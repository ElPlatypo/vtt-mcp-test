@@ -0,0 +1,75 @@
+/** manage-scene-objects update: moves and edits objects this tool placed. Foundry is stubbed. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+
+const MODULE = 'foundry-mcp-bridge-scenes';
+const mine = { [MODULE]: { sceneObjectsTool: true } };
+
+function setup() {
+  const updated: Array<{ type: string; data: any[] }> = [];
+  const doc = (id: string, extra: any = {}) => ({ id, flags: mine, x: 700, y: 400, ...extra });
+  const col = (docs: any[]) => ({ contents: docs, get: (id: string) => docs.find(d => d.id === id) });
+  const scene: any = {
+    id: 's1',
+    name: 'Town',
+    width: 2000,
+    height: 1500,
+    padding: 0,
+    grid: { size: 100, distance: 5, units: 'ft' },
+    dimensions: { sceneX: 0, sceneY: 0, sceneWidth: 2000, sceneHeight: 1500 },
+    tokens: col([]),
+    lights: col([doc('l1')]),
+    walls: col([doc('w1', { door: 1 }), doc('w2', { door: 0 })]),
+    notes: col([doc('n1'), { id: 'n2', flags: {}, x: 0, y: 0 }]),
+    tiles: col([]),
+    sounds: col([]),
+    updateEmbeddedDocuments: vi.fn(async (type: string, data: any[]) => {
+      updated.push({ type, data });
+      return data;
+    }),
+  };
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'GM' },
+    scenes: { contents: [scene], viewed: scene, current: scene },
+    actors: { contents: [] },
+    settings: { get: (_m: string, key: string) => (key === 'allowWriteOperations' ? true : undefined) },
+  });
+  return { da: new FoundryDataAccess(), scene, updated };
+}
+
+describe('manageSceneObjects update', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('moves a pin and edits a light and a door in one call', async () => {
+    const { da, updated } = setup();
+    const r = await da.manageSceneObjects({
+      action: 'update',
+      scene: 's1',
+      updates: [{ id: 'n1', x: 10, text: 'Inn' }, { id: 'l1', bright: 2, dim: 4 }, { id: 'w1', door_state: 'open' }],
+    });
+    expect(r.updated).toEqual([
+      { kind: 'note', id: 'n1', changed: ['x', 'text'] },
+      { kind: 'light', id: 'l1', changed: ['bright', 'dim'] },
+      { kind: 'wall', id: 'w1', changed: ['door_state'] },
+    ]);
+    const byType = Object.fromEntries(updated.map(u => [u.type, u.data[0]]));
+    expect(byType.Note).toEqual({ _id: 'n1', x: 1000, y: 400, text: 'Inn' });
+    expect(byType.AmbientLight).toEqual({ _id: 'l1', 'config.bright': 10, 'config.dim': 20 });
+    expect(byType.Wall).toEqual({ _id: 'w1', ds: 1 });
+  });
+
+  it('refuses what it did not place, what is missing and bad fields, changing nothing', async () => {
+    const { da, updated } = setup();
+    await expect(da.manageSceneObjects({ action: 'update', scene: 's1', updates: [{ id: 'n2', text: 'x' }] })).rejects.toThrow('not created by this tool');
+    await expect(da.manageSceneObjects({ action: 'update', scene: 's1', updates: [{ id: 'zzz', text: 'x' }] })).rejects.toThrow('no object with id zzz');
+    await expect(da.manageSceneObjects({ action: 'update', scene: 's1', updates: [{ id: 'w2', door_state: 'open' }] })).rejects.toThrow('only applies to doors');
+    await expect(da.manageSceneObjects({ action: 'update', scene: 's1', updates: [{ id: 'n1', text: 'ok' }, { id: 'l1', color: 'red' }] })).rejects.toThrow('#RRGGBB');
+    await expect(da.manageSceneObjects({ action: 'update', scene: 's1', updates: [{ id: 'n1', kind: 'light', text: 'x' }] })).rejects.toThrow('no light with id n1');
+    await expect(da.manageSceneObjects({ action: 'update', scene: 's1', updates: [] })).rejects.toThrow('non-empty');
+    expect(updated).toHaveLength(0);
+  });
+});

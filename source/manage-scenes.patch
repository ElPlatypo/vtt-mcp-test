+      walls: [{ _id: 'bw1', c: [0, 0, 1, 1] }],
+      levels: [{ _id: 'bl', background: { src: 'old.png' } }],
+    });
+    const r = await da.manageSceneBackups({ action: 'restore', backup: made.backup.id, confirm: true });
+    expect(r.safetyBackup.label).toBe('before restore');
+    expect(cave.clone).toHaveBeenCalledTimes(2);
+    expect(cave.update).toHaveBeenCalledWith({ width: 3000 });
+    expect(cave.deleteEmbeddedDocuments).toHaveBeenCalledWith('Token', ['t0', 't1']);
+    expect(cave.deleteEmbeddedDocuments).toHaveBeenCalledWith('Wall', ['w0', 'w1', 'w2']);
+    expect(cave.createEmbeddedDocuments).toHaveBeenCalledWith('Token', [
+      { name: 'Wolf', level: 'defaultLevel0000' },
+      { name: 'Lost' },
+    ]);
+    expect(cave.createEmbeddedDocuments).toHaveBeenCalledWith('Wall', [{ c: [0, 0, 1, 1] }]);
+    expect(cave.updateEmbeddedDocuments).toHaveBeenCalledWith('Level', [{ background: { src: 'old.png' }, _id: 'defaultLevel0000' }]);
+    expect(r.restoredInto).toMatchObject({ id: 's1' });
+  });
+
+  it('deletes only backups, and only when confirmed', async () => {
+    const { da, cave } = setupScenes();
+    const made = await da.manageSceneBackups({ action: 'backup', scene: 'Cave' });
+    const backupScene = (game as any).scenes.contents.find((s: any) => s.id === made.backup.id);
+    const dry = await da.manageSceneBackups({ action: 'delete', backup: made.backup.id });
+    expect(dry.dryRun).toBe(true);
+    expect(backupScene.delete).not.toHaveBeenCalled();
+    await da.manageSceneBackups({ action: 'delete', backup: made.backup.id, confirm: true });
+    expect(backupScene.delete).toHaveBeenCalled();
+    await expect(da.manageSceneBackups({ action: 'delete', backup: 'Cave', confirm: true })).rejects.toThrow('exact name');
+    expect(cave.delete).not.toHaveBeenCalled();
+  });
+
+  it('needs the original, knows its actions and respects the write gate', async () => {
+    const { da, scenesList } = setupScenes();
+    const made = await da.manageSceneBackups({ action: 'backup', scene: 'Cave' });
+    scenesList.splice(0, 1);
+    await expect(da.manageSceneBackups({ action: 'restore', backup: made.backup.id })).rejects.toThrow('no longer exists');
+    await expect(da.manageSceneBackups({ action: 'restore' })).rejects.toThrow('backup');
+    await expect(da.manageSceneBackups({ action: 'explode' as any })).rejects.toThrow('Unknown action');
+    const off = setupScenes(false);
+    await expect(off.da.manageSceneBackups({ action: 'backup', scene: 'Cave' })).rejects.toThrow();
+    expect((await off.da.manageSceneBackups({ action: 'list' })).success).toBe(true);
+  });
+});
diff --git a/packages/foundry-module/src/data-access.inspect.test.ts b/packages/foundry-module/src/data-access.inspect.test.ts

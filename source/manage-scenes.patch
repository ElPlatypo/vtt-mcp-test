+/**
+ * Pure validation helpers for the upload-file tool.
+ *
+ * The MCP server checks files before sending them and the module checks them again
+ * here, so a bad request is refused on both sides. Only a small set of image types
+ * is accepted, and the bytes must really be that type.
+ */
+
+export const UPLOAD_MAX_BYTES = 20 * 1024 * 1024;
+
+export const UPLOAD_IMAGE_TYPES: Record<string, string> = {
+  png: 'image/png',
+  jpg: 'image/jpeg',
+  jpeg: 'image/jpeg',
+  webp: 'image/webp',
+  gif: 'image/gif',
+};
+
+export type DetectedImageType = 'png' | 'jpg' | 'webp' | 'gif';
+
+/**
+ * Reduce a name to letters, digits, dot, dash and underscore, drop any directory part
+ * and require an allowed image extension. Returns the safe name with a lower-case extension.
+ */
+export function sanitizeUploadFilename(raw: unknown): string {
+  if (typeof raw !== 'string' || !raw.trim()) {
+    throw new Error('filename is required and must be a string');
+  }
+  const base = raw.split(/[\\/]/).pop() ?? '';
+  const cleaned = base.replace(/[^a-zA-Z0-9_.-]/g, '_').replace(/^\.+/, '');
+  const dot = cleaned.lastIndexOf('.');
+  if (dot <= 0 || dot === cleaned.length - 1) {
+    throw new Error('filename needs a name and an extension, for example cave.webp');
+  }
+  const ext = cleaned.slice(dot + 1).toLowerCase();
+  if (!(ext in UPLOAD_IMAGE_TYPES)) {
+    throw new Error(`Unsupported file type ".${ext}". Allowed: png, jpg, jpeg, webp, gif`);
+  }
+  return `${cleaned.slice(0, dot)}.${ext}`;
+}
+
+/**
+ * Validate an optional sub-folder below the world's upload folder: up to three
+ * segments of letters, digits, dash and underscore. No dots, so no ".." either.
+ * Returns the cleaned relative path, or "" for the upload folder itself.
+ */
+export function sanitizeUploadFolder(raw: unknown): string {
+  if (raw === undefined || raw === null || raw === '') return '';
+  if (typeof raw !== 'string') {
+    throw new Error('folder must be a string');
+  }
+  const parts = raw.split(/[\\/]/).filter(Boolean);
+  if (parts.length > 3) {
+    throw new Error('folder may have at most 3 levels');
+  }
+  for (const part of parts) {
+    if (!/^[A-Za-z0-9_-]+$/.test(part)) {
+      throw new Error(
+        `Invalid folder name "${part}": use only letters, digits, dash and underscore`
+      );
+    }
+  }
+  return parts.join('/');
+}
+
+/** Identify an image by its first bytes. Returns null for anything else. */
+export function detectImageType(bytes: Uint8Array): DetectedImageType | null {
+  if (
+    bytes.length >= 8 &&
+    bytes[0] === 0x89 &&
+    bytes[1] === 0x50 &&
+    bytes[2] === 0x4e &&
+    bytes[3] === 0x47 &&
+    bytes[4] === 0x0d &&
+    bytes[5] === 0x0a &&
+    bytes[6] === 0x1a &&
+    bytes[7] === 0x0a
+  ) {
+    return 'png';
+  }
+  if (bytes.length >= 3 && bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) {
+    return 'jpg';
+  }
+  if (
+    bytes.length >= 6 &&
+    bytes[0] === 0x47 &&
+    bytes[1] === 0x49 &&
+    bytes[2] === 0x46 &&
+    bytes[3] === 0x38 &&
+    (bytes[4] === 0x37 || bytes[4] === 0x39) &&
+    bytes[5] === 0x61
+  ) {
+    return 'gif';
+  }
+  if (
+    bytes.length >= 12 &&
+    bytes[0] === 0x52 && // R
+    bytes[1] === 0x49 && // I
+    bytes[2] === 0x46 && // F
+    bytes[3] === 0x46 && // F
+    bytes[8] === 0x57 && // W
+    bytes[9] === 0x45 && // E
+    bytes[10] === 0x42 && // B
+    bytes[11] === 0x50 // P
+  ) {
+    return 'webp';
+  }
+  return null;
+}
+
+/** True when a file extension agrees with the detected image type ("jpeg" counts as "jpg"). */
+export function extensionMatchesType(filename: string, detected: DetectedImageType): boolean {
+  const ext = filename.slice(filename.lastIndexOf('.') + 1).toLowerCase();
+  return (ext === 'jpeg' ? 'jpg' : ext) === detected;
+}
+
+/** Decode base64 into bytes. Throws a clear error for text that is not base64. */
+export function decodeBase64(data: unknown): Uint8Array {
+  if (typeof data !== 'string' || !data) {
+    throw new Error('file data is required and must be a base64 string');
+  }
+  let binary: string;
+  try {
+    binary = atob(data);
+  } catch {
+    throw new Error('file data is not valid base64');
+  }
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) {
+    bytes[i] = binary.charCodeAt(i);
+  }
+  return bytes;
+}

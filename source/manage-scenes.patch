@@ -0,0 +1,220 @@
+import { WebSocketServer, type WebSocket } from 'ws';
+import { TableBundler, type BundlerSettings, type TableEventIn } from './table-bundler.js';
+
+/**
+ * The table feed: a WebSocket on this computer (default ws://127.0.0.1:31418) that sends one JSON
+ * line per "beat", a bundle of what happened at the table, only when the AI GM is needed (see
+ * table-bundler). In Claude Code, watch it with the Monitor tool: each line arrives as one
+ * notification. It reads the events the Foundry module records (the table-events query) while
+ * someone is connected; with nobody connected it does nothing.
+ *
+ * Lines: {type:"beat", n, why:[...], events:[...], dropped?, table:{scene, combat?, party, online}}
+ * and {type:"notice", text} for changes such as the GM muting the feed or Foundry disconnecting.
+ */
+
+export interface TableFeedOptions {
+  query: (method: string, data?: any, timeoutMs?: number) => Promise<any>;
+  isConnected: () => boolean;
+  logger: { info: (m: string, d?: any) => void; warn: (m: string, d?: any) => void; debug: (m: string, d?: any) => void };
+  port: number;
+  /** how often the module's events are read while a client is connected */
+  pollMs?: number;
+  now?: () => number;
+}
+
+export const DEFAULT_TABLE_FEED_PORT = 31418;
+const QUERY = 'foundry-mcp-bridge.table-events';
+
+export class TableFeed {
+  readonly bundler = new TableBundler();
+  private options: TableFeedOptions;
+  private wss: WebSocketServer | undefined;
+  private clients = new Set<WebSocket>();
+  private timer: ReturnType<typeof setTimeout> | undefined;
+  private polling = false;
+  private seq: number | undefined;
+  private session: string | undefined;
+  private lastNotice: string | undefined;
+  private beats = 0;
+  private lastBeatAt: number | undefined;
+
+  constructor(options: TableFeedOptions) {
+    this.options = options;
+  }
+
+  private now(): number {
+    return this.options.now?.() ?? Date.now();
+  }
+
+  get port(): number | undefined {
+    const address = this.wss?.address();
+    return address && typeof address === 'object' ? address.port : undefined;
+  }
+
+  get listeners(): number {
+    return this.clients.size;
+  }
+
+  start(): Promise<void> {
+    return new Promise(resolve => {
+      const wss = new WebSocketServer({ host: '127.0.0.1', port: this.options.port });
+      wss.once('listening', () => {
+        this.wss = wss;
+        wss.on('connection', socket => this.onConnection(socket));
+        this.options.logger.info('Table feed listening', { port: this.port });
+        resolve();
+      });
+      wss.once('error', error => {
+        this.options.logger.warn('Table feed could not start', { error: error.message });
+        resolve();
+      });
+    });
+  }
+
+  stop(): void {
+    if (this.timer) clearTimeout(this.timer);
+    this.timer = undefined;
+    for (const client of this.clients) client.terminate();
+    this.clients.clear();
+    this.wss?.close();
+    this.wss = undefined;
+  }
+
+  private onConnection(socket: WebSocket): void {
+    this.clients.add(socket);
+    socket.on('close', () => {
+      this.clients.delete(socket);
+      if (this.clients.size === 0) {
+        if (this.timer) clearTimeout(this.timer);
+        this.timer = undefined;
+        this.seq = undefined; // the next listener starts from what is new then
+      }
+    });
+    socket.on('error', () => socket.terminate());
+    if (!this.timer && !this.polling) void this.tick();
+  }
+
+  private send(line: Record<string, unknown>): void {
+    const text = JSON.stringify(line);
+    for (const client of this.clients) if (client.readyState === 1) client.send(text);
+  }
+
+  /** A line for the GM's AI on the feed, such as a queued job that failed after its tool call returned. */
+  announce(text: string): void {
+    this.lastNotice = undefined;
+    this.notice(text);
+  }
+
+  private notice(text: string): void {
+    if (this.lastNotice === text) return;
+    this.lastNotice = text;
+    this.send({ type: 'notice', text });
+  }
+
+  /** Read new events from the module; on the first read only note where "now" is. */
+  private async pull(snapshot = false): Promise<Record<string, any> | undefined> {
+    const first = this.seq === undefined;
+    const result = await this.options.query(QUERY, {
+      ...(first ? {} : { since: this.seq, session: this.session }),
+      ...(snapshot ? { snapshot: true } : {}),
+    });
+    if (result?.success === false) throw new Error(result.error || 'table events refused');
+    const restarted = !!result?.restarted || (this.session !== undefined && result?.session !== this.session);
+    this.session = result?.session;
+    this.seq = typeof result?.seq === 'number' ? result.seq : this.seq;
+    if (!first && !restarted) this.bundler.add((result?.events ?? []) as TableEventIn[], this.now());
+    if (restarted && !first) this.notice('The Foundry page was reloaded; the table feed starts again from now');
+    const muted = result?.muted === true;
+    if (muted !== this.bundler.muted) {
+      this.bundler.muted = muted;
+      if (!first) this.notice(muted ? 'The GM muted the AI GM: events are kept and come in one bundle when unmuted' : 'The GM unmuted the AI GM');
+    }
+    return result;
+  }
+
+  private async beat(reason?: string): Promise<boolean> {
+    let table: Record<string, any> | undefined;
+    try {
+      // The snapshot read also brings any events that came in meanwhile, so none are lost.
+      const result = await this.pull(true);
+      table = result?.table;
+    } catch {
+      table = undefined;
+    }
+    const now = this.now();
+    // Turns the GM's tools already ran (or that ended with the combat) are not worth a wake.
+    if (!reason && table && !this.bundler.dropStaleTurns(table.combat?.turn)) return false;
+    const beat = this.bundler.flush(now, reason);
+    if (!beat) return false;
+    this.beats += 1;
+    this.lastBeatAt = now;
+    // why and table first, the events last: a long beat that gets cut in the notification loses its tail only.
+    this.send({ type: 'beat', n: this.beats, why: beat.why, ...(table ? { table } : {}), events: beat.events, ...(beat.dropped ? { dropped: beat.dropped } : {}) });
+    return true;
+  }
+
+  private async tick(): Promise<void> {
+    if (this.clients.size === 0) return;
+    this.polling = true;
+    try {
+      if (!this.options.isConnected()) {
+        this.notice('Foundry is not connected; the table feed resumes when it is');
+      } else {
+        await this.pull();
+        if (this.lastNotice?.startsWith('Foundry is not connected')) this.notice('Foundry is connected again; the table feed is live');
+        const now = this.now();
+        this.bundler.tick(now);
+        if (this.bundler.due(now)) await this.beat();
+      }
+    } catch (error) {
+      this.notice(`Cannot read the table: ${error instanceof Error ? error.message : String(error)}`);
+    } finally {
+      this.polling = false;
+      if (this.clients.size > 0) this.timer = setTimeout(() => void this.tick(), this.options.pollMs ?? 1000);
+      else this.timer = undefined;
+    }
+  }
+
+  // ----- control, for the table-watch tool -----
+
+  status(): Record<string, any> {
+    const s = this.bundler.settings;
+    return {
+      listening: this.port !== undefined,
+      url: this.port !== undefined ? `ws://127.0.0.1:${this.port}` : undefined,
+      listeners: this.clients.size,
+      foundryConnected: this.options.isConnected(),
+      muted: this.bundler.muted,
+      beatsSent: this.beats,
+      ...(this.lastBeatAt ? { lastBeatSecondsAgo: Math.round((this.now() - this.lastBeatAt) / 1000) } : {}),
+      pendingEvents: this.bundler.pendingCount,
+      wakePending: this.bundler.hasWake,
+      ...(this.bundler.awaiting ? { awaitingRolls: this.bundler.awaiting } : {}),
+      settings: {
+        quiet_seconds: s.quietMs / 1000,
+        turn_quiet_seconds: s.turnQuietMs / 1000,
+        min_interval_seconds: s.minIntervalMs / 1000,
+        max_wait_seconds: s.maxWaitMs / 1000,
+        max_background: s.maxBackground,
+      },
+    };
+  }
+
+  configure(patch: Partial<BundlerSettings>): void {
+    this.bundler.settings = { ...this.bundler.settings, ...patch };
+  }
+
+  expect(names: string[], timeoutMs: number, since?: number): void {
+    this.bundler.expect(names, this.now(), timeoutMs, since);
+  }
+
+  cancelExpectation(): void {
+    this.bundler.cancelExpectation();
+  }
+
+  /** Send what is pending now as a beat. */
+  async flushNow(reason: string): Promise<boolean> {
+    if (this.clients.size === 0) return false;
+    return this.beat(reason);
+  }
+}

+import { describe, expect, it } from 'vitest';
+import {
+  buildWorkflow,
+  DEFAULT_PROFILES,
+  fitPixels,
+  IMAGE_KINDS,
+  normalizeProfile,
+  normalizeProfiles,
+  resolveGeneration,
+} from './image-profiles.js';
+
+describe('normalizeProfiles', () => {
+  it('gives the defaults for nothing, nonsense or broken JSON', () => {
+    expect(normalizeProfiles(undefined)).toEqual(DEFAULT_PROFILES);
+    expect(normalizeProfiles('not json')).toEqual(DEFAULT_PROFILES);
+    expect(normalizeProfiles(42)).toEqual(DEFAULT_PROFILES);
+  });
+
+  it('has every kind', () => {
+    expect(Object.keys(normalizeProfiles({})).sort()).toEqual([...IMAGE_KINDS].sort());
+  });
+
+  it('defaults maps to a checkpoint and the rest to MiniMax H3', () => {
+    expect(DEFAULT_PROFILES.map.workflow).toBe('checkpoint');
+    for (const kind of ['portrait', 'token', 'handout'] as const) {
+      expect(DEFAULT_PROFILES[kind].workflow).toBe('minimax-h3');
+      expect(DEFAULT_PROFILES[kind].steps).toBe(6);
+      expect(DEFAULT_PROFILES[kind].cfg).toBe(1);
+    }
+  });
+
+  it('keeps saved values and fills in missing ones from that kind default', () => {
+    const profiles = normalizeProfiles(
+      JSON.stringify({ portrait: { workflow: 'minimax-h3', diffusionModel: 'other.safetensors' } })
+    );
+    expect(profiles.portrait.diffusionModel).toBe('other.safetensors');
+    expect(profiles.portrait.steps).toBe(DEFAULT_PROFILES.portrait.steps);
+    expect(profiles.map).toEqual(DEFAULT_PROFILES.map);
+  });
+
+  it('treats profiles saved before workflows existed as old checkpoint settings', () => {
+    const profiles = normalizeProfiles({
+      map: { checkpoint: 'mine.safetensors', steps: 40 },
+      portrait: { checkpoint: '', steps: 25, cfg: 6, sampler: 'dpmpp_2m' },
+    });
+    // The map stays a checkpoint profile with the saved values.
+    expect(profiles.map.workflow).toBe('checkpoint');
+    expect(profiles.map.checkpoint).toBe('mine.safetensors');
+    expect(profiles.map.steps).toBe(40);
+    // The rest only held settings for a checkpoint that was never chosen: new defaults.
+    expect(profiles.portrait).toEqual(DEFAULT_PROFILES.portrait);
+  });
+
+  it('clamps and repairs bad numbers and names', () => {
+    const p = normalizeProfile(
+      { steps: 100000, cfg: -4, width: 9000, height: 10, sampler: 'bad name!', scheduler: 7 },
+      DEFAULT_PROFILES.map
+    );
+    expect(p.steps).toBe(100);
+    expect(p.cfg).toBe(0);
+    expect(p.width).toBeLessThanOrEqual(6400);
+    expect(p.width * p.height).toBeLessThanOrEqual(4096 * 4096);
+    expect(p.height).toBe(256);
+    expect(p.sampler).toBe(DEFAULT_PROFILES.map.sampler);
+    expect(p.scheduler).toBe(DEFAULT_PROFILES.map.scheduler);
+  });
+
+  it('rejects an unknown workflow', () => {
+    const p = normalizeProfile({ workflow: 'magic' }, DEFAULT_PROFILES.portrait);
+    expect(p.workflow).toBe('minimax-h3');
+  });
+
+  it('accepts numbers sent as text', () => {
+    const p = normalizeProfile({ steps: '12', cfg: '3.5' }, DEFAULT_PROFILES.map);
+    expect(p.steps).toBe(12);
+    expect(p.cfg).toBe(3.5);
+  });
+});
+
+describe('fitPixels', () => {
+  it('snaps to multiples of 8, or 32 when asked', () => {
+    expect(fitPixels(1000, 1003)).toEqual({ width: 1000, height: 1000 });
+    expect(fitPixels(1650, 2440, 32)).toEqual({ width: 1664, height: 2432 });
+  });
+
+  it('shrinks a picture that has too many pixels but keeps its shape', () => {
+    const big = fitPixels(6400, 6000, 32);
+    expect(big.width * big.height).toBeLessThanOrEqual(4096 * 4096);
+    expect(big.width % 32).toBe(0);
+    expect(big.height % 32).toBe(0);
+    expect(big.width).toBeGreaterThan(big.height);
+  });
+});
+
+describe('resolveGeneration (checkpoint)', () => {
+  const profile = { ...DEFAULT_PROFILES.map };
+
+  it('wraps the prompt in the profile wording', () => {
+    const gen = resolveGeneration('map', profile, { prompt: ' a forest clearing ', seed: 5 });
+    expect(gen.positive).toBe(
+      '2d DnD battlemap of a forest clearing, top-down view, overhead perspective, aerial'
+    );
+    expect(gen.seed).toBe(5);
+    expect(gen.steps).toBe(30);
+  });
+
+  it('lets the request override size and steps, and extends the negative prompt', () => {
+    const gen = resolveGeneration('map', profile, {
+      prompt: 'x',
+      width: 1536,
+      height: 1024,
+      steps: 12,
+      negativePrompt: 'fog',
+    });
+    expect([gen.width, gen.height, gen.steps]).toEqual([1536, 1024, 12]);
+    expect(gen.negative.endsWith(', fog')).toBe(true);
+  });
+
+  it('refuses an empty prompt and a missing checkpoint', () => {
+    expect(() => resolveGeneration('map', profile, { prompt: '  ' })).toThrow('prompt');
+    expect(() =>
+      resolveGeneration('map', { ...profile, checkpoint: '' }, { prompt: 'a cave' })
+    ).toThrow(/No checkpoint is chosen for "map"/);
+  });
+
+  it('refuses reference pictures', () => {
+    expect(() =>
+      resolveGeneration('map', profile, { prompt: 'x', referenceImages: ['a.png'] })
+    ).toThrow(/cannot take reference images/);
+  });
+
+  it('picks a seed when none is given', () => {
+    const gen = resolveGeneration('map', profile, { prompt: 'x' });
+    expect(Number.isInteger(gen.seed)).toBe(true);
+    expect(gen.seed).toBeGreaterThanOrEqual(0);
+  });
+});
+
+describe('resolveGeneration (minimax-h3)', () => {
+  const profile = { ...DEFAULT_PROFILES.portrait };
+
+  it('uses the prompt as written, snaps the size to 32 and has no negative prompt', () => {
+    const gen = resolveGeneration('portrait', profile, {

+import { afterAll, describe, expect, it, vi } from 'vitest';
+import { promises as fs } from 'fs';
+import os from 'os';
+import path from 'path';
+import { PNG } from 'pngjs';
+import { ActorArtTools, artSlug } from './actor-art-tools.js';
+import { padToSquare } from './prop-keying.js';
+
+const tmp: string[] = [];
+afterAll(async () => {
+  for (const f of tmp) await fs.rm(f, { force: true });
+});
+
+/** 800 x 600 magenta picture with a 300 x 400 brown figure in it. */
+async function tokenSource(): Promise<string> {
+  const w = 800;
+  const h = 600;
+  const png = new PNG({ width: w, height: h });
+  for (let y = 0; y < h; y++) {
+    for (let x = 0; x < w; x++) {
+      const inside = x >= 250 && x < 550 && y >= 100 && y < 500;
+      const c = inside ? [90, 60, 30] : [255, 0, 255];
+      png.data.set([c[0]!, c[1]!, c[2]!, 255], (y * w + x) * 4);
+    }
+  }
+  const file = path.join(os.tmpdir(), `actor-art-${Date.now()}-${Math.random().toString(36).slice(2)}.png`);
+  await fs.writeFile(file, PNG.sync.write(png));
+  tmp.push(file);
+  return file;
+}
+
+function make(options: { generate?: any; upload?: any; query?: any } = {}) {
+  const query = vi.fn(options.query ?? (async () => ({ success: true, actor: { id: 'a1', name: 'Goblin Boss' }, tokensUpdated: 2 })));
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  const upload = options.upload ?? vi.fn(async (a: any) => ({ success: true, path: `worlds/w/uploads/${a.folder}/${a.filename}` }));
+  return { tools: new ActorArtTools({ foundryClient: { query } as any, logger, generate: options.generate, upload }), query, upload };
+}

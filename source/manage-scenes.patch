@@ -0,0 +1,102 @@
+/** rules lookup: utils and the data-access search/read over journal packs and world journals. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+import { clipText, htmlToText, queryTerms, searchPages, type RulePage } from './rules-utils.js';
+
+describe('rules utils', () => {
+  it('turns html into plain text with headings, lists and enrichers resolved', () => {
+    const t = htmlToText('<h2>Hiding</h2><p>Roll @UUID[Compendium.x.y]{Stealth} &amp; wait.</p><ul><li>one</li><li>two</li></ul>');
+    expect(t).toContain('## Hiding');
+    expect(t).toContain('Roll Stealth & wait.');
+    expect(t).toContain('\n- one\n- two');
+  });
+  it('keeps meaningful query words', () => {
+    expect(queryTerms('How does hiding work in combat?')).toEqual(['hiding', 'work', 'combat']);
+  });
+  it('ranks a page named for the term first and skips unrelated pages', () => {
+    const pages: RulePage[] = [
+      { uuid: 'u1', journal: 'Rules', page: 'Surprise', source: 'SRD', text: 'The GM determines who is surprised. Surprised creatures cannot act.' },
+      { uuid: 'u2', journal: 'Rules', page: 'Hiding', source: 'SRD', text: 'Make a Stealth check. A hidden creature may surprise enemies.' },
+      { uuid: 'u3', journal: 'Rules', page: 'Cooking', source: 'SRD', text: 'Soup.' },
+    ];
+    const hits = searchPages(pages, 'surprise');
+    expect(hits.map(h => h.uuid)).toEqual(['u1', 'u2']);
+    expect(hits[0]!.snippet).toContain('surprised');
+    expect(searchPages(pages, 'dragon')).toEqual([]);
+  });
+  it('clips text and reports what is left', () => {
+    const text = 'First sentence. '.repeat(50);
+    const c = clipText(text, 100);
+    expect(c.truncated).toBe(true);
+    expect(c.text.length).toBeLessThanOrEqual(100);
+    expect(c.remaining).toBeGreaterThan(text.length - 101);
+    expect(clipText('short', 100)).toEqual({ text: 'short', truncated: false, remaining: 0 });
+  });
+});
+
+function setup() {
+  const page = (id: string, name: string, html: string) => ({ uuid: `Compendium.dnd5e.rules.JournalEntry.J.JournalEntryPage.${id}`, name, type: 'text', text: { content: html } });
+  const journal = { name: 'Appendix E: Rules', pages: { contents: [page('p1', 'Surprise', '<p>Compare Stealth checks with passive Perception to see who is surprised.</p>'), page('p2', 'Grappling', '<p>Escape with Athletics.</p>')] } };
+  const houseJournal = { name: 'House Rules', pages: { contents: [{ ...page('h1', 'Crits', '<p>Max damage on a critical hit.</p>'), uuid: 'JournalEntry.W.JournalEntryPage.h1' }] } };
+  const getDocuments = vi.fn(async () => [journal]);
+  const packs = [
+    { collection: 'dnd5e.rules', documentName: 'JournalEntry', metadata: { label: 'SRD Rules', system: 'dnd5e' }, getDocuments },
+    { collection: 'dnd5e.items', documentName: 'Item', metadata: { label: 'Items', system: 'dnd5e' }, getDocuments: vi.fn() },
+  ];
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('fromUuid', vi.fn(async (uuid: string) => (uuid.endsWith('.p1') ? { ...journal.pages.contents[0], documentName: 'JournalEntryPage', parent: journal } : null)));
+  vi.stubGlobal('game', {
+    ready: true,
+    system: { id: 'dnd5e' },
+    world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'GM', isGM: true },
+    packs: { contents: packs, get: (id: string) => packs.find(p => p.collection === id) },
+    journal: { contents: [houseJournal, { name: 'Session notes', pages: { contents: [page('n1', 'Notes', '<p>surprise party</p>')] } }] },
+    settings: { get: () => undefined },
+  });
+  return { da: new FoundryDataAccess(), getDocuments };
+}
+
+describe('lookupRules', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('lists the sources', async () => {
+    const { da } = setup();
+    const r = await da.lookupRules({ action: 'sources' });
+    expect(r.sources.map((s: any) => s.id)).toEqual(['dnd5e.rules', 'world']);
+  });
+  it('searches packs and rules-named world journals, caching the pack', async () => {
+    const { da, getDocuments } = setup();
+    const r = await da.lookupRules({ query: 'surprise' });
+    expect(r.results.map((h: any) => h.page)).toEqual(['Surprise']);
+    expect(r.results[0]).toMatchObject({ journal: 'Appendix E: Rules', source: 'SRD Rules' });
+    expect(r.results[0].score).toBeUndefined();
+    const house = await da.lookupRules({ query: 'critical', sources: ['world'] });
+    expect(house.results[0]).toMatchObject({ page: 'Crits', source: 'world' });
+    await da.lookupRules({ query: 'grappling' });
+    expect(getDocuments).toHaveBeenCalledTimes(1);
+  });
+  it('pulls embedded pages into the text of the page that embeds them', async () => {
+    const { da } = setup();
+    const g = (globalThis as any).game;
+    g.packs.contents[0].getDocuments = async () => [
+      { name: 'Combat', pages: { contents: [{ uuid: 'stub', name: 'Making an Attack', type: 'text', text: { content: '<h2>Unseen Attackers</h2>@Embed[Compendium.x.JournalEntry.J.JournalEntryPage.deep inline]' } }] } },
+    ];
+    (globalThis as any).fromUuid = async (u: string) => (u.endsWith('.deep') ? { documentName: 'JournalEntryPage', text: { content: '<p>A hidden attacker gives away its location.</p>' } } : null);
+    const r = await da.lookupRules({ query: 'hidden attacker location', sources: ['dnd5e.rules'] });
+    expect(r.results[0]).toMatchObject({ page: 'Making an Attack' });
+  });
+  it('reads pages, and says when one is missing', async () => {
+    const { da } = setup();
+    const r = await da.lookupRules({ action: 'read', uuids: ['Compendium.dnd5e.rules.JournalEntry.J.JournalEntryPage.p1', 'nope'] });
+    expect(r.results[0]).toMatchObject({ page: 'Surprise', journal: 'Appendix E: Rules' });
+    expect(r.results[0].text).toContain('passive Perception');
+    expect(r.results[1]).toMatchObject({ error: 'not found' });
+  });
+  it('asks for a query or a uuid', async () => {
+    const { da } = setup();
+    await expect(da.lookupRules({ action: 'search' })).rejects.toThrow('needs a query');
+    await expect(da.lookupRules({ action: 'read' })).rejects.toThrow('needs uuid');
+  });
+});

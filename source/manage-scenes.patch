+/**
+ * Rules lookup: turning journal pages (the system's own rules compendiums, or the world's rules
+ * journals) into searchable plain text, ranking them against a question, and cutting snippets.
+ */
+
+export interface RulePage {
+  uuid: string;
+  /** the journal the page belongs to */
+  journal: string;
+  page: string;
+  /** where it came from: a compendium label, or "world" */
+  source: string;
+  /** plain text, original case */
+  text: string;
+}
+
+const ENTITIES: Record<string, string> = { '&nbsp;': ' ', '&amp;': '&', '&lt;': '<', '&gt;': '>', '&quot;': '"', '&#39;': "'", '&rsquo;': "'", '&lsquo;': "'", '&ndash;': '-', '&mdash;': '-' };
+
+/** Journal page HTML as plain text: headings and list items on their own lines, enrichers shown as their labels. */
+export function htmlToText(html: unknown): string {
+  let s = String(html ?? '');
+  s = s.replace(/@UUID\[[^\]]*\]\{([^}]*)\}/g, '$1');
+  s = s.replace(/@UUID\[[^\]]*\]/g, '');
+  s = s.replace(/@Embed\[[^\]]*\]/g, '');
+  s = s.replace(/@[A-Za-z]+\[[^\]]*\]\{([^}]*)\}/g, '$1');
+  s = s.replace(/\[\[[^\]]*\]\]\{([^}]*)\}/g, '$1');
+  s = s.replace(/\[\[\/?[a-z]+ ([^\]]*)\]\]/gi, '$1');
+  s = s.replace(/<\s*h[1-6][^>]*>/gi, '\n\n## ').replace(/<\s*\/\s*h[1-6]\s*>/gi, '\n');
+  s = s.replace(/<\s*li[^>]*>/gi, '\n- ').replace(/<\s*(\/p|br|\/tr|\/div|\/ul|\/ol)\s*\/?>/gi, '\n');
+  s = s.replace(/<\s*\/t[dh]\s*>/gi, ' | ');
+  s = s.replace(/<[^>]+>/g, '');
+  s = s.replace(/&[a-z#0-9]+;/gi, m => ENTITIES[m.toLowerCase()] ?? ' ');
+  return s
+    .split('\n')
+    .map(line => line.replace(/[ \t]+/g, ' ').trim())
+    .filter((line, i, all) => line !== '' || (i > 0 && all[i - 1] !== ''))
+    .join('\n')
+    .trim();
+}
+
+const STOP = new Set(['the', 'a', 'an', 'of', 'to', 'in', 'on', 'for', 'and', 'or', 'is', 'are', 'do', 'does', 'how', 'what', 'when', 'can', 'you', 'your', 'with', 'rule', 'rules']);
+
+/** The words of a question that carry meaning. */
+export function queryTerms(query: string): string[] {
+  const words = query.toLowerCase().match(/[a-z0-9']+/g) ?? [];
+  const terms = words.filter(w => w.length > 1 && !STOP.has(w));
+  return [...new Set(terms.length ? terms : words)];
+}
+
+const count = (haystack: string, needle: string): number => {
+  let n = 0;
+  let i = -1;
+  while ((i = haystack.indexOf(needle, i + 1)) >= 0) n++;
+  return n;
+};
+
+/** How well a page answers a question: its name counts most, then its journal, then its text. 0 means no match. */
+export function scorePage(page: RulePage, terms: string[], text: string = page.text.toLowerCase()): number {
+  if (terms.length === 0) return 0;
+  const name = page.page.toLowerCase();
+  const journal = page.journal.toLowerCase();
+  let score = 0;
+  let found = 0;
+  for (const term of terms) {
+    const inName = name.includes(term);
+    const inJournal = journal.includes(term);
+    const hits = count(text, term);
+    if (inName || inJournal || hits > 0) found++;
+    if (name === term) score += 100;
+    else if (inName) score += 30;
+    if (inJournal) score += 5;
+    score += Math.min(hits, 6) * 2;
+  }
+  // a page that covers every word beats one that covers some
+  if (found === terms.length) score += 20 * terms.length;
+  else if (found < Math.ceil(terms.length / 2)) return 0;
+  // short focused pages beat huge ones that merely mention the words
+  return score - Math.min(10, Math.floor(page.text.length / 4000));
+}
+
+/** About `width` characters of the page around the first place a term appears. */
+export function snippetFor(text: string, terms: string[], width = 260): string {
+  const lower = text.toLowerCase();
+  let at = -1;
+  for (const term of terms) {
+    const i = lower.indexOf(term);
+    if (i >= 0 && (at < 0 || i < at)) at = i;
+  }
+  const start = Math.max(0, (at < 0 ? 0 : at) - Math.floor(width / 3));
+  const piece = text.slice(start, start + width).replace(/\s+/g, ' ').trim();
+  return (start > 0 ? '... ' : '') + piece + (start + width < text.length ? ' ...' : '');
+}
+
+export interface RuleHit {
+  uuid: string;
+  journal: string;
+  page: string;
+  source: string;
+  chars: number;
+  snippet: string;
+  score: number;
+}
+
+/** The best pages for a question, best first. */
+export function searchPages(pages: RulePage[], query: string, limit = 5): RuleHit[] {
+  const terms = queryTerms(query);
+  return pages
+    .map(p => ({ p, score: scorePage(p, terms) }))
+    .filter(x => x.score > 0)
+    .sort((a, b) => b.score - a.score)
+    .slice(0, Math.max(1, limit))
+    .map(({ p, score }) => ({ uuid: p.uuid, journal: p.journal, page: p.page, source: p.source, chars: p.text.length, snippet: snippetFor(p.text, terms), score }));
+}
+
+/** Cut text at a paragraph or sentence end near the limit, and say how much is left. */
+export function clipText(text: string, maxChars: number): { text: string; truncated: boolean; remaining: number } {
+  if (text.length <= maxChars) return { text, truncated: false, remaining: 0 };
+  const cut = text.slice(0, maxChars);
+  const at = Math.max(cut.lastIndexOf('\n'), cut.lastIndexOf('. '));
+  const end = at > maxChars * 0.6 ? at + 1 : maxChars;
+  return { text: text.slice(0, end).trimEnd(), truncated: true, remaining: text.length - end };
+}

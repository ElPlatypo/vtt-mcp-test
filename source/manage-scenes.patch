+  /** What every change returns: ids touched and the whole layout as text, so it can be checked at a glance. */
+  private summary(doc: LayoutDoc, action: string, changed: number[]): Record<string, any> {
+    const out: Record<string, any> = {
+      success: true,
+      action,
+      layout: doc.id,
+      grid: { columns: doc.columns, rows: doc.rows, squarePixels: doc.size, snap: doc.snap },
+      shapeCount: doc.shapes.length,
+      history: { undo: doc.undo?.length ?? 0, redo: doc.redo?.length ?? 0 },
+      ...(changed.length > 0 ? { ids: changed } : {}),
+      ...(doc.reference ? { reference: doc.reference } : {}),
+    };
+    if (doc.columns <= MAX_TEXT_COLUMNS && doc.rows <= MAX_TEXT_ROWS) {
+      const { text, legend } = asciiMap(doc);
+      out.map = text;
+      out.legend = legend;
+    } else {
+      out.note = 'The layout is too large for a text map; use show with a region or png:true';
+    }
+    return out;
+  }
+
+  private async show(doc: LayoutDoc, a: Args): Promise<any> {
+    if (!a.png) {
+      const view = a.region;
+      if (!view && (doc.columns > MAX_TEXT_COLUMNS || doc.rows > MAX_TEXT_ROWS)) {
+        throw new Error('The layout is too large for one text map; pass a region or png:true');
+      }
+      const { text, legend } = asciiMap(doc, view);
+      return {
+        success: true,
+        layout: doc.id,
+        grid: { columns: doc.columns, rows: doc.rows, squarePixels: doc.size, snap: doc.snap },
+        map: text,
+        legend,
+        ...(a.shapes_list ? { shapes: describeShapes(doc) } : {}),
+      };
+    }
+    const img = await renderPreview(doc, {
+      ...(a.grid !== undefined ? { grid: a.grid } : {}),
+      ...(a.labels !== undefined ? { labels: a.labels } : {}),
+      ...(a.show_reference !== undefined ? { reference: a.show_reference } : {}),
+      ...(a.hide_shapes ? { hide_shapes: true } : {}),
+      ...(a.region ? { region: a.region } : {}),
+    });
+    const file = await this.writePicture(doc, 'preview', encodePng(img.width, img.height, img.rgb));
+    return {
+      success: true,
+      layout: doc.id,
+      file,
+      width: img.width,
+      height: img.height,
+      region: img.region,
+      ...(a.shapes_list ? { shapes: describeShapes(doc) } : {}),
+    };
+  }
+
+  private async render(doc: LayoutDoc): Promise<any> {
+    if (doc.shapes.length === 0) throw new Error('The layout has no shapes yet');
+    const layout = layoutOf(doc);
+    const { width, height, rgb } = renderLayout(layout);
+    const file = await this.writePicture(doc, 'sketch', encodePng(width, height, rgb));
+    this.logger.info('Layout rendered', { layout: doc.id, width, height });
+    const multiple = width % 32 === 0 && height % 32 === 0;
+    return {
+      success: true,
+      layout: doc.id,
+      file,
+      width,
+      height,
+      grid: { columns: doc.columns, rows: doc.rows, squarePixels: doc.size },
+      legend: legendFor(layout),
+      hint:
+        'Pass file in generate-image reference_images and say that <Picture 1> is the exact floor plan to follow, then add the legend sentence (and say what any custom colour means). Remove numbers or text in the prompt. Use the same grid size for the scene.' +
+        (multiple ? '' : ' The image model rounds sizes to multiples of 32; pick columns and rows so width and height are multiples of 32 to avoid a slight stretch.'),
+    };
+  }
+
+  private async writePicture(doc: LayoutDoc, kind: string, png: Buffer): Promise<string> {
+    await fs.mkdir(this.store.folder, { recursive: true });
+    const file = path.join(this.store.folder, `${doc.id}-${kind}-${Date.now()}.png`);
+    await fs.writeFile(file, png);
+    await this.prune();
+    return file;
+  }
+
+  private async prune(): Promise<void> {
+    try {
+      const files = (await fs.readdir(this.store.folder)).filter(f => f.endsWith('.png'));
+      if (files.length <= KEEP_PICTURES) return;
+      const stats = await Promise.all(
+        files.map(async f => ({ f, t: (await fs.stat(path.join(this.store.folder, f))).mtimeMs }))
+      );
+      stats.sort((x, y) => x.t - y.t);
+      for (const { f } of stats.slice(0, files.length - KEEP_PICTURES)) {
+        await fs.rm(path.join(this.store.folder, f), { force: true });
+      }
+    } catch {
+      // cleanup is best effort
+    }
+  }
+}

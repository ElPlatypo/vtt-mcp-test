@@ -0,0 +1,94 @@
+import { describe, expect, it } from 'vitest';
+import { sceneTextMap, type TextMapData } from './scene-text-map.js';
+
+function data(extra: Partial<TextMapData> = {}): TextMapData {
+  return {
+    grid: { columns: 6, rows: 4 },
+    legend: { tokens: [], lights: [], notes: [], regions: [] },
+    walls: [],
+    ...extra,
+  };
+}
+
+function cell(text: string, col: number, row: number): string {
+  // two header lines, then two lines per square plus the top line; each line has a 3 character label
+  const lines = text.split('\n');
+  return lines[2 + row * 2 + 1]![3 + col * 2 + 1] ?? ' ';
+}
+
+describe('sceneTextMap', () => {
+  it('draws walls on grid lines and doors as D and s', () => {
+    const { text } = sceneTextMap(
+      data({
+        walls: [
+          [0, 0, 6, 0, 0],
+          [3, 0, 4, 0, 1],
+          [0, 4, 2, 4, 2],
+          [0, 0, 0, 4, 0],
+        ],
+      })
+    );
+    const lines = text.split('\n');
+    const top = lines[2]!;
+    expect(top.slice(3, 3 + 13)).toBe('######DDD####');
+    expect(lines[2 + 8]!.slice(3, 3 + 5)).toBe('sssss');
+    expect(lines[2 + 3]![3]).toBe('#');
+  });
+
+  it('puts tokens, lights and pins on square centres and lists them in the key', () => {
+    const { text, key } = sceneTextMap(
+      data({
+        legend: {
+          tokens: [
+            { n: 1, name: 'Wolf', x: 1, y: 1, width: 1, height: 1, hidden: true },
+            { n: 2, name: 'Ogre', x: 3, y: 2, width: 2, height: 2, hidden: false },
+          ],
+          lights: [{ n: 'L1', x: 2, y: 1, bright: 3, dim: 6 }],
+          notes: [{ n: 'N1', x: 0.5, y: 0.5, text: 'Cave' }],
+          regions: [],
+        },
+      })
+    );
+    expect(cell(text, 1, 1)).toBe('1');
+    for (const [c, r] of [[3, 2], [4, 2], [3, 3], [4, 3]] as const) expect(cell(text, c, r)).toBe('2');
+    expect(cell(text, 0, 0)).toBe('n');
+    expect(text.split('\n')[2 + 2]![3 + 4]).toBe('*');
+    expect(key.join('\n')).toContain('1 = Wolf (hidden) at 1,1');
+    expect(key.join('\n')).toContain('2 = Ogre at 3,2 size 2x2');
+    expect(key.join('\n')).toContain('pin "Cave"');
+  });
+
+  it('marks region squares by kind', () => {
+    const { text, key } = sceneTextMap(
+      data({
+        legend: {
+          tokens: [],
+          lights: [],
+          notes: [],
+          regions: [
+            { n: 'R1', name: 'Rubble', kinds: ['dnd5e.difficultTerrain'] },
+            { n: 'R2', name: 'Pit', kinds: ['executeMacro'] },
+          ],
+        },
+        regionShapes: [
+          [{ type: 'poly', points: [[0, 0], [2, 0], [2, 2], [0, 2]] }],
+          [{ type: 'ellipse', cx: 4.5, cy: 3.5, rx: 0.6, ry: 0.6 }],
+        ],
+      })
+    );
+    expect(cell(text, 0, 0)).toBe(':');
+    expect(cell(text, 1, 1)).toBe(':');
+    expect(cell(text, 2, 2)).toBe(' ');
+    expect(cell(text, 4, 3)).toBe('!');

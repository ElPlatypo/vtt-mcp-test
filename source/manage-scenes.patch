+        <option value="minimax-h3" {{#if isH3}}selected{{/if}}>MiniMax H3 Image (supports reference pictures)</option>
+      </select>
+    </div>
+
+    <div class="mgs-group" data-workflow-group="checkpoint" {{#unless isCheckpoint}}hidden{{/unless}}>
+      <div class="mgs-row-2">
+        <div class="mgs-form-group">
+          <label class="mgs-label">Checkpoint</label>
+          <select name="{{key}}__checkpoint" data-list="checkpoint" data-current="{{checkpoint}}"></select>
+        </div>
+      </div>
+    </div>
+
+    <div class="mgs-group" data-workflow-group="minimax-h3" {{#unless isH3}}hidden{{/unless}}>
+      <div class="mgs-row-2">
+        <div class="mgs-form-group">
+          <label class="mgs-label">Diffusion model</label>
+          <select name="{{key}}__diffusionModel" data-list="diffusion" data-current="{{diffusionModel}}"></select>
+        </div>
+        <div class="mgs-form-group">
+          <label class="mgs-label">Text encoder</label>
+          <select name="{{key}}__textEncoder" data-list="textEncoder" data-current="{{textEncoder}}"></select>
+        </div>
+      </div>
+    </div>
+
+    <div class="mgs-form-group">
+      <label class="mgs-label">VAE</label>
+      <select name="{{key}}__vae" data-list="vae" data-current="{{vae}}"></select>
+    </div>
+
+    <div class="mgs-row-4">
+      <div class="mgs-form-group">
+        <label class="mgs-label">Steps</label>
+        <input type="number" name="{{key}}__steps" value="{{steps}}" min="1" max="100" step="1" />

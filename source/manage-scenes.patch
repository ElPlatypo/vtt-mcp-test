@@ -0,0 +1,207 @@
+/** Attacks, saves and checks through the dnd5e activity and actor roll APIs (stubbed). */
+import { describe, expect, it, vi } from 'vitest';
+import { performAttack, performCheck, pickActivity, resolveKey } from './combat-actions.js';
+
+const roll = (total: number, extra: Record<string, any> = {}) => ({ total, dice: [{ results: [{ result: extra.natural ?? total, active: true }] }], options: {}, ...extra });
+
+function target(name: string, hp: number, ac: number) {
+  const system: any = { attributes: { hp: { value: hp, max: hp }, ac: { value: ac } } };
+  const actor: any = {
+    name,
+    system,
+    applyDamage: vi.fn(async (damages: any[]) => {
+      system.attributes.hp.value = Math.max(0, system.attributes.hp.value - damages.reduce((n, d) => n + d.value, 0));
+    }),
+    rollSavingThrow: vi.fn(async () => [roll(10)]),
+  };
+  return { name, actor, token: { object: { id: name } } };
+}
+
+function attacker(activityType: 'attack' | 'save', parts: Partial<Record<string, any>> = {}) {
+  const activity: any = {
+    type: activityType,
+    use: vi.fn(async () => undefined),
+    rollAttack: vi.fn(async () => [roll(parts.attack ?? 15, { natural: parts.natural ?? 12, isSuccess: parts.success ?? true, options: { target: 13 } })]),
+    rollDamage: vi.fn(async () => [{ total: parts.damage ?? 6, options: { type: 'slashing' } }]),
+    save: { ability: new Set(['dex']), dc: { value: 13 } },
+    damage: { onSave: parts.onSave ?? 'half' },
+  };
+  const item = { id: 'i1', name: 'Scimitar', system: { activities: { values: () => [activity] } } };
+  return { name: 'Goblin 1', actor: { items: { contents: [item] } }, activity };
+}
+
+describe('pickActivity', () => {
+  it('finds an item by name or the first attack', () => {
+    const a = attacker('attack');
+    expect(pickActivity(a.actor, 'scim')?.item.name).toBe('Scimitar');
+    expect(pickActivity(a.actor, undefined)?.activity).toBe(a.activity);
+    expect(pickActivity(a.actor, 'Bow')).toBeNull();
+  });
+});
+
+describe('performAttack', () => {
+  it('uses the item, targets the token, rolls the attack, damage on a hit, and applies it', async () => {
+    const a = attacker('attack', { attack: 17, damage: 5 });
+    const t = target('Mira', 12, 13);
+    const setTarget = vi.fn();
+    const r = await performAttack(a, [t], { setTarget });
+    expect(a.activity.use).toHaveBeenCalled();
+    expect(setTarget).toHaveBeenNthCalledWith(1, t);
+    expect(setTarget).toHaveBeenLastCalledWith(null);
+    expect(r.results[0]).toMatchObject({ target: 'Mira', roll: 17, natural: 12, ac: 13, hit: true, damage: 5, hp: '12 -> 7' });
+    expect(t.actor.applyDamage.mock.calls[0][0][0]).toMatchObject({ value: 5, type: 'slashing' });
+  });
+  it('does not roll damage on a miss, and passes the crit on', async () => {
+    const miss = attacker('attack', { success: false, attack: 8 });
+    const t = target('Mira', 12, 13);
+    const r = await performAttack(miss, [t], {});
+    expect(r.results[0]).toMatchObject({ hit: false });
+    expect(miss.activity.rollDamage).not.toHaveBeenCalled();
+    const crit = attacker('attack');
+    crit.activity.rollAttack = vi.fn(async () => [roll(25, { natural: 20, isCritical: true, isSuccess: true, options: { target: 13 } })]);
+    await performAttack(crit, [target('Mira', 12, 13)], {});
+    expect(crit.activity.rollDamage).toHaveBeenCalledWith({ isCritical: true }, { configure: false }, { create: true, messageMode: 'gm', rollMode: 'gmroll' });
+  });
+  it('posts rolls to the GM only unless public is asked', async () => {
+    const quiet = attacker('attack');
+    await performAttack(quiet, [target('Mira', 12, 13)], {});
+    expect(quiet.activity.rollAttack.mock.calls[0][2]).toEqual({ create: true, messageMode: 'gm', rollMode: 'gmroll' });
+    expect(quiet.activity.use.mock.calls[0][0]).toEqual({ subsequentActions: false });
+    expect(quiet.activity.use.mock.calls[0][2]).toEqual({ create: true, messageMode: 'gm', rollMode: 'gmroll' });
+    const loud = attacker('attack');
+    await performAttack(loud, [target('Mira', 12, 13)], { public: true });
+    expect(loud.activity.rollAttack.mock.calls[0][2]).toEqual({ create: true, messageMode: 'public', rollMode: 'publicroll' });
+  });
+  it('can skip consuming and applying', async () => {
+    const a = attacker('attack');
+    const t = target('Mira', 12, 13);
+    const r = await performAttack(a, [t], { consume: false, apply: false });
+    expect(a.activity.use).not.toHaveBeenCalled();
+    expect(t.actor.applyDamage).not.toHaveBeenCalled();
+    expect(r.results[0].hp).toBeUndefined();
+  });
+  it('rolls an attack with advantage and no target', async () => {
+    const a = attacker('attack');
+    const r = await performAttack(a, [], { advantage: true });
+    expect(a.activity.rollAttack).toHaveBeenCalledWith({ advantage: true }, { configure: false }, { create: true, messageMode: 'gm', rollMode: 'gmroll' });
+    expect(r.results[0].roll).toBe(15);
+  });
+  it('rolls a save once for damage and each target saves, taking half on a success', async () => {
+    const a = attacker('save', { damage: 10 });
+    const saver = target('Mira', 20, 12);
+    saver.actor.rollSavingThrow = vi.fn(async () => [roll(15)]);
+    const failer = target('Bo', 20, 12);
+    const r = await performAttack(a, [saver, failer], {});
+    expect(a.activity.rollDamage).toHaveBeenCalledTimes(1);
+    expect(r).toMatchObject({ kind: 'save', dc: 13, ability: 'dex' });
+    expect(r.results[0]).toMatchObject({ target: 'Mira', saved: true, hp: '20 -> 15' });
+    expect(r.results[1]).toMatchObject({ target: 'Bo', saved: false, hp: '20 -> 10' });
+    expect(saver.actor.rollSavingThrow).toHaveBeenCalledWith({ ability: 'dex', target: 13 }, { configure: false }, { create: true, messageMode: 'gm', rollMode: 'gmroll' });
+  });
+  it('says when there is nothing to use', async () => {
+    await expect(performAttack({ name: 'Bob', actor: { items: { contents: [] } } }, [], {})).rejects.toThrow('no attack or save');
+  });
+});
+
+describe('performCheck', () => {
+  const tables = { skills: { prc: { label: 'Perception' }, ath: { label: 'Athletics' } }, abilities: { dex: { label: 'Dexterity' }, wis: { label: 'Wisdom' } } };
+  const who = (fn: any) => [{ name: 'Mira', actor: fn }];
+  it('resolves names to keys', () => {
+    expect(resolveKey(tables.skills, 'Perception')).toBe('prc');
+    expect(resolveKey(tables.skills, 'prc')).toBe('prc');
+    expect(resolveKey(tables.abilities, 'dexterity')).toBe('dex');
+    expect(resolveKey(tables.abilities, 'luck')).toBeUndefined();
+  });
+  it('rolls a skill against a dc', async () => {
+    const actor = { rollSkill: vi.fn(async () => [roll(14, { natural: 11 })]) };
+    const r = await performCheck(who(actor), { skill: 'perception', dc: 12, advantage: true }, tables);
+    expect(actor.rollSkill).toHaveBeenCalledWith({ advantage: true, target: 12, skill: 'prc' }, { configure: false }, { create: true, messageMode: 'gm', rollMode: 'gmroll' });
+    expect(r).toMatchObject({ roll: 'prc check', dc: 12, results: [{ name: 'Mira', total: 14, natural: 11, success: true }] });
+  });
+  it('rolls saves and ability checks, and wants exactly one kind', async () => {
+    const actor = { rollSavingThrow: vi.fn(async () => [roll(7)]), rollAbilityCheck: vi.fn(async () => [roll(9)]) };
+    expect((await performCheck(who(actor), { save: 'wis', dc: 10 }, tables)).results[0]).toMatchObject({ total: 7, success: false });
+    expect((await performCheck(who(actor), { ability: 'dex' }, tables)).results[0].total).toBe(9);
+    await expect(performCheck(who(actor), { skill: 'prc', ability: 'dex' }, tables)).rejects.toThrow('exactly one');
+    await expect(performCheck(who(actor), { skill: 'juggling' }, tables)).rejects.toThrow('Unknown skill');
+  });
+});
+
+describe('markDownIfZero', () => {
+  it('makes a character at 0 hp unconscious and prone, once', async () => {
+    const { markDownIfZero } = await import('./combat-actions.js');
+    const statuses = new Set<string>();
+    const actor: any = { type: 'character', system: { attributes: { hp: { value: 0 } } }, statuses, toggleStatusEffect: vi.fn(async (id: string) => void statuses.add(id)) };
+    expect(await markDownIfZero(actor)).toEqual(['unconscious', 'prone']);
+    expect(await markDownIfZero(actor)).toEqual([]);
+  });
+  it('leaves monsters and standing characters alone', async () => {
+    const { markDownIfZero } = await import('./combat-actions.js');
+    const toggle = vi.fn();
+    expect(await markDownIfZero({ type: 'npc', system: { attributes: { hp: { value: 0 } } }, statuses: new Set(), toggleStatusEffect: toggle })).toEqual([]);
+    expect(await markDownIfZero({ type: 'character', system: { attributes: { hp: { value: 3 } } }, statuses: new Set(), toggleStatusEffect: toggle })).toEqual([]);
+    expect(toggle).not.toHaveBeenCalled();
+  });
+});
+
+describe('death saves, stabilize and surprised', () => {
+  const dying = (extra: Record<string, any> = {}) => {
+    const statuses = new Set<string>();
+    const actor: any = {
+      type: 'character',
+      uuid: 'Actor.a',
+      system: { attributes: { hp: { value: 0 }, death: { success: 1, failure: 1 } } },
+      statuses,
+      update: vi.fn(async (changes: any) => {
+        actor.system.attributes.death.success = changes['system.attributes.death.success'];
+        actor.system.attributes.death.failure = changes['system.attributes.death.failure'];
+      }),
+      toggleStatusEffect: vi.fn(async (id: string) => void statuses.add(id)),
+      createEmbeddedDocuments: vi.fn(async () => []),
+      ...extra,
+    };
+    return actor;
+  };
+  it('sets only the counts that were given and clamps them', async () => {
+    const { setDeathSaves } = await import('./combat-actions.js');
+    const actor = dying();
+    expect(await setDeathSaves(actor, { failure: 2 })).toEqual({ success: 1, failure: 2 });
+    expect(await setDeathSaves(actor, { success: 9 })).toEqual({ success: 3, failure: 2, status: 'stable' });
+  });
+  it('marks the character dead on three failures', async () => {
+    const { setDeathSaves } = await import('./combat-actions.js');
+    const actor = dying();
+    expect(await setDeathSaves(actor, { failure: 3 })).toMatchObject({ failure: 3, status: 'dead' });
+    expect(actor.toggleStatusEffect).toHaveBeenCalledWith('dead', { active: true, overlay: true });
+  });
+  it('stabilizes: three successes, no failures, still unconscious', async () => {
+    const { stabilize } = await import('./combat-actions.js');
+    const actor = dying();
+    expect(await stabilize(actor)).toEqual({ success: 3, failure: 0, status: 'stable' });
+    expect(actor.statuses.has('unconscious')).toBe(true);
+  });
+  it('gives a one-round surprised effect once', async () => {
+    const { markSurprised } = await import('./combat-actions.js');
+    const actor = dying();
+    expect(await markSurprised(actor)).toBe(true);
+    expect(actor.createEmbeddedDocuments).toHaveBeenCalledWith('ActiveEffect', [expect.objectContaining({ statuses: ['surprised'], duration: { rounds: 1 } })]);
+    actor.statuses.add('surprised');
+    expect(await markSurprised(actor)).toBe(false);
+  });
+});
+
+describe('real names', () => {
+  it('finds a token and a combatant by the GM-only real name', async () => {
+    const { pickTokens, matchCombatants, tokenRealName } = await import('./combat-utils.js');
+    const tokens = [
+      { id: 't1', name: 'Goblin Leader', actorName: 'Goblin Boss', realName: 'Yeemik' },
+      { id: 't2', name: 'Goblin', actorName: 'Goblin' },
+    ];
+    expect(pickTokens(tokens, ['yeemik']).picked.map(t => t.id)).toEqual(['t1']);
+    expect(pickTokens(tokens, ['Goblin Leader']).picked.map(t => t.id)).toEqual(['t1']);
+    const combatants = [{ id: 'c1', name: 'Goblin Leader', realName: 'Yeemik' }, { id: 'c2', name: 'Goblin' }];
+    expect(matchCombatants(combatants, 'Yeemik').map(c => c.id)).toEqual(['c1']);
+    expect(tokenRealName({ flags: { 'foundry-mcp-bridge-scenes': { realName: ' Yeemik ' } } })).toBe('Yeemik');
+    expect(tokenRealName({})).toBeUndefined();
+  });
+});

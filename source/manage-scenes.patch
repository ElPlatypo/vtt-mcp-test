+  async handleManageSceneObjects(args: any): Promise<any> {
+    const parsed = sceneObjectsSchema.parse(args);
+    if (parsed.action === 'place' && !parsed.objects) {
+      throw new Error('objects is required for place');
+    }
+    if (parsed.action === 'update' && !parsed.updates) {
+      throw new Error('updates is required for update');
+    }
+    if (parsed.action === 'remove' && !parsed.all_mine && !(parsed.ids && parsed.ids.length)) {
+      throw new Error('remove needs ids or all_mine: true');
+    }
+
+    this.logger.info('Managing scene objects', { action: parsed.action, scene: parsed.scene });
+    if (parsed.action === 'check_walls') return this.checkSceneWalls(parsed);
+    try {
+      // The label of a light is only a note for the caller; do not send it.
+      const { region: _region, ...sent } = parsed;
+      const payload = {
+        ...sent,
+        ...(parsed.objects
+          ? {
+              objects: parsed.objects.map(o => {
+                if (o.kind === 'light') {
+                  const { label: _label, ...rest } = o;
+                  return rest;
+                }
+                return o;
+              }),
+            }
+          : {}),
+      };
+      const result = await this.foundryClient.query(
+        'foundry-mcp-bridge.manage-scene-objects',
+        payload
+      );
+      if (result?.success === false) {
+        throw new Error(result.error || 'Request was refused');
+      }
+      if (parsed.action === 'describe' && parsed.kind === 'wall') return compactWallDescription(result, parsed.region);
+      return result;
+    } catch (error) {
+      this.logger.error('Failed to manage scene objects', error);
+      throw new Error(
+        `Failed to manage scene objects: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+
+  private async checkSceneWalls(parsed: { scene?: string | undefined; fix?: boolean | undefined; tolerance?: number | undefined }): Promise<any> {
+    const q = (data: any) => this.foundryClient.query('foundry-mcp-bridge.manage-scene-objects', data);
+    const scene = parsed.scene ? { scene: parsed.scene } : {};
+    const described = await q({ action: 'describe', kind: 'wall', ...scene });
+    if (described?.success === false) throw new Error(described.error || 'Could not read the scene');
+    const walls: CheckWall[] = described?.walls ?? [];
+    const issues = checkWalls(walls, parsed.tolerance !== undefined ? { tolerance: parsed.tolerance } : {});
+    const result: any = {
+      success: true,
+      scene: described?.scene,
+      wallCount: walls.length,
+      issueCount: issues.length,
+      issues: issues.slice(0, 80),
+      ...(issues.length > 80 ? { note: `${issues.length - 80} more issues not shown` } : {}),
+    };
+    if (parsed.fix) {
+      const plan = planFixes(walls, issues);
+      if (plan.remove.length > 0) {
+        const out = await q({ action: 'remove', kind: 'wall', ids: plan.remove, ...scene });
+        if (out?.success === false) throw new Error(out.error || 'Could not remove the walls to repair');
+        if (plan.place.length > 0) {
+          const placed = await q({ action: 'place', ...scene, objects: plan.place.map(p => ({ kind: 'wall', ...p })) });
+          if (placed?.success === false) throw new Error(placed.error || 'Could not place the repaired walls');
+        }
+      }
+      result.fixed = { removed: plan.remove.length, replaced: plan.place.length };
+      result.remaining = issues.filter(i => !i.fixable).length;
+    }
+    return result;
+  }

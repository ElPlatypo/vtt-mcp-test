+      'depth',
+      'embedded_identifier',
+      'embedded_type',
+      'identifier',
+      'include_embedded',
+      'limit',
+      'max_chars',
+      'path',
+      'search',
+      'type',
+      'uuid',
+    ]);
+  });
+});
+
+describe('InspectTools.handleInspectDocument', () => {
+  it('forwards list, get and schema requests', async () => {

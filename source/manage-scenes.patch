+/**
+ * "Notes for Claude": a group in the scene controls (upper left) with a select tool, a rectangle
+ * tool, a polygon tool and a notes list. The GM clicks an object or draws an area, writes what
+ * should change, and the note is kept on the scene for Claude to read (the annotations tool).
+ *
+ * This file talks to Foundry's canvas and dialogs, so it is checked by hand in Foundry; the
+ * geometry and storage it relies on are unit-tested (annotation-utils, annotation-scene).
+ */
+import { MODULE_ID } from './constants.js';
+import {
+  hitTest,
+  makeAnnotation,
+  makeArea,
+  rectPoints,
+  roundSquares,
+  targetOf,
+  type Annotation,
+  type Clickable,
+  type Point,
+} from './annotation-utils.js';
+import { readAnnotations, sceneClickables, writeAnnotations } from './annotation-scene.js';
+import { getGridGeometry } from './scene-objects-utils.js';
+
+type Mode = 'select' | 'rect' | 'polygon';
+
+const G = globalThis as any;
+const GROUP = 'mcp-annotate';
+const ORANGE = 0xff8a00;
+const BLUE = 0x2f9bff;
+
+const esc = (text: string): string =>
+  String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
+
+let mode: Mode | null = null;
+let overlay: any = null; // hover, selection and drawing
+let pins: any = null; // numbered outlines of open notes
+let hovered: Clickable | null = null;
+let dragStart: Point | null = null; // squares
+let dragNow: Point | null = null;
+let polygon: Point[] = [];
+let busy = false;
+let listening = false;
+
+// ---------- coordinates ----------
+
+function geometry(): ReturnType<typeof getGridGeometry> | null {
+  try {
+    return G.canvas?.scene ? getGridGeometry(G.canvas.scene) : null;
+  } catch {
+    return null;
+  }
+}
+
+/** A mouse event as grid squares from the top-left of the map. */
+function eventSquares(event: PointerEvent | MouseEvent): Point | null {
+  const geom = geometry();
+  const client = { x: event.clientX, y: event.clientY };
+  const point = G.canvas?.canvasCoordinatesFromClient?.(client) ?? G.canvas?.stage?.toLocal?.(new G.PIXI.Point(client.x, client.y));
+  if (!geom || !point) return null;
+  return [(point.x - geom.originX) / geom.size, (point.y - geom.originY) / geom.size];
+}
+
+const toCanvas = (geom: { size: number; originX: number; originY: number }, p: Point): [number, number] => [geom.originX + p[0] * geom.size, geom.originY + p[1] * geom.size];
+
+// ---------- drawing ----------
+
+function layerParent(): any {
+  return G.canvas?.interface ?? G.canvas?.stage;
+}
+
+function ensureLayers(): void {
+  const parent = layerParent();
+  if (!parent || !G.PIXI) return;
+  if (!pins || pins.destroyed) {
+    pins = new G.PIXI.Container();
+    pins.eventMode = 'none';
+    parent.addChild(pins);
+  }
+  if (!overlay || overlay.destroyed) {
+    overlay = new G.PIXI.Graphics();
+    overlay.eventMode = 'none';
+    parent.addChild(overlay);
+  }
+}
+
+/** Draw a closed shape with a soft fill and a line (PixiJS 7 Graphics API, as in Foundry v14). */
+function paint(g: any, color: number, fillAlpha: number, width: number, draw: () => void): void {
+  g.lineStyle(width, color, 0.95);
+  g.beginFill(color, fillAlpha);
+  draw();
+  g.endFill();
+}
+
+function strokeShape(g: any, geom: any, c: Clickable, color: number): void {
+  const cv = (p: Point) => toCanvas(geom, p);
+  if (c.at) {
+    const [x, y] = cv(c.at);
+    paint(g, color, 0.2, 3, () => g.drawCircle(x, y, geom.size * 0.45));
+  } else if (c.segment) {
+    const [x1, y1] = cv(c.segment[0]);
+    const [x2, y2] = cv(c.segment[1]);
+    g.lineStyle(6, color, 0.95);
+    g.moveTo(x1, y1);
+    g.lineTo(x2, y2);
+  } else if (c.polygon) {
+    paint(g, color, 0.12, 3, () => g.drawPolygon(c.polygon!.flatMap(p => cv(p))));
+  } else if (c.x !== undefined && c.y !== undefined && c.width !== undefined && c.height !== undefined) {
+    const [x, y] = cv([c.x, c.y]);
+    paint(g, color, 0.12, 3, () => g.drawRect(x, y, c.width! * geom.size, c.height! * geom.size));
+  }
+}
+
+function redrawOverlay(): void {
+  const geom = geometry();
+  if (!overlay || overlay.destroyed || !geom) return;
+  overlay.clear();
+  if (hovered && mode === 'select') strokeShape(overlay, geom, hovered, BLUE);
+  if (dragStart && dragNow && mode === 'rect') {
+    const pts = rectPoints(dragStart[0], dragStart[1], dragNow[0], dragNow[1]);
+    paint(overlay, BLUE, 0.18, 3, () => overlay.drawPolygon(pts.flatMap(p => toCanvas(geom, p))));
+  }
+  if (mode === 'polygon' && polygon.length > 0) {
+    const pts = dragNow ? [...polygon, dragNow] : polygon;
+    const flat = pts.flatMap(p => toCanvas(geom, p));
+    if (pts.length >= 3) paint(overlay, BLUE, 0.15, 0, () => overlay.drawPolygon(flat));
+    overlay.lineStyle(3, BLUE, 0.95);
+    overlay.moveTo(flat[0], flat[1]);
+    for (let i = 2; i + 1 < flat.length; i += 2) overlay.lineTo(flat[i], flat[i + 1]);
+    for (const p of polygon) {
+      const [px, py] = toCanvas(geom, p);
+      paint(overlay, BLUE, 1, 0, () => overlay.drawCircle(px, py, 5));
+    }
+  }
+}
+
+/** Numbered outlines of the open notes of the scene being viewed. */
+export function redrawPins(): void {
+  try {
+    if (!G.game?.user?.isGM) return;
+    ensureLayers();
+    const geom = geometry();
+    if (!pins || pins.destroyed || !geom) return;
+    pins.removeChildren().forEach((child: any) => child.destroy?.());
+    const open = readAnnotations(G.canvas.scene).filter(a => a.status === 'open');
+    const g = new G.PIXI.Graphics();
+    pins.addChild(g);
+    const clickables = sceneClickables(G.canvas.scene);
+    for (const a of open) {
+      let corner: Point = [0, 0];
+      if (a.area) {
+        paint(g, ORANGE, 0.1, 2, () => g.drawPolygon(a.area!.points.flatMap(p => toCanvas(geom, p))));
+        corner = [a.area.bbox.x, a.area.bbox.y];
+      } else if (a.target) {
+        const now = clickables.find(c => c.id === a.target!.id && c.kind === a.target!.kind);
+        if (now) {
+          strokeShape(g, geom, now, ORANGE);
+          const t = targetOf(now);
+          corner = [t.x, t.y];
+        } else {
+          corner = [a.target.x, a.target.y];
+        }
+      }
+      const [cx, cy] = toCanvas(geom, corner);
+      g.lineStyle(2, 0xffffff, 1);
+      g.beginFill(ORANGE, 1);
+      g.drawCircle(cx, cy, 11);
+      g.endFill();
+      const label = new G.PIXI.Text(String(a.number), { fontSize: 13, fontWeight: 'bold', fill: 0x000000 });
+      label.anchor?.set?.(0.5);
+      label.position.set(cx, cy);
+      pins.addChild(label);
+    }
+  } catch (error) {
+    console.warn(`[${MODULE_ID}] Could not draw the note pins:`, error);
+  }
+}
+
+// ---------- notes ----------
+
+async function askForText(title: string, summary: string): Promise<string | null> {
+  const DialogV2 = G.foundry?.applications?.api?.DialogV2;
+  if (!DialogV2) {
+    const typed = window.prompt(`${title}\n${summary}`);
+    return typed && typed.trim() ? typed : null;
+  }
+  try {
+    const result = await DialogV2.prompt({
+      window: { title },
+      content: `<p>${esc(summary)}</p><textarea name="note" rows="5" style="width:100%" autofocus placeholder="What should change? (e.g. change the picture of this prop, clean up the walls here, add three goblins)"></textarea>`,
+      ok: { label: 'Save note', callback: (_event: any, button: any) => button.form.elements.note.value },
+      rejectClose: false,
+    });
+    return typeof result === 'string' && result.trim() ? result : null;
+  } catch {
+    return null;
+  }
+}
+
+async function saveNote(input: { prompt: string; target?: ReturnType<typeof targetOf>; area?: ReturnType<typeof makeArea> }): Promise<void> {
+  const scene = G.canvas?.scene;
+  if (!scene) return;
+  const list = readAnnotations(scene);
+  const note = makeAnnotation({ scene: scene.id, sceneName: scene.name, ...input }, list);
+  await writeAnnotations(scene, [...list, note]);
+  G.ui?.notifications?.info(`Note ${note.number} saved for Claude`);
+  redrawPins();
+}
+
+async function finishSelect(point: Point): Promise<void> {
+  const hit = hitTest(sceneClickables(G.canvas.scene), point);
+  if (!hit) {
+    G.ui?.notifications?.warn('Nothing to select there. Click on a token, tile, light, wall, pin, sound, drawing or region.');
+    return;
+  }
+  const target = targetOf(hit);
+  const what = `${target.kind}${target.name ? ` "${target.name}"` : ''} at (${target.x}, ${target.y})`;
+  const prompt = await askForText('Note for Claude', `About this ${what}`);
+  if (prompt) await saveNote({ prompt, target });
+}
+
+async function finishArea(points: Point[], shape: 'rect' | 'polygon'): Promise<void> {
+  const area = makeArea(points, shape);
+  const b = area.bbox;
+  const prompt = await askForText('Note for Claude', `About this area: ${b.width} x ${b.height} squares from (${b.x}, ${b.y})`);
+  if (prompt) await saveNote({ prompt, area });
+}
+
+// ---------- pointer handling ----------
+
+function isCanvasEvent(event: Event): boolean {
+  const board = G.canvas?.app?.view ?? document.getElementById('board');
+  return !!board && event.target === board;
+}
+
+function resetDrawing(): void {
+  dragStart = null;
+  dragNow = null;
+  polygon = [];
+  hovered = null;
+  redrawOverlay();
+}
+
+function onPointerDown(event: PointerEvent): void {
+  if (!mode || busy || event.button !== 0 || !isCanvasEvent(event)) return;
+  const point = eventSquares(event);
+  if (!point) return;
+  event.preventDefault();
+  event.stopPropagation();
+  event.stopImmediatePropagation();
+  if (mode === 'select') {
+    busy = true;
+    finishSelect(point)
+      .catch(error => G.ui?.notifications?.error(String(error?.message ?? error)))
+      .finally(() => {
+        busy = false;
+        resetDrawing();
+      });
+  } else if (mode === 'rect') {
+    dragStart = point;
+    dragNow = point;
+  } else if (mode === 'polygon') {
+    polygon.push([roundSquares(point[0]), roundSquares(point[1])]);
+    dragNow = point;
+    redrawOverlay();
+  }
+}
+
+function onPointerMove(event: PointerEvent): void {
+  if (!mode || busy || !isCanvasEvent(event)) return;
+  const point = eventSquares(event);
+  if (!point) return;
+  if (mode === 'select') {
+    const hit = hitTest(sceneClickables(G.canvas.scene), point);
+    if (hit?.id !== hovered?.id || hit?.kind !== hovered?.kind) {
+      hovered = hit;
+      redrawOverlay();
+    }
+  } else if (mode === 'rect' && dragStart) {
+    dragNow = point;
+    redrawOverlay();
+  } else if (mode === 'polygon' && polygon.length > 0) {
+    dragNow = point;
+    redrawOverlay();
+  }
+}
+
+function onPointerUp(event: PointerEvent): void {
+  if (mode !== 'rect' || !dragStart || busy || event.button !== 0) return;
+  const end = eventSquares(event) ?? dragNow;
+  const start = dragStart;
+  dragStart = null;
+  dragNow = null;
+  if (!end || Math.abs(end[0] - start[0]) < 0.3 || Math.abs(end[1] - start[1]) < 0.3) {
+    redrawOverlay();
+    return;
+  }
+  busy = true;
+  finishArea(rectPoints(start[0], start[1], end[0], end[1]), 'rect')
+    .catch(error => G.ui?.notifications?.error(String(error?.message ?? error)))
+    .finally(() => {
+      busy = false;
+      resetDrawing();
+    });
+}
+
+function finishPolygon(): void {
+  if (mode !== 'polygon' || busy) return;
+  if (polygon.length < 3) {
+    G.ui?.notifications?.warn('Click at least three points, then double-click or press Enter to finish.');
+    return;
+  }
+  const points = polygon.slice();
+  busy = true;
+  finishArea(points, 'polygon')
+    .catch(error => G.ui?.notifications?.error(String(error?.message ?? error)))
+    .finally(() => {
+      busy = false;
+      resetDrawing();
+    });
+}
+
+function onDoubleClick(event: MouseEvent): void {
+  if (mode !== 'polygon' || !isCanvasEvent(event)) return;
+  event.preventDefault();
+  event.stopPropagation();
+  // the double click's second press already added a point on top of the first; drop the copy
+  if (polygon.length > 1) {
+    const [a, b] = [polygon[polygon.length - 1]!, polygon[polygon.length - 2]!];
+    if (Math.hypot(a[0] - b[0], a[1] - b[1]) < 0.2) polygon.pop();
+  }
+  finishPolygon();
+}
+
+function onKeyDown(event: KeyboardEvent): void {
+  if (!mode || busy) return;
+  const typing = (event.target as HTMLElement | null)?.matches?.('input, textarea, select, [contenteditable="true"]');
+  if (typing) return;
+  if (event.key === 'Escape') {
+    resetDrawing();
+  } else if (event.key === 'Enter' && mode === 'polygon') {
+    event.preventDefault();
+    finishPolygon();
+  } else if (event.key === 'Backspace' && mode === 'polygon' && polygon.length > 0) {
+    event.preventDefault();
+    polygon.pop();
+    redrawOverlay();
+  }
+}
+
+function startListening(): void {
+  if (listening) return;
+  listening = true;
+  document.body.addEventListener('pointerdown', onPointerDown, true);
+  document.body.addEventListener('pointermove', onPointerMove, true);
+  document.body.addEventListener('pointerup', onPointerUp, true);
+  document.body.addEventListener('dblclick', onDoubleClick, true);
+  document.addEventListener('keydown', onKeyDown, true);
+}
+
+function stopListening(): void {
+  if (!listening) return;
+  listening = false;
+  document.body.removeEventListener('pointerdown', onPointerDown, true);
+  document.body.removeEventListener('pointermove', onPointerMove, true);
+  document.body.removeEventListener('pointerup', onPointerUp, true);
+  document.body.removeEventListener('dblclick', onDoubleClick, true);
+  document.removeEventListener('keydown', onKeyDown, true);
+}
+
+function setMode(next: Mode | null): void {
+  if (next === mode) return; // the group and the tool both report a change; act once
+  mode = next;
+  resetDrawing();
+  if (next) {
+    ensureLayers();
+    startListening();
+    const hint =
+      next === 'select' ? 'Click an object to leave a note about it' : next === 'rect' ? 'Drag to draw an area' : 'Click points; double-click or Enter to finish, Backspace to undo, Esc to cancel';
+    G.ui?.notifications?.info(hint);
+  } else {
+    stopListening();
+  }
+}
+
+// ---------- notes list ----------
+
+async function openNotesPanel(): Promise<void> {
+  const scene = G.canvas?.scene;
+  if (!scene) return;
+  const DialogV2 = G.foundry?.applications?.api?.DialogV2;
+  if (!DialogV2) {
+    G.ui?.notifications?.warn('This Foundry version has no dialog for the notes list');
+    return;
+  }
+  const list: Annotation[] = readAnnotations(scene);
+  const rows = list.length
+    ? list
+        .map(a => {
+          const where = a.target ? `${a.target.kind}${a.target.name ? ` "${esc(a.target.name)}"` : ''}` : `area ${a.area!.bbox.width}x${a.area!.bbox.height}`;
+          const status = a.status === 'open' ? '' : ` <em>(${a.status})</em>`;
+          return `<li data-id="${esc(a.id)}" style="margin-bottom:6px"><strong>${a.number}.</strong> ${esc(a.prompt)}${status}<br><small>${where}</small>${
+            a.reply ? `<br><small><strong>Claude:</strong> ${esc(a.reply)}</small>` : ''
+          } <a data-del="${esc(a.id)}" title="Delete this note" style="float:right"><i class="fa-solid fa-trash"></i></a></li>`;
+        })
+        .join('')
+    : '<li><em>No notes on this scene yet.</em></li>';
+  await DialogV2.wait({
+    window: { title: `Notes for Claude: ${scene.name}` },
+    content: `<ul style="list-style:none;padding:0;margin:0;max-height:50vh;overflow:auto">${rows}</ul>`,
+    buttons: [
+      {
+        action: 'clear',
+        label: 'Clear finished',
+        callback: async () => {
+          await writeAnnotations(scene, readAnnotations(scene).filter(a => a.status === 'open'));
+          redrawPins();
+        },
+      },
+      { action: 'close', label: 'Close', default: true },
+    ],
+    render: (_event: any, dialog: any) => {
+      dialog.element?.querySelectorAll?.('[data-del]').forEach((el: HTMLElement) =>
+        el.addEventListener('click', async () => {
+          const id = el.getAttribute('data-del');
+          await writeAnnotations(scene, readAnnotations(scene).filter(a => a.id !== id));
+          el.closest('li')?.remove();
+          redrawPins();
+        })
+      );
+    },
+    rejectClose: false,
+  }).catch(() => undefined);
+}
+
+// ---------- registration ----------
+
+export function registerAnnotationUI(): void {
+  Hooks.on('getSceneControlButtons', (controls: any) => {
+    try {
+      if (!G.game?.user?.isGM) return;
+      const tool = (name: Mode, order: number, title: string, icon: string) => ({
+        name,
+        order,
+        title,
+        icon,
+        onChange: (_event: any, active: boolean) => {
+          if (active !== false) setMode(name);
+        },
+      });
+      controls[GROUP] = {
+        name: GROUP,
+        order: 99,
+        title: 'Notes for Claude',
+        icon: 'fa-solid fa-comment-dots',
+        visible: true,
+        activeTool: 'select',
+        onChange: (_event: any, active: boolean) => {
+          const current = G.ui?.controls?.tool?.name;
+          if (active) setMode(current === 'rect' || current === 'polygon' ? current : 'select');
+          else setMode(null);
+        },
+        tools: {
+          select: tool('select', 1, 'Select an object and leave a note', 'fa-solid fa-arrow-pointer'),
+          rect: tool('rect', 2, 'Draw a rectangle and leave a note', 'fa-solid fa-vector-square'),
+          polygon: tool('polygon', 3, 'Draw an area and leave a note', 'fa-solid fa-draw-polygon'),
+          list: {
+            name: 'list',
+            order: 4,
+            title: 'Notes on this scene',
+            icon: 'fa-solid fa-list-check',
+            button: true,
+            onChange: () => {
+              void openNotesPanel();
+            },
+          },
+        },
+      };
+    } catch (error) {
+      console.warn(`[${MODULE_ID}] Could not add the notes tools:`, error);
+    }
+  });
+
+  Hooks.on('canvasReady', () => {
+    overlay = null;
+    pins = null;
+    redrawPins();
+  });
+  Hooks.on('canvasTearDown', () => {
+    setMode(null);
+    overlay = null;
+    pins = null;
+  });
+  Hooks.on('updateScene', (scene: any) => {
+    if (scene?.id === G.canvas?.scene?.id) redrawPins();
+  });
+}

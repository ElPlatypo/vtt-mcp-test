@@ -0,0 +1,53 @@
+/**
+ * What a ComfyUI offers: its checkpoints, VAEs, samplers and schedulers, read from /object_info.
+ * Used to fill the choices in the image generation settings.
+ */
+
+export interface ComfyModels {
+  checkpoints: string[];
+  diffusionModels: string[];
+  textEncoders: string[];
+  vaes: string[];
+  samplers: string[];
+  schedulers: string[];
+}
+
+/**
+ * The list of allowed values of one input. ComfyUI sends either `[["a","b"], {...}]` or, in
+ * newer versions, `["COMBO", {"options": ["a","b"]}]`.
+ */
+export function comboOptions(spec: unknown): string[] {
+  if (!Array.isArray(spec)) return [];
+  const first = spec[0];
+  let options: unknown;
+  if (Array.isArray(first)) {
+    options = first;
+  } else if (first === 'COMBO') {
+    options = (spec[1] as { options?: unknown } | undefined)?.options;
+  }
+  return Array.isArray(options) ? options.filter((o): o is string => typeof o === 'string') : [];
+}
+
+function inputOptions(info: unknown, node: string, input: string): string[] {
+  const required = (info as any)?.[node]?.input?.required;
+  const optional = (info as any)?.[node]?.input?.optional;
+  return comboOptions(required?.[input] ?? optional?.[input]);
+}
+
+/** Combine the /object_info answers for the loader and sampler nodes. */
+export function parseComfyModels(parts: {
+  checkpointLoader?: unknown;
+  unetLoader?: unknown;
+  clipLoader?: unknown;
+  vaeLoader?: unknown;
+  ksampler?: unknown;
+}): ComfyModels {
+  return {
+    checkpoints: inputOptions(parts.checkpointLoader, 'CheckpointLoaderSimple', 'ckpt_name'),
+    diffusionModels: inputOptions(parts.unetLoader, 'UNETLoader', 'unet_name'),
+    textEncoders: inputOptions(parts.clipLoader, 'CLIPLoader', 'clip_name'),
+    vaes: inputOptions(parts.vaeLoader, 'VAELoader', 'vae_name'),
+    samplers: inputOptions(parts.ksampler, 'KSampler', 'sampler_name'),
+    schedulers: inputOptions(parts.ksampler, 'KSampler', 'scheduler'),
+  };
+}

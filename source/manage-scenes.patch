+/** Preview result without the parts the caller does not need: the legend only for what is in view, and only when labels are on. */
+export function slimPreviewInfo(info: any, sent: any, wantLegend: boolean | undefined): any {
+  const { legend, layers: _layers, labelEvery: _every, ...rest } = info;
+  const show = wantLegend ?? sent.labels !== 'none';
+  if (!show || !legend) return rest;
+  const view = info.region as { x: number; y: number; width: number; height: number } | undefined;
+  const inView = (x: number, y: number, w = 0, h = 0) =>
+    !view || (x + w >= view.x && x <= view.x + view.width && y + h >= view.y && y <= view.y + view.height);
+  return {
+    ...rest,
+    legend: {
+      ...(legend.tokens ? { tokens: legend.tokens.filter((t: any) => inView(t.x, t.y, t.width, t.height)) } : {}),
+      ...(legend.lights ? { lights: legend.lights.filter((l: any) => inView(l.x, l.y)) } : {}),
+      ...(legend.notes ? { notes: legend.notes.filter((n: any) => inView(n.x, n.y)) } : {}),
+      ...(legend.tiles ? { tiles: legend.tiles } : {}),
+      ...(!view && legend.regions ? { regions: legend.regions } : {}),
+    },
+  };

+import { describe, expect, it } from 'vitest';
+import { buildMacroData, buildTableResults } from './play-utils.js';
+
+describe('buildTableResults', () => {
+  it('numbers rows in order by weight and picks the formula', () => {
+    const t = buildTableResults([{ text: 'Wolves' }, { text: 'Goblins', weight: 3 }, { text: 'Nothing' }]);
+    expect(t.results.map(r => r.range)).toEqual([[1, 1], [2, 4], [5, 5]]);
+    expect(t.results[1]).toMatchObject({ type: 'text', name: 'Goblins', weight: 3, drawn: false });
+    expect(t.total).toBe(5);
+    expect(t.formula).toBe('1d5');
+  });
+
+  it('accepts exact ranges and derives weight from them', () => {
+    const t = buildTableResults([
+      { text: 'Low', range: [1, 10] },
+      { text: 'High', range: [11, 20] },
+    ]);
+    expect(t.results[0].weight).toBe(10);
+    expect(t.formula).toBe('1d20');
+  });
+
+  it('rejects bad tables', () => {
+    expect(() => buildTableResults([])).toThrow();
+    expect(() => buildTableResults([{ text: ' ' }])).toThrow('text');
+    expect(() => buildTableResults([{ text: 'a', range: [1, 2] }, { text: 'b' }])).toThrow('every row or on none');
+    expect(() => buildTableResults([{ text: 'a', range: [1, 5] }, { text: 'b', range: [5, 6] }])).toThrow('overlaps');
+    expect(() => buildTableResults([{ text: 'a', range: [3, 2] }])).toThrow('above high');
+    expect(() => buildTableResults([{ text: 'a', range: [2, 3] }])).toThrow('start at 1');
+    expect(() => buildTableResults([{ text: 'a', weight: 0 }])).toThrow('weight');
+  });
+});
+
+describe('buildMacroData', () => {
+  it('builds a global script macro by default', () => {
+    expect(buildMacroData({ name: ' Pit ', command: 'ui.notifications.info("x")' })).toEqual({
+      name: 'Pit',
+      type: 'script',
+      scope: 'global',
+      command: 'ui.notifications.info("x")',
+    });
+  });
+
+  it('rejects bad macros', () => {
+    expect(() => buildMacroData({ command: 'x' })).toThrow('name');
+    expect(() => buildMacroData({ name: 'a' })).toThrow('command');
+    expect(() => buildMacroData({ name: 'a', command: 'x', type: 'python' })).toThrow('type');
+    expect(() => buildMacroData({ name: 'a', command: 'x'.repeat(20001) })).toThrow('longer');
+  });
+});

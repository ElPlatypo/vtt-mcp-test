+/**
+ * upload-file tool tests: the MCP server side. It reads a file from this computer, checks
+ * it really is an image, and forwards it to the bridge. The module re-checks everything
+ * and does the actual upload (see foundry-module/src/data-access.upload-file.test.ts).
+ */
+
+import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';
+import { promises as fs } from 'fs';
+import os from 'os';
+import path from 'path';
+import { UploadTools, UPLOAD_MAX_BYTES, detectImageType } from './upload.js';
+
+const PNG = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3, 4]);
+
+let dir: string;
+
+beforeAll(async () => {
+  dir = await fs.mkdtemp(path.join(os.tmpdir(), 'upload-tool-test-'));
+});
+
+afterAll(async () => {
+  await fs.rm(dir, { recursive: true, force: true });
+});
+
+function makeTools(queryImpl?: (method: string, data: any, timeout?: number) => unknown) {
+  const query = vi.fn(
+    queryImpl ?? (async () => ({ success: true, path: 'worlds/w/uploads/map.png', bytes: 12 }))
+  );
+  const logger: any = {
+    info: vi.fn(),
+    debug: vi.fn(),
+    error: vi.fn(),
+    warn: vi.fn(),
+    child: () => logger,
+  };
+  const tools = new UploadTools({ foundryClient: { query } as any, logger });
+  return { tools, query };
+}
+
+async function writeFile(name: string, content: Buffer | string): Promise<string> {
+  const file = path.join(dir, name);
+  await fs.writeFile(file, content);
+  return file;
+}
+
+describe('upload-file tool definition', () => {
+  it('requires only file_path and advertises the options', () => {
+    const def = makeTools().tools.getToolDefinitions()[0];
+    expect(def.name).toBe('upload-file');
+    expect(def.inputSchema.required).toEqual(['file_path']);
+    const props = def.inputSchema.properties as Record<string, any>;
+    expect(Object.keys(props).sort()).toEqual(['file_path', 'filename', 'folder', 'overwrite']);
+  });
+});
+
+describe('UploadTools.handleUploadFile', () => {
+  it('reads the image, base64-encodes it and forwards it with a long timeout', async () => {
+    const file = await writeFile('map.png', PNG);
+    const { tools, query } = makeTools();
+
+    const result = await tools.handleUploadFile({ file_path: file });
+
+    expect(query).toHaveBeenCalledTimes(1);
+    const [method, data, timeout] = query.mock.calls[0];
+    expect(method).toBe('foundry-mcp-bridge.upload-file');
+    expect(data).toEqual({ filename: 'map.png', imageData: PNG.toString('base64') });
+    expect(timeout).toBe(120000);
+    expect(result).toMatchObject({ success: true, path: 'worlds/w/uploads/map.png' });
+  });
+
+  it('passes folder, filename and overwrite through', async () => {
+    const file = await writeFile('original.png', PNG);
+    const { tools, query } = makeTools();
+
+    await tools.handleUploadFile({
+      file_path: file,
+      folder: 'maps/cave',
+      filename: 'renamed.png',
+      overwrite: true,
+    });
+
+    expect(query.mock.calls[0][1]).toMatchObject({
+      filename: 'renamed.png',
+      folder: 'maps/cave',
+      overwrite: true,
+    });
+  });
+
+  it('refuses a relative path', async () => {
+    const { tools, query } = makeTools();
+
+    await expect(tools.handleUploadFile({ file_path: 'map.png' })).rejects.toThrow(
+      'file_path must be an absolute path'
+    );
+    expect(query).not.toHaveBeenCalled();
+  });
+
+  it('refuses a file that does not exist', async () => {
+    const { tools, query } = makeTools();
+
+    await expect(
+      tools.handleUploadFile({ file_path: path.join(dir, 'missing.png') })
+    ).rejects.toThrow('File not found');
+    expect(query).not.toHaveBeenCalled();
+  });
+
+  it('refuses a directory', async () => {
+    const sub = path.join(dir, 'folder.png');
+    await fs.mkdir(sub, { recursive: true });
+    const { tools, query } = makeTools();
+
+    await expect(tools.handleUploadFile({ file_path: sub })).rejects.toThrow('Not a regular file');
+    expect(query).not.toHaveBeenCalled();
+  });
+
+  it.each([
+    ['a text file', 'notes.txt', 'hello'],
+    ['a script', 'run.js', 'process.exit()'],
+    ['an SVG', 'pic.svg', '<svg></svg>'],
+  ])('refuses %s by extension', async (_label, name, content) => {
+    const file = await writeFile(name, content);
+    const { tools, query } = makeTools();
+
+    await expect(tools.handleUploadFile({ file_path: file })).rejects.toThrow(
+      /Unsupported file type/
+    );
+    expect(query).not.toHaveBeenCalled();
+  });
+
+  it('refuses a file that is not really an image, whatever its name says', async () => {
+    const file = await writeFile('fake.png', 'this is a text file renamed to .png');
+    const { tools, query } = makeTools();
+
+    await expect(tools.handleUploadFile({ file_path: file })).rejects.toThrow(
+      'not a PNG, JPEG, WebP or GIF image'
+    );
+    expect(query).not.toHaveBeenCalled();
+  });
+
+  it('refuses an image whose name says a different type', async () => {
+    const file = await writeFile('actually-png.jpg', PNG);
+    const { tools, query } = makeTools();
+
+    await expect(tools.handleUploadFile({ file_path: file })).rejects.toThrow(
+      'content is PNG but its name says ".jpg"'
+    );
+    expect(query).not.toHaveBeenCalled();
+  });
+
+  it('refuses an empty file', async () => {
+    const file = await writeFile('empty.png', Buffer.alloc(0));
+    const { tools, query } = makeTools();
+
+    await expect(tools.handleUploadFile({ file_path: file })).rejects.toThrow('The file is empty');
+    expect(query).not.toHaveBeenCalled();
+  });
+
+  it('refuses a file over the size limit without reading it', async () => {
+    const file = path.join(dir, 'huge.png');
+    const handle = await fs.open(file, 'w');
+    await handle.truncate(UPLOAD_MAX_BYTES + 1); // sparse: cheap to create
+    await handle.close();
+    const { tools, query } = makeTools();
+
+    await expect(tools.handleUploadFile({ file_path: file })).rejects.toThrow('the limit is 20 MB');
+    expect(query).not.toHaveBeenCalled();
+  });
+
+  it('rejects unknown arguments', async () => {
+    const file = await writeFile('map2.png', PNG);
+    const { tools } = makeTools();
+
+    await expect(
+      tools.handleUploadFile({ file_path: file, destination: '/etc' })
+    ).rejects.toThrow();
+  });
+
+  it('surfaces a module refusal clearly', async () => {
+    const file = await writeFile('map3.png', PNG);
+    const { tools } = makeTools(async () => ({ success: false, error: 'Access denied' }));
+
+    await expect(tools.handleUploadFile({ file_path: file })).rejects.toThrow(
+      'Failed to upload file: Access denied'
+    );
+  });
+
+  it('wraps a bridge failure with context', async () => {
+    const file = await writeFile('map4.png', PNG);
+    const { tools } = makeTools(async () => {
+      throw new Error('Foundry VTT module not connected');
+    });
+
+    await expect(tools.handleUploadFile({ file_path: file })).rejects.toThrow(
+      'Failed to upload file: Foundry VTT module not connected'
+    );
+  });
+});
+
+describe('detectImageType (server copy)', () => {
+  it('recognises png, jpg, gif and webp, and nothing else', () => {
+    expect(detectImageType(PNG)).toBe('png');
+    expect(detectImageType(Uint8Array.from([0xff, 0xd8, 0xff, 0xe0]))).toBe('jpg');
+    expect(detectImageType(Uint8Array.from([0x47, 0x49, 0x46, 0x38, 0x39, 0x61]))).toBe('gif');
+    expect(
+      detectImageType(Uint8Array.from([0x52, 0x49, 0x46, 0x46, 0, 0, 0, 0, 0x57, 0x45, 0x42, 0x50]))
+    ).toBe('webp');
+    expect(detectImageType(Buffer.from('<svg>'))).toBeNull();
+  });
+});
diff --git a/packages/mcp-server/src/tools/upload.ts b/packages/mcp-server/src/tools/upload.ts
new file mode 100644
index 0000000..386d634
--- /dev/null
+++ b/packages/mcp-server/src/tools/upload.ts
@@ -0,0 +1,188 @@
+import { promises as fs } from 'fs';
+import path from 'path';
+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+
+export interface UploadToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+/** 20 MB. The module enforces the same limit. */
+export const UPLOAD_MAX_BYTES = 20 * 1024 * 1024;
+
+/** Uploading to a remote server can take a while; the default query timeout is 10 s. */
+const UPLOAD_TIMEOUT_MS = 120000;
+
+const ALLOWED_EXTENSIONS = ['png', 'jpg', 'jpeg', 'webp', 'gif'];
+
+/** Identify an image by its first bytes (png, jpg, gif, webp). */
+export function detectImageType(bytes: Uint8Array): 'png' | 'jpg' | 'gif' | 'webp' | null {
+  const b = bytes;
+  if (
+    b.length >= 8 &&
+    b[0] === 0x89 &&
+    b[1] === 0x50 &&
+    b[2] === 0x4e &&
+    b[3] === 0x47 &&
+    b[4] === 0x0d &&
+    b[5] === 0x0a &&
+    b[6] === 0x1a &&
+    b[7] === 0x0a
+  ) {
+    return 'png';
+  }
+  if (b.length >= 3 && b[0] === 0xff && b[1] === 0xd8 && b[2] === 0xff) return 'jpg';
+  if (
+    b.length >= 6 &&
+    b[0] === 0x47 &&
+    b[1] === 0x49 &&
+    b[2] === 0x46 &&
+    b[3] === 0x38 &&
+    (b[4] === 0x37 || b[4] === 0x39) &&
+    b[5] === 0x61
+  ) {
+    return 'gif';
+  }
+  if (
+    b.length >= 12 &&
+    b[0] === 0x52 &&
+    b[1] === 0x49 &&
+    b[2] === 0x46 &&
+    b[3] === 0x46 &&
+    b[8] === 0x57 &&
+    b[9] === 0x45 &&
+    b[10] === 0x42 &&
+    b[11] === 0x50
+  ) {
+    return 'webp';
+  }
+  return null;
+}
+
+export class UploadTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: UploadToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'UploadTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'upload-file',
+        description:
+          "Upload an image from this computer to the Foundry server, into the current world's own folder (worlds/<world>/uploads/...). Returns the Foundry path, which can be used directly as a scene background (manage-scenes) or an actor or token image. Only png, jpg, webp and gif images up to 20 MB are accepted; the file must really be an image. Existing files are not replaced unless overwrite is true.",
+        inputSchema: {
+          type: 'object',
+          properties: {
+            file_path: {
+              type: 'string',
+              description: 'Absolute path of the image file on this computer',
+            },
+            folder: {
+              type: 'string',
+              description:
+                'Optional sub-folder below the world upload folder, up to 3 levels of letters, digits, dash and underscore (e.g. "maps" or "maps/phandelver")',
+            },
+            filename: {
+              type: 'string',
+              description:
+                'Optional name to store it under (letters, digits, dot, dash, underscore). Defaults to the original file name.',
+            },
+            overwrite: {
+              type: 'boolean',
+              description: 'Replace a file with the same name if one exists (default: false)',
+            },
+          },
+          required: ['file_path'],
+        },
+      },
+    ];
+  }
+
+  async handleUploadFile(args: any): Promise<any> {
+    const schema = z
+      .object({
+        file_path: z.string().min(1),
+        folder: z.string().optional(),
+        filename: z.string().min(1).optional(),
+        overwrite: z.boolean().optional(),
+      })
+      .strict();
+    const parsed = schema.parse(args);
+
+    if (!path.isAbsolute(parsed.file_path)) {
+      throw new Error('file_path must be an absolute path');
+    }
+
+    const storedName = parsed.filename ?? path.basename(parsed.file_path);
+    const extension = path.extname(storedName).slice(1).toLowerCase();
+    if (!ALLOWED_EXTENSIONS.includes(extension)) {
+      throw new Error(
+        `Unsupported file type ".${extension}". Allowed: ${ALLOWED_EXTENSIONS.join(', ')}`
+      );
+    }
+
+    let stat;
+    try {
+      stat = await fs.stat(parsed.file_path);
+    } catch {
+      throw new Error(`File not found: ${parsed.file_path}`);
+    }
+    if (!stat.isFile()) {
+      throw new Error(`Not a regular file: ${parsed.file_path}`);
+    }
+    if (stat.size === 0) {
+      throw new Error('The file is empty');
+    }
+    if (stat.size > UPLOAD_MAX_BYTES) {
+      throw new Error(
+        `The file is ${(stat.size / 1024 / 1024).toFixed(1)} MB; the limit is ${UPLOAD_MAX_BYTES / 1024 / 1024} MB`
+      );
+    }
+
+    const bytes = await fs.readFile(parsed.file_path);
+    const detected = detectImageType(bytes);
+    if (!detected) {
+      throw new Error('The file is not a PNG, JPEG, WebP or GIF image');
+    }
+    if ((extension === 'jpeg' ? 'jpg' : extension) !== detected) {
+      throw new Error(
+        `The file content is ${detected.toUpperCase()} but its name says ".${extension}"`
+      );
+    }
+
+    this.logger.info('Uploading file to Foundry', {
+      name: storedName,
+      bytes: bytes.length,
+      folder: parsed.folder,
+    });
+
+    try {
+      const result = await this.foundryClient.query(
+        'foundry-mcp-bridge.upload-file',
+        {
+          filename: storedName,
+          imageData: bytes.toString('base64'),
+          ...(parsed.folder ? { folder: parsed.folder } : {}),
+          ...(parsed.overwrite ? { overwrite: true } : {}),
+        },
+        UPLOAD_TIMEOUT_MS
+      );
+      if (result?.success === false) {
+        throw new Error(result.error || 'Upload was refused');
+      }
+      this.logger.info('File uploaded to Foundry', { path: result?.path });
+      return { success: true, ...result };
+    } catch (error) {
+      this.logger.error('Failed to upload file', error);
+      throw new Error(
+        `Failed to upload file: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+}

diff --git a/packages/mcp-server/src/tools/scene-text-map.ts b/packages/mcp-server/src/tools/scene-text-map.ts
new file mode 100644
index 0000000..dcbe47a
--- /dev/null
+++ b/packages/mcp-server/src/tools/scene-text-map.ts
@@ -0,0 +1,135 @@
+/**
+ * A text picture of a scene (no image needed): walls, doors, tokens, lights, pins and regions
+ * on a character grid, so a crowded scene can be checked exactly. Every square is two
+ * characters wide and two tall: grid points sit on the even positions and square centres on the
+ * odd ones, so walls (which run along grid lines and half squares) show where they really are.
+ */
+
+export interface TextMapToken {
+  n: number;
+  name: string;
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+  hidden: boolean;
+}
+
+export interface TextMapData {
+  grid: { columns: number; rows: number };
+  legend: {
+    tokens: TextMapToken[];
+    lights: Array<{ n: string; x: number; y: number; bright: number; dim: number }>;
+    notes: Array<{ n: string; x: number; y: number; text: string }>;
+    regions: Array<{ n: string; name: string; kinds: string[] }>;
+  };
+  /** [x1, y1, x2, y2, door] in squares; door 0 wall, 1 door, 2 secret door. */
+  walls: number[][];
+  /** Outlines of the regions in the same order as legend.regions. */
+  regionShapes?: Array<Array<{ type: 'poly'; points: Array<[number, number]> } | { type: 'ellipse'; cx: number; cy: number; rx: number; ry: number }>>;
+}
+
+const MAX_SQUARES = 120;
+const TOKEN_CHARS = '123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
+
+function inPoly(x: number, y: number, pts: Array<[number, number]>): boolean {
+  let inside = false;
+  for (let i = 0, j = pts.length - 1; i < pts.length; j = i++) {
+    const [xi, yi] = pts[i]!;
+    const [xj, yj] = pts[j]!;
+    if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) inside = !inside;
+  }
+  return inside;
+}
+
+function regionChar(kinds: string[]): string {
+  const k = kinds.join(' ').toLowerCase();
+  if (k.includes('difficult')) return ':';
+  if (k.includes('macro') || k.includes('trap')) return '!';
+  if (k.includes('teleport')) return 'T';
+  return '~';
+}
+
+export function sceneTextMap(data: TextMapData): { text: string; key: string[] } {
+  const { columns, rows } = data.grid;
+  if (columns > MAX_SQUARES || rows > MAX_SQUARES) {
+    throw new Error(`The scene is ${columns} x ${rows} squares; the text map handles up to ${MAX_SQUARES} x ${MAX_SQUARES}`);
+  }
+  const W = columns * 2 + 1;
+  const H = rows * 2 + 1;
+  const cells: string[][] = Array.from({ length: H }, () => Array(W).fill(' '));
+
+  // Regions first (under everything else), on square centres.
+  (data.regionShapes ?? []).forEach((shapes, i) => {
+    const ch = regionChar(data.legend.regions[i]?.kinds ?? []);
+    for (let r = 0; r < rows; r++) {
+      for (let c = 0; c < columns; c++) {
+        const px = c + 0.5;
+        const py = r + 0.5;
+        const hit = shapes.some(s =>
+          s.type === 'poly'
+            ? inPoly(px, py, s.points)
+            : ((px - s.cx) / s.rx) ** 2 + ((py - s.cy) / s.ry) ** 2 <= 1
+        );
+        if (hit) cells[r * 2 + 1]![c * 2 + 1] = ch;
+      }
+    }
+  });
+
+  // Walls: sampled every quarter square.
+  for (const [x1, y1, x2, y2, door] of data.walls as Array<[number, number, number, number, number]>) {
+    const len = Math.hypot(x2 - x1, y2 - y1);
+    const steps = Math.max(1, Math.ceil(len * 4));
+    const ch = door === 2 ? 's' : door === 1 ? 'D' : '#';
+    for (let i = 0; i <= steps; i++) {
+      const x = Math.round((x1 + ((x2 - x1) * i) / steps) * 2);
+      const y = Math.round((y1 + ((y2 - y1) * i) / steps) * 2);
+      if (x < 0 || y < 0 || x >= W || y >= H) continue;
+      const prev = cells[y]![x]!;
+      // A door stays visible where it meets a wall.
+      if (ch === '#' && (prev === 'D' || prev === 's')) continue;
+      cells[y]![x] = ch;
+    }
+  }
+
+  // Lights, pins and tokens on top.
+  for (const l of data.legend.lights) {
+    const x = Math.round(l.x * 2);
+    const y = Math.round(l.y * 2);
+    if (x >= 0 && y >= 0 && x < W && y < H) cells[y]![x] = '*';
+  }
+  for (const n of data.legend.notes) {
+    const x = Math.round(n.x * 2);
+    const y = Math.round(n.y * 2);
+    if (x >= 0 && y >= 0 && x < W && y < H) cells[y]![x] = 'n';
+  }
+  const key: string[] = [];
+  data.legend.tokens.forEach((t, i) => {
+    const ch = TOKEN_CHARS[i] ?? '?';
+    for (let dy = 0; dy < Math.max(1, Math.round(t.height)); dy++) {
+      for (let dx = 0; dx < Math.max(1, Math.round(t.width)); dx++) {
+        const x = (Math.floor(t.x) + dx) * 2 + 1;
+        const y = (Math.floor(t.y) + dy) * 2 + 1;
+        if (x >= 0 && y >= 0 && x < W && y < H) cells[y]![x] = ch;
+      }
+    }
+    key.push(`${ch} = ${t.name}${t.hidden ? ' (hidden)' : ''} at ${t.x},${t.y}${t.width !== 1 || t.height !== 1 ? ` size ${t.width}x${t.height}` : ''}`);
+  });
+  data.legend.lights.forEach(l => key.push(`* ${l.n} light at ${l.x},${l.y} (bright ${l.bright}, dim ${l.dim})`));
+  data.legend.notes.forEach(n => key.push(`n ${n.n} pin "${n.text}" at ${n.x},${n.y}`));
+  data.legend.regions.forEach(r => key.push(`${regionChar(r.kinds)} ${r.n} region "${r.name}"${r.kinds.length ? ` (${r.kinds.join(', ')})` : ''}`));
+
+  // Column ruler: tens and ones above each square centre.
+  const tens: string[] = Array(W + 3).fill(' ');
+  const ones: string[] = Array(W + 3).fill(' ');
+  for (let c = 0; c < columns; c++) {
+    if (c % 10 === 0) tens[3 + c * 2 + 1] = String(Math.floor(c / 10) % 10);
+    ones[3 + c * 2 + 1] = String(c % 10);
+  }
+  const lines = [tens.join('').trimEnd(), ones.join('').trimEnd()];
+  for (let y = 0; y < H; y++) {
+    const label = y % 2 === 1 ? String((y - 1) / 2).padStart(2) : '  ';
+    lines.push(`${label} ${cells[y]!.join('')}`.trimEnd());
+  }
+  return { text: lines.join('\n'), key: ['# wall   D door   s secret door   * light   n pin   : difficult terrain   ! trap region   ~ other region', ...key] };
+}

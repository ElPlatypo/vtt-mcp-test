+++ b/packages/foundry-module/src/speech-player.ts
@@ -0,0 +1,301 @@
+import { MODULE_ID } from './constants.js';
+import { escapeHtml, planSegment, segmentsEnd, segmentsHtml, segmentsText, speechSettingsFrom, type SpeechSegment } from './speech-utils.js';
+
+/**
+ * Narration at the table. The MCP server sends the audio in pieces; the GM's browser decides when each piece
+ * starts (in server time) and tells everyone through the module socket; every browser fetches the piece
+ * and plays it at that moment with Web Audio, so the pieces join without gaps and every player hears the
+ * same thing at the same time. The chat message is created with the first piece and grows with each one;
+ * each browser reveals its words in time with the audio.
+ */
+
+interface Session {
+  nextStart: number | undefined;
+  segments: SpeechSegment[];
+  sync: boolean;
+  speaker: string;
+  /** the chat speaker (alias, actor, token) when the line is spoken as a character on the scene */
+  speakerData?: Record<string, unknown>;
+  /** the token on the canvas that shows the speech bubble */
+  tokenObject?: any;
+  messageId?: string;
+  /** chat updates run in order */
+  chain: Promise<unknown>;
+}
+
+interface PlayOrder {
+  type: 'tts';
+  op: 'play';
+  id: string;
+  url: string;
+  start: number;
+  seconds: number;
+}
+
+const SOCKET = `module.${MODULE_ID}`;
+
+export class SpeechPlayer {
+  private sessions = new Map<string, Session>();
+  /** server time the last queued audio of the whole world ends: one timeline, so speeches never overlap */
+  private laneEnd = 0;
+  private sources = new Set<AudioBufferSourceNode>();
+  private buffers = new Map<string, Promise<AudioBuffer | null>>();
+  private gain: GainNode | null = null;
+  /** narration messages whose popup notification stays open until their audio has ended: message id to end time */
+  private holds = new Map<string, number>();
+  private holdTimer: ReturnType<typeof setInterval> | undefined;
+  private inactiveTimer: ReturnType<typeof setTimeout> | undefined;
+
+  /** Listen for the GM's orders and reveal narrated chat messages. Call once, when the game is ready. */
+  attach(): void {
+    (game as any).socket?.on(SOCKET, (data: any) => {
+      if (data?.type !== 'tts') return;
+      if (data.op === 'play') void this.play(data as PlayOrder);
+      else if (data.op === 'stop') this.silence();
+    });
+    Hooks.on('renderChatMessageHTML', (message: any, html: HTMLElement) => this.reveal(message, html));
+  }
+
+  // ------------------------------------------------------------ GM side
+
+  /** The `speak` query from the MCP server. */
+  async handle(data: any): Promise<any> {
+    const action = data?.action;
+    if (action === 'lane-end') {
+      // How long until everything queued so far has been spoken to the end; the server holds its posts for that long.
+      return { success: true, wait: Math.max(0, this.laneEnd - this.now()) };
+    }
+    if (action === 'stop') {
+      this.laneEnd = 0;
+      this.sessions.clear();
+      this.broadcast({ type: 'tts', op: 'stop' });
+      this.silence();
+      return { success: true, stopped: true };
+    }
+    if (action === 'end') {
+      const id = String(data.id ?? '');
+      const session = this.sessions.get(id);
+      if (session) {
+        const wait = Math.max(0, (session.nextStart ?? 0) - this.now()) + 5000;
+        setTimeout(() => this.sessions.delete(id), wait);
+      }
+      return { success: true };
+    }
+    if (action !== 'queue') return { success: false, error: `Unknown speak action: ${String(action)}` };
+
+    const id = String(data.id ?? '');
+    const path = String(data.path ?? '');
+    const seconds = Number(data.audioSeconds);
+    if (!id || !path || !Number.isFinite(seconds) || seconds <= 0) return { success: false, error: 'queue needs id, path and audioSeconds' };
+
+    let session = this.sessions.get(id);
+    if (!session) {
+      session = { nextStart: undefined, segments: [], sync: data.sync !== false, speaker: String(data.speaker || 'Narrator'), chain: Promise.resolve() };
+      this.resolveSpeaker(session, data);
+      this.sessions.set(id, session);
+    }
+    const plan = planSegment(session.nextStart, this.now(), seconds, Number(data.startDelayMs) || 0, this.laneEnd);
+    session.nextStart = plan.nextStart;
+    this.laneEnd = Math.max(this.laneEnd, plan.nextStart);
+    const url = path.startsWith('/') || /^https?:/.test(path) ? path : `/${path}`;
+    this.broadcast({ type: 'tts', op: 'play', id, url, start: plan.start, seconds });
+    void this.play({ type: 'tts', op: 'play', id, url, start: plan.start, seconds });
+    if (data.bubbleText && session.tokenObject) this.bubble(session.tokenObject, String(data.bubbleText), plan.start);
+
+    let messageId = session.messageId;
+    if (session.sync) {
+      session.segments.push({ text: String(data.text ?? ''), at: plan.start, seconds });
+      const first = session.messageId === undefined;
+      const work = session.chain.then(() => this.writeMessage(session!)).catch(error => console.error(`[${MODULE_ID}] narration chat message failed:`, error));
+      session.chain = work;
+      if (first) await work; // the first call reports the message id
+      messageId = session.messageId;
+    }
+    return { success: true, ...(messageId ? { messageId } : {}), start: plan.start };
+  }
+
+  /** The token or actor the line is spoken as, if any: the chat message then carries it and a bubble shows over the token. */
+  private resolveSpeaker(session: Session, data: any): void {
+    try {
+      const scene = (globalThis as any).canvas?.scene;
+      let tokenDoc: any = data.tokenId ? scene?.tokens?.get(String(data.tokenId)) : undefined;
+      let actor: any = tokenDoc?.actor;
+      if (!tokenDoc && data.actorIdentifier) {
+        const key = String(data.actorIdentifier);
+        actor = (game as any).actors?.get(key) ?? (game as any).actors?.getName(key);
+        const tokens = (actor?.getActiveTokens?.(false, true) as any[]) ?? [];
+        tokenDoc = tokens[0];
+      }
+      if (!actor && !tokenDoc) return;
+      const ChatMessageClass = (globalThis as any).ChatMessage;
+      session.speakerData = tokenDoc ? ChatMessageClass.getSpeaker({ token: tokenDoc, actor }) : ChatMessageClass.getSpeaker({ actor });
+      session.tokenObject = tokenDoc?.object;
+    } catch (error) {
+      console.warn(`[${MODULE_ID}] narration speaker not found:`, error);
+    }
+  }
+
+  /** Show the whole line as a speech bubble over the token when its audio starts. */
+  private bubble(token: any, text: string, startAt: number): void {
+    const show = () => {
+      try {
+        const result = (globalThis as any).canvas?.hud?.bubbles?.broadcast(token, escapeHtml(text), { pan: false, requireVisible: true });
+        // Not awaited: the promise waits for the previous bubble of this token to fade, which may never happen in a hidden tab.
+        Promise.resolve(result).catch(error => console.warn(`[${MODULE_ID}] narration bubble failed:`, error));
+      } catch (error) {
+        console.warn(`[${MODULE_ID}] narration bubble failed:`, error);
+      }
+    };
+    setTimeout(show, Math.max(0, startAt - this.now()));
+  }
+
+  private async writeMessage(session: Session): Promise<void> {
+    const snapshot = session.segments.map(s => ({ ...s }));
+    const content = segmentsText(snapshot);
+    const flags = { [MODULE_ID]: { tts: { segments: snapshot } } };
+    const ChatMessageClass = (globalThis as any).ChatMessage;
+    if (!session.messageId) {
+      const created = await ChatMessageClass.create({ content, speaker: session.speakerData ?? { alias: session.speaker }, flags });
+      session.messageId = created?.id;
+      return;
+    }
+    const message = (game as any).messages?.get(session.messageId);
+    if (message) await message.update({ content, [`flags.${MODULE_ID}.tts`]: { segments: snapshot } });
+  }
+
+  private broadcast(payload: Record<string, unknown>): void {
+    (game as any).socket?.emit(SOCKET, payload);
+  }
+
+  // ------------------------------------------------------------ every browser
+
+  private now(): number {
+    return (game as any).time.serverTime as number;
+  }
+
+  private volume(): number {
+    try {
+      const v = Number(game.settings.get(MODULE_ID, 'ttsVolume' as any));
+      return Number.isFinite(v) ? Math.min(1, Math.max(0, v)) : 1;
+    } catch {
+      return 1;
+    }
+  }
+
+  private context(): AudioContext | null {
+    const ctx = ((game as any).audio?.context as AudioContext | undefined) ?? null;
+    if (!ctx) return null;
+    if (!this.gain) {
+      this.gain = ctx.createGain();
+      this.gain.connect(ctx.destination);
+    }
+    return ctx;
+  }
+
+  private load(url: string): Promise<AudioBuffer | null> {
+    let loading = this.buffers.get(url);
+    if (!loading) {
+      loading = (async () => {
+        const ctx = this.context();
+        if (!ctx) return null;
+        const response = await fetch(url);
+        if (!response.ok) throw new Error(`HTTP ${response.status}`);
+        return ctx.decodeAudioData(await response.arrayBuffer());
+      })().catch(error => {
+        console.error(`[${MODULE_ID}] narration audio failed to load (${url}):`, error);
+        return null;
+      });
+      this.buffers.set(url, loading);
+      if (this.buffers.size > 40) this.buffers.delete(this.buffers.keys().next().value as string);
+    }
+    return loading;
+  }
+
+  private async play(order: PlayOrder): Promise<void> {
+    const volume = this.volume();
+    if (volume <= 0) return;
+    const buffer = await this.load(order.url);
+    const ctx = this.context();
+    if (!buffer || !ctx || !this.gain) return;
+    if (ctx.state === 'suspended') await ctx.resume().catch(() => undefined);
+    const wait = (order.start - this.now()) / 1000; // negative when the piece should already be playing
+    const offset = wait < 0 ? -wait : 0;
+    if (offset >= buffer.duration) return;
+    this.gain.gain.value = volume;
+    const source = ctx.createBufferSource();
+    source.buffer = buffer;
+    source.connect(this.gain);
+    source.onended = () => this.sources.delete(source);
+    this.sources.add(source);
+    source.start(ctx.currentTime + Math.max(0, wait), offset);
+  }
+
+  private silence(): void {
+    for (const source of this.sources) {
+      try {
+        source.stop();
+      } catch {
+        // already stopped
+      }
+    }
+    this.sources.clear();
+  }
+
+  /**
+   * Foundry closes a chat popup (the notification at the bottom right) five seconds after it appears, however long the
+   * narration still has to run, and fades the whole notification area (class "active" off) at the same time. Keep both
+   * from happening until the audio has ended; after that Foundry's own countdown closes the popup, and the area is
+   * faded five seconds later. Every update of the message extends the hold.
+   */
+  private hold(messageId: string | undefined, endAt: number): void {
+    if (!messageId || endAt <= this.now()) return;
+    this.holds.set(messageId, Math.max(endAt, this.holds.get(messageId) ?? 0));
+    if (this.inactiveTimer) {
+      clearTimeout(this.inactiveTimer);
+      this.inactiveTimer = undefined;
+    }
+    if (this.holdTimer) return;
+    this.holdTimer = setInterval(() => {
+      const now = this.now();
+      const area = document.querySelector('#chat-notifications');
+      if (this.holds.size > 0) area?.classList.add('active');
+      for (const [id, end] of this.holds) {
+        if (now >= end) {
+          this.holds.delete(id);
+          continue;
+        }
+        const popup = document.querySelector<HTMLElement & { _lifeSpan?: number }>(`#chat-notifications .message[data-message-id="${id}"]`);
+        if (popup) popup._lifeSpan = 0;
+      }
+      if (this.holds.size === 0 && this.holdTimer) {
+        clearInterval(this.holdTimer);
+        this.holdTimer = undefined;
+        // Foundry's own timer for this has already run, so let the area fade after the popup's five seconds.
+        this.inactiveTimer = setTimeout(() => {
+          this.inactiveTimer = undefined;
+          document.querySelector('#chat-notifications')?.classList.remove('active');
+        }, 5000);
+      }
+    }, 400);
+  }
+
+  /** Show the words of a narrated message when their time comes. */
+  private reveal(message: any, html: HTMLElement): void {
+    const tts = message?.getFlag?.(MODULE_ID, 'tts');
+    const segments = tts?.segments as SpeechSegment[] | undefined;
+    if (!segments?.length) return;
+    const body = html.querySelector('.message-content');
+    if (!body) return;
+    body.innerHTML = segmentsHtml(segments);
+    this.hold(message.id, segmentsEnd(segments));
+    const now = this.now();
+    body.querySelectorAll<HTMLElement>('.mcp-tts-w').forEach(span => {
+      const wait = Number(span.dataset.at) - now;
+      if (wait <= 0) span.classList.add('on');
+      else setTimeout(() => span.classList.add('on'), wait);
+    });
+  }
+}
+
+export const speechPlayer = new SpeechPlayer();
+export { speechSettingsFrom };

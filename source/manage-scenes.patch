@@ -0,0 +1,178 @@
+/**
+ * The tactical query: distances between tokens, which tokens an area of effect touches, and line
+ * of sight and cover between tokens, using the walls of the scene through Foundry's own collision
+ * test. Read-only.
+ */
+import { tokenRealName } from './combat-utils.js';
+import { getGridGeometry, squaresToPixels } from './scene-objects-utils.js';
+import { boxDistance, boxInArea, centre, corners, directionOf, pointDistance, segmentCrossesBox, wallCover, type Area, type AreaShape, type Box, type Pt } from './tactical-utils.js';
+
+export interface TacticalRequest {
+  action: 'distance' | 'area' | 'sight';
+  scene?: string;
+  from?: string;
+  to?: string[];
+  shape?: AreaShape;
+  origin?: string | [number, number];
+  size?: number;
+  width?: number;
+  direction?: number | string;
+  toward?: string | [number, number];
+  include_origin?: boolean;
+}
+
+const DISPOSITION: Record<number, string> = { [-2]: 'secret', [-1]: 'hostile', 0: 'neutral', 1: 'friendly' };
+
+function sceneFor(identifier?: string): any {
+  const g = (globalThis as any).game;
+  if (identifier) {
+    const scenes = (g.scenes?.contents ?? []) as any[];
+    const s = g.scenes?.get?.(identifier) ?? scenes.find(x => x.name === identifier) ?? scenes.find(x => String(x.name).toLowerCase() === identifier.toLowerCase());
+    if (!s) throw new Error(`Scene not found: ${identifier}`);
+    return s;
+  }
+  const s = g.scenes?.viewed ?? (globalThis as any).canvas?.scene ?? g.scenes?.active;
+  if (!s) throw new Error('No scene is being viewed');
+  return s;
+}
+
+function tokenFor(scene: any, name: string): any {
+  const all = (scene.tokens?.contents ?? []) as any[];
+  const key = name.trim().toLowerCase();
+  const byId = scene.tokens?.get?.(name);
+  if (byId) return byId;
+  for (const test of [
+    (t: any) => String(t.name).toLowerCase() === key,
+    (t: any) => (tokenRealName(t) ?? '').toLowerCase() === key,
+    (t: any) => String(t.actor?.name ?? '').toLowerCase() === key,
+    (t: any) => String(t.name).toLowerCase().includes(key),
+  ]) {
+    const hits = all.filter(test);
+    if (hits.length === 1) return hits[0];
+    if (hits.length > 1) throw new Error(`"${name}" matches ${hits.length} tokens on ${scene.name}: ${hits.slice(0, 10).map(t => `${t.name} (${t.id})`).join(', ')}`);
+  }
+  throw new Error(`No token "${name}" on ${scene.name}`);
+}
+
+const boxOf = (t: any): Box => ({ x: Number(t.x), y: Number(t.y), width: Number(t.width) || 1, height: Number(t.height) || 1 });
+
+/** Foundry's wall test between two points, or undefined when the scene is not on the canvas. */
+function collider(scene: any): ((type: 'sight' | 'move', a: Pt, b: Pt, elevation?: number) => boolean) | undefined {
+  const g = globalThis as any;
+  if (g.canvas?.scene?.id !== scene.id) return undefined;
+  const backends = g.CONFIG?.Canvas?.polygonBackends;
+  if (!backends) return undefined;
+  return (type, a, b, elevation = 0) => {
+    const backend = backends[type] ?? backends.sight;
+    try {
+      return !!backend.testCollision({ ...a, elevation }, { ...b, elevation }, { type, mode: 'any' });
+    } catch {
+      return !!backend.testCollision(a, b, { type, mode: 'any' });
+    }
+  };
+}
+
+export async function tactical(data: TacticalRequest): Promise<Record<string, any>> {
+  const scene = sceneFor(data?.scene);
+  const geom = getGridGeometry(scene);
+  const grid = geom.size;
+  const units = geom.units || 'ft';
+  const toPx = (feet: number) => (feet / (geom.distance || 5)) * grid;
+  const pointOf = (v: string | [number, number]): { pt: Pt; token?: any } => {
+    if (Array.isArray(v)) return { pt: squaresToPixels(geom, Number(v[0]), Number(v[1])) };
+    const token = tokenFor(scene, v);
+    return { pt: centre(boxOf(token), grid), token };
+  };
+  const describe = (t: any) => ({
+    name: tokenRealName(t) ? `${t.name} [${tokenRealName(t)}]` : t.name,
+    id: t.id,
+    disposition: DISPOSITION[Number(t.disposition)] ?? 'unknown',
+    ...(t.hidden ? { hidden: true } : {}),
+  });
+
+  if (data.action === 'distance') {
+    if (!data.from || !data.to?.length) throw new Error('distance needs from and to');
+    const from = tokenFor(scene, data.from);
+    return {
+      success: true,
+      scene: scene.name,
+      from: from.name,
+      distances: data.to.map(n => {
+        const t = tokenFor(scene, n);
+        return { ...describe(t), distance: `${boxDistance(boxOf(from), boxOf(t), grid, geom.distance || 5)} ${units}` };
+      }),
+    };
+  }
+
+  if (data.action === 'area') {
+    const shape = data.shape ?? 'circle';
+    if (!data.origin) throw new Error('area needs origin: a token name or [column, row] in grid squares');
+    if (!(Number(data.size) > 0)) throw new Error('area needs size in feet (radius, length or side)');
+    const { pt: origin, token: originToken } = pointOf(data.origin);
+    let direction = directionOf(data.direction);
+    if (direction === undefined && data.toward !== undefined) {
+      const { pt } = pointOf(data.toward);
+      direction = Math.atan2(pt.y - origin.y, pt.x - origin.x);
+    }
+    if ((shape === 'cone' || shape === 'line') && direction === undefined) throw new Error(`a ${shape} needs direction (degrees, 0 = east, 90 = south, or a compass word) or toward (a token or square)`);
+    const area: Area = { shape, origin, size: toPx(Number(data.size)), ...(shape === 'line' ? { width: toPx(Number(data.width ?? 5)) } : {}), ...(direction !== undefined ? { direction } : {}) };
+    const collide = collider(scene);
+    const inside: any[] = [];
+    for (const t of (scene.tokens?.contents ?? []) as any[]) {
+      if (originToken && t.id === originToken.id && !data.include_origin) continue;
+      if (!boxInArea(boxOf(t), area, grid)) continue;
+      const entry: Record<string, any> = { ...describe(t), distance: `${pointDistance(origin, boxOf(t), grid, geom.distance || 5)} ${units}` };
+      // An effect does not go through walls: flag creatures with every line from the origin blocked.
+      if (collide) {
+        const open = corners(boxOf(t), grid, 6).some(c => !collide('move', origin, c, Number(t.elevation) || 0)) || !collide('move', origin, centre(boxOf(t), grid));
+        if (!open) entry.behindWall = true;
+      }
+      inside.push(entry);
+    }
+    return {
+      success: true,
+      scene: scene.name,
+      area: `${data.size} ${units} ${shape}${originToken ? ` from ${originToken.name}` : ''}`,
+      inside,
+      note:
+        'A creature counts when the centre of one of its squares is in the area. ' +
+        (collide ? 'behindWall: walls block every line from the origin to it, so the effect does not reach it.' : 'Walls were not checked (the scene is not on screen).'),
+    };
+  }
+
+  if (data.action === 'sight') {
+    if (!data.from || !data.to?.length) throw new Error('sight needs from and to');
+    const collide = collider(scene);
+    if (!collide) throw new Error(`Line of sight needs the scene on screen: the GM is not viewing "${scene.name}"`);
+    const from = tokenFor(scene, data.from);
+    const fromBox = boxOf(from);
+    const others = ((scene.tokens?.contents ?? []) as any[]).filter(t => t.id !== from.id);
+    const elevation = Number(from.elevation) || 0;
+    return {
+      success: true,
+      scene: scene.name,
+      from: from.name,
+      targets: data.to.map(n => {
+        const t = tokenFor(scene, n);
+        const box = boxOf(t);
+        const points = [centre(box, grid), ...corners(box, grid, 6)];
+        const eye = centre(fromBox, grid);
+        const sees = points.some(p => !collide('sight', eye, p, elevation));
+        const { cover, blockedLines, lines } = wallCover(fromBox, box, grid, (a, b) => collide('move', a, b, elevation));
+        const inWay = others.filter(o => o.id !== t.id && !o.hidden && segmentCrossesBox(eye, centre(box, grid), boxOf(o), grid)).map(o => o.name);
+        const effective = cover === 'none' && inWay.length ? 'half' : cover;
+        return {
+          ...describe(t),
+          distance: `${boxDistance(fromBox, box, grid, geom.distance || 5)} ${units}`,
+          lineOfSight: sees,
+          cover: effective,
+          ...(cover !== 'none' ? { coverFromWalls: `${blockedLines} of ${lines} lines blocked` } : {}),
+          ...(inWay.length ? { creaturesInTheWay: inWay } : {}),
+        };
+      }),
+      note: 'Cover by the DMG corner method against walls; a creature in the way gives half cover. lineOfSight ignores light and vision modes (darkness, invisibility).',
+    };
+  }
+
+  throw new Error('action must be distance, area or sight');
+}

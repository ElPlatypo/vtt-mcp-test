+    await tools.handleInspectDocument({ action: 'list', type: 'Scene', search: 'cave' });
+    await tools.handleInspectDocument({
+      action: 'get',
+      type: 'Actor',
+      identifier: 'Klarg',
+      path: 'system.attributes.hp',

+/**
+ * Pure helpers for manage-roll-tables and manage-macros. No Foundry globals, so they can be tested.
+ */
+
+export interface TableRowSpec {
+  /** The result text (shown in chat when this result is rolled). */
+  text: string;
+  /** Longer text shown under the result. */
+  description?: string;
+  /** Relative chance, a whole number from 1 (default 1). Ignored when range is given. */
+  weight?: number;
+  /** Exact dice range [low, high] this result covers. Give a range on every row or on none. */
+  range?: [number, number];
+}
+
+export const MAX_TABLE_ROWS = 200;
+
+export interface BuiltTable {
+  results: Array<Record<string, any>>;
+  /** Highest number on the table. */
+  total: number;
+  /** The dice formula that covers the table, e.g. 1d20. */
+  formula: string;
+}
+
+/** The smallest sensible dice formula whose maximum is `total` (1d6, 1d20, 1d100, or 1d<n>). */
+export function formulaFor(total: number): string {
+  return `1d${total}`;
+}
+
+/** Turn table rows into Foundry TableResult data with ranges, and the formula that covers them. */
+export function buildTableResults(rows: unknown, label = 'results'): BuiltTable {
+  if (!Array.isArray(rows) || rows.length === 0 || rows.length > MAX_TABLE_ROWS) {
+    throw new Error(`${label} must be a list of 1 to ${MAX_TABLE_ROWS} rows`);
+  }
+  const specs = rows as TableRowSpec[];
+  const withRange = specs.filter(r => r && r.range !== undefined).length;
+  if (withRange !== 0 && withRange !== specs.length) {
+    throw new Error(`${label}: give a range on every row or on none`);
+  }
+
+  const results: Array<Record<string, any>> = [];
+  let next = 1;
+  const used: Array<[number, number]> = [];
+
+  specs.forEach((row, index) => {
+    const at = `${label}[${index}]`;
+    if (!row || typeof row !== 'object') throw new Error(`${at}: must be an object`);
+    if (typeof row.text !== 'string' || !row.text.trim()) throw new Error(`${at}: text is required`);
+    if (row.description !== undefined && typeof row.description !== 'string') {
+      throw new Error(`${at}: description must be a string`);
+    }
+    let range: [number, number];
+    let weight: number;
+    if (row.range !== undefined) {
+      if (
+        !Array.isArray(row.range) ||
+        row.range.length !== 2 ||
+        !row.range.every(n => Number.isInteger(n) && n >= 1)
+      ) {
+        throw new Error(`${at}: range must be [low, high] whole numbers from 1`);
+      }
+      const [low, high] = row.range;
+      if (low > high) throw new Error(`${at}: range low is above high`);
+      if (used.some(([a, b]) => low <= b && high >= a)) {
+        throw new Error(`${at}: range ${low}-${high} overlaps another row`);
+      }
+      used.push([low, high]);
+      range = [low, high];
+      weight = high - low + 1;
+    } else {
+      weight = row.weight === undefined ? 1 : row.weight;
+      if (!Number.isInteger(weight) || weight < 1 || weight > 1000) {
+        throw new Error(`${at}: weight must be a whole number from 1 to 1000`);
+      }
+      range = [next, next + weight - 1];
+      next += weight;
+    }
+    results.push({
+      type: 'text',
+      name: row.text.trim(),
+      description: row.description ?? '',
+      weight,
+      range,
+      drawn: false,
+    });
+  });
+
+  const total = Math.max(...results.map(r => r.range[1]));
+  if (withRange > 0) {
+    // A range table need not cover every number, but it must start at 1 to be rollable.
+    if (!used.some(([a]) => a === 1)) {
+      throw new Error(`${label}: ranges must start at 1`);
+    }
+  }
+  return { results, total, formula: formulaFor(total) };
+}
+
+export const MACRO_TYPES = ['script', 'chat'] as const;
+export const MAX_MACRO_CHARS = 20000;
+
+/** Validate a macro and build its Foundry data. */
+export function buildMacroData(spec: {
+  name?: unknown;
+  type?: unknown;
+  command?: unknown;
+  img?: unknown;
+}): Record<string, any> {
+  if (typeof spec.name !== 'string' || !spec.name.trim()) throw new Error('name is required');
+  const type = spec.type === undefined ? 'script' : spec.type;
+  if (!(MACRO_TYPES as readonly unknown[]).includes(type)) {
+    throw new Error(`type must be ${MACRO_TYPES.join(' or ')}`);
+  }
+  if (typeof spec.command !== 'string' || !spec.command.trim()) {
+    throw new Error('command is required (the script, or the chat text)');
+  }
+  if (spec.command.length > MAX_MACRO_CHARS) {
+    throw new Error(`command is longer than ${MAX_MACRO_CHARS} characters`);
+  }
+  if (spec.img !== undefined && (typeof spec.img !== 'string' || !spec.img.trim())) {
+    throw new Error('img must be a file path');
+  }
+  return {
+    name: spec.name.trim(),
+    type,
+    scope: 'global',
+    command: spec.command,
+    ...(spec.img ? { img: spec.img } : {}),
+  };
+}
diff --git a/packages/foundry-module/src/plutonium-utils.ts b/packages/foundry-module/src/plutonium-utils.ts

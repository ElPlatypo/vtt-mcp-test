+/**
+ * Pure helper for manage-scene-objects update: turn the fields asked for (grid squares and tool
+ * units) into a partial Foundry update for one placed object. No Foundry globals.
+ */
+import { squaresToPixels, type GridGeometry } from './scene-objects-utils.js';
+
+export type ObjectKind = 'token' | 'light' | 'wall' | 'note' | 'tile' | 'sound';
+
+export const OBJECT_DOCUMENT: Record<ObjectKind, string> = {
+  token: 'Token',
+  light: 'AmbientLight',
+  wall: 'Wall',
+  note: 'Note',
+  tile: 'Tile',
+  sound: 'AmbientSound',
+};
+
+/** Fields each kind accepts, besides id and kind. */
+export const UPDATE_FIELDS: Record<ObjectKind, readonly string[]> = {
+  token: ['x', 'y', 'name', 'width', 'height', 'hidden', 'disposition', 'elevation'],
+  light: ['x', 'y', 'bright', 'dim', 'color', 'alpha', 'angle', 'rotation', 'animation', 'hidden'],
+  wall: ['door_state'],
+  note: ['x', 'y', 'text', 'font_size', 'icon_size', 'icon', 'global'],
+  tile: ['x', 'y', 'width', 'height', 'src', 'rotation', 'alpha', 'elevation', 'hidden'],
+  sound: ['x', 'y', 'radius', 'path', 'volume', 'repeat', 'walls', 'easing', 'hidden'],
+};
+
+const DOOR_STATES: Record<string, number> = { closed: 0, open: 1, locked: 2 };
+const LIGHT_ANIMATIONS = ['torch', 'pulse', 'chroma', 'wave', 'fog', 'sunburst', 'dome', 'emanation', 'hexa', 'ghost', 'energy', 'roiling', 'hole'];
+
+const isNum = (v: unknown): v is number => typeof v === 'number' && Number.isFinite(v);
+
+function inRange(v: unknown, min: number, max: number, label: string, name: string, what = 'a number'): number {
+  if (!isNum(v) || v < min || v > max) throw new Error(`${label}: ${name} must be ${what} from ${min} to ${max}`);
+  return v;
+}
+
+/**
+ * Build the update for one object. `current` gives the object's present x and y in pixels so that
+ * changing only x or only y keeps the other. Throws a clear error for anything not allowed.
+ */
+export function buildObjectUpdate(
+  kind: ObjectKind,
+  spec: Record<string, any>,
+  geom: GridGeometry,
+  current: { x?: number; y?: number } | undefined,
+  label: string
+): Record<string, any> {
+  if (!(kind in UPDATE_FIELDS)) throw new Error(`${label}: kind must be token, light, wall, note, tile or sound`);
+  const allowed = UPDATE_FIELDS[kind];
+  const given = Object.keys(spec).filter(k => k !== 'id' && k !== 'kind');
+  if (given.length === 0) throw new Error(`${label}: nothing to change (allowed for a ${kind}: ${allowed.join(', ')})`);
+  for (const key of given) {
+    if (!allowed.includes(key)) throw new Error(`${label}: ${key} cannot be changed on a ${kind} (allowed: ${allowed.join(', ')})`);
+  }
+
+  const data: Record<string, any> = {};
+  const maxX = geom.sceneWidth / geom.size;
+  const maxY = geom.sceneHeight / geom.size;
+
+  if (spec.x !== undefined || spec.y !== undefined) {
+    if (kind === 'wall') throw new Error(`${label}: walls cannot be moved`);
+    const cx = isNum(current?.x) ? (current!.x! - geom.originX) / geom.size : 0;
+    const cy = isNum(current?.y) ? (current!.y! - geom.originY) / geom.size : 0;
+    const nx = spec.x !== undefined ? inRange(spec.x, 0, maxX, label, 'x', 'grid squares') : cx;
+    const ny = spec.y !== undefined ? inRange(spec.y, 0, maxY, label, 'y', 'grid squares') : cy;
+    const p = squaresToPixels(geom, nx, ny);
+    data.x = p.x;
+    data.y = p.y;
+  }
+  if (spec.hidden !== undefined) data.hidden = !!spec.hidden;
+  if (spec.elevation !== undefined) {
+    if (!isNum(spec.elevation)) throw new Error(`${label}: elevation must be a number`);
+    data.elevation = spec.elevation;
+  }
+  if (spec.alpha !== undefined) {
+    const a = inRange(spec.alpha, 0, 1, label, 'alpha');
+    if (kind === 'light') data['config.alpha'] = a;
+    else data.alpha = a;
+  }
+  if (spec.rotation !== undefined) {
+    if (!isNum(spec.rotation)) throw new Error(`${label}: rotation must be degrees`);
+    data.rotation = spec.rotation;
+  }
+
+  switch (kind) {
+    case 'token':
+      if (spec.name !== undefined) data.name = String(spec.name);
+      for (const dim of ['width', 'height'] as const) {
+        if (spec[dim] !== undefined) data[dim] = inRange(spec[dim], 0.5, 20, label, dim, 'a number of squares');
+      }
+      if (spec.disposition !== undefined) {
+        if (![-1, 0, 1].includes(spec.disposition)) throw new Error(`${label}: disposition must be -1, 0 or 1`);
+        data.disposition = spec.disposition;
+      }
+      break;
+    case 'light':
+      if (spec.bright !== undefined) data['config.bright'] = inRange(spec.bright, 0, 400, label, 'bright', 'squares') * geom.distance;
+      if (spec.dim !== undefined) data['config.dim'] = inRange(spec.dim, 0, 400, label, 'dim', 'squares') * geom.distance;
+      if (spec.color !== undefined) {
+        if (typeof spec.color !== 'string' || !/^#[0-9a-fA-F]{6}$/.test(spec.color)) throw new Error(`${label}: color must look like #RRGGBB`);
+        data['config.color'] = spec.color.toLowerCase();
+      }
+      if (spec.angle !== undefined) data['config.angle'] = inRange(spec.angle, 1, 360, label, 'angle', 'degrees');
+      if (spec.animation !== undefined) {
+        if (spec.animation === null) data['config.animation'] = { type: null };
+        else if (!LIGHT_ANIMATIONS.includes(spec.animation)) throw new Error(`${label}: animation must be one of ${LIGHT_ANIMATIONS.join(', ')}`);
+        else data['config.animation'] = { type: spec.animation, speed: 5, intensity: 5 };
+      }
+      break;
+    case 'wall':
+      if (!(spec.door_state in DOOR_STATES)) throw new Error(`${label}: door_state must be closed, open or locked`);
+      data.ds = DOOR_STATES[spec.door_state];
+      break;
+    case 'note':
+      if (spec.text !== undefined) data.text = String(spec.text);
+      if (spec.font_size !== undefined) data.fontSize = inRange(spec.font_size, 8, 128, label, 'font_size', 'a number');
+      if (spec.icon_size !== undefined) data.iconSize = inRange(spec.icon_size, 32, 512, label, 'icon_size', 'a number');
+      if (spec.icon !== undefined) data['texture.src'] = String(spec.icon);
+      if (spec.global !== undefined) data.global = !!spec.global;
+      break;
+    case 'tile':
+      for (const dim of ['width', 'height'] as const) {
+        if (spec[dim] !== undefined) {
+          data[dim] = Math.round(inRange(spec[dim], 0.01, 400, label, dim, 'a number of squares') * geom.size);
+        }
+      }
+      if (spec.src !== undefined) {
+        if (typeof spec.src !== 'string' || !spec.src.trim() || /^[a-z]+:\/\//i.test(spec.src)) {
+          throw new Error(`${label}: src must be a path in the Foundry files`);
+        }
+        data['texture.src'] = spec.src.trim();
+      }
+      break;
+    case 'sound':
+      if (spec.radius !== undefined) data.radius = inRange(spec.radius, 0.01, 400, label, 'radius', 'squares') * geom.distance;
+      if (spec.path !== undefined) {
+        if (typeof spec.path !== 'string' || !spec.path.trim() || /^[a-z]+:\/\//i.test(spec.path)) {
+          throw new Error(`${label}: path must be an audio file in the Foundry files`);
+        }
+        data.path = spec.path.trim();
+      }
+      if (spec.volume !== undefined) data.volume = inRange(spec.volume, 0, 1, label, 'volume');
+      for (const flag of ['repeat', 'walls', 'easing'] as const) {
+        if (spec[flag] !== undefined) data[flag] = !!spec[flag];
+      }
+      break;
+  }
+  return data;
+}
diff --git a/packages/foundry-module/src/party-utils.ts b/packages/foundry-module/src/party-utils.ts

+import { layoutOf } from './layout-doc.js';
+
+const folder = path.join(os.tmpdir(), `layout-actions-test-${Date.now()}`);
+afterAll(async () => {
+  await fs.rm(folder, { recursive: true, force: true });
+});
+
+const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+
+type Call = { tool: string; args: any };
+
+interface Fakes {
+  scene?: { tokens?: any[]; lights?: any[]; notes?: any[]; grid?: any };
+  generate?: (args: any) => Promise<any>;
+  upload?: (args: any) => Promise<any>;
+}
+
+function make(fakes: Fakes = {}) {
+  const calls: Call[] = [];
+  const query = vi.fn(async (tool: string, args: any) => {
+    calls.push({ tool, args });
+    if (tool === 'foundry-mcp-bridge.manage-scenes') {
+      return { success: true, action: 'create', scene: { id: 'sc1', name: args.name } };
+    }
+    if (args.action === 'describe') {
+      return {
+        success: true,
+        scene: { id: 'sc1', name: 'Cave' },
+        grid: fakes.scene?.grid ?? { columns: 24, rows: 16 },
+        tokens: fakes.scene?.tokens ?? [],
+        lights: fakes.scene?.lights ?? [],
+        notes: fakes.scene?.notes ?? [],
+      };
+    }
+    if (args.action === 'remove') return { success: true, removed: [{ id: 'old' }] };
+    if (args.action === 'place') return { success: true, created: args.objects.map((o: any, i: number) => ({ kind: o.kind, id: `n${i}`, x: o.x, y: o.y })) };
+    return { success: true };
+  });
+  const tools = new LayoutTools({
+    logger,
+    folder,
+    foundryClient: { query } as any,
+    ...(fakes.generate ? { generate: fakes.generate } : {}),
+    ...(fakes.upload ? { upload: fakes.upload } : {}),
+  });
+  return { tools, calls, query };
+}
+
+async function newLayout(tools: LayoutTools, name: string, shapes?: any[]) {
+  await tools.handleLayout({ action: 'new', name, columns: 24, rows: 16, grid_size: 32, snap: 0.5 });
+  await tools.handleLayout({
+    action: 'add',
+    layout: name,
+    shapes: shapes ?? [
+      { shape: 'room', at: [2, 2], size: [6, 6], name: 'west room' },
+      { shape: 'room', at: [8.5, 2], size: [6, 6], name: 'east room' },
+      { shape: 'door', at: [8.25, 4], dir: 'v' },
+      { shape: 'room', at: [16, 4], size: [6, 8], name: 'cellar' },
+    ],
+  });
+}
+
+describe('layout check', () => {
+  it('reports unconnected areas without Foundry', async () => {
+    const { tools } = make();
+    await newLayout(tools, 'check one');
+    const result = await tools.handleLayout({ action: 'check', layout: 'check one' });
+    expect(result.ok).toBe(false);
+    expect(result.warnings.join(' ')).toContain('not connected');
+    expect(result.sceneProblems).toBeUndefined();
+  });
+
+  it('reads the scene and reports objects on rock', async () => {
+    const { tools, calls } = make({
+      scene: {
+        tokens: [{ name: 'Rocky', x: 12, y: 12, width: 1, height: 1 }, { name: 'Fine', x: 3, y: 3, width: 1, height: 1 }],
+        lights: [{ x: 3, y: 3 }],
+        notes: [{ x: 12, y: 12, text: 'lost pin' }],
+      },

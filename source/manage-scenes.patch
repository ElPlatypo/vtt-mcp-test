@@ -0,0 +1,277 @@
+/**
+ * Pure helpers for the actor options of manage-actors and create-actor-from-compendium:
+ * token size and behaviour, and a hit point shorthand. No Foundry globals, so they can be tested.
+ */
+
+export interface TokenOptions {
+  /** Token size in grid squares (0.5 to 20), e.g. 2 for a Large creature. */
+  width?: number;
+  height?: number;
+  /** -1 hostile, 0 neutral, 1 friendly. */
+  disposition?: number;
+  /** Picture scale inside the token (0.2 to 3). */
+  scale?: number;
+  /** Token is linked to the actor (shared hit points), default false for NPCs. */
+  actor_link?: boolean;
+  /** When the name is shown: none, control, owner_hover, hover, owner, always. */
+  display_name?: string;
+  /** Vision on/off for the token. */
+  vision?: boolean;
+  /** How far the token sees, in scene distance units (feet); 0 means only what light shows. */
+  vision_range?: number;
+  /** Vision mode id: basic, darkvision, monochromatic, tremorsense, lightAmplification (what the system offers). */
+  vision_mode?: string;
+  /** Full sight settings: enabled, range, angle (degrees), vision_mode, brightness, saturation, contrast. */
+  sight?: Record<string, unknown>;
+  /** Light the token gives off: preset (torch, lantern, candle, none) and/or bright, dim (distance units), color, alpha, angle, coloration, luminosity, attenuation, saturation, contrast, shadows, negative, priority, animation {type, speed, intensity, reverse}. */
+  light?: Record<string, unknown>;
+  /** Extra detection modes: [{id, range, enabled?}] (e.g. seeAll, feelTremor, senseInvisibility). Adds or changes these modes. */
+  detection_modes?: Array<{ id: string; range?: number; enabled?: boolean }>;
+  lock_rotation?: boolean;
+  /** Token opacity 0 to 1. */
+  alpha?: number;
+  /** When the bars are shown: none, control, owner_hover, hover, owner, always. */
+  display_bars?: string;
+  /** Any other prototype token field, as a nested object (e.g. {ring: {enabled: true}}); applied last. */
+  raw?: Record<string, unknown>;
+}
+
+export const LIGHT_PRESETS: Record<string, Record<string, any>> = {
+  none: { bright: 0, dim: 0 },
+  candle: { bright: 5, dim: 10, color: '#ffb347', animation: { type: 'torch', speed: 2, intensity: 2 } },
+  torch: { bright: 20, dim: 40, color: '#ff9329', animation: { type: 'torch', speed: 5, intensity: 5 } },
+  lantern: { bright: 30, dim: 60, color: '#ffc169', animation: { type: 'torch', speed: 3, intensity: 3 } },
+};
+
+const LIGHT_KEYS = ['preset', 'bright', 'dim', 'color', 'alpha', 'angle', 'coloration', 'luminosity', 'attenuation', 'saturation', 'contrast', 'shadows', 'negative', 'priority', 'animation'];
+const SIGHT_KEYS = ['enabled', 'range', 'angle', 'vision_mode', 'brightness', 'saturation', 'contrast'];
+const COLOR = /^#[0-9a-fA-F]{6}$/;
+
+function num(value: unknown, min: number, max: number, label: string): number {
+  if (typeof value !== 'number' || !Number.isFinite(value) || value < min || value > max) {
+    throw new Error(`${label} must be a number from ${min} to ${max}`);
+  }
+  return value;
+}
+
+function onlyKeys(obj: Record<string, any>, allowed: string[], label: string): void {
+  for (const key of Object.keys(obj)) {
+    if (!allowed.includes(key)) throw new Error(`${label}: unknown option "${key}" (${allowed.join(', ')})`);
+  }
+}
+
+const BLOCKED = new Set(['__proto__', 'constructor', 'prototype']);
+
+/** Flatten a nested object to dotted keys; arrays and non-plain values stay as they are. */
+export function flattenPatch(obj: unknown, label: string, prefix = '', depth = 0): Record<string, any> {
+  if (!obj || typeof obj !== 'object' || Array.isArray(obj)) throw new Error(`${label} must be an object`);
+  if (depth > 6) throw new Error(`${label} is nested too deeply`);
+  const out: Record<string, any> = {};
+  for (const [key, value] of Object.entries(obj as Record<string, any>)) {
+    if (BLOCKED.has(key) || key.includes('.')) throw new Error(`${label}: "${key}" is not allowed as a field name`);
+    const path = prefix ? `${prefix}.${key}` : key;
+    if (value && typeof value === 'object' && !Array.isArray(value) && Object.keys(value).length > 0) {
+      Object.assign(out, flattenPatch(value, label, path, depth + 1));
+    } else {
+      out[path] = value;
+    }
+  }
+  return out;
+}
+
+function lightPatch(light: unknown, label: string): Record<string, any> {
+  if (!light || typeof light !== 'object' || Array.isArray(light)) throw new Error(`${label}: light must be an object`);
+  const l = light as Record<string, any>;
+  onlyKeys(l, LIGHT_KEYS, `${label}: light`);
+  const merged: Record<string, any> = {};
+  if (l.preset !== undefined) {
+    const preset = LIGHT_PRESETS[String(l.preset)];
+    if (!preset) throw new Error(`${label}: light preset must be one of ${Object.keys(LIGHT_PRESETS).join(', ')}`);
+    Object.assign(merged, preset);
+  }
+  for (const [k, v] of Object.entries(l)) if (k !== 'preset') merged[k] = v;
+  const patch: Record<string, any> = {};
+  for (const k of ['bright', 'dim']) if (merged[k] !== undefined) patch[`light.${k}`] = num(merged[k], 0, 1000, `${label}: light ${k}`);
+  if (merged.color !== undefined) {
+    if (merged.color !== null && !COLOR.test(String(merged.color))) throw new Error(`${label}: light color must look like #RRGGBB`);
+    patch['light.color'] = merged.color;
+  }
+  if (merged.alpha !== undefined) patch['light.alpha'] = num(merged.alpha, 0, 1, `${label}: light alpha`);
+  if (merged.angle !== undefined) patch['light.angle'] = num(merged.angle, 0, 360, `${label}: light angle`);
+  for (const k of ['attenuation', 'saturation', 'contrast', 'luminosity']) {
+    if (merged[k] !== undefined) patch[`light.${k}`] = num(merged[k], k === 'attenuation' || k === 'luminosity' ? 0 : -1, 1, `${label}: light ${k}`);
+  }
+  if (merged.coloration !== undefined) patch['light.coloration'] = num(merged.coloration, 0, 10, `${label}: light coloration`);
+  if (merged.priority !== undefined) patch['light.priority'] = num(merged.priority, 0, 1000, `${label}: light priority`);
+  for (const k of ['shadows', 'negative']) if (merged[k] !== undefined) patch[`light.${k}`] = k === 'shadows' ? num(merged[k], 0, 1, `${label}: light shadows`) : !!merged[k];
+  if (merged.animation !== undefined) {
+    const a = merged.animation;
+    if (a === null) {
+      patch['light.animation.type'] = null;
+    } else {
+      if (typeof a !== 'object' || Array.isArray(a)) throw new Error(`${label}: light animation must be an object`);
+      onlyKeys(a, ['type', 'speed', 'intensity', 'reverse'], `${label}: light animation`);
+      if (a.type !== undefined) {
+        if (a.type !== null && !/^[A-Za-z][A-Za-z0-9]{0,30}$/.test(String(a.type))) throw new Error(`${label}: light animation type must be a name such as torch, pulse, flame`);
+        patch['light.animation.type'] = a.type;
+      }
+      if (a.speed !== undefined) patch['light.animation.speed'] = num(a.speed, 0, 10, `${label}: animation speed`);
+      if (a.intensity !== undefined) patch['light.animation.intensity'] = num(a.intensity, 0, 10, `${label}: animation intensity`);
+      if (a.reverse !== undefined) patch['light.animation.reverse'] = !!a.reverse;
+    }
+  }
+  return patch;
+}
+
+function sightPatch(sight: unknown, label: string): Record<string, any> {
+  if (!sight || typeof sight !== 'object' || Array.isArray(sight)) throw new Error(`${label}: sight must be an object`);
+  const s = sight as Record<string, any>;
+  onlyKeys(s, SIGHT_KEYS, `${label}: sight`);
+  const patch: Record<string, any> = {};
+  if (s.enabled !== undefined) patch['sight.enabled'] = !!s.enabled;
+  if (s.range !== undefined) patch['sight.range'] = s.range === null ? null : num(s.range, 0, 100000, `${label}: sight range`);
+  if (s.angle !== undefined) patch['sight.angle'] = num(s.angle, 0, 360, `${label}: sight angle`);
+  if (s.vision_mode !== undefined) {
+    if (!/^[A-Za-z][A-Za-z0-9]{0,40}$/.test(String(s.vision_mode))) throw new Error(`${label}: sight vision_mode must be a mode id such as basic or darkvision`);
+    patch['sight.visionMode'] = s.vision_mode;
+  }
+  for (const k of ['brightness', 'saturation', 'contrast']) {
+    if (s[k] !== undefined) patch[`sight.${k}`] = num(s[k], -1, 1, `${label}: sight ${k}`);
+  }
+  return patch;
+}
+
+export const NAME_DISPLAY_MODES: Record<string, number> = {
+  none: 0,
+  control: 10,
+  owner_hover: 20,
+  hover: 30,
+  owner: 40,
+  always: 50,
+};
+
+const TOKEN_KEYS = ['width', 'height', 'disposition', 'scale', 'actor_link', 'display_name', 'vision', 'vision_range', 'vision_mode', 'sight', 'light', 'detection_modes', 'lock_rotation', 'alpha', 'display_bars', 'raw'];
+
+/**
+ * Validate token options and return a flat patch using dotted prototypeToken paths
+ * (usable in actor.update, or expanded into the data of a new actor).
+ */
+export function buildPrototypeTokenPatch(token: unknown, label: string): Record<string, any> {
+  if (!token || typeof token !== 'object' || Array.isArray(token)) {
+    throw new Error(`${label}: token must be an object`);
+  }
+  const t = token as Record<string, any>;
+  for (const key of Object.keys(t)) {
+    if (!TOKEN_KEYS.includes(key)) {
+      throw new Error(`${label}: unknown token option "${key}" (${TOKEN_KEYS.join(', ')})`);
+    }
+  }
+  const patch: Record<string, any> = {};
+  for (const dim of ['width', 'height'] as const) {
+    if (t[dim] !== undefined) {
+      if (typeof t[dim] !== 'number' || !(t[dim] >= 0.5 && t[dim] <= 20)) {
+        throw new Error(`${label}: token ${dim} must be a number of squares from 0.5 to 20`);
+      }
+      patch[dim] = t[dim];
+    }
+  }
+  if (t.disposition !== undefined) {
+    if (![-1, 0, 1].includes(t.disposition)) {
+      throw new Error(`${label}: token disposition must be -1 (hostile), 0 (neutral) or 1 (friendly)`);
+    }
+    patch.disposition = t.disposition;
+  }
+  if (t.scale !== undefined) {
+    if (typeof t.scale !== 'number' || !(t.scale >= 0.2 && t.scale <= 3)) {
+      throw new Error(`${label}: token scale must be a number from 0.2 to 3`);
+    }
+    patch['texture.scaleX'] = t.scale;
+    patch['texture.scaleY'] = t.scale;
+  }
+  if (t.actor_link !== undefined) patch.actorLink = !!t.actor_link;
+  if (t.vision !== undefined) patch['sight.enabled'] = !!t.vision;
+  if (t.vision_range !== undefined) {
+    patch['sight.range'] = num(t.vision_range, 0, 100000, `${label}: token vision_range`);
+    if (t.vision === undefined && t.vision_range > 0) patch['sight.enabled'] = true;
+  }
+  if (t.vision_mode !== undefined) Object.assign(patch, sightPatch({ vision_mode: t.vision_mode }, `${label}: token`));
+  if (t.sight !== undefined) Object.assign(patch, sightPatch(t.sight, `${label}: token`));
+  if (t.light !== undefined) Object.assign(patch, lightPatch(t.light, `${label}: token`));
+  if (t.detection_modes !== undefined) {
+    if (!Array.isArray(t.detection_modes) || t.detection_modes.length > 20) throw new Error(`${label}: token detection_modes must be a list of at most 20`);
+    // Foundry keeps detection modes as an object keyed by mode id; these are added or changed.
+    t.detection_modes.forEach((m: any, i: number) => {
+      if (!m || typeof m !== 'object' || typeof m.id !== 'string' || !/^[A-Za-z][A-Za-z0-9]{0,40}$/.test(m.id)) {
+        throw new Error(`${label}: token detection_modes[${i}] needs an id such as basicSight or seeAll`);
+      }
+      onlyKeys(m, ['id', 'range', 'enabled'], `${label}: token detection_modes[${i}]`);
+      patch[`detectionModes.${m.id}`] = { enabled: m.enabled === undefined ? true : !!m.enabled, range: m.range === undefined ? null : num(m.range, 0, 100000, `${label}: detection range`) };
+    });
+  }
+  if (t.lock_rotation !== undefined) patch.lockRotation = !!t.lock_rotation;
+  if (t.alpha !== undefined) patch.alpha = num(t.alpha, 0, 1, `${label}: token alpha`);
+  if (t.display_bars !== undefined) {
+    const mode = NAME_DISPLAY_MODES[String(t.display_bars)];
+    if (mode === undefined) throw new Error(`${label}: display_bars must be one of ${Object.keys(NAME_DISPLAY_MODES).join(', ')}`);
+    patch.displayBars = mode;
+  }
+  if (t.display_name !== undefined) {
+    const mode = NAME_DISPLAY_MODES[String(t.display_name)];
+    if (mode === undefined) {
+      throw new Error(`${label}: display_name must be one of ${Object.keys(NAME_DISPLAY_MODES).join(', ')}`);
+    }
+    patch.displayName = mode;
+  }
+  if (t.raw !== undefined) Object.assign(patch, flattenPatch(t.raw, `${label}: token raw`));
+  return patch;
+}
+
+/** The same patch with the "prototypeToken." prefix on every key. */
+export function prototypeTokenUpdate(patch: Record<string, any>): Record<string, any> {
+  return Object.fromEntries(Object.entries(patch).map(([k, v]) => [`prototypeToken.${k}`, v]));
+}
+
+/**
+ * Hit point shorthand: a number sets current and maximum, {value, max} sets them separately.
+ * Only dnd5e is known to keep hit points at system.attributes.hp.
+ */
+export function buildHpPatch(
+  systemId: string,
+  hp: unknown,
+  label: string,
+  /** updating an existing actor: {value} changes only the value and {max} only the max (a new actor gets both) */
+  onlyGiven = false
+): Record<string, any> {
+  if (systemId !== 'dnd5e') {
+    throw new Error(`${label}: the hp shorthand is only available for dnd5e; use system for ${systemId || 'this system'}`);
+  }
+  let value: number;
+  let max: number;
+  if (typeof hp === 'number') {
+    value = hp;
+    max = hp;
+  } else if (hp && typeof hp === 'object' && !Array.isArray(hp)) {
+    const h = hp as Record<string, any>;
+    const keys = Object.keys(h).filter(k => k !== 'value' && k !== 'max');
+    if (keys.length > 0) throw new Error(`${label}: hp only takes value and max`);
+    if (h.value === undefined && h.max === undefined) throw new Error(`${label}: hp needs value or max`);
+    max = h.max ?? h.value;
+    value = h.value ?? h.max;
+  } else {
+    throw new Error(`${label}: hp must be a number or {value, max}`);
+  }
+  for (const n of [value, max]) {
+    if (typeof n !== 'number' || !Number.isInteger(n) || n < 0 || n > 100000) {
+      throw new Error(`${label}: hp must be whole numbers from 0 to 100000`);
+    }
+  }
+  if (onlyGiven && hp && typeof hp === 'object') {
+    const h = hp as Record<string, any>;
+    if (h.value === undefined || h.max === undefined) {
+      if (h.value !== undefined && h.max === undefined) return { attributes: { hp: { value } } };
+      return { attributes: { hp: { max } } };
+    }
+  }
+  if (value > max) throw new Error(`${label}: hp value cannot be above max`);
+  return { attributes: { hp: { value, max } } };
+}

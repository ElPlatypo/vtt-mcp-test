+      'Roll. For initiative, now please.',
+    ]);
+    expect(splitSpeechSegments('  ')).toEqual([]);
+    expect(splitSpeechSegments('One short line.')).toEqual(['One short line.']);
+  });
+  it('cuts a very long sentence at commas', () => {
+    const long = 'The woods press close to the trail here, with a steep embankment and dense thickets on either side, and the wind carries the smell of old smoke and wet leaves through the pines, over the road and the bodies.';
+    const parts = splitSpeechSegments(long, 100);
+    expect(parts.length).toBeGreaterThan(1);
+    expect(parts.every(p => p.length <= 100)).toBe(true);
+    expect(parts.join(' ')).toBe(long);
+  });
+});
+
+describe('start delay', () => {
+  const pieces = ['A'.repeat(50), 'B'.repeat(50), 'C'.repeat(50), 'D'.repeat(50)];
+  it('is zero when generation is faster than speech', () => {
+    expect(startDelayMs(pieces, 4, 1200)).toBe(0); // 0.3 s of waiting per second of speech
+    expect(startDelayMs(['one piece'], 4, 9000)).toBe(0);
+  });
+  it('holds playback back when generation is slower than speech', () => {
+    // 1.7 s of waiting per second of speech, 4 s pieces: piece 4 is ready at 3 * 6.8 = 20.4 s but would play at 3 * 4.12
+    const d = startDelayMs(pieces, 4, 6800);
+    expect(d).toBeGreaterThan(7000);
+    expect(d).toBeLessThan(10000);
+  });
+});
+
+import { groupSpeech } from './speech.js';
+
+describe('groupSpeech', () => {
+  it('keeps a paragraph together and only cuts a long text at sentence ends', () => {
+    const para = 'You have been on the Triboar Trail for about half a day. The woods press close on either side. Something is watching from the trees.';
+    expect(groupSpeech(para)).toEqual([para]);
+    const parts = groupSpeech(para, 90);
+    expect(parts.length).toBeGreaterThan(1);
+    expect(parts.every(p => p.length <= 90)).toBe(true);
+    expect(parts.join(' ')).toBe(para);
+    expect(groupSpeech('  ')).toEqual([]);
+  });
+});
diff --git a/packages/mcp-server/src/speech.ts b/packages/mcp-server/src/speech.ts

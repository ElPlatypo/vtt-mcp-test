+    return this.placeObjects(doc, a.scene, objects, report);
+  }
+
+  private async placeObjects(doc: LayoutDoc, scene: string | undefined, objects: any[], report: any[]): Promise<any> {
+    const created: any[] = [];
+    for (let i = 0; i < objects.length; i += 150) {
+      const res = await this.client().query('foundry-mcp-bridge.manage-scene-objects', {
+        action: 'place',
+        ...(scene ? { scene } : {}),
+        objects: objects.slice(i, i + 150),
+      });
+      if (res?.success === false) throw new Error(res.error || 'Could not place the objects');
+      created.push(...(res?.created ?? []));

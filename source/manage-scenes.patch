+/**
+ * Layout documents: a map layout that is built up in steps. Shapes get ids, can be added,
+ * moved, changed and removed, and every change can be seen at once as a text map. Shapes
+ * snap to the grid by default; snap 0 gives freeform placement for outdoors and odd shapes.
+ */
+
+import { promises as fs } from 'fs';
+import os from 'os';
+import path from 'path';
+import {
+  FILLS,
+  colorFor,
+  normalizeShape,
+  renderLayout,
+  scanPolygon,
+  shapePolygons,
+  type LayoutShape,
+  type NormalizedLayout,
+} from './layout-utils.js';
+import { decodeImage } from './layout-image.js';
+
+export interface LayoutReference {
+  /** A PNG or JPEG on this computer, such as a page of the book. */
+  image: string;
+  /** Pixel in the image where square (0, 0) of the layout starts. */
+  origin: [number, number];
+  /** Pixels of the image that make up one square. */
+  cellPx: number;
+}
+
+export interface LayoutDoc {
+  id: string;
+  name: string;
+  columns: number;
+  rows: number;
+  size: number;
+  background: string;
+  snap: number;
+  wallFills: string[];
+  nextId: number;
+  shapes: LayoutShape[];
+  reference?: LayoutReference;
+  /** Earlier states, oldest first, for undo. */
+  undo?: HistoryEntry[];
+  /** States that undo stepped back from, most recent last, for redo. */
+  redo?: HistoryEntry[];
+}
+
+/** Everything undo restores: the shapes and the settings (not the history itself). */
+export interface LayoutState {
+  shapes: LayoutShape[];
+  nextId: number;
+  snap: number;
+  background: string;
+  wallFills: string[];
+  reference?: LayoutReference;
+}
+
+export interface HistoryEntry {
+  /** What the change was, e.g. "add 3 shapes". */
+  label: string;
+  state: LayoutState;
+}
+
+export const MAX_DOC_SHAPES = 600;
+export const MAX_HISTORY = 40;
+
+export function slug(name: string): string {
+  return (
+    name
+      .toLowerCase()
+      .replace(/[^a-z0-9]+/g, '-')
+      .replace(/^-+|-+$/g, '')
+      .slice(0, 50) || 'layout'
+  );
+}
+
+// ===== Storage =====
+
+/**
+ * Where layouts are kept unless a folder is given: a per-user data folder that survives temp
+ * clean-ups (FOUNDRY_MCP_LAYOUTS_DIR overrides it). Older versions kept them in the temp folder.
+ */
+export function defaultLayoutsDir(): string {
+  const override = process.env.FOUNDRY_MCP_LAYOUTS_DIR;
+  if (override) return override;
+  const home = os.homedir();
+  if (process.platform === 'win32') {
+    const local = process.env.LOCALAPPDATA || path.join(home, 'AppData', 'Local');
+    return path.join(local, 'FoundryMCPServer', 'layouts');
+  }
+  if (process.platform === 'darwin') {
+    return path.join(home, 'Library', 'Application Support', 'FoundryMCPServer', 'layouts');
+  }
+  const data = process.env.XDG_DATA_HOME || path.join(home, '.local', 'share');
+  return path.join(data, 'foundry-mcp', 'layouts');
+}
+
+/** The temp folder older versions used; its layouts are copied over once. */
+export const LEGACY_LAYOUTS_DIR = path.join(os.tmpdir(), 'foundry-mcp-layouts');
+
+export class LayoutStore {
+  private dir: string;
+  private legacyDir: string | undefined;
+  private migrated: Promise<void> | undefined;
+  private cache = new Map<string, LayoutDoc>();
+
+  /** legacyDir: a folder whose layouts are copied into dir (once) when dir does not have them. */
+  constructor(dir?: string, legacyDir?: string) {
+    this.dir = dir ?? defaultLayoutsDir();
+    this.legacyDir = dir === undefined ? (legacyDir ?? LEGACY_LAYOUTS_DIR) : legacyDir;
+  }
+
+  /** Copy layouts from the old temp folder that are not in the folder yet. Never deletes. */
+  private migrate(): Promise<void> {
+    if (!this.migrated) {
+      this.migrated = (async () => {
+        const from = this.legacyDir;
+        if (!from || path.resolve(from) === path.resolve(this.dir)) return;
+        let files: string[];
+        try {
+          files = (await fs.readdir(from)).filter(f => f.endsWith('.layout.json'));
+        } catch {
+          return;
+        }
+        if (!files.length) return;
+        await fs.mkdir(this.dir, { recursive: true });
+        for (const f of files) {
+          const target = path.join(this.dir, f);
+          try {
+            await fs.access(target);
+          } catch {
+            await fs.copyFile(path.join(from, f), target).catch(() => undefined);
+          }
+        }
+      })().catch(() => undefined);
+    }
+    return this.migrated;
+  }
+
+  get folder(): string {
+    return this.dir;
+  }
+
+  private file(id: string): string {
+    return path.join(this.dir, `${id}.layout.json`);
+  }
+
+  async load(id: string): Promise<LayoutDoc> {
+    await this.migrate();
+    const key = slug(id);
+    const hit = this.cache.get(key);
+    if (hit) return hit;
+    try {
+      const doc = JSON.parse(await fs.readFile(this.file(key), 'utf8')) as LayoutDoc;
+      this.cache.set(key, doc);
+      return doc;
+    } catch {
+      throw new Error(`Layout "${id}" not found; use action list, or new to start one`);
+    }
+  }
+
+  async save(doc: LayoutDoc): Promise<void> {
+    await this.migrate();
+    await fs.mkdir(this.dir, { recursive: true });
+    this.cache.set(doc.id, doc);
+    await fs.writeFile(this.file(doc.id), JSON.stringify(doc));
+  }
+
+  async exists(id: string): Promise<boolean> {
+    await this.migrate();
+    try {
+      await fs.access(this.file(slug(id)));
+      return true;
+    } catch {
+      return false;
+    }
+  }
+
+  async list(): Promise<Array<{ id: string; name: string; columns: number; rows: number; shapes: number }>> {
+    await this.migrate();
+    try {
+      const files = (await fs.readdir(this.dir)).filter(f => f.endsWith('.layout.json'));
+      const out = [];
+      for (const f of files) {
+        const doc = await this.load(f.replace('.layout.json', ''));
+        out.push({ id: doc.id, name: doc.name, columns: doc.columns, rows: doc.rows, shapes: doc.shapes.length });
+      }
+      return out;
+    } catch {
+      return [];
+    }
+  }
+
+  async remove(id: string): Promise<void> {
+    const key = slug(id);
+    this.cache.delete(key);
+    await fs.rm(this.file(key), { force: true });
+  }
+}
+
+// ===== Editing =====
+
+export function layoutOf(doc: LayoutDoc): NormalizedLayout {
+  return {
+    columns: doc.columns,
+    rows: doc.rows,
+    size: doc.size,
+    background: doc.background,
+    shapes: doc.shapes,
+    wallFills: doc.wallFills,
+  };
+}
+
+export function createDoc(args: {
+  name: string;
+  columns: number;
+  rows: number;
+  grid_size?: number;
+  background?: string;
+  snap?: number;
+  wall_fills?: string[];
+}): LayoutDoc {
+  const int = (v: unknown, min: number, max: number, label: string): number => {
+    if (!Number.isInteger(v) || (v as number) < min || (v as number) > max) {
+      throw new Error(`${label} must be a whole number from ${min} to ${max}`);
+    }
+    return v as number;
+  };
+  const columns = int(args.columns, 4, 200, 'columns');
+  const rows = int(args.rows, 4, 200, 'rows');
+  const size = args.grid_size === undefined ? 64 : int(args.grid_size, 8, 256, 'grid_size');
+  if (columns * size * rows * size > 4096 * 4096) {
+    throw new Error('The picture would be larger than 4096 x 4096 pixels; lower grid_size or the map size');
+  }
+  const background = args.background ?? 'rock';
+  if (!FILLS[background]) throw new Error(`background must be one of ${Object.keys(FILLS).join(', ')}`);
+  const snap = args.snap === undefined ? 1 : args.snap;
+  if (typeof snap !== 'number' || snap < 0 || snap > 5) throw new Error('snap must be a number from 0 to 5');
+  const wallFills = args.wall_fills ?? ['floor'];
+  for (const f of wallFills) if (!FILLS[f]) throw new Error(`wall_fills: unknown fill "${f}"`);
+  return {
+    id: slug(args.name),
+    name: args.name.trim(),
+    columns,
+    rows,
+    size,
+    background,
+    snap,
+    wallFills,
+    nextId: 1,
+    shapes: [],
+  };
+}
+
+// ===== Undo and redo =====
+
+/** A copy of the current state, taken before a change. */
+export function captureState(doc: LayoutDoc): LayoutState {
+  return JSON.parse(
+    JSON.stringify({
+      shapes: doc.shapes,
+      nextId: doc.nextId,
+      snap: doc.snap,
+      background: doc.background,
+      wallFills: doc.wallFills,
+      ...(doc.reference ? { reference: doc.reference } : {}),
+    })
+  ) as LayoutState;
+}
+
+export function restoreState(doc: LayoutDoc, state: LayoutState): void {
+  const copy = JSON.parse(JSON.stringify(state)) as LayoutState;
+  doc.shapes = copy.shapes;
+  doc.nextId = copy.nextId;
+  doc.snap = copy.snap;
+  doc.background = copy.background;
+  doc.wallFills = copy.wallFills;
+  if (copy.reference) doc.reference = copy.reference;
+  else delete doc.reference;
+}
+
+/** Remember the state from before a change that went through, and drop anything that could be redone. */
+export function commitChange(doc: LayoutDoc, label: string, before: LayoutState): void {
+  const undo = doc.undo ?? [];
+  undo.push({ label, state: before });
+  if (undo.length > MAX_HISTORY) undo.splice(0, undo.length - MAX_HISTORY);
+  doc.undo = undo;
+  doc.redo = [];
+}
+
+/** Step back `steps` changes. Returns what was undone, most recent first. */
+export function undoChanges(doc: LayoutDoc, steps: number): string[] {
+  const undo = doc.undo ?? [];
+  if (undo.length === 0) throw new Error('Nothing to undo');
+  const done: string[] = [];
+  const redo = doc.redo ?? [];
+  for (let i = 0; i < steps && undo.length > 0; i++) {
+    const entry = undo.pop()!;
+    redo.push({ label: entry.label, state: captureState(doc) });
+    restoreState(doc, entry.state);
+    done.push(entry.label);
+  }
+  doc.undo = undo;
+  doc.redo = redo;
+  return done;
+}
+
+/** Step forward again after an undo. Returns what was redone. */
+export function redoChanges(doc: LayoutDoc, steps: number): string[] {
+  const redo = doc.redo ?? [];
+  if (redo.length === 0) throw new Error('Nothing to redo');
+  const done: string[] = [];
+  const undo = doc.undo ?? [];
+  for (let i = 0; i < steps && redo.length > 0; i++) {
+    const entry = redo.pop()!;
+    undo.push({ label: entry.label, state: captureState(doc) });
+    restoreState(doc, entry.state);
+    done.push(entry.label);
+  }
+  doc.undo = undo;
+  doc.redo = redo;
+  return done;
+}
+
+/** Add shapes on top (or after the shape `after`). Returns the new ids. */
+export function addShapes(doc: LayoutDoc, raws: unknown[], after?: number, atIndex?: number): number[] {
+  if (!Array.isArray(raws) || raws.length === 0) throw new Error('shapes must be a non-empty list');
+  if (doc.shapes.length + raws.length > MAX_DOC_SHAPES) {
+    throw new Error(`A layout holds at most ${MAX_DOC_SHAPES} shapes`);
+  }
+  let at = atIndex !== undefined && after === undefined ? Math.max(0, Math.min(atIndex, doc.shapes.length)) : doc.shapes.length;
+  if (after !== undefined) {
+    const i = doc.shapes.findIndex(s => s.id === after);
+    if (i < 0) throw new Error(`after: shape ${after} not found`);
+    at = i + 1;
+  }
+  const made = raws.map((raw, i) => {
+    const shape = normalizeShape(raw, `shapes[${i}]`, doc.snap);
+    shape.id = doc.nextId++;
+    return shape;
+  });
+  doc.shapes.splice(at, 0, ...made);
+  return made.map(s => s.id!);
+}
+
+function translate(shape: LayoutShape, dx: number, dy: number): void {
+  if (shape.rect) shape.rect = [shape.rect[0]! + dx, shape.rect[1]! + dy, shape.rect[2]!, shape.rect[3]!];
+  if (shape.ellipse) shape.ellipse = [shape.ellipse[0]! + dx, shape.ellipse[1]! + dy, shape.ellipse[2]!, shape.ellipse[3]!];
+  if (shape.polygon) shape.polygon = shape.polygon.map(p => [p[0]! + dx, p[1]! + dy]);
+  if (shape.path) shape.path = shape.path.map(p => [p[0]! + dx, p[1]! + dy]);
+  if (shape.at) shape.at = [shape.at[0]! + dx, shape.at[1]! + dy];
+  if (shape.cells) {
+    if (!Number.isInteger(dx) || !Number.isInteger(dy)) throw new Error('cells can only move by whole squares');
+    shape.cells = shape.cells.map(c => [c[0]! + dx, c[1]! + dy, c[2]!, c[3]!]);
+  }
+}
+
+/**
+ * Change a shape. `set` replaces fields (null removes one, e.g. rotate), `move` shifts it by
+ * [columns, rows], `front`/`back` change its stacking, `after` puts it above another shape.
+ */
+export function updateShape(
+  doc: LayoutDoc,
+  id: number,
+  change: { set?: Record<string, unknown>; move?: number[]; front?: boolean; back?: boolean; after?: number }
+): void {
+  const index = doc.shapes.findIndex(s => s.id === id);
+  if (index < 0) throw new Error(`Shape ${id} not found`);
+  const current = doc.shapes[index]!;
+  const next: any = { ...current };
+
+  if (change.set) {
+    for (const [k, v] of Object.entries(change.set)) {
+      if (k === 'id' || k === 'shape') throw new Error(`${k} cannot be changed; remove the shape and add a new one`);
+      if (v === null) delete next[k];
+      else next[k] = v;
+    }
+  }
+  if (change.move) {
+    if (!Array.isArray(change.move) || change.move.length !== 2 || !change.move.every(n => typeof n === 'number' && Number.isFinite(n))) {
+      throw new Error('move must be [columns, rows]');
+    }
+    translate(next, change.move[0]!, change.move[1]!);
+  }
+  const fixed = normalizeShape(next, `shape ${id}`, doc.snap);
+  fixed.id = id;
+  doc.shapes[index] = fixed;
+
+  if (change.front || change.back || change.after !== undefined) {
+    doc.shapes.splice(index, 1);
+    if (change.front) doc.shapes.push(fixed);
+    else if (change.back) doc.shapes.unshift(fixed);
+    else {
+      const j = doc.shapes.findIndex(s => s.id === change.after);
+      if (j < 0) {
+        doc.shapes.splice(index, 0, fixed);
+        throw new Error(`after: shape ${change.after} not found`);
+      }
+      doc.shapes.splice(j + 1, 0, fixed);
+    }
+  }
+}
+
+export function removeShapes(doc: LayoutDoc, ids: number[]): number[] {
+  const gone = new Set(ids);
+  const removed = doc.shapes.filter(s => gone.has(s.id!)).map(s => s.id!);
+  const missing = ids.filter(i => !removed.includes(i));
+  if (missing.length > 0) throw new Error(`Shapes not found: ${missing.join(', ')}`);
+  doc.shapes = doc.shapes.filter(s => !gone.has(s.id!));
+  return removed;
+}
+
+/** One line per shape, so the document can be read back. */
+export function describeShapes(doc: LayoutDoc): Array<Record<string, unknown>> {
+  return doc.shapes.map(s => {
+    const geometry = s.rect ?? s.ellipse ?? s.polygon ?? s.path ?? s.cells ?? (s.at ? { at: s.at, dir: s.dir, size: s.size ?? 1 } : null);
+    return {
+      id: s.id,
+      shape: s.shape,
+      fill: s.fill,
+      ...(s.color ? { color: s.color } : {}),
+      ...(s.name ? { name: s.name } : {}),
+      ...(s.rotate ? { rotate: s.rotate } : {}),
+      ...(s.secret ? { secret: true } : {}),
+      geometry,
+    };
+  });
+}
+
+// ===== Text map =====
+
+const ASCII: Record<string, string> = {
+  rock: '#',
+  floor: '.',
+  grass: ',',
+  road: '=',
+  water: '~',
+  building: 'B',
+  stone: 'o',
+  sand: ':',
+  wood: 'w',
+  door: '+',
+};
+
+export interface Region {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+}
+
+/** The layout as text, one character per square, with column and row numbers. */
+export function asciiMap(doc: LayoutDoc, region?: Region): { text: string; legend: string } {
+  const S = 4; // samples per square
+  const names = Object.keys(FILLS);
+  const grid = new Uint8Array(doc.columns * S * doc.rows * S);
+  grid.fill(names.indexOf(doc.background));
+  const w = doc.columns * S;
+  const h = doc.rows * S;
+  for (const shape of doc.shapes) {
+    if (shape.shape === 'door') continue;
+    const value = names.indexOf(shape.fill ?? 'floor');
+    for (const poly of shapePolygons(shape, S)) {
+      scanPolygon(poly, w, h, (y, x0, x1) => grid.fill(value, y * w + x0, y * w + x1 + 1));
+    }
+  }
+  const x0 = region ? Math.max(0, Math.floor(region.x)) : 0;
+  const y0 = region ? Math.max(0, Math.floor(region.y)) : 0;
+  const x1 = region ? Math.min(doc.columns, Math.ceil(region.x + region.width)) : doc.columns;
+  const y1 = region ? Math.min(doc.rows, Math.ceil(region.y + region.height)) : doc.rows;
+
+  const lines: string[][] = [];
+  for (let r = y0; r < y1; r++) {
+    const row: string[] = [];
+    for (let c = x0; c < x1; c++) {
+      row.push(ASCII[names[grid[(r * S + S / 2) * w + c * S + S / 2]!]!] ?? '?');
+    }
+    lines.push(row);
+  }
+  // Doors mark the square their bar sits in.
+  for (const shape of doc.shapes) {
+    if (shape.shape !== 'door') continue;
+    const [dx, dy] = shape.at as [number, number];
+    const len = Math.max(1, Math.round(shape.size ?? 1));
+    for (let i = 0; i < len; i++) {
+      const c = shape.dir === 'v' ? Math.floor(dx) : Math.floor(dx) + i;
+      const r = shape.dir === 'v' ? Math.floor(dy) + i : Math.floor(dy);
+      if (c >= x0 && c < x1 && r >= y0 && r < y1) lines[r - y0]![c - x0] = shape.secret ? 'S' : '+';
+    }
+  }
+
+  const tens = ['   '];
+  const ones = ['   '];
+  for (let c = x0; c < x1; c++) {
+    tens.push(c % 10 === 0 ? String(Math.floor(c / 10) % 10) : ' ');
+    ones.push(String(c % 10));
+  }
+  const body = lines.map((row, i) => `${String(y0 + i).padStart(2)} ${row.join('')}`);
+  const used = new Set(lines.flat());
+  const legend = Object.entries(ASCII)
+    .filter(([, ch]) => used.has(ch))
+    .map(([fill, ch]) => `${ch} ${fill}`)
+    .concat(used.has('S') ? ['S secret door'] : [])
+    .join('   ');
+  return { text: [tens.join(''), ones.join(''), ...body].join('\n'), legend };
+}
+
+// ===== Preview picture =====
+
+const DIGITS: Record<string, string[]> = {
+  '0': ['111', '101', '101', '101', '111'],
+  '1': ['010', '110', '010', '010', '111'],
+  '2': ['111', '001', '111', '100', '111'],
+  '3': ['111', '001', '111', '001', '111'],
+  '4': ['101', '101', '111', '001', '001'],
+  '5': ['111', '100', '111', '001', '111'],
+  '6': ['111', '100', '111', '101', '111'],
+  '7': ['111', '001', '001', '001', '001'],
+  '8': ['111', '101', '111', '101', '111'],
+  '9': ['111', '101', '111', '001', '111'],
+};
+
+type Pixels = { width: number; height: number; rgb: Uint8Array };
+
+function setPixel(img: Pixels, x: number, y: number, c: [number, number, number], alpha = 1): void {
+  if (x < 0 || y < 0 || x >= img.width || y >= img.height) return;
+  const o = (y * img.width + x) * 3;
+  for (let i = 0; i < 3; i++) img.rgb[o + i] = Math.round(img.rgb[o + i]! * (1 - alpha) + c[i]! * alpha);
+}
+
+/** Draw a number on a dark box, with its top-left corner at (x, y). Returns the box width. */
+function drawNumber(img: Pixels, x: number, y: number, text: string, k: number, ink: [number, number, number]): number {
+  const boxW = text.length * 4 * k + k;
+  const boxH = 5 * k + 2 * k;
+  for (let j = 0; j < boxH; j++) for (let i = 0; i < boxW; i++) setPixel(img, x + i, y + j, [0, 0, 0], 0.7);
+  [...text].forEach((ch, n) => {
+    const glyph = DIGITS[ch];
+    if (!glyph) return;
+    glyph.forEach((row, gy) =>
+      [...row].forEach((bit, gx) => {
+        if (bit !== '1') return;
+        for (let a = 0; a < k; a++) {
+          for (let b = 0; b < k; b++) setPixel(img, x + k + n * 4 * k + gx * k + a, y + k + gy * k + b, ink);
+        }
+      })
+    );
+  });
+  return boxW;
+}
+
+export interface PreviewOptions {
+  grid?: boolean;
+  labels?: boolean;
+  reference?: boolean;
+  /** Show only the reference picture with the grid, without the shapes. */
+  hide_shapes?: boolean;
+  region?: Region;
+}
+
+/** The layout as a picture to look at: shapes over the book page, a numbered grid and shape ids. */
+export async function renderPreview(doc: LayoutDoc, opts: PreviewOptions = {}): Promise<Pixels & { region: Region }> {
+  const layout = layoutOf(doc);
+  const sketch = renderLayout(hideShapes(layout, !!opts.hide_shapes));
+  const { width, height } = sketch;
+  const img: Pixels = { width, height, rgb: sketch.rgb };
+  const bg = colorFor({ fill: doc.background });
+
+  if ((opts.reference ?? true) && doc.reference) {
+    const ref = await decodeImage(doc.reference.image);
+    const [ox, oy] = doc.reference.origin;
+    const per = doc.reference.cellPx / doc.size;
+    for (let y = 0; y < height; y++) {
+      const ry = Math.floor(oy + (y + 0.5) * per);
+      for (let x = 0; x < width; x++) {
+        const rx = Math.floor(ox + (x + 0.5) * per);
+        const o = (y * width + x) * 3;
+        const inside = rx >= 0 && ry >= 0 && rx < ref.width && ry < ref.height;
+        const r = inside ? ref.data[(ry * ref.width + rx) * 4]! : 255;
+        const g = inside ? ref.data[(ry * ref.width + rx) * 4 + 1]! : 255;
+        const b = inside ? ref.data[(ry * ref.width + rx) * 4 + 2]! : 255;
+        const isBg = img.rgb[o] === bg[0] && img.rgb[o + 1] === bg[1] && img.rgb[o + 2] === bg[2];
+        const a = isBg || opts.hide_shapes ? 0 : 0.5;
+        img.rgb[o] = Math.round(r * (1 - a) + img.rgb[o]! * a);
+        img.rgb[o + 1] = Math.round(g * (1 - a) + img.rgb[o + 1]! * a);
+        img.rgb[o + 2] = Math.round(b * (1 - a) + img.rgb[o + 2]! * a);
+      }
+    }
+  }
+
+  if (opts.grid ?? true) {
+    for (let c = 0; c <= doc.columns; c++) {
+      const strong = c % 5 === 0;
+      const x = Math.min(width - 1, c * doc.size);
+      for (let y = 0; y < height; y++) {
+        setPixel(img, x, y, strong ? [255, 220, 0] : [255, 255, 255], strong ? 0.7 : 0.3);
+        if (strong) setPixel(img, x + 1, y, [255, 220, 0], 0.5);
+      }
+    }
+    for (let r = 0; r <= doc.rows; r++) {
+      const strong = r % 5 === 0;
+      const y = Math.min(height - 1, r * doc.size);
+      for (let x = 0; x < width; x++) {
+        setPixel(img, x, y, strong ? [255, 220, 0] : [255, 255, 255], strong ? 0.7 : 0.3);
+        if (strong) setPixel(img, x, y + 1, [255, 220, 0], 0.5);
+      }
+    }
+    const k = doc.size >= 40 ? 3 : 2;
+    const every = doc.size >= 28 ? 1 : 5;
+    for (let c = 0; c < doc.columns; c += every) drawNumber(img, c * doc.size + 2, 2, String(c), k, [255, 255, 255]);
+    for (let r = 1; r < doc.rows; r += every) drawNumber(img, 2, r * doc.size + 2, String(r), k, [255, 255, 255]);
+  }
+
+  if ((opts.labels ?? true) && !opts.hide_shapes) {
+    const k = doc.size >= 40 ? 3 : 2;
+    for (const shape of doc.shapes) {
+      const polys = shapePolygons(shape, doc.size);
+      let sx = 0;
+      let sy = 0;
+      let n = 0;
+      for (const poly of polys) for (const [x, y] of poly) { sx += x; sy += y; n++; }
+      if (n === 0) continue;
+      const text = String(shape.label ?? shape.id);
+      const boxW = text.length * 4 * k + k;
+      drawNumber(img, Math.round(sx / n - boxW / 2), Math.round(sy / n - (7 * k) / 2), text, k, shape.shape === 'door' ? [255, 160, 40] : [120, 255, 120]);
+    }
+  }
+
+  const region = opts.region
+    ? {
+        x: Math.max(0, Math.floor(opts.region.x)),
+        y: Math.max(0, Math.floor(opts.region.y)),
+        width: Math.min(doc.columns, Math.ceil(opts.region.x + opts.region.width)) - Math.max(0, Math.floor(opts.region.x)),
+        height: Math.min(doc.rows, Math.ceil(opts.region.y + opts.region.height)) - Math.max(0, Math.floor(opts.region.y)),
+      }
+    : { x: 0, y: 0, width: doc.columns, height: doc.rows };
+  if (!opts.region) return { ...img, region };
+  if (region.width < 2 || region.height < 2) throw new Error('region must cover at least 2 by 2 squares');
+
+  // Crop, then enlarge by a whole factor so the picture is easier to read.
+  const cw = region.width * doc.size;
+  const ch = region.height * doc.size;
+  const f = Math.max(1, Math.min(4, Math.floor(1600 / Math.max(cw, ch))));
+  const out = new Uint8Array(cw * f * ch * f * 3);
+  for (let y = 0; y < ch * f; y++) {
+    for (let x = 0; x < cw * f; x++) {
+      const so = ((region.y * doc.size + Math.floor(y / f)) * width + region.x * doc.size + Math.floor(x / f)) * 3;
+      const o = (y * cw * f + x) * 3;
+      out[o] = img.rgb[so]!;
+      out[o + 1] = img.rgb[so + 1]!;
+      out[o + 2] = img.rgb[so + 2]!;
+    }
+  }
+  return { width: cw * f, height: ch * f, rgb: out, region };
+}
+
+function hideShapes(layout: NormalizedLayout, hide: boolean): NormalizedLayout {
+  return hide ? { ...layout, shapes: [] } : layout;
+}

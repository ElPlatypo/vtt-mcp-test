+import { describe, expect, it } from 'vitest';
+import { buildHpPatch, buildPrototypeTokenPatch, prototypeTokenUpdate } from './actor-overrides-utils.js';
+
+describe('buildPrototypeTokenPatch', () => {
+  it('turns token options into prototype token paths', () => {
+    const patch = buildPrototypeTokenPatch(
+      { width: 2, height: 2, disposition: -1, scale: 1.2, actor_link: false, display_name: 'hover', vision: true },
+      't'
+    );
+    expect(patch).toEqual({
+      width: 2,
+      height: 2,
+      disposition: -1,
+      'texture.scaleX': 1.2,
+      'texture.scaleY': 1.2,
+      actorLink: false,
+      'sight.enabled': true,
+      displayName: 30,
+    });
+    expect(prototypeTokenUpdate({ width: 2 })).toEqual({ 'prototypeToken.width': 2 });
+  });
+
+  it('rejects bad options', () => {
+    expect(() => buildPrototypeTokenPatch({ width: 40 }, 't')).toThrow('width');
+    expect(() => buildPrototypeTokenPatch({ disposition: 2 }, 't')).toThrow('disposition');
+    expect(() => buildPrototypeTokenPatch({ display_name: 'x' }, 't')).toThrow('display_name');
+    expect(() => buildPrototypeTokenPatch({ size: 2 }, 't')).toThrow('unknown token option');
+    expect(() => buildPrototypeTokenPatch('big', 't')).toThrow('object');
+  });
+});
+
+describe('buildHpPatch', () => {
+  it('sets value and max from a number or an object', () => {
+    expect(buildHpPatch('dnd5e', 27, 'h')).toEqual({ attributes: { hp: { value: 27, max: 27 } } });
+    expect(buildHpPatch('dnd5e', { max: 10 }, 'h')).toEqual({ attributes: { hp: { value: 10, max: 10 } } });
+    expect(buildHpPatch('dnd5e', { value: 3, max: 10 }, 'h')).toEqual({ attributes: { hp: { value: 3, max: 10 } } });
+  });
+
+  it('rejects other systems and bad numbers', () => {
+    expect(() => buildHpPatch('pf2e', 5, 'h')).toThrow('dnd5e');
+    expect(() => buildHpPatch('dnd5e', -1, 'h')).toThrow();
+    expect(() => buildHpPatch('dnd5e', 1.5, 'h')).toThrow();
+    expect(() => buildHpPatch('dnd5e', { value: 9, max: 5 }, 'h')).toThrow('above max');
+    expect(() => buildHpPatch('dnd5e', {}, 'h')).toThrow();
+  });
+});
+
+describe('buildHpPatch when updating', () => {
+  it('changes only the part that was given', () => {
+    expect(buildHpPatch('dnd5e', { value: 3 }, 'h', true)).toEqual({ attributes: { hp: { value: 3 } } });
+    expect(buildHpPatch('dnd5e', { max: 30 }, 'h', true)).toEqual({ attributes: { hp: { max: 30 } } });
+    expect(buildHpPatch('dnd5e', { value: 3, max: 30 }, 'h', true)).toEqual({ attributes: { hp: { value: 3, max: 30 } } });
+    expect(buildHpPatch('dnd5e', 27, 'h', true)).toEqual({ attributes: { hp: { value: 27, max: 27 } } });
+  });
+  it('still sets both for a new actor', () => {
+    expect(buildHpPatch('dnd5e', { value: 3 }, 'h')).toEqual({ attributes: { hp: { value: 3, max: 3 } } });
+  });
+});

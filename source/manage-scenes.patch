@@ -0,0 +1,246 @@
+/** control-playlist playback commands, add/remove sounds and audio upload, with Foundry stubbed. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+import { detectAudioType, extensionMatchesAudio, sanitizeUploadFilename } from './upload-utils.js';
+
+function makeSound(id: string, name: string, extra: Record<string, any> = {}) {
+  return { id, name, path: `worlds/w/uploads/audio/${name}.mp3`, playing: false, pausedTime: null, volume: 0.5, repeat: false, sound: { currentTime: 12.34 }, ...extra };
+}
+
+function makePlaylist(id: string, name: string, sounds: any[], extra: Record<string, any> = {}) {
+  const pl: any = {
+    id,
+    name,
+    mode: 0,
+    sounds: { contents: sounds },
+    playAll: vi.fn(async () => undefined),
+    stopAll: vi.fn(async () => undefined),
+    cycleMode: vi.fn(async () => undefined),
+    playSound: vi.fn(async () => undefined),
+    stopSound: vi.fn(async () => undefined),
+    playNext: vi.fn(async () => undefined),
+    update: vi.fn(async () => undefined),
+    updateEmbeddedDocuments: vi.fn(async () => []),
+    createEmbeddedDocuments: vi.fn(async () => []),
+    deleteEmbeddedDocuments: vi.fn(async () => []),
+    ...extra,
+  };
+  return pl;
+}
+
+function setup(allow = true) {
+  const battle = makePlaylist('p1', 'Battle', [makeSound('s1', 'Drums', { playing: true }), makeSound('s2', 'Horns', { playing: true }), makeSound('s3', 'Calm')]);
+  const tavern = makePlaylist('p2', 'Tavern', [makeSound('t1', 'Fiddle', { pausedTime: 30 })]);
+  const empty = makePlaylist('p3', 'Empty', []);
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'GM' },
+    playlists: { contents: [battle, tavern, empty] },
+    settings: { get: (_m: string, key: string) => (key === 'allowWriteOperations' ? allow : undefined) },
+  });
+  return { da: new FoundryDataAccess(), battle, tavern, empty };
+}
+
+describe('controlPlaylist', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('keeps the old commands', async () => {
+    const { da, battle } = setup();
+    await da.controlPlaylist({ playlist: 'Battle', command: 'play' });
+    await da.controlPlaylist({ playlist: 'Battle', command: 'stop' });
+    await da.controlPlaylist({ playlist: 'Battle', command: 'play-sound', sound: 'Calm' });
+    await da.controlPlaylist({ playlist: 'Battle', command: 'stop-sound', sound: 'Calm' });
+    expect(battle.playAll).toHaveBeenCalled();
+    expect(battle.stopAll).toHaveBeenCalled();
+    expect(battle.playSound).toHaveBeenCalledWith(battle.sounds.contents[2]);
+    expect(battle.stopSound).toHaveBeenCalled();
+  });
+
+  it('pauses the playing tracks and remembers where they were', async () => {
+    const { da, battle } = setup();
+    const r = await da.controlPlaylist({ playlist: 'Battle', command: 'pause' });
+    expect(battle.updateEmbeddedDocuments).toHaveBeenCalledWith('PlaylistSound', [
+      { _id: 's1', playing: false, pausedTime: 12.34 },
+      { _id: 's2', playing: false, pausedTime: 12.34 },
+    ]);
+    expect(r.paused.map((s: any) => s.name)).toEqual(['Drums', 'Horns']);
+  });
+
+  it('pauses one track and refuses an unknown one', async () => {
+    const { da, battle } = setup();
+    await da.controlPlaylist({ playlist: 'Battle', command: 'pause-sound', sound: 'Horns' });
+    expect(battle.updateEmbeddedDocuments).toHaveBeenCalledWith('PlaylistSound', [{ _id: 's2', playing: false, pausedTime: 12.34 }]);
+    await expect(da.controlPlaylist({ playlist: 'Battle', command: 'pause-sound' })).rejects.toThrow('requires "sound"');
+    await expect(da.controlPlaylist({ playlist: 'Battle', command: 'pause-sound', sound: 'zzz' })).rejects.toThrow('not found');
+  });
+
+  it('resumes paused tracks without restarting them', async () => {
+    const { da, tavern } = setup();
+    const r = await da.controlPlaylist({ playlist: 'Tavern', command: 'resume' });
+    expect(tavern.updateEmbeddedDocuments).toHaveBeenCalledWith('PlaylistSound', [{ _id: 't1', playing: true }]);
+    expect(r.resumed).toHaveLength(1);
+    const { da: da2, empty } = setup();
+    await da2.controlPlaylist({ playlist: 'Empty', command: 'resume' });
+    expect(empty.updateEmbeddedDocuments).not.toHaveBeenCalled();
+  });
+
+  it('skips tracks', async () => {
+    const { da, battle } = setup();
+    await da.controlPlaylist({ playlist: 'Battle', command: 'next' });
+    await da.controlPlaylist({ playlist: 'Battle', command: 'previous' });
+    expect(battle.playNext).toHaveBeenNthCalledWith(1, undefined, { direction: 1 });
+    expect(battle.playNext).toHaveBeenNthCalledWith(2, undefined, { direction: -1 });
+    const { da: da2, empty } = setup();
+    empty.playNext = undefined;
+    await expect(da2.controlPlaylist({ playlist: 'Empty', command: 'next' })).rejects.toThrow('cannot skip');
+  });
+
+  it('sets the volume of one track or the whole playlist', async () => {
+    const { da, battle } = setup();
+    await da.controlPlaylist({ playlist: 'Battle', command: 'set-volume', sound: 'Calm', volume: 0.2 });
+    expect(battle.updateEmbeddedDocuments).toHaveBeenCalledWith('PlaylistSound', [{ _id: 's3', volume: 0.2 }]);
+    const r = await da.controlPlaylist({ playlist: 'Battle', command: 'set-volume', volume: 0 });
+    expect(r.sounds).toBe(3);
+    await expect(da.controlPlaylist({ playlist: 'Battle', command: 'set-volume', volume: 2 })).rejects.toThrow('0 to 1');
+    await expect(da.controlPlaylist({ playlist: 'Battle', command: 'set-volume' })).rejects.toThrow('volume');
+    await expect(da.controlPlaylist({ playlist: 'Empty', command: 'set-volume', volume: 0.5 })).rejects.toThrow('no sounds');
+  });
+
+  it('lists what is playing or paused across playlists', async () => {
+    const { da } = setup();
+    const r = await da.controlPlaylist({ command: 'now-playing' });
+    expect(r.playing).toBe(2);
+    expect(r.sounds.map((s: any) => [s.name, s.playing, s.paused, s.position])).toEqual([
+      ['Drums', true, false, 12.3],
+      ['Horns', true, false, 12.3],
+      ['Fiddle', false, true, 30],
+    ]);
+    const one = await da.controlPlaylist({ command: 'now-playing', playlist: 'Tavern' });
+    expect(one.sounds).toHaveLength(1);
+  });
+
+  it('silences every playlist that is playing', async () => {
+    const { da, battle, tavern, empty } = setup();
+    const r = await da.controlPlaylist({ command: 'stop-all' });
+    expect(r.stopped).toBe(2);
+    expect(battle.stopAll).toHaveBeenCalled();
+    expect(tavern.stopAll).not.toHaveBeenCalled();
+    expect(empty.stopAll).not.toHaveBeenCalled();
+  });
+
+  it('needs a playlist for the others and knows its commands', async () => {
+    const { da } = setup();
+    await expect(da.controlPlaylist({ command: 'pause' })).rejects.toThrow('playlist identifier is required');
+    await expect(da.controlPlaylist({ playlist: 'Battle', command: 'dance' as any })).rejects.toThrow('Unknown command');
+  });
+});
+
+describe('managePlaylists create', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('creates the playlist through the Playlist class and adds its sounds', async () => {
+    const { da } = setup();
+    const created = makePlaylist('new1', 'Cave', []);
+    const createDocuments = vi.fn(async () => [created]);
+    vi.stubGlobal('Playlist', { createDocuments });
+    const r = await da.managePlaylists({
+      action: 'create',
+      name: 'Cave',
+      sounds: [{ path: 'worlds/w/uploads/audio/drip.mp3', name: 'Drip', volume: 0.3 }],
+    });
+    expect(createDocuments).toHaveBeenCalledWith([{ name: 'Cave' }]);
+    expect(created.createEmbeddedDocuments).toHaveBeenCalledWith('PlaylistSound', [
+      { path: 'worlds/w/uploads/audio/drip.mp3', name: 'Drip', volume: 0.3 },
+    ]);
+    expect(r.success).toBe(true);
+  });
+});
+
+describe('managePlaylists add and remove sounds', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('adds sounds, naming them after the file', async () => {
+    const { da, empty } = setup();
+    const r = await da.managePlaylists({
+      action: 'update',
+      playlist: 'Empty',
+      add_sounds: [{ path: 'worlds/w/uploads/audio/cave-drip.mp3', volume: 0.4, repeat: true }, { path: 'x/y.ogg', name: 'Wind' }],
+    });
+    expect(r.soundsAdded).toBe(2);
+    expect(empty.createEmbeddedDocuments).toHaveBeenNthCalledWith(1, 'PlaylistSound', [
+      { path: 'worlds/w/uploads/audio/cave-drip.mp3', name: 'cave-drip', volume: 0.4, repeat: true },
+    ]);
+    expect(empty.createEmbeddedDocuments).toHaveBeenNthCalledWith(2, 'PlaylistSound', [{ path: 'x/y.ogg', name: 'Wind' }]);
+    await expect(da.managePlaylists({ action: 'update', playlist: 'Empty', add_sounds: [{} as any] })).rejects.toThrow('"path"');
+  });
+
+  it('removes sounds by id, name or path, only when one matches', async () => {
+    const { da, battle } = setup();
+    const r = await da.managePlaylists({ action: 'update', playlist: 'Battle', remove_sounds: ['s1', 'Horns'] });
+    expect(r.soundsRemoved).toBe(2);
+    expect(battle.deleteEmbeddedDocuments).toHaveBeenCalledWith('PlaylistSound', ['s1', 's2']);
+    await expect(da.managePlaylists({ action: 'update', playlist: 'Battle', remove_sounds: ['nope'] })).rejects.toThrow('no sound matches');
+  });
+});
+
+describe('audio file checks', () => {
+  const b = (...v: number[]) => Uint8Array.from([...v, ...new Array(16).fill(0)]);
+  it('recognises the formats by their first bytes', () => {
+    expect(detectAudioType(b(0x49, 0x44, 0x33))).toBe('mp3');
+    expect(detectAudioType(b(0xff, 0xfb))).toBe('mp3');
+    expect(detectAudioType(b(0x4f, 0x67, 0x67, 0x53))).toBe('ogg');
+    expect(detectAudioType(Uint8Array.from([0x52, 0x49, 0x46, 0x46, 0, 0, 0, 0, 0x57, 0x41, 0x56, 0x45]))).toBe('wav');
+    expect(detectAudioType(b(0x66, 0x4c, 0x61, 0x43))).toBe('flac');
+    expect(detectAudioType(Uint8Array.from([0, 0, 0, 0x20, 0x66, 0x74, 0x79, 0x70, 0, 0, 0, 0]))).toBe('m4a');
+    expect(detectAudioType(Buffer.from('<html>'))).toBeNull();
+    expect(detectAudioType(Uint8Array.from([0x89, 0x50, 0x4e, 0x47]))).toBeNull();
+  });
+  it('matches the extension to the content', () => {
+    expect(extensionMatchesAudio('a.mp3', 'mp3')).toBe(true);
+    expect(extensionMatchesAudio('a.opus', 'ogg')).toBe(true);
+    expect(extensionMatchesAudio('a.wav', 'mp3')).toBe(false);
+  });
+  it('accepts audio names and still refuses others', () => {
+    expect(sanitizeUploadFilename('Cave Drip.MP3')).toBe('Cave_Drip.mp3');
+    expect(() => sanitizeUploadFilename('x.exe')).toThrow('Unsupported file type');
+  });
+});
+
+describe('uploadFile with audio', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  function setupUpload() {
+    const upload = vi.fn(async (_s: string, dir: string, file: File) => ({ path: `${dir}/${file.name}` }));
+    vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+    vi.stubGlobal('FilePicker', { createDirectory: vi.fn(async () => undefined), browse: vi.fn(async () => ({ files: [] })), upload });
+    vi.stubGlobal('game', {
+      ready: true,
+      world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+      user: { id: 'gm', name: 'GM' },
+      settings: { get: (_m: string, key: string) => (key === 'allowWriteOperations' ? true : undefined) },
+    });
+    return { da: new FoundryDataAccess(), upload };
+  }
+  const mp3 = Buffer.concat([Buffer.from('ID3'), Buffer.alloc(32, 1)]).toString('base64');
+
+  it('uploads an mp3 with an audio type', async () => {
+    const { da, upload } = setupUpload();
+    const r = await da.uploadFile({ filename: 'drip.mp3', imageData: mp3, folder: 'audio' });
+    expect(r.success).toBe(true);
+    const file = (upload.mock.calls as any[][])[0]![2] as File;
+    expect(file.type).toBe('audio/mpeg');
+  });
+
+  it('refuses audio with the wrong extension and unknown content', async () => {
+    const { da, upload } = setupUpload();
+    await expect(da.uploadFile({ filename: 'drip.wav', imageData: mp3 })).rejects.toThrow('name says otherwise');
+    await expect(da.uploadFile({ filename: 'drip.mp3', imageData: Buffer.from('hello world, not audio').toString('base64') })).rejects.toThrow('not a PNG');
+    expect(upload).not.toHaveBeenCalled();
+  });
+});
diff --git a/packages/foundry-module/src/data-access.plutonium.test.ts b/packages/foundry-module/src/data-access.plutonium.test.ts

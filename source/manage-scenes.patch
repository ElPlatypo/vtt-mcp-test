+});
+
+import { splitSpeechSegments, startDelayMs } from './speech.js';
+
+describe('splitting speech into pieces', () => {
+  it('splits at sentences and joins very short ones to the next', () => {
+    const t = 'You have been on the Triboar Trail for about half a day. As you come around a bend, you spot two dead horses. Roll. For initiative, now please.';
+    expect(splitSpeechSegments(t)).toEqual([
+      'You have been on the Triboar Trail for about half a day.',

@@ -0,0 +1,50 @@
+import { describe, expect, it } from 'vitest';
+import { dayPart, describeDuration, describeTime, durationSeconds, secondsUntil, type CalendarLike, type TimeComponents } from './time-utils.js';
+
+const cal: CalendarLike = {
+  name: 'Simplified Gregorian',
+  months: { values: [{ name: 'January' }, { name: 'February' }] },
+  days: { values: [{ name: 'Monday' }, { name: 'Tuesday' }], hoursPerDay: 24, minutesPerHour: 60, secondsPerMinute: 60 },
+  seasons: { values: [{ name: 'Spring' }, { name: 'Summer' }, { name: 'Fall' }, { name: 'Winter' }] },
+  years: { yearZero: 1491 },
+  sunrise: () => 6,
+  sunset: () => 18,
+};
+const at = (hour: number, minute = 0, extra: Partial<TimeComponents> = {}): TimeComponents => ({ year: 0, day: 0, dayOfMonth: 0, dayOfWeek: 1, hour, minute, second: 0, month: 0, season: 3, ...extra });
+
+describe('in-game time', () => {
+  it('describes a moment readably', () => {
+    expect(describeTime(cal, at(21, 5), 0)).toEqual({
+      calendar: 'Simplified Gregorian',
+      date: 'Tuesday, 1 January, year 1491',
+      time: '21:05',
+      partOfDay: 'night',
+      season: 'Winter',
+      sunrise: '06:00',
+      sunset: '18:00',
+      worldTime: 0,
+    });
+  });
+  it('names the parts of the day', () => {
+    expect(dayPart(6.2, 6, 18)).toBe('dawn');
+    expect(dayPart(9, 6, 18)).toBe('morning');
+    expect(dayPart(14, 6, 18)).toBe('afternoon');
+    expect(dayPart(18.4, 6, 18)).toBe('dusk');
+    expect(dayPart(19, 6, 18)).toBe('evening');
+    expect(dayPart(23, 6, 18)).toBe('night');
+    expect(dayPart(3, 6, 18)).toBe('night');
+  });
+  it('finds the next dawn, dusk or midnight, always ahead', () => {
+    expect(secondsUntil(cal, at(22), 'dawn')).toBe(8 * 3600);
+    expect(secondsUntil(cal, at(5), 'dawn')).toBe(3600);
+    expect(secondsUntil(cal, at(6), 'dawn')).toBe(24 * 3600);
+    expect(secondsUntil(cal, at(12, 30), 'dusk')).toBe(5.5 * 3600);
+    expect(secondsUntil(cal, at(23), 'midnight')).toBe(3600);
+  });
+  it('adds up durations and reads them back', () => {
+    expect(durationSeconds(cal, { hours: 8 })).toBe(28800);
+    expect(durationSeconds(cal, { days: 1, minutes: 30, rounds: 10 })).toBe(86400 + 1800 + 60);
+    expect(describeDuration(cal, 90061)).toBe('1 day, 1 hour, 1 minute, 1 second');
+    expect(describeDuration(cal, 0)).toBe('0 seconds');
+  });
+});

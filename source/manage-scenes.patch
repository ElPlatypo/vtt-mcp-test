+/**
+ * Pure helpers for inspect-document: limit how deep and how long returned data is, pick a
+ * part of a document by path, and describe a document's field schema. No Foundry globals.
+ */
+
+/** Document types that can be listed and read by name. Users and settings are left out. */
+export const INSPECTABLE_TYPES = [
+  'Actor',
+  'Item',
+  'Scene',
+  'JournalEntry',
+  'RollTable',
+  'Macro',
+  'Playlist',
+  'Cards',
+  'Folder',
+  'Combat',
+  'ChatMessage',
+] as const;
+export type InspectableType = (typeof INSPECTABLE_TYPES)[number];
+
+export const DEFAULT_MAX_CHARS = 20000;
+export const MAX_MAX_CHARS = 100000;
+
+/**
+ * Replace everything nested deeper than `depth` levels with a short placeholder, so a big
+ * document can be read level by level. Depth 1 keeps the top-level keys only.
+ */
+export function trimDepth(value: unknown, depth: number): unknown {
+  if (value === null || typeof value !== 'object') return value;
+  if (depth <= 0) {
+    return Array.isArray(value)
+      ? `[array of ${value.length}]`
+      : `{object with ${Object.keys(value).length} keys}`;
+  }
+  if (Array.isArray(value)) return value.map(item => trimDepth(item, depth - 1));
+  const out: Record<string, unknown> = {};
+  for (const [key, inner] of Object.entries(value as Record<string, unknown>)) {
+    out[key] = trimDepth(inner, depth - 1);
+  }
+  return out;
+}
+
+/** Read a part of an object by dotted path ("system.attributes.hp", "items.0.name"). */
+export function pickPath(value: unknown, path: string): unknown {
+  const parts = path.split('.').filter(part => part.length > 0);
+  if (parts.length === 0) throw new Error('path is empty');
+  let cursor: any = value;
+  const seen: string[] = [];
+  for (const part of parts) {
+    if (cursor === null || typeof cursor !== 'object' || !(part in cursor)) {
+      const where = seen.length ? seen.join('.') : 'the document';
+      const keys =
+        cursor !== null && typeof cursor === 'object'
+          ? Object.keys(cursor).slice(0, 30).join(', ')
+          : '(not an object)';
+      throw new Error(`Nothing at "${[...seen, part].join('.')}". Keys of ${where}: ${keys}`);
+    }
+    cursor = cursor[part];
+    seen.push(part);
+  }
+  return cursor;
+}
+
+/** Serialise, and cut off with a note if the result would be longer than maxChars. */
+export function limitJson(value: unknown, maxChars: number): { json: string; truncated: boolean } {
+  const json = JSON.stringify(value, null, 1) ?? 'null';
+  if (json.length <= maxChars) return { json, truncated: false };
+  return { json: json.slice(0, maxChars), truncated: true };
+}
+
+export interface SchemaNode {
+  type: string;
+  required?: boolean;
+  nullable?: boolean;
+  initial?: unknown;
+  choices?: unknown[];
+  min?: number;
+  max?: number;
+  fields?: Record<string, SchemaNode>;
+  element?: SchemaNode;
+}
+
+/**
+ * Describe a Foundry DataField tree as plain data: each field's kind (StringField,
+ * NumberField, ...), whether it is required, its allowed choices and its children.
+ * Works on any object shaped like a DataField, so it can be tested without Foundry.
+ */
+export function describeFields(
+  fields: Record<string, any>,
+  depth: number
+): Record<string, SchemaNode> {
+  const out: Record<string, SchemaNode> = {};
+  for (const [name, field] of Object.entries(fields ?? {})) {
+    out[name] = describeField(field, depth);
+  }
+  return out;
+}
+
+function describeField(field: any, depth: number): SchemaNode {
+  const node: SchemaNode = { type: String(field?.constructor?.name ?? 'Unknown') };
+  if (field?.required) node.required = true;
+  if (field?.nullable) node.nullable = true;
+  const initial = field?.initial;
+  if (initial !== undefined && typeof initial !== 'function') node.initial = initial;
+  if (typeof field?.min === 'number') node.min = field.min;
+  if (typeof field?.max === 'number') node.max = field.max;
+
+  const choices = field?.choices;
+  if (Array.isArray(choices)) node.choices = choices.slice(0, 40);
+  else if (choices && typeof choices === 'object') node.choices = Object.keys(choices).slice(0, 40);
+
+  if (depth > 1) {
+    if (field?.fields && typeof field.fields === 'object') {
+      node.fields = describeFields(field.fields, depth - 1);
+    }
+    if (field?.element && typeof field.element === 'object') {
+      node.element = describeField(field.element, depth - 1);
+    }
+  }
+  return node;
+}

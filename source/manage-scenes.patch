+/** move-token walks with Foundry's own movement: path around walls, cost, speed limit. Foundry is stubbed. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+
+function setup(options: { cost?: number; speed?: number; late?: boolean; pathEnd?: { x: number; y: number } } = {}) {
+  const end = options.pathEnd ?? { x: 320, y: 64 };
+  // Applies the move to the token, as Foundry does (late when options.late: the promise resolves first).
+  const move = vi.fn(async function (this: any, path: any[]) {
+    const last = path[path.length - 1];
+    if (options.late) setTimeout(() => Object.assign(this, { x: last.x, y: last.y }), 200);
+    else Object.assign(this, { x: last.x, y: last.y });
+  });
+  // Applies the change to the token it is called on, as Foundry would.
+  const update = vi.fn(async function (this: any, changes: any) {
+    Object.assign(this, changes);
+  });
+  const findMovementPath = vi.fn(() => ({ promise: Promise.resolve([{ x: end.x, y: end.y, action: 'walk' }]) }));
+  const measureMovementPath = vi.fn(() => ({ cost: options.cost ?? 25 }));
+  const token: any = {
+    id: 't1',
+    name: 'Goblin 1',
+    x: 64,
+    y: 64,
+    movementAction: 'walk',
+    actor: { system: { attributes: { movement: { walk: options.speed ?? 30 } } } },
+    parent: { grid: { units: 'ft' } },
+    object: { findMovementPath },
+    move,
+    update,
+    measureMovementPath,
+  };
+  const scene: any = { id: 's1', name: 'Cave', grid: { size: 64 }, tokens: new Map([['t1', token]]) };
+  token.parent = { ...token.parent, ...scene };
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'GM' },
+    scenes: { contents: [scene], current: scene, viewed: scene },
+    settings: { get: (_m: string, key: string) => (key === 'allowWriteOperations' ? true : undefined) },
+  });
+  return { da: new FoundryDataAccess(), token, move, update, findMovementPath };
+}
+
+describe('moveToken walking', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('returns only once the token document has the destination', async () => {
+    const { da, token } = setup({ late: true });
+    await da.moveToken({ tokenId: 't1', x: 320, y: 64 });
+    expect(token.x).toBe(320);
+    expect(token.y).toBe(64);
+  });
+
+  it('walks with the system movement, constrained by walls and cost', async () => {
+    const { da, move, update, findMovementPath } = setup();
+    const r = await da.moveToken({ tokenId: 't1', x: 320, y: 64 });
+    expect(findMovementPath).toHaveBeenCalledWith([{ x: 320, y: 64 }], { constrainOptions: { ignoreWalls: false, ignoreCost: false } });
+    expect(move).toHaveBeenCalledWith([{ x: 320, y: 64, action: 'walk' }], expect.objectContaining({ method: 'api', constrainOptions: { ignoreWalls: false, ignoreCost: false } }));
+    expect(update).not.toHaveBeenCalled();
+    expect(r).toMatchObject({ success: true, moved: true, cost: '25 ft', speed: '30 ft' });
+    expect(r.blocked).toBeUndefined();
+  });
+  it('refuses a walk that costs more than the speed, unless dash or ignore_speed', async () => {
+    const { da, move } = setup({ cost: 40 });
+    const refused = await da.moveToken({ tokenId: 't1', x: 320, y: 64 });
+    expect(refused).toMatchObject({ moved: false, cost: '40 ft', speed: '30 ft' });
+    expect(refused.reason).toContain('Too far');
+    expect(move).not.toHaveBeenCalled();
+    expect((await da.moveToken({ tokenId: 't1', x: 320, y: 64, dash: true })).moved).toBe(true);
+    expect((await da.moveToken({ tokenId: 't1', x: 320, y: 64, ignore_speed: true })).moved).toBe(true);
+    const used = await da.moveToken({ tokenId: 't1', x: 320, y: 64, used: 10, cost: 25 } as any);
+    expect(used.moved).toBe(false); // 30 - 10 = 20 available, 40 needed
+  });
+  it('says when a wall stopped the walk short', async () => {
+    const { da, move } = setup({ cost: 10, pathEnd: { x: 128, y: 64 } });
+    const r = await da.moveToken({ tokenId: 't1', x: 320, y: 64 });
+    expect(move).toHaveBeenCalled();
+    expect(r).toMatchObject({ moved: true, blocked: true, stoppedAt: { x: 128, y: 64 } });
+  });
+  it('teleports on request, ignoring walls and speed', async () => {
+    const { da, update, move, findMovementPath } = setup({ cost: 500 });
+    const r = await da.moveToken({ tokenId: 't1', x: 320, y: 64, mode: 'teleport' });
+    expect(update).toHaveBeenCalledWith({ x: 320, y: 64 }, { animate: true });
+    expect(move).not.toHaveBeenCalled();
+    expect(findMovementPath).not.toHaveBeenCalled();
+    expect(r.moved).toBeUndefined();
+  });
+  it('places the token directly, with a note, when the scene is not on screen', async () => {
+    const { da, token, update } = setup();
+    delete token.object;
+    const r = await da.moveToken({ tokenId: 't1', x: 320, y: 64 });
+    expect(update).toHaveBeenCalled();
+    expect(r.note).toContain('not the one on screen');
+    await expect(da.moveToken({ tokenId: 't1', x: 1, y: 1, mode: 'fly' as any })).rejects.toThrow('mode must be');
+  });
+});

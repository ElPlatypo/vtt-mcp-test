+  private async build(doc: LayoutDoc, a: Args): Promise<any> {
+    if (!this.generate || !this.upload) throw new Error('build needs image generation and upload, which are not available here');
+    if (!a.scene_name) throw new Error('build needs scene_name');
+    if (!a.prompt) throw new Error('build needs prompt (describe the look of the map)');
+    const width = doc.columns * doc.size;
+    const height = doc.rows * doc.size;
+    if (width % 32 !== 0 || height % 32 !== 0) {
+      throw new Error(`The picture would be ${width} x ${height} pixels; the image model needs multiples of 32. Change the layout columns, rows or grid_size (set grid_size 32, 64 or pick even columns for 48).`);
+    }
+    const steps: string[] = [];
+    const sketch = await this.render(doc);
+    steps.push('sketch rendered');
+    const generated = await this.generate({
+      kind: 'map',
+      width,
+      height,
+      upload: false,
+      reference_images: [sketch.file],
+      prompt: `<Picture 1> is the exact floor plan to follow. ${sketch.legend} ${a.prompt} No text, no numbers, no grid lines, no characters.`,
+    });
+    if (generated?.success === false) throw new Error(generated.error || 'The map could not be generated');
+    const localPath: string | undefined = generated?.local_path;
+    if (!localPath) throw new Error('The image generator returned no file');
+    steps.push(`map generated (${generated.seconds ?? '?'} s)`);

+      { mapGenMode: 'custom', mapGenCustomHost: 'my host', mapGenCustomPort: 8188 },
+      'host must be',
+    ],
+    [
+      'a text port',
+      { mapGenMode: 'custom', mapGenCustomHost: 'nexus', mapGenCustomPort: 'abc' },
+      'port must be',
+    ],
+    [
+      'port 0',
+      { mapGenMode: 'custom', mapGenCustomHost: 'nexus', mapGenCustomPort: 0 },
+      'port must be',
+    ],
+    [
+      'port 99999',
+      { mapGenMode: 'custom', mapGenCustomHost: 'nexus', mapGenCustomPort: 99999 },
+      'port must be',
+    ],
+    [
+      'a decimal port',
+      { mapGenMode: 'custom', mapGenCustomHost: 'nexus', mapGenCustomPort: 80.5 },
+      'port must be',
+    ],
+    [

+/**
+ * upload-file tests. Foundry's file picker is stubbed: these check what the bridge asks
+ * Foundry to do (which folders, which file, which checks) and that unsafe input is refused
+ * before anything is uploaded. Whether a real Foundry accepts the upload needs a real world.
+ */
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+import { UPLOAD_MAX_BYTES } from './upload-utils.js';
+
+const PNG_HEAD = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a];
+
+function pngBase64(extraBytes = 16): string {
+  return Buffer.from([...PNG_HEAD, ...new Array(extraBytes).fill(7)]).toString('base64');
+}
+
+function setup(
+  options: { allowWriteOperations?: boolean; existingFiles?: string[]; noWorld?: boolean } = {}
+) {
+  const createDirectory = vi.fn(async () => undefined);
+  const browse = vi.fn(async () => ({ files: options.existingFiles ?? [] }));
+  const upload = vi.fn(async (_source: string, directory: string, file: File) => ({
+    status: 'success',
+    path: `${directory}/${file.name}`,
+  }));
+
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('FilePicker', { createDirectory, browse, upload });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: options.noWorld
+      ? { getFlag: vi.fn(() => []), setFlag: vi.fn() }
+      : { id: 'world-1', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'Gamemaster' },
+    settings: {
+      get: (_module: string, key: string) =>
+        key === 'allowWriteOperations' ? (options.allowWriteOperations ?? true) : undefined,
+    },
+  });
+
+  return { dataAccess: new FoundryDataAccess(), createDirectory, browse, upload };
+}
+
+describe('FoundryDataAccess.uploadFile', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('uploads into the world upload folder and returns the Foundry path', async () => {
+    const { dataAccess, createDirectory, upload } = setup();
+
+    const result = await dataAccess.uploadFile({ filename: 'Cave.PNG', imageData: pngBase64() });
+
+    expect(createDirectory.mock.calls.map(c => c[1])).toEqual([
+      'worlds',
+      'worlds/world-1',
+      'worlds/world-1/uploads',
+    ]);
+    expect(upload).toHaveBeenCalledTimes(1);
+    const [source, directory, file, , uploadOptions] = upload.mock.calls[0] as unknown as [
+      string,
+      string,
+      File,
+      unknown,
+      unknown,
+    ];
+    expect(source).toBe('data');
+    expect(directory).toBe('worlds/world-1/uploads');
+    expect(file.name).toBe('Cave.png');
+    expect(file.type).toBe('image/png');
+    expect(file.size).toBe(PNG_HEAD.length + 16);
+    expect(uploadOptions).toEqual({ notify: false });
+    expect(result).toMatchObject({
+      success: true,
+      path: 'worlds/world-1/uploads/Cave.png',
+      filename: 'Cave.png',
+      directory: 'worlds/world-1/uploads',
+      contentType: 'image/png',
+    });
+  });
+
+  it('creates and uses a nested sub-folder', async () => {
+    const { dataAccess, createDirectory, upload } = setup();
+
+    const result = await dataAccess.uploadFile({
+      filename: 'a.png',
+      imageData: pngBase64(),
+      folder: 'maps/phandelver',
+    });
+
+    expect(createDirectory.mock.calls.map(c => c[1])).toEqual([
+      'worlds',
+      'worlds/world-1',
+      'worlds/world-1/uploads',
+      'worlds/world-1/uploads/maps',
+      'worlds/world-1/uploads/maps/phandelver',
+    ]);
+    expect(upload.mock.calls[0][1]).toBe('worlds/world-1/uploads/maps/phandelver');
+    expect(result.path).toBe('worlds/world-1/uploads/maps/phandelver/a.png');
+  });
+
+  it('keeps going when a directory already exists', async () => {
+    const { dataAccess, createDirectory, upload } = setup();
+    createDirectory.mockRejectedValue(new Error('EEXIST: directory already exists'));
+
+    await expect(
+      dataAccess.uploadFile({ filename: 'a.png', imageData: pngBase64() })
+    ).resolves.toMatchObject({ success: true });
+    expect(upload).toHaveBeenCalled();
+  });
+
+  it('strips a directory or traversal from the filename', async () => {
+    const { dataAccess, upload } = setup();
+
+    const result = await dataAccess.uploadFile({
+      filename: '../../../secret/evil.png',
+      imageData: pngBase64(),
+    });
+
+    expect(result.filename).toBe('evil.png');
+    expect(upload.mock.calls[0][1]).toBe('worlds/world-1/uploads');
+  });
+
+  describe('existing files', () => {
+    it('refuses to replace an existing file by default, before uploading', async () => {
+      const { dataAccess, upload } = setup({
+        existingFiles: ['worlds/world-1/uploads/a.png'],
+      });
+
+      await expect(
+        dataAccess.uploadFile({ filename: 'a.png', imageData: pngBase64() })
+      ).rejects.toThrow('File already exists: worlds/world-1/uploads/a.png');
+      expect(upload).not.toHaveBeenCalled();
+    });
+
+    it('replaces it when overwrite is true, without listing the folder', async () => {
+      const { dataAccess, upload, browse } = setup({
+        existingFiles: ['worlds/world-1/uploads/a.png'],
+      });
+
+      await expect(
+        dataAccess.uploadFile({ filename: 'a.png', imageData: pngBase64(), overwrite: true })
+      ).resolves.toMatchObject({ success: true });
+      expect(upload).toHaveBeenCalledTimes(1);
+      expect(browse).not.toHaveBeenCalled();
+    });
+
+    it('compares against the cleaned name, so "my map.png" is stored as my_map.png', async () => {
+      const { dataAccess, upload } = setup({
+        existingFiles: ['worlds/world-1/uploads/my_map.png'],
+      });
+
+      await expect(
+        dataAccess.uploadFile({ filename: 'my map.png', imageData: pngBase64() })
+      ).rejects.toThrow('File already exists: worlds/world-1/uploads/my_map.png');
+      expect(upload).not.toHaveBeenCalled();
+    });
+
+    it('is not fooled by a malformed entry elsewhere in the listing', async () => {
+      const { dataAccess, upload } = setup({
+        existingFiles: ['worlds/world-1/uploads/bad%E0%A4%A.png', 'worlds/world-1/uploads/a.png'],
+      });
+
+      await expect(
+        dataAccess.uploadFile({ filename: 'a.png', imageData: pngBase64() })
+      ).rejects.toThrow('already exists');
+      expect(upload).not.toHaveBeenCalled();
+    });
+
+    it('still uploads when the folder cannot be listed', async () => {
+      const { dataAccess, browse, upload } = setup();
+      browse.mockRejectedValue(new Error('cannot browse'));
+
+      await dataAccess.uploadFile({ filename: 'a.png', imageData: pngBase64() });
+
+      expect(upload).toHaveBeenCalled();
+    });
+  });
+
+  describe('refuses bad input before uploading anything', () => {
+    it.each([
+      ['a file that is not an image', 'a.png', Buffer.from('just some text').toString('base64')],
+      ['an SVG', 'a.png', Buffer.from('<svg xmlns="x"></svg>').toString('base64')],
+      ['a name that disagrees with the content', 'a.jpg', pngBase64()],
+      ['an unsupported extension', 'a.txt', pngBase64()],
+      ['empty data', 'a.png', ''],
+      ['data that is not base64', 'a.png', '%%%%'],
+    ])('%s', async (_label, filename, imageData) => {
+      const { dataAccess, upload, createDirectory } = setup();
+
+      await expect(dataAccess.uploadFile({ filename, imageData })).rejects.toThrow(
+        /Failed to upload file/
+      );
+      expect(upload).not.toHaveBeenCalled();
+      expect(createDirectory).not.toHaveBeenCalled();
+    });
+
+    it('a file over the size limit', async () => {
+      const { dataAccess, upload } = setup();
+      const big = Buffer.alloc(UPLOAD_MAX_BYTES + 1);
+      Buffer.from(PNG_HEAD).copy(big);
+
+      await expect(
+        dataAccess.uploadFile({ filename: 'big.png', imageData: big.toString('base64') })
+      ).rejects.toThrow('the limit is 20 MB');
+      expect(upload).not.toHaveBeenCalled();
+    });
+
+    it.each(['..', '../outside', 'a/../../b', 'has space'])('the folder "%s"', async folder => {
+      const { dataAccess, upload, createDirectory } = setup();
+
+      await expect(
+        dataAccess.uploadFile({ filename: 'a.png', imageData: pngBase64(), folder })
+      ).rejects.toThrow(/Failed to upload file/);
+      expect(upload).not.toHaveBeenCalled();
+      expect(createDirectory).not.toHaveBeenCalled();
+    });
+  });
+
+  describe('permissions and failures', () => {
+    it('is blocked when write operations are disabled', async () => {
+      const { dataAccess, upload } = setup({ allowWriteOperations: false });
+
+      await expect(
+        dataAccess.uploadFile({ filename: 'a.png', imageData: pngBase64() })
+      ).rejects.toThrow(/disabled in module settings/);
+      expect(upload).not.toHaveBeenCalled();
+    });
+
+    it('needs a loaded world', async () => {
+      const { dataAccess } = setup({ noWorld: true });
+
+      await expect(
+        dataAccess.uploadFile({ filename: 'a.png', imageData: pngBase64() })
+      ).rejects.toThrow('No world is loaded');
+    });
+
+    it('reports an upload that Foundry did not confirm', async () => {
+      const { dataAccess, upload } = setup();
+      upload.mockResolvedValue(false as any);
+
+      await expect(
+        dataAccess.uploadFile({ filename: 'a.png', imageData: pngBase64() })
+      ).rejects.toThrow('did not confirm the upload');
+    });
+  });
+});

@@ -0,0 +1,410 @@
+/**
+ * manage-scenes tests (create / update / describe).
+ *
+ * Foundry itself is stubbed: these check the payload the bridge sends to
+ * Scene.create / scene.update, the v14 background-on-Level handling, validation
+ * and the write-permission gate. They cannot prove Foundry accepts the payload;
+ * that needs a real world (see the install and test guide).
+ */
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+
+function makeScene(overrides: Record<string, any> = {}) {
+  const level = overrides.level === null ? undefined : { background: { src: '' }, update: vi.fn() };
+  const scene: any = {
+    id: 'scene-1',
+    name: 'Old Name',
+    active: false,
+    width: 4000,
+    height: 3000,
+    padding: 0.25,
+    backgroundColor: '#999999',
+    grid: { type: 1, size: 100, distance: 5, units: 'ft' },
+    tokenVision: true,
+    environment: { darknessLevel: 0, globalLight: { enabled: false } },
+    navigation: false,
+    navName: '',
+    _source: {},
+    levels: { contents: level ? [level] : [] },
+    update: vi.fn(async () => undefined),
+    activate: vi.fn(async () => undefined),
+    createEmbeddedDocuments: vi.fn(async () => []),
+    ...overrides,
+  };
+  delete scene.level;
+  return { scene, level };
+}
+
+function setup(
+  options: { generation?: number; allowWriteOperations?: boolean; scenes?: any[] } = {}
+) {
+  const created = makeScene({ id: 'scene-new', name: 'Created', level: null });
+  const create = vi.fn(async (data: any) => {
+    Object.assign(created.scene, { name: data.name });
+    return created.scene;
+  });
+
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('Scene', { create });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'world-1', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'Gamemaster' },
+    release: { generation: options.generation ?? 14 },
+    scenes: { contents: options.scenes ?? [] },
+    settings: {
+      get: (_module: string, key: string) =>
+        key === 'allowWriteOperations' ? (options.allowWriteOperations ?? true) : undefined,
+    },
+  });
+
+  return {
+    dataAccess: new FoundryDataAccess(),
+    create,
+    created: created.scene,
+  };
+}
+
+describe('FoundryDataAccess.manageScenes', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  describe('create', () => {
+    it('sends the scene fields to Scene.create, with the grid nested', async () => {
+      const { dataAccess, create } = setup();
+
+      const result = await dataAccess.manageScenes({
+        action: 'create',
+        name: '  Cragmaw Cave  ',
+        width: 5000,
+        height: 3500,
+        grid_size: 140,
+        grid_distance: 5,
+        grid_units: 'ft',
+        darkness: 0.8,
+        global_light: false,
+        token_vision: true,
+        navigation: true,
+        nav_name: 'Cave',
+        background_color: '#112233',
+      });
+
+      expect(create).toHaveBeenCalledWith({
+        name: 'Cragmaw Cave',
+        width: 5000,
+        height: 3500,
+        grid: { size: 140, distance: 5, units: 'ft' },
+        environment: { darknessLevel: 0.8, globalLight: { enabled: false } },
+        tokenVision: true,
+        navigation: true,
+        navName: 'Cave',
+      });
+      // v14 has no Scene#backgroundColor field: the colour goes onto the first Level instead.
+      expect(result.success).toBe(true);
+      expect(result.action).toBe('create');
+      expect(result.scene.id).toBe('scene-new');
+    });
+
+    it('on v14 puts the background on a new Base level when the scene has none', async () => {
+      const { dataAccess, created } = setup({ generation: 14 });
+
+      await dataAccess.manageScenes({
+        action: 'create',
+        name: 'Road',
+        background: 'worlds/w/maps/road.webp',
+      });
+
+      expect(created.createEmbeddedDocuments).toHaveBeenCalledWith('Level', [
+        { name: 'Base', background: { src: 'worlds/w/maps/road.webp' } },
+      ]);
+      expect(created.update).not.toHaveBeenCalled();
+    });
+
+    it('on v13 writes background.src on the scene itself', async () => {
+      const { dataAccess, created } = setup({ generation: 13 });
+
+      await dataAccess.manageScenes({
+        action: 'create',
+        name: 'Road',
+        background: 'worlds/w/maps/road.webp',
+      });
+
+      expect(created.update).toHaveBeenCalledWith({
+        background: { src: 'worlds/w/maps/road.webp' },
+      });
+      expect(created.createEmbeddedDocuments).not.toHaveBeenCalled();
+    });
+
+    it('requires a name', async () => {
+      const { dataAccess, create } = setup();
+
+      await expect(dataAccess.manageScenes({ action: 'create', width: 4000 })).rejects.toThrow(
+        'name is required for create'
+      );
+      expect(create).not.toHaveBeenCalled();
+    });
+
+    it('activates the scene only when asked', async () => {
+      const { dataAccess, created } = setup();
+
+      await dataAccess.manageScenes({ action: 'create', name: 'A' });
+      expect(created.activate).not.toHaveBeenCalled();
+
+      await dataAccess.manageScenes({ action: 'create', name: 'B', activate: true });
+      expect(created.activate).toHaveBeenCalledTimes(1);
+    });
+  });
+
+  describe('update', () => {
+    it('renames and edits the grid of a scene found by name', async () => {
+      const { scene } = makeScene();
+      const { dataAccess } = setup({ scenes: [scene] });
+
+      const result = await dataAccess.manageScenes({
+        action: 'update',
+        scene_identifier: 'old name',
+        name: 'Cave Mouth',
+        grid_size: 120,
+      });
+
+      expect(scene.update).toHaveBeenCalledWith({ name: 'Cave Mouth', grid: { size: 120 } });
+      expect(result.scene.id).toBe('scene-1');
+    });
+
+    it('updates the existing first level on v14 instead of creating one', async () => {
+      const { scene, level } = makeScene();
+      const { dataAccess } = setup({ generation: 14, scenes: [scene] });
+
+      await dataAccess.manageScenes({
+        action: 'update',
+        scene_identifier: 'scene-1',
+        background: 'worlds/w/maps/cave.webp',
+      });
+
+      expect(level!.update).toHaveBeenCalledWith({
+        background: { src: 'worlds/w/maps/cave.webp' },
+      });
+      expect(scene.createEmbeddedDocuments).not.toHaveBeenCalled();
+      expect(scene.update).not.toHaveBeenCalled();
+    });
+
+    it('clears the background with null', async () => {
+      const { scene, level } = makeScene();
+      const { dataAccess } = setup({ generation: 14, scenes: [scene] });
+
+      await dataAccess.manageScenes({
+        action: 'update',
+        scene_identifier: 'scene-1',
+        background: null,
+      });
+
+      expect(level!.update).toHaveBeenCalledWith({ background: { src: null } });
+    });
+
+    it('fails clearly for an unknown scene', async () => {
+      const { dataAccess } = setup();
+
+      await expect(
+        dataAccess.manageScenes({ action: 'update', scene_identifier: 'nope', name: 'x' })
+      ).rejects.toThrow('Scene not found: "nope"');
+    });
+
+    it('rejects an update that changes nothing', async () => {
+      const { scene } = makeScene();
+      const { dataAccess } = setup({ scenes: [scene] });
+
+      await expect(
+        dataAccess.manageScenes({ action: 'update', scene_identifier: 'scene-1' })
+      ).rejects.toThrow('Nothing to update');
+      expect(scene.update).not.toHaveBeenCalled();
+    });
+
+    it('requires scene_identifier', async () => {
+      const { dataAccess } = setup();
+
+      await expect(dataAccess.manageScenes({ action: 'update', name: 'x' })).rejects.toThrow(
+        'scene_identifier is required for update'
+      );
+    });
+  });
+
+  describe('background colour', () => {
+    it('on v14 writes the colour to the first level, never to the scene', async () => {
+      const { scene, level } = makeScene();
+      const { dataAccess } = setup({ generation: 14, scenes: [scene] });
+
+      await dataAccess.manageScenes({
+        action: 'update',
+        scene_identifier: 'scene-1',
+        background_color: '#112233',
+      });
+
+      expect(level!.update).toHaveBeenCalledWith({ background: { color: '#112233' } });
+      expect(scene.update).not.toHaveBeenCalled();
+    });
+
+    it('on v14 resets the colour to the default #999999 with null', async () => {
+      const { scene, level } = makeScene();
+      const { dataAccess } = setup({ generation: 14, scenes: [scene] });
+
+      await dataAccess.manageScenes({
+        action: 'update',
+        scene_identifier: 'scene-1',
+        background_color: null,
+      });
+
+      expect(level!.update).toHaveBeenCalledWith({ background: { color: '#999999' } });
+    });
+
+    it('on v14 creates a Base level for the colour when the scene has no level', async () => {
+      const { dataAccess, create, created } = setup({ generation: 14 });
+
+      await dataAccess.manageScenes({
+        action: 'create',
+        name: 'Dark',
+        background_color: '#000000',
+      });
+
+      expect(create).toHaveBeenCalledWith({ name: 'Dark' });
+      expect(created.createEmbeddedDocuments).toHaveBeenCalledWith('Level', [
+        { name: 'Base', background: { color: '#000000' } },
+      ]);
+    });
+
+    it('on v13 still writes backgroundColor on the scene', async () => {
+      const { scene } = makeScene();
+      const { dataAccess } = setup({ generation: 13, scenes: [scene] });
+
+      await dataAccess.manageScenes({
+        action: 'update',
+        scene_identifier: 'scene-1',
+        background_color: '#112233',
+      });
+
+      expect(scene.update).toHaveBeenCalledWith({ backgroundColor: '#112233' });
+    });
+  });
+
+  describe('warnings for changes Foundry did not keep', () => {
+    it('reports a requested value the scene does not show afterwards', async () => {
+      // makeScene's update() is a no-op, like Foundry silently dropping a field.
+      const { scene } = makeScene();
+      const { dataAccess } = setup({ scenes: [scene] });
+
+      const result = await dataAccess.manageScenes({
+        action: 'update',
+        scene_identifier: 'scene-1',
+        grid_size: 120,
+      });
+
+      expect(result.success).toBe(true);
+      expect(result.warnings).toEqual(['grid_size was requested as 120 but the scene reports 100']);
+    });
+
+    it('adds no warnings when every requested change shows up', async () => {
+      const { scene } = makeScene();
+      scene.update = vi.fn(async (data: any) => {
+        if (data.name) scene.name = data.name;
+        if (data.grid?.size) scene.grid.size = data.grid.size;
+      });
+      const { dataAccess } = setup({ scenes: [scene] });
+
+      const result = await dataAccess.manageScenes({
+        action: 'update',
+        scene_identifier: 'scene-1',
+        name: 'New',
+        grid_size: 120,
+      });
+
+      expect(result.warnings).toBeUndefined();
+      expect(result.scene).toMatchObject({ name: 'New', grid: { size: 120 } });
+    });
+  });
+
+  describe('validation', () => {
+    it.each([
+      [{ grid_size: 10 }, 'grid_size must be between 50 and 1000'],
+      [{ grid_size: 100.5 }, 'grid_size must be a whole number'],
+      [{ darkness: 2 }, 'darkness must be between 0 and 1'],
+      [{ width: 50 }, 'width must be between 100 and 20000'],
+      [{ padding: 0.9 }, 'padding must be between 0 and 0.5'],
+      [{ grid_type: 9 }, 'grid_type must be between 0 and 5'],
+      [{ background_color: 'red' }, 'background_color must be a #RRGGBB hex string or null'],
+      [{ name: '   ' }, 'name must be a non-empty string'],
+      [{ background: '  ' }, 'background must be a file path string or null to clear it'],
+    ])('rejects %j', async (extra, message) => {
+      const { scene } = makeScene();
+      const { dataAccess, create } = setup({ scenes: [scene] });
+
+      await expect(
+        dataAccess.manageScenes({ action: 'update', scene_identifier: 'scene-1', ...extra })
+      ).rejects.toThrow(message);
+      expect(scene.update).not.toHaveBeenCalled();
+      expect(create).not.toHaveBeenCalled();
+    });
+
+    it('rejects an unknown action', async () => {
+      const { dataAccess } = setup();
+
+      await expect(dataAccess.manageScenes({ action: 'delete' as any })).rejects.toThrow(
+        'Unknown action: delete'
+      );
+    });
+  });
+
+  describe('permissions', () => {
+    it('blocks create and update when write operations are disabled', async () => {
+      const { scene } = makeScene();
+      const { dataAccess, create } = setup({ allowWriteOperations: false, scenes: [scene] });
+
+      await expect(dataAccess.manageScenes({ action: 'create', name: 'x' })).rejects.toThrow(
+        /disabled in module settings/
+      );
+      await expect(
+        dataAccess.manageScenes({ action: 'update', scene_identifier: 'scene-1', name: 'x' })
+      ).rejects.toThrow(/disabled in module settings/);
+      expect(create).not.toHaveBeenCalled();
+      expect(scene.update).not.toHaveBeenCalled();
+    });
+
+    it('still allows describe, which only reads', async () => {
+      const { scene } = makeScene();
+      const { dataAccess } = setup({ allowWriteOperations: false, scenes: [scene] });
+
+      const result = await dataAccess.manageScenes({ action: 'describe' });
+
+      expect(result.success).toBe(true);
+    });
+  });
+
+  describe('describe', () => {
+    it('lists every scene with grid and size', async () => {
+      const a = makeScene({ id: 'a', name: 'A' }).scene;
+      const b = makeScene({ id: 'b', name: 'B' }).scene;
+      const { dataAccess } = setup({ scenes: [a, b] });
+
+      const result = await dataAccess.manageScenes({ action: 'describe' });
+
+      expect(result.scenes.map((s: any) => s.name)).toEqual(['A', 'B']);
+      expect(result.scenes[0]).toMatchObject({
+        width: 4000,
+        height: 3000,
+        grid: { type: 1, size: 100, distance: 5, units: 'ft' },
+      });
+    });
+
+    it('reads one scene and its v14 level background', async () => {
+      const { scene, level } = makeScene({ id: 'a', name: 'Road' });
+      level!.background.src = 'worlds/w/maps/road.webp';
+      const { dataAccess } = setup({ scenes: [scene] });
+
+      const result = await dataAccess.manageScenes({
+        action: 'describe',
+        scene_identifier: 'Road',
+      });
+
+      expect(result.scene.background).toBe('worlds/w/maps/road.webp');
+    });
+  });
+});

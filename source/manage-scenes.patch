diff --git a/packages/mcp-server/src/tools/image-generation.test.ts b/packages/mcp-server/src/tools/image-generation.test.ts
new file mode 100644
index 0000000..4b2190f
--- /dev/null
+++ b/packages/mcp-server/src/tools/image-generation.test.ts
@@ -0,0 +1,257 @@
+import { mkdtempSync, existsSync, writeFileSync } from 'fs';
+import os from 'os';
+import path from 'path';
+import { describe, expect, it, vi } from 'vitest';
+import { DEFAULT_PROFILES } from '../image-profiles.js';
+import { ImageGenerationTools, slugify } from './image-generation.js';
+
+const PNG = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3]);
+
+const SAVED_PROFILES = {
+  map: { workflow: 'checkpoint', checkpoint: 'battle.safetensors' },
+  portrait: {
+    workflow: 'minimax-h3',
+    diffusionModel: 'h3.safetensors',
+    textEncoder: 'qwen.safetensors',
+    vae: 'h3vae.safetensors',
+  },
+  token: { workflow: 'minimax-h3', diffusionModel: '' },
+};
+
+function makeTools(options: { profiles?: any; uploadResult?: any; runError?: Error } = {}) {
+  const profiles = options.profiles ?? SAVED_PROFILES;
+  const query = vi.fn(async (method: string) => {
+    if (method === 'foundry-mcp-bridge.get-image-settings') {
+      return { success: true, target: { mode: 'custom', host: 'h', port: 1 }, profiles };
+    }
+    if (method === 'foundry-mcp-bridge.upload-file') {
+      return options.uploadResult ?? { success: true, path: 'worlds/w/uploads/generated/x.png' };
+    }
+    throw new Error(`unexpected ${method}`);
+  });
+  const runWorkflow = vi.fn(async () => {
+    if (options.runError) throw options.runError;
+    return { image: PNG, filename: 'f.png', promptId: 'p1' };
+  });
+  const uploadImage = vi.fn(async (_bytes: Buffer, name: string) => name);
+  const getModels = vi.fn(async () => ({
+    checkpoints: ['battle.safetensors'],
+    diffusionModels: ['h3.safetensors'],
+    textEncoders: ['qwen.safetensors'],
+    vaes: ['sdxl_vae.safetensors', 'h3vae.safetensors'],
+    samplers: [],
+    schedulers: [],
+  }));
+  const applyTarget = vi.fn();
+  const logger: any = {
+    info: vi.fn(),
+    debug: vi.fn(),
+    error: vi.fn(),
+    warn: vi.fn(),
+    child: () => logger,
+  };
+  const outputDir = mkdtempSync(path.join(os.tmpdir(), 'img-test-'));
+  const tools = new ImageGenerationTools({
+    foundryClient: { query } as any,
+    logger,
+    getClient: () => ({ runWorkflow, getModels, uploadImage }),
+    applyTarget,
+    outputDir,
+  });
+  return { tools, query, runWorkflow, getModels, uploadImage, applyTarget, outputDir };
+}
+
+describe('slugify', () => {
+  it('makes a safe short name', () => {
+    expect(slugify('A Dwarf, with an axe!')).toBe('a-dwarf-with-an-axe');
+    expect(slugify('???')).toBe('image');
+    expect(slugify('x'.repeat(100)).length).toBeLessThanOrEqual(40);
+  });
+});
+
+describe('definitions', () => {
+  it('offers generate-image and describe-image-generation', () => {
+    const defs = makeTools().tools.getToolDefinitions();
+    expect(defs.map(d => d.name)).toEqual(['generate-image', 'describe-image-generation']);
+    expect(defs[0]!.inputSchema.required).toEqual(['kind', 'prompt']);
+  });
+
+  it('tells Claude how to write H3 prompts and use references', () => {
+    const def = makeTools().tools.getToolDefinitions()[0]!;
+    expect(def.description).toContain('<Picture 1>');
+    expect(def.description).toContain('ONE detailed English paragraph');
+    expect(Object.keys(def.inputSchema.properties)).toContain('reference_images');
+  });
+});
+
+describe('generate-image (checkpoint)', () => {
+  it('uses the profile, points at the chosen ComfyUI and uploads the result', async () => {
+    const { tools, runWorkflow, query, applyTarget, outputDir } = makeTools();
+    const result = await tools.handleGenerateImage({ kind: 'map', prompt: 'a cave', seed: 7 });
+
+    expect(applyTarget).toHaveBeenCalledWith({ mode: 'custom', host: 'h', port: 1 });
+    const workflow = (runWorkflow.mock.calls[0] as any[])[0];
+    expect(workflow['1'].inputs.ckpt_name).toBe('battle.safetensors');
+    expect(workflow['2'].inputs.text).toBe(
+      '2d DnD battlemap of a cave, top-down view, overhead perspective, aerial'
+    );
+    expect(workflow['5'].inputs.seed).toBe(7);
+    expect(workflow['5'].inputs.steps).toBe(DEFAULT_PROFILES.map.steps);
+
+    const uploadCall = query.mock.calls.find(c => c[0] === 'foundry-mcp-bridge.upload-file')!;
+    const payload = uploadCall[1] as any;
+    expect(payload.folder).toBe('generated/map');
+    expect(payload.filename).toMatch(/^a-cave-[a-z0-9]+\.png$/);
+    expect(payload.imageData).toBe(PNG.toString('base64'));
+
+    expect(result).toMatchObject({
+      success: true,
+      uploaded: true,
+      path: 'worlds/w/uploads/generated/x.png',
+      kind: 'map',
+      workflow: 'checkpoint',
+      model: 'battle.safetensors',
+      references: 0,
+      seed: 7,
+    });
+    expect(existsSync(result.local_path)).toBe(true);
+    expect(result.local_path.startsWith(outputDir)).toBe(true);
+  });
+
+  it('keeps the image local when upload is false', async () => {
+    const { tools, query } = makeTools();
+    const result = await tools.handleGenerateImage({
+      kind: 'portrait',
+      prompt: 'a dwarf',
+      upload: false,
+    });
+    expect(result.uploaded).toBe(false);
+    expect(query.mock.calls.some(c => c[0] === 'foundry-mcp-bridge.upload-file')).toBe(false);
+  });
+
+  it('refuses reference pictures for a checkpoint profile', async () => {
+    const { tools, runWorkflow } = makeTools();
+    await expect(
+      tools.handleGenerateImage({ kind: 'map', prompt: 'x', reference_images: ['C:/a.png'] })
+    ).rejects.toThrow(/cannot take reference images/);
+    expect(runWorkflow).not.toHaveBeenCalled();
+  });
+
+  it('says so when the kind is not set up', async () => {
+    const { tools, runWorkflow } = makeTools();
+    await expect(tools.handleGenerateImage({ kind: 'token', prompt: 'an orc' })).rejects.toThrow(
+      /missing its diffusion model, text encoder or VAE/
+    );
+    expect(runWorkflow).not.toHaveBeenCalled();
+  });
+
+  it('passes ComfyUI failures on with context', async () => {
+    const { tools } = makeTools({ runError: new Error('ComfyUI rejected the job (HTTP 400)') });
+    await expect(tools.handleGenerateImage({ kind: 'map', prompt: 'x' })).rejects.toThrow(
+      'Image generation failed: ComfyUI rejected the job (HTTP 400)'
+    );
+  });
+
+  it('reports a failed upload without losing the image', async () => {
+    const { tools } = makeTools({ uploadResult: { success: false, error: 'disk full' } });
+    await expect(tools.handleGenerateImage({ kind: 'map', prompt: 'x' })).rejects.toThrow(
+      /was generated \(kept at .*\) but uploading to Foundry failed: disk full/
+    );
+  });
+
+  it('rejects unknown kinds and unknown arguments', async () => {
+    const { tools } = makeTools();
+    await expect(tools.handleGenerateImage({ kind: 'dragon', prompt: 'x' })).rejects.toThrow();
+    await expect(
+      tools.handleGenerateImage({ kind: 'map', prompt: 'x', extra: 1 })
+    ).rejects.toThrow();
+  });
+});
+
+describe('generate-image (MiniMax H3 and reference pictures)', () => {
+  it('generates with the H3 workflow and the prompt as written', async () => {
+    const { tools, runWorkflow, uploadImage } = makeTools();
+    const result = await tools.handleGenerateImage({
+      kind: 'portrait',
+      prompt: 'A dwarf smith at a forge.',
+      seed: 3,
+    });
+    const workflow = (runWorkflow.mock.calls[0] as any[])[0];
+    expect(workflow['1'].inputs.unet_name).toBe('h3.safetensors');
+    expect(workflow['5'].inputs.prompt).toBe('A dwarf smith at a forge.');
+    expect(workflow['5'].inputs.width).toBe(1664);
+    expect(workflow['7'].inputs).toMatchObject({ steps: 6, cfg: 1 });
+    expect(uploadImage).not.toHaveBeenCalled();
+    expect(result).toMatchObject({ workflow: 'minimax-h3', model: 'h3.safetensors' });
+  });
+
+  it('uploads reference pictures to ComfyUI and wires them in', async () => {
+    const { tools, runWorkflow, uploadImage, outputDir } = makeTools();
+    const ref = path.join(outputDir, 'ref.png');
+    writeFileSync(ref, PNG);
+
+    const result = await tools.handleGenerateImage({
+      kind: 'portrait',
+      prompt: 'The same dwarf from <Picture 1>, now in a tavern.',
+      reference_images: [ref],
+      seed: 1,
+    });
+
+    expect(uploadImage).toHaveBeenCalledTimes(1);
+    const [bytes, comfyName] = uploadImage.mock.calls[0] as [Buffer, string];
+    expect(bytes.equals(PNG)).toBe(true);
+    expect(comfyName).toMatch(/^claude-ref-[0-9a-f]{16}\.png$/);
+
+    const workflow = (runWorkflow.mock.calls[0] as any[])[0];
+    expect(workflow['20']).toEqual({ class_type: 'LoadImage', inputs: { image: comfyName } });
+    expect(workflow['5'].inputs['images.image_1']).toEqual(['20', 0]);
+    expect(result.references).toBe(1);
+  });
+
+  it('checks reference pictures before generating anything', async () => {
+    const { tools, runWorkflow, outputDir } = makeTools();
+    const notImage = path.join(outputDir, 'x.png');
+    writeFileSync(notImage, Buffer.from('hello'));
+
+    for (const [file, message] of [
+      ['relative.png', /must be absolute/],
+      [path.join(outputDir, 'missing.png'), /not found/],
+      [notImage, /not a PNG, JPEG, WebP or GIF/],
+    ] as const) {
+      await expect(
+        tools.handleGenerateImage({ kind: 'portrait', prompt: 'x', reference_images: [file] })
+      ).rejects.toThrow(message);
+    }
+    expect(runWorkflow).not.toHaveBeenCalled();
+  });
+});
+
+describe('describe-image-generation', () => {
+  it('lists profiles, what ComfyUI offers and what is missing', async () => {
+    const { tools } = makeTools();
+    const result = await tools.handleDescribe();
+    expect(result.reachable).toBe(true);
+    expect(result.available.diffusion_models).toContain('h3.safetensors');
+    expect(result.profiles.portrait.workflow).toBe('minimax-h3');
+    expect(result.problems).toContain('token: no diffusion model chosen');
+    expect(result.problems.some((p: string) => p.startsWith('map:'))).toBe(false);
+    expect(result.problems.some((p: string) => p.startsWith('portrait:'))).toBe(false);
+  });
+
+  it('notices a model file that this ComfyUI does not have', async () => {
+    const { tools } = makeTools({
+      profiles: {
+        portrait: {
+          workflow: 'minimax-h3',
+          diffusionModel: 'gone.safetensors',
+          textEncoder: 'qwen.safetensors',
+          vae: 'h3vae.safetensors',
+        },
+      },
+    });
+    const result = await tools.handleDescribe();
+    expect(result.problems).toContain(
+      'portrait: diffusion model "gone.safetensors" is not in this ComfyUI'
+    );
+  });
+});
diff --git a/packages/mcp-server/src/tools/image-generation.ts b/packages/mcp-server/src/tools/image-generation.ts
new file mode 100644
index 0000000..7aee1e5
--- /dev/null
+++ b/packages/mcp-server/src/tools/image-generation.ts
@@ -0,0 +1,353 @@
+import { createHash } from 'crypto';
+import { promises as fs } from 'fs';
+import os from 'os';
+import path from 'path';
+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+import type { ComfyModels } from '../comfyui-models.js';
+import { detectImageType, UPLOAD_MAX_BYTES } from './upload.js';
+import {
+  buildWorkflow,
+  IMAGE_KINDS,
+  MAX_REFERENCE_IMAGES,
+  normalizeProfiles,
+  resolveGeneration,
+  type ImageKind,
+  type ImageProfiles,
+} from '../image-profiles.js';
+
+/** The parts of the ComfyUI client this tool needs (so tests can stand in for it). */
+export interface ImageComfyClient {
+  runWorkflow(
+    workflow: Record<string, any>,
+    options?: { timeoutMs?: number }
+  ): Promise<{ image: Buffer; filename: string; promptId: string }>;
+  getModels(): Promise<ComfyModels>;
+  uploadImage(image: Buffer, filename: string): Promise<string>;
+}
+
+export interface ImageGenerationToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+  /** The ComfyUI client, already pointed at the chosen ComfyUI by applyTarget. */
+  getClient: () => ImageComfyClient;
+  /** Point the client at the ComfyUI the module's settings choose. */
+  applyTarget: (rawTarget: unknown) => void;
+  /** Where to keep the local copies (default: a folder in the system temp directory). */
+  outputDir?: string;
+}
+
+const UPLOAD_TIMEOUT_MS = 120000;
+const KEEP_LOCAL_COPIES = 200;
+
+const generateSchema = z
+  .object({
+    kind: z.enum(IMAGE_KINDS),
+    prompt: z.string().min(1).max(2000),
+    name: z.string().max(80).optional(),
+    negative_prompt: z.string().max(1000).optional(),
+    width: z.number().int().min(64).max(4096).optional(),
+    height: z.number().int().min(64).max(4096).optional(),
+    steps: z.number().int().min(1).max(150).optional(),
+    seed: z.number().int().min(0).optional(),
+    reference_images: z.array(z.string().min(1)).max(MAX_REFERENCE_IMAGES).optional(),
+    upload: z.boolean().optional(),
+    folder: z.string().max(80).optional(),
+  })
+  .strict();
+
+/** A file-name-safe version of a text: lower case letters, digits and dashes. */
+export function slugify(text: string, maxLength = 40): string {
+  const slug = text
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+    .slice(0, maxLength)
+    .replace(/-+$/g, '');
+  return slug || 'image';
+}
+
+export class ImageGenerationTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+  private getClient: () => ImageComfyClient;
+  private applyTarget: (raw: unknown) => void;
+  private outputDir: string;
+
+  constructor(options: ImageGenerationToolsOptions) {
+    this.foundryClient = options.foundryClient;
+    this.logger = options.logger.child({ component: 'ImageGenerationTools' });
+    this.getClient = options.getClient;
+    this.applyTarget = options.applyTarget;
+    this.outputDir = options.outputDir ?? path.join(os.tmpdir(), 'foundry-mcp-images');
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'generate-image',
+        description:
+          'Generate a picture with the GM\'s ComfyUI and (by default) upload it to the Foundry world. "kind" picks the profile the GM configured in the module settings (checkpoint, steps, size and prompt wording): map = top-down battlemap, portrait = character portrait, token = round token art, handout = illustration for players. The profile wraps your prompt, so describe only the subject. Returns the Foundry path (use it in manage-scenes, actors or journals) and a local file path you can open to look at the result. Takes about 1-3 minutes with MiniMax H3 (10-90 seconds for a checkpoint). A kind that is not set up fails with a message saying so; describe-image-generation shows what is set up. MINIMAX H3 PROMPTS: there is no prompt expander, so write the prompt yourself as ONE detailed English paragraph (80-200 words): the subject and its exact visible features (face, hair, scar, clothes, props, colours), pose and expression, setting, camera/framing, lighting, medium or art style. Put any required text in quotes. Do not use keyword lists or negative wording; describe what should be there. REFERENCE IMAGES (MiniMax H3 only): pass absolute file paths in reference_images (for example the local_path of an earlier result) and refer to them in the prompt as <Picture 1>, <Picture 2>, ...; to keep a character consistent, say which features to keep ("the exact same woman from <Picture 1>: same face, scar, copper braids, green eyes, apron and pendant") and then describe the new scene. Repeat the features that matter in words, because the picture alone carries them only loosely.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            kind: {
+              type: 'string',
+              enum: [...IMAGE_KINDS],
+              description: 'Which profile to use',
+            },
+            prompt: {
+              type: 'string',
+              description: 'What to draw. The profile adds its own style wording around it.',
+            },
+            name: {
+              type: 'string',
+              description: 'Short name used for the file (default: taken from the prompt)',
+            },
+            negative_prompt: {
+              type: 'string',
+              description: 'Extra things to avoid, added to the profile\'s negative prompt',
+            },
+            width: { type: 'number', description: 'Override the profile width (pixels, 256-2048)' },
+            height: { type: 'number', description: 'Override the profile height (pixels, 256-2048)' },
+            steps: { type: 'number', description: 'Override the profile step count' },
+            seed: {
+              type: 'number',
+              description: 'Use a fixed seed to repeat or tweak a result (default: random)',
+            },
+            reference_images: {
+              type: 'array',
+              items: { type: 'string' },
+              description:
+                'Absolute paths of up to 16 reference pictures on this computer (png, jpg, webp), named <Picture 1>, <Picture 2>... in the prompt. MiniMax H3 profiles only. Use the local_path returned by an earlier generate-image call to keep a character consistent.',
+            },
+            upload: {
+              type: 'boolean',
+              description:
+                'Upload to the Foundry world (default true). False keeps it local only, to look at first.',
+            },
+            folder: {
+              type: 'string',
+              description:
+                'Sub-folder in the world upload folder (default "generated/<kind>"); letters, digits, dash, underscore, up to 3 levels',
+            },
+          },
+          required: ['kind', 'prompt'],
+        },
+      },
+      {
+        name: 'describe-image-generation',
+        description:
+          'Show how image generation is set up: which ComfyUI is used, the profile for each kind (map, portrait, token, handout), the checkpoints/VAEs that ComfyUI offers, and any profile whose checkpoint is missing. Read-only.',
+        inputSchema: { type: 'object', properties: {} },
+      },
+    ];
+  }
+
+  private async readSettings(): Promise<{ target: unknown; profiles: ImageProfiles }> {
+    const result = await this.foundryClient.query('foundry-mcp-bridge.get-image-settings', {});
+    if (result?.success === false || result?.error) {
+      throw new Error(result.error || 'Could not read the image generation settings');
+    }
+    return { target: result?.target, profiles: normalizeProfiles(result?.profiles) };
+  }
+
+  async handleGenerateImage(args: unknown): Promise<any> {
+    const parsed = generateSchema.parse(args);
+    const kind: ImageKind = parsed.kind;
+
+    const settings = await this.readSettings();
+    this.applyTarget(settings.target);
+
+    const profile = settings.profiles[kind];
+    const references = parsed.reference_images ?? [];
+    if (references.length > 0 && profile.workflow !== 'minimax-h3') {
+      throw new Error(
+        `The "${kind}" profile uses a checkpoint workflow, which cannot take reference images. Only MiniMax H3 profiles can.`
+      );
+    }
+
+    // Check the pictures before spending time on generation.
+    const loaded = await Promise.all(references.map(file => this.loadReference(file)));
+
+    const client = this.getClient();
+    const uploadedNames: string[] = [];
+    for (const picture of loaded) {
+      uploadedNames.push(await client.uploadImage(picture.bytes, picture.comfyName));
+    }
+
+    const generation = resolveGeneration(kind, profile, {
+      prompt: parsed.prompt,
+      negativePrompt: parsed.negative_prompt,
+      width: parsed.width,
+      height: parsed.height,
+      steps: parsed.steps,
+      seed: parsed.seed,
+      referenceImages: uploadedNames,
+    });
+
+    const baseName = `${slugify(parsed.name ?? parsed.prompt)}-${Date.now().toString(36)}`;
+    const workflow = buildWorkflow(generation, `claude-${kind}`);
+
+    this.logger.info('Generating image', {
+      kind,
+      workflow: generation.workflow,
+      model: generation.workflow === 'minimax-h3' ? generation.diffusionModel : generation.checkpoint,
+      references: references.length,
+      steps: generation.steps,
+      size: `${generation.width}x${generation.height}`,
+    });
+
+    const started = Date.now();
+    let result;
+    try {
+      result = await client.runWorkflow(workflow, { timeoutMs: 15 * 60 * 1000 });
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      throw new Error(`Image generation failed: ${message}`);
+    }
+    const seconds = Math.round((Date.now() - started) / 1000);
+
+    const localPath = await this.saveLocalCopy(`${baseName}.png`, result.image);
+
+    const summary = {
+      kind,
+      workflow: generation.workflow,
+      model: generation.workflow === 'minimax-h3' ? generation.diffusionModel : generation.checkpoint,
+      references: references.length,
+      steps: generation.steps,
+      size: `${generation.width}x${generation.height}`,
+      seed: generation.seed,
+      seconds,
+      local_path: localPath,
+    };
+
+    if (parsed.upload === false) {
+      return { success: true, ...summary, uploaded: false };
+    }
+
+    const folder = parsed.folder?.trim() || `generated/${kind}`;
+    try {
+      const uploaded = await this.foundryClient.query(
+        'foundry-mcp-bridge.upload-file',
+        {
+          filename: `${baseName}.png`,
+          imageData: result.image.toString('base64'),
+          folder,
+        },
+        UPLOAD_TIMEOUT_MS
+      );
+      if (uploaded?.success === false) {
+        throw new Error(uploaded.error || 'Upload was refused');
+      }
+      return { success: true, ...summary, uploaded: true, path: uploaded?.path };
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      // The picture exists; say so, so it is not generated twice.
+      throw new Error(
+        `The image was generated (kept at ${localPath}, seed ${generation.seed}) but uploading to Foundry failed: ${message}`
+      );
+    }
+  }
+
+  async handleDescribe(): Promise<any> {
+    const settings = await this.readSettings();
+    this.applyTarget(settings.target);
+
+    let models: ComfyModels | undefined;
+    let comfyError: string | undefined;
+    try {
+      models = await this.getClient().getModels();
+    } catch (error) {
+      comfyError = error instanceof Error ? error.message : String(error);
+    }
+
+    const problems: string[] = [];
+    for (const kind of IMAGE_KINDS) {
+      const profile = settings.profiles[kind];
+      const check = (label: string, value: string, available: string[] | undefined) => {
+        if (!value) {
+          problems.push(`${kind}: no ${label} chosen`);
+        } else if (available && !available.includes(value)) {
+          problems.push(`${kind}: ${label} "${value}" is not in this ComfyUI`);
+        }
+      };
+      if (profile.workflow === 'minimax-h3') {
+        check('diffusion model', profile.diffusionModel, models?.diffusionModels);
+        check('text encoder', profile.textEncoder, models?.textEncoders);
+        check('VAE', profile.vae, models?.vaes);
+      } else {
+        check('checkpoint', profile.checkpoint, models?.checkpoints);
+        if (profile.vae && models && !models.vaes.includes(profile.vae)) {
+          problems.push(`${kind}: VAE "${profile.vae}" is not in this ComfyUI`);
+        }
+      }
+    }
+
+    return {
+      success: true,
+      comfyui: settings.target,
+      reachable: !comfyError,
+      ...(comfyError ? { comfyui_error: comfyError } : {}),
+      profiles: settings.profiles,
+      available: models
+        ? {
+            checkpoints: models.checkpoints,
+            diffusion_models: models.diffusionModels,
+            text_encoders: models.textEncoders,
+            vaes: models.vaes,
+          }
+        : undefined,
+      problems,
+    };
+  }
+
+  /** Read and check one reference picture; its ComfyUI name comes from its content. */
+  private async loadReference(file: string): Promise<{ bytes: Buffer; comfyName: string }> {
+    if (!path.isAbsolute(file)) {
+      throw new Error(`Reference image paths must be absolute: ${file}`);
+    }
+    let bytes: Buffer;
+    try {
+      bytes = await fs.readFile(file);
+    } catch {
+      throw new Error(`Reference image not found: ${file}`);
+    }
+    if (bytes.length === 0 || bytes.length > UPLOAD_MAX_BYTES) {
+      throw new Error(`Reference image has an unusable size (${bytes.length} bytes): ${file}`);
+    }
+    const type = detectImageType(bytes);
+    if (!type) {
+      throw new Error(`Reference image is not a PNG, JPEG, WebP or GIF picture: ${file}`);
+    }
+    const hash = createHash('sha1').update(bytes).digest('hex').slice(0, 16);
+    return { bytes, comfyName: `claude-ref-${hash}.${type}` };
+  }
+
+  private async saveLocalCopy(filename: string, image: Buffer): Promise<string> {
+    await fs.mkdir(this.outputDir, { recursive: true });
+    const filePath = path.join(this.outputDir, filename);
+    await fs.writeFile(filePath, image);
+
+    // Keep the folder from growing without end.
+    try {
+      const names = await fs.readdir(this.outputDir);
+      if (names.length > KEEP_LOCAL_COPIES) {
+        const stats = await Promise.all(
+          names.map(async name => ({
+            name,
+            time: (await fs.stat(path.join(this.outputDir, name))).mtimeMs,
+          }))
+        );
+        stats.sort((a, b) => a.time - b.time);
+        for (const old of stats.slice(0, names.length - KEEP_LOCAL_COPIES)) {
+          await fs.unlink(path.join(this.outputDir, old.name)).catch(() => undefined);
+        }
+      }
+    } catch {
+      // Cleaning up is optional.
+    }
+    return filePath;
+  }
+}

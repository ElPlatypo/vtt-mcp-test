--- /dev/null
+++ b/packages/foundry-module/src/grid-measure-utils.ts
@@ -0,0 +1,285 @@
+/**
+ * Finding the grid that is drawn into a map picture: how many pixels one square is, and where
+ * the lines start. Works on the strength of vertical and horizontal edges, which line up every
+ * `size` pixels when the picture has a grid and do not when it has none.
+ */
+
+export interface AxisCandidate {
+  size: number;
+  score: number;
+}
+
+export interface AxisMeasure {
+  /** The strongest repeat distances, best first (for when the best one is wrong). */
+  candidates: AxisCandidate[];
+  /** Pixels per square, or null when no regular spacing was found. */
+  size: number | null;
+  /** Pixels from the picture's edge to the first line, 0 up to size - 1. */
+  offset: number;
+  /** 0 to 1: how well the edges repeat at that spacing. */
+  confidence: number;
+  /** How much stronger the best line position is than the typical one (0 = flat, texture). */
+  contrast: number;
+}
+
+
+/**
+ * How line-like each column and each row is: the sum of |2g(x) - g(x-2) - g(x+2)| over the
+ * picture. A thin grid line (dark or light) scores high all along its length, while soft edges
+ * and large shapes score low.
+ */
+export function edgeProfiles(
+  gray: ArrayLike<number>,
+  width: number,
+  height: number
+): { columns: Float64Array; rows: Float64Array } {
+  const columns = new Float64Array(width);
+  const rows = new Float64Array(height);
+  for (let y = 0; y < height; y++) {
+    const row = y * width;
+    for (let x = 2; x < width - 2; x++) {
+      columns[x] += Math.abs(2 * gray[row + x]! - gray[row + x - 2]! - gray[row + x + 2]!);
+    }
+    if (y >= 2 && y < height - 2) {
+      const above = (y - 2) * width;
+      const below = (y + 2) * width;
+      let sum = 0;
+      for (let x = 0; x < width; x++) {
+        sum += Math.abs(2 * gray[row + x]! - gray[above + x]! - gray[below + x]!);
+      }
+      rows[y] = sum;
+    }
+  }
+  return { columns, rows };
+}
+
+const HIGH_PASS_RADIUS = 8;
+
+/** The profile minus its moving average over +-radius positions. */
+export function highPass(profile: Float64Array, radius: number): Float64Array {
+  const n = profile.length;
+  const prefix = new Float64Array(n + 1);
+  for (let i = 0; i < n; i++) prefix[i + 1] = prefix[i]! + profile[i]!;
+  const out = new Float64Array(n);
+  for (let i = 0; i < n; i++) {
+    const a = Math.max(0, i - radius);
+    const b = Math.min(n, i + radius + 1);
+    out[i] = profile[i]! - (prefix[b]! - prefix[a]!) / (b - a);
+  }
+  return out;
+}
+
+/** Normalised correlation of a profile with itself shifted by `lag`. */
+function correlation(p: Float64Array, lag: number): number {
+  let sum = 0;
+  let a = 0;
+  let b = 0;
+  const end = p.length - lag;
+  for (let i = 0; i < end; i++) {
+    const u = p[i]!;
+    const v = p[i + lag]!;
+    sum += u * v;
+    a += u * u;
+    b += v * v;
+  }
+  const denominator = Math.sqrt(a * b);
+  return denominator > 0 ? sum / denominator : 0;
+}
+
+/** Find the repeat distance of a line-strength profile, with the offset of its first line. */
+export function measureAxis(
+  profile: Float64Array,
+  minSize = 20,
+  maxSize = 400
+): AxisMeasure {
+  const length = profile.length;
+  const top = Math.min(maxSize, Math.floor(length / 3));
+  if (top <= minSize) return { size: null, offset: 0, confidence: 0, contrast: 0, candidates: [] };
+
+  // High-pass: take out the slow swing of the profile (large shapes, light and dark areas), which
+  // otherwise correlates with itself at every distance and makes texture look like a grid.
+  const centred = highPass(profile, HIGH_PASS_RADIUS);
+
+  const scores: number[] = new Array(top + 2).fill(0);
+  let best = 0;
+  for (let lag = minSize; lag <= top; lag++) {
+    scores[lag] = correlation(centred, lag);
+    if (scores[lag]! > best) best = scores[lag]!;
+  }
+  if (best <= 0) return { size: null, offset: 0, confidence: 0, contrast: 0, candidates: [] };
+
+  const candidates: AxisCandidate[] = [];
+  for (let lag = minSize + 1; lag < top; lag++) {
+    const s = scores[lag]!;
+    if (s > 0 && s >= scores[lag - 1]! && s >= scores[lag + 1]!) {
+      candidates.push({ size: lag, score: Math.round(s * 1000) / 1000 });
+    }
+  }
+  candidates.sort((a, b) => b.score - a.score);
+  candidates.splice(6);
+
+  // Take the smallest spacing that is a local peak almost as strong as the best one, so a grid
+  // is not reported as two or three squares.
+  let chosen = 0;
+  for (let lag = minSize + 1; lag < top; lag++) {
+    const s = scores[lag]!;
+    if (s >= best * 0.85 && s >= scores[lag - 1]! && s >= scores[lag + 1]!) {
+      chosen = lag;
+      break;
+    }
+  }
+  if (chosen === 0) return { size: null, offset: 0, confidence: best, contrast: 0, candidates };
+
+  // The true spacing may fall between two whole pixels; settle on the strongest neighbour.
+  let size = chosen;
+  for (const candidate of [chosen - 1, chosen + 1]) {
+    if (candidate >= minSize && candidate <= top && scores[candidate]! > scores[size]!) {
+      size = candidate;
+    }
+  }
+
+  // Offset: the position within one square where the edges add up the most.
+  const phase = new Float64Array(size);
+  for (let i = 0; i < length; i++) phase[i % size] += profile[i]!;
+  let offset = 0;
+  let strongest = -Infinity;
+  for (let p = 0; p < size; p++) {
+    const smooth = phase[p]! + phase[(p + 1) % size]! + phase[(p + size - 1) % size]!;
+    if (smooth > strongest) {
+      strongest = smooth;
+      offset = p;
+    }
+  }
+
+  // Contrast: lines pile up at one position within a square, texture spreads evenly.
+  let phaseMean = 0;
+  for (let p = 0; p < size; p++) phaseMean += phase[p]!;
+  phaseMean /= size;
+  const contrast = phaseMean > 0 ? strongest / 3 / phaseMean - 1 : 0;
+
+  return { size, offset, confidence: scores[size]!, contrast, candidates };
+}
+
+/** Grid sizes that divide both sides evenly, with a sensible number of squares. */
+export function divisorSizes(
+  width: number,
+  height: number,
+  min = 40,
+  max = 200
+): Array<{ size: number; columns: number; rows: number }> {
+  const result: Array<{ size: number; columns: number; rows: number }> = [];
+  for (let size = min; size <= max; size++) {
+    if (width % size === 0 && height % size === 0) {
+      result.push({ size, columns: width / size, rows: height / size });
+    }
+  }
+  return result;
+}
+
+export interface Region {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+}
+
+export interface GridMeasure {
+  /** True when the picture (or region) shows a regular grid both directions agree on. */
+  detected: boolean;
+  /** Pixels per square when detected. */
+  size: number | null;
+  /** Pixels from the picture's left / top edge to the first line (whole picture coordinates). */
+  offsetX: number;
+  offsetY: number;
+  /** How well the lines repeat at that spacing, 0 to 1. */
+  confidence: number;
+  /** What each direction found on its own; one can be weak when the region is narrow. */
+  x: AxisMeasure;
+  y: AxisMeasure;
+  region: Region;
+  /** Grid sizes that divide the picture into whole squares, as a fallback for gridless maps. */
+  divisors: Array<{ size: number; columns: number; rows: number }>;
+}
+
+export const MIN_CONFIDENCE = 0.3;
+/**
+ * Drawn lines stand out clearly at one position in each square (contrast above 1 in practice).
+ * Texture, foliage and the faint repeat that image generators leave behind stay below 0.2.
+ */
+export const MIN_CONTRAST = 0.5;
+
+/** Cut a rectangle out of a grey-scale picture. */
+export function crop(
+  gray: ArrayLike<number>,
+  width: number,
+  region: Region
+): Uint8Array {
+  const out = new Uint8Array(region.width * region.height);
+  for (let y = 0; y < region.height; y++) {
+    const from = (region.y + y) * width + region.x;
+    for (let x = 0; x < region.width; x++) out[y * region.width + x] = gray[from + x]!;
+  }
+  return out;
+}
+
+/** The region clipped to the picture, or the whole picture when none is given. */
+export function clipRegion(width: number, height: number, region?: Region): Region {
+  if (!region) return { x: 0, y: 0, width, height };
+  const x = Math.max(0, Math.min(width - 1, Math.round(region.x)));
+  const y = Math.max(0, Math.min(height - 1, Math.round(region.y)));
+  return {
+    x,
+    y,
+    width: Math.max(1, Math.min(width - x, Math.round(region.width))),
+    height: Math.max(1, Math.min(height - y, Math.round(region.height))),
+  };
+}
+
+/**
+ * Measure the grid in a grey-scale picture, or in one region of it. Faint grids drawn only on
+ * the floors are best measured by pointing at a floor area with a region.
+ */
+export function measureGrid(
+  gray: ArrayLike<number>,
+  width: number,
+  height: number,
+  options: { region?: Region; minSize?: number; maxSize?: number } = {}
+): GridMeasure {
+  const region = clipRegion(width, height, options.region);
+  const part =
+    region.width === width && region.height === height
+      ? gray
+      : crop(gray, width, region);
+  const { columns, rows } = edgeProfiles(part, region.width, region.height);
+  const x = measureAxis(columns, options.minSize, options.maxSize);
+  const y = measureAxis(rows, options.minSize, options.maxSize);
+
+  const xGood = x.size !== null && x.confidence >= MIN_CONFIDENCE && x.contrast >= MIN_CONTRAST;
+  const yGood = y.size !== null && y.confidence >= MIN_CONFIDENCE && y.contrast >= MIN_CONTRAST;
+  // Both directions must agree. A narrow region the caller picked has too little to say in
+  // one direction, and then the other may stand alone.
+  const bothAgree = xGood && yGood && Math.abs(x.size! - y.size!) <= 1;
+  const oneStrong =
+    options.region !== undefined && (xGood !== yGood);
+  const detected = bothAgree || oneStrong;
+
+  const size = detected
+    ? bothAgree
+      ? Math.round((x.size! + y.size!) / 2)
+      : (xGood ? x.size! : y.size!)
+    : null;
+
+  // Offsets in whole-picture pixels: the first line at or after the picture's edge.
+  const wrap = (offset: number, origin: number, s: number) => (((offset + origin) % s) + s) % s;
+  return {
+    detected,
+    size,
+    offsetX: detected && size ? wrap(x.offset, region.x, size) : 0,
+    offsetY: detected && size ? wrap(y.offset, region.y, size) : 0,
+    confidence: detected ? Math.max(xGood ? x.confidence : 0, yGood ? y.confidence : 0) : Math.max(x.confidence, y.confidence),
+    x,
+    y,
+    region,
+    divisors: divisorSizes(width, height),
+  };
+}
diff --git a/packages/foundry-module/src/image-profiles-utils.test.ts b/packages/foundry-module/src/image-profiles-utils.test.ts
new file mode 100644
index 0000000..d1e0d72
--- /dev/null
+++ b/packages/foundry-module/src/image-profiles-utils.test.ts
@@ -0,0 +1,100 @@
+import { describe, expect, it } from 'vitest';
+import {
+  DEFAULT_PROFILES,
+  IMAGE_KINDS,
+  profilesFromSetting,
+  readProfilesForm,
+  selectChoices,
+} from './image-profiles-utils.js';
+
+/** A form with every field filled in from the defaults. */
+function formFrom(profiles = DEFAULT_PROFILES): Record<string, unknown> {
+  const data: Record<string, unknown> = {};
+  for (const kind of IMAGE_KINDS) {
+    for (const [field, value] of Object.entries(profiles[kind])) {
+      data[`${kind}__${field}`] = String(value);
+    }
+  }
+  return data;
+}
+
+describe('profilesFromSetting', () => {
+  it('gives the defaults for an empty or broken setting', () => {
+    expect(profilesFromSetting('{}')).toEqual(DEFAULT_PROFILES);
+    expect(profilesFromSetting('nope')).toEqual(DEFAULT_PROFILES);
+    expect(profilesFromSetting(undefined)).toEqual(DEFAULT_PROFILES);
+  });
+
+  it('keeps saved values and defaults the rest', () => {
+    const p = profilesFromSetting(
+      JSON.stringify({ portrait: { workflow: 'checkpoint', checkpoint: 'a.safetensors' } })
+    );
+    expect(p.portrait.workflow).toBe('checkpoint');
+    expect(p.portrait.checkpoint).toBe('a.safetensors');
+    expect(p.portrait.steps).toBe(DEFAULT_PROFILES.portrait.steps);
+    expect(p.map).toEqual(DEFAULT_PROFILES.map);
+  });
+
+  it('defaults maps to a checkpoint and the rest to MiniMax H3', () => {
+    expect(DEFAULT_PROFILES.map.workflow).toBe('checkpoint');
+    expect(DEFAULT_PROFILES.portrait.workflow).toBe('minimax-h3');
+    expect(DEFAULT_PROFILES.token.steps).toBe(6);
+  });
+
+  it('treats profiles saved before workflows existed as old checkpoint settings', () => {
+    const p = profilesFromSetting({
+      map: { checkpoint: 'mine.safetensors', steps: 40 },
+      portrait: { checkpoint: '', steps: 25, cfg: 6 },
+    });
+    expect(p.map.workflow).toBe('checkpoint');
+    expect(p.map.checkpoint).toBe('mine.safetensors');
+    expect(p.map.steps).toBe(40);
+    expect(p.portrait).toEqual(DEFAULT_PROFILES.portrait);
+  });
+});
+
+describe('readProfilesForm', () => {
+  it('reads a complete form back into the same profiles', () => {
+    const result = readProfilesForm(formFrom());
+    expect(result).toEqual({ ok: true, value: DEFAULT_PROFILES });
+  });
+
+  it('uses what was typed', () => {
+    const data = {
+      ...formFrom(),
+      portrait__diffusionModel: ' other.safetensors ',
+      portrait__steps: '31',
+    };
+    const result = readProfilesForm(data);
+    if (!result.ok) throw new Error(result.error);
+    expect(result.value.portrait.diffusionModel).toBe('other.safetensors');
+    expect(result.value.portrait.steps).toBe(31);
+  });
+
+  it('names the field that is wrong', () => {
+    const bad = (field: string, value: string) => {
+      const result = readProfilesForm({ ...formFrom(), [field]: value });
+      return result.ok ? 'ok' : result.error;
+    };
+    expect(bad('map__workflow', 'magic')).toContain('Maps: choose a workflow');
+    expect(bad('map__steps', '0')).toContain('Maps: steps');
+    expect(bad('map__steps', '2.5')).toContain('whole number');
+    expect(bad('token__cfg', 'abc')).toContain('Tokens: CFG');
+    expect(bad('handout__width', '100')).toContain('Handouts and illustrations: width');
+    expect(bad('portrait__height', '')).toContain('Character portraits: height');
+    expect(bad('map__sampler', 'bad name')).toContain('choose a sampler');
+    expect(bad('map__scheduler', '')).toContain('choose a scheduler');
+    expect(bad('map__promptPrefix', 'x'.repeat(1001))).toContain('promptPrefix');
+  });
+});
+
+describe('selectChoices', () => {
+  it('keeps the current value even when ComfyUI does not list it', () => {
+    expect(selectChoices(['a', 'b'], 'old', false)).toEqual(['old', 'a', 'b']);
+    expect(selectChoices(['a', 'b'], 'a', false)).toEqual(['a', 'b']);
+  });
+
+  it('can offer an empty choice', () => {
+    expect(selectChoices(['a'], '', true)).toEqual(['', 'a']);
+  });
+});
diff --git a/packages/foundry-module/src/image-profiles-utils.ts b/packages/foundry-module/src/image-profiles-utils.ts

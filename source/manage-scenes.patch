+ */
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+
+function makeActor() {
+  const items = [
+    { id: 'i1', name: 'Scimitar', type: 'weapon' },
+    { id: 'i2', name: 'Shortbow', type: 'weapon' },
+  ];
+  const actor: any = {
+    id: 'a1',
+    name: 'Sildar Hallwinter',
+    type: 'npc',
+    documentName: 'Actor',
+    uuid: 'Actor.a1',
+    folder: { name: 'Allies' },
+    constructor: { metadata: { embedded: { Item: 'items', ActiveEffect: 'effects' } } },
+    getEmbeddedCollection: (type: string) => ({
+      contents: type === 'Item' ? items.map(makeItem) : [],
+    }),
+    toObject: () => ({
+      name: 'Sildar Hallwinter',
+      system: { attributes: { hp: { value: 27, max: 27 } }, details: { cr: 2 } },
+      items: items.map(i => ({ ...i })),
+      effects: [],
+    }),
+    update: vi.fn(),
+    delete: vi.fn(),
+  };
+  return actor;
+}
+
+function makeItem(data: any): any {
+  return {
+    ...data,
+    documentName: 'Item',
+    uuid: `Actor.a1.Item.${data.id}`,
+    constructor: { metadata: { embedded: {} } },
+    toObject: () => ({ ...data, system: { damage: '1d6' } }),
+  };
+}
+
+function setup(options: { actors?: any[] } = {}) {
+  const actor = makeActor();
+  const actors = options.actors ?? [actor];
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'GM' },
+    collections: new Map([['Actor', { contents: actors }]]),
+    settings: { get: () => true },
+  });
+  vi.stubGlobal('CONFIG', {
+    Wall: {
+      documentClass: {
+        schema: { fields: { c: new (class ArrayField {})(), door: new (class NumberField {})() } },
+        metadata: { embedded: {} },
+      },
+    },
+    Scene: {
+      documentClass: {
+        schema: { fields: { name: new (class StringField {})() } },
+        metadata: { embedded: { Token: 'tokens', Wall: 'walls' } },
+      },
+    },
+  });
+  vi.stubGlobal(
+    'fromUuid',
+    vi.fn(async (uuid: string) => (uuid === 'Actor.a1' ? actor : null))
+  );
+  return { dataAccess: new FoundryDataAccess(), actor };
+}
+
+describe('FoundryDataAccess.inspectDocument', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  describe('list', () => {
+    it('lists documents of a type with a search filter', async () => {
+      const { dataAccess } = setup();
+      const all = await dataAccess.inspectDocument({ action: 'list', type: 'Actor' });
+      expect(all).toMatchObject({
+        total: 1,
+        items: [{ id: 'a1', name: 'Sildar Hallwinter', subtype: 'npc', folder: 'Allies' }],
+      });
+
+      const none = await dataAccess.inspectDocument({
+        action: 'list',
+        type: 'Actor',
+        search: 'zzz',
+      });
+      expect(none.items).toEqual([]);
+      const some = await dataAccess.inspectDocument({
+        action: 'list',
+        type: 'Actor',
+        search: 'SILDAR',
+      });
+      expect(some.total).toBe(1);
+    });
+
+    it('limits the number shown', async () => {
+      const many = Array.from({ length: 5 }, (_, i) => ({ id: `x${i}`, name: `N${i}` }));
+      const { dataAccess } = setup({ actors: many });
+      const result = await dataAccess.inspectDocument({ action: 'list', type: 'Actor', limit: 2 });
+      expect(result).toMatchObject({ total: 5, shown: 2 });
+      expect(result.items).toHaveLength(2);
+    });
+
+    it('refuses types outside the allowed list', async () => {
+      const { dataAccess } = setup();
+      await expect(dataAccess.inspectDocument({ action: 'list', type: 'User' })).rejects.toThrow(
+        'type must be one of'
+      );
+      await expect(dataAccess.inspectDocument({ action: 'list', type: 'Setting' })).rejects.toThrow(
+        'type must be one of'
+      );
+    });
+  });
+
+  describe('get', () => {
+    it('reads a document by name, summarising embedded collections as counts', async () => {
+      const { dataAccess } = setup();
+      const result = await dataAccess.inspectDocument({
+        action: 'get',
+        type: 'Actor',
+        identifier: 'sildar hallwinter',
+      });
+
+      expect(result.document).toMatchObject({
+        documentName: 'Actor',
+        id: 'a1',
+        embeddedTypes: ['Item', 'ActiveEffect'],
+      });
+      const data = JSON.parse(result.data);
+      expect(data.system.attributes.hp).toEqual({ value: 27, max: 27 });
+      expect(data.items).toContain('2 items');
+      expect(result.truncated).toBe(false);
+    });
+
+    it('includes embedded documents when asked', async () => {
+      const { dataAccess } = setup();
+      const result = await dataAccess.inspectDocument({
+        action: 'get',
+        type: 'Actor',
+        identifier: 'a1',
+        include_embedded: true,
+      });
+      expect(JSON.parse(result.data).items).toHaveLength(2);
+    });
+
+    it('reads a part by path, and by uuid', async () => {
+      const { dataAccess } = setup();
+      const byPath = await dataAccess.inspectDocument({
+        action: 'get',
+        type: 'Actor',
+        identifier: 'a1',
+        path: 'system.attributes.hp.max',
+      });
+      expect(JSON.parse(byPath.data)).toBe(27);
+      expect(byPath.path).toBe('system.attributes.hp.max');
+
+      const byUuid = await dataAccess.inspectDocument({ action: 'get', uuid: 'Actor.a1' });
+      expect(byUuid.document.id).toBe('a1');
+      await expect(
+        dataAccess.inspectDocument({ action: 'get', uuid: 'Actor.zzz' })
+      ).rejects.toThrow('No document found');
+    });
+
+    it('limits depth and size and says when output was cut', async () => {
+      const { dataAccess } = setup();
+      const shallow = await dataAccess.inspectDocument({
+        action: 'get',
+        type: 'Actor',
+        identifier: 'a1',
+        depth: 1,
+      });
+      expect(JSON.parse(shallow.data).system).toBe('{object with 2 keys}');
+
+      const cut = await dataAccess.inspectDocument({
+        action: 'get',
+        type: 'Actor',
+        identifier: 'a1',
+        max_chars: 500,
+        include_embedded: true,
+        depth: 12,
+      });
+      expect(cut.data.length).toBeLessThanOrEqual(500);
+      if (cut.truncated) expect(cut.note).toContain('max_chars');
+    });
+
+    it('lists and reads embedded documents', async () => {
+      const { dataAccess } = setup();
+      const list = await dataAccess.inspectDocument({
+        action: 'get',
+        type: 'Actor',
+        identifier: 'a1',
+        embedded_type: 'Item',
+      });
+      expect(list).toMatchObject({ embeddedType: 'Item', total: 2 });
+      expect(list.items.map((i: any) => i.name)).toEqual(['Scimitar', 'Shortbow']);
+
+      const one = await dataAccess.inspectDocument({
+        action: 'get',
+        type: 'Actor',
+        identifier: 'a1',
+        embedded_type: 'Item',
+        embedded_identifier: 'shortbow',
+      });
+      expect(one.document.id).toBe('i2');
+      expect(JSON.parse(one.data).system.damage).toBe('1d6');
+    });
+
+    it.each([
+      ['an unknown document', { type: 'Actor', identifier: 'Nobody' }, 'not found'],
+      ['no identifier', { type: 'Actor' }, 'needs identifier'],
+      [
+        'a bad embedded type',
+        { type: 'Actor', identifier: 'a1', embedded_type: 'Token' },
+        'has no embedded "Token"',
+      ],
+      [
+        'an unknown embedded document',
+        { type: 'Actor', identifier: 'a1', embedded_type: 'Item', embedded_identifier: 'zz' },
+        'not found',
+      ],
+      ['a wrong path', { type: 'Actor', identifier: 'a1', path: 'system.nope' }, 'Nothing at'],
+      ['a bad depth', { type: 'Actor', identifier: 'a1', depth: 0 }, 'depth must be'],
+      ['a bad max_chars', { type: 'Actor', identifier: 'a1', max_chars: 10 }, 'max_chars must be'],
+    ])('rejects %s', async (_label, options, message) => {
+      const { dataAccess } = setup();
+      await expect(
+        dataAccess.inspectDocument({ action: 'get', ...(options as any) })
+      ).rejects.toThrow(message);
+    });
+
+    it('refuses several documents with the same name', async () => {
+      const twin = (id: string) => ({ ...makeActor(), id, name: 'Twin' });
+      const { dataAccess } = setup({ actors: [twin('t1'), twin('t2')] });
+      await expect(
+        dataAccess.inspectDocument({ action: 'get', type: 'Actor', identifier: 'twin' })
+      ).rejects.toThrow('Several Actor documents');
+    });
+
+    it('never changes anything', async () => {
+      const { dataAccess, actor } = setup();
+      await dataAccess.inspectDocument({
+        action: 'get',
+        type: 'Actor',
+        identifier: 'a1',
+        include_embedded: true,
+      });
+      expect(actor.update).not.toHaveBeenCalled();
+      expect(actor.delete).not.toHaveBeenCalled();
+    });
+  });
+
+  describe('schema', () => {
+    it('describes a type and its embedded types', async () => {
+      const { dataAccess } = setup();
+      const result = await dataAccess.inspectDocument({ action: 'schema', type: 'Scene' });
+      expect(result.embeddedTypes).toEqual({ Token: 'tokens', Wall: 'walls' });
+      expect(result.fields.name.type).toBe('StringField');
+    });
+
+    it('describes an embedded type by name', async () => {
+      const { dataAccess } = setup();
+      const result = await dataAccess.inspectDocument({ action: 'schema', embedded_type: 'Wall' });
+      expect(Object.keys(result.fields)).toEqual(['c', 'door']);
+    });
+
+    it('rejects unknown and malformed type names', async () => {
+      const { dataAccess } = setup();
+      await expect(
+        dataAccess.inspectDocument({ action: 'schema', type: 'Dragon' })
+      ).rejects.toThrow('No document type named "Dragon"');
+      await expect(dataAccess.inspectDocument({ action: 'schema', type: '../x' })).rejects.toThrow(
+        'schema needs type'
+      );
+      await expect(dataAccess.inspectDocument({ action: 'schema' })).rejects.toThrow(
+        'schema needs type'
+      );
+    });
+  });
+
+  it('rejects an unknown action', async () => {
+    const { dataAccess } = setup();
+    await expect(dataAccess.inspectDocument({ action: 'delete' as any })).rejects.toThrow(
+      'Unknown action'
+    );
+  });
+});
diff --git a/packages/foundry-module/src/data-access.manage-journals.test.ts b/packages/foundry-module/src/data-access.manage-journals.test.ts

+
+describe('parseApiPath', () => {
+  it('accepts plain and nested names, and drops a leading api.', () => {
+    expect(parseApiPath('getByTag')).toEqual(['getByTag']);
+    expect(parseApiPath('tags.add')).toEqual(['tags', 'add']);
+    expect(parseApiPath('api.tags.add')).toEqual(['tags', 'add']);
+  });
+  it('refuses anything that could reach outside the api', () => {
+    for (const bad of ['', ' ', 'a b', 'a..b', 'a.', '1a', 'a-b', 'a()', 'x.constructor', '__proto__.x', 'a.prototype.b', 'eval', 'a;b', 'a[0]']) {
+      expect(() => parseApiPath(bad)).toThrow();
+    }
+    expect(() => parseApiPath('a.b.c.d.e.f.g')).toThrow('at most');
+    expect(() => parseApiPath(42)).toThrow('required');
+  });
+});
+
+describe('resolveApiFunction', () => {
+  const api = { ping: function (this: any) { return this === api; }, tags: { add: (x: number) => x + 1, label: 'x' }, n: 3 };
+  it('finds a function and keeps its owner as this', () => {
+    const { fn, self, name } = resolveApiFunction(api, 'tags.add');
+    expect(name).toBe('tags.add');
+    expect(fn.call(self, 1)).toBe(2);
+    const ping = resolveApiFunction(api, 'ping');
+    expect(ping.fn.apply(ping.self, [])).toBe(true);
+  });
+  it('explains what went wrong', () => {
+    expect(() => resolveApiFunction(api, 'nope')).toThrow('not a function');
+    expect(() => resolveApiFunction(api, 'tags.label')).toThrow('not a function');
+    expect(() => resolveApiFunction(api, 'n.x')).toThrow('not an object');
+    expect(() => resolveApiFunction(api, 'ping.constructor')).toThrow('not allowed');
+  });
+});
+
+describe('serializeValue', () => {
+  it('passes JSON values through and names functions', () => {
+    expect(serializeValue({ a: 1, b: 'x', c: [true, null], f: function go() {} })).toEqual({ a: 1, b: 'x', c: [true, null], f: '[function go]' });
+    expect(serializeValue(undefined)).toBeNull();
+    expect(serializeValue(NaN)).toBe('NaN');
+  });
+  it('turns documents, canvas objects, maps and sets into plain data', () => {
+    const doc = { documentName: 'Token', id: 't1', uuid: 'Scene.s.Token.t1', name: 'Wolf', huge: new Array(1000).fill(1) };
+    expect(serializeValue(doc)).toEqual({ documentName: 'Token', id: 't1', uuid: 'Scene.s.Token.t1', name: 'Wolf' });
+    expect(serializeValue({ document: doc })).toEqual({ documentName: 'Token', id: 't1', uuid: 'Scene.s.Token.t1', name: 'Wolf' });
+    expect(serializeValue(new Map([['a', 1], ['b', 2]]))).toEqual([1, 2]);
+    expect(serializeValue(new Set([1, 2]))).toEqual([1, 2]);
+    expect(serializeValue({ contents: [1, 2, 3] })).toEqual([1, 2, 3]);
+    expect(serializeValue(new Date(0))).toBe('1970-01-01T00:00:00.000Z');
+  });
+  it('limits depth, length and cycles', () => {
+    const cyc: any = { name: 'c' };
+    cyc.self = cyc;
+    expect(serializeValue(cyc)).toEqual({ name: 'c', self: '[circular]' });
+    const deep = { a: { b: { c: { d: { e: 1 } } } } };
+    expect(JSON.stringify(serializeValue(deep))).toContain('[object]');
+    const list = serializeValue(new Array(150).fill(7)) as unknown[];
+    expect(list.length).toBe(101);
+    expect(list[100]).toBe('... 50 more');
+    expect((serializeValue('x'.repeat(5000)) as string).length).toBeLessThan(2100);
+  });
+  it('survives getters that throw', () => {
+    const bad = {};
+    Object.defineProperty(bad, 'boom', { enumerable: true, get() { throw new Error('no'); } });
+    expect(serializeValue(bad)).toEqual({ boom: '[unreadable]' });
+  });
+});
+
+describe('relationIds', () => {
+  it('reads sets, arrays and collections of ids or objects', () => {
+    expect(relationIds(new Set([{ id: 'a' }, { id: 'b' }]))).toEqual(['a', 'b']);
+    expect(relationIds(['a', { id: 'b' }, 5, {}])).toEqual(['a', 'b']);
+    expect(relationIds({ contents: [{ id: 'z' }] })).toEqual(['z']);
+    expect(relationIds(undefined)).toEqual([]);
+  });
+});
+
+describe('describeApi', () => {
+  it('lists functions, nested objects and values, including class methods, without private names', () => {
+    class Api {
+      value = 5;
+      tags = { add() {}, remove() {} };
+      _hidden = 1;
+      getByTag() {}
+    }
+    const described = describeApi(new Api())!;
+    const names = Object.fromEntries(described.map(d => [d.name, d]));
+    expect(names.getByTag?.kind).toBe('function');
+    expect(names.value?.kind).toBe('value');
+    expect(names.tags).toEqual({ name: 'tags', kind: 'object', members: ['add', 'remove'] });
+    expect(names._hidden).toBeUndefined();
+    expect(describeApi(null)).toBeNull();
+  });
+});
+
+const node = (id: string, active: boolean, requires: string[] = [], conflicts: string[] = []): ModuleNode => ({ id, active, requires, conflicts, installed: true });
+
+describe('planModuleToggle', () => {
+  const nodes = [
+    node('mine', true, [], ['original']),
+    node('original', false, [], ['mine']),
+    node('socketlib', false),
+    node('libwrapper', false),
+    node('sequencer', false, ['socketlib']),
+    node('jb2a', false, ['sequencer']),
+    node('tagger', false, ['libwrapper']),
+    node('active-lib', true),
+    node('needs-active-lib', true, ['active-lib']),
+  ];
+
+  it('switches on what is needed first, in order', () => {
+    const plan = planModuleToggle(nodes, ['jb2a'], true);
+    expect(plan.ok).toBe(true);
+    expect(plan.change.map(c => c.id)).toEqual(['socketlib', 'sequencer', 'jb2a']);
+    expect(plan.change[0]).toMatchObject({ active: true, reason: 'needed by sequencer' });
+    expect(plan.change[2]!.reason).toBe('requested');
+  });
+
+  it('reports modules already in the wanted state and does not repeat shared needs', () => {
+    const plan = planModuleToggle(nodes, ['active-lib', 'sequencer', 'jb2a'], true);
+    expect(plan.unchanged).toEqual(['active-lib']);
+    expect(plan.change.map(c => c.id)).toEqual(['socketlib', 'sequencer', 'jb2a']);
+  });
+
+  it('refuses a module that conflicts with an active one', () => {
+    const plan = planModuleToggle(nodes, ['original'], true);
+    expect(plan.ok).toBe(false);
+    expect(plan.problems[0]).toContain('conflicts with "mine"');
+  });
+
+  it('says when something is not installed', () => {
+    const plan = planModuleToggle(nodes, ['ghost'], true);
+    expect(plan.ok).toBe(false);
+    expect(plan.problems).toEqual(['"ghost" is not installed']);
+    const lib = planModuleToggle([node('x', false, ['missing-lib'])], ['x'], true);
+    expect(lib.problems).toContain('"missing-lib" is not installed');
+  });
+
+  it('switches off what depends on a module, and protects the connection', () => {
+    const plan = planModuleToggle(nodes, ['active-lib'], false);
+    expect(plan.change.map(c => c.id)).toEqual(['needs-active-lib', 'active-lib']);
+    expect(plan.change[0]).toMatchObject({ active: false, reason: 'needs active-lib' });
+    const own = planModuleToggle(nodes, ['mine'], false, ['mine']);
+    expect(own.ok).toBe(false);
+    expect(own.problems[0]).toContain('connection to this tool');
+    expect(planModuleToggle(nodes, ['socketlib'], false).unchanged).toEqual(['socketlib']);
+  });
+
+  it('copes with a requirement loop', () => {
+    const loop = [node('a', false, ['b']), node('b', false, ['a'])];
+    const plan = planModuleToggle(loop, ['a'], true);
+    expect(plan.ok).toBe(true);
+    expect(plan.change.map(c => c.id).sort()).toEqual(['a', 'b']);
+  });
+});
diff --git a/packages/foundry-module/src/module-utils.ts b/packages/foundry-module/src/module-utils.ts

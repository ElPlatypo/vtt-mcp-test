+  private async runExisting(doc: LayoutDoc, a: Args): Promise<any> {
+    switch (a.action) {
+      case 'add': {
+        if (!a.shapes) throw new Error('add needs shapes');
+        const before = captureState(doc);
+        const expanded = expandShapeSpecs(a.shapes);
+        // Roads, grass and the like go under buildings already drawn, unless after says otherwise.
+        const under = a.after === undefined ? groundInsertIndex(doc.shapes as any, expanded) : undefined;
+        const ids = addShapes(doc, expanded, a.after, under);
+        commitChange(doc, `add ${ids.length} shape${ids.length === 1 ? '' : 's'} (${ids.join(', ')})`, before);
+        await this.store.save(doc);
+        return this.summary(doc, 'add', ids);
+      }
+      case 'update': {
+        if (a.id === undefined) throw new Error('update needs id');
+        if (!a.set && !a.move && !a.front && !a.back && a.after === undefined) {
+          throw new Error('update needs set, move, front, back or after');
+        }
+        const before = captureState(doc);
+        updateShape(doc, a.id, {
+          ...(a.set ? { set: a.set } : {}),
+          ...(a.move ? { move: a.move } : {}),
+          ...(a.front ? { front: true } : {}),
+          ...(a.back ? { back: true } : {}),
+          ...(a.after !== undefined ? { after: a.after } : {}),
+        });
+        commitChange(doc, `update shape ${a.id}`, before);
+        await this.store.save(doc);
+        return this.summary(doc, 'update', [a.id]);
+      }
+      case 'remove': {
+        if (!a.ids) throw new Error('remove needs ids');
+        const before = captureState(doc);
+        const removed = removeShapes(doc, a.ids);
+        commitChange(doc, `remove shape${removed.length === 1 ? '' : 's'} ${removed.join(', ')}`, before);
+        await this.store.save(doc);
+        return this.summary(doc, 'remove', removed);
+      }
+      case 'set': {
+        const before = captureState(doc);
+        if (a.snap !== undefined) {
+          if (a.snap < 0 || a.snap > 5) throw new Error('snap must be a number from 0 to 5');
+          doc.snap = a.snap;
+        }
+        if (a.background !== undefined) {
+          if (!FILLS[a.background]) throw new Error(`background must be one of ${fillNames.join(', ')}`);
+          doc.background = a.background;
+        }
+        if (a.wall_fills !== undefined) {
+          for (const f of a.wall_fills) if (!FILLS[f]) throw new Error(`wall_fills: unknown fill "${f}"`);
+          doc.wallFills = a.wall_fills;
+        }
+        if (a.reference === null) delete doc.reference;
+        else if (a.reference) {
+          doc.reference = { image: a.reference.image, origin: a.reference.origin, cellPx: a.reference.cell_px };
+        }
+        commitChange(doc, 'change settings', before);

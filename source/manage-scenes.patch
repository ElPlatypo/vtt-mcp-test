+    expect((await da.manageSceneBackups({ action: 'list', scene: 'nothing' }).catch(() => ({ failed: true }))) as any).toMatchObject({ failed: true });
+  });
+
+  it('restore shows what it would do unless confirmed', async () => {
+    const { da, cave } = setupScenes();

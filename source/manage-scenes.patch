+import { afterEach, describe, expect, it, vi } from 'vitest';
+import WebSocket from 'ws';
+import { TableFeed } from './table-feed.js';
+
+const logger = { info: vi.fn(), warn: vi.fn(), debug: vi.fn() };
+
+/** A stand-in for the module's table-events query: a list of events and a muted flag. */
+function fakeModule() {
+  const state = { events: [] as any[], muted: false, session: 's1', snapshots: 0 };
+  const query = vi.fn(async (_method: string, data: any) => {
+    if (data?.snapshot) state.snapshots += 1;
+    const since = typeof data?.since === 'number' ? data.since : undefined;
+    const events = since === undefined ? state.events : state.events.filter(e => e.seq > since);
+    return {
+      success: true,
+      session: state.session,
+      seq: state.events.length,
+      events,
+      muted: state.muted,
+      ...(data?.snapshot ? { table: { scene: 'Trail', party: ['Randal hp 20/20 AC 19'] } } : {}),
+    };
+  });
+  const push = (e: any) => state.events.push({ seq: state.events.length + 1, at: 0, ...e });
+  return { state, query, push };
+}
+
+let feed: TableFeed | undefined;
+afterEach(() => {
+  feed?.stop();
+  feed = undefined;
+});
+
+async function connect(port: number): Promise<{ lines: any[]; ws: WebSocket }> {
+  const ws = new WebSocket(`ws://127.0.0.1:${port}`);
+  const lines: any[] = [];
+  ws.on('message', d => lines.push(JSON.parse(String(d))));
+  await new Promise(r => ws.once('open', r));
+  return { lines, ws };
+}
+
+const until = async (check: () => boolean, ms = 3000) => {
+  const end = Date.now() + ms;
+  while (!check() && Date.now() < end) await new Promise(r => setTimeout(r, 20));
+};
+
+describe('TableFeed', () => {
+  it('starts from now, then sends one beat with the events and a table snapshot', async () => {
+    const mod = fakeModule();
+    mod.push({ kind: 'say', wake: true, text: 'old line, before anyone listened' });
+    feed = new TableFeed({ query: mod.query, isConnected: () => true, logger, port: 0, pollMs: 20 });
+    feed.configure({ quietMs: 50, minIntervalMs: 0 });
+    await feed.start();
+    const { lines, ws } = await connect(feed.port!);
+    await until(() => mod.query.mock.calls.length > 1);
+    mod.push({ kind: 'move', wake: false, text: 'Randal moved to square (3, 4)' });
+    mod.push({ kind: 'say', wake: true, text: 'Randal (Claudio): "I open the door"' });
+    await until(() => lines.length > 0);
+    expect(lines[0]).toEqual({
+      type: 'beat',
+      n: 1,
+      why: ['a player spoke in character'],
+      events: ['Randal moved to square (3, 4)', 'Randal (Claudio): "I open the door"'],
+      table: { scene: 'Trail', party: ['Randal hp 20/20 AC 19'] },
+    });
+    expect(feed.status()).toMatchObject({ listeners: 1, beatsSent: 1, pendingEvents: 0 });
+    ws.close();
+  });
+
+  it('tells the listener when the GM mutes, and sends nothing while muted', async () => {
+    const mod = fakeModule();
+    feed = new TableFeed({ query: mod.query, isConnected: () => true, logger, port: 0, pollMs: 20 });
+    feed.configure({ quietMs: 0, minIntervalMs: 0 });
+    await feed.start();
+    const { lines, ws } = await connect(feed.port!);
+    await until(() => mod.query.mock.calls.length > 1);
+    mod.state.muted = true;
+    mod.push({ kind: 'say', wake: true, text: 'muted line' });
+    await until(() => lines.length > 0);
+    await new Promise(r => setTimeout(r, 150));
+    expect(lines).toEqual([{ type: 'notice', text: 'The GM muted the AI GM: events are kept and come in one bundle when unmuted' }]);
+    mod.state.muted = false;
+    await until(() => lines.some(l => l.type === 'beat'));
+    expect(lines.find(l => l.type === 'beat')?.events).toEqual(['muted line']);
+    ws.close();
+  });
+
+  it('says when Foundry is not connected', async () => {
+    const mod = fakeModule();
+    feed = new TableFeed({ query: mod.query, isConnected: () => false, logger, port: 0, pollMs: 20 });
+    await feed.start();
+    const { lines, ws } = await connect(feed.port!);
+    await until(() => lines.length > 0);
+    expect(lines[0]).toEqual({ type: 'notice', text: 'Foundry is not connected; the table feed resumes when it is' });
+    expect(mod.query).not.toHaveBeenCalled();
+    ws.close();
+  });
+});

+import { describe, expect, it, vi } from 'vitest';
+import { LootTools } from './loot-tools.js';
+
+function makeTools(impl?: (method: string, data: any) => unknown) {
+  const query = vi.fn(
+    impl ??
+      (async (method: string) => {
+        if (method.endsWith('make-chest')) return { success: true, actor: { id: 'c1', name: 'Hoard', type: 'group' }, steps: ['1 compendium item(s) added'], added: [], stacked: [], notFound: [] };
+        if (method.endsWith('manage-scene-objects')) return { success: true, scene: { id: 's', name: 'Cave' }, created: [{ kind: 'token', id: 't1', x: 4, y: 5 }] };
+        return { success: true };
+      })
+  );
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  return { tools: new LootTools({ foundryClient: { query } as any, logger }), query };
+}
+
+describe('definitions', () => {
+  it('offers add-compendium-items and make-chest', () => {
+    const defs = makeTools().tools.getToolDefinitions();
+    expect(defs.map(d => d.name)).toEqual(['add-compendium-items', 'make-chest']);
+    expect(defs[0]!.inputSchema.required).toEqual(['actor', 'items']);
+    expect(defs[1]!.inputSchema.required).toEqual(['name']);
+  });
+});
+
+describe('add-compendium-items', () => {
+  it('sends the request as given', async () => {
+    const { tools, query } = makeTools();
+    await tools.handleAddCompendiumItems({ actor: 'Goblin', items: ['Longsword', { name: 'Arrow', quantity: 20 }], packs: ['dnd5e.items'], stack: false });
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.add-compendium-items', { actor: 'Goblin', items: ['Longsword', { name: 'Arrow', quantity: 20 }], packs: ['dnd5e.items'], stack: false });
+  });
+  it('refuses bad input and reports a refusal', async () => {
+    const { tools, query } = makeTools(async () => ({ success: false, error: 'Actor not found' }));
+    await expect(tools.handleAddCompendiumItems({ actor: 'x', items: [] })).rejects.toThrow();
+    await expect(tools.handleAddCompendiumItems({ items: ['a'] })).rejects.toThrow();
+    await expect(tools.handleAddCompendiumItems({ actor: 'x', items: [{ name: 'a', quantity: 0 }] })).rejects.toThrow();
+    expect(query).not.toHaveBeenCalled();
+    await expect(tools.handleAddCompendiumItems({ actor: 'x', items: ['a'] })).rejects.toThrow('Failed to add compendium items: Actor not found');
+  });
+});
+
+describe('make-chest', () => {
+  it('makes the chest and places its token', async () => {
+    const { tools, query } = makeTools();
+    const r = await tools.handleMakeChest({ name: 'Hoard', items: ['Potion of Healing'], currency: { gp: 50 }, scene: 'Cave', x: 4, y: 5, width: 1, hidden: true });
+    expect(query).toHaveBeenNthCalledWith(1, 'foundry-mcp-bridge.make-chest', { name: 'Hoard', items: ['Potion of Healing'], currency: { gp: 50 } });
+    expect(query).toHaveBeenNthCalledWith(2, 'foundry-mcp-bridge.manage-scene-objects', {
+      action: 'place',
+      scene: 'Cave',
+      objects: [{ kind: 'token', actor: 'c1', x: 4, y: 5, name: 'Hoard', width: 1, hidden: true }],
+    });
+    expect(r.token).toMatchObject({ id: 't1', scene: { name: 'Cave' } });
+    expect(r.steps).toEqual(['1 compendium item(s) added', 'token placed']);
+  });
+  it('makes only the actor when no position is given', async () => {
+    const { tools, query } = makeTools();
+    const r = await tools.handleMakeChest({ name: 'Hoard', custom_items: [{ name: 'Locket', price: { value: 25 } }] });
+    expect(query).toHaveBeenCalledTimes(1);
+    expect(r.token).toBeUndefined();
+  });
+  it('needs both x and y, and checks the other fields', async () => {
+    const { tools, query } = makeTools();
+    await expect(tools.handleMakeChest({ name: 'H', x: 3 })).rejects.toThrow('both x and y');
+    await expect(tools.handleMakeChest({ name: 'H', ownership: 'all' })).rejects.toThrow();
+    await expect(tools.handleMakeChest({ name: 'H', currency: { gold: 1 } })).rejects.toThrow();
+    await expect(tools.handleMakeChest({})).rejects.toThrow();
+    expect(query).not.toHaveBeenCalled();
+  });
+  it('says the chest exists when only the token fails', async () => {
+    const { tools } = makeTools(async (m: string) => (m.endsWith('make-chest') ? { success: true, actor: { id: 'c1', name: 'Hoard' } } : { success: false, error: 'outside the scene' }));
+    await expect(tools.handleMakeChest({ name: 'Hoard', x: 99, y: 99 })).rejects.toThrow('was made (id c1) but its token could not be placed: outside the scene');
+  });
+  it('reports a refusal when the chest cannot be made', async () => {
+    const { tools } = makeTools(async () => ({ success: false, error: 'no group type' }));
+    await expect(tools.handleMakeChest({ name: 'Hoard' })).rejects.toThrow('Failed to make the chest: no group type');
+  });
+});
diff --git a/packages/mcp-server/src/tools/loot-tools.ts b/packages/mcp-server/src/tools/loot-tools.ts
new file mode 100644
index 0000000..9384dc7
--- /dev/null
+++ b/packages/mcp-server/src/tools/loot-tools.ts
@@ -0,0 +1,221 @@
+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+
+export interface LootToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+const itemRequest = z.union([
+  z.string().min(1).max(200),
+  z
+    .object({
+      name: z.string().min(1).max(200),
+      quantity: z.number().int().min(1).max(9999).optional(),
+      pack: z.string().min(1).max(200).optional(),
+    })
+    .strict(),
+]);
+
+const customItem = z
+  .object({
+    name: z.string().min(1).max(200),
+    type: z.string().min(1).max(40).optional(),
+    quantity: z.number().int().min(1).max(9999).optional(),
+    price: z.object({ value: z.number().min(0), denomination: z.enum(['pp', 'gp', 'ep', 'sp', 'cp']).optional() }).strict().optional(),
+    description: z.string().max(4000).optional(),
+  })
+  .strict();
+
+const currencySchema = z
+  .object({
+    pp: z.number().int().min(0).optional(),
+    gp: z.number().int().min(0).optional(),
+    ep: z.number().int().min(0).optional(),
+    sp: z.number().int().min(0).optional(),
+    cp: z.number().int().min(0).optional(),
+  })
+  .strict();
+
+const addSchema = z
+  .object({
+    actor: z.string().min(1),
+    items: z.array(itemRequest).min(1).max(100),
+    packs: z.array(z.string().min(1)).max(20).optional(),
+    stack: z.boolean().optional(),
+  })
+  .strict();
+
+const chestSchema = z
+  .object({
+    name: z.string().min(1).max(100),
+    items: z.array(itemRequest).min(1).max(100).optional(),
+    custom_items: z.array(customItem).max(100).optional(),
+    currency: currencySchema.optional(),
+    ownership: z.enum(['none', 'limited', 'observer', 'owner']).optional(),
+    packs: z.array(z.string().min(1)).max(20).optional(),
+    img: z.string().min(1).max(400).optional(),
+    folder: z.string().min(1).max(100).optional(),
+    type: z.string().min(1).max(40).optional(),
+    scene: z.string().min(1).optional(),
+    x: z.number().min(0).optional(),
+    y: z.number().min(0).optional(),
+    width: z.number().min(0.5).max(20).optional(),
+    height: z.number().min(0.5).max(20).optional(),
+    hidden: z.boolean().optional(),
+  })
+  .strict();
+
+export class LootTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: LootToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'LootTools' });
+  }
+
+  getToolDefinitions() {
+    const itemList = {
+      type: 'array',
+      items: {
+        description: 'An item name ("Longsword") or {name, quantity?, pack?}',
+        anyOf: [
+          { type: 'string' },
+          {
+            type: 'object',
+            properties: { name: { type: 'string' }, quantity: { type: 'number' }, pack: { type: 'string' } },
+            required: ['name'],
+            additionalProperties: false,
+          },
+        ],
+      },
+    };
+    return [
+      {
+        name: 'add-compendium-items',
+        description:
+          'Copy items from the compendium onto an actor by exact name: weapons, armour, potions, gear, loot, for an NPC, a player character or a chest. items: ["Longsword", {name:"Arrow", quantity:20}, {name:"Chest", pack:"dnd5e.items"}]. Without a pack it searches the item packs (the main system ones first) and only takes things that can be carried, not spells or features; name a pack to take anything from it. An item already on the actor stacks (its quantity goes up) unless stack is false. Reports what was added, stacked and not found. Use search-compendium to find exact names.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            actor: { type: 'string', description: 'Actor id or name' },
+            items: itemList,
+            packs: { type: 'array', items: { type: 'string' }, description: 'Pack ids to search, in order (default: all item packs)' },
+            stack: { type: 'boolean', description: 'Add to an existing stack of the same item (default true)' },
+          },
+          required: ['actor', 'items'],
+          additionalProperties: false,
+        },
+      },
+      {
+        name: 'make-chest',
+        description:
+          'Make a chest, hoard or stash of loot in one call: an actor (a group in D&D 5e) holding currency, compendium items and made-up items, with who may open it, and optionally its token on a scene. ' +
+          'items: compendium items as in add-compendium-items (["Potion of Healing", {name:"Arrow", quantity:20}]); custom_items: things made up on the spot [{name, quantity?, type? (default loot), price?:{value, denomination}, description? (HTML)}]; currency: {pp?, gp?, ep?, sp?, cp?}. ' +
+          'ownership says what players can do with it: none (they cannot see it), limited, observer (default: they can look inside), owner (they can take things). ' +
+          'Give scene (default the one being viewed), x and y (grid squares, top-left corner of the token) to put its token on the map; without x and y only the actor is made. img is the chest picture (default a steel-bound chest from Foundry\'s icons; a prop made with make-prop works too). It lands in a Loot folder. Names not found in the compendium are listed, and the chest is still made.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: { type: 'string', description: 'Name of the chest or hoard' },
+            items: itemList,
+            custom_items: {
+              type: 'array',
+              items: {
+                type: 'object',
+                properties: {
+                  name: { type: 'string' },
+                  type: { type: 'string' },
+                  quantity: { type: 'number' },
+                  price: { type: 'object', properties: { value: { type: 'number' }, denomination: { type: 'string' } } },
+                  description: { type: 'string' },
+                },
+                required: ['name'],
+                additionalProperties: false,
+              },
+            },
+            currency: {
+              type: 'object',
+              properties: { pp: { type: 'number' }, gp: { type: 'number' }, ep: { type: 'number' }, sp: { type: 'number' }, cp: { type: 'number' } },
+              additionalProperties: false,
+            },
+            ownership: { type: 'string', enum: ['none', 'limited', 'observer', 'owner'], description: 'What players can do with it (default observer)' },
+            packs: { type: 'array', items: { type: 'string' }, description: 'Pack ids to search for the items' },
+            img: { type: 'string', description: 'Picture for the chest and its token' },
+            folder: { type: 'string', description: 'Actor folder (default Loot)' },
+            type: { type: 'string', description: 'Actor type (default group)' },
+            scene: { type: 'string', description: 'Scene for the token (id or exact name; default the one being viewed)' },
+            x: { type: 'number', description: 'Token column in grid squares (with y places the token)' },
+            y: { type: 'number', description: 'Token row in grid squares' },
+            width: { type: 'number', description: 'Token width in squares (default 1)' },
+            height: { type: 'number', description: 'Token height in squares (default 1)' },
+            hidden: { type: 'boolean', description: 'Hide the token from players until revealed' },
+          },
+          required: ['name'],
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handleAddCompendiumItems(args: unknown): Promise<any> {
+    const a = addSchema.parse(args ?? {});
+    try {
+      const result = await this.foundryClient.query('foundry-mcp-bridge.add-compendium-items', a);
+      if (result?.success === false) throw new Error(result.error || 'The items could not be added');
+      return result;
+    } catch (error) {
+      this.logger.error('Failed to add compendium items', error);
+      throw new Error(`Failed to add compendium items: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  async handleMakeChest(args: unknown): Promise<any> {
+    const a = chestSchema.parse(args ?? {});
+    if ((a.x === undefined) !== (a.y === undefined)) throw new Error('Give both x and y to place the token, or neither');
+    if (!a.items && !a.custom_items && !a.currency) {
+      // an empty chest is allowed, but it is usually a forgotten argument
+      this.logger.warn('make-chest called with no items, custom_items or currency');
+    }
+    const { scene, x, y, width, height, hidden, ...chest } = a;
+    try {
+      const made = await this.foundryClient.query('foundry-mcp-bridge.make-chest', chest);
+      if (made?.success === false) throw new Error(made.error || 'The chest could not be made');
+      const result: Record<string, any> = { ...made };
+      if (x !== undefined && y !== undefined) {
+        try {
+          const placed = await this.foundryClient.query('foundry-mcp-bridge.manage-scene-objects', {
+            action: 'place',
+            ...(scene ? { scene } : {}),
+            objects: [
+              {
+                kind: 'token',
+                actor: made.actor.id,
+                x,
+                y,
+                name: a.name,
+                ...(width !== undefined ? { width } : {}),
+                ...(height !== undefined ? { height } : {}),
+                ...(hidden !== undefined ? { hidden } : {}),
+              },
+            ],
+          });
+          if (placed?.success === false) throw new Error(placed.error || 'refused');
+          result.token = { ...(placed?.created?.[0] ?? {}), scene: placed?.scene };
+          result.steps = [...(result.steps ?? []), 'token placed'];
+        } catch (error) {
+          // The chest exists; say so, so it is not made twice.
+          throw new Error(
+            `The chest "${made.actor.name}" was made (id ${made.actor.id}) but its token could not be placed: ${error instanceof Error ? error.message : 'Unknown error'}`
+          );
+        }
+      }
+      return result;
+    } catch (error) {
+      this.logger.error('Failed to make the chest', error);
+      throw new Error(error instanceof Error && /was made \(id/.test(error.message) ? error.message : `Failed to make the chest: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+}
diff --git a/packages/mcp-server/src/tools/module-tools.test.ts b/packages/mcp-server/src/tools/module-tools.test.ts

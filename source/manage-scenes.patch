+import { describe, expect, it, vi } from 'vitest';
+import { PlutoniumTools } from './plutonium-tools.js';
+
+function make(response: any = { success: true }) {
+  const query = vi.fn(async () => response);
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  return { tools: new PlutoniumTools({ foundryClient: { query } as any, logger }), query };
+}
+
+describe('plutonium and adventure tools', () => {
+  it('exposes both tools', () => {
+    const defs = make().tools.getToolDefinitions();
+    expect(defs.map(d => d.name)).toEqual(['plutonium', 'adventure']);
+    expect(defs[0]!.description).toContain('before the SRD compendiums');
+    expect(defs[1]!.description).toContain('LMoP');
+  });
+  it('sends plutonium requests to Foundry', async () => {
+    const { tools, query } = make({ success: true, results: [] });
+    await tools.handlePlutonium({ action: 'import', kind: 'creature', names: ['Goblin Boss'] });
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.plutonium', { action: 'import', kind: 'creature', names: ['Goblin Boss'] }, 120000);
+  });
+  it('sends adventure requests to Foundry', async () => {
+    const { tools, query } = make({ success: true });
+    await tools.handleAdventure({ action: 'read', section: 1, heading: 'Goblin Ambush' });
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.adventure', { action: 'read', section: 1, heading: 'Goblin Ambush' }, 60000);
+  });
+  it('rejects bad input and refused requests', async () => {
+    const { tools } = make();
+    await expect(tools.handlePlutonium({ kind: 'dragon' })).rejects.toThrow();
+    await expect(tools.handlePlutonium({ action: 'import', names: [] })).rejects.toThrow();
+    await expect(tools.handleAdventure({ action: 'dig' })).rejects.toThrow();
+    const refused = make({ success: false, error: 'Access denied' });
+    await expect(refused.tools.handleAdventure({})).rejects.toThrow('Access denied');
+  });
+});
diff --git a/packages/mcp-server/src/tools/plutonium-tools.ts b/packages/mcp-server/src/tools/plutonium-tools.ts
new file mode 100644
index 0000000..2ef7086
--- /dev/null
+++ b/packages/mcp-server/src/tools/plutonium-tools.ts
@@ -0,0 +1,104 @@
+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+
+export interface PlutoniumToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+const plutoniumSchema = z
+  .object({
+    action: z.enum(['status', 'search', 'import']).optional(),
+    kind: z.enum(['creature', 'spell', 'item']).optional(),
+    query: z.string().min(1).max(120).optional(),
+    source: z.string().min(1).max(20).optional(),
+    limit: z.number().int().min(1).max(25).optional(),
+    names: z.array(z.string().min(1).max(120)).min(1).max(20).optional(),
+  })
+  .strict();
+
+const adventureSchema = z
+  .object({
+    action: z.enum(['list', 'outline', 'search', 'read']).optional(),
+    adventure: z.string().min(1).max(40).optional(),
+    query: z.string().min(1).max(200).optional(),
+    section: z.union([z.string().min(1).max(120), z.number().int().min(0).max(200)]).optional(),
+    heading: z.string().min(1).max(120).optional(),
+    limit: z.number().int().min(1).max(10).optional(),
+    max_chars: z.number().int().min(500).max(15000).optional(),
+  })
+  .strict();
+
+export class PlutoniumTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: PlutoniumToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'PlutoniumTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'plutonium',
+        description:
+          'Search and import monsters, spells and items from the 5etools catalogue through the Plutonium module (it must be active in the world). ' +
+          'It covers every official book and many third-party ones, so use it before the SRD compendiums when a creature, spell or item is not found there, and to import fully converted actors (actions, traits, spells, art) in one call. ' +
+          'search {kind: creature|spell|item (default creature), query, source?, limit?} lists matches (name, source, cr/level/type; inWorld:true when one with that name already exists); ' +
+          'import {kind, names: ["Goblin Boss", "Nothic|MM"]} imports each by exact name (add |SOURCE to pick a book) and returns what was created with ids and uuids; status says whether Plutonium is active. ' +
+          'Imported actors land in the world\'s folders as Plutonium is configured; place them on a scene afterwards with the usual token tools. Needs the Foundry GM tab open and not minimized.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: { type: 'string', enum: ['status', 'search', 'import'], description: 'search (default), import or status' },
+            kind: { type: 'string', enum: ['creature', 'spell', 'item'], description: 'what to search or import (default creature)' },
+            query: { type: 'string', description: 'search: the name or part of it' },
+            source: { type: 'string', description: 'only this book, e.g. MM, PHB, LMoP' },
+            limit: { type: 'number', description: 'search: how many results (default 10, max 25)' },
+            names: { type: 'array', items: { type: 'string' }, description: 'import: exact names, each optionally "Name|SOURCE" (max 20)' },
+          },
+          additionalProperties: false,
+        },
+      },
+      {
+        name: 'adventure',
+        description:
+          'Read a published adventure from the 5etools data through Plutonium (for example Lost Mine of Phandelver, id LMoP), so scenes are run from the book and not from memory. ' +
+          'list {query?} finds adventures; outline {adventure?(LMoP)} shows its sections with the headings inside them; search {query} finds the sections that mention something (a place, an NPC, an item); ' +
+          'read {section: index or name, heading?, max_chars?(6000)} returns the text (read-aloud boxes marked "> Read aloud", tables and lists kept), use heading to read just one part such as "Goblin Ambush" or "3. Kennel". ' +
+          'Prefer search then read with a heading to keep it short. The text is the published adventure: it may include spoilers for the GM only; never read boxed text or secrets to players unless the scene calls for it.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: { type: 'string', enum: ['list', 'outline', 'search', 'read'], description: 'outline (default), list, search or read' },
+            adventure: { type: 'string', description: 'adventure id (default LMoP)' },
+            query: { type: 'string', description: 'search / list: key words' },
+            section: { type: ['string', 'number'], description: 'read: the section index or name from the outline' },
+            heading: { type: 'string', description: 'read: only the part under this heading' },
+            limit: { type: 'number', description: 'search: how many sections (default 6, max 10)' },
+            max_chars: { type: 'number', description: 'read: cut at about this many characters (default 6000, max 15000)' },
+          },
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handlePlutonium(args: unknown): Promise<any> {
+    const a = plutoniumSchema.parse(args ?? {});
+    this.logger.info('Plutonium request', { action: a.action ?? 'search', kind: a.kind });
+    const result = await this.foundryClient.query('foundry-mcp-bridge.plutonium', a, 120000);
+    if (result?.success === false) throw new Error(result.error || 'Request was refused');
+    return result;
+  }
+
+  async handleAdventure(args: unknown): Promise<any> {
+    const a = adventureSchema.parse(args ?? {});
+    this.logger.info('Adventure request', { action: a.action ?? 'outline' });
+    const result = await this.foundryClient.query('foundry-mcp-bridge.adventure', a, 60000);
+    if (result?.success === false) throw new Error(result.error || 'Request was refused');
+    return result;
+  }
+}

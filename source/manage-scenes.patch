@@ -0,0 +1,74 @@
+/**
+ * Where the map generation service (ComfyUI) lives: the one the bridge installs and starts
+ * itself on this computer ("builtin"), or any ComfyUI you already run ("custom"), on this
+ * computer or another one. Pure helpers, so they can be tested without a server.
+ */
+
+export interface ComfyTarget {
+  mode: 'builtin' | 'custom';
+  host: string;
+  port: number;
+  /** Use https and wss instead of http and ws (for a ComfyUI behind a TLS reverse proxy). */
+  secure: boolean;
+}
+
+export const BUILTIN_COMFY_PORT = 31411;
+
+export const BUILTIN_TARGET: ComfyTarget = {
+  mode: 'builtin',
+  host: '127.0.0.1',
+  port: BUILTIN_COMFY_PORT,
+  secure: false,
+};
+
+const HOSTNAME = /^[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$/;
+const IPV6 = /^\[[0-9A-Fa-f:.]+\]$/;
+
+/**
+ * Check a target sent by the Foundry module. Anything other than a clearly valid custom
+ * target is rejected, so a bad setting can never send requests to a strange address.
+ */
+export function parseComfyTarget(raw: unknown): ComfyTarget {
+  if (raw === undefined || raw === null) return { ...BUILTIN_TARGET };
+  if (typeof raw !== 'object') throw new Error('ComfyUI target must be an object');
+  const input = raw as Record<string, unknown>;
+
+  if (input.mode === undefined || input.mode === 'builtin') return { ...BUILTIN_TARGET };
+  if (input.mode !== 'custom') throw new Error('ComfyUI mode must be "builtin" or "custom"');
+
+  const host = typeof input.host === 'string' ? input.host.trim() : '';
+  if (!host || !(HOSTNAME.test(host) || IPV6.test(host))) {
+    throw new Error(
+      'ComfyUI host must be a host name or IP address (no http://, no port, no path)'
+    );
+  }
+
+  const port = input.port;
+  if (typeof port !== 'number' || !Number.isInteger(port) || port < 1 || port > 65535) {
+    throw new Error('ComfyUI port must be a whole number from 1 to 65535');
+  }
+
+  const secure = input.secure === undefined ? false : input.secure;
+  if (typeof secure !== 'boolean') throw new Error('ComfyUI secure must be true or false');
+
+  return { mode: 'custom', host, port, secure };
+}
+
+export function comfyBaseUrl(target: ComfyTarget): string {
+  return `${target.secure ? 'https' : 'http'}://${target.host}:${target.port}`;
+}
+
+export function comfyWebSocketUrl(target: ComfyTarget, clientId: string): string {
+  return `${target.secure ? 'wss' : 'ws'}://${target.host}:${target.port}/ws?clientId=${encodeURIComponent(clientId)}`;
+}
+
+export function sameComfyTarget(a: ComfyTarget, b: ComfyTarget): boolean {
+  return a.mode === b.mode && a.host === b.host && a.port === b.port && a.secure === b.secure;
+}
+
+/** A short description for messages, e.g. "custom ComfyUI at http://nexus:8188". */
+export function describeComfyTarget(target: ComfyTarget): string {
+  return target.mode === 'builtin'
+    ? `built-in ComfyUI at ${comfyBaseUrl(target)}`
+    : `custom ComfyUI at ${comfyBaseUrl(target)}`;
+}

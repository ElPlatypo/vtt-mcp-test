@@ -0,0 +1,55 @@
+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+
+export interface AuditToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+const schema = z
+  .object({
+    scene: z.string().min(1).optional(),
+    include_backups: z.boolean().optional(),
+  })
+  .strict();
+
+export class AuditTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: AuditToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'AuditTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'audit-world',
+        description:
+          'Read-only checklist of what is missing or broken in the world, worst first: scenes without a background, walls, tokens, lights or music; tokens whose actor is gone; teleport regions that are hidden (hidden regions never run), have no destination or point at a region that no longer exists; map pins pointing at a missing journal or page; dark scenes with token vision and no lights; actors still on the default silhouette; player characters nobody owns; empty playlists; duplicate scene names; no active scene. Each finding names the tool that fixes it, and a per-scene table gives the counts. scene limits it to one scene; backup scenes made by manage-scene-backups are skipped unless include_backups is true. Changes nothing. Needs the Foundry tab open in a browser.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            scene: { type: 'string', description: 'Only audit this scene (id or name)' },
+            include_backups: { type: 'boolean', description: 'Also audit backup scenes (default false)' },
+          },
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handleAuditWorld(args: any): Promise<any> {
+    const a = schema.parse(args ?? {});
+    try {
+      const result = await this.foundryClient.query('foundry-mcp-bridge.audit-world', a);
+      if (result?.success === false) throw new Error(result.error || 'The audit was refused');
+      return result;
+    } catch (error) {
+      this.logger.error('Failed to audit the world', error);
+      throw new Error(`Failed to audit the world: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+}

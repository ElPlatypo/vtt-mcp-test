@@ -0,0 +1,115 @@
+/**
+ * The ComfyUI manager must tell the MCP server which ComfyUI to use with every request,
+ * from the saved settings, or from an address being tried in the settings dialog.
+ */
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { ComfyUIManager } from './comfyui-manager.js';
+
+function setup(settings: Record<string, unknown>) {
+  const sent: any[] = [];
+  const listeners: Array<(event: { data: string }) => void> = [];
+  const socketBridge = {
+    isConnected: () => true,
+    sendMessage: (request: any) => {
+      sent.push(request);
+      // Answer like the MCP server does.
+      queueMicrotask(() =>
+        listeners.forEach(listener =>
+          listener({ data: JSON.stringify({ requestId: request.requestId, status: 'running' }) })
+        )
+      );
+    },
+    ws: {
+      addEventListener: (_type: string, listener: any) => listeners.push(listener),
+      removeEventListener: (_type: string, listener: any) => {
+        const index = listeners.indexOf(listener);
+        if (index >= 0) listeners.splice(index, 1);
+      },
+    },
+  };
+  vi.stubGlobal('foundryMCPBridge', { socketBridge });
+  vi.stubGlobal('game', { settings: { get: (_module: string, key: string) => settings[key] } });
+  vi.stubGlobal('ui', { notifications: { info: vi.fn(), warn: vi.fn(), error: vi.fn() } });
+  return { manager: new ComfyUIManager(), sent };
+}
+
+describe('ComfyUIManager target', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('uses the built-in instance by default', () => {
+    const { manager } = setup({});
+    expect(manager.getTarget().mode).toBe('builtin');
+  });
+
+  it('reads a custom instance from the saved settings', () => {
+    const { manager } = setup({
+      mapGenMode: 'custom',
+      mapGenCustomHost: 'nexus',
+      mapGenCustomPort: 8188,
+      mapGenCustomSecure: false,
+    });
+    expect(manager.getTarget()).toEqual({
+      mode: 'custom',
+      host: 'nexus',
+      port: 8188,
+      secure: false,
+    });
+  });
+
+  it('falls back to built-in when the saved custom settings are unusable', () => {
+    const { manager } = setup({
+      mapGenMode: 'custom',
+      mapGenCustomHost: '',
+      mapGenCustomPort: 8188,
+    });
+    expect(manager.getTarget().mode).toBe('builtin');
+  });
+
+  it('sends the saved target with a status check', async () => {
+    const { manager, sent } = setup({
+      mapGenMode: 'custom',
+      mapGenCustomHost: '127.0.0.1',
+      mapGenCustomPort: 8188,
+    });
+
+    await manager.checkStatus();
+
+    expect(sent).toHaveLength(1);
+    expect(sent[0].type).toBe('check-comfyui-status');
+    expect(sent[0].data.comfyuiTarget).toEqual({
+      mode: 'custom',
+      host: '127.0.0.1',
+      port: 8188,
+      secure: false,
+    });
+  });
+
+  it('sends an address that is being tried instead of the saved one', async () => {
+    const { manager, sent } = setup({});
+
+    await manager.checkStatus({ mode: 'custom', host: 'nexus', port: 9000, secure: true });
+
+    expect(sent[0].data.comfyuiTarget).toEqual({
+      mode: 'custom',
+      host: 'nexus',
+      port: 9000,
+      secure: true,
+    });
+  });
+
+  it('sends the target with map generation requests too', async () => {
+    const { manager, sent } = setup({
+      mapGenMode: 'custom',
+      mapGenCustomHost: 'nexus',
+      mapGenCustomPort: 8188,
+    });
+
+    await manager.generateMap({ prompt: 'a cave' });
+
+    expect(sent[0].type).toBe('generate-map-request');
+    expect(sent[0].data.prompt).toBe('a cave');
+    expect(sent[0].data.comfyuiTarget.host).toBe('nexus');
+  });
+});

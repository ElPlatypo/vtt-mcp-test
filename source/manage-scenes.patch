+import { describe, expect, it, vi } from 'vitest';
+import { AuditTools } from './audit-tools.js';
+
+function makeTools(impl?: (m: string, d: any) => unknown) {
+  const query = vi.fn(impl ?? (async () => ({ success: true, findings: [] })));
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  return { tools: new AuditTools({ foundryClient: { query } as any, logger }), query };
+}
+
+describe('audit-world', () => {
+  it('is exposed and sends its options', async () => {
+    const { tools, query } = makeTools();
+    expect(tools.getToolDefinitions()[0]!.name).toBe('audit-world');
+    await tools.handleAuditWorld({ scene: 'Cave', include_backups: true });
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.audit-world', { scene: 'Cave', include_backups: true });
+    await tools.handleAuditWorld(undefined);
+    expect(query).toHaveBeenLastCalledWith('foundry-mcp-bridge.audit-world', {});
+  });
+  it('refuses unknown input and reports failures', async () => {
+    const { tools, query } = makeTools(async () => ({ success: false, error: 'no such scene' }));
+    await expect(tools.handleAuditWorld({ bogus: 1 })).rejects.toThrow();
+    expect(query).not.toHaveBeenCalled();
+    await expect(tools.handleAuditWorld({})).rejects.toThrow('Failed to audit the world: no such scene');
+  });
+});
diff --git a/packages/mcp-server/src/tools/audit-tools.ts b/packages/mcp-server/src/tools/audit-tools.ts
new file mode 100644
index 0000000..f20b694
--- /dev/null

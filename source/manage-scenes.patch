+    const generate = vi.fn(async () => ({ success: true, local_path: src }));
+    const { tools, query } = make({ generate });
+    const r = await tools.handleMakeActorArt({ actors: [{ actor: 'a1', portrait: false }], token_size: 128, update_placed: false, folder: 'npc', seed: 7 });
+    expect(generate).toHaveBeenCalledTimes(1);

index 0000000..d05eaac
--- /dev/null
+++ b/packages/mcp-server/src/say-lane.ts
@@ -0,0 +1,118 @@
+/**
+ * The say lane: what the table hears and reads plays in order. Speech jobs generate one at a time, in the order the
+ * tool calls came in; chat posts, roll cards and gated board actions wait until the speech queued before them has
+ * been spoken to the end. Board actions that are not gated never come here.
+ */
+
+export interface LaneHooks {
+  /** Milliseconds until everything queued in Foundry has been spoken to the end (0 when nothing is playing). */
+  untilSpeechEnds(): Promise<number>;
+  /** A job failed after its tool call had already returned. */
+  onFailure(text: string): void;
+}
+
+export interface Queued {
+  queued: true;
+  position: number;
+  note?: string;
+}
+
+type Kind = 'speech' | 'post' | 'action';
+
+export class SayLane {
+  private tail: Promise<void> = Promise.resolve();
+  private pending = 0;
+  private epoch = 0;
+  private timers = new Set<ReturnType<typeof setTimeout>>();
+
+  constructor(private hooks: LaneHooks) {}
+
+  /** Jobs waiting or running, plus posts and actions waiting for the speech to end. */
+  get busy(): number {
+    return this.pending + this.timers.size;
+  }
+
+  /** True when `stop` has been called since `epoch` was read. Speech jobs check it between pieces. */
+  cancelled(epoch: number): boolean {
+    return epoch !== this.epoch;
+  }
+
+  currentEpoch(): number {
+    return this.epoch;
+  }
+
+  /** Queue a speech. `run` receives the epoch to pass to `cancelled`. Returns at once. */
+  speech(label: string, run: (epoch: number) => Promise<unknown>): Queued {
+    return this.add('speech', label, async epoch => {
+      await run(epoch);
+    });
+  }
+
+  /**
+   * Run `run` once the speech queued so far has been spoken to the end. When nothing is queued or playing it runs
+   * now and its own result is returned; otherwise the call returns {queued: true} and a failure becomes a notice.
+   */
+  async afterSpeech<T>(label: string, run: () => Promise<T>, kind: Kind = 'post'): Promise<T | Queued> {
+    if (this.pending === 0 && this.timers.size === 0) {
+      const wait = await this.safeWait();
+      if (wait <= 0 && this.pending === 0 && this.timers.size === 0) return run();
+    }
+    return this.add(kind, label, async epoch => {
+      const wait = await this.safeWait();
+      if (wait <= 0) {
+        await run();
+        return;
+      }
+      const timer = setTimeout(() => {
+        this.timers.delete(timer);
+        if (epoch !== this.epoch) return;
+        run().catch(error => this.fail(label, error));
+      }, wait);
+      this.timers.add(timer);
+    });
+  }
+
+  /** Empty the lane: planned lines no longer fit. Returns how many jobs were dropped. */
+  clear(): number {
+    const dropped = this.pending + this.timers.size;
+    this.epoch++;
+    for (const timer of this.timers) clearTimeout(timer);
+    this.timers.clear();
+    return dropped;
+  }
+
+  /** Resolves when every job queued so far has been handled (generated or scheduled). For tests. */
+  idle(): Promise<void> {
+    return this.tail;
+  }
+
+  private add(kind: Kind, label: string, job: (epoch: number) => Promise<void>): Queued {
+    const epoch = this.epoch;
+    const position = this.pending + this.timers.size + 1;
+    this.pending++;
+    this.tail = this.tail.then(async () => {
+      try {
+        if (epoch !== this.epoch) return; // dropped by a stop
+        await job(epoch);
+      } catch (error) {
+        this.fail(label, error);
+      } finally {
+        this.pending--;
+      }
+    });
+    return { queued: true, position, ...(position > 1 ? { note: `${kind} comes after ${position - 1} earlier item(s) of the table queue` } : {}) };
+  }
+
+  private async safeWait(): Promise<number> {
+    try {
+      const wait = await this.hooks.untilSpeechEnds();
+      return Number.isFinite(wait) ? wait : 0;
+    } catch {
+      return 0;
+    }
+  }
+
+  private fail(label: string, error: unknown): void {
+    this.hooks.onFailure(`${label} failed: ${error instanceof Error ? error.message : String(error)}`);
+  }
+}

+/** manage-regions link: two regions joined by teleports, across scenes. Foundry is stubbed. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+
+const MODULE = 'foundry-mcp-bridge-scenes';
+
+function makeScene(id: string, name: string, failBehaviors = false) {
+  const behaviorCalls: Array<{ region: string; data: any[] }> = [];
+  const scene: any = {
+    id,
+    name,
+    width: 4000,
+    height: 3000,
+    padding: 0,
+    grid: { size: 100, distance: 5, units: 'ft' },
+    dimensions: { sceneX: 0, sceneY: 0, sceneWidth: 4000, sceneHeight: 3000 },
+    regions: { contents: [] as any[] },
+    behaviorCalls,
+    createEmbeddedDocuments: vi.fn(async (type: string, data: any[]) =>
+      data.map((d, i) => {
+        const regionId = `${id}-r${i}`;
+        return {
+          id: regionId,
+          uuid: `Scene.${id}.Region.${regionId}`,
+          name: d.name,
+          createEmbeddedDocuments: vi.fn(async (_t: string, b: any[]) => {
+            if (failBehaviors) throw new Error('behavior failed');
+            behaviorCalls.push({ region: regionId, data: b });
+            return b;
+          }),
+        };
+      })
+    ),
+    deleteEmbeddedDocuments: vi.fn(async () => []),
+  };
+  return scene;
+}
+
+function setup(options: { allow?: boolean; failSecond?: boolean } = {}) {
+  const a = makeScene('sa', 'Cragmaw Hideout');
+  const b = makeScene('sb', 'Goblin Trail', options.failSecond);
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('CONFIG', {
+    RegionBehavior: { dataModels: { modifyMovementCost: { schema: { fields: { difficulties: { fields: { walk: {} } } } } } } },
+  });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'GM' },
+    scenes: { contents: [a, b], viewed: a, current: a },
+    actors: { contents: [] },
+    settings: { get: (_m: string, key: string) => (key === 'allowWriteOperations' ? (options.allow ?? true) : undefined) },
+  });
+  return { da: new FoundryDataAccess(), a, b };
+}
+
+describe('manageRegions link', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('joins two scenes both ways', async () => {
+    const { da, a, b } = setup();
+    const r = await da.manageRegions({
+      action: 'link',
+      from: { scene: 'Cragmaw Hideout', rect: [2, 3, 2, 1], name: 'Cave mouth' },
+      to: { scene: 'sb', rect: [10, 10, 2, 2] },
+    });
+    expect(r).toMatchObject({
+      success: true,
+      twoWay: true,
+      from: { scene: { id: 'sa' }, region: { uuid: 'Scene.sa.Region.sa-r0', name: 'Cave mouth' } },
+      to: { scene: { id: 'sb' }, region: { uuid: 'Scene.sb.Region.sb-r0', name: 'To Cragmaw Hideout' } },
+    });
+    const [type, data] = a.createEmbeddedDocuments.mock.calls[0];
+    expect(type).toBe('Region');
+    expect(data[0]).toMatchObject({
+      name: 'Cave mouth',
+      color: '#bf5af2',
+      shapes: [{ type: 'rectangle', x: 200, y: 300, width: 200, height: 100 }],
+      flags: { [MODULE]: { sceneObjectsTool: true } },
+    });
+    expect(b.createEmbeddedDocuments.mock.calls[0][1][0].shapes[0]).toMatchObject({ x: 1000, y: 1000, width: 200, height: 200 });
+
+    expect(a.behaviorCalls).toHaveLength(1);
+    expect(a.behaviorCalls[0]!.data[0]).toMatchObject({
+      type: 'teleportToken',
+      name: 'Teleport to Goblin Trail',
+      system: { destinations: ['Scene.sb.Region.sb-r0'], placement: 'center' },
+    });
+    expect(b.behaviorCalls[0]!.data[0]).toMatchObject({
+      type: 'teleportToken',
+      name: 'Teleport to Cragmaw Hideout',
+      system: { destinations: ['Scene.sa.Region.sa-r0'] },
+    });
+  });
+
+  it('one way puts a teleport only on the first region', async () => {
+    const { da, a, b } = setup();
+    const r = await da.manageRegions({
+      action: 'link',
+      two_way: false,
+      placement: 'random',
+      choice: true,
+      from: { scene: 'sa', ellipse: [5, 5, 1, 1] },
+      to: { scene: 'sb', polygon: [[1, 1], [4, 1], [4, 4]] },
+    });
+    expect(r.twoWay).toBe(false);
+    expect(a.behaviorCalls[0]!.data[0].system).toMatchObject({ placement: 'random', choice: true });
+    expect(b.behaviorCalls).toHaveLength(0);
+  });
+
+  it('links two spots of the same scene and names them', async () => {
+    const { da, a } = setup();
+    await da.manageRegions({ action: 'link', from: { scene: 'sa', rect: [1, 1, 1, 1] }, to: { scene: 'sa', rect: [8, 8, 1, 1] } });
+    const names = a.createEmbeddedDocuments.mock.calls.map((c: any) => c[1][0].name);
+    expect(names).toEqual(['Teleport A', 'Teleport B']);
+    const named = setup();
+    await named.da.manageRegions({ action: 'link', name: 'Stairs', from: { scene: 'sa', rect: [1, 1, 1, 1] }, to: { scene: 'sb', rect: [1, 1, 1, 1] } });
+    expect(named.a.createEmbeddedDocuments.mock.calls[0][1][0].name).toBe('Stairs (A)');
+    expect(named.b.createEmbeddedDocuments.mock.calls[0][1][0].name).toBe('Stairs (B)');
+  });
+
+  it('removes what it made when a step fails', async () => {
+    const { da, a, b } = setup({ failSecond: true });
+    await expect(
+      da.manageRegions({ action: 'link', from: { scene: 'sa', rect: [1, 1, 1, 1] }, to: { scene: 'sb', rect: [1, 1, 1, 1] } })
+    ).rejects.toThrow('behavior failed');
+    expect(a.deleteEmbeddedDocuments).toHaveBeenCalledWith('Region', ['sa-r0']);
+    expect(b.deleteEmbeddedDocuments).toHaveBeenCalledWith('Region', ['sb-r0']);
+  });
+
+  it('checks the input and the write gate', async () => {
+    const { da, a } = setup();
+    await expect(da.manageRegions({ action: 'link', from: { scene: 'sa', rect: [1, 1, 1, 1] } })).rejects.toThrow('needs from and to');
+    await expect(
+      da.manageRegions({ action: 'link', from: { scene: 'sa', rect: [1, 1, 1, 1] }, to: { scene: 'sb', rect: [99, 99, 5, 5] } })
+    ).rejects.toThrow('outside the scene');
+    await expect(
+      da.manageRegions({ action: 'link', from: { scene: 'sa', rect: [1, 1, 1, 1] }, to: { scene: 'nope', rect: [1, 1, 1, 1] } })
+    ).rejects.toThrow('Scene not found');
+    await expect(
+      da.manageRegions({ action: 'link', placement: 'up' as any, from: { scene: 'sa', rect: [1, 1, 1, 1] }, to: { scene: 'sb', rect: [1, 1, 1, 1] } })
+    ).rejects.toThrow('placement');
+    expect(a.createEmbeddedDocuments).not.toHaveBeenCalled();
+    const off = setup({ allow: false });
+    await expect(
+      off.da.manageRegions({ action: 'link', from: { scene: 'sa', rect: [1, 1, 1, 1] }, to: { scene: 'sb', rect: [1, 1, 1, 1] } })
+    ).rejects.toThrow();
+  });
+});

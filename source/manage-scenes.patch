+/** Picking the objects a reveal or hide request means, from plain descriptions of what is on a scene. */
+
+export const REVEAL_KINDS = ['token', 'light', 'tile', 'sound', 'drawing', 'door'] as const;
+export type RevealKind = (typeof REVEAL_KINDS)[number];
+
+export interface RevealTarget {
+  kind: RevealKind;
+  id?: string;
+  /** token: token or actor name; others: not used */
+  name?: string;
+  /** a position in grid squares, with how close an object has to be (default 1 square) */
+  x?: number;
+  y?: number;
+  radius?: number;
+  /** every object of this kind */
+  all?: boolean;
+}
+
+export interface SceneThing {
+  kind: RevealKind;
+  id: string;
+  name?: string;
+  actorName?: string;
+  /** position in grid squares (a wall: its middle) */
+  x: number;
+  y: number;
+  /** hidden (tokens, lights...) or a secret door */
+  hidden: boolean;
+}
+
+export function checkTarget(target: RevealTarget): string | null {
+  if (!REVEAL_KINDS.includes(target?.kind)) return `kind must be one of: ${REVEAL_KINDS.join(', ')}`;
+  const hasPos = target.x !== undefined || target.y !== undefined;
+  if (hasPos && (typeof target.x !== 'number' || typeof target.y !== 'number')) return 'give both x and y';
+  if (target.radius !== undefined && !(typeof target.radius === 'number' && target.radius >= 0 && target.radius <= 100)) return 'radius must be from 0 to 100 squares';
+  if (!target.id && !target.name && !hasPos && !target.all) return `a ${target.kind} target needs id, name, x and y, or all:true`;
+  if (target.name && target.kind !== 'token') return 'name only works for tokens (use id, x and y, or all for other kinds)';
+  return null;
+}
+
+/** The things of one kind that a target means, by id, name, closeness to a point, or all. */
+export function selectTargets(things: SceneThing[], target: RevealTarget): SceneThing[] {
+  let list = things.filter(t => t.kind === target.kind);
+  if (target.id) return list.filter(t => t.id === target.id);
+  if (target.name) {
+    const wanted = target.name.trim().toLowerCase();
+    const exact = list.filter(t => (t.name ?? '').toLowerCase() === wanted || (t.actorName ?? '').toLowerCase() === wanted);
+    list = exact.length > 0 ? exact : list.filter(t => (t.name ?? '').toLowerCase().includes(wanted) || (t.actorName ?? '').toLowerCase().includes(wanted));
+  }
+  if (target.x !== undefined && target.y !== undefined) {
+    const radius = target.radius ?? 1;
+    list = list.filter(t => Math.hypot(t.x - target.x!, t.y - target.y!) <= radius);
+  }
+  return list;
+}
+
+/** What to write so an object is revealed (hidden false, a secret door a normal door) or hidden. */
+export function revealPatch(kind: RevealKind, id: string, reveal: boolean): Record<string, any> {
+  if (kind === 'door') return { _id: id, door: reveal ? 1 : 2 };
+  return { _id: id, hidden: !reveal };
+}

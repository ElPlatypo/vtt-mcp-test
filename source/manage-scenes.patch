diff --git a/packages/mcp-server/src/tools/inspect.ts b/packages/mcp-server/src/tools/inspect.ts
new file mode 100644
index 0000000..8048ab0
--- /dev/null
+++ b/packages/mcp-server/src/tools/inspect.ts
@@ -0,0 +1,142 @@
+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+
+export interface InspectToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+const TYPES = [
+  'Actor',
+  'Item',
+  'Scene',
+  'JournalEntry',
+  'RollTable',
+  'Macro',
+  'Playlist',
+  'Cards',
+  'Folder',
+  'Combat',
+  'ChatMessage',
+] as const;
+
+const inspectSchema = z
+  .object({
+    action: z.enum(['list', 'get', 'schema']),
+    type: z
+      .string()
+      .regex(/^[A-Za-z]+$/)
+      .optional(),
+    identifier: z.string().min(1).optional(),
+    uuid: z.string().min(1).optional(),
+    embedded_type: z
+      .string()
+      .regex(/^[A-Za-z]+$/)
+      .optional(),
+    embedded_identifier: z.string().min(1).optional(),
+    path: z.string().min(1).optional(),
+    depth: z.number().int().min(1).max(12).optional(),
+    max_chars: z.number().int().min(500).max(100000).optional(),
+    include_embedded: z.boolean().optional(),
+    search: z.string().min(1).optional(),
+    limit: z.number().int().min(1).max(500).optional(),
+  })
+  .strict();
+
+export class InspectTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: InspectToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'InspectTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'inspect-document',
+        description:
+          'Read-only look at the raw data in the Foundry world, to check exact field names and values instead of guessing. Never changes anything. ' +
+          `list: documents of a type (${TYPES.join(', ')}), with optional search text. ` +
+          'get: one document\'s data as JSON, by type + identifier (id or exact name) or by uuid (also works for compendium entries). Embedded collections (a scene\'s tokens and walls, an actor\'s items) are summarised as counts unless include_embedded is true; to read them, pass embedded_type (e.g. "Token", "Wall", "Item") to list them and embedded_identifier to read one. ' +
+          'path reads one part (e.g. "system.attributes.hp" or "levels.0"); depth limits nesting (default 5, deeper levels shown as placeholders); max_chars caps the output (default 20000, up to 100000). ' +
+          'schema: the fields a document type has, with kinds (StringField, NumberField, ...), whether required, and allowed choices; type or embedded_type is a name as in Foundry CONFIG, e.g. "Scene", "Wall" or "Region". Use schema before writing data for a type you have not used before.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: { type: 'string', enum: ['list', 'get', 'schema'] },
+            type: {
+              type: 'string',
+              description: `Document type: ${TYPES.join(', ')} (schema also accepts embedded names such as Wall)`,
+            },
+            identifier: { type: 'string', description: 'get: document id or exact name' },
+            uuid: {
+              type: 'string',
+              description: 'get: a Foundry uuid, instead of type and identifier',
+            },
+            embedded_type: {
+              type: 'string',
+              description:
+                'get: list the embedded documents of this type (Token, Wall, Item, JournalEntryPage, ...); schema: describe this embedded type',
+            },
+            embedded_identifier: {
+              type: 'string',
+              description: 'get: id or exact name of one embedded document',
+            },
+            path: { type: 'string', description: 'get: dotted path to read part of the data' },
+            depth: {
+              type: 'number',
+              description:
+                'get: nesting depth to show (default 5); schema: field levels (default 3, max 6)',
+            },
+            max_chars: {
+              type: 'number',
+              description: 'get: cap on output size (500 to 100000, default 20000)',
+            },
+            include_embedded: {
+              type: 'boolean',
+              description: 'get: include embedded documents instead of counts',
+            },
+            search: { type: 'string', description: 'list: only names containing this text' },
+            limit: {
+              type: 'number',
+              description: 'list: at most this many (default 100, max 500)',
+            },
+          },
+          required: ['action'],
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handleInspectDocument(args: any): Promise<any> {
+    const parsed = inspectSchema.parse(args);
+
+    if (parsed.action === 'list' && !parsed.type) {
+      throw new Error('list needs type');
+    }
+    if (parsed.action === 'get' && !parsed.uuid && !(parsed.type && parsed.identifier)) {
+      throw new Error('get needs type and identifier, or uuid');
+    }
+    if (parsed.action === 'schema' && !parsed.type && !parsed.embedded_type) {
+      throw new Error('schema needs type or embedded_type');
+    }
+
+    this.logger.info('Inspecting Foundry data', { action: parsed.action, type: parsed.type });
+    try {
+      const result = await this.foundryClient.query('foundry-mcp-bridge.inspect-document', parsed);
+      if (result?.success === false) {
+        throw new Error(result.error || 'Request was refused');
+      }
+      return result;
+    } catch (error) {
+      this.logger.error('Failed to inspect', error);
+      throw new Error(
+        `Failed to inspect: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+}

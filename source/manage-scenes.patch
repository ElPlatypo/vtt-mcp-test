+/**
+ * Looking at a layout as data: where the floor is, what is connected, where a creature or a
+ * light can go, and how well a generated picture lines up with the sketch. Pure functions on a
+ * NormalizedLayout, so they are easy to test; layout.ts wires them to the tool.
+ */
+
+import type { DecodedImage } from './layout-image.js';
+import { FILLS, scanPolygon, shapePolygons, type LayoutShape, type NormalizedLayout } from './layout-utils.js';
+
+/** Samples per square when rasterizing (thin half-square walls need at least 2). */
+export const SAMPLES = 4;
+
+const FILL_NAMES = Object.keys(FILLS);
+const ROCK = FILL_NAMES.indexOf('rock');
+const WATER = FILL_NAMES.indexOf('water');
+
+export interface Raster {
+  columns: number;
+  rows: number;
+  /** Fill index (into FILLS) per sample. */
+  fill: Uint8Array;
+  /** Index of the shape (position in layout.shapes + 1) that painted the sample, 0 = background. */
+  owner: Uint16Array;
+  /** Samples a door opens through a thin wall. */
+  doorCut: Uint8Array;
+  w: number;
+  h: number;
+}
+
+export function rasterize(layout: NormalizedLayout): Raster {
+  const w = layout.columns * SAMPLES;
+  const h = layout.rows * SAMPLES;
+  const fill = new Uint8Array(w * h);
+  fill.fill(Math.max(0, FILL_NAMES.indexOf(layout.background)));
+  const owner = new Uint16Array(w * h);
+  const doorCut = new Uint8Array(w * h);
+  layout.shapes.forEach((shape, index) => {
+    if (shape.shape === 'door') {
+      const [x, y] = shape.at as [number, number];
+      const len = Math.max(1, shape.size ?? 1);
+      const x0 = shape.dir === 'v' ? x - 0.5 : x;
+      const x1 = shape.dir === 'v' ? x + 0.5 : x + len;
+      const y0 = shape.dir === 'v' ? y : y - 0.5;
+      const y1 = shape.dir === 'v' ? y + len : y + 0.5;
+      for (let j = Math.max(0, Math.floor(y0 * SAMPLES)); j < Math.min(h, Math.ceil(y1 * SAMPLES)); j++) {
+        for (let i = Math.max(0, Math.floor(x0 * SAMPLES)); i < Math.min(w, Math.ceil(x1 * SAMPLES)); i++) {
+          doorCut[j * w + i] = 1;
+        }
+      }
+      return;
+    }
+    const value = Math.max(0, FILL_NAMES.indexOf(shape.fill ?? 'floor'));
+    for (const poly of shapePolygons(shape, SAMPLES)) {
+      scanPolygon(poly, w, h, (y, x0, x1) => {
+        fill.fill(value, y * w + x0, y * w + x1 + 1);
+        owner.fill(index + 1, y * w + x0, y * w + x1 + 1);
+      });
+    }
+  });
+  return { columns: layout.columns, rows: layout.rows, fill, owner, doorCut, w, h };
+}
+
+function sampleIndex(r: Raster, x: number, y: number): number {
+  const i = Math.min(r.w - 1, Math.max(0, Math.floor(x * SAMPLES)));
+  const j = Math.min(r.h - 1, Math.max(0, Math.floor(y * SAMPLES)));
+  return j * r.w + i;
+}
+
+export function insideLayout(r: Raster, x: number, y: number): boolean {
+  return x >= 0 && y >= 0 && x < r.columns && y < r.rows;
+}
+
+/** The fill name at a point in squares ("rock" outside the layout). */
+export function fillAt(r: Raster, x: number, y: number): string {
+  if (!insideLayout(r, x, y)) return 'rock';
+  return FILL_NAMES[r.fill[sampleIndex(r, x, y)]!]!;
+}
+
+export function isOpenAt(r: Raster, x: number, y: number): boolean {
+  return insideLayout(r, x, y) && r.fill[sampleIndex(r, x, y)] !== ROCK;
+}
+
+/** Floor a creature can stand on: not rock and not deep water. */
+export function isStandAt(r: Raster, x: number, y: number): boolean {
+  if (!insideLayout(r, x, y)) return false;
+  const v = r.fill[sampleIndex(r, x, y)]!;
+  return v !== ROCK && v !== WATER;
+}
+
+/** Index in layout.shapes of the shape that painted this point, or -1. */
+export function shapeIndexAt(r: Raster, x: number, y: number): number {
+  if (!insideLayout(r, x, y)) return -1;
+  return r.owner[sampleIndex(r, x, y)]! - 1;
+}
+
+export function shapeTitle(shape: LayoutShape | undefined): string {
+  if (!shape) return 'the background';
+  return shape.name ? `"${shape.name}" (shape ${shape.id})` : `shape ${shape.id}`;
+}
+
+// ===== Layout checks =====
+
+export interface AreaInfo {
+  squares: number;
+  /** A point inside the area, in squares. */
+  at: [number, number];
+  near: string;
+}
+
+export interface LayoutCheck {
+  errors: string[];
+  warnings: string[];
+  areas: AreaInfo[];
+}
+
+/** Separate open areas (rooms joined by a door count as one), biggest first. */
+export function openAreas(layout: NormalizedLayout, r: Raster): AreaInfo[] {
+  const seen = new Uint8Array(r.w * r.h);
+  const areas: Array<{ count: number; sx: number; sy: number; samples: number[] }> = [];
+  const stack: number[] = [];
+  const open = (idx: number) => r.fill[idx] !== ROCK || r.doorCut[idx] === 1;
+  for (let start = 0; start < r.w * r.h; start++) {
+    if (seen[start] || !open(start)) continue;
+    let count = 0;
+    let sx = 0;
+    let sy = 0;
+    stack.length = 0;
+    stack.push(start);
+    seen[start] = 1;
+    let kept: number[] = [];
+    while (stack.length > 0) {
+      const idx = stack.pop()!;
+      count++;
+      const i = idx % r.w;
+      const j = (idx - i) / r.w;
+      sx += i;
+      sy += j;
+      if (count % 37 === 0) kept.push(idx);
+      for (const n of [idx - 1, idx + 1, idx - r.w, idx + r.w]) {
+        if (n < 0 || n >= r.w * r.h) continue;
+        if ((n === idx - 1 && i === 0) || (n === idx + 1 && i === r.w - 1)) continue;
+        if (seen[n] || !open(n)) continue;
+        seen[n] = 1;
+        stack.push(n);
+      }
+    }
+    if (kept.length === 0) kept = [start];
+    areas.push({ count, sx: sx / count, sy: sy / count, samples: kept });
+  }
+  return areas
+    .map(a => {
+      // A point really inside the area, near its middle.
+      let best = a.samples[0]!;
+      let bestD = Infinity;
+      for (const idx of a.samples) {
+        const i = idx % r.w;
+        const j = (idx - i) / r.w;
+        const d = (i - a.sx) ** 2 + (j - a.sy) ** 2;
+        if (d < bestD) {
+          bestD = d;
+          best = idx;
+        }
+      }
+      const bi = best % r.w;
+      const bj = (best - bi) / r.w;
+      const at: [number, number] = [Math.round(((bi + 0.5) / SAMPLES) * 10) / 10, Math.round(((bj + 0.5) / SAMPLES) * 10) / 10];
+      const owner = layout.shapes[shapeIndexAt(r, at[0], at[1])];
+      return { squares: Math.round(a.count / (SAMPLES * SAMPLES)), at, near: shapeTitle(owner) };
+    })
+    .sort((a, b) => b.squares - a.squares);
+}
+
+export function checkLayout(layout: NormalizedLayout): LayoutCheck {
+  const r = rasterize(layout);
+  const errors: string[] = [];
+  const warnings: string[] = [];
+
+  if (layout.shapes.filter(s => s.shape !== 'door').length === 0) {
+    errors.push('The layout has no shapes yet');
+    return { errors, warnings, areas: [] };
+  }
+
+  // Connectivity: everything open should be one area (through doors).
+  const areas = openAreas(layout, r).filter(a => a.squares >= 2);
+  if (areas.length > 1) {
+    const main = areas[0]!;
+    for (const a of areas.slice(1)) {
+      warnings.push(
+        `Open area of about ${a.squares} squares around ${a.at[0]},${a.at[1]} (${a.near}) is not connected to the main area of ${main.squares} squares (${main.near}): no corridor, door or overlap joins them`
+      );
+    }
+  }
+
+  // Doors: both sides must be open.
+  layout.shapes.forEach(shape => {
+    if (shape.shape !== 'door') return;
+    const [x, y] = shape.at as [number, number];
+    const len = Math.max(1, shape.size ?? 1);
+    // Look at points along the whole door: both sides must be open somewhere along it.
+    const n = Math.max(1, Math.round(len * 4));
+    const sideOpen = (px: number, py: number, sign: number) =>
+      [0.5, 0.75, 1, 1.25].some(d => isOpenAt(r, shape.dir === 'v' ? px + sign * d : px, shape.dir === 'v' ? py : py + sign * d));
+    let both = 0;
+    let anyA = false;
+    let anyB = false;
+    for (let i = 0; i < n; i++) {
+      const t = ((i + 0.5) / n) * len;
+      const px = shape.dir === 'v' ? x : x + t;
+      const py = shape.dir === 'v' ? y + t : y;
+      const a = sideOpen(px, py, -1);
+      const b = sideOpen(px, py, 1);
+      anyA ||= a;
+      anyB ||= b;
+      if (a && b) both++;
+    }
+    const title = `Door ${shape.id}${shape.name ? ` "${shape.name}"` : ''} at ${x},${y}`;
+    if (both === 0) {
+      errors.push(
+        `${title} has ${!anyA && !anyB ? 'rock on both sides' : `rock on its ${!anyA ? (shape.dir === 'v' ? 'west' : 'north') : shape.dir === 'v' ? 'east' : 'south'} side`}: it connects nothing`
+      );
+    } else if (both / n < 0.6) {
+      warnings.push(`${title} is only partly over an opening (${both} of ${n} quarter-squares join two open areas); move it so it sits on the opening`);
+    }
+  });
+
+  // Shapes outside the layout.
+  layout.shapes.forEach(shape => {
+    if (shape.shape === 'door') return;
+    let any = false;
+    for (const poly of shapePolygons(shape, 1)) {
+      if (poly.some(([px, py]) => px >= 0 && py >= 0 && px <= layout.columns && py <= layout.rows)) any = true;
+    }
+    if (!any) warnings.push(`${shapeTitle(shape)} lies completely outside the layout`);
+  });
+
+  return { errors, warnings, areas };
+}
+
+// ===== Checking what is on a scene =====
+
+export interface SceneToken {
+  name: string;
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+  hidden?: boolean;
+}
+export interface ScenePoint {
+  x: number;
+  y: number;
+  text?: string;
+  name?: string;
+}
+
+export function checkSceneObjects(
+  layout: NormalizedLayout,
+  objects: { tokens?: SceneToken[]; lights?: ScenePoint[]; notes?: ScenePoint[] }
+): string[] {
+  const r = rasterize(layout);
+  const problems: string[] = [];
+  const taken = new Map<string, string>();
+  for (const t of objects.tokens ?? []) {
+    const cx = t.x + t.width / 2;
+    const cy = t.y + t.height / 2;
+    const where = `${Math.round(t.x * 100) / 100},${Math.round(t.y * 100) / 100}`;
+    if (!insideLayout(r, cx, cy)) {
+      problems.push(`Token "${t.name}" at ${where} is outside the map`);
+      continue;
+    }
+    const fill = fillAt(r, cx, cy);
+    if (fill === 'rock') problems.push(`Token "${t.name}" at ${where} stands on solid rock`);
+    else if (fill === 'water') problems.push(`Token "${t.name}" at ${where} is in water (fine for a stream, check it is meant)`);
+    else {
+      // Is a wall between the token's square and the nearest open floor? Only flag tokens wedged
+      // into a corner of a thin wall: the centre must be open, which it is, so nothing more here.
+    }
+    const key = `${Math.floor(t.x)},${Math.floor(t.y)}`;
+    const other = taken.get(key);
+    if (other) problems.push(`Tokens "${other}" and "${t.name}" are on the same square (${key})`);
+    else taken.set(key, t.name);
+  }
+  for (const l of objects.lights ?? []) {
+    const near = [0, 0.5, 1].some(d => [[0, 0], [d, 0], [-d, 0], [0, d], [0, -d]].some(([dx, dy]) => isOpenAt(r, l.x + dx!, l.y + dy!)));
+    if (!near) problems.push(`Light at ${l.x},${l.y} is deep inside solid rock`);
+  }
+  for (const n of objects.notes ?? []) {
+    if (!isOpenAt(r, n.x, n.y)) problems.push(`Pin "${n.text ?? ''}" at ${n.x},${n.y} sits on solid rock`);
+  }
+  return problems;
+}
+
+// ===== Picking positions =====
+
+export interface CellPick {
+  /** Top-left square of the footprint. */
+  x: number;
+  y: number;
+}
+
+/** Find a shape by id, label number or name (exact, then partial). */
+export function resolveShape(layout: NormalizedLayout, ref: number | string): { shape: LayoutShape; index: number } {
+  const shapes = layout.shapes;
+  const non = (s: LayoutShape) => s.shape !== 'door';
+  const byId = (id: number) => shapes.findIndex(s => s.id === id && non(s));
+  if (typeof ref === 'number') {
+    let i = byId(ref);
+    if (i < 0) i = shapes.findIndex(s => s.label === ref && non(s));
+    if (i < 0) throw new Error(`No shape with id or label ${ref}`);
+    return { shape: shapes[i]!, index: i };
+  }
+  const text = ref.trim().toLowerCase();
+  if (/^\d+$/.test(text)) return resolveShape(layout, Number(text));
+  const named = shapes.map((s, i) => ({ s, i })).filter(({ s }) => non(s) && s.name);
+  const exact = named.filter(({ s }) => s.name!.toLowerCase() === text);
+  const partial = named.filter(({ s }) => s.name!.toLowerCase().includes(text));
+  const pool = exact.length > 0 ? exact : partial;
+  if (pool.length === 0) throw new Error(`No shape named "${ref}"; name shapes when you add them, or use the id`);
+  if (pool.length > 1) {
+    throw new Error(`"${ref}" matches several shapes (${pool.map(({ s }) => `${s.id} "${s.name}"`).join(', ')}); use the id`);
+  }
+  return { shape: pool[0]!.s, index: pool[0]!.i };
+}
+
+/** Distance (in squares, 8-neighbour) from each cell to the nearest square one cannot stand on. */
+function edgeDistance(r: Raster): Uint8Array {
+  const { columns, rows } = r;
+  const dist = new Uint8Array(columns * rows);
+  const standCell = (c: number, row: number) => isStandAt(r, c + 0.5, row + 0.5);
+  const queue: number[] = [];
+  const unset = 255;
+  dist.fill(unset);
+  for (let row = 0; row < rows; row++) {
+    for (let c = 0; c < columns; c++) {
+      if (!standCell(c, row)) {
+        dist[row * columns + c] = 0;
+        queue.push(row * columns + c);
+      }
+    }
+  }
+  for (let head = 0; head < queue.length; head++) {
+    const idx = queue[head]!;
+    const c = idx % columns;
+    const row = (idx - c) / columns;
+    for (let dy = -1; dy <= 1; dy++) {
+      for (let dx = -1; dx <= 1; dx++) {
+        if (!dx && !dy) continue;
+        const nc = c + dx;
+        const nr = row + dy;
+        if (nc < 0 || nr < 0 || nc >= columns || nr >= rows) continue;
+        const n = nr * columns + nc;
+        if (dist[n] !== unset) continue;
+        dist[n] = Math.min(254, dist[idx]! + 1);
+        queue.push(n);
+      }
+    }
+  }
+  // Squares next to the map edge count as next to a wall.
+  for (let row = 0; row < rows; row++) for (let c = 0; c < columns; c++) {
+    const edge = Math.min(c, row, columns - 1 - c, rows - 1 - row) + 1;
+    const idx = row * columns + c;
+    if (dist[idx]! > edge) dist[idx] = edge;
+  }
+  return dist;
+}
+
+export interface PickOptions {
+  /** Footprint in squares (default 1 x 1). */
+  width?: number;
+  height?: number;
+  /** Squares already taken, as "col,row". */
+  taken?: Set<string>;
+  /** Spread the picks out (default) or keep them together. */
+  spread?: boolean;
+}
+
+/**
+ * Choose `count` free spots inside a shape: away from walls where possible and, when spreading,
+ * as far from each other as possible. Deterministic.
+ */
+export function pickSpots(layout: NormalizedLayout, r: Raster, shapeIndex: number, count: number, options: PickOptions = {}): CellPick[] {
+  const fw = Math.max(1, Math.round(options.width ?? 1));
+  const fh = Math.max(1, Math.round(options.height ?? 1));
+  const dist = edgeDistance(r);
+  const taken = options.taken ?? new Set<string>();
+  const candidates: Array<{ c: number; row: number; d: number }> = [];
+  for (let row = 0; row + fh <= r.rows; row++) {
+    for (let c = 0; c + fw <= r.columns; c++) {
+      if (shapeIndexAt(r, c + 0.5, row + 0.5) !== shapeIndex) continue;
+      let ok = true;
+      let minD = 255;
+      for (let dy = 0; dy < fh && ok; dy++) {
+        for (let dx = 0; dx < fw && ok; dx++) {
+          if (!isStandAt(r, c + dx + 0.5, row + dy + 0.5) || taken.has(`${c + dx},${row + dy}`)) ok = false;
+          minD = Math.min(minD, dist[(row + dy) * r.columns + c + dx]!);
+        }
+      }
+      if (ok) candidates.push({ c, row, d: minD });
+    }
+  }
+  if (candidates.length === 0) throw new Error(`No free floor inside ${shapeTitle(layout.shapes[shapeIndex])} for a ${fw}x${fh} footprint`);
+  // Prefer squares away from walls (distance 2+), but use any when the room is tight.
+  const preferred = candidates.filter(c => c.d >= 2);
+  const pool = preferred.length >= count ? preferred : candidates;
+  if (pool.length < count) {
+    throw new Error(`${shapeTitle(layout.shapes[shapeIndex])} has room for only ${pool.length} of ${count}`);
+  }
+  const cx = pool.reduce((a, p) => a + p.c, 0) / pool.length;
+  const cy = pool.reduce((a, p) => a + p.row, 0) / pool.length;
+  const chosen: typeof pool = [];
+  const used = new Set<string>();
+  const anchors: Array<[number, number]> = [...taken].map(k => k.split(',').map(Number) as [number, number]);
+  const spread = options.spread !== false;
+  for (let n = 0; n < count; n++) {
+    let best: (typeof pool)[number] | undefined;
+    let bestScore = -Infinity;
+    for (const p of pool) {
+      const key = `${p.c},${p.row}`;
+      if (used.has(key)) continue;
+      // Footprints must not overlap earlier picks.
+      if (chosen.some(q => Math.abs(q.c - p.c) < fw && Math.abs(q.row - p.row) < fh)) continue;
+      let score: number;
+      if (chosen.length === 0) {
+        score = p.d * 4 - Math.hypot(p.c - cx, p.row - cy) * 0.3;
+      } else if (spread) {
+        let minDist = Infinity;
+        for (const q of chosen) minDist = Math.min(minDist, Math.hypot(q.c - p.c, q.row - p.row));
+        for (const [ax, ay] of anchors) minDist = Math.min(minDist, Math.hypot(ax - p.c, ay - p.row) * 1.5);
+        score = minDist * 3 + p.d;
+      } else {
+        score = -Math.hypot(chosen[0]!.c - p.c, chosen[0]!.row - p.row) * 3 + p.d;
+      }
+      if (score > bestScore) {
+        bestScore = score;
+        best = p;
+      }
+    }
+    if (!best) throw new Error(`No room for ${count} in ${shapeTitle(layout.shapes[shapeIndex])}`);
+    chosen.push(best);
+    used.add(`${best.c},${best.row}`);
+  }
+  return chosen.map(p => ({ x: p.c, y: p.row }));
+}
+
+// ===== Light proposals =====
+
+export interface LightProposal {
+  x: number;
+  y: number;
+  bright: number;
+  dim: number;
+  shape: string;
+}
+
+export function proposeLights(
+  layout: NormalizedLayout,
+  options: { minArea?: number; bright?: number; dim?: number; includeOutdoor?: boolean } = {}
+): LightProposal[] {
+  const r = rasterize(layout);
+  const minArea = options.minArea ?? 10;
+  const outdoor = new Set(['grass', 'road', 'sand']);
+  const out: LightProposal[] = [];
+  layout.shapes.forEach((shape, index) => {
+    if (shape.shape === 'door') return;
+    const fill = shape.fill ?? 'floor';
+    if (fill === 'rock' || fill === 'water') return;
+    if (!options.includeOutdoor && outdoor.has(fill)) return;
+    let cells = 0;
+    for (let row = 0; row < r.rows; row++) for (let c = 0; c < r.columns; c++) {
+      if (shapeIndexAt(r, c + 0.5, row + 0.5) === index) cells++;
+    }
+    if (cells < minArea) return;
+    const count = Math.max(1, Math.round(cells / 40));
+    const bright = options.bright ?? Math.max(2, Math.min(5, Math.round(Math.sqrt(cells) / 2)));
+    const dim = options.dim ?? bright * 2;
+    let spots: CellPick[];
+    try {
+      spots = pickSpots(layout, r, index, count, { spread: true });
+    } catch {
+      return;
+    }
+    for (const s of spots) {
+      const x = s.x + 0.5;
+      const y = s.y + 0.5;
+      if (out.some(o => Math.hypot(o.x - x, o.y - y) < Math.max(o.bright, bright) * 0.8)) continue;
+      out.push({ x, y, bright, dim, shape: shapeTitle(shape) });
+    }
+  });
+  return out;
+}
+
+// ===== Aligning a generated picture with the layout =====
+
+export interface AlignResult {
+  /** Move the layout's walls by this many squares to match the picture. */
+  shift: [number, number];
+  score: number;
+  scoreAtZero: number;
+  /** How strongly the picture follows the layout at all (about 0.3 or more is a clear match). */
+  quality: 'good' | 'weak' | 'none';
+}
+
+/** Brightness of the picture, averaged into SAMPLES x SAMPLES blocks per layout square. */
+export function brightnessGrid(image: DecodedImage, columns: number, rows: number): Float32Array {
+  const w = columns * SAMPLES;
+  const h = rows * SAMPLES;
+  const out = new Float32Array(w * h);
+  for (let j = 0; j < h; j++) {
+    const y0 = Math.floor((j * image.height) / h);
+    const y1 = Math.max(y0 + 1, Math.floor(((j + 1) * image.height) / h));
+    for (let i = 0; i < w; i++) {
+      const x0 = Math.floor((i * image.width) / w);
+      const x1 = Math.max(x0 + 1, Math.floor(((i + 1) * image.width) / w));
+      let sum = 0;
+      let n = 0;
+      for (let y = y0; y < y1; y += 2) {
+        for (let x = x0; x < x1; x += 2) {
+          const o = (y * image.width + x) * 4;
+          sum += 0.299 * image.data[o]! + 0.587 * image.data[o + 1]! + 0.114 * image.data[o + 2]!;
+          n++;
+        }
+      }
+      out[j * w + i] = n ? sum / n : 0;
+    }
+  }
+  return out;
+}
+
+export function alignToImage(layout: NormalizedLayout, image: DecodedImage, maxShift = 1.5): AlignResult {
+  const r = rasterize(layout);
+  const bright = brightnessGrid(image, layout.columns, layout.rows);
+  const mask = new Uint8Array(r.w * r.h);
+  // A dungeon is matched on everything that is not rock. A town, whose walls go round buildings and
+  // not floors, is matched on the buildings, which is what stands out against the ground.
+  const structure = layout.wallFills.length > 0 && !layout.wallFills.includes('floor');
+  const wanted = new Set(layout.wallFills.map(f => FILL_NAMES.indexOf(f)));
+  for (let k = 0; k < mask.length; k++) mask[k] = structure ? (wanted.has(r.fill[k]!) ? 1 : 0) : r.fill[k] === ROCK ? 0 : 1;
+  const n = Math.round(maxShift * SAMPLES);
+
+  const correlate = (sx: number, sy: number): number => {
+    // brightness(i, j) against mask(i - sx, j - sy)
+    let count = 0;
+    let sumB = 0;
+    let sumM = 0;
+    let sumBB = 0;
+    let sumMM = 0;
+    let sumBM = 0;
+    const jStart = Math.max(0, sy);
+    const jEnd = Math.min(r.h, r.h + sy);
+    const iStart = Math.max(0, sx);
+    const iEnd = Math.min(r.w, r.w + sx);
+    for (let j = jStart; j < jEnd; j++) {
+      for (let i = iStart; i < iEnd; i++) {
+        const b = bright[j * r.w + i]!;
+        const m = mask[(j - sy) * r.w + (i - sx)]!;
+        count++;
+        sumB += b;
+        sumM += m;
+        sumBB += b * b;
+        sumMM += m * m;
+        sumBM += b * m;
+      }
+    }
+    if (count === 0) return -1;
+    const cov = sumBM - (sumB * sumM) / count;
+    const varB = sumBB - (sumB * sumB) / count;
+    const varM = sumMM - (sumM * sumM) / count;
+    if (varB <= 1e-9 || varM <= 1e-9) return 0;
+    const c = cov / Math.sqrt(varB * varM);
+    // Roofs can be darker or lighter than the ground; what matters is that they line up.
+    return structure ? Math.abs(c) : c;
+  };
+
+  const scoreAtZero = correlate(0, 0);
+  let best = { sx: 0, sy: 0, score: scoreAtZero };
+  for (let sy = -n; sy <= n; sy++) {
+    for (let sx = -n; sx <= n; sx++) {
+      const score = correlate(sx, sy);
+      // Prefer no shift unless another is clearly better.
+      if (score > best.score + 0.01) best = { sx, sy, score };
+    }
+  }
+  const round = (v: number) => Math.round(v * 1000) / 1000;
+  return {
+    shift: [best.sx / SAMPLES, best.sy / SAMPLES],
+    score: round(best.score),
+    scoreAtZero: round(scoreAtZero),
+    quality: best.score >= 0.35 ? 'good' : best.score >= 0.15 ? 'weak' : 'none',
+  };
+}

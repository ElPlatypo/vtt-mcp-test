@@ -0,0 +1,152 @@
+import { describe, expect, it, vi } from 'vitest';
+import { CampaignMemoryTools, buildThreads, escapeHtml, listItems, parseThreads, plain, sections } from './campaign-memory.js';
+
+/** A journal store that behaves like manage-journals: describe, create, update (upsert by page name). */
+function fakeFoundry() {
+  const journals = new Map<string, { id: string; name: string; pages: Array<{ id: string; name: string; content: string }> }>();
+  const calls: any[] = [];
+  const query = vi.fn(async (method: string, data: any) => {
+    calls.push({ method, data });
+    if (data.action === 'describe') {
+      const j = [...journals.values()].find(x => x.id === data.journal || x.name === data.journal);
+      if (!j) throw new Error('Journal not found: "' + data.journal + '"');
+      return { success: true, journal: { id: j.id, name: j.name, pages: j.pages.map(p => ({ ...p, type: 'text' })) } };
+    }
+    if (data.action === 'create') {
+      const j = { id: 'j' + (journals.size + 1), name: data.name, pages: data.pages.map((p: any, i: number) => ({ id: 'p' + i, name: p.name, content: p.content })) };
+      journals.set(j.id, j);
+      return { success: true, journal: { id: j.id } };
+    }
+    const j = [...journals.values()].find(x => x.id === data.journal || x.name === data.journal)!;
+    for (const p of data.pages) {
+      const existing = j.pages.find(x => x.name === p.name);
+      if (existing) existing.content = p.content;
+      else j.pages.push({ id: 'p' + j.pages.length, name: p.name, content: p.content });
+    }
+    return { success: true };
+  });
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  const tools = new CampaignMemoryTools({ foundryClient: { query } as any, logger });
+  const page = (name: string) => [...journals.values()][0]!.pages.find(p => p.name === name)!.content;
+  return { tools, query, calls, page, journals };
+}
+
+describe('html helpers', () => {
+  it('reads and writes lists, threads and sections', () => {
+    expect(escapeHtml('a <b> & c')).toBe('a &lt;b&gt; &amp; c');
+    expect(plain('<p>Met @UUID[Actor.x]{Sildar} &amp; left</p><p>Next</p>')).toBe('Met Sildar & left\nNext');
+    expect(listItems('<ul><li>one</li><li><p>two</p></li></ul>')).toEqual(['one', 'two']);
+    expect(parseThreads(buildThreads(['a', 'b'], ['c']))).toEqual({ open: ['a', 'b'], closed: ['c'] });
+    expect(sections('<h2>S1</h2><p>x</p><h2>S2</h2><p>y</p>', 2)).toEqual([
+      { heading: 'S1', body: '<p>x</p>' },
+      { heading: 'S2', body: '<p>y</p>' },
+    ]);
+  });
+});
+
+describe('campaign-memory', () => {
+  it('is exposed with action required', () => {
+    const def = fakeFoundry().tools.getToolDefinitions()[0]!;
+    expect(def.name).toBe('campaign-memory');
+    expect(def.inputSchema.required).toEqual(['action']);
+  });
+
+  it('creates the GM-only journal with its pages on first use', async () => {
+    const { tools, calls, journals } = fakeFoundry();
+    const r = await tools.handle({ action: 'brief' });
+    const create = calls.find(c => c.data.action === 'create')!;
+    expect(create.data).toMatchObject({ name: 'Campaign Memory', ownership: 'none' });
+    expect(create.data.pages.map((p: any) => p.name)).toEqual(['Session Log', 'Open Threads', 'Player Knowledge', 'NPC Notes', 'Next Session']);
+    expect(journals.size).toBe(1);
+    expect(r).toMatchObject({ success: true, openThreads: [], sessionsLogged: 0, next: '' });
+  });
+
+  it('logs a session in one update and reads it back in the brief', async () => {
+    const { tools, calls, page } = fakeFoundry();
+    const r = await tools.handle({
+      action: 'log',
+      summary: 'The party ambushed the goblins & found Sildar.',
+      date: '14 Mirtul',
+      opened: ['Find Gundren Rockseeker', 'Deliver the supplies to Barthen'],
+      knowledge: ['Gundren was taken to Cragmaw Castle'],
+      npcs: [{ name: 'Sildar Hallwinter', note: 'Grateful, wants to go to Phandalin' }],
+      next: 'Goblin hideout\nBandit leader Klarg',
+    });
+    expect(r).toMatchObject({ success: true, session: 'Session 1', threads: { opened: 2, closed: [] }, knowledge: 1, npcs: ['Sildar Hallwinter'], next: true });
+    expect(calls.filter(c => c.data.action === 'update')).toHaveLength(1);
+    expect(page('Session Log')).toContain('<h2>Session 1 (14 Mirtul)</h2><p>The party ambushed the goblins &amp; found Sildar.</p>');
+    expect(page('Next Session')).toBe('<p>Goblin hideout</p><p>Bandit leader Klarg</p>');
+
+    const brief = await tools.handle({ action: 'brief' });
+    expect(brief.openThreads).toEqual(['Find Gundren Rockseeker', 'Deliver the supplies to Barthen']);
+    expect(brief.lastSessions).toEqual([{ title: 'Session 1 (14 Mirtul)', text: 'The party ambushed the goblins & found Sildar.' }]);
+    expect(brief.npcs).toEqual([{ name: 'Sildar Hallwinter', latest: '(Session 1) Grateful, wants to go to Phandalin', notes: 1 }]);
+    expect(brief.playersKnow).toEqual({ count: 1, latest: ['Gundren was taken to Cragmaw Castle'] });
+    expect((await tools.handle({ action: 'brief', knowledge: true })).playersKnow).toEqual(['Gundren was taken to Cragmaw Castle']);
+    expect(brief.next).toBe('Goblin hideout\nBandit leader Klarg');
+  });
+
+  it('numbers sessions, keeps only the last ones in the brief and adds to an existing NPC', async () => {
+    const { tools, page } = fakeFoundry();
+    await tools.handle({ action: 'log', summary: 'One', npcs: [{ name: 'Sildar', note: 'first' }] });
+    await tools.handle({ action: 'log', summary: 'Two' });
+    const r = await tools.handle({ action: 'log', summary: 'Three', npcs: [{ name: 'sildar', note: 'second' }] });
+    expect(r.session).toBe('Session 3');
+    expect(page('NPC Notes').match(/<h3>/g)).toHaveLength(1);
+    expect(page('NPC Notes')).toContain('<p>(Session 1) first</p><p>(Session 3) second</p>');
+    const brief = await tools.handle({ action: 'brief', sessions: 2 });
+    expect(brief.lastSessions.map((s: any) => s.text)).toEqual(['Two', 'Three']);
+    expect(brief.sessionsLogged).toBe(3);
+    const named = await tools.handle({ action: 'log', session: 7, summary: 'Seven' });
+    expect(named.session).toBe('Session 7');
+  });
+
+  it('closes threads by a few words, moves them to Closed and reports ones it did not find', async () => {
+    const { tools, page } = fakeFoundry();
+    await tools.handle({ action: 'log', summary: 'x', opened: ['Find Gundren Rockseeker', 'Deliver supplies'] });
+    const r = await tools.handle({ action: 'log', session: 2, closed: ['gundren', 'dragon'], opened: ['Visit the manor'] });
+    expect(r.threads).toEqual({ opened: 1, closed: ['Find Gundren Rockseeker'], notFound: ['dragon'] });
+    expect(parseThreads(page('Open Threads'))).toEqual({
+      open: ['Deliver supplies', 'Visit the manor'],
+      closed: ['Find Gundren Rockseeker (resolved Session 2)'],
+    });
+    const brief = await tools.handle({ action: 'brief' });
+    expect(brief.recentlyClosed).toEqual(['Find Gundren Rockseeker (resolved Session 2)']);
+  });
+
+  it('recalls matching lines across the pages and needs every word', async () => {
+    const { tools } = fakeFoundry();
+    await tools.handle({ action: 'log', summary: 'Sildar was rescued from the goblins', knowledge: ['Sildar works for the Lords Alliance'], npcs: [{ name: 'Klarg', note: 'Bugbear boss' }] });
+    const r = await tools.handle({ action: 'recall', query: 'sildar' });
+    expect(r.total).toBe(2);
+    expect(r.matches.map((m: any) => m.page).sort()).toEqual(['Player Knowledge', 'Session Log']);
+    expect((await tools.handle({ action: 'recall', query: 'sildar alliance' })).matches).toHaveLength(1);
+    expect((await tools.handle({ action: 'recall', query: 'dragon' })).total).toBe(0);
+  });
+
+  it('refuses empty logs and unknown fields, and repairs missing pages', async () => {
+    const { tools, journals, calls } = fakeFoundry();
+    await expect(tools.handle({ action: 'log' })).rejects.toThrow('Nothing to log');
+    await expect(tools.handle({ action: 'recall' })).rejects.toThrow();
+    await expect(tools.handle({ action: 'brief', purge: true })).rejects.toThrow();
+    const j = [...journals.values()][0]!;
+    j.pages = j.pages.filter(p => p.name !== 'NPC Notes');
+    calls.length = 0;
+    await tools.handle({ action: 'brief' });
+    expect(calls.some(c => c.data.action === 'update' && c.data.pages[0].name === 'NPC Notes')).toBe(true);
+  });
+
+  it('uses another journal name when given', async () => {
+    const { tools, journals } = fakeFoundry();
+    await tools.handle({ action: 'brief', journal: 'Waterdeep Memory' });
+    expect([...journals.values()][0]!.name).toBe('Waterdeep Memory');
+  });
+
+  it('passes on warnings and a refused request', async () => {
+    const { tools } = fakeFoundry();
+    const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+    const bad = new CampaignMemoryTools({ foundryClient: { query: async () => ({ success: false, error: 'GM only' }) } as any, logger });
+    await expect(bad.handle({ action: 'brief' })).rejects.toThrow('GM only');
+    await tools.handle({ action: 'brief' });
+  });
+});
diff --git a/packages/mcp-server/src/tools/campaign-memory.ts b/packages/mcp-server/src/tools/campaign-memory.ts
new file mode 100644
index 0000000..2185d13
--- /dev/null
+++ b/packages/mcp-server/src/tools/campaign-memory.ts
@@ -0,0 +1,289 @@
+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+
+export interface CampaignMemoryOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+export const MEMORY_PAGES = ['Session Log', 'Open Threads', 'Player Knowledge', 'NPC Notes', 'Next Session'] as const;
+const DEFAULT_JOURNAL = 'Campaign Memory';
+
+const text = z.string().min(1).max(2000);
+const schema = z.discriminatedUnion('action', [
+  z
+    .object({
+      action: z.literal('brief'),
+      journal: z.string().min(1).optional(),
+      sessions: z.number().int().min(1).max(5).optional(),
+      knowledge: z.boolean().optional(),
+    })
+    .strict(),
+  z
+    .object({
+      action: z.literal('log'),
+      journal: z.string().min(1).optional(),
+      session: z.union([z.string().min(1).max(60), z.number().int().min(0)]).optional(),
+      date: z.string().min(1).max(60).optional(),
+      summary: z.string().min(1).max(8000).optional(),
+      opened: z.array(text).max(30).optional(),
+      closed: z.array(text).max(30).optional(),
+      knowledge: z.array(text).max(30).optional(),
+      npcs: z.array(z.object({ name: z.string().min(1).max(100), note: text }).strict()).max(30).optional(),
+      next: z.string().min(1).max(8000).optional(),
+    })
+    .strict(),
+  z
+    .object({
+      action: z.literal('recall'),
+      journal: z.string().min(1).optional(),
+      query: z.string().min(1).max(200),
+    })
+    .strict(),
+]);
+
+// ---------- HTML helpers (exported for tests) ----------
+
+export function escapeHtml(value: string): string {
+  return value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
+}
+
+/** Plain text of some journal HTML; Foundry links become their label. */
+export function plain(html: string): string {
+  return html
+    .replace(/@UUID\[[^\]]*\]\{([^}]*)\}/g, '$1')
+    .replace(/<\/(p|li|h[1-6]|div)>/gi, '\n')
+    .replace(/<br\s*\/?>/gi, '\n')
+    .replace(/<[^>]*>/g, '')
+    .replace(/&lt;/g, '<')
+    .replace(/&gt;/g, '>')
+    .replace(/&quot;/g, '"')
+    .replace(/&#39;/g, "'")
+    .replace(/&amp;/g, '&')
+    .replace(/\n{2,}/g, '\n')
+    .trim();
+}
+
+export function listItems(html: string): string[] {
+  return [...html.matchAll(/<li[^>]*>([\s\S]*?)<\/li>/gi)].map(m => m[1]!.replace(/^\s*<p>([\s\S]*)<\/p>\s*$/i, '$1').trim());
+}
+
+const items = (list: string[]): string => `<ul>${list.map(i => `<li>${i}</li>`).join('')}</ul>`;
+
+/** Open Threads page: an Open list and a Closed list. */
+export function parseThreads(html: string): { open: string[]; closed: string[] } {
+  const split = html.split(/<h2[^>]*>\s*Closed\s*<\/h2>/i);
+  return { open: listItems(split[0] ?? ''), closed: listItems(split[1] ?? '') };
+}
+export function buildThreads(open: string[], closed: string[]): string {
+  return `<h2>Open</h2>${items(open)}<h2>Closed</h2>${items(closed)}`;
+}
+
+/** Sections that start with a heading of this level. */
+export function sections(html: string, level: 2 | 3): Array<{ heading: string; body: string }> {
+  const re = new RegExp(`<h${level}[^>]*>([\\s\\S]*?)<\\/h${level}>`, 'gi');
+  const marks = [...html.matchAll(re)];
+  return marks.map((m, i) => ({
+    heading: m[1]!.trim(),
+    body: html.slice(m.index! + m[0].length, i + 1 < marks.length ? marks[i + 1]!.index! : html.length).trim(),
+  }));
+}
+
+export function buildNpcs(list: Array<{ heading: string; body: string }>): string {
+  return list.map(s => `<h3>${s.heading}</h3>${s.body}`).join('');
+}
+
+const words = (query: string) => query.toLowerCase().split(/\s+/).filter(Boolean);
+
+// ---------- tool ----------
+
+interface MemoryPage {
+  id?: string;
+  name: string;
+  content: string;
+}
+
+export class CampaignMemoryTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: CampaignMemoryOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'CampaignMemoryTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'campaign-memory',
+        description:
+          `The campaign's long-term memory, kept in a GM-only journal (default "${DEFAULT_JOURNAL}", made on first use) with pages: ${MEMORY_PAGES.join(', ')}. You can read and edit it in Foundry. ` +
+          'action brief: one call that returns the open threads, the last sessions, NPC notes, the next-session notes and what the players know (knowledge:true for the full list; default just a count). Call it at the start of a session. ' +
+          'action log: records what happened in one call: session (number or label; default the next number), date, summary (added to the Session Log), opened (new open threads), closed (threads that were resolved, matched by a few words of their text; they move to Closed), knowledge (facts the players learned), npcs [{name, note}] (notes on an NPC, kept under their name), next (replaces the next-session prep notes). Give at least one of these. ' +
+          'action recall: query finds matching lines across all pages (every word must appear). ' +
+          'Text can contain {{actor: Name}}, {{scene: Name}}, {{journal: Name}} links.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: { type: 'string', enum: ['brief', 'log', 'recall'] },
+            journal: { type: 'string', description: `Memory journal name (default "${DEFAULT_JOURNAL}")` },
+            sessions: { type: 'number', description: 'brief: how many recent sessions to show (1 to 5, default 2)' },
+            knowledge: {
+              type: ['boolean', 'array'],
+              description: 'brief: true to list everything the players know. log: list of facts the players learned',
+              items: { type: 'string' },
+            },
+            session: { type: ['string', 'number'], description: 'log: session number or label' },
+            date: { type: 'string', description: 'log: date or in-world date for the entry' },
+            summary: { type: 'string', description: 'log: what happened' },
+            opened: { type: 'array', items: { type: 'string' }, description: 'log: new open threads' },
+            closed: { type: 'array', items: { type: 'string' }, description: 'log: resolved threads (a few words of the thread text)' },
+            npcs: {
+              type: 'array',
+              items: { type: 'object', properties: { name: { type: 'string' }, note: { type: 'string' } }, required: ['name', 'note'], additionalProperties: false },
+              description: 'log: notes on NPCs',
+            },
+            next: { type: 'string', description: 'log: notes for the next session (replaces the old ones)' },
+            query: { type: 'string', description: 'recall: words to look for' },
+          },
+          required: ['action'],
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  private async query(method: string, data: Record<string, any>): Promise<any> {
+    const result = await this.foundryClient.query(`foundry-mcp-bridge.${method}`, data);
+    if (result?.success === false) throw new Error(result.error || 'Request was refused');
+    return result;
+  }
+
+  /** Read the memory pages, creating the journal when it does not exist yet. */
+  private async load(name: string): Promise<{ id: string; pages: Map<string, MemoryPage> }> {
+    let described: any;
+    try {
+      described = await this.query('manage-journals', { action: 'describe', journal: name });
+    } catch (error) {
+      const message = error instanceof Error ? error.message : '';
+      if (!/not found/i.test(message)) throw error;
+      described = await this.query('manage-journals', {
+        action: 'create',
+        name,
+        ownership: 'none',
+        pages: MEMORY_PAGES.map(page => ({ name: page, content: '' })),
+      });
+      described = await this.query('manage-journals', { action: 'describe', journal: name });
+    }
+    const pages = new Map<string, MemoryPage>();
+    for (const p of (described?.journal?.pages ?? []) as any[]) {
+      pages.set(p.name, { id: p.id, name: p.name, content: p.content ?? '' });
+    }
+    const missing = MEMORY_PAGES.filter(p => !pages.has(p));
+    if (missing.length > 0) {
+      await this.query('manage-journals', { action: 'update', journal: name, pages: missing.map(p => ({ name: p, content: '' })) });
+      for (const p of missing) pages.set(p, { name: p, content: '' });
+    }
+    return { id: described.journal.id, pages };
+  }
+
+  async handle(args: unknown): Promise<any> {
+    const a = schema.parse(args ?? {});
+    const name = a.journal ?? DEFAULT_JOURNAL;
+    this.logger.info('Campaign memory', { action: a.action });
+    const { id, pages } = await this.load(name);
+    const page = (n: (typeof MEMORY_PAGES)[number]) => pages.get(n)!.content;
+
+    if (a.action === 'brief') {
+      const threads = parseThreads(page('Open Threads'));
+      const log = sections(page('Session Log'), 2);
+      const knowledge = listItems(page('Player Knowledge')).map(plain);
+      const npcs = sections(page('NPC Notes'), 3).map(s => {
+        const notes = s.body.match(/<p[^>]*>[\s\S]*?<\/p>/gi) ?? [];
+        return { name: plain(s.heading), latest: plain(notes[notes.length - 1] ?? '') , notes: notes.length };
+      });
+      return {
+        success: true,
+        journal: { id, name },
+        openThreads: threads.open.map(plain),
+        recentlyClosed: threads.closed.slice(-3).map(plain),
+        lastSessions: log.slice(-(a.sessions ?? 2)).map(s => ({ title: plain(s.heading), text: plain(s.body) })),
+        sessionsLogged: log.length,
+        npcs,
+        playersKnow: a.knowledge ? knowledge : { count: knowledge.length, latest: knowledge.slice(-3) },
+        next: plain(page('Next Session')),
+      };
+    }
+
+    if (a.action === 'recall') {
+      const wanted = words(a.query);
+      const found: Array<{ page: string; text: string }> = [];
+      for (const [pageName, p] of pages) {
+        const chunks = p.content.split(/<\/(?:p|li|h[1-6])>/i).map(plain).filter(Boolean);
+        for (const chunk of chunks) {
+          const lower = chunk.toLowerCase();
+          if (wanted.every(w => lower.includes(w))) found.push({ page: pageName, text: chunk });
+        }
+      }
+      return { success: true, query: a.query, matches: found.slice(0, 20), total: found.length };
+    }
+
+    // log
+    if (!a.summary && !a.opened?.length && !a.closed?.length && !a.knowledge?.length && !a.npcs?.length && !a.next) {
+      throw new Error('Nothing to log: give summary, opened, closed, knowledge, npcs or next');
+    }
+    const updates: MemoryPage[] = [];
+    const log = sections(page('Session Log'), 2);
+    const label = a.session !== undefined ? (typeof a.session === 'number' ? `Session ${a.session}` : a.session) : `Session ${log.length + 1}`;
+    const title = a.date ? `${label} (${a.date})` : label;
+    const done: Record<string, any> = { session: label };
+
+    if (a.summary) {
+      updates.push({ name: 'Session Log', content: `${page('Session Log')}<h2>${escapeHtml(title)}</h2><p>${escapeHtml(a.summary)}</p>` });
+    }
+    if (a.opened?.length || a.closed?.length) {
+      const threads = parseThreads(page('Open Threads'));
+      const matched: string[] = [];
+      const notFound: string[] = [];
+      for (const wanted of a.closed ?? []) {
+        const w = wanted.toLowerCase();
+        const at = threads.open.findIndex(t => plain(t).toLowerCase().includes(w) || w.includes(plain(t).toLowerCase()));
+        if (at < 0) {
+          notFound.push(wanted);
+          continue;
+        }
+        const [thread] = threads.open.splice(at, 1);
+        matched.push(plain(thread!));
+        threads.closed.push(`${thread} (resolved ${label})`);
+      }
+      for (const opened of a.opened ?? []) threads.open.push(escapeHtml(opened));
+      updates.push({ name: 'Open Threads', content: buildThreads(threads.open, threads.closed) });
+      done.threads = { opened: a.opened?.length ?? 0, closed: matched, ...(notFound.length ? { notFound } : {}) };
+    }
+    if (a.knowledge?.length) {
+      const known = listItems(page('Player Knowledge'));
+      known.push(...a.knowledge.map(k => escapeHtml(k)));
+      updates.push({ name: 'Player Knowledge', content: items(known) });
+      done.knowledge = a.knowledge.length;
+    }
+    if (a.npcs?.length) {
+      const list = sections(page('NPC Notes'), 3);
+      for (const npc of a.npcs) {
+        const entry = `<p>(${escapeHtml(label)}) ${escapeHtml(npc.note)}</p>`;
+        const at = list.find(s => plain(s.heading).toLowerCase() === npc.name.trim().toLowerCase());
+        if (at) at.body += entry;
+        else list.push({ heading: escapeHtml(npc.name.trim()), body: entry });
+      }
+      updates.push({ name: 'NPC Notes', content: buildNpcs(list) });
+      done.npcs = a.npcs.map(n => n.name);
+    }
+    if (a.next) {
+      updates.push({ name: 'Next Session', content: a.next.split(/\n+/).map(l => `<p>${escapeHtml(l)}</p>`).join('') });
+      done.next = true;
+    }
+
+    const result = await this.query('manage-journals', { action: 'update', journal: id, pages: updates });
+    return { success: true, journal: { id, name }, ...done, ...(result?.warnings?.length ? { warnings: result.warnings } : {}) };
+  }
+}

@@ -0,0 +1,65 @@
+/**
+ * Moving real items and coins between actors (a character's pack, a chest, a creature's loot). Pure helpers, so
+ * they can be tested without Foundry.
+ */
+
+export interface ItemLike {
+  id: string;
+  name: string;
+  type?: string;
+  system?: { quantity?: number };
+}
+
+/** The items asked for, by id or by name (exact, else part of a name), and the asks that matched nothing. */
+export function pickItems<T extends ItemLike>(items: T[], ids: string[] = [], names: string[] = []): { picked: T[]; notFound: string[] } {
+  const picked: T[] = [];
+  const notFound: string[] = [];
+  const add = (item: T) => {
+    if (!picked.includes(item)) picked.push(item);
+  };
+  for (const id of ids) {
+    const hit = items.find(i => i.id === id);
+    if (hit) add(hit);
+    else notFound.push(id);
+  }
+  for (const name of names) {
+    const key = name.trim().toLowerCase();
+    const exact = items.filter(i => i.name.toLowerCase() === key);
+    const matches = exact.length ? exact : items.filter(i => i.name.toLowerCase().includes(key));
+    if (matches.length === 0) notFound.push(name);
+    for (const m of matches) add(m);
+  }
+  return { picked, notFound };
+}
+
+/** How many of a stack move: all of it by default, never more than there is. */
+export function quantityToMove(have: number | undefined, wanted: number | undefined): { move: number; whole: boolean } {
+  const total = Math.max(1, Math.floor(Number(have ?? 1)) || 1);
+  const want = wanted === undefined ? total : Math.floor(Number(wanted));
+  if (!(want >= 1)) throw new Error('quantity must be a whole number of 1 or more');
+  const move = Math.min(total, want);
+  return { move, whole: move >= total };
+}
+
+export const COINS = ['pp', 'gp', 'ep', 'sp', 'cp'] as const;
+export type Coin = (typeof COINS)[number];
+export type Purse = Partial<Record<Coin, number>>;
+
+/** Move coins from one purse to another; refuses when the giver does not have enough of a coin. */
+export function moveCoins(from: Purse, to: Purse, amounts: Record<string, unknown>): { from: Purse; to: Purse; moved: Purse } {
+  const nextFrom: Purse = { ...from };
+  const nextTo: Purse = { ...to };
+  const moved: Purse = {};
+  for (const [key, raw] of Object.entries(amounts)) {
+    if (!(COINS as readonly string[]).includes(key)) throw new Error(`Unknown coin "${key}": use ${COINS.join(', ')}`);
+    const coin = key as Coin;
+    const amount = Math.floor(Number(raw));
+    if (!(amount > 0)) throw new Error(`${coin} must be a whole number above 0`);
+    const have = Number(nextFrom[coin] ?? 0);
+    if (have < amount) throw new Error(`Not enough ${coin}: ${have} available, ${amount} asked`);
+    nextFrom[coin] = have - amount;
+    nextTo[coin] = Number(nextTo[coin] ?? 0) + amount;
+    moved[coin] = amount;
+  }
+  return { from: nextFrom, to: nextTo, moved };
+}

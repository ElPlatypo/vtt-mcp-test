@@ -0,0 +1,72 @@
+/** move-token in grid squares, and get-token-details on any scene. Foundry is stubbed. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+
+function makeScene(id: string, name: string, tokenId: string) {
+  // Applies the change to the token it is called on, as Foundry would.
+  const update = vi.fn(async function (this: any, changes: any) {
+    Object.assign(this, changes);
+  });
+  const token = { id: tokenId, name: `Token ${tokenId}`, x: 5, y: 6, width: 1, height: 1, update, texture: { src: 'a.png' } };
+  return {
+    id,
+    name,
+    width: 1280,
+    height: 1280,
+    padding: 0.25,
+    grid: { size: 64, distance: 5, units: 'ft' },
+    dimensions: { sceneX: 320, sceneY: 320, sceneWidth: 1280, sceneHeight: 1280 },
+    tokens: new Map([[tokenId, token]]),
+    update,
+  };
+}
+
+function setup() {
+  const a = makeScene('sa', 'Trail', 'ta');
+  const b = makeScene('sb', 'Town', 'tb');
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'GM' },
+    scenes: { contents: [a, b], current: a, viewed: a },
+    settings: { get: (_m: string, key: string) => (key === 'allowWriteOperations' ? true : undefined) },
+  });
+  return { da: new FoundryDataAccess(), a, b };
+}
+
+describe('move-token in squares', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('converts squares to pixels with the padding offset', async () => {
+    const { da, b } = setup();
+    const r = await da.moveToken({ tokenId: 'tb', x: 11, y: 2.5, units: 'squares', animate: false });
+    expect(b.update).toHaveBeenCalledWith({ x: 320 + 11 * 64, y: 320 + 2.5 * 64 }, { animate: false });
+    expect(r).toMatchObject({ success: true, newPosition: { x: 1024, y: 480 }, newSquares: { x: 11, y: 2.5 }, scene: { id: 'sb', name: 'Town' } });
+  });
+  it('keeps pixels the default and refuses bad units and squares off the map', async () => {
+    const { da, b } = setup();
+    await da.moveToken({ tokenId: 'tb', x: 640, y: 640, animate: false });
+    expect(b.update).toHaveBeenCalledWith({ x: 640, y: 640 }, { animate: false });
+    await expect(da.moveToken({ tokenId: 'tb', x: 1, y: 1, units: 'feet' as any })).rejects.toThrow('units must be pixels or squares');
+    await expect(da.moveToken({ tokenId: 'tb', x: 21, y: 1, units: 'squares' })).rejects.toThrow('inside the map');
+    await expect(da.moveToken({ tokenId: 'tb', x: -1, y: 1, units: 'squares' })).rejects.toThrow('inside the map');
+  });
+});
+
+describe('get-token-details on any scene', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('finds a token on a scene that is not the current one', async () => {
+    const { da } = setup();
+    const r = await da.getTokenDetails({ tokenId: 'tb' });
+    expect(r).toMatchObject({ success: true, id: 'tb', name: 'Token tb' });
+  });
+  it('takes a scene and says where it looked', async () => {
+    const { da } = setup();
+    await expect(da.getTokenDetails({ tokenId: 'ta', scene: 'Town' })).rejects.toThrow('not found in scene "Town"');
+    await expect(da.getTokenDetails({ tokenId: 'zz' })).rejects.toThrow('not found in scene "Trail"');
+  });
+});

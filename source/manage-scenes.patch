index 0000000..cbd8013
--- /dev/null
+++ b/packages/foundry-module/src/journal-utils.ts
@@ -0,0 +1,99 @@
+/**
+ * Pure helpers for the manage-journals tool: ownership levels, a safety pass over HTML,
+ * and {{kind: Name}} link resolution. Kept free of Foundry globals so they can be tested.
+ */
+
+export type OwnershipName = 'none' | 'limited' | 'observer' | 'owner';
+
+/** Foundry's CONST.DOCUMENT_OWNERSHIP_LEVELS, by friendly name. */
+export const OWNERSHIP_LEVELS: Record<OwnershipName, number> = {
+  none: 0,
+  limited: 1,
+  observer: 2,
+  owner: 3,
+};
+
+export function ownershipName(level: unknown): OwnershipName | 'unknown' {
+  const found = (Object.keys(OWNERSHIP_LEVELS) as OwnershipName[]).find(
+    key => OWNERSHIP_LEVELS[key] === level
+  );
+  return found ?? 'unknown';
+}
+
+/**
+ * Remove the parts of an HTML string that can run code in a browser: script, iframe,
+ * object, embed, link, meta, base and form tags, inline event handlers (onclick=...)
+ * and javascript: or data:text/html URLs.
+ *
+ * This is defence in depth for text that comes from an AI or an imported document, not a
+ * full sanitiser: Foundry still renders journal text through its own handling.
+ */
+export function stripUnsafeHtml(html: string): string {
+  let out = html;
+  // Whole elements with content.
+  out = out.replace(
+    /<\s*(script|iframe|object|embed|form|noscript)\b[\s\S]*?<\s*\/\s*\1\s*>/gi,
+    ''
+  );
+  // Unclosed or void variants of the same and other dangerous tags.
+  out = out.replace(
+    /<\s*\/?\s*(script|iframe|object|embed|form|noscript|link|meta|base)\b[^>]*>/gi,
+    ''
+  );
+  // Inline event handlers: onclick="..." onerror='...' onload=...
+  out = out.replace(/\s+on[a-z]+\s*=\s*("[^"]*"|'[^']*'|[^\s>]+)/gi, '');
+  // Script-capable URLs in attributes.
+  out = out.replace(
+    /(\s(?:href|src|xlink:href|action|formaction)\s*=\s*)(["']?)\s*(?:javascript:|data:text\/html|vbscript:)[^"'\s>]*\2/gi,
+    '$1""'
+  );
+  return out;
+}
+
+export type LinkKind = 'actor' | 'scene' | 'journal' | 'item' | 'rolltable';
+
+const LINK_DOCUMENT: Record<LinkKind, string> = {
+  actor: 'Actor',
+  scene: 'Scene',
+  journal: 'JournalEntry',
+  item: 'Item',
+  rolltable: 'RollTable',
+};
+
+export type LinkLookup = (
+  kind: LinkKind,
+  name: string
+) => { id: string; name: string } | 'ambiguous' | null;
+
+/**
+ * Turn {{actor: Sildar Hallwinter}} or {{scene: Cragmaw Cave | the cave}} into Foundry's
+ * @UUID[Actor.<id>]{label} link. A name that cannot be resolved (or matches several
+ * documents) is left as its plain label and reported in warnings.
+ */
+export function resolveContentLinks(
+  html: string,
+  lookup: LinkLookup
+): { html: string; warnings: string[] } {
+  const warnings: string[] = [];
+  const out = html.replace(
+    /\{\{\s*(actor|scene|journal|item|rolltable)\s*:\s*([^}|]+?)\s*(?:\|\s*([^}]+?)\s*)?\}\}/gi,
+    (_match, rawKind: string, rawName: string, rawLabel?: string) => {
+      const kind = rawKind.toLowerCase() as LinkKind;
+      const name = rawName.trim();
+      const label = (rawLabel ?? name).trim();
+      const found = lookup(kind, name);
+      if (found === 'ambiguous') {
+        warnings.push(
+          `link {{${kind}: ${name}}} matches more than one ${kind}; left as plain text`
+        );
+        return label;
+      }
+      if (!found) {
+        warnings.push(`link {{${kind}: ${name}}} matches no ${kind}; left as plain text`);
+        return label;
+      }
+      return `@UUID[${LINK_DOCUMENT[kind]}.${found.id}]{${label}}`;
+    }
+  );
+  return { html: out, warnings };
+}

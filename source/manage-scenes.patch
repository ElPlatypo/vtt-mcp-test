+import { describe, expect, it, vi } from 'vitest';
+import { drawPreview, DEFAULT_LAYERS } from './preview-utils.js';
+import type { GridGeometry } from './scene-objects-utils.js';
+
+const geom: GridGeometry = {
+  size: 100,
+  originX: 0,
+  originY: 0,
+  sceneWidth: 1000,
+  sceneHeight: 500,
+  columns: 10,
+  rows: 5,
+  distance: 5,
+  units: 'ft',
+};
+
+function ctxStub() {
+  const texts: string[] = [];
+  const ctx: any = {
+    texts,
+    fillRect: vi.fn(),
+    drawImage: vi.fn(),
+    beginPath: vi.fn(),
+    closePath: vi.fn(),
+    moveTo: vi.fn(),
+    lineTo: vi.fn(),
+    arc: vi.fn(),
+    ellipse: vi.fn(),
+    stroke: vi.fn(),
+    strokeRect: vi.fn(),
+    fill: vi.fn(),
+    save: vi.fn(),
+    restore: vi.fn(),
+    translate: vi.fn(),
+    rotate: vi.fn(),
+    setLineDash: vi.fn(),
+    strokeText: vi.fn(),
+    fillText: vi.fn((t: string) => texts.push(t)),
+  };
+  return ctx;
+}
+
+describe('tiles layer', () => {
+  const image = { tag: 'prop' };
+  const tiles = [
+    { x: 2, y: 1, width: 2, height: 1, rotation: 90, alpha: 0.5, image },
+    { x: 6, y: 2, width: 1, height: 1, hidden: true },
+  ];
+
+  it('is on by default and draws each picture around its centre, rotated', () => {
+    expect(DEFAULT_LAYERS).toContain('tiles');
+    const ctx = stubDraw({ tiles, layers: DEFAULT_LAYERS });
+    expect(ctx.translate).toHaveBeenCalledWith(300, 150);
+    expect(ctx.rotate).toHaveBeenCalledWith(Math.PI / 2);
+    expect(ctx.drawImage).toHaveBeenCalledWith(image, -100, -50, 200, 100);
+  });
+
+  it('outlines a tile without a picture and numbers the tiles', () => {
+    const ctx = stubDraw({ tiles, labelMode: 'numbers' });
+    expect(ctx.drawImage).toHaveBeenCalledTimes(1);
+    expect(ctx.strokeRect).toHaveBeenCalledTimes(4);
+    expect(ctx.texts).toEqual(expect.arrayContaining(['T1', 'T2']));
+  });
+
+  it('is skipped when the layer is not asked for, and labels can be off', () => {
+    const off = stubDraw({ tiles, layers: ['image', 'grid'] });
+    expect(off.strokeRect).not.toHaveBeenCalled();
+    const none = stubDraw({ tiles, labelMode: 'none' });
+    expect(none.texts).not.toContain('T1');
+  });
+});
+
+function stubDraw(options: Record<string, unknown>) {
+  const ctx = ctxStub();
+  drawPreview(ctx, { geom, scale: 1, labelEvery: 5, tokens: [], lights: [], ...options } as any);
+  return ctx;
+}

+/**
+ * manage-scenes tool tests.
+ *
+ * These cover the MCP tool layer: schema shape, validation, and forwarding to
+ * the bridge query. What Foundry does with the request is covered in
+ * foundry-module/src/data-access.manage-scenes.test.ts.
+ */
+
+import { describe, it, expect, vi } from 'vitest';
+import { SceneTools } from './scene.js';
+
+function makeTools(queryImpl?: (method: string, data: any) => unknown) {
+  const query = vi.fn(queryImpl ?? (async () => ({ scene: { id: 's1', name: 'Road' } })));
+  const logger: any = {
+    info: vi.fn(),
+    debug: vi.fn(),
+    error: vi.fn(),
+    warn: vi.fn(),
+    child: () => logger,
+  };
+  const foundryClient: any = { query };
+  const tools = new SceneTools({ foundryClient, logger });
+  return { tools, query };
+}
+
+describe('manage-scenes tool definition', () => {
+  const { tools } = makeTools();
+  const definition = tools.getToolDefinitions().find(d => d.name === 'manage-scenes')!;
+
+  it('is registered and requires only the action', () => {
+    expect(definition).toBeDefined();
+    expect(definition.inputSchema.required).toEqual(['action']);
+  });
+
+  it('offers create, update and describe but no delete', () => {
+    const props = definition.inputSchema.properties as Record<string, any>;
+    expect(props.action.enum).toEqual(['create', 'update', 'describe']);
+  });
+
+  it('advertises the name, background, size and grid fields', () => {
+    const props = definition.inputSchema.properties as Record<string, any>;
+    for (const key of [
+      'name',
+      'background',
+      'width',
+      'height',
+      'grid_size',
+      'grid_distance',
+      'grid_units',
+      'darkness',
+      'activate',
+    ]) {
+      expect(props[key], key).toBeDefined();
+    }
+  });
+});
+
+describe('SceneTools.handleManageScenes', () => {
+  it('forwards a valid create to the bridge query', async () => {
+    const { tools, query } = makeTools();
+
+    const result = await tools.handleManageScenes({
+      action: 'create',
+      name: 'Road',
+      grid_size: 100,
+    });
+
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.manage-scenes', {
+      action: 'create',
+      name: 'Road',
+      grid_size: 100,
+    });
+    expect(result).toMatchObject({ success: true, scene: { id: 's1' } });
+  });
+
+  it('allows null to clear the background', async () => {
+    const { tools, query } = makeTools();
+
+    await tools.handleManageScenes({
+      action: 'update',
+      scene_identifier: 'Road',
+      background: null,
+    });
+
+    expect(query.mock.calls[0][1]).toMatchObject({ background: null });
+  });
+
+  it.each([
+    [{ action: 'create' }, 'name is required for create'],
+    [{ action: 'update', name: 'x' }, 'scene_identifier is required for update'],
+  ])('rejects %j before calling Foundry', async (args, message) => {
+    const { tools, query } = makeTools();
+
+    await expect(tools.handleManageScenes(args)).rejects.toThrow(message);
+    expect(query).not.toHaveBeenCalled();
+  });
+
+  it.each([
+    { action: 'delete' },
+    { action: 'create', name: 'x', grid_size: 10 },
+    { action: 'create', name: 'x', darkness: 5 },
+    { action: 'create', name: 'x', background_color: 'blue' },
+    { action: 'create', name: 'x', surprise: true },
+  ])('rejects the invalid input %j', async args => {
+    const { tools, query } = makeTools();
+
+    await expect(tools.handleManageScenes(args)).rejects.toThrow();
+    expect(query).not.toHaveBeenCalled();
+  });
+
+  it('wraps bridge failures with context', async () => {
+    const { tools } = makeTools(async () => {
+      throw new Error('Foundry VTT module not connected');
+    });
+
+    await expect(tools.handleManageScenes({ action: 'describe' })).rejects.toThrow(
+      'Failed to manage scenes: Foundry VTT module not connected'
+    );
+  });
+});

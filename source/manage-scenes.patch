+import { describe, expect, it, vi } from 'vitest';
+import { CombatTools } from './combat-tools.js';
+
+function make(response: any = { success: true }) {
+  const query = vi.fn(async () => response);
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  return { tools: new CombatTools({ foundryClient: { query } as any, logger }), query };
+}
+
+describe('combat tool', () => {
+  it('is exposed with action required', () => {
+    const def = make().tools.getToolDefinitions()[0]!;
+    expect(def.name).toBe('combat');
+    expect(def.inputSchema.required).toEqual(['action']);
+  });
+  it('sends the request to Foundry', async () => {
+    const { tools, query } = make({ success: true, combat: { round: 1 } });
+    const r = await tools.handleCombat({ action: 'damage', amounts: [{ target: 'Goblin 1', amount: 4 }] });
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.combat', { action: 'damage', amounts: [{ target: 'Goblin 1', amount: 4 }] });
+    expect(r.combat.round).toBe(1);
+  });
+  it('rejects bad input and refused requests', async () => {
+    const { tools } = make();
+    await expect(tools.handleCombat({ action: 'dance' })).rejects.toThrow();
+    await expect(tools.handleCombat({ action: 'damage', amounts: [{ target: 'x', amount: -2 }] })).rejects.toThrow();
+    const refused = make({ success: false, error: 'Access denied' });
+    await expect(refused.tools.handleCombat({ action: 'status' })).rejects.toThrow('Access denied');
+  });
+});

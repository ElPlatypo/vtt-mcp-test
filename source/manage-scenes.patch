@@ -0,0 +1,464 @@
+/**
+ * Drawing for preview-scene: the scene image with a numbered grid and the scene's tokens
+ * and lights on top, so positions can be read in grid squares. Works on any 2D context, so
+ * it can be tested with a recording stub.
+ */
+
+import type { GridGeometry } from './scene-objects-utils.js';
+
+export interface PreviewToken {
+  name: string;
+  /** Hidden from players: drawn dashed. */
+  hidden?: boolean;
+  /** Top-left corner in grid squares. */
+  x: number;
+  y: number;
+  /** Size in grid squares. */
+  width: number;
+  height: number;
+}
+
+export interface PreviewLight {
+  /** Centre in grid squares. */
+  x: number;
+  y: number;
+  /** Radii in grid squares. */
+  bright: number;
+  dim: number;
+  color?: string | undefined;
+}
+
+/** A region drawn as one or more outlines, in grid squares. */
+export interface PreviewRegion {
+  name: string;
+  /** The colour set on the region, #RRGGBB. */
+  color?: string | undefined;
+  /** Behavior types, used to pick a colour (difficult terrain, trap, teleport, other). */
+  kinds: string[];
+  shapes: Array<
+    | { type: 'poly'; points: Array<[number, number]> }
+    | { type: 'ellipse'; cx: number; cy: number; rx: number; ry: number }
+  >;
+}
+
+/** A tile (a picture laid on the map), in grid squares. */
+export interface PreviewTile {
+  /** Top-left corner and size in grid squares. */
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+  /** Degrees, clockwise, around the centre. */
+  rotation?: number;
+  alpha?: number;
+  hidden?: boolean;
+  /** The loaded picture; omit to draw only the outline. */
+  image?: unknown;
+}
+
+export const PREVIEW_LAYERS = [
+  'image',
+  'tiles',
+  'grid',
+  'walls',
+  'doors',
+  'tokens',
+  'lights',
+  'light_radii',
+  'notes',
+  'regions',
+] as const;
+export type PreviewLayer = (typeof PREVIEW_LAYERS)[number];
+/** What is drawn when no layers are asked for (light radii only on request). */
+export const DEFAULT_LAYERS: PreviewLayer[] = ['image', 'tiles', 'grid', 'walls', 'doors', 'tokens', 'lights', 'notes', 'regions'];
+
+export type LabelMode = 'numbers' | 'names' | 'none';
+
+/** Colour of a region by what it does. */
+export function regionColor(region: PreviewRegion): string {
+  const kinds = region.kinds.join(' ').toLowerCase();
+  if (kinds.includes('difficult')) return '#b5803a';
+  if (kinds.includes('macro') || kinds.includes('trap')) return '#ff3b30';
+  if (kinds.includes('teleport')) return '#bf5af2';
+  if (region.kinds.length > 0) return '#0a84ff';
+  return region.color && /^#[0-9a-fA-F]{6}$/.test(region.color) ? region.color : '#8e8e93';
+}
+
+export interface PreviewWall {
+  /** End points in grid squares. */
+  x1: number;
+  y1: number;
+  x2: number;
+  y2: number;
+  /** 0 none, 1 door, 2 secret door. */
+  door: number;
+}
+
+export interface PreviewNote {
+  x: number;
+  y: number;
+  text: string;
+}
+
+export interface PreviewOptions {
+  geom: GridGeometry;
+  /** Output pixels per scene pixel. */
+  scale: number;
+  /** Label every Nth column and row (default 1). */
+  labelEvery: number;
+  tokens: PreviewToken[];
+  lights: PreviewLight[];
+  walls?: PreviewWall[];
+  notes?: PreviewNote[];
+  regions?: PreviewRegion[];
+  tiles?: PreviewTile[];
+  /** Layers to draw (default: all of them, with light radii). */
+  layers?: readonly PreviewLayer[];
+  /** How tokens, lights and regions are labelled (default names). */
+  labelMode?: LabelMode;
+  /** Darken the map image by this fraction (0 to 0.9) so the overlay stands out. */
+  dim?: number;
+  /** Image to draw behind the grid; omit for a plain grey background. */
+  image?: unknown;
+  /** Only draw this part of the scene, in grid squares (a zoomed look at one area). */
+  view?: PreviewView;
+}
+
+/** A rectangle of the scene in grid squares. */
+export interface PreviewView {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+}
+
+/** Zoomed previews may be drawn larger than the scene's own pixels, up to this factor. */
+export const MAX_ZOOM = 2;
+
+/** Output size in pixels for the whole scene, or for just the view when one is given. */
+export function previewSize(
+  geom: GridGeometry,
+  scale: number,
+  view?: PreviewView
+): { width: number; height: number } {
+  const square = geom.size * scale;
+  return view
+    ? { width: Math.round(view.width * square), height: Math.round(view.height * square) }
+    : { width: Math.round(geom.sceneWidth * scale), height: Math.round(geom.sceneHeight * scale) };
+}
+
+/** Choose the output scale so the longest side is at most maxSize pixels (never upscales). */
+export function previewScale(geom: GridGeometry, maxSize: number, view?: PreviewView): number {
+  if (view) {
+    // A zoomed view fills the picture and may be enlarged a little for readability.
+    const longest = Math.max(view.width, view.height) * geom.size;
+    return Math.min(MAX_ZOOM, maxSize / longest);
+  }
+  const longest = Math.max(geom.sceneWidth, geom.sceneHeight);
+  return Math.min(1, maxSize / longest);
+}
+
+/** Pick a label interval that keeps labels readable: about one label per 40 output pixels. */
+export function defaultLabelEvery(geom: GridGeometry, scale: number): number {
+  const squarePx = geom.size * scale;
+  return Math.max(1, Math.ceil(40 / squarePx));
+}
+
+export function drawPreview(ctx: any, options: PreviewOptions): { width: number; height: number } {
+  const { geom, scale } = options;
+  const layers = new Set<string>(options.layers ?? PREVIEW_LAYERS);
+  const labelMode: LabelMode = options.labelMode ?? 'names';
+  const tokens = layers.has('tokens') ? options.tokens : [];
+  const lights = layers.has('lights') || layers.has('light_radii') ? options.lights : [];
+  const regions = layers.has('regions') ? options.regions ?? [] : [];
+  const width = Math.round(geom.sceneWidth * scale);
+  const height = Math.round(geom.sceneHeight * scale);
+  const square = geom.size * scale;
+  const every = Math.max(1, Math.floor(options.labelEvery));
+  const view = options.view;
+  // Output window in whole-scene pixels; everything is drawn in whole-scene coordinates and the
+  // canvas is moved so only the window shows.
+  const outSize = previewSize(geom, scale, view);
+  const ox = view ? view.x * square : 0;
+  const oy = view ? view.y * square : 0;
+  if (view) {
+    ctx.save();
+    ctx.translate(-ox, -oy);
+  }
+
+  // Background.
+  ctx.fillStyle = '#808080';
+  ctx.fillRect(0, 0, width, height);
+  if (options.image && layers.has('image')) {
+    ctx.drawImage(options.image, 0, 0, width, height);
+    if (options.dim && options.dim > 0) {
+      ctx.fillStyle = `rgba(0,0,0,${Math.min(0.9, options.dim)})`;
+      ctx.fillRect(0, 0, width, height);
+    }
+  }
+
+  // Tiles: pictures laid over the map image, in the order Foundry lists them.
+  if (layers.has('tiles')) {
+    (options.tiles ?? []).forEach((tile, index) => {
+      const w = tile.width * square;
+      const h = tile.height * square;
+      ctx.save();
+      ctx.translate(tile.x * square + w / 2, tile.y * square + h / 2);
+      if (tile.rotation) ctx.rotate((tile.rotation * Math.PI) / 180);
+      ctx.globalAlpha = tile.hidden ? 0.5 : tile.alpha === undefined ? 1 : Math.max(0, Math.min(1, tile.alpha));
+      if (tile.image) ctx.drawImage(tile.image, -w / 2, -h / 2, w, h);
+      ctx.globalAlpha = 1;
+      ctx.setLineDash(tile.hidden ? [8, 5] : [])
+      ctx.strokeStyle = 'rgba(0,0,0,0.85)';
+      ctx.lineWidth = 6;
+      ctx.strokeRect(-w / 2, -h / 2, w, h);
+      ctx.strokeStyle = '#34ff6a';
+      ctx.lineWidth = 3;
+      ctx.strokeRect(-w / 2, -h / 2, w, h);
+      ctx.setLineDash([]);
+      if (labelMode !== 'none') {
+        ctx.font = 'bold 14px sans-serif';
+        ctx.textAlign = 'left';
+        ctx.textBaseline = 'alphabetic';
+        ctx.lineWidth = 4;
+        ctx.strokeStyle = '#000000';
+        ctx.strokeText('T' + (index + 1), -w / 2 + 5, -h / 2 + 17);
+        ctx.fillStyle = '#34ff6a';
+        ctx.fillText('T' + (index + 1), -w / 2 + 5, -h / 2 + 17);
+      }
+      ctx.restore();
+    });
+  }
+
+  // Regions (under everything else): a tinted fill and an outline.
+  for (const region of regions) {
+    const color = regionColor(region);
+    ctx.fillStyle = color + '55';
+    for (const shape of region.shapes) {
+      ctx.beginPath();
+      if (shape.type === 'ellipse') {
+        ctx.ellipse(shape.cx * square, shape.cy * square, shape.rx * square, shape.ry * square, 0, 0, Math.PI * 2);
+      } else {
+        shape.points.forEach((p, i) => (i === 0 ? ctx.moveTo(p[0] * square, p[1] * square) : ctx.lineTo(p[0] * square, p[1] * square)));
+        ctx.closePath();
+      }
+      ctx.fill();
+      ctx.strokeStyle = 'rgba(0,0,0,0.85)';
+      ctx.lineWidth = 6;
+      ctx.stroke();
+      ctx.strokeStyle = color;
+      ctx.lineWidth = 3;
+      ctx.stroke();
+    }
+  }
+
+  // Lights (under the grid).
+  for (const light of lights) {
+    const cx = light.x * square;
+    const cy = light.y * square;
+    const color = light.color || '#ffcc33';
+    const radii = layers.has('light_radii');
+    const ring = (radius: number, dash: number[]) => {
+      ctx.setLineDash(dash);
+      ctx.beginPath();
+      ctx.arc(cx, cy, radius, 0, Math.PI * 2);
+      ctx.strokeStyle = 'rgba(0,0,0,0.85)';
+      ctx.lineWidth = 6;
+      ctx.stroke();
+      ctx.strokeStyle = color;
+      ctx.lineWidth = 3;
+      ctx.stroke();
+      ctx.setLineDash([]);
+    };
+    if (radii && light.dim > 0) ring(light.dim * square, [10, 6]);
+    if (radii && light.bright > 0) ring(light.bright * square, []);
+    if (layers.has('lights')) {
+      ctx.fillStyle = color;
+      ctx.strokeStyle = '#000000';
+      ctx.lineWidth = 2.5;
+      ctx.beginPath();
+      ctx.arc(cx, cy, 7, 0, Math.PI * 2);
+      ctx.fill();
+      ctx.stroke();
+    }
+  }
+
+  // Grid lines: thin every square, stronger every 5.
+  for (let col = 0; layers.has('grid') && col <= geom.columns; col++) {
+    const px = col * square;
+    ctx.strokeStyle = col % 5 === 0 ? 'rgba(255,255,255,0.75)' : 'rgba(255,255,255,0.35)';
+    ctx.lineWidth = col % 5 === 0 ? 1.5 : 0.75;
+    ctx.beginPath();
+    ctx.moveTo(px, 0);
+    ctx.lineTo(px, height);
+    ctx.stroke();
+  }
+  for (let row = 0; layers.has('grid') && row <= geom.rows; row++) {
+    const py = row * square;
+    ctx.strokeStyle = row % 5 === 0 ? 'rgba(255,255,255,0.75)' : 'rgba(255,255,255,0.35)';
+    ctx.lineWidth = row % 5 === 0 ? 1.5 : 0.75;
+    ctx.beginPath();
+    ctx.moveTo(0, py);
+    ctx.lineTo(width, py);
+    ctx.stroke();
+  }
+
+  // Walls: bright cyan; doors thick orange with end ticks; secret doors dashed magenta-orange.
+  // Every line has a dark outline so it stands out on light stone and dark rock alike, and every
+  // end has a dot, so a gap or a loose end is easy to see.
+  const shown = (options.walls ?? []).filter(wall => (wall.door ? layers.has('doors') : layers.has('walls')));
+  if (shown.length > 0) {
+    const thin = Math.max(3.5, Math.min(7, square * 0.07));
+    const thick = thin * 1.6;
+    const line = (wall: PreviewWall, width: number, color: string, dash: number[]) => {
+      ctx.lineWidth = width;
+      ctx.strokeStyle = color;
+      ctx.lineCap = 'butt';
+      ctx.setLineDash(dash);
+      ctx.beginPath();
+      ctx.moveTo(wall.x1 * square, wall.y1 * square);
+      ctx.lineTo(wall.x2 * square, wall.y2 * square);
+      ctx.stroke();
+    };
+    // pass 1: dark outlines under everything
+    for (const wall of shown) line(wall, (wall.door ? thick : thin) + 4, 'rgba(0,0,0,0.85)', []);
+    // pass 2: the colours
+    for (const wall of shown) {
+      const secret = wall.door === 2;
+      line(wall, wall.door ? thick : thin, wall.door ? (secret ? '#ff2d95' : '#ff9500') : '#00e5ff', secret ? [8, 5] : []);
+    }
+    ctx.setLineDash([]);
+    // end ticks across each door, so its length is visible
+    for (const wall of shown) {
+      if (!wall.door) continue;
+      const dx = wall.x2 - wall.x1;
+      const dy = wall.y2 - wall.y1;
+      const length = Math.hypot(dx, dy) || 1;
+      const nx = (-dy / length) * (thick * 1.1);
+      const ny = (dx / length) * (thick * 1.1);
+      ctx.lineWidth = 2.5;
+      ctx.strokeStyle = '#ffffff';
+      for (const [x, y] of [[wall.x1, wall.y1], [wall.x2, wall.y2]] as Array<[number, number]>) {
+        ctx.beginPath();
+        ctx.moveTo(x * square - nx, y * square - ny);
+        ctx.lineTo(x * square + nx, y * square + ny);
+        ctx.stroke();
+      }
+    }
+    // dots where walls start and end
+    const seen = new Set<string>();
+    for (const wall of shown) {
+      for (const [x, y] of [[wall.x1, wall.y1], [wall.x2, wall.y2]] as Array<[number, number]>) {
+        const key = `${Math.round(x * 100)},${Math.round(y * 100)}`;
+        if (seen.has(key)) continue;
+        seen.add(key);
+        ctx.beginPath();
+        ctx.arc(x * square, y * square, thin * 0.85, 0, Math.PI * 2);
+        ctx.fillStyle = '#ffffff';
+        ctx.fill();
+        ctx.lineWidth = 1.5;
+        ctx.strokeStyle = '#000000';
+        ctx.stroke();
+      }
+    }
+  }
+
+  // Map pins: yellow diamonds.
+  for (const note of layers.has('notes') ? options.notes ?? [] : []) {
+    const cx = note.x * square;
+    const cy = note.y * square;
+    ctx.fillStyle = '#ffd60a';
+    ctx.strokeStyle = '#000000';
+    ctx.lineWidth = 2.5;
+    ctx.beginPath();
+    ctx.moveTo(cx, cy - 12);
+    ctx.lineTo(cx + 12, cy);
+    ctx.lineTo(cx, cy + 12);
+    ctx.lineTo(cx - 12, cy);
+    ctx.closePath();
+    ctx.fill();
+    ctx.stroke();
+  }
+
+  // Tokens.
+  for (const token of tokens) {
+    const left = token.x * square;
+    const top = token.y * square;
+    const w = token.width * square;
+    const h = token.height * square;
+    ctx.fillStyle = 'rgba(255,59,48,0.4)';
+    ctx.setLineDash(token.hidden ? [8, 5] : []);
+    ctx.beginPath();
+    ctx.arc(left + w / 2, top + h / 2, Math.min(w, h) / 2, 0, Math.PI * 2);
+    ctx.fill();
+    ctx.strokeStyle = 'rgba(0,0,0,0.85)';
+    ctx.lineWidth = 6;
+    ctx.stroke();
+    ctx.strokeStyle = '#ff3b30';
+    ctx.lineWidth = 3;
+    ctx.stroke();
+    ctx.setLineDash([]);
+  }
+
+  // Labels: outlined text so they read on any map.
+  const fontSize = Math.max(11, Math.min(16, Math.round(square * 0.45)));
+  ctx.font = `bold ${fontSize}px sans-serif`;
+  ctx.textAlign = 'center';
+  ctx.textBaseline = 'middle';
+  const label = (text: string, x: number, y: number) => {
+    ctx.lineWidth = 4;
+    ctx.lineJoin = 'round';
+    ctx.strokeStyle = '#000000';
+    ctx.strokeText(text, x, y);
+    ctx.fillStyle = '#ffffff';
+    ctx.fillText(text, x, y);
+  };
+  const firstCol = view ? Math.max(0, Math.floor(view.x)) : 0;
+  const lastCol = view ? Math.min(geom.columns, Math.ceil(view.x + view.width)) : geom.columns;
+  const firstRow = view ? Math.max(0, Math.floor(view.y)) : 0;
+  const lastRow = view ? Math.min(geom.rows, Math.ceil(view.y + view.height)) : geom.rows;
+  for (let col = firstCol - (firstCol % every); layers.has('grid') && col < lastCol; col += every) {
+    if (col < firstCol) continue;
+    const x = (col + 0.5) * square;
+    label(String(col), x, oy + fontSize);
+    label(String(col), x, oy + outSize.height - fontSize);
+  }
+  for (let row = firstRow - (firstRow % every); layers.has('grid') && row < lastRow; row += every) {
+    if (row < firstRow) continue;
+    const y = (row + 0.5) * square;
+    label(String(row), ox + fontSize, y);
+    label(String(row), ox + outSize.width - fontSize, y);
+  }
+  for (const note of layers.has('notes') ? options.notes ?? [] : []) {
+    if (note.text) label(note.text, note.x * square, note.y * square - 16);
+  }
+  if (labelMode !== 'none') {
+    tokens.forEach((token, i) => {
+      if (labelMode === 'numbers') {
+        label(String(i + 1), (token.x + token.width / 2) * square, (token.y + token.height / 2) * square);
+      } else {
+        label(token.name, (token.x + token.width / 2) * square, (token.y + token.height) * square + fontSize);
+      }
+    });
+    if (layers.has('lights') && labelMode === 'numbers') {
+      lights.forEach((light, i) => label(`L${i + 1}`, light.x * square + 14, light.y * square - 12));
+    }
+    regions.forEach((region, i) => {
+      const first = region.shapes[0];
+      if (!first) return;
+      let cx: number;
+      let cy: number;
+      if (first.type === 'ellipse') {
+        cx = first.cx;
+        cy = first.cy;
+      } else {
+        cx = first.points.reduce((a, p) => a + p[0], 0) / first.points.length;
+        cy = first.points.reduce((a, p) => a + p[1], 0) / first.points.length;
+      }
+      label(labelMode === 'numbers' ? `R${i + 1}` : region.name, cx * square, cy * square);
+    });
+  }
+
+  if (view) ctx.restore();
+  return view ? outSize : { width, height };
+}

+import { describe, expect, it, vi } from 'vitest';
+import { drawPreview, regionColor, DEFAULT_LAYERS, type PreviewRegion } from './preview-utils.js';
+import type { GridGeometry } from './scene-objects-utils.js';
+
+const geom: GridGeometry = {
+  size: 100,
+  originX: 0,
+  originY: 0,
+  sceneWidth: 1000,
+  sceneHeight: 500,
+  columns: 10,
+  rows: 5,
+  distance: 5,
+  units: 'ft',
+};
+
+function fakeContext() {
+  const texts: Array<{ text: string; x: number; y: number }> = [];
+  const dashes: number[][] = [];
+  const ctx: any = {
+    texts,
+    dashes,
+    fillRect: vi.fn(),
+    drawImage: vi.fn(),
+    beginPath: vi.fn(),
+    closePath: vi.fn(),
+    moveTo: vi.fn(),
+    lineTo: vi.fn(),
+    arc: vi.fn(),
+    ellipse: vi.fn(),
+    stroke: vi.fn(),
+    fill: vi.fn(),
+    save: vi.fn(),
+    restore: vi.fn(),
+    translate: vi.fn(),
+    setLineDash: vi.fn((d: number[]) => dashes.push(d)),
+    strokeText: vi.fn(),
+    fillText: vi.fn((text: string, x: number, y: number) => texts.push({ text, x, y })),
+  };
+  return ctx;
+}
+
+const tokens = [
+  { name: 'Wolf', x: 1, y: 1, width: 1, height: 1 },
+  { name: 'Goblin', x: 2, y: 1, width: 1, height: 1, hidden: true },
+];
+const lights = [{ x: 5, y: 2, bright: 2, dim: 4 }];
+const regions: PreviewRegion[] = [
+  { name: 'Rubble', kinds: ['dnd5e.difficultTerrain'], shapes: [{ type: 'poly', points: [[3, 3], [5, 3], [5, 4], [3, 4]] }] },
+  { name: 'Pit', kinds: ['executeMacro'], shapes: [{ type: 'ellipse', cx: 7, cy: 3, rx: 1, ry: 1 }] },
+];
+
+describe('drawPreview layers', () => {
+  it('numbers tokens, lights and regions instead of writing names', () => {
+    const ctx = fakeContext();
+    drawPreview(ctx, { geom, scale: 1, labelEvery: 5, tokens, lights, regions, labelMode: 'numbers' });
+    const labels = ctx.texts.map((t: any) => t.text);
+    expect(labels).toEqual(expect.arrayContaining(['1', '2', 'L1', 'R1', 'R2']));
+    expect(labels).not.toContain('Wolf');
+    expect(labels).not.toContain('Rubble');
+  });
+
+  it('writes names when asked, and nothing for none', () => {
+    const named = fakeContext();
+    drawPreview(named, { geom, scale: 1, labelEvery: 5, tokens, lights, regions, labelMode: 'names' });
+    expect(named.texts.map((t: any) => t.text)).toEqual(expect.arrayContaining(['Wolf', 'Goblin', 'Rubble', 'Pit']));
+    const none = fakeContext();
+    drawPreview(none, { geom, scale: 1, labelEvery: 5, tokens, lights, regions, labelMode: 'none' });
+    const labels = none.texts.map((t: any) => t.text);
+    expect(labels).not.toContain('Wolf');
+    expect(labels).not.toContain('1');
+  });
+
+  it('draws only the layers asked for', () => {
+    const ctx = fakeContext();
+    drawPreview(ctx, { geom, scale: 1, labelEvery: 1, tokens, lights, regions, layers: ['tokens'], labelMode: 'numbers' });
+    // tokens are circles; no light dot, no region ellipse, no grid numbers
+    expect(ctx.arc).toHaveBeenCalledTimes(2);
+    expect(ctx.ellipse).not.toHaveBeenCalled();
+    expect(ctx.drawImage).not.toHaveBeenCalled();
+    const labels = ctx.texts.map((t: any) => t.text);
+    expect(labels).toEqual(['1', '2']);
+  });
+
+  it('draws regions as filled outlines and ellipses', () => {
+    const ctx = fakeContext();
+    drawPreview(ctx, { geom, scale: 1, labelEvery: 5, tokens: [], lights: [], regions, layers: ['regions'] });
+    expect(ctx.ellipse).toHaveBeenCalledWith(700, 300, 100, 100, 0, 0, Math.PI * 2);
+    expect(ctx.moveTo).toHaveBeenCalledWith(300, 300);
+  });
+
+  it('draws light radii only when the layer is asked for', () => {
+    const dots = fakeContext();
+    drawPreview(dots, { geom, scale: 1, labelEvery: 5, tokens: [], lights, layers: ['lights'] });
+    expect(dots.arc).toHaveBeenCalledTimes(1);
+    expect(dots.arc).toHaveBeenCalledWith(500, 200, 7, 0, Math.PI * 2);
+    const radii = fakeContext();
+    drawPreview(radii, { geom, scale: 1, labelEvery: 5, tokens: [], lights, layers: ['lights', 'light_radii'] });
+    expect(radii.arc).toHaveBeenCalledWith(500, 200, 400, 0, Math.PI * 2);
+    expect(radii.arc).toHaveBeenCalledWith(500, 200, 200, 0, Math.PI * 2);
+  });
+
+  it('shows hidden tokens dashed', () => {
+    const ctx = fakeContext();
+    drawPreview(ctx, { geom, scale: 1, labelEvery: 5, tokens, lights: [], layers: ['tokens'] });
+    expect(ctx.dashes).toContainEqual([8, 5]);
+  });
+
+  it('dims the map image under the overlay', () => {
+    const ctx = fakeContext();
+    drawPreview(ctx, { geom, scale: 1, labelEvery: 5, tokens: [], lights: [], image: {}, dim: 0.5 });
+    expect(ctx.drawImage).toHaveBeenCalled();
+    expect(ctx.fillRect).toHaveBeenCalledTimes(2);
+  });
+
+  it('separates walls from doors', () => {
+    const ctx = fakeContext();
+    const walls = [
+      { x1: 0, y1: 0, x2: 1, y2: 0, door: 0 },
+      { x1: 1, y1: 0, x2: 2, y2: 0, door: 1 },
+    ];
+    drawPreview(ctx, { geom, scale: 1, labelEvery: 5, tokens: [], lights: [], walls, layers: ['doors'] });
+    expect(ctx.lineTo.mock.calls.filter((c: number[]) => c[0] === 200 && c[1] === 0).length).toBeGreaterThan(0);
+    expect(ctx.lineTo).not.toHaveBeenCalledWith(100, 0);
+    expect(ctx.lineTo).toHaveBeenCalledWith(200, 0);
+  });
+});
+
+describe('regionColor and defaults', () => {
+  it('colours regions by what they do', () => {
+    expect(regionColor({ name: 'a', kinds: ['dnd5e.difficultTerrain'], shapes: [] })).toBe('#b5803a');
+    expect(regionColor({ name: 'a', kinds: ['executeMacro'], shapes: [] })).toBe('#ff3b30');
+    expect(regionColor({ name: 'a', kinds: ['teleportToken'], shapes: [] })).toBe('#bf5af2');
+    expect(regionColor({ name: 'a', kinds: ['pauseGame'], shapes: [] })).toBe('#0a84ff');
+    expect(regionColor({ name: 'a', color: '#123456', kinds: [], shapes: [] })).toBe('#123456');
+  });
+
+  it('leaves light radii out by default', () => {
+    expect(DEFAULT_LAYERS).toContain('regions');
+    expect(DEFAULT_LAYERS).not.toContain('light_radii');
+  });
+});

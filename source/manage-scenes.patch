+import { describe, expect, it } from 'vitest';
+import { describeFields, limitJson, pickPath, trimDepth } from './inspect-utils.js';
+
+describe('trimDepth', () => {
+  const doc = { a: 1, b: { c: { d: 2 }, e: [1, 2, 3] }, f: 'text' };
+
+  it('keeps values within the depth and replaces deeper objects with a placeholder', () => {
+    expect(trimDepth(doc, 1)).toEqual({
+      a: 1,
+      b: '{object with 2 keys}',
+      f: 'text',
+    });
+    expect(trimDepth(doc, 2)).toEqual({
+      a: 1,
+      b: { c: '{object with 1 keys}', e: '[array of 3]' },
+      f: 'text',
+    });
+  });
+
+  it('keeps everything when deep enough and leaves primitives alone', () => {
+    expect(trimDepth(doc, 10)).toEqual(doc);
+    expect(trimDepth(5, 1)).toBe(5);
+    expect(trimDepth(null, 1)).toBeNull();
+  });
+});
+
+describe('pickPath', () => {
+  const doc = {
+    system: { attributes: { hp: { value: 7, max: 11 } } },
+    items: [{ name: 'Scimitar' }],
+  };
+
+  it('reads nested values and array entries', () => {
+    expect(pickPath(doc, 'system.attributes.hp')).toEqual({ value: 7, max: 11 });
+    expect(pickPath(doc, 'items.0.name')).toBe('Scimitar');
+  });
+
+  it('names the sibling keys when the path is wrong', () => {
+    expect(() => pickPath(doc, 'system.attributes.mana')).toThrow(
+      'Nothing at "system.attributes.mana". Keys of system.attributes: hp'
+    );
+    expect(() => pickPath(doc, 'nope')).toThrow('Keys of the document: system, items');
+    expect(() => pickPath(doc, 'items.0.name.length')).toThrow('(not an object)');
+  });
+
+  it('rejects an empty path', () => {
+    expect(() => pickPath(doc, '..')).toThrow('empty');
+  });
+});
+
+describe('limitJson', () => {
+  it('returns the whole text when it fits', () => {
+    expect(limitJson({ a: 1 }, 1000)).toEqual({ json: '{\n "a": 1\n}', truncated: false });
+  });
+
+  it('cuts to the limit and says so', () => {
+    const out = limitJson({ text: 'x'.repeat(500) }, 100);
+    expect(out.truncated).toBe(true);
+    expect(out.json).toHaveLength(100);
+  });
+});
+
+describe('describeFields', () => {
+  class StringField {
+    required = true;
+    initial = 'x';
+    choices = ['a', 'b'];
+  }
+  class NumberField {
+    min = 0;
+    max = 10;
+    nullable = true;
+  }
+  class SchemaField {
+    fields: Record<string, any>;
+    constructor(fields: Record<string, any>) {
+      this.fields = fields;
+    }
+  }
+  class ArrayField {
+    element: any;
+    constructor(element: any) {
+      this.element = element;
+    }
+  }
+
+  const fields = {
+    name: new StringField(),
+    size: new NumberField(),
+    grid: new SchemaField({
+      size: new NumberField(),
+      nested: new SchemaField({ deep: new StringField() }),
+    }),
+    tags: new ArrayField(new StringField()),
+    kind: Object.assign(new StringField(), {
+      choices: { one: 'One', two: 'Two' },
+      initial: () => 'z',
+    }),
+  };
+
+  it('reports kinds, required, initial, choices and limits', () => {
+    const out = describeFields(fields, 1);
+    expect(out.name).toEqual({
+      type: 'StringField',
+      required: true,
+      initial: 'x',
+      choices: ['a', 'b'],
+    });
+    expect(out.size).toEqual({ type: 'NumberField', nullable: true, min: 0, max: 10 });
+    expect(out.kind.choices).toEqual(['one', 'two']);
+    expect(out.kind.initial).toBeUndefined();
+  });
+
+  it('descends into nested fields and array elements only as deep as asked', () => {
+    const shallow = describeFields(fields, 1);
+    expect(shallow.grid.fields).toBeUndefined();
+
+    const deeper = describeFields(fields, 3);
+    expect(Object.keys(deeper.grid.fields!)).toEqual(['size', 'nested']);
+    expect(deeper.grid.fields!.nested.fields!.deep.type).toBe('StringField');
+    expect(deeper.tags.element?.type).toBe('StringField');
+  });
+});

+
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('FilePicker', { createDirectory, browse, upload });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: options.noWorld
+      ? { getFlag: vi.fn(() => []), setFlag: vi.fn() }
+      : { id: 'world-1', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'Gamemaster' },

+<form class="mgs-settings" autocomplete="off">
+  <section class="mgs-block">
+    <h2 class="mgs-title">Image Generation</h2>
+    <p class="mgs-note">
+      Claude can generate pictures with your ComfyUI. Choose here which model and settings are used for
+      each kind of picture. Which ComfyUI is used (built-in or your own) is set in
+      <strong>Configure Map Generation</strong>.
+    </p>
+  </section>
+
+  <section class="mgs-block mgs-settings-block">
+    <div class="mgs-model-bar">
+      <button type="button" class="mgs-btn check" id="igs-refresh-btn">
+        <i class="fas fa-sync"></i> Load models from ComfyUI
+      </button>
+      <p class="mgs-status-detail" id="igs-model-status">Not loaded yet. The lists below show what is saved.</p>
+    </div>
+    <p class="mgs-hint">
+      Checkpoints go in ComfyUI's <code>models/checkpoints</code> folder, MiniMax H3 diffusion models in
+      <code>models/diffusion_models</code>, text encoders in <code>models/text_encoders</code> and VAEs in
+      <code>models/vae</code>.
+    </p>
+  </section>
+
+  {{#each kinds}}
+  <details class="mgs-details mgs-settings-block" {{#if open}}open{{/if}}>
+    <summary class="mgs-summary">{{label}}</summary>
+    <p class="mgs-hint mgs-tight">{{help}}</p>
+
+    <div class="mgs-form-group">
+      <label class="mgs-label">Workflow</label>
+      <select name="{{key}}__workflow" data-role="workflow">

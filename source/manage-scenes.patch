+import { promises as fs } from 'fs';
+import os from 'os';
+import path from 'path';
+import { PNG } from 'pngjs';
+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+import { decodeImage } from './layout-image.js';
+import { downscale, keyOutBackground, padToSquare } from './prop-keying.js';
+
+export interface ActorArtToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+  generate?: ((args: any) => Promise<any>) | undefined;
+  upload?: ((args: any) => Promise<any>) | undefined;
+}
+
+const MAX_ACTORS = 2;
+
+const schema = z
+  .object({
+    actors: z
+      .array(
+        z
+          .object({
+            actor: z.string().min(1),
+            prompt: z.string().min(3).max(1500).optional(),
+            portrait: z.boolean().optional(),
+            token: z.boolean().optional(),
+          })
+          .strict()
+      )
+      .min(1)
+      .max(MAX_ACTORS),
+    style: z.string().min(1).max(300).optional(),
+    portrait_size: z.number().int().min(256).max(2048).optional(),
+    token_size: z.number().int().min(64).max(1024).optional(),
+    update_placed: z.boolean().optional(),
+    folder: z.string().min(1).max(80).optional(),
+    seed: z.number().int().min(0).optional(),
+  })
+  .strict();
+
+/** A name safe to use in a file path. */
+export function artSlug(text: string): string {
+  const slug = text
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+    .slice(0, 40);
+  return slug || 'actor';
+}
+
+export class ActorArtTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+  private generate: ((args: any) => Promise<any>) | undefined;
+  private upload: ((args: any) => Promise<any>) | undefined;
+  private folder = path.join(os.tmpdir(), 'foundry-mcp-actor-art');
+
+  constructor({ foundryClient, logger, generate, upload }: ActorArtToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'ActorArtTools' });
+    this.generate = generate;
+    this.upload = upload;
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'make-actor-art',
+        description:
+          'Give actors their pictures in one call: generates a portrait and a token (a head-and-shoulders picture with a transparent background, cropped square), uploads both to worlds/<world>/uploads/actors/<name>/, sets the actor\'s portrait and token picture, and swaps the picture on tokens of that actor already on scenes (update_placed, default true). ' +
+          `actors: up to ${MAX_ACTORS} per call, each {actor (id or name), prompt (what they look like, e.g. "a scarred goblin boss in rusted plate armour, yellow eyes"; defaults to the actor name), portrait? (default true), token? (default true)}. ` +
+          'style is added to every prompt (e.g. "dark fantasy oil painting"). portrait_size and token_size are the longest side in pixels of the finished pictures (defaults 1024 and 512); MiniMax H3 pictures are always generated large and shrunk. Takes about two minutes per actor. A failure on one actor does not stop the others; each result says what was done.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            actors: {
+              type: 'array',
+              maxItems: MAX_ACTORS,
+              items: {
+                type: 'object',
+                properties: {
+                  actor: { type: 'string', description: 'Actor id or name' },
+                  prompt: { type: 'string', description: 'What the character looks like' },
+                  portrait: { type: 'boolean', description: 'Make the portrait (default true)' },
+                  token: { type: 'boolean', description: 'Make the token (default true)' },
+                },
+                required: ['actor'],
+                additionalProperties: false,
+              },
+            },
+            style: { type: 'string', description: 'Art style added to every prompt' },
+            portrait_size: { type: 'number', description: 'Longest side of the portrait in pixels (default 1024)' },
+            token_size: { type: 'number', description: 'Longest side of the token in pixels (default 512)' },
+            update_placed: { type: 'boolean', description: 'Also change tokens of these actors already on scenes (default true)' },
+            folder: { type: 'string', description: 'Folder below the world uploads (default actors)' },
+            seed: { type: 'number', description: 'Seed for the generation (same seed for every picture)' },
+          },
+          required: ['actors'],
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  private async makeOne(
+    entry: { actor: string; prompt?: string | undefined; portrait?: boolean | undefined; token?: boolean | undefined },
+    options: { style?: string | undefined; portraitSize: number; tokenSize: number; updatePlaced: boolean; folder: string; seed?: number | undefined }
+  ): Promise<Record<string, any>> {
+    if (!this.generate || !this.upload) throw new Error('Image generation and upload are not available here');
+    const slug = artSlug(entry.actor);
+    const look = entry.prompt ?? entry.actor;
+    const style = options.style ? `, ${options.style}` : '';
+    const steps: string[] = [];
+    const result: Record<string, any> = { actor: entry.actor };
+    const seed = options.seed !== undefined ? { seed: options.seed } : {};
+    const where = `${options.folder}/${slug}`;
+
+    if (entry.portrait !== false) {
+      const generated = await this.generate({
+        kind: 'portrait',
+        name: `portrait-${slug}`,
+        prompt: `${look}. Character portrait${style}`,
+        upload: false,
+        max_side: options.portraitSize,
+        ...seed,
+      });
+      if (generated?.success === false || !generated?.local_path) throw new Error(generated?.error || 'The portrait could not be generated');
+      const uploaded = await this.upload({ file_path: generated.local_path, folder: where, filename: 'portrait.png', overwrite: true });
+      if (uploaded?.success === false || !uploaded?.path) throw new Error(uploaded?.error || 'The portrait could not be uploaded');
+      result.portrait = uploaded.path;
+      steps.push(`portrait made (${generated.shrunk_to ?? generated.size})`);
+    }
+
+    if (entry.token !== false) {
+      const generated = await this.generate({
+        kind: 'token',
+        name: `token-${slug}`,
+        prompt:
+          `${look}. Token art: only this one subject, centred, facing the viewer, with plenty of empty space all around and nothing touching the edges; if it is a person or creature show it from the chest up, with nobody and nothing else in the picture${style}. ` +
+          'Isolated on a perfectly flat, uniform pure magenta (#FF00FF) background. No frame, no border, no text, no shadow on the background.',
+        upload: false,
+        ...seed,
+      });
+      if (generated?.success === false || !generated?.local_path) throw new Error(generated?.error || 'The token could not be generated');
+      const picture = await decodeImage(generated.local_path);
+      const keyed = keyOutBackground({ width: picture.width, height: picture.height, data: picture.data }, { removeEnclosed: true });
+      const square = downscale(padToSquare({ width: keyed.width, height: keyed.height, data: keyed.data }), options.tokenSize);
+      const png = new PNG({ width: square.width, height: square.height });
+      png.data = Buffer.from(square.data);
+      await fs.mkdir(this.folder, { recursive: true });
+      const local = path.join(this.folder, `${slug}-token-${Date.now().toString(36)}.png`);
+      await fs.writeFile(local, PNG.sync.write(png));
+      const uploaded = await this.upload({ file_path: local, folder: where, filename: 'token.png', overwrite: true });
+      if (uploaded?.success === false || !uploaded?.path) throw new Error(uploaded?.error || 'The token could not be uploaded');
+      result.token = uploaded.path;
+      result.localToken = local;
+      steps.push(`token made (${square.width}x${square.height})`);
+    }
+
+    const applied = await this.foundryClient.query('foundry-mcp-bridge.set-actor-art', {
+      actor: entry.actor,
+      ...(result.portrait ? { img: result.portrait } : {}),
+      ...(result.token ? { tokenImg: result.token } : {}),
+      update_placed: options.updatePlaced,
+    });
+    if (applied?.success === false) throw new Error(applied.error || 'The pictures could not be set on the actor');
+    result.actorName = applied?.actor?.name;
+    result.tokensUpdated = applied?.tokensUpdated ?? 0;
+    steps.push('actor updated');
+    result.steps = steps;
+    return result;
+  }
+
+  async handleMakeActorArt(args: unknown): Promise<any> {
+    const a = schema.parse(args ?? {});
+    const options = {
+      style: a.style,
+      portraitSize: a.portrait_size ?? 1024,
+      tokenSize: a.token_size ?? 512,
+      updatePlaced: a.update_placed !== false,
+      folder: a.folder ?? 'actors',
+      seed: a.seed,
+    };
+    const results: Array<Record<string, any>> = [];
+    for (const entry of a.actors) {
+      try {
+        results.push({ success: true, ...(await this.makeOne(entry, options)) });
+      } catch (error) {
+        this.logger.error('Failed to make actor art', error);
+        results.push({ success: false, actor: entry.actor, error: error instanceof Error ? error.message : 'Unknown error' });
+      }
+    }
+    const failed = results.filter(r => !r.success).length;
+    return { success: failed < results.length, made: results.length - failed, failed, results };
+  }
+}

@@ -0,0 +1,47 @@
+import { describe, expect, it, vi } from 'vitest';
+import { ChatControlTools } from './chat-control.js';
+
+function make(response: any = { success: true }) {
+  const query = vi.fn(async () => response);
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  return { tools: new ChatControlTools({ foundryClient: { query } as any, logger }), query };
+}
+
+describe('chat tool', () => {
+  it('is exposed with action required', () => {
+    const def = make().tools.getToolDefinitions()[0]!;
+    expect(def.name).toBe('chat');
+    expect(def.inputSchema.required).toEqual(['action']);
+  });
+  it('sends read and narrate to the chat query', async () => {
+    const { tools, query } = make({ success: true, messages: [] });
+    await tools.handleChat({ action: 'read', since: 'abc', limit: 5 });
+    expect(query).toHaveBeenLastCalledWith('foundry-mcp-bridge.chat', { action: 'read', since: 'abc', limit: 5 }, 30000);
+    await tools.handleChat({ action: 'narrate', content: 'Dusk falls.', whisperTo: ['Claudio'] });
+    expect(query).toHaveBeenLastCalledWith('foundry-mcp-bridge.chat', { action: 'narrate', content: 'Dusk falls.', whisperTo: ['Claudio'] }, 30000);
+  });
+  it('sends say through the existing speak query with only the speaking fields', async () => {
+    const { tools, query } = make({ success: true, id: 'm1' });
+    await tools.handleChat({ action: 'say', actorIdentifier: 'Sildar', content: 'Hold!', chatLog: true });
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.createChatMessage', { actorIdentifier: 'Sildar', content: 'Hold!', chatLog: true });
+  });
+  it('rejects bad input and refused requests', async () => {
+    const { tools } = make();
+    await expect(tools.handleChat({ action: 'shout' })).rejects.toThrow();
+    await expect(tools.handleChat({ action: 'say', content: 'hi' })).rejects.toThrow('actorIdentifier or tokenId');
+    await expect(tools.handleChat({ action: 'say', actorIdentifier: 'A' })).rejects.toThrow('needs content');
+    await expect(tools.handleChat({ action: 'narrate' })).rejects.toThrow('needs content');
+    await expect(tools.handleChat({ action: 'wait', timeout_s: 20 })).rejects.toThrow();
+    await expect(make({ success: false, error: 'Access denied' }).tools.handleChat({ action: 'read' })).rejects.toThrow('Access denied');
+  });
+});
+
+describe('chat tool description', () => {
+  it('points to the live feed instead of a blocking wait', () => {
+    const def = make().tools.getToolDefinitions()[0]!;
+    expect(def.description).toContain('ws://127.0.0.1:31417');
+    expect(def.description).toContain('Monitor');
+    expect(def.description).not.toContain('timeout_s');
+    expect(def.description).toContain('typed by a person');
+  });
+});
diff --git a/packages/mcp-server/src/tools/chat-control.ts b/packages/mcp-server/src/tools/chat-control.ts

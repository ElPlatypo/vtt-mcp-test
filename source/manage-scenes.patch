@@ -0,0 +1,63 @@
+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+
+export interface RulesToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+const schema = z
+  .object({
+    action: z.enum(['search', 'read', 'sources']).optional(),
+    query: z.string().min(2).max(200).optional(),
+    uuid: z.string().min(1).optional(),
+    uuids: z.array(z.string().min(1)).min(1).max(5).optional(),
+    sources: z.array(z.string().min(1)).max(10).optional(),
+    limit: z.number().int().min(1).max(10).optional(),
+    max_chars: z.number().int().min(500).max(12000).optional(),
+  })
+  .strict();
+
+export class RulesTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: RulesToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'RulesTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'rules',
+        description:
+          'Look up the game rules instead of answering from memory: it searches the rules journals the game system ships (for dnd5e the SRD rules and the newer rules compendium: combat, conditions, hiding, surprise, actions, spells rules, glossary) and the world\'s own rules journals (any world journal with "rules", "house" or "reference" in its name, where house rules can be kept). ' +
+          'Use it whenever a ruling matters (what an action does, how a condition works, who is surprised), then follow what it says. ' +
+          'search {query, sources?, limit?(5)} returns the best pages with a short snippet, journal, source and uuid; read {uuid | uuids, max_chars?(4000)} returns the page text (a journal uuid lists its pages); sources lists where rules are searched. Search with the key words (hiding, surprise, grapple, opportunity attack), not a whole sentence. Needs the Foundry tab open in a browser.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: { type: 'string', enum: ['search', 'read', 'sources'], description: 'search (default), read or sources' },
+            query: { type: 'string', description: 'search: key words of the rule you need' },
+            uuid: { type: 'string', description: 'read: the uuid of a page from a search result' },
+            uuids: { type: 'array', items: { type: 'string' }, description: 'read: up to 5 pages at once' },
+            sources: { type: 'array', items: { type: 'string' }, description: 'search: only these sources (ids from action sources, or "world")' },
+            limit: { type: 'number', description: 'search: how many pages (default 5, max 10)' },
+            max_chars: { type: 'number', description: 'read: cut each page at about this many characters (default 4000, max 12000)' },
+          },
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handleRules(args: unknown): Promise<any> {
+    const a = schema.parse(args ?? {});
+    this.logger.info('Rules lookup', { action: a.action ?? 'search' });
+    const result = await this.foundryClient.query('foundry-mcp-bridge.rules', a, 60000);
+    if (result?.success === false) throw new Error(result.error || 'Request was refused');
+    return result;
+  }
+}

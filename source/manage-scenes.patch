+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+
+export interface ShareToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+const schema = z
+  .object({
+    image: z.string().min(1).optional(),
+    title: z.string().min(1).max(200).optional(),
+    journal: z.string().min(1).optional(),
+    users: z.array(z.string().min(1)).max(20).optional(),
+    chat: z.boolean().optional(),
+  })
+  .strict()
+  .refine(a => (a.image === undefined) !== (a.journal === undefined), { message: 'Give either image or journal (not both)' });
+
+export class ShareTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: ShareToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'ShareTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'share-with-players',
+        description:
+          'Show something to the players. image: a Foundry file path (e.g. a handout or map from uploads) opens full-screen for every player, with an optional title. journal: a journal id or name opens for the players; players who cannot yet see it are given observer access first (users limits this to named players, default all). chat: true also posts it to the chat (the picture, or a link to the journal).',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            image: { type: 'string', description: 'Foundry file path of the picture to show' },
+            title: { type: 'string', description: 'Title shown with the picture' },
+            journal: { type: 'string', description: 'Journal id or name to show' },
+            users: { type: 'array', maxItems: 20, items: { type: 'string' }, description: 'Player names or ids (journal only; default all players)' },
+            chat: { type: 'boolean', description: 'Also post to the chat' },
+          },
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handleShareWithPlayers(args: unknown): Promise<any> {
+    const a = schema.parse(args ?? {});
+    this.logger.info('Sharing with players', { image: a.image, journal: a.journal });
+    const result = await this.foundryClient.query('foundry-mcp-bridge.share-with-players', a);
+    if (result?.success === false) throw new Error(result.error || 'Request was refused');
+    return result;
+  }
+}

+    vi.setSystemTime(new Date(2026, 10, 12, 11, 0));
+    await da.manageSceneBackups({ action: 'backup', scene: 'Cave', label: 'two' });
+    vi.useRealTimers();
+    const all = await da.manageSceneBackups({ action: 'list' });
+    expect(all.total).toBe(2);

+  it('reads a custom host, port and https flag', () => {
+    expect(
+      readComfyForm({
+        mapGenMode: 'custom',
+        mapGenCustomHost: ' nexus ',
+        mapGenCustomPort: '8188',
+        mapGenCustomSecure: true,
+      })
+    ).toEqual({ ok: true, value: { mode: 'custom', host: 'nexus', port: 8188, secure: true } });
+    expect(
+      readComfyForm({ mapGenMode: 'custom', mapGenCustomHost: '127.0.0.1', mapGenCustomPort: 8188 })

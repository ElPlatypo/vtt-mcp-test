+    const generation = (game as any).release?.generation ?? 0;
+    if (generation >= 14) {
+      const level = scene.levels?.contents?.[0];
+      if (level) {
+        await level.update({ background: { src } });
+      } else if (src) {
+        await scene.createEmbeddedDocuments('Level', [{ name: 'Base', background: { src } }]);
+      }
+    } else {
+      await scene.update({ background: { src } });
+    }
+  }
+
+  /**
+   * Set the canvas colour behind the background. Foundry v14 has no Scene#backgroundColor
+   * field in the document source: the colour lives on the first Level's background
+   * (Scene#backgroundColor is only a derived getter, and writing it is silently ignored).
+   * Verified against a v14.369 world.
+   */
+  private async applySceneBackgroundColor(scene: any, color: string): Promise<void> {
+    const level = scene.levels?.contents?.[0];
+    if (level) {
+      await level.update({ background: { color } });
+    } else {
+      await scene.createEmbeddedDocuments('Level', [{ name: 'Base', background: { color } }]);
+    }
+  }
+
+  /**
+   * Compare what was requested with what the scene reports afterwards, so a write that
+   * Foundry silently dropped is reported instead of claimed as a success.
+   */
+  private findUnappliedSceneChanges(
+    options: Record<string, any>,
+    summary: Record<string, any>
+  ): string[] {
+    const warnings: string[] = [];
+    const same = (wanted: unknown, actual: unknown): boolean => {
+      if (typeof wanted === 'number' && typeof actual === 'number') {
+        return Math.abs(wanted - actual) < 1e-6;
+      }
+      if (typeof wanted === 'string' && typeof actual === 'string') {
+        return wanted.toLowerCase() === actual.toLowerCase();
+      }
+      return wanted === actual;
+    };
+    const check = (label: string, wanted: unknown, actual: unknown) => {
+      if (wanted === undefined) return;
+      if (!same(wanted, actual)) {
+        warnings.push(
+          `${label} was requested as ${JSON.stringify(wanted)} but the scene reports ${JSON.stringify(actual ?? null)}`
+        );
+      }
+    };
+
+    check('name', typeof options.name === 'string' ? options.name.trim() : undefined, summary.name);
+    check('width', options.width, summary.width);
+    check('height', options.height, summary.height);
+    check('padding', options.padding, summary.padding);
+    check('grid_size', options.grid_size, summary.grid?.size);
+    check('grid_distance', options.grid_distance, summary.grid?.distance);
+    check('grid_units', options.grid_units, summary.grid?.units);
+    check('grid_type', options.grid_type, summary.grid?.type);
+    // null means "reset to default" on v14, so only a concrete colour can be compared.
+    if (typeof options.background_color === 'string') {
+      check('background_color', options.background_color, summary.backgroundColor);
+    }
+    check('token_vision', options.token_vision, summary.tokenVision);
+    check('darkness', options.darkness, summary.darkness);
+    check('global_light', options.global_light, summary.globalLight);
+    check('navigation', options.navigation, summary.navigation);
+    check('nav_name', options.nav_name, summary.navName);
+    check('background', options.background, summary.background);
+
+    return warnings;
+  }
+
+  /**
+   * Create, update or describe scenes.
+   * create: builds a new scene (name required).
+   * update: edits an existing scene found by id or exact name (case-insensitive).
+   * describe: lists all scenes, or one scene when scene_identifier is given.
+   * Never deletes anything.
+   */
+  async manageScenes(options: {
+    action: 'create' | 'update' | 'describe';
+    scene_identifier?: string;
+    name?: string;
+    background?: string | null;
+    width?: number;
+    height?: number;
+    padding?: number;
+    grid_size?: number;
+    grid_distance?: number;
+    grid_units?: string;
+    grid_type?: number;
+    background_color?: string | null;
+    token_vision?: boolean;
+    darkness?: number;
+    global_light?: boolean;
+    navigation?: boolean;
+    nav_name?: string;
+    activate?: boolean;
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      if (options.action === 'describe') {
+        if (options.scene_identifier) {
+          const scene = this.findSceneByIdentifier(options.scene_identifier);
+          return { success: true, scene: this.summarizeScene(scene) };
+        }
+        const scenes = (game.scenes?.contents || []) as any[];
+        return { success: true, scenes: scenes.map(scene => this.summarizeScene(scene)) };
+      }
+
+      if (options.action !== 'create' && options.action !== 'update') {
+        throw new Error(`Unknown action: ${String(options.action)} (create | update | describe)`);
+      }
+
+      const permissionCheck = permissionManager.checkWritePermission('modifyScene', {});
+      if (!permissionCheck.allowed) {
+        throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${permissionCheck.reason}`);
+      }
+
+      if (options.background !== undefined && options.background !== null) {
+        if (typeof options.background !== 'string' || !options.background.trim()) {
+          throw new Error('background must be a file path string or null to clear it');
+        }
+      }
+
+      const data = this.buildSceneData(options);
+
+      // On v14 the canvas colour is a Level property, not a Scene field: split it out
+      // so it is not sent to Scene.create / scene.update (where it is silently dropped).
+      let levelColor: string | undefined;
+      if ('backgroundColor' in data && ((game as any).release?.generation ?? 0) >= 14) {
+        levelColor = data.backgroundColor ?? '#999999';
+        delete data.backgroundColor;
+      }
+
+      let scene: any;
+      if (options.action === 'create') {
+        if (!data.name) {
+          throw new Error('name is required for create');
+        }
+        scene = await (globalThis as any).Scene.create(data);
+        if (!scene) {
+          throw new Error('Foundry did not return the created scene');
+        }
+      } else {
+        if (!options.scene_identifier) {
+          throw new Error('scene_identifier is required for update');
+        }
+        scene = this.findSceneByIdentifier(options.scene_identifier);
+        const hasChange =
+          Object.keys(data).length > 0 ||
+          options.background !== undefined ||
+          levelColor !== undefined ||
+          options.activate === true;
+        if (!hasChange) {
+          throw new Error('Nothing to update: pass at least one field to change');
+        }
+        if (Object.keys(data).length > 0) {
+          await scene.update(data);
+        }
+      }
+
+      if (options.background !== undefined) {
+        await this.applySceneBackground(scene, options.background);
+      }
+      if (levelColor !== undefined) {
+        await this.applySceneBackgroundColor(scene, levelColor);
+      }
+      if (options.activate === true) {
+        await scene.activate();
+      }
+
+      this.auditLog(`manageScenes:${options.action}`, options, 'success');
+
+      const summary = this.summarizeScene(scene);
+      const warnings = this.findUnappliedSceneChanges(options, summary);
+      return {
+        success: true,
+        action: options.action,
+        scene: summary,
+        ...(warnings.length > 0 ? { warnings } : {}),
+      };
+    } catch (error) {
+      this.auditLog(
+        `manageScenes:${options?.action}`,
+        options,
+        'failure',
+        error instanceof Error ? error.message : 'Unknown error'
+      );
+      throw new Error(
+        `Failed to ${options?.action ?? 'manage'} scene: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+
+  // ===== SCENE OBJECTS (TOKENS AND LIGHTS PLACED IN GRID SQUARES) =====
+
+  /** The scene named by the caller, or the one the GM is looking at. */
+  private resolveSceneForObjects(identifier?: string): any {
+    if (identifier) return this.findSceneByIdentifier(identifier);
+    const scene = (game.scenes as any)?.viewed ?? (game.scenes as any)?.current;
+    if (!scene) throw new Error('No scene is open; pass scene (id or name)');
+    return scene;
+  }
+
+  private isToolObject(doc: any): boolean {
+    const flags = doc?.flags?.[this.moduleId] ?? doc?.getFlag?.(this.moduleId, CREATED_BY_FLAG);
+    if (flags === true) return true;
+    return !!flags?.[CREATED_BY_FLAG];
+  }
+
+  private findActorForPlacement(identifier: string): any {
+    const actors = (((game as any).actors?.contents || []) as any[]);
+    const byId = actors.find(a => a.id === identifier);
+    if (byId) return byId;
+    const wanted = identifier.trim().toLowerCase();
+    const matches = actors.filter(a => String(a.name ?? '').toLowerCase() === wanted);
+    if (matches.length === 1) return matches[0];
+    if (matches.length > 1) {
+      throw new Error(
+        `Several actors are named "${identifier}" (ids: ${matches.map(a => a.id).join(', ')}); use the id`
+      );
+    }
+    throw new Error(`Actor not found: "${identifier}"`);
+  }
+
+  private describeSceneObjects(scene: any, geom: GridGeometry, kinds: string[]): Record<string, any> {
+    const out: Record<string, any> = {
+      scene: { id: scene.id, name: scene.name },
+      grid: {
+        columns: geom.columns,
+        rows: geom.rows,
+        squarePixels: geom.size,
+        squareDistance: geom.distance,
+        units: geom.units,
+        originPixels: { x: geom.originX, y: geom.originY },
+      },
+    };
+    if (kinds.includes('token')) {
+      out.tokens = (((scene.tokens?.contents || []) as any[]).map(t => ({
+        id: t.id,
+        name: t.name,
+        actorId: t.actorId ?? null,
+        ...pixelsToSquares(geom, t.x, t.y),
+        width: t.width,
+        height: t.height,
+        hidden: !!t.hidden,
+        createdByTool: this.isToolObject(t),
+      })));
+    }
+    if (kinds.includes('light')) {
+      out.lights = (((scene.lights?.contents || []) as any[]).map(l => ({
+        id: l.id,
+        ...pixelsToSquares(geom, l.x, l.y),
+        brightSquares: (l.config?.bright ?? 0) / (geom.distance || 1),
+        dimSquares: (l.config?.dim ?? 0) / (geom.distance || 1),
+        color: l.config?.color ? String(l.config.color) : null,
+        hidden: !!l.hidden,
+        createdByTool: this.isToolObject(l),
+      })));
+    }
+    if (kinds.includes('wall')) {
+      const walls = ((scene.walls?.contents || []) as any[]).map(w => {
+        const a = pixelsToSquares(geom, w.c?.[0], w.c?.[1]);
+        const b = pixelsToSquares(geom, w.c?.[2], w.c?.[3]);
+        return {
+          id: w.id,
+          from: [a.x, a.y],
+          to: [b.x, b.y],
+          door: w.door === 1 ? 'door' : w.door === 2 ? 'secret_door' : null,
+          createdByTool: this.isToolObject(w),
+        };
+      });
+      out.wallCount = walls.length;
+      out.walls = walls.slice(0, 400);
+      if (walls.length > 400) out.wallsTruncated = true;
+    }
+    if (kinds.includes('note')) {
+      out.notes = ((scene.notes?.contents || []) as any[]).map(n => ({
+        id: n.id,
+        ...pixelsToSquares(geom, n.x, n.y),
+        text: n.text ?? '',
+        journalId: n.entryId ?? null,
+        pageId: n.pageId ?? null,
+        createdByTool: this.isToolObject(n),
+      }));
+    }
+    return out;
+  }
+
+  /**
+   * Place tokens, lights, walls and map pins by grid square, describe what is on a scene, or remove objects
+   * this tool created (never anything else).
+   */
+  async manageSceneObjects(options: {
+    action: 'place' | 'describe' | 'remove';
+    scene?: string;
+    objects?: Array<Record<string, any>>;
+    ids?: string[];
+    all_mine?: boolean;
+    kind?: 'token' | 'light' | 'wall' | 'note';
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      const action = options.action;
+      if (action !== 'place' && action !== 'describe' && action !== 'remove') {
+        throw new Error(`Unknown action: ${String(action)} (place | describe | remove)`);
+      }
+      const scene = this.resolveSceneForObjects(options.scene);
+      const geom = getGridGeometry(scene);
+
+      if (action === 'describe') {
+        const kinds = options.kind ? [options.kind] : ['token', 'light', 'wall', 'note'];
+        return { success: true, ...this.describeSceneObjects(scene, geom, kinds) };
+      }
+
+      const permissionCheck = permissionManager.checkWritePermission('modifyScene', {});
+      if (!permissionCheck.allowed) {
+        throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${permissionCheck.reason}`);
+      }
+
+      const flagData = { [this.moduleId]: { [CREATED_BY_FLAG]: true } };
+
+      if (action === 'place') {
+        const specs = options.objects ?? [];
+        if (!Array.isArray(specs) || specs.length === 0) {
+          throw new Error('objects must be a non-empty list');
+        }
+        if (specs.length > 200) throw new Error('At most 200 objects per call');
+
+        const tokenData: any[] = [];
+        const lightData: any[] = [];
+        const wallData: any[] = [];
+        const noteData: any[] = [];
+        const warnings: string[] = [];
+
+        specs.forEach((spec, index) => {
+          const label = `objects[${index}]`;
+          if (spec.kind === 'light') {
+            const data = buildLightData(spec as any, geom, label);
+            lightData.push({ ...data, flags: flagData });
+          } else if (spec.kind === 'token') {
+            assertInsideScene(geom, spec.x, spec.y, label);
+            if (!spec.actor || typeof spec.actor !== 'string') {
+              throw new Error(`${label}: actor (id or exact name) is required for a token`);
+            }
+            if (spec.x >= geom.columns || spec.y >= geom.rows) {
+              throw new Error(
+                `${label}: a token's x and y are its top-left square (0 to ${geom.columns - 1} across, 0 to ${geom.rows - 1} down)`
+              );
+            }
+            if (spec.disposition !== undefined && ![-1, 0, 1].includes(spec.disposition)) {
+              throw new Error(`${label}: disposition must be -1 (hostile), 0 (neutral) or 1 (friendly)`);
+            }
+            const actor = this.findActorForPlacement(spec.actor);
+            const proto = (actor as any).prototypeToken.toObject();
+            if (proto.texture?.src?.startsWith('http')) proto.texture.src = null;
+            const position = squaresToPixels(geom, spec.x, spec.y);
+            tokenData.push({
+              ...proto,
+              ...(spec.name ? { name: String(spec.name) } : {}),
+              actorId: actor.id,
+              x: position.x,
+              y: position.y,
+              ...(spec.hidden !== undefined ? { hidden: !!spec.hidden } : {}),
+              ...(spec.disposition !== undefined ? { disposition: spec.disposition } : {}),
+              ...(spec.elevation !== undefined ? { elevation: Number(spec.elevation) } : {}),
+              flags: { ...(proto.flags ?? {}), ...flagData },
+            });
+          } else if (spec.kind === 'wall') {
+            for (const data of buildWallData(spec as any, geom, label)) {
+              wallData.push({ ...data, flags: flagData });
+            }
+            if (wallData.length > MAX_WALL_SEGMENTS) {
+              throw new Error(`At most ${MAX_WALL_SEGMENTS} wall segments per call`);
+            }
+          } else if (spec.kind === 'note') {
+            assertInsideScene(geom, spec.x, spec.y, label);
+            if (!spec.journal || typeof spec.journal !== 'string') {
+              throw new Error(`${label}: journal (id or exact name) is required for a map pin`);
+            }
+            const journal = this.findJournalByIdentifier(spec.journal);
+            let pageId: string | undefined;
+            if (spec.page !== undefined) {
+              const pages = (journal.pages?.contents || []) as any[];
+              const wantedPage = String(spec.page).trim().toLowerCase();
+              const matches = pages.filter(
+                p => p.id === spec.page || String(p.name ?? '').toLowerCase() === wantedPage
+              );
+              if (matches.length === 0) {
+                throw new Error(`${label}: page "${spec.page}" not found in journal "${journal.name}"`);
+              }
+              if (matches.length > 1) {
+                throw new Error(`${label}: several pages match "${spec.page}"; use the page id`);
+              }
+              pageId = matches[0].id;
+            }
+            const position = squaresToPixels(geom, spec.x, spec.y);
+            const size = spec.icon_size === undefined ? 40 : Number(spec.icon_size);
+            const fontSize = spec.font_size === undefined ? 32 : Number(spec.font_size);
+            if (!Number.isFinite(size) || size < 32 || size > 512) {
+              throw new Error(`${label}: icon_size must be a number from 32 to 512`);
+            }
+            if (!Number.isFinite(fontSize) || fontSize < 8 || fontSize > 128) {
+              throw new Error(`${label}: font_size must be a number from 8 to 128`);
+            }
+            noteData.push({
+              x: position.x,
+              y: position.y,
+              entryId: journal.id,
+              ...(pageId ? { pageId } : {}),
+              text: spec.text === undefined ? journal.name : String(spec.text),
+              texture: { src: spec.icon ? String(spec.icon) : 'icons/svg/book.svg' },
+              iconSize: size,
+              fontSize,
+              global: !!spec.global,
+              flags: flagData,
+            });
+          } else {
+            throw new Error(`${label}: kind must be "token", "light", "wall" or "note"`);
+          }
+        });
+
+        const created: Array<{ kind: string; id: string; x: number; y: number }> = [];
+        if (tokenData.length > 0) {
+          const docs = (await scene.createEmbeddedDocuments('Token', tokenData)) as any[];
+          for (const doc of docs ?? []) {
+            created.push({ kind: 'token', id: doc.id, ...pixelsToSquares(geom, doc.x, doc.y) });
+          }
+        }
+        if (lightData.length > 0) {
+          const docs = (await scene.createEmbeddedDocuments('AmbientLight', lightData)) as any[];
+          for (const doc of docs ?? []) {
+            created.push({ kind: 'light', id: doc.id, ...pixelsToSquares(geom, doc.x, doc.y) });
+          }
+        }
+
+        if (wallData.length > 0) {
+          const docs = (await scene.createEmbeddedDocuments('Wall', wallData)) as any[];
+          for (const doc of docs ?? []) {
+            const a = pixelsToSquares(geom, doc.c?.[0], doc.c?.[1]);
+            created.push({ kind: 'wall', id: doc.id, ...a });
+          }
+        }
+        if (noteData.length > 0) {
+          const docs = (await scene.createEmbeddedDocuments('Note', noteData)) as any[];
+          for (const doc of docs ?? []) {
+            created.push({ kind: 'note', id: doc.id, ...pixelsToSquares(geom, doc.x, doc.y) });
+          }
+        }
+
+        this.auditLog('manageSceneObjects:place', { scene: scene.id, count: specs.length }, 'success');
+        return {
+          success: true,
+          action,
+          scene: { id: scene.id, name: scene.name },
+          created,
+          ...(warnings.length > 0 ? { warnings } : {}),
+        };
+      }
+
+      // remove: only objects this tool created.
+      const ids = options.ids ?? [];
+      if (!options.all_mine && ids.length === 0) {
+        throw new Error('Pass ids, or all_mine: true, to say what to remove');
+      }
+      const kinds: Array<'token' | 'light' | 'wall' | 'note'> = options.kind
+        ? [options.kind]
+        : ['token', 'light', 'wall', 'note'];
+      const removed: Array<{ kind: string; id: string }> = [];
+      const skipped: Array<{ id: string; reason: string }> = [];
+      const collections: Record<string, { collection: any; documentName: string }> = {
+        token: { collection: scene.tokens, documentName: 'Token' },
+        light: { collection: scene.lights, documentName: 'AmbientLight' },
+        wall: { collection: scene.walls, documentName: 'Wall' },
+        note: { collection: scene.notes, documentName: 'Note' },
+      };
+
+      const wanted = new Set(ids);
+      const found = new Set<string>();
+      for (const kind of kinds) {
+        const { collection, documentName } = collections[kind];
+        const docs = ((collection?.contents || []) as any[]).filter(doc => {
+          if (!this.isToolObject(doc)) return false;
+          return options.all_mine ? true : wanted.has(doc.id);
+        });
+        for (const doc of docs) found.add(doc.id);
+        if (docs.length > 0) {
+          await scene.deleteEmbeddedDocuments(
+            documentName,
+            docs.map(d => d.id)
+          );
+          docs.forEach(d => removed.push({ kind, id: d.id }));
+        }
+      }
+      for (const id of ids) {
+        if (!found.has(id)) {
+          skipped.push({
+            id,
+            reason: 'not found, or not created by this tool (only its own objects can be removed)',
+          });
+        }
+      }
+
+      this.auditLog('manageSceneObjects:remove', { scene: scene.id, count: removed.length }, 'success');
+      return {
+        success: true,
+        action,
+        scene: { id: scene.id, name: scene.name },
+        removed,
+        ...(skipped.length > 0 ? { skipped } : {}),
+      };
+    } catch (error) {
+      this.auditLog(
+        `manageSceneObjects:${options?.action}`,
+        { scene: options?.scene },
+        'failure',
+        error instanceof Error ? error.message : 'Unknown error'
+      );
+      throw new Error(
+        `Failed to ${options?.action ?? 'manage'} scene objects: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+
+  /**
+   * Find the grid drawn into a map picture: pixels per square and where the lines start. Works
+   * on a scene's background or on any image in Foundry's files, and can look at one region
+   * only (grids are often faint and drawn just on the floors). Read-only.
+   */
+  async measureGrid(options: {
+    scene?: string;
+    image?: string;
+    region?: { x: number; y: number; width: number; height: number };
+    min_size?: number;
+    max_size?: number;
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      let scene: any;
+      let src: string | null = null;
+      if (options.image) {
+        if (typeof options.image !== 'string' || /^[a-z]+:\/\//i.test(options.image)) {
+          throw new Error('image must be a path in the Foundry files, such as worlds/<world>/uploads/map.png');
+        }
+        src = options.image;
+      } else {
+        scene = this.resolveSceneForObjects(options.scene);
+        src =
+          scene._source?.background?.src || scene.levels?.contents?.[0]?.background?.src || null;
+        if (!src) throw new Error('The scene has no background image to measure');
+      }
+
+      const image = await new Promise<HTMLImageElement>((resolve, reject) => {
+        const img = new Image();
+        img.onload = () => resolve(img);
+        img.onerror = () => reject(new Error(`The image could not be loaded: ${src}`));
+        img.src = src!;
+      });
+      const width = image.naturalWidth;
+      const height = image.naturalHeight;
+      if (width * height > 40_000_000) {
+        throw new Error(`The image is too large to measure (${width}x${height})`);
+      }
+
+      const canvas = document.createElement('canvas');
+      canvas.width = width;
+      canvas.height = height;
+      const ctx = canvas.getContext('2d', { willReadFrequently: true });
+      if (!ctx) throw new Error('This browser cannot read the picture');
+      ctx.drawImage(image, 0, 0);
+      let rgba: Uint8ClampedArray;
+      try {
+        rgba = ctx.getImageData(0, 0, width, height).data;
+      } catch {
+        throw new Error('The browser refused to read the picture (it is from another site)');
+      }
+      const gray = new Uint8Array(width * height);
+      for (let i = 0; i < gray.length; i++) {
+        gray[i] = 0.299 * rgba[i * 4]! + 0.587 * rgba[i * 4 + 1]! + 0.114 * rgba[i * 4 + 2]!;
+      }
+
+      const measured = measureGridInPicture(gray, width, height, {
+        ...(options.region ? { region: options.region } : {}),
+        ...(options.min_size !== undefined ? { minSize: options.min_size } : {}),
+        ...(options.max_size !== undefined ? { maxSize: options.max_size } : {}),
+      });
+
+      const notes: string[] = [];
+      if (measured.detected && measured.size) {
+        if (measured.size < 50) {
+          const factor = Math.ceil(50 / measured.size);
+          notes.push(
+            `Foundry's smallest grid is 50 px. To use this grid, make the scene ${factor}x the image size (width ${width * factor}, height ${height * factor}) with grid_size ${measured.size * factor}.`
+          );
+        } else {
+          notes.push(
+            `With the scene as large as the image (${width}x${height}), set grid_size to ${measured.size}.`
+          );
+        }
+      } else {
+        notes.push(
+          'No regular grid was found. If the picture has a faint grid on its floors, pass a region that covers only a floor area. For a map without a grid, pick a grid_size from divisors (whole squares) or from the size of a feature you can measure, such as a door or corridor.'
+        );
+      }
+
+      return {
+        success: true,
+        source: options.image ? 'image' : 'scene background',
+        ...(scene ? { scene: { id: scene.id, name: scene.name, grid_size: scene.grid?.size } } : {}),
+        image: src,
+        width,
+        height,
+        ...measured,
+        notes,
+      };
+    } catch (error) {
+      return { success: false, error: error instanceof Error ? error.message : 'Could not measure the grid' };
+    }
+  }
+
+  /**
+   * Draw the scene image with a numbered grid and its tokens and lights, and return it as a
+   * PNG so positions can be checked in grid squares. Read-only.
+   */
+  async previewScene(options: {
+    scene?: string;
+    max_size?: number;
+    label_every?: number;
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      const scene = this.resolveSceneForObjects(options.scene);
+      const geom = getGridGeometry(scene);
+      const maxSize = options.max_size ?? 1600;
+      if (typeof maxSize !== 'number' || !Number.isFinite(maxSize) || maxSize < 200 || maxSize > 3000) {
+        throw new Error('max_size must be a number from 200 to 3000');
+      }
+      if (
+        options.label_every !== undefined &&
+        (!Number.isInteger(options.label_every) || options.label_every < 1 || options.label_every > 50)
+      ) {
+        throw new Error('label_every must be a whole number from 1 to 50');
+      }
+      const scale = previewScale(geom, maxSize);
+      const labelEvery = options.label_every ?? defaultLabelEvery(geom, scale);
+
+      const warnings: string[] = [];
+      const src =
+        scene._source?.background?.src || scene.levels?.contents?.[0]?.background?.src || null;
+      let image: any;
+      if (src) {
+        try {
+          image = await new Promise<any>((resolve, reject) => {
+            const img = new Image();
+            img.onload = () => resolve(img);
+            img.onerror = () => reject(new Error('the image could not be loaded'));
+            img.src = src;
+          });
+        } catch (error) {
+          warnings.push(
+            `Background ${src}: ${error instanceof Error ? error.message : 'could not be drawn'}; drawn on grey`
+          );
+        }
+      } else {
+        warnings.push('The scene has no background image; drawn on grey');
+      }
+
+      const tokens: PreviewToken[] = (((scene.tokens?.contents || []) as any[]).map(t => {
+        const topLeft = pixelsToSquares(geom, t.x, t.y);
+        return {
+          name: String(t.name ?? ''),
+          ...topLeft,
+          width: Number(t.width ?? 1),
+          height: Number(t.height ?? 1),
+        };
+      }));
+      const lights: PreviewLight[] = (((scene.lights?.contents || []) as any[]).map(l => {
+        const centre = pixelsToSquares(geom, l.x, l.y);
+        return {
+          ...centre,
+          bright: (l.config?.bright ?? 0) / (geom.distance || 1),
+          dim: (l.config?.dim ?? 0) / (geom.distance || 1),
+          color: l.config?.color ? String(l.config.color) : undefined,
+        };
+      }));
+
+      const walls: PreviewWall[] = ((scene.walls?.contents || []) as any[]).map(w => {
+        const a = pixelsToSquares(geom, w.c?.[0], w.c?.[1]);
+        const b = pixelsToSquares(geom, w.c?.[2], w.c?.[3]);
+        return { x1: a.x, y1: a.y, x2: b.x, y2: b.y, door: Number(w.door ?? 0) };
+      });
+      const notes: PreviewNote[] = ((scene.notes?.contents || []) as any[]).map(n => ({
+        ...pixelsToSquares(geom, n.x, n.y),
+        text: String(n.text ?? ''),
+      }));
+
+      const canvas = document.createElement('canvas');
+      canvas.width = Math.round(geom.sceneWidth * scale);
+      canvas.height = Math.round(geom.sceneHeight * scale);
+      const ctx = canvas.getContext('2d');
+      if (!ctx) throw new Error('This browser cannot draw the preview');
+      const size = drawPreview(ctx, { geom, scale, labelEvery, tokens, lights, walls, notes, image });
+
+      let dataUrl: string;
+      try {
+        dataUrl = canvas.toDataURL('image/png');
+      } catch {
+        throw new Error('The browser refused to export the picture (the background image is from another site)');
+      }
+      const imageBase64 = dataUrl.slice(dataUrl.indexOf(',') + 1);
+
+      return {
+        success: true,
+        scene: { id: scene.id, name: scene.name },
+        mimeType: 'image/png',
+        imageBase64,
+        width: size.width,
+        height: size.height,
+        scale,
+        labelEvery,
+        grid: { columns: geom.columns, rows: geom.rows },
+        tokens: tokens.length,
+        lights: lights.length,
+        walls: walls.length,
+        notes: notes.length,
+        ...(warnings.length > 0 ? { warnings } : {}),
+      };
+    } catch (error) {
+      throw new Error(
+        `Failed to preview scene: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+
+  // ===== INSPECT DOCUMENT (READ-ONLY) =====
+
+  /** Names of the embedded document types a document class has (e.g. Token, Wall for a Scene). */
+  private embeddedTypesOf(documentClass: any): Record<string, string> {
+    const embedded = documentClass?.metadata?.embedded;
+    return embedded && typeof embedded === 'object' ? { ...embedded } : {};
+  }
+
+  /**
+   * Read-only look at Foundry data, so the exact fields and values can be checked instead of
+   * guessed. list: documents of a type. get: one document's data (by type and name/id, or
+   * by uuid), optionally an embedded document or a part of it by path. schema: the fields a
+   * document type has, with their kinds and allowed values.
+   */
+  async inspectDocument(options: {
+    action: 'list' | 'get' | 'schema';
+    type?: string;
+    identifier?: string;
+    uuid?: string;
+    embedded_type?: string;
+    embedded_identifier?: string;
+    path?: string;
+    depth?: number;
+    max_chars?: number;
+    include_embedded?: boolean;
+    search?: string;
+    limit?: number;
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      const action = options.action;
+      if (action !== 'list' && action !== 'get' && action !== 'schema') {
+        throw new Error(`Unknown action: ${String(action)} (list | get | schema)`);
+      }
+
+      const intIn = (value: unknown, name: string, min: number, max: number, fallback: number) => {
+        if (value === undefined) return fallback;
+        if (typeof value !== 'number' || !Number.isInteger(value) || value < min || value > max) {
+          throw new Error(`${name} must be a whole number from ${min} to ${max}`);
+        }
+        return value;
+      };
+      const depth = intIn(options.depth, 'depth', 1, 12, 5);
+      const maxChars = intIn(options.max_chars, 'max_chars', 500, MAX_MAX_CHARS, DEFAULT_MAX_CHARS);
+
+      const checkType = (type: unknown): string => {
+        if (typeof type !== 'string' || !(INSPECTABLE_TYPES as readonly string[]).includes(type)) {
+          throw new Error(`type must be one of: ${INSPECTABLE_TYPES.join(', ')}`);
+        }
+        return type;
+      };
+
+      if (action === 'schema') {
+        const typeName = options.embedded_type ?? options.type;
+        if (typeof typeName !== 'string' || !/^[A-Za-z]+$/.test(typeName)) {
+          throw new Error('schema needs type (or embedded_type), e.g. Scene or Wall');
+        }
+        const documentClass = (CONFIG as any)[typeName]?.documentClass;
+        const fields = documentClass?.schema?.fields;
+        if (!fields) throw new Error(`No document type named "${typeName}"`);
+        const schemaDepth = intIn(options.depth, 'depth', 1, 6, 3);
+        return {
+          success: true,
+          action,
+          type: typeName,
+          embeddedTypes: this.embeddedTypesOf(documentClass),
+          fields: describeFields(fields, schemaDepth),
+        };
+      }
+
+      if (action === 'list') {
+        const type = checkType(options.type);
+        const collection = (game as any).collections?.get(type);
+        if (!collection) throw new Error(`Foundry has no collection for ${type}`);
+        const limit = intIn(options.limit, 'limit', 1, 500, 100);
+        const search = options.search?.trim().toLowerCase();
+        const all = ((collection.contents || []) as any[]).filter(doc => {
+          if (!search) return true;
+          return String(doc.name ?? '').toLowerCase().includes(search);
+        });
+        const items = all.slice(0, limit).map(doc => ({
+          id: doc.id,
+          name: doc.name ?? doc.alias ?? '',
+          ...(doc.type ? { subtype: doc.type } : {}),
+          folder: doc.folder?.name ?? null,
+        }));
+        return {
+          success: true,
+          action,
+          type,
+          total: all.length,
+          ...(all.length > limit ? { shown: limit } : {}),
+          items,
+        };
+      }
+
+      // get
+      let doc: any;
+      if (options.uuid) {
+        doc = await (globalThis as any).fromUuid(options.uuid);
+        if (!doc) throw new Error(`No document found for uuid ${options.uuid}`);
+      } else {
+        const type = checkType(options.type);
+        if (!options.identifier) throw new Error('get needs identifier (id or exact name) or uuid');
+        const collection = (game as any).collections?.get(type);
+        if (!collection) throw new Error(`Foundry has no collection for ${type}`);
+        const docs = (collection.contents || []) as any[];
+        const byId = docs.find(d => d.id === options.identifier);
+        if (byId) {
+          doc = byId;
+        } else {
+          const wanted = options.identifier.trim().toLowerCase();
+          const matches = docs.filter(d => String(d.name ?? '').toLowerCase() === wanted);
+          if (matches.length === 0) throw new Error(`${type} not found: "${options.identifier}"`);
+          if (matches.length > 1) {
+            throw new Error(
+              `Several ${type} documents are named "${options.identifier}" (ids: ${matches.map(m => m.id).join(', ')}); use the id`
+            );
+          }
+          doc = matches[0];
+        }
+      }
+
+      const topEmbedded = this.embeddedTypesOf(doc.constructor);
+
+      if (options.embedded_type) {
+        const embeddedType = options.embedded_type;
+        if (!(embeddedType in topEmbedded)) {
+          throw new Error(
+            `${doc.documentName ?? 'This document'} has no embedded "${embeddedType}". It has: ${Object.keys(topEmbedded).join(', ') || 'none'}`
+          );
+        }
+        const embeddedDocs = ((doc.getEmbeddedCollection(embeddedType)?.contents ?? []) as any[]);
+        if (!options.embedded_identifier) {
+          return {
+            success: true,
+            action,
+            parent: { id: doc.id, name: doc.name },
+            embeddedType,
+            total: embeddedDocs.length,
+            items: embeddedDocs.slice(0, 200).map(e => ({
+              id: e.id,
+              name: e.name ?? '',
+              ...(e.type ? { subtype: e.type } : {}),
+            })),
+          };
+        }
+        const wantedEmbedded = options.embedded_identifier.trim().toLowerCase();
+        const found =
+          embeddedDocs.find(e => e.id === options.embedded_identifier) ??
+          (() => {
+            const matches = embeddedDocs.filter(
+              e => String(e.name ?? '').toLowerCase() === wantedEmbedded
+            );
+            if (matches.length > 1) {
+              throw new Error(
+                `Several ${embeddedType} documents are named "${options.embedded_identifier}" (ids: ${matches.map(m => m.id).join(', ')}); use the id`
+              );
+            }
+            return matches[0];
+          })();
+        if (!found) {
+          throw new Error(`${embeddedType} not found: "${options.embedded_identifier}"`);
+        }
+        doc = found;
+      }
+
+      let data: unknown = doc.toObject();
+      const embeddedHere = Object.values(this.embeddedTypesOf(doc.constructor)) as string[];
+      if (!options.include_embedded && !options.path && data && typeof data === 'object') {
+        const counts: Record<string, string> = {};
+        for (const field of embeddedHere) {
+          const value = (data as any)[field];
+          if (Array.isArray(value)) {
+            counts[field] = `[${value.length} items: use embedded_type to list, or include_embedded]`;
+            (data as any)[field] = counts[field];
+          }
+        }
+      }
+      if (options.path) data = pickPath(data, options.path);
+      const trimmed = trimDepth(data, depth);
+      const { json, truncated } = limitJson(trimmed, maxChars);
+
+      return {
+        success: true,
+        action,
+        document: {
+          documentName: doc.documentName,
+          id: doc.id,
+          name: doc.name ?? null,
+          uuid: doc.uuid ?? null,
+          embeddedTypes: Object.keys(this.embeddedTypesOf(doc.constructor)),
+        },
+        ...(options.path ? { path: options.path } : {}),
+        depth,
+        truncated,
+        // A string, so the size limit is exact; the caller reads it as JSON.
+        data: json,
+        ...(truncated
+          ? {
+              note: `Output was cut at ${maxChars} characters. Use path to read one part, a smaller depth, or a larger max_chars.`,
+            }
+          : {}),
+      };
+    } catch (error) {
+      throw new Error(
+        `Failed to inspect: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+
+  // ===== JOURNAL MANAGEMENT (CREATE / UPDATE / DESCRIBE) =====
+
+  /** Find journals by id or exact (case-insensitive) name; throws if none or several. */
+  private findJournalByIdentifier(identifier: string): any {
+    const journals = ((game as any).journal?.contents || []) as any[];
+    const byId = journals.find(j => j.id === identifier);
+    if (byId) return byId;
+    const wanted = identifier.trim().toLowerCase();
+    const matches = journals.filter(j => String(j.name ?? '').toLowerCase() === wanted);
+    if (matches.length === 1) return matches[0];
+    if (matches.length > 1) {
+      throw new Error(
+        `Several journals are named "${identifier}" (ids: ${matches.map(j => j.id).join(', ')}); use the id`
+      );
+    }
+    throw new Error(`Journal not found: "${identifier}"`);
+  }
+
+  /** Look a document up by kind and name for {{kind: Name}} links. */
+  private lookupLinkTarget(kind: LinkKind, name: string): { id: string; name: string } | 'ambiguous' | null {
+    const collections: Record<LinkKind, any> = {
+      actor: (game as any).actors,
+      scene: (game as any).scenes,
+      journal: (game as any).journal,
+      item: (game as any).items,
+      rolltable: (game as any).tables,
+    };
+    const docs = (collections[kind]?.contents || []) as any[];
+    const wanted = name.trim().toLowerCase();
+    const byId = docs.find(d => d.id === name.trim());
+    if (byId) return { id: byId.id, name: byId.name };
+    const matches = docs.filter(d => String(d.name ?? '').toLowerCase() === wanted);
+    if (matches.length === 1) return { id: matches[0].id, name: matches[0].name };
+    return matches.length > 1 ? 'ambiguous' : null;
+  }
+
+  /** Make journal HTML safe and resolve {{kind: Name}} links. */
+  private prepareJournalHtml(content: string, warnings: string[]): string {
+    const safe = stripUnsafeHtml(content);
+    const resolved = resolveContentLinks(safe, (kind, name) => this.lookupLinkTarget(kind, name));
+    warnings.push(...resolved.warnings);
+    return resolved.html;
+  }
+
+  private summarizeJournal(journal: any, includePages: boolean): Record<string, any> {
+    const level = journal.ownership?.default;
+    const summary: Record<string, any> = {
+      id: journal.id,
+      name: journal.name,
+      folder: journal.folder?.name ?? null,
+      ownership: ownershipName(level),
+      pageCount: journal.pages?.size ?? journal.pages?.contents?.length ?? 0,
+    };
+    if (includePages) {
+      const pages = ((journal.pages?.contents || []) as any[])
+        .slice()
+        .sort((a, b) => (a.sort ?? 0) - (b.sort ?? 0));
+      summary.pages = pages.map(page => ({
+        id: page.id,
+        name: page.name,
+        type: page.type,
+        sort: page.sort,
+        ...(page.type === 'text'
+          ? { content: page.text?.content ?? '' }
+          : page.type === 'image'
+            ? { src: page.src ?? null, caption: page.image?.caption ?? '' }
+            : {}),
+        showTitle: page.title?.show,
+        titleLevel: page.title?.level,
+      }));
+    }
+    return summary;
+  }
+
+  /**
+   * Create, update or describe journals.
+   * create: a journal with exactly the pages given (text pages as HTML, or image pages).
+   * update: rename, move to a folder, change who can see it, and upsert pages (matched by id
+   *   or exact name; created when no page matches). Never removes pages or journals.
+   * describe: lists all journals, or one journal with its full pages.
+   * Text may contain {{actor: Name}}, {{scene: Name}}, {{journal: Name}}, {{item: Name}} or
+   * {{rolltable: Name}} (optionally {{actor: Name | label}}), which become Foundry links.
+   */
+  async manageJournals(options: {
+    action: 'create' | 'update' | 'describe';
+    journal?: string;
+    name?: string;
+    folder?: string;
+    ownership?: OwnershipName;
+    pages?: Array<{
+      id?: string;
+      name?: string;
+      type?: 'text' | 'image';
+      content?: string;
+      src?: string;
+      caption?: string;
+      show_title?: boolean;
+      title_level?: number;
+    }>;
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      if (options.action === 'describe') {
+        if (options.journal) {
+          const journal = this.findJournalByIdentifier(options.journal);
+          return { success: true, journal: this.summarizeJournal(journal, true) };
+        }
+        const journals = (((game as any).journal?.contents || []) as any[]).map(j =>
+          this.summarizeJournal(j, false)
+        );
+        return { success: true, journals };
+      }
+
+      if (options.action !== 'create' && options.action !== 'update') {
+        throw new Error(`Unknown action: ${String(options.action)} (create | update | describe)`);
+      }
+
+      const permissionCheck = permissionManager.checkWritePermission('createActor', {
+        quantity: 1,
+      });
+      if (!permissionCheck.allowed) {
+        throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${permissionCheck.reason}`);
+      }
+
+      if (options.name !== undefined && (typeof options.name !== 'string' || !options.name.trim())) {
+        throw new Error('name must be a non-empty string');
+      }
+      if (options.ownership !== undefined && !(options.ownership in OWNERSHIP_LEVELS)) {
+        throw new Error('ownership must be one of: none, limited, observer, owner');
+      }
+      if (options.folder !== undefined && (typeof options.folder !== 'string' || !options.folder.trim())) {
+        throw new Error('folder must be a non-empty string');
+      }
+      const pageSpecs = options.pages ?? [];
+      if (!Array.isArray(pageSpecs) || pageSpecs.length > 100) {
+        throw new Error('pages must be a list of at most 100 pages');
+      }
+      for (const spec of pageSpecs) {
+        if (spec.type !== undefined && spec.type !== 'text' && spec.type !== 'image') {
+          throw new Error(`Unsupported page type "${String(spec.type)}" (text | image)`);
+        }
+        if (typeof spec.content === 'string' && spec.content.length > 1_000_000) {
+          throw new Error('A page may hold at most 1,000,000 characters');
+        }
+        if (
+          spec.title_level !== undefined &&
+          (!Number.isInteger(spec.title_level) || spec.title_level < 1 || spec.title_level > 6)
+        ) {
+          throw new Error('title_level must be a whole number from 1 to 6');
+        }
+      }
+
+      const warnings: string[] = [];
+      const html = (content: string) => this.prepareJournalHtml(content, warnings);
+
+      // Fields of a page document from a spec (create: all defaults; update: only given).
+      const pageFields = (spec: (typeof pageSpecs)[number], type: 'text' | 'image') => {
+        const fields: Record<string, any> = {};
+        if (type === 'text' && spec.content !== undefined) {
+          fields['text.content'] = html(spec.content);
+        }
+        if (type === 'image') {
+          if (spec.src !== undefined) fields.src = spec.src;
+          if (spec.caption !== undefined) fields['image.caption'] = spec.caption;
+        }
+        if (spec.show_title !== undefined) fields['title.show'] = spec.show_title;
+        if (spec.title_level !== undefined) fields['title.level'] = spec.title_level;
+        return fields;
+      };
+
+      const nest = (flat: Record<string, any>): Record<string, any> => {
+        const out: Record<string, any> = {};
+        for (const [path, value] of Object.entries(flat)) {
+          const parts = path.split('.');
+          let cursor = out;
+          parts.slice(0, -1).forEach(part => {
+            cursor[part] = cursor[part] ?? {};
+            cursor = cursor[part];
+          });
+          cursor[parts[parts.length - 1]] = value;
+        }
+        return out;
+      };
+
+      const newPageData = (spec: (typeof pageSpecs)[number], sort: number) => {
+        const type = spec.type ?? 'text';
+        if (!spec.name || typeof spec.name !== 'string' || !spec.name.trim()) {
+          throw new Error('Every new page needs a name');
+        }
+        if (type === 'image' && !spec.src) {
+          throw new Error(`Image page "${spec.name}" needs a src (a Foundry file path)`);
+        }
+        const data = nest(pageFields(spec, type));
+        if (type === 'text') {
+          data.text = { format: 1, content: '', ...(data.text ?? {}) };
+        }
+        return { name: spec.name.trim(), type, sort, ...data };
+      };
+
+      let journal: any;
+      const pageResults: Array<{ id: string; name: string; type: string; result: string }> = [];
+
+      if (options.action === 'create') {
+        if (!options.name) throw new Error('name is required for create');
+        const folderId = options.folder
+          ? await this.getOrCreateFolder(options.folder.trim(), 'JournalEntry')
+          : null;
+        if (options.folder && !folderId) {
+          warnings.push(`folder "${options.folder}" could not be created; the journal is in the root`);
+        }
+        const pagesData = pageSpecs.map((spec, index) => newPageData(spec, (index + 1) * 100000));
+        journal = await JournalEntry.create({
+          name: options.name.trim(),
+          pages: pagesData,
+          ownership: { default: OWNERSHIP_LEVELS[options.ownership ?? 'none'] },
+          ...(folderId ? { folder: folderId } : {}),
+        } as any);
+        if (!journal) throw new Error('Foundry did not return the created journal');
+        for (const page of ((journal.pages?.contents || []) as any[])) {
+          pageResults.push({ id: page.id, name: page.name, type: page.type, result: 'created' });
+        }
+      } else {
+        if (!options.journal) throw new Error('journal is required for update');
+        journal = this.findJournalByIdentifier(options.journal);
+        const hasChange =
+          options.name !== undefined ||
+          options.folder !== undefined ||
+          options.ownership !== undefined ||
+          pageSpecs.length > 0;
+        if (!hasChange) throw new Error('Nothing to update: pass at least one field to change');
+
+        const journalUpdate: Record<string, any> = {};
+        if (options.name !== undefined) journalUpdate.name = options.name.trim();
+        if (options.ownership !== undefined) {
+          journalUpdate.ownership = { default: OWNERSHIP_LEVELS[options.ownership] };
+        }
+        if (options.folder !== undefined) {
+          const folderId = await this.getOrCreateFolder(options.folder.trim(), 'JournalEntry');
+          if (!folderId) {
+            warnings.push(`folder "${options.folder}" could not be created; the journal was not moved`);
+          } else {
+            journalUpdate.folder = folderId;
+          }
+        }
+        if (Object.keys(journalUpdate).length > 0) {
+          await journal.update(journalUpdate);
+        }
+
+        const existing = ((journal.pages?.contents || []) as any[]).slice();
+        let nextSort =
+          existing.reduce((max, page) => Math.max(max, page.sort ?? 0), 0) + 100000;
+        for (const spec of pageSpecs) {
+          let target: any;
+          if (spec.id) {
+            target = existing.find(p => p.id === spec.id);
+            if (!target) throw new Error(`Page not found: ${spec.id}`);
+          } else if (spec.name) {
+            const wanted = spec.name.trim().toLowerCase();
+            const matches = existing.filter(p => String(p.name ?? '').toLowerCase() === wanted);
+            if (matches.length > 1) {
+              throw new Error(
+                `Several pages are named "${spec.name}" (ids: ${matches.map(p => p.id).join(', ')}); pass the id`
+              );
+            }
+            target = matches[0];
+          } else {
+            throw new Error('Every page needs an id or a name');
+          }
+
+          if (target) {
+            if (spec.type !== undefined && spec.type !== target.type) {
+              throw new Error(
+                `Page "${target.name}" is a ${target.type} page; its type cannot change`
+              );
+            }
+            const fields = pageFields(spec, target.type);
+            if (Object.keys(fields).length === 0) {
+              warnings.push(`page "${target.name}" had nothing to change`);
+              continue;
+            }
+            await target.update(fields);
+            pageResults.push({ id: target.id, name: target.name, type: target.type, result: 'updated' });
+          } else {
+            const created = await journal.createEmbeddedDocuments('JournalEntryPage', [
+              newPageData(spec, nextSort),
+            ]);
+            nextSort += 100000;
+            const page = created?.[0];
+            if (page) existing.push(page);
+            pageResults.push({
+              id: page?.id ?? '',
+              name: spec.name!.trim(),
+              type: spec.type ?? 'text',
+              result: 'created',
+            });
+          }
+        }
+      }
+
+      this.auditLog(`manageJournals:${options.action}`, { ...options, pages: pageSpecs.length }, 'success');
+
+      return {
+        success: true,
+        action: options.action,
+        journal: this.summarizeJournal(journal, false),
+        pages: pageResults,
+        ...(warnings.length > 0 ? { warnings } : {}),
+      };
+    } catch (error) {
+      this.auditLog(
+        `manageJournals:${options?.action}`,
+        { journal: options?.journal, name: options?.name },
+        'failure',
+        error instanceof Error ? error.message : 'Unknown error'
+      );
+      throw new Error(
+        `Failed to ${options?.action ?? 'manage'} journal: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+
+  // ===== FILE UPLOAD =====
+
+  /**
+   * Upload an image into the world's own upload folder (worlds/<world>/uploads/...),
+   * so it survives module updates and can be used as a scene background, token or
+   * portrait image. Only png, jpg, webp and gif are accepted, the bytes must match the
+   * extension, size is capped, and the folder is restricted to the world's upload tree.
+   * Existing files are not replaced unless overwrite is true.
+   */
+  async uploadFile(options: {
+    filename: string;
+    imageData: string;
+    folder?: string;
+    overwrite?: boolean;
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      const permissionCheck = permissionManager.checkWritePermission('modifyScene', {});
+      if (!permissionCheck.allowed) {
+        throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${permissionCheck.reason}`);
+      }
+
+      const filename = sanitizeUploadFilename(options.filename);
+      const folder = sanitizeUploadFolder(options.folder);
+      const bytes = decodeBase64(options.imageData);
+
+      if (bytes.length === 0) {
+        throw new Error('The file is empty');
+      }
+      if (bytes.length > UPLOAD_MAX_BYTES) {
+        throw new Error(
+          `The file is ${(bytes.length / 1024 / 1024).toFixed(1)} MB; the limit is ${UPLOAD_MAX_BYTES / 1024 / 1024} MB`
+        );
+      }
+      const detected = detectImageType(bytes);
+      if (!detected) {
+        throw new Error('The file is not a PNG, JPEG, WebP or GIF image');
+      }
+      if (!extensionMatchesType(filename, detected)) {
+        throw new Error(
+          `The file content is ${detected.toUpperCase()} but the name says otherwise`
+        );
+      }
+
+      const worldId = (game as any).world?.id;
+      if (!worldId) {
+        throw new Error('No world is loaded');
+      }
+      const FilePickerAPI =
+        (globalThis as any).foundry?.applications?.apps?.FilePicker?.implementation ||
+        (globalThis as any).FilePicker;
+      if (!FilePickerAPI) {
+        throw new Error('Foundry file picker is not available');
+      }
+
+      // Create each level of worlds/<world>/uploads[/folder...]; existing ones are fine.
+      const segments = ['worlds', worldId, 'uploads', ...(folder ? folder.split('/') : [])];
+      let current = '';
+      for (const segment of segments) {
+        current = current ? `${current}/${segment}` : segment;
+        try {
+          await FilePickerAPI.createDirectory('data', current, { bucket: null });
+        } catch (dirError: any) {
+          const message = String(dirError?.message ?? dirError);
+          if (!message.includes('EEXIST') && !message.includes('already exists')) {
+            console.warn(`[${this.moduleId}] Directory creation warning for ${current}:`, message);
+          }
+        }
+      }
+      const directory = current;
+
+      // Do not silently replace an existing file.
+      if (!options.overwrite) {
+        let existing: string[] = [];
+        try {
+          const listing = await FilePickerAPI.browse('data', directory);
+          existing = (listing?.files ?? []).map((f: string) => {
+            try {
+              return decodeURIComponent(String(f));
+            } catch {
+              return String(f); // malformed %-encoding in one entry must not hide the others
+            }
+          });
+        } catch {
+          // Cannot list the folder: carry on rather than block the upload.
+        }
+        if (existing.some(f => f === `${directory}/${filename}` || f.endsWith(`/${filename}`))) {
+          throw new Error(
+            `File already exists: ${directory}/${filename}. Use a different filename or pass overwrite: true`
+          );
+        }
+      }
+
+      const mime = UPLOAD_IMAGE_TYPES[filename.slice(filename.lastIndexOf('.') + 1)];
+      const file = new File([bytes as BlobPart], filename, { type: mime });
+      const response = await FilePickerAPI.upload('data', directory, file, {}, { notify: false });
+      if (!response || !response.path) {
+        throw new Error('Foundry did not confirm the upload (it may have been rejected)');
+      }
+
+      this.auditLog('uploadFile', { filename, folder, bytes: bytes.length }, 'success');
+
+      return {
+        success: true,
+        path: response.path,
+        filename,
+        directory,
+        bytes: bytes.length,
+        contentType: mime,
+      };
+    } catch (error) {
+      this.auditLog(
+        'uploadFile',
+        { filename: options?.filename, folder: options?.folder },
+        'failure',
+        error instanceof Error ? error.message : 'Unknown error'
+      );
+      throw new Error(
+        `Failed to upload file: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }

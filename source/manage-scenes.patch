+import { describe, expect, it } from 'vitest';
+import { ownershipName, resolveContentLinks, stripUnsafeHtml } from './journal-utils.js';
+
+describe('ownershipName', () => {
+  it('maps levels to names', () => {
+    expect([0, 1, 2, 3].map(ownershipName)).toEqual(['none', 'limited', 'observer', 'owner']);
+    expect(ownershipName(-1)).toBe('unknown');
+    expect(ownershipName(undefined)).toBe('unknown');
+  });
+});
+
+describe('stripUnsafeHtml', () => {
+  it('keeps ordinary markup', () => {
+    const html =
+      '<h2>Title</h2><p class="x">Some <em>text</em></p><table><tr><td>1</td></tr></table>';
+    expect(stripUnsafeHtml(html)).toBe(html);
+  });
+
+  it('removes script, iframe and form elements with their content', () => {
+    expect(stripUnsafeHtml('a<script>alert(1)</script>b')).toBe('ab');
+    expect(stripUnsafeHtml('a<iframe src="x">y</iframe>b')).toBe('ab');
+    expect(stripUnsafeHtml('a<FORM action="x"><input></FORM>b')).toBe('ab');
+  });
+
+  it('removes unclosed and void dangerous tags', () => {
+    expect(stripUnsafeHtml('a<script src="x">b')).toBe('ab');
+    expect(
+      stripUnsafeHtml('<link rel="stylesheet" href="x"><meta charset="x"><base href="x">p')
+    ).toBe('p');
+  });
+
+  it('removes inline event handlers in every quoting style', () => {
+    expect(stripUnsafeHtml('<img src="a.png" onerror="x()">')).toBe('<img src="a.png">');
+    expect(stripUnsafeHtml("<p onclick='x()'>t</p>")).toBe('<p>t</p>');
+    expect(stripUnsafeHtml('<p onmouseover=x()>t</p>')).toBe('<p>t</p>');
+  });
+
+  it('blanks script-capable URLs', () => {
+    expect(stripUnsafeHtml('<a href="javascript:alert(1)">x</a>')).toBe('<a href="">x</a>');
+    expect(stripUnsafeHtml("<a href='JavaScript:alert(1)'>x</a>")).toBe('<a href="">x</a>');
+    expect(stripUnsafeHtml('<a href="https://example.com">x</a>')).toBe(
+      '<a href="https://example.com">x</a>'
+    );
+  });
+});
+
+describe('resolveContentLinks', () => {
+  const lookup = (kind: string, name: string) => {
+    if (name === 'Twice') return 'ambiguous' as const;
+    if (name === 'Missing') return null;
+    return { id: `${kind}-id`, name };
+  };
+
+  it('turns links into UUID links, with the name or a label', () => {
+    const out = resolveContentLinks(
+      '<p>{{actor: Sildar Hallwinter}} in {{scene: Cave | the cave}}</p>',
+      lookup
+    );
+    expect(out.html).toBe(
+      '<p>@UUID[Actor.actor-id]{Sildar Hallwinter} in @UUID[Scene.scene-id]{the cave}</p>'
+    );
+    expect(out.warnings).toEqual([]);
+  });
+
+  it('supports every kind', () => {
+    const out = resolveContentLinks('{{journal: A}} {{item: B}} {{rolltable: C}}', lookup);
+    expect(out.html).toBe(
+      '@UUID[JournalEntry.journal-id]{A} @UUID[Item.item-id]{B} @UUID[RollTable.rolltable-id]{C}'
+    );
+  });
+
+  it('leaves unresolved or ambiguous names as plain text with a warning', () => {
+    const out = resolveContentLinks('{{actor: Missing}} and {{item: Twice | the thing}}', lookup);
+    expect(out.html).toBe('Missing and the thing');
+    expect(out.warnings).toHaveLength(2);
+    expect(out.warnings[0]).toContain('matches no actor');
+    expect(out.warnings[1]).toContain('more than one item');
+  });
+
+  it('ignores text that only looks similar', () => {
+    const html = '{{unknown: X}} {actor: Y} {{ }}';
+    expect(resolveContentLinks(html, lookup).html).toBe(html);
+  });
+});

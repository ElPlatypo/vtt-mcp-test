+import { describe, expect, it } from 'vitest';
+import { STYLE, TableEventBuffer, chatEvent, doorEvent, moveEvent, turnEvent } from './table-watch-utils.js';
+
+const users: Record<string, { name: string; isGM: boolean }> = {
+  gm: { name: 'Gamemaster', isGM: true },
+  p1: { name: 'Claudio', isGM: false },
+  p2: { name: 'Marta', isGM: false },
+};
+const ctx = { moduleId: 'foundry-mcp-bridge-scenes', userName: (id: string) => users[id]?.name, isGMUser: (id: string) => !!users[id]?.isGM };
+const author = (id: string) => ({ id, ...users[id] });
+
+function msg(over: Record<string, any>): any {
+  return { id: 'm', author: author('p1'), content: '<p>I kick the door</p>', speaker: { actor: 'a1', alias: 'Randal' }, style: STYLE.IC, whisper: [], rolls: [], flags: {}, type: 'base', ...over };
+}
+
+describe('chatEvent: the table chat rule', () => {
+  it('wakes on in-character lines and emotes', () => {
+    expect(chatEvent(msg({}), ctx)).toMatchObject({ kind: 'say', wake: true, text: 'Randal (Claudio): "I kick the door"', user: 'Claudio', actor: 'Randal' });
+    expect(chatEvent(msg({ style: STYLE.EMOTE, content: 'draws his sword' }), ctx)).toMatchObject({ kind: 'emote', wake: true, text: '*Randal draws his sword* (Claudio)' });
+  });
+
+  it('wakes on a message private to the GM, also when out of character', () => {
+    const e = chatEvent(msg({ style: STYLE.OOC, speaker: { alias: 'Claudio' }, whisper: ['gm'], content: 'Can I sneak past?' }), ctx);
+    expect(e).toMatchObject({ kind: 'whisper', wake: true, text: 'Claudio to the GM, privately: "Can I sneak past?"' });
+  });
+
+  it('ignores public out-of-character talk, blind messages and whispers between players', () => {
+    expect(chatEvent(msg({ style: STYLE.OOC, speaker: { alias: 'Claudio' } }), ctx)).toBeNull();
+    expect(chatEvent(msg({ blind: true, whisper: ['gm'] }), ctx)).toBeNull();
+    expect(chatEvent(msg({ whisper: ['p2'] }), ctx)).toBeNull();
+  });
+
+  it('keeps player rolls and cards as background, blind rolls marked', () => {
+    const roll = { total: 14, formula: '1d20 + 1' };
+    expect(chatEvent(msg({ rolls: [roll], flavor: 'Wisdom (Perception) Check', content: '14', flags: { dnd5e: {} } }), ctx)).toMatchObject({
+      kind: 'roll',
+      wake: false,
+      text: 'Randal (Claudio) rolled Wisdom (Perception) Check: 14 (1d20 + 1)',
+      user: 'Claudio',
+      actor: 'Randal',
+    });
+    expect(chatEvent(msg({ rolls: [roll], blind: true, flavor: 'Stealth' }), ctx)?.text).toMatch(/\[blind\]$/);
+    expect(chatEvent(msg({ flags: { dnd5e: { item: {} } }, flavor: 'Second Wind', content: '<div>card</div>' }), ctx)).toMatchObject({ kind: 'card', wake: false, text: 'Randal (Claudio) used Second Wind' });
+  });
+
+  it("ignores the bridge's own posts and the GM's tool rolls and cards, but not the GM typing", () => {
+    expect(chatEvent(msg({ flags: { 'foundry-mcp-bridge-scenes': { bridge: true } } }), ctx)).toBeNull();
+    expect(chatEvent(msg({ author: author('gm'), rolls: [{ total: 20, formula: '1d20+4' }] }), ctx)).toBeNull();
+    expect(chatEvent(msg({ author: author('gm'), flags: { dnd5e: {} } }), ctx)).toBeNull();
+    expect(chatEvent(msg({ author: author('gm'), speaker: { actor: 'a1', alias: 'Randal' } }), ctx)).toMatchObject({ kind: 'say', wake: true });
+  });
+});
+
+describe('other table events', () => {
+  it("wakes on a GM-run creature's turn, not on a player's", () => {
+    expect(turnEvent({ round: 2, combatant: { name: 'Goblin 2', hasPlayerOwner: false } }, 'Randal')).toMatchObject({
+      kind: 'turn',
+      wake: true,
+      text: "Randal ended their turn. Round 2: Goblin 2's turn",
+    });
+    expect(turnEvent({ round: 2, combatant: { name: 'Randal', actor: { hasPlayerOwner: true } } })).toMatchObject({ wake: false, text: "Round 2: Randal's turn (a player)" });
+    expect(turnEvent({ round: 3, combatant: { name: 'Goblin 1', hasPlayerOwner: false, isDefeated: true } })?.wake).toBe(false);
+    expect(turnEvent({ round: 1, combatant: null })).toBeNull();
+  });
+
+  it('notes moves and doors; opening a door wakes when the setting is on', () => {
+    expect(moveEvent('Randal', 'Claudio', { x: 12, y: 8.04 }, 't1')).toMatchObject({ wake: false, text: 'Randal moved to square (12, 8)', key: 'move:t1' });
+    expect(doorEvent(1, 'Claudio', { x: 14.5, y: 6 }, true)).toMatchObject({ wake: true, text: 'Claudio opened a door at square (14.5, 6)' });
+    expect(doorEvent(1, 'Claudio', undefined, false).wake).toBe(false);
+    expect(doorEvent(0, 'Claudio', undefined, true)).toMatchObject({ wake: false, text: 'Claudio closed a door' });
+  });
+
+  it('buffers events with sequence numbers and a capacity', () => {
+    const buf = new TableEventBuffer(3, 'abc');
+    for (let i = 0; i < 5; i++) buf.push({ kind: 'move', wake: false, text: `m${i}` }, i);
+    expect(buf.since().events.map(e => e.text)).toEqual(['m2', 'm3', 'm4']);
+    expect(buf.since(4)).toMatchObject({ seq: 5, events: [{ seq: 5, text: 'm4' }] });
+    expect(buf.session).toBe('abc');
+  });
+});
+
+describe('rolls aimed at someone', () => {
+  it('names the targets of an attack and says hit or miss against their AC', () => {
+    const attack = msg({
+      type: 'attack',
+      rolls: [{ total: 18, formula: '1d20 + 5' }],
+      flavor: 'Longsword - Attack Roll',
+      content: '',
+      system: { targets: [{ name: 'Goblin 2', ac: 15 }, { name: 'Goblin 3', ac: 19 }] },
+    });
+    expect(chatEvent(attack, ctx)?.text).toBe('Randal (Claudio) rolled Longsword - Attack Roll: 18 (1d20 + 5) vs Goblin 2 (AC 15): hit; Goblin 3 (AC 19): miss');
+    const crit = msg({ type: 'attack', rolls: [{ total: 9, formula: '1d20', isCritical: true }], flavor: 'Attack', content: '', system: { targets: [{ name: 'Ogre', ac: 11 }] } });
+    expect(chatEvent(crit, ctx)?.text).toMatch(/vs Ogre \(AC 11\): critical hit$/);
+  });
+  it('names the targets of damage without judging it', () => {
+    const damage = msg({ type: 'damage', rolls: [{ total: 9, formula: '1d8 + 3' }], flavor: 'Longsword - Damage Roll', content: '', flags: { dnd5e: { targets: [{ name: 'Goblin 2', ac: 15 }] } } });
+    expect(chatEvent(damage, ctx)?.text).toBe('Randal (Claudio) rolled Longsword - Damage Roll: 9 (1d8 + 3) vs Goblin 2');
+  });
+  it('treats the v14 emote flag as an emote', () => {
+    expect(chatEvent(msg({ style: STYLE.OTHER, emote: true, content: 'waves' }), ctx)).toMatchObject({ kind: 'emote', wake: true });
+  });
+});
+
+describe('v14 message details', () => {
+  it('does not repeat the name Foundry already put in an emote', () => {
+    expect(chatEvent(msg({ emote: true, style: STYLE.OTHER, content: 'Randal draws his sword' }), ctx)?.text).toBe('*Randal draws his sword* (Claudio)');
+    expect(chatEvent(msg({ emote: true, style: STYLE.OTHER, content: 'draws his sword' }), ctx)?.text).toBe('*Randal draws his sword* (Claudio)');
+  });
+  it('names the item on a use card that has no text', () => {
+    expect(chatEvent(msg({ type: 'usage', content: '', flavor: '', system: { item: { name: 'Longsword' } } }), ctx)).toMatchObject({ kind: 'card', text: 'Randal (Claudio) used Longsword' });
+  });
+});
+
+describe('round 1: roll targets and unapplied damage', () => {
+  const targets = [{ name: 'Goblin 3', ac: 15, uuid: 'Scene.s.Token.t' }];
+  it('names targets only for attack, damage and save rolls', async () => {
+    const { rollTargets } = await import('./table-watch-utils.js');
+    expect(rollTargets({ type: 'attack', system: { targets } }, [{ total: 18 }])).toContain('Goblin 3 (AC 15): hit');
+    expect(rollTargets({ flags: { dnd5e: { roll: { type: 'damage' } } }, system: { targets } }, [{ total: 5, options: {} }])).toBe(' vs Goblin 3');
+    expect(rollTargets({ flags: { dnd5e: { roll: { type: 'damage' } } }, system: { targets } }, [{ total: 5, options: { types: ['healing'] } }])).toBe('');
+    expect(rollTargets({ type: 'check', system: { targets } }, [{ total: 5 }])).toBe('');
+  });
+  it('reports damage that did not change hit points', async () => {
+    const { damageNotAppliedEvent, damageRollTargets } = await import('./table-watch-utils.js');
+    expect(damageRollTargets({ flags: { dnd5e: { roll: { type: 'damage' } } }, rolls: [{ options: {} }], system: { targets } })).toEqual([{ name: 'Goblin 3', uuid: 'Scene.s.Token.t' }]);
+    expect(damageRollTargets({ type: 'attack', rolls: [{}], system: { targets } })).toEqual([]);
+    expect(damageNotAppliedEvent('Randal', [{ name: 'Goblin 3', hp: 7 }], 'Claudio')?.text).toContain('NOT applied to Goblin 3 (still 7 hp)');
+    expect(damageNotAppliedEvent('Randal', [], 'Claudio')).toBeNull();
+  });
+});
diff --git a/packages/foundry-module/src/table-watch-utils.ts b/packages/foundry-module/src/table-watch-utils.ts
new file mode 100644
index 0000000..2bd53f5
--- /dev/null
+++ b/packages/foundry-module/src/table-watch-utils.ts
@@ -0,0 +1,242 @@
+/**
+ * Table watch: turning what happens at the table (chat, rolls, combat turns, token moves, doors,
+ * hit points, players joining) into short events, each marked as one that should wake the AI GM
+ * or as background it reads the next time it is woken. Pure: no Foundry globals.
+ *
+ * The chat rule follows how the table uses Foundry's chat: messages sent as a character (in
+ * character or emote) and messages sent privately to the GM are for the AI GM and wake it;
+ * public out-of-character messages and blind messages do not.
+ */
+import { htmlToText } from './rules-utils.js';
+
+export type TableEventKind = 'say' | 'emote' | 'whisper' | 'roll' | 'card' | 'turn' | 'combat' | 'move' | 'door' | 'hp' | 'presence';
+
+export interface TableEvent {
+  seq: number;
+  /** ms since epoch */
+  at: number;
+  kind: TableEventKind;
+  /** one short line, ready to read */
+  text: string;
+  /** this event should wake the AI GM (subject to the server's bundling) */
+  wake: boolean;
+  /** player (user) name, when a player caused it */
+  user?: string;
+  /** character name, when it concerns one */
+  actor?: string;
+  /** events with the same key replace each other inside one bundle (a token's moves, an actor's hp) */
+  key?: string;
+  /** the item a roll or card is about, so the server can fold an item card into the roll that follows it */
+  item?: string;
+  /** a roll's kind (attack, damage, save ...) and total, so an attack and its damage can be merged into one line */
+  rollKind?: string;
+  total?: number;
+}
+
+export type NewTableEvent = Omit<TableEvent, 'seq' | 'at'>;
+
+const MAX_TEXT = 300;
+const cut = (s: string, max = MAX_TEXT): string => (s.length > max ? `${s.slice(0, max - 3)}...` : s);
+const oneLine = (html: unknown): string => htmlToText(String(html ?? '')).replace(/\s+/g, ' ').trim();
+
+/**
+ * Who a dnd5e roll was aimed at (dnd5e 4+ keeps them in system.targets, older versions in
+ * flags.dnd5e.targets), and for an attack whether it hit each target's AC: " vs Goblin 2 (AC 15): hit".
+ */
+/** What a dnd5e roll message is: attack, damage, save, heal ... (empty when unknown). */
+export function rollKind(message: any, rolls: any[]): string {
+  const raw = String(message?.flags?.dnd5e?.roll?.type ?? message?.type ?? rolls[0]?.options?.rollType ?? '').toLowerCase();
+  const types = rolls[0]?.options?.types ?? (rolls[0]?.options?.type ? [rolls[0].options.type] : []);
+  const healing = (Array.isArray(types) ? types : [...(types ?? [])]).some((t: unknown) => t === 'healing' || t === 'temphp');
+  if (raw === 'damage' && healing) return 'heal';
+  return raw;
+}
+
+export function rollTargets(message: any, rolls: any[]): string {
+  const targets: any[] = message?.system?.targets ?? message?.flags?.dnd5e?.targets ?? [];
+  if (!Array.isArray(targets) || targets.length === 0) return '';
+  const kind = rollKind(message, rolls);
+  // Only an attack, damage or save roll is aimed at the targets (healing and checks are not).
+  if (kind !== 'attack' && kind !== 'damage' && kind !== 'save') return '';
+  const roll = rolls[0];
+  const total = Number(roll?.total);
+  const crit = roll?.isCritical === true;
+  const fumble = roll?.isFumble === true;
+  const parts = targets.map(t => {
+    const name = String(t?.name ?? 'someone');
+    const ac = Number(t?.ac);
+    if (kind !== 'attack' || !Number.isFinite(ac) || !Number.isFinite(total)) return name;
+    const hit = crit || (!fumble && total >= ac);
+    return `${name} (AC ${ac}): ${crit ? 'critical hit' : fumble ? 'miss (natural 1)' : hit ? 'hit' : 'miss'}`;
+  });
+  return ` vs ${parts.join('; ')}`;
+}
+
+/** The targets of a damage roll (not healing), as {name, uuid}, or none. */
+export function damageRollTargets(message: any): Array<{ name: string; uuid: string }> {
+  const rolls: any[] = Array.isArray(message?.rolls) ? message.rolls : [];
+  if (rollKind(message, rolls) !== 'damage') return [];
+  const targets: any[] = message?.system?.targets ?? message?.flags?.dnd5e?.targets ?? [];
+  if (!Array.isArray(targets)) return [];
+  return targets.filter(t => t?.uuid).map(t => ({ name: String(t.name ?? 'a target'), uuid: String(t.uuid) }));
+}
+
+/** Told when a player's damage roll did not change the target's hit points: dnd5e leaves applying it to the GM. */
+export function damageNotAppliedEvent(who: string, unchanged: Array<{ name: string; hp: number }>, user: string): NewTableEvent | null {
+  if (unchanged.length === 0) return null;
+  const list = unchanged.map(u => `${u.name} (still ${u.hp} hp)`).join(', ');
+  return { kind: 'card', wake: false, text: `${who}'s damage roll was NOT applied to ${list}: apply it with combat damage`, user, key: `unapplied:${unchanged.map(u => u.name).join(',')}` };
+}
+
+/** Foundry's chat message styles (CONST.CHAT_MESSAGE_STYLES): OTHER 0, OOC 1, IC 2, EMOTE 3. */
+export const STYLE = { OTHER: 0, OOC: 1, IC: 2, EMOTE: 3 } as const;
+
+export interface ChatContext {
+  /** the module's id, to recognise what the bridge posted */
+  moduleId: string;
+  userName: (id: string) => string | undefined;
+  isGMUser: (id: string) => boolean;
+}
+
+/**
+ * One chat message as a table event, or null when it is not something the AI GM should see:
+ * the bridge's own posts, the GM's tool rolls and cards, public out-of-character talk, blind
+ * messages, and whispers between players.
+ */
+export function chatEvent(message: any, ctx: ChatContext): NewTableEvent | null {
+  const flags = message?.flags ?? {};
+  if (flags[ctx.moduleId]?.bridge || flags[ctx.moduleId]?.tts) return null;
+  const author = message.author ?? message.user;
+  const authorId: string | undefined = author?.id ?? (typeof message.user === 'string' ? message.user : undefined);
+  const user = author?.name ?? (authorId ? ctx.userName(authorId) : undefined) ?? 'someone';
+  const fromGM = !!(author?.isGM ?? (authorId ? ctx.isGMUser(authorId) : false));
+  const rolls: any[] = Array.isArray(message.rolls) ? message.rolls : [];
+  const systemCard = !!flags.dnd5e || (typeof message.type === 'string' && message.type !== 'base');
+  // What the GM side posts with rolls or system cards is the bridge's or the GM's own doing.
+  if (fromGM && (rolls.length || systemCard)) return null;
+
+  const alias: string | undefined = message.speaker?.alias || undefined;
+  const asActor = !!(message.speaker?.actor || message.speaker?.token);
+  const who = alias && alias !== user ? `${alias} (${user})` : user;
+  const whisper: string[] = Array.isArray(message.whisper) ? message.whisper : [];
+  const blind = !!message.blind;
+  const text = cut(oneLine(message.content));
+  const actor = asActor && alias ? alias : undefined;
+  const base = { user, ...(actor ? { actor } : {}) };
+
+  if (rolls.length) {
+    const flavor = cut(oneLine(message.flavor), 80);
+    const totals = rolls.map(r => r?.total).filter(t => t !== undefined && t !== null);
+    const formula = String(rolls[0]?.formula ?? '');
+    const label = flavor || formula || 'a roll';
+    const vis = blind ? ' [blind]' : whisper.length ? ' [private]' : '';
+    const itemName: string | undefined = message.system?.item?.name ?? message.flags?.dnd5e?.item?.name ?? undefined;
+    const kind = rollKind(message, rolls);
+    const total = Number(rolls[0]?.total);
+    return {
+      kind: 'roll',
+      wake: false,
+      text: cut(`${who} rolled ${label}: ${totals.join(', ')}${formula && flavor ? ` (${formula})` : ''}${rollTargets(message, rolls)}${vis}`, 220),
+      ...(itemName ? { item: itemName } : {}),
+      ...(kind ? { rollKind: kind } : {}),
+      ...(Number.isFinite(total) ? { total } : {}),
+      ...base,
+    };
+  }
+  if (systemCard) {
+    // dnd5e 4+ keeps the item on the message (system.item), older versions only in the flavor.
+    const itemName = message.system?.item?.name ?? message.flags?.dnd5e?.item?.name;
+    const flavor = oneLine(message.flavor);
+    const summary = cut(itemName || flavor || text, 100);
+    return summary ? { kind: 'card', wake: false, text: `${who} used ${summary}`, ...(itemName ? { item: itemName } : {}), ...base } : null;
+  }
+  if (!text) return null;
+  // Blind to the GM: not for the AI GM.
+  if (blind) return null;
+  if (whisper.length) {
+    const toGM = whisper.some(id => ctx.isGMUser(id));
+    if (!toGM) return null; // between players
+    return { kind: 'whisper', wake: true, text: `${who} to the GM, privately: "${text}"`, ...base };
+  }
+  const style = Number(message.style ?? (typeof message.type === 'number' ? message.type : STYLE.OTHER));
+  // Foundry v14 marks an emote with its own emote flag; older versions use the EMOTE style.
+  if (style === STYLE.EMOTE || message.emote === true) {
+    // Foundry v14 already writes the speaker's name into the emote ("Randal draws his sword").
+    const name = alias ?? user;
+    const line = text.toLowerCase().startsWith(name.toLowerCase()) ? text : `${name} ${text}`;
+    return { kind: 'emote', wake: true, text: `*${line}*${alias && alias !== user ? ` (${user})` : ''}`, ...base };
+  }
+  if (style === STYLE.IC || (style === STYLE.OTHER && asActor)) return { kind: 'say', wake: true, text: `${who}: "${text}"`, ...base };
+  // Public, as the user (out of character): table talk, not for the AI GM.
+  return null;
+}
+
+export interface CombatantLike {
+  name?: string;
+  hasPlayerOwner?: boolean;
+  isDefeated?: boolean;
+  defeated?: boolean;
+  hidden?: boolean;
+  actor?: { hasPlayerOwner?: boolean; name?: string } | null;
+}
+
+/** The turn passing to a combatant: a monster's (or other GM-run) turn wakes the AI GM, a player's does not. */
+export function turnEvent(combat: { round?: number; combatant?: CombatantLike | null } | null | undefined, previous?: string): NewTableEvent | null {
+  const current = combat?.combatant;
+  if (!current) return null;
+  const playerRun = !!(current.hasPlayerOwner ?? current.actor?.hasPlayerOwner);
+  const defeated = !!(current.isDefeated ?? current.defeated);
+  const name = current.name ?? current.actor?.name ?? 'someone';
+  const ended = previous ? `${previous} ended their turn. ` : '';
+  const text = `${ended}Round ${combat?.round ?? '?'}: ${name}'s turn${playerRun ? ' (a player)' : ''}${defeated ? ' (defeated)' : ''}`;
+  return { kind: 'turn', wake: !playerRun && !defeated, text, actor: name, key: 'turn' };
+}
+
+/** A token moved by a player, in grid squares. */
+export function moveEvent(tokenName: string, user: string, squares: { x: number; y: number }, tokenId: string): NewTableEvent {
+  const round = (v: number) => Math.round(v * 10) / 10;
+  return { kind: 'move', wake: false, text: `${tokenName} moved to square (${round(squares.x)}, ${round(squares.y)})`, user, actor: tokenName, key: `move:${tokenId}` };
+}
+
+const DOOR_STATES: Record<number, string> = { 0: 'closed', 1: 'opened', 2: 'locked' };
+
+/** A door opened, closed or locked by a player; opening one wakes the AI GM (the room beyond may need describing). */
+export function doorEvent(state: number, user: string, squares: { x: number; y: number } | undefined, wakeOnOpen: boolean): NewTableEvent {
+  const what = DOOR_STATES[state] ?? 'changed';
+  const where = squares ? ` at square (${Math.round(squares.x * 2) / 2}, ${Math.round(squares.y * 2) / 2})` : '';
+  return { kind: 'door', wake: wakeOnOpen && state === 1, text: `${user} ${what} a door${where}`, user };
+}
+
+/** Hit points a player changed on a character. */
+export function hpEvent(actorName: string, user: string, hp: { value?: number; max?: number }, actorId: string): NewTableEvent {
+  return { kind: 'hp', wake: false, text: `${actorName} now has ${hp.value ?? '?'}${hp.max !== undefined ? `/${hp.max}` : ''} hp (changed by ${user})`, user, actor: actorName, key: `hp:${actorId}` };
+}
+
+export function presenceEvent(user: string, connected: boolean): NewTableEvent {
+  return { kind: 'presence', wake: false, text: `${user} ${connected ? 'joined' : 'left'} the game`, user, key: `presence:${user}` };
+}
+
+/** A ring buffer of table events with increasing sequence numbers. */
+export class TableEventBuffer {
+  private events: TableEvent[] = [];
+  private nextSeq = 1;
+  /** changes when the buffer is made anew (a page reload), so a reader knows its marker is stale */
+  readonly session: string;
+
+  constructor(private capacity = 500, session?: string) {
+    this.session = session ?? Math.random().toString(36).slice(2, 10);
+  }
+
+  push(event: NewTableEvent, at = Date.now()): TableEvent {
+    const full: TableEvent = { ...event, seq: this.nextSeq++, at };
+    this.events.push(full);
+    if (this.events.length > this.capacity) this.events.splice(0, this.events.length - this.capacity);
+    return full;
+  }
+
+  /** Events after a sequence number (all kept events when since is missing), and the latest number. */
+  since(seq?: number): { events: TableEvent[]; seq: number } {
+    const events = typeof seq === 'number' ? this.events.filter(e => e.seq > seq) : this.events.slice();
+    return { events, seq: this.nextSeq - 1 };
+  }
+}

+} from './speech.js';
+
+function flac(sampleRate: number, samples: number): Buffer {
+  const b = Buffer.alloc(60);
+  b.write('fLaC', 0, 'ascii');
+  const o = 18;
+  b[o] = (sampleRate >> 12) & 0xff;
+  b[o + 1] = (sampleRate >> 4) & 0xff;
+  b[o + 2] = ((sampleRate & 15) << 4) | 0; // channels/bits bits left at 0
+  b[o + 3] = (samples / 2 ** 32) & 15;
+  b.writeUInt32BE(samples >>> 0, o + 4);
+  return b;
+}
+
+describe('speech settings', () => {
+  it('fills defaults and rejects odd values', () => {
+    expect(normalizeSpeechSettings(undefined)).toEqual(DEFAULT_SPEECH_SETTINGS);
+    const s = normalizeSpeechSettings({ engine: 'nope', voice: '  Ryan ', speed: 9, syncText: 'x', style: '' });
+    expect(s).toMatchObject({ engine: 'kokoro', voice: 'Ryan', speed: 1, syncText: true });
+    expect(s.style).toBe(DEFAULT_SPEECH_SETTINGS.style);
+    expect(normalizeSpeechSettings({ engine: 'qwen3-design', speed: 1.25, syncText: false })).toMatchObject({ engine: 'qwen3-design', speed: 1.25, syncText: false });
+  });
+  it('picks the Kokoro language from the voice', () => {
+    expect(kokoroLanguageFor('bm_fable')).toBe('English (British)');
+    expect(kokoroLanguageFor('af_heart')).toBe('English');
+    expect(kokoroLanguageFor('ff_siwis')).toBe('French');
+    expect(kokoroLanguageFor('xx')).toBe('English');
+  });
+  it('reads node defaults from object_info', () => {
+    const info = {
+      input: {
+        required: { text: ['STRING', { default: 'hi' }], model_choice: [['0.6B', '1.7B']], speaker: ['KOKORO_SPEAKER'], speed: ['FLOAT', { default: 1 }], mode: [['a', 'b'], { default: 'b' }] },
+        optional: { instruct: ['STRING', { default: '' }] },
+      },
+    };
+    expect(nodeInputDefaults(info)).toEqual({ text: 'hi', model_choice: '0.6B', speed: 1, mode: 'b', instruct: '' });
+  });
+});
+
+describe('speech workflows', () => {
+  const base = { text: 'Hello there.', voice: 'bm_fable', language: 'auto', speed: 1.1, style: 'calm', seed: 7 };
+  it('builds the Kokoro workflow with the language from the voice', () => {
+    const w = buildSpeechWorkflow({ ...base, engine: 'kokoro' });
+    expect(w['1']).toEqual({ class_type: 'KokoroSpeaker', inputs: { speaker_name: 'bm_fable' } });
+    expect(w['2'].inputs).toEqual({ text: 'Hello there.', speaker: ['1', 0], speed: 1.1, lang: 'English (British)' });
+    expect(w['3']).toMatchObject({ class_type: 'SaveAudio', inputs: { audio: ['2', 0] } });
+    expect(buildSpeechWorkflow({ ...base, engine: 'kokoro', language: 'French' })['2'].inputs.lang).toBe('French');
+  });
+  it('builds the Qwen3 custom voice workflow on top of the node defaults', () => {
+    const w = buildSpeechWorkflow({ ...base, engine: 'qwen3-custom', voice: 'Ryan' }, { device: 'auto', top_p: 0.8 });
+    expect(w['1'].class_type).toBe('FB_Qwen3TTSCustomVoice');
+    expect(w['1'].inputs).toMatchObject({ device: 'auto', top_p: 0.8, text: 'Hello there.', speaker: 'Ryan', instruct: 'calm', model_choice: '1.7B', language: 'English', seed: 7, unload_model_after_generate: false });
+    expect(w['2']).toMatchObject({ class_type: 'SaveAudio', inputs: { audio: ['1', 0] } });
+  });
+  it('builds the Qwen3 voice design workflow from the voice description', () => {
+    const w = buildSpeechWorkflow({ ...base, engine: 'qwen3-design', voice: 'A gruff old dwarf' });
+    expect(w['1'].class_type).toBe('FB_Qwen3TTSVoiceDesign');

+import { describe, expect, it } from 'vitest';
+import { boxDistance, boxInArea, directionOf, inArea, pointDistance, segmentCrossesBox, wallCover, type Box, type Pt } from './tactical-utils.js';
+
+const G = 100;
+const at = (col: number, row: number, size = 1): Box => ({ x: col * G, y: row * G, width: size, height: size });
+const centreOf = (col: number, row: number): Pt => ({ x: (col + 0.5) * G, y: (row + 0.5) * G });
+
+describe('distances', () => {
+  it('counts squares the D&D way', () => {
+    expect(boxDistance(at(0, 0), at(1, 1), G, 5)).toBe(5);
+    expect(boxDistance(at(0, 0), at(6, 3), G, 5)).toBe(30);
+    expect(boxDistance(at(0, 0), at(3, 0, 2), G, 5)).toBe(15);
+    expect(pointDistance({ x: 0, y: 0 }, at(2, 0), G, 5)).toBe(10);
+  });
+});
+
+describe('areas', () => {
+  it('a 20 ft radius around a point takes in squares whose centre is within it', () => {
+    const fireball = { shape: 'circle' as const, origin: { x: 5 * G, y: 5 * G }, size: 4 * G };
+    expect(boxInArea(at(7, 7), fireball, G)).toBe(true); // centre ~2.1 squares diagonal... 2.5,2.5 -> 3.5
+    expect(boxInArea(at(8, 8), fireball, G)).toBe(false);
+    expect(boxInArea(at(1, 5), fireball, G)).toBe(true);
+    expect(boxInArea(at(0, 5), fireball, G)).toBe(false);
+  });
+  it('a 15 ft cone is as wide as it is long', () => {
+    const cone = { shape: 'cone' as const, origin: { x: 1 * G, y: 5.5 * G }, size: 3 * G, direction: 0 };
+    expect(boxInArea(at(1, 5), cone, G)).toBe(true);
+    expect(boxInArea(at(3, 5), cone, G)).toBe(true);
+    expect(boxInArea(at(3, 6), cone, G)).toBe(true); // 1 square off axis at 2.5 out
+    expect(boxInArea(at(1, 7), cone, G)).toBe(false);
+    expect(boxInArea(at(4, 5), cone, G)).toBe(false); // beyond 15 ft
+    expect(boxInArea(at(0, 5), cone, G)).toBe(false); // behind
+  });
+  it('a 30 ft line 5 ft wide', () => {
+    const line = { shape: 'line' as const, origin: { x: 0, y: 2.5 * G }, size: 6 * G, width: G, direction: 0 };
+    expect(boxInArea(at(5, 2), line, G)).toBe(true);
+    expect(boxInArea(at(6, 2), line, G)).toBe(false);
+    expect(boxInArea(at(3, 3), line, G)).toBe(false);
+    expect(inArea(centreOf(2, 2), { shape: 'square', origin: centreOf(2, 2), size: G })).toBe(true);
+  });
+  it('reads directions as compass words or degrees', () => {
+    expect(directionOf('south')).toBeCloseTo(Math.PI / 2);
+    expect(directionOf(180)).toBeCloseTo(Math.PI);
+    expect(directionOf('up')).toBeUndefined();
+  });
+});
+
+describe('cover', () => {
+  // A wall along x = 300 from y = 0 to y = 150 (half of the target's row is behind it).
+  const wall = (a: Pt, b: Pt) => {
+    const x = 300;
+    if ((a.x - x) * (b.x - x) >= 0) return false;
+    const t = (x - a.x) / (b.x - a.x);
+    const y = a.y + t * (b.y - a.y);
+    return y >= 0 && y <= 150;
+  };
+  it('gives none in the open, half or more behind a partial wall, total behind a full one', () => {
+    expect(wallCover(at(0, 5), at(5, 5), G, () => false).cover).toBe('none');
+    expect(wallCover(at(0, 0), at(5, 0), G, wall).cover).not.toBe('none');
+    expect(wallCover(at(0, 0), at(5, 0), G, () => true)).toEqual({ cover: 'total', blockedLines: 4, lines: 4 });
+  });
+  it('lets the attacker pick its best corner', () => {
+    // From row 1 and below the wall (y <= 150) no longer blocks the lower corners.
+    const r = wallCover(at(0, 3), at(5, 1), G, wall);
+    expect(['none', 'half']).toContain(r.cover);
+  });
+  it('sees creatures standing in the way', () => {
+    expect(segmentCrossesBox(centreOf(0, 0), centreOf(4, 0), at(2, 0), G)).toBe(true);
+    expect(segmentCrossesBox(centreOf(0, 0), centreOf(4, 0), at(2, 2), G)).toBe(false);
+  });
+});
diff --git a/packages/foundry-module/src/tactical-utils.ts b/packages/foundry-module/src/tactical-utils.ts

+import { describe, expect, it } from 'vitest';
+import {
+  BUILTIN_TARGET,
+  comfyBaseUrl,
+  comfyWebSocketUrl,
+  describeComfyTarget,
+  parseComfyTarget,
+  sameComfyTarget,
+} from './comfyui-target.js';
+
+describe('parseComfyTarget', () => {
+  it('defaults to the built-in instance', () => {
+    expect(parseComfyTarget(undefined)).toEqual(BUILTIN_TARGET);
+    expect(parseComfyTarget(null)).toEqual(BUILTIN_TARGET);
+    expect(parseComfyTarget({})).toEqual(BUILTIN_TARGET);
+    expect(parseComfyTarget({ mode: 'builtin', host: 'evil.example', port: 1 })).toEqual(
+      BUILTIN_TARGET
+    );
+  });
+
+  it('accepts a custom host name, address or IPv6 address', () => {
+    expect(parseComfyTarget({ mode: 'custom', host: 'localhost', port: 8188 })).toEqual({
+      mode: 'custom',
+      host: 'localhost',
+      port: 8188,
+      secure: false,
+    });
+    expect(
+      parseComfyTarget({ mode: 'custom', host: ' nexus.lan ', port: 443, secure: true })
+    ).toEqual({ mode: 'custom', host: 'nexus.lan', port: 443, secure: true });
+    expect(parseComfyTarget({ mode: 'custom', host: '192.168.1.20', port: 8188 }).host).toBe(
+      '192.168.1.20'
+    );
+    expect(parseComfyTarget({ mode: 'custom', host: '[::1]', port: 8188 }).host).toBe('[::1]');
+  });
+
+  it.each([
+    ['an unknown mode', { mode: 'cloud' }, 'mode must be'],
+    ['a missing host', { mode: 'custom', port: 8188 }, 'host must be'],
+    ['a URL as host', { mode: 'custom', host: 'http://nexus', port: 8188 }, 'host must be'],
+    ['a host with a port', { mode: 'custom', host: 'nexus:8188', port: 8188 }, 'host must be'],
+    ['a host with a path', { mode: 'custom', host: 'nexus/api', port: 8188 }, 'host must be'],
+    ['a host with credentials', { mode: 'custom', host: 'a@nexus', port: 8188 }, 'host must be'],
+    ['a host with spaces', { mode: 'custom', host: 'my host', port: 8188 }, 'host must be'],
+    ['a text port', { mode: 'custom', host: 'nexus', port: '8188' }, 'port must be'],
+    ['port 0', { mode: 'custom', host: 'nexus', port: 0 }, 'port must be'],
+    ['port 70000', { mode: 'custom', host: 'nexus', port: 70000 }, 'port must be'],
+    ['a fractional port', { mode: 'custom', host: 'nexus', port: 80.5 }, 'port must be'],
+    [
+      'a non-boolean secure',
+      { mode: 'custom', host: 'nexus', port: 80, secure: 'yes' },
+      'secure must be',
+    ],
+  ])('rejects %s', (_label, input, message) => {
+    expect(() => parseComfyTarget(input)).toThrow(message);
+  });
+
+  it('rejects a target that is not an object', () => {
+    expect(() => parseComfyTarget('nexus')).toThrow('must be an object');
+  });
+});
+
+describe('URLs and descriptions', () => {
+  const custom = { mode: 'custom', host: 'nexus', port: 8188, secure: false } as const;
+
+  it('builds http and ws URLs, or https and wss when secure', () => {
+    expect(comfyBaseUrl(BUILTIN_TARGET)).toBe('http://127.0.0.1:31411');
+    expect(comfyBaseUrl(custom)).toBe('http://nexus:8188');
+    expect(comfyBaseUrl({ ...custom, secure: true })).toBe('https://nexus:8188');
+    expect(comfyWebSocketUrl(custom, 'a b')).toBe('ws://nexus:8188/ws?clientId=a%20b');
+    expect(comfyWebSocketUrl({ ...custom, secure: true }, 'x')).toBe(
+      'wss://nexus:8188/ws?clientId=x'
+    );
+  });
+
+  it('compares and describes targets', () => {
+    expect(sameComfyTarget(custom, { ...custom })).toBe(true);
+    expect(sameComfyTarget(custom, { ...custom, port: 1 })).toBe(false);
+    expect(sameComfyTarget(custom, BUILTIN_TARGET)).toBe(false);
+    expect(describeComfyTarget(custom)).toBe('custom ComfyUI at http://nexus:8188');
+    expect(describeComfyTarget(BUILTIN_TARGET)).toBe('built-in ComfyUI at http://127.0.0.1:31411');
+  });
+});

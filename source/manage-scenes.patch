+/**
+ * manage-scenes tests (create / update / describe).
+ *
+ * Foundry itself is stubbed: these check the payload the bridge sends to
+ * Scene.create / scene.update, the v14 background-on-Level handling, validation
+ * and the write-permission gate. They cannot prove Foundry accepts the payload;
+ * that needs a real world (see the install and test guide).
+ */
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+
+function makeScene(overrides: Record<string, any> = {}) {
+  const level = overrides.level === null ? undefined : { background: { src: '' }, update: vi.fn() };
+  const scene: any = {
+    id: 'scene-1',
+    name: 'Old Name',
+    active: false,
+    width: 4000,
+    height: 3000,
+    padding: 0.25,
+    backgroundColor: '#999999',
+    grid: { type: 1, size: 100, distance: 5, units: 'ft' },
+    tokenVision: true,
+    environment: { darknessLevel: 0, globalLight: { enabled: false } },
+    navigation: false,
+    navName: '',
+    _source: {},
+    levels: { contents: level ? [level] : [] },
+    update: vi.fn(async () => undefined),
+    activate: vi.fn(async () => undefined),
+    createEmbeddedDocuments: vi.fn(async () => []),
+    ...overrides,
+  };
+  delete scene.level;
+  return { scene, level };
+}
+
+function setup(
+  options: { generation?: number; allowWriteOperations?: boolean; scenes?: any[] } = {}
+) {
+  const created = makeScene({ id: 'scene-new', name: 'Created', level: null });
+  const create = vi.fn(async (data: any) => {
+    Object.assign(created.scene, { name: data.name });
+    return created.scene;
+  });
+
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('Scene', { create });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'world-1', getFlag: vi.fn(() => []), setFlag: vi.fn() },

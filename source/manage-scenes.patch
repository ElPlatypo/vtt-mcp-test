+++ b/packages/mcp-server/src/tools/layout-analysis.test.ts
@@ -0,0 +1,273 @@
+import { describe, expect, it } from 'vitest';
+import {
+  alignToImage,
+  checkLayout,
+  checkSceneObjects,
+  fillAt,
+  isOpenAt,
+  isStandAt,
+  openAreas,
+  pickSpots,
+  proposeLights,
+  rasterize,
+  resolveShape,
+} from './layout-analysis.js';
+import { addShapes, createDoc, layoutOf } from './layout-doc.js';
+import { renderLayout } from './layout-utils.js';
+
+function layoutWith(shapes: any[], extra: Partial<{ columns: number; rows: number; background: string; snap: number }> = {}) {
+  const doc = createDoc({ name: 'test', columns: extra.columns ?? 24, rows: extra.rows ?? 16, grid_size: 32, snap: extra.snap ?? 0.5, ...(extra.background ? { background: extra.background } : {}) });
+  addShapes(doc, shapes);
+  return layoutOf(doc);
+}
+
+// Two rooms side by side with a thin wall between them.
+const twoRooms = (door: boolean) => [
+  { shape: 'room', at: [2, 2], size: [6, 6], name: 'west room' },
+  { shape: 'room', at: [8.5, 2], size: [6, 6], name: 'east room' },
+  ...(door ? [{ shape: 'door', at: [8.25, 4], dir: 'v', size: 1 }] : []),
+];
+
+describe('rasterize and lookups', () => {
+  it('tells floor, rock and water apart', () => {
+    const layout = layoutWith([
+      { shape: 'room', at: [2, 2], size: [6, 6] },
+      { shape: 'room', at: [4, 4], size: [2, 2], fill: 'water' },
+    ]);
+    const r = rasterize(layout);
+    expect(fillAt(r, 3, 3)).toBe('floor');
+    expect(fillAt(r, 5, 5)).toBe('water');
+    expect(fillAt(r, 12, 12)).toBe('rock');
+    expect(fillAt(r, -1, 3)).toBe('rock');
+    expect(isOpenAt(r, 5, 5)).toBe(true);
+    expect(isStandAt(r, 5, 5)).toBe(false);
+    expect(isStandAt(r, 3, 3)).toBe(true);
+  });
+});
+
+describe('checkLayout', () => {
+  it('reports rooms that nothing connects, and is quiet once a door joins them', () => {
+    const apart = checkLayout(layoutWith(twoRooms(false)));
+    expect(apart.warnings.join(' ')).toContain('not connected');
+    expect(apart.areas.length).toBe(2);
+
+    const joined = checkLayout(layoutWith(twoRooms(true)));
+    expect(joined.errors).toEqual([]);
+    expect(joined.warnings).toEqual([]);
+    expect(joined.areas.length).toBe(1);
+  });
+
+  it('flags a door with rock on a side', () => {
+    const result = checkLayout(layoutWith([{ shape: 'room', at: [2, 2], size: [6, 6] }, { shape: 'door', at: [12, 4], dir: 'v', size: 1 }]));
+    expect(result.errors.join(' ')).toContain('connects nothing');
+  });
+
+  it('warns about a door that hangs half off its opening', () => {
+    // A one-square-wide passage joining two rooms; the door starts half a square too far down.
+    const shapes = [
+      { shape: 'room', at: [2, 2], size: [2, 6], name: 'a' },
+      { shape: 'room', at: [10, 2], size: [2, 6], name: 'b' },
+      { shape: 'room', at: [4, 4], size: [6, 1], name: 'link' },
+    ];
+    const ok = checkLayout(layoutWith([...shapes, { shape: 'door', at: [7, 4], dir: 'v', size: 1 }]));
+    expect(ok.errors).toEqual([]);
+    expect(ok.warnings).toEqual([]);
+    const half = checkLayout(layoutWith([...shapes, { shape: 'door', at: [7, 4.5], dir: 'v', size: 1 }]));
+    expect(half.errors).toEqual([]);
+    // The rooms are joined by the link either way; only the door is judged.
+    expect(half.warnings.join(' ')).toContain('only partly');
+  });
+
+  it('says so when the layout is empty', () => {
+    const doc = createDoc({ name: 'empty', columns: 10, rows: 10 });
+    expect(checkLayout(layoutOf(doc)).errors[0]).toContain('no shapes');
+  });
+
+  it('lists open areas biggest first with a point inside each', () => {
+    const layout = layoutWith(twoRooms(false));
+    const areas = openAreas(layout, rasterize(layout));
+    expect(areas[0]!.squares).toBe(36);
+    const r = rasterize(layout);
+    for (const a of areas) expect(isOpenAt(r, a.at[0], a.at[1])).toBe(true);
+  });
+});
+
+describe('checkSceneObjects', () => {
+  const layout = layoutWith(twoRooms(true));
+  it('finds tokens on rock, on the same square, in water and outside, and lights and pins in rock', () => {
+    const problems = checkSceneObjects(layout, {
+      tokens: [
+        { name: 'Ok', x: 3, y: 3, width: 1, height: 1 },
+        { name: 'Rocky', x: 20, y: 12, width: 1, height: 1 },
+        { name: 'Twin A', x: 5, y: 5, width: 1, height: 1 },
+        { name: 'Twin B', x: 5.2, y: 5.1, width: 1, height: 1 },
+        { name: 'Lost', x: 40, y: 3, width: 1, height: 1 },
+      ],
+      lights: [{ x: 3, y: 3 }, { x: 20, y: 13 }],
+      notes: [{ x: 3, y: 3, text: 'fine' }, { x: 20, y: 13, text: 'buried' }],
+    });
+    const text = problems.join('\n');

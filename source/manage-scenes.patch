+    expect((createCall[1] as any).actors[0]).toMatchObject({ img: 'a.png', tokenImg: 'b.png' });
+
+    await tools.handleManageActors({
+      action: 'update',
+      updates: [{ id: 'x', tokenImg: 'c.png' }],
+    });
+    const updateCall = query.mock.calls.find(c => c[0] === 'foundry-mcp-bridge.updateActors')!;
+    expect((updateCall[1] as any).updates[0]).toMatchObject({ id: 'x', tokenImg: 'c.png' });
+  });
+});

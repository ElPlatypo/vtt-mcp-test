+    // Foundry takes at most 200 objects and 1000 wall segments per call.
+    const chunks: Array<typeof placed> = [];
+    let current: typeof placed = [];
+    let count = 0;
+    for (const w of placed) {
+      const n = Math.max(1, w.points.length - 1 + (w.closed ? 1 : 0));
+      if (current.length >= 150 || count + n > 900) {
+        chunks.push(current);
+        current = [];
+        count = 0;
+      }
+      current.push(w);
+      count += n;
+    }
+    if (current.length > 0) chunks.push(current);

+++ b/packages/foundry-module/src/plutonium-utils.ts
@@ -0,0 +1,237 @@
+/**
+ * Plutonium (5etools) data: turning 5etools entries into plain text, finding catalogue rows by name,
+ * and splitting an adventure into sections that can be searched and read.
+ */
+
+/** "{@creature goblin|MM|goblins}" -> "goblins"; "{@dc 13}" -> "DC 13"; "{@damage 1d6}" -> "1d6". */
+export function cleanTags(text: string): string {
+  let s = String(text ?? '');
+  for (let i = 0; i < 4 && s.includes('{@'); i++) {
+    s = s.replace(/\{@(\w+)(?: ([^{}]*))?\}/g, (_m, tag: string, body: string = '') => {
+      const parts = body.split('|');
+      switch (tag) {
+        case 'dc':
+          return `DC ${parts[0]}`;
+        case 'hit':
+          return `${Number(parts[0]) >= 0 ? '+' : ''}${parts[0]}`;
+        case 'h':
+          return 'Hit: ';
+        case 'atk':
+          return /m/.test(parts[0] ?? '') ? 'Melee attack:' : 'Ranged attack:';
+        case 'recharge':
+          return parts[0] ? `(Recharge ${parts[0]}-6)` : '(Recharge 6)';
+        case 'dice':
+        case 'damage':
+        case 'scaledice':
+        case 'scaledamage':
+        case 'chance':
+        case 'd20':
+          return parts[0] ?? '';
+        default:
+          // display text is the third part when given, else the name
+          return (parts[2] || parts[0] || '').trim();
+      }
+    });
+  }
+  return s;
+}
+
+type Entry = string | number | { [k: string]: any };
+
+/** 5etools entries (strings and typed objects) as plain text, headings as "## ". */
+export function entriesToText(entries: Entry | Entry[] | undefined, depth = 2): string {
+  const out: string[] = [];
+  const walk = (e: Entry | undefined, d: number): void => {
+    if (e === undefined || e === null) return;
+    if (typeof e === 'string' || typeof e === 'number') {
+      out.push(cleanTags(String(e)));
+      return;
+    }
+    if (Array.isArray(e)) {
+      for (const x of e) walk(x, d);
+      return;
+    }
+    const type = e.type;
+    if (type === 'image' || type === 'gallery' || type === 'hexColsOdd' || type === 'square' || type === 'none') {
+      if (Array.isArray(e.images)) return;
+      if (type === 'image') return;
+    }
+    if (type === 'list') {
+      for (const it of e.items ?? []) {
+        if (typeof it === 'string') out.push('- ' + cleanTags(it));
+        else if (it?.name && (it.entry || it.entries)) out.push(`- ${cleanTags(it.name)}: ${entriesToText(it.entry ?? it.entries, d)}`);
+        else {
+          const t = entriesToText(it, d);
+          if (t) out.push('- ' + t);
+        }
+      }
+      return;
+    }
+    if (type === 'table') {
+      if (e.caption) out.push(`**${cleanTags(e.caption)}**`);
+      if (Array.isArray(e.colLabels)) out.push(e.colLabels.map((c: string) => cleanTags(c)).join(' | '));
+      for (const row of e.rows ?? []) {
+        const cells = (Array.isArray(row) ? row : row?.row ?? []) as Entry[];
+        out.push(cells.map(c => entriesToText(c as any, d).replace(/\n+/g, ' ')).join(' | '));
+      }
+      return;
+    }
+    if (type === 'quote') {
+      walk(e.entries, d);
+      if (e.by) out.push(`- ${cleanTags(e.by)}`);
+      return;
+    }
+    if (type === 'statblock' || type === 'statblockInline') {
+      const sb = e.data?.name ?? e.tag ?? '';
+      out.push(`[stat block: ${cleanTags(String(e.name ?? sb))}${e.source ? ' (' + e.source + ')' : ''}]`);
+      return;
+    }
+    if (type === 'item') {
+      out.push(`- ${cleanTags(e.name ?? '')}: ${entriesToText(e.entry ?? e.entries, d)}`.trimEnd());
+      return;
+    }
+    // section, entries, inset, insetReadaloud, and anything else with nested entries
+    const label = e.name ? cleanTags(String(e.name)) : '';
+    const boxed = type === 'insetReadaloud' ? 'Read aloud' : type === 'inset' ? 'Sidebar' : '';
+    if (label || boxed) {
+      const head = type === 'inset' || type === 'insetReadaloud' ? `> ${boxed}${label ? ': ' + label : ''}` : `${'#'.repeat(Math.min(5, d))} ${label}`;
+      out.push(head);
+    }
+    if (e.entries) walk(e.entries, type === 'section' || type === 'entries' ? d + 1 : d);
+    else if (e.entry) walk(e.entry, d);
+  };
+  walk(entries as Entry, depth);
+  return out
+    .join('\n')
+    .replace(/\n{3,}/g, '\n\n')
+    .trim();
+}
+
+export interface CatalogRow {
+  name: string;
+  source: string;
+  [k: string]: any;
+}
+
+const norm = (s: string): string => s.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
+
+/** Rows whose name matches the query, exact first, then prefix, then contains; optional source filter. */
+export function findByName<T extends CatalogRow>(rows: T[], query: string, source?: string, limit = 10): T[] {
+  const q = norm(query);
+  if (!q) return [];
+  const src = source?.toLowerCase();
+  const scored: Array<{ r: T; s: number }> = [];
+  for (const r of rows) {
+    if (src && String(r.source).toLowerCase() !== src) continue;
+    const n = norm(r.name);
+    let s = 0;
+    if (n === q) s = 100;
+    else if (n.startsWith(q)) s = 60;
+    else if (n.split(' ').some(w => w === q)) s = 50;
+    else if (n.includes(q)) s = 30;
+    else if (q.split(' ').every(w => n.includes(w))) s = 20;
+    if (s) scored.push({ r, s: s - (isSrdSource(r.source) ? 0 : 1) });
+  }
+  return scored
+    .sort((a, b) => b.s - a.s || a.r.name.length - b.r.name.length || a.r.name.localeCompare(b.r.name))
+    .slice(0, Math.max(1, limit))
+    .map(x => x.r);
+}
+
+/** The core books, which rank above third-party sources when names tie. */
+export function isSrdSource(source: string): boolean {
+  return ['MM', 'PHB', 'DMG', 'XGE', 'TCE', 'MPMM', 'VGM', 'MTF', 'VRGR', 'XMM', 'XPHB', 'XDMG', 'LMoP'].includes(String(source));
+}
+
+export function creatureCr(m: any): string {
+  const cr = m?.cr;
+  return cr === undefined ? '?' : typeof cr === 'object' ? String(cr.cr) : String(cr);
+}
+
+export function creatureType(m: any): string {
+  const t = m?.type;
+  return typeof t === 'string' ? t : t?.type ?? '';
+}
+
+export interface AdventureSection {
+  index: number;
+  name: string;
+  /** the headings inside the section, for finding a place */
+  headers: string[];
+  text: string;
+}
+
+/** An adventure's top-level sections, named from the index entry when the data has no name. */
+export function adventureSections(data: any[], contents: any[] = []): AdventureSection[] {
+  return (data ?? []).map((sec, index) => {
+    const headers: string[] = [];
+    const collect = (e: any): void => {
+      if (!e || typeof e !== 'object') return;
+      if (Array.isArray(e)) return e.forEach(collect);
+      if (e.type === 'entries' && e.name) headers.push(cleanTags(String(e.name)));
+      if (e.entries) collect(e.entries);
+    };
+    collect(sec?.entries);
+    return {
+      index,
+      name: cleanTags(String(sec?.name ?? contents[index]?.name ?? `Section ${index + 1}`)),
+      headers,
+      text: entriesToText(sec, 2),
+    };
+  });
+}
+
+/** Sections that mention the query, best first, with a snippet around the first hit. */
+export function searchSections(sections: AdventureSection[], query: string, limit = 6): Array<{ index: number; section: string; snippet: string; matches: number }> {
+  const terms = [...new Set((query.toLowerCase().match(/[a-z0-9']+/g) ?? []).filter(w => w.length > 1))];
+  if (terms.length === 0) return [];
+  const hits: Array<{ index: number; section: string; snippet: string; matches: number; score: number }> = [];
+  for (const sec of sections) {
+    const lower = sec.text.toLowerCase();
+    let matches = 0;
+    let first = -1;
+    let found = 0;
+    for (const t of terms) {
+      let i = -1;
+      let n = 0;
+      while ((i = lower.indexOf(t, i + 1)) >= 0) {
+        n++;
+        if (first < 0 || i < first) first = i;
+      }
+      if (n) found++;
+      matches += n;
+    }
+    if (found < Math.ceil(terms.length / 2)) continue;
+    const score = found * 50 + Math.min(matches, 30) + (terms.some(t => sec.name.toLowerCase().includes(t)) ? 40 : 0);
+    const start = Math.max(0, first - 90);
+    hits.push({ index: sec.index, section: sec.name, matches, score, snippet: (start > 0 ? '... ' : '') + sec.text.slice(start, start + 260).replace(/\s+/g, ' ').trim() + ' ...' });
+  }
+  return hits
+    .sort((a, b) => b.score - a.score)
+    .slice(0, limit)
+    .map(({ score: _s, ...h }) => h);
+}
+
+/**
+ * Cut a section down to the part under one heading when `heading` is given (case-insensitive contains),
+ * from that heading to the next heading of the same or higher level.
+ */
+export function pickHeading(text: string, heading: string): string | null {
+  const lines = text.split('\n');
+  const want = heading.toLowerCase();
+  let start = -1;
+  let level = 0;
+  for (let i = 0; i < lines.length; i++) {
+    const m = /^(#{1,6}) (.*)$/.exec(lines[i]!);
+    if (!m) continue;
+    if (start < 0) {
+      if (m[2]!.toLowerCase().includes(want)) {
+        start = i;
+        level = m[1]!.length;
+      }
+    } else if (m[1]!.length <= level) {
+      return lines.slice(start, i).join('\n').trim();
+    }
+  }
+  return start < 0 ? null : lines.slice(start).join('\n').trim();
+}

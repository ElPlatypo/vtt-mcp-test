+import { describe, expect, it } from 'vitest';
+import { buildObjectUpdate } from './object-update-utils.js';
+import type { GridGeometry } from './scene-objects-utils.js';
+
+const geom: GridGeometry = { size: 100, originX: 200, originY: 100, sceneWidth: 2000, sceneHeight: 1500, columns: 20, rows: 15, distance: 5, units: 'ft' };
+const cur = { x: 700, y: 400 }; // square (5, 3)
+
+describe('buildObjectUpdate', () => {
+  it('moves in squares and keeps the other axis', () => {
+    expect(buildObjectUpdate('note', { x: 10 }, geom, cur, 'u')).toEqual({ x: 1200, y: 400 });
+    expect(buildObjectUpdate('note', { y: 2.5 }, geom, cur, 'u')).toEqual({ x: 700, y: 350 });
+    expect(buildObjectUpdate('token', { x: 1, y: 2 }, geom, cur, 'u')).toEqual({ x: 300, y: 300 });
+  });
+  it('rejects positions off the map and unknown fields', () => {
+    expect(() => buildObjectUpdate('note', { x: 21 }, geom, cur, 'u')).toThrow('x must be grid squares');
+    expect(() => buildObjectUpdate('token', { bright: 3 }, geom, cur, 'u')).toThrow('bright cannot be changed on a token');
+    expect(() => buildObjectUpdate('token', {}, geom, cur, 'u')).toThrow('nothing to change');
+    expect(() => buildObjectUpdate('wall', { x: 1, door_state: 'open' }, geom, cur, 'u')).toThrow('cannot be changed on a wall');
+  });
+  it('converts light radii and uses dotted config keys', () => {
+    expect(buildObjectUpdate('light', { bright: 3, dim: 6, color: '#FFA040', alpha: 0.5, animation: 'torch' }, geom, cur, 'u')).toEqual({
+      'config.bright': 15,
+      'config.dim': 30,
+      'config.color': '#ffa040',
+      'config.alpha': 0.5,
+      'config.animation': { type: 'torch', speed: 5, intensity: 5 },
+    });
+    expect(buildObjectUpdate('light', { animation: null }, geom, cur, 'u')).toEqual({ 'config.animation': { type: null } });
+    expect(() => buildObjectUpdate('light', { color: 'red' }, geom, cur, 'u')).toThrow('#RRGGBB');
+    expect(() => buildObjectUpdate('light', { animation: 'sparkle' }, geom, cur, 'u')).toThrow('animation');
+  });
+  it('handles tokens, notes, tiles and sounds', () => {
+    expect(buildObjectUpdate('token', { name: 'Boss', width: 2, disposition: -1, hidden: true, elevation: 5 }, geom, cur, 'u')).toEqual({
+      name: 'Boss', width: 2, disposition: -1, hidden: true, elevation: 5,
+    });
+    expect(() => buildObjectUpdate('token', { disposition: 3 }, geom, cur, 'u')).toThrow('disposition');
+    expect(buildObjectUpdate('note', { text: 'Inn', font_size: 40, icon_size: 64, global: true, icon: 'a.svg' }, geom, cur, 'u')).toEqual({
+      text: 'Inn', fontSize: 40, iconSize: 64, global: true, 'texture.src': 'a.svg',
+    });
+    expect(buildObjectUpdate('tile', { width: 2, height: 1.5, rotation: 90, alpha: 0.4, src: 'p/a.png' }, geom, cur, 'u')).toEqual({
+      width: 200, height: 150, rotation: 90, alpha: 0.4, 'texture.src': 'p/a.png',
+    });
+    expect(() => buildObjectUpdate('tile', { src: 'http://x/a.png' }, geom, cur, 'u')).toThrow('Foundry files');
+    expect(buildObjectUpdate('sound', { radius: 4, volume: 0.2, repeat: false, walls: false, easing: true, path: 'a.mp3' }, geom, cur, 'u')).toEqual({
+      radius: 20, volume: 0.2, repeat: false, walls: false, easing: true, path: 'a.mp3',
+    });
+    expect(() => buildObjectUpdate('sound', { volume: 2 }, geom, cur, 'u')).toThrow('volume');
+  });
+  it('sets door states', () => {
+    expect(buildObjectUpdate('wall', { door_state: 'locked' }, geom, cur, 'u')).toEqual({ ds: 2 });
+    expect(buildObjectUpdate('wall', { door_state: 'open' }, geom, cur, 'u')).toEqual({ ds: 1 });
+    expect(() => buildObjectUpdate('wall', { door_state: 'ajar' }, geom, cur, 'u')).toThrow('door_state');
+  });
+});

+import { describe, expect, it, vi } from 'vitest';
+import { PlaylistTools } from './playlist.js';
+
+function makeTools() {
+  const query = vi.fn(async () => ({}));
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  return { tools: new PlaylistTools({ foundryClient: { query } as any, logger }), query };
+}
+
+describe('control-playlist', () => {
+  it('offers the new commands and only requires command', () => {
+    const def = makeTools().tools.getToolDefinitions().find(d => d.name === 'control-playlist')!;
+    expect(def.inputSchema.required).toEqual(['command']);
+    expect((def.inputSchema.properties as any).command.enum).toEqual(
+      expect.arrayContaining(['pause', 'resume', 'next', 'previous', 'set-volume', 'now-playing', 'stop-all', 'pause-sound', 'resume-sound'])
+    );
+  });
+
+  it('sends commands that need no playlist', async () => {
+    const { tools, query } = makeTools();
+    await tools.handleControlPlaylist({ command: 'now-playing' });
+    await tools.handleControlPlaylist({ command: 'stop-all' });
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.control-playlist', { command: 'now-playing' });
+    expect(query).toHaveBeenCalledTimes(2);
+  });
+
+  it('checks what each command needs', async () => {
+    const { tools, query } = makeTools();
+    await expect(tools.handleControlPlaylist({ command: 'pause' })).rejects.toThrow('requires "playlist"');
+    await expect(tools.handleControlPlaylist({ command: 'pause-sound', playlist: 'a' })).rejects.toThrow('requires "sound"');
+    await expect(tools.handleControlPlaylist({ command: 'set-volume', playlist: 'a' })).rejects.toThrow('requires "volume"');
+    await expect(tools.handleControlPlaylist({ command: 'set-volume', playlist: 'a', volume: 3 })).rejects.toThrow();
+    await expect(tools.handleControlPlaylist({ command: 'dance', playlist: 'a' })).rejects.toThrow();
+    expect(query).not.toHaveBeenCalled();
+    await tools.handleControlPlaylist({ command: 'set-volume', playlist: 'a', sound: 'b', volume: 0.3 });
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.control-playlist', { command: 'set-volume', playlist: 'a', sound: 'b', volume: 0.3 });
+  });
+});
+
+describe('manage-playlists add and remove sounds', () => {
+  it('passes add_sounds and remove_sounds through and checks them', async () => {
+    const { tools, query } = makeTools();
+    await tools.handleManagePlaylists({
+      action: 'update',
+      playlist: 'Cave',
+      add_sounds: [{ path: 'worlds/w/uploads/audio/drip.mp3', repeat: true }],
+      remove_sounds: ['old'],
+    });
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.manage-playlists', expect.objectContaining({
+      add_sounds: [{ path: 'worlds/w/uploads/audio/drip.mp3', repeat: true }],
+      remove_sounds: ['old'],
+    }));
+    await expect(tools.handleManagePlaylists({ action: 'update', playlist: 'Cave', add_sounds: [{ name: 'x' }] })).rejects.toThrow();
+    await expect(tools.handleManagePlaylists({ action: 'update', playlist: 'Cave', add_sounds: [{ path: 'a', bogus: 1 }] })).rejects.toThrow();
+  });
+});

@@ -0,0 +1,58 @@
+import { describe, expect, it, vi } from 'vitest';
+import { ModuleTools } from './module-tools.js';
+
+function makeTools(queryImpl?: (method: string, data: any) => unknown) {
+  const query = vi.fn(queryImpl ?? (async () => ({ success: true })));
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  return { tools: new ModuleTools({ foundryClient: { query } as any, logger }), query };
+}
+
+describe('manage-modules definition', () => {
+  it('is exposed with action required', () => {
+    const defs = makeTools().tools.getToolDefinitions();
+    expect(defs.map(d => d.name)).toEqual(['manage-modules']);
+    expect(defs[0]!.inputSchema.required).toEqual(['action']);
+  });
+});
+
+describe('handleManageModules', () => {
+  it('sends a valid request to the module', async () => {
+    const { tools, query } = makeTools(async () => ({ success: true, modules: [] }));
+    const r = await tools.handleManageModules({ action: 'list', filter: 'active' });
+    expect(r.success).toBe(true);
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.manage-modules', { action: 'list', filter: 'active' });
+  });
+
+  it('checks the fields each action needs', async () => {
+    const { tools, query } = makeTools();
+    await expect(tools.handleManageModules({ action: 'describe' })).rejects.toThrow('describe needs module');
+    await expect(tools.handleManageModules({ action: 'get_setting', module: 'a' })).rejects.toThrow('needs key');
+    await expect(tools.handleManageModules({ action: 'set_setting', module: 'a', key: 'k' })).rejects.toThrow('needs value');
+    await expect(tools.handleManageModules({ action: 'call', module: 'a' })).rejects.toThrow('needs path');
+    await expect(tools.handleManageModules({ action: 'set_active', modules: ['a'] })).rejects.toThrow('needs active');
+    expect(query).not.toHaveBeenCalled();
+  });
+
+  it('accepts a setting value of false, 0 or null-like content', async () => {
+    const { tools, query } = makeTools();
+    await tools.handleManageModules({ action: 'set_setting', module: 'a', key: 'k', value: false });
+    await tools.handleManageModules({ action: 'set_setting', module: 'a', key: 'k', value: 0 });
+    expect(query).toHaveBeenCalledTimes(2);
+  });
+
+  it('rejects unknown fields and actions', async () => {
+    const { tools } = makeTools();
+    await expect(tools.handleManageModules({ action: 'list', bogus: 1 })).rejects.toThrow();
+    await expect(tools.handleManageModules({ action: 'explode' })).rejects.toThrow();
+    await expect(tools.handleManageModules({ action: 'call', module: 'a', path: 'f', args: new Array(21).fill(1) })).rejects.toThrow();
+  });
+
+  it('turns a refusal or failure into a readable error', async () => {
+    const refused = makeTools(async () => ({ success: false, error: 'conflicts with x' }));
+    await expect(refused.tools.handleManageModules({ action: 'list' })).rejects.toThrow('Failed to manage modules: conflicts with x');
+    const down = makeTools(async () => {
+      throw new Error('timeout');
+    });
+    await expect(down.tools.handleManageModules({ action: 'list' })).rejects.toThrow('timeout');
+  });
+});
diff --git a/packages/mcp-server/src/tools/module-tools.ts b/packages/mcp-server/src/tools/module-tools.ts
new file mode 100644
index 0000000..fe5663b
--- /dev/null
+++ b/packages/mcp-server/src/tools/module-tools.ts
@@ -0,0 +1,96 @@
+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+
+export interface ModuleToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+const id = z.string().min(1).max(100);
+
+const schema = z
+  .object({
+    action: z.enum(['list', 'describe', 'get_setting', 'set_setting', 'call', 'set_active']),
+    module: id.optional(),
+    modules: z.array(id).min(1).max(40).optional(),
+    filter: z.enum(['all', 'active', 'inactive']).optional(),
+    search: z.string().min(1).max(100).optional(),
+    key: z.string().min(1).max(200).optional(),
+    value: z.any().optional(),
+    path: z.string().min(1).max(200).optional(),
+    args: z.array(z.any()).max(20).optional(),
+    active: z.boolean().optional(),
+    confirm: z.boolean().optional(),
+    dry_run: z.boolean().optional(),
+  })
+  .strict();
+
+export class ModuleTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: ModuleToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'ModuleTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'manage-modules',
+        description:
+          'Look at the Foundry modules installed on the server and use them. ' +
+          'list {filter?: all|active|inactive, search?} shows installed modules (id, title, version, whether active, whether it has a public API). ' +
+          'describe {module} shows one module: description, what it requires and conflicts with, the settings it registers (key, name, hint, scope, type, default and current value) and, when active, its public API (function names, one level of nested objects). ' +
+          'get_setting {module, key} and set_setting {module, key, value} read and change a module setting (world settings change for everyone). ' +
+          'call {module, path, args?} runs a function of the module\'s public API (game.modules.get(id).api) and returns its result as JSON; path is like "getByTag" or "tags.add", args a list of values; documents in results come back as {documentName, id, uuid, name}. Only active modules that publish an api can be called, and nothing outside that api is reachable; read describe first for the real function names and see the module\'s own documentation for what the arguments mean. ' +
+          'set_active {modules, active, confirm?, dry_run?} switches modules on or off in this world: it adds the modules they require (switching on) or that depend on them (switching off), refuses conflicts, and without confirm: true only reports what it would change. Nothing takes effect until the Foundry page is reloaded (F5); the connection to this tool is never switched off. ' +
+          'Changing settings, calling APIs and switching modules are write operations, as with macros: what a module function does is up to that module. Needs the Foundry tab open in a browser.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: { type: 'string', enum: ['list', 'describe', 'get_setting', 'set_setting', 'call', 'set_active'] },
+            module: { type: 'string', description: 'describe / get_setting / set_setting / call: module id (see list)' },
+            modules: { type: 'array', items: { type: 'string' }, description: 'set_active: module ids' },
+            filter: { type: 'string', enum: ['all', 'active', 'inactive'], description: 'list: which modules (default all)' },
+            search: { type: 'string', description: 'list: only ids or titles containing this text' },
+            key: { type: 'string', description: 'get_setting / set_setting: the setting key as describe shows it' },
+            value: { description: 'set_setting: the new value (boolean, number, string, object)' },
+            path: { type: 'string', description: 'call: function name below the module api, e.g. "getByTag" or "tags.add"' },
+            args: { type: 'array', items: {}, description: 'call: arguments, in order (JSON values; use document ids or uuids, not objects, where the module accepts them)' },
+            active: { type: 'boolean', description: 'set_active: true to switch on, false to switch off' },
+            confirm: { type: 'boolean', description: 'set_active: must be true to apply the change' },
+            dry_run: { type: 'boolean', description: 'set_active: only report what would change' },
+          },
+          required: ['action'],
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handleManageModules(args: any): Promise<any> {
+    const parsed = schema.parse(args ?? {});
+    const needs: Record<string, Array<keyof typeof parsed>> = {
+      describe: ['module'],
+      get_setting: ['module', 'key'],
+      set_setting: ['module', 'key'],
+      call: ['module', 'path'],
+      set_active: ['modules', 'active'],
+    };
+    for (const field of needs[parsed.action] ?? []) {
+      if (parsed[field] === undefined) throw new Error(`${parsed.action} needs ${String(field)}`);
+    }
+    if (parsed.action === 'set_setting' && !('value' in (args ?? {}))) throw new Error('set_setting needs value');
+
+    try {
+      const result = await this.foundryClient.query('foundry-mcp-bridge.manage-modules', parsed);
+      if (result?.success === false) throw new Error(result.error || 'Request was refused');
+      return result;
+    } catch (error) {
+      this.logger.error('Failed to manage modules', error);
+      throw new Error(`Failed to manage modules: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+}

@@ -0,0 +1,36 @@
+import { describe, expect, it, vi } from 'vitest';
+import { AnnotationTools } from './annotation-tools.js';
+
+function make(result: any = { success: true }) {
+  const query = vi.fn(async () => result);
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  return { tools: new AnnotationTools({ foundryClient: { query } as any, logger }), query };
+}
+
+describe('annotations', () => {
+  it('is exposed with action required', () => {
+    const def = make().tools.getToolDefinitions()[0]!;
+    expect(def.name).toBe('annotations');
+    expect(def.inputSchema.required).toEqual(['action']);
+  });
+  it('sends list, resolve and clear to the bridge', async () => {
+    const { tools, query } = make();
+    await tools.handle({ action: 'list' });
+    expect(query).toHaveBeenLastCalledWith('foundry-mcp-bridge.annotations', { action: 'list' });
+    await tools.handle({ action: 'list', scene: 'Cave', status: 'all' });
+    expect(query).toHaveBeenLastCalledWith('foundry-mcp-bridge.annotations', { action: 'list', scene: 'Cave', status: 'all' });
+    await tools.handle({ action: 'resolve', ids: ['n1', 'n2'], reply: 'Done: new picture' });
+    expect(query).toHaveBeenLastCalledWith('foundry-mcp-bridge.annotations', { action: 'resolve', ids: ['n1', 'n2'], reply: 'Done: new picture' });
+    await tools.handle({ action: 'clear' });
+    expect(query).toHaveBeenLastCalledWith('foundry-mcp-bridge.annotations', { action: 'clear' });
+  });
+  it('refuses bad input and passes on a refusal', async () => {
+    const { tools } = make();
+    await expect(tools.handle({})).rejects.toThrow();
+    await expect(tools.handle({ action: 'resolve' })).rejects.toThrow();
+    await expect(tools.handle({ action: 'resolve', ids: [] })).rejects.toThrow();
+    await expect(tools.handle({ action: 'list', status: 'soon' })).rejects.toThrow();
+    await expect(tools.handle({ action: 'list', ids: ['x'] })).rejects.toThrow();
+    await expect(make({ success: false, error: 'GM only' }).tools.handle({ action: 'list' })).rejects.toThrow('GM only');
+  });
+});
diff --git a/packages/mcp-server/src/tools/annotation-tools.ts b/packages/mcp-server/src/tools/annotation-tools.ts
new file mode 100644
index 0000000..68dbfab
--- /dev/null
+++ b/packages/mcp-server/src/tools/annotation-tools.ts
@@ -0,0 +1,76 @@
+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+
+export interface AnnotationToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+const schema = z.discriminatedUnion('action', [
+  z
+    .object({
+      action: z.literal('list'),
+      scene: z.string().min(1).optional(),
+      status: z.enum(['open', 'done', 'dismissed', 'all']).optional(),
+    })
+    .strict(),
+  z
+    .object({
+      action: z.literal('resolve'),
+      ids: z.array(z.string().min(1)).min(1).max(50),
+      status: z.enum(['open', 'done', 'dismissed']).optional(),
+      reply: z.string().max(2000).optional(),
+    })
+    .strict(),
+  z
+    .object({
+      action: z.literal('clear'),
+      scene: z.string().min(1).optional(),
+    })
+    .strict(),
+]);
+
+export class AnnotationTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: AnnotationToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'AnnotationTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'annotations',
+        description:
+          'The notes the GM leaves on the map with the "Notes for Claude" tools (upper-left scene controls in Foundry): a click on one object, or a drawn area, plus what should change ("change the picture of this prop", "clean up the walls here", "add enemies here"). ' +
+          'action list (default status open; also done, dismissed, all; optional scene): each note has id, number (the orange pin on the map), scene, prompt, and either target {kind: token | light | tile | sound | note | drawing | wall | region, id, name, x, y, width, height} or area {shape, points, bbox} in grid squares from the top-left of the map (the same coordinates the other scene tools use). ' +
+          'A target says stillThere:false when the object was deleted and nowAt when it moved; an area lists what is inside it (tokens by name, lights, walls, doors, tiles...). Check for open notes at the start of a session and whenever the GM says they left notes. ' +
+          'action resolve: ids, status (done by default; dismissed, or open to reopen) and reply (a short message the GM sees next to the note) once you have dealt with it. ' +
+          'action clear: removes finished (done and dismissed) notes.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: { type: 'string', enum: ['list', 'resolve', 'clear'] },
+            scene: { type: 'string', description: 'list or clear: only this scene (id or exact name)' },
+            status: { type: 'string', enum: ['open', 'done', 'dismissed', 'all'], description: 'list: which notes (default open); resolve: the new status (default done)' },
+            ids: { type: 'array', maxItems: 50, items: { type: 'string' }, description: 'resolve: ids of the notes' },
+            reply: { type: 'string', description: 'resolve: what you did, shown to the GM' },
+          },
+          required: ['action'],
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handle(args: unknown): Promise<any> {
+    const a = schema.parse(args ?? {});
+    this.logger.info('Annotations', { action: a.action });
+    const result = await this.foundryClient.query('foundry-mcp-bridge.annotations', a);
+    if (result?.success === false) throw new Error(result.error || 'Request was refused');
+    return result;
+  }
+}

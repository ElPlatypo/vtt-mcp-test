+/** manage-roll-tables and manage-macros tests with Foundry stubbed. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+
+function setup(allow = true) {
+  const table: any = {
+    id: 't1',
+    name: 'Trail Encounters',
+    formula: '1d4',
+    replacement: true,
+    results: { contents: [{ id: 'r1', name: 'Wolves', range: [1, 1], weight: 1 }] },
+    update: vi.fn(async () => undefined),
+    deleteEmbeddedDocuments: vi.fn(async () => undefined),
+    createEmbeddedDocuments: vi.fn(async () => undefined),
+    draw: vi.fn(async () => ({ roll: { total: 1 }, results: [{ name: 'Wolves', description: '' }] })),
+  };
+  const macro: any = {
+    id: 'm1',
+    uuid: 'Macro.m1',
+    name: 'Pit',
+    type: 'script',
+    command: 'return 7;',
+    update: vi.fn(async () => undefined),
+    execute: vi.fn(async () => 7),
+  };
+  const RollTable = {
+    create: vi.fn(async (d: any) => ({ id: 't2', name: d.name, formula: d.formula, results: { contents: d.results } })),
+  };
+  const Macro = { create: vi.fn(async (d: any) => ({ id: 'm2', name: d.name, type: d.type })) };
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('RollTable', RollTable);
+  vi.stubGlobal('Macro', Macro);
+  vi.stubGlobal('Folder', { create: vi.fn(async (d: any) => ({ id: 'f9', name: d.name })) });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'GM' },
+    tables: { contents: [table] },
+    macros: { contents: [macro] },
+    folders: { contents: [] },
+    settings: { get: (_m: string, k: string) => (k === 'allowWriteOperations' ? allow : undefined) },
+  });
+  return { da: new FoundryDataAccess(), table, macro, RollTable, Macro };
+}
+
+describe('manageRollTables', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('creates a table with ranges and a formula', async () => {
+    const { da, RollTable } = setup();
+    await da.manageRollTables({ action: 'create', name: 'Loot', results: [{ text: 'Gold' }, { text: 'Gem', weight: 2 }] });
+    const data = RollTable.create.mock.calls[0][0];
+    expect(data).toMatchObject({ name: 'Loot', formula: '1d3', replacement: true, displayRoll: true });
+    expect(data.results.map((r: any) => r.range)).toEqual([[1, 1], [2, 3]]);
+  });
+
+  it('lists, describes and rolls', async () => {
+    const { da, table } = setup();
+    expect((await da.manageRollTables({ action: 'list' })).tables[0]).toMatchObject({ name: 'Trail Encounters', rows: 1 });
+    expect((await da.manageRollTables({ action: 'describe', table: 'trail encounters' })).table.results[0].text).toBe('Wolves');
+    const r = await da.manageRollTables({ action: 'roll', table: 't1', times: 2 });
+    expect(table.draw).toHaveBeenCalledTimes(2);
+    expect(r.rolled[0]).toEqual({ roll: 1, results: [{ text: 'Wolves', description: undefined }] });
+  });
+
+  it('replaces the rows on update', async () => {
+    const { da, table } = setup();
+    await da.manageRollTables({ action: 'update', table: 't1', results: [{ text: 'A' }, { text: 'B' }] });
+    expect(table.update).toHaveBeenCalledWith({ formula: '1d2' });
+    expect(table.deleteEmbeddedDocuments).toHaveBeenCalledWith('TableResult', ['r1']);
+    expect(table.createEmbeddedDocuments.mock.calls[0][1]).toHaveLength(2);
+  });
+
+  it('is blocked when writes are off, but listing works', async () => {
+    const { da, RollTable } = setup(false);
+    await expect(da.manageRollTables({ action: 'create', name: 'x', results: [{ text: 'a' }] })).rejects.toThrow();
+    expect(RollTable.create).not.toHaveBeenCalled();
+    await expect(da.manageRollTables({ action: 'list' })).resolves.toMatchObject({ success: true });
+  });
+});
+
+describe('manageMacros', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('creates, describes, updates and executes', async () => {
+    const { da, macro, Macro } = setup();
+    await da.manageMacros({ action: 'create', name: 'New', command: 'x' });
+    expect(Macro.create.mock.calls[0][0]).toMatchObject({ name: 'New', type: 'script', scope: 'global' });
+    expect((await da.manageMacros({ action: 'describe', macro: 'Pit' })).macro.command).toBe('return 7;');
+    await da.manageMacros({ action: 'update', macro: 'm1', command: 'return 8;' });
+    expect(macro.update).toHaveBeenCalledWith({ name: 'Pit', type: 'script', command: 'return 8;' });
+    const run = await da.manageMacros({ action: 'execute', macro: 'Pit' });
+    expect(run.returned).toBe(7);
+    expect(run.macro.uuid).toBe('Macro.m1');
+  });
+
+  it('refuses to run or create when writes are off', async () => {
+    const { da, macro } = setup(false);
+    await expect(da.manageMacros({ action: 'execute', macro: 'Pit' })).rejects.toThrow();
+    expect(macro.execute).not.toHaveBeenCalled();
+    await expect(da.manageMacros({ action: 'list' })).resolves.toMatchObject({ success: true });
+  });
+});
diff --git a/packages/foundry-module/src/data-access.playlists.test.ts b/packages/foundry-module/src/data-access.playlists.test.ts

+import { describe, expect, it, vi } from 'vitest';
+import { RevealTools } from './reveal-tools.js';
+
+function make(result: any = { success: true }) {
+  const query = vi.fn(async () => result);
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  return { tools: new RevealTools({ foundryClient: { query } as any, logger }), query };
+}
+
+describe('reveal', () => {
+  it('is exposed', () => {
+    const def = make().tools.getToolDefinitions()[0]!;
+    expect(def.name).toBe('reveal');
+    expect(Object.keys(def.inputSchema.properties).sort()).toEqual(['hide', 'reset_fog', 'reveal', 'scene']);
+  });
+  it('sends reveal, hide and fog requests to the bridge', async () => {
+    const { tools, query } = make();
+    const args = { scene: 'Cave', reveal: [{ kind: 'token', name: 'Goblin' }], hide: [{ kind: 'door', x: 3, y: 4, radius: 2 }], reset_fog: true };
+    await tools.handleReveal(args);
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.reveal', args);
+    await tools.handleReveal({ reset_fog: true });
+  });
+  it('refuses empty and bad requests and passes on a refusal', async () => {
+    const { tools } = make();
+    await expect(tools.handleReveal({})).rejects.toThrow('Give reveal');
+    await expect(tools.handleReveal({ reveal: [] })).rejects.toThrow('Give reveal');
+    await expect(tools.handleReveal({ reveal: [{ kind: 'wall', id: 'x' }] })).rejects.toThrow();
+    await expect(tools.handleReveal({ reveal: [{ kind: 'token', color: 'red' }] })).rejects.toThrow();
+    await expect(make({ success: false, error: 'GM only' }).tools.handleReveal({ reset_fog: true })).rejects.toThrow('GM only');
+  });
+});

@@ -0,0 +1,270 @@
+/* Map Generation Service settings dialog. Self-contained (mgs- prefix) so it does not depend on,
+   or disturb, the Enhanced Creature Index dialog styles. Uses Foundry's theme variables with
+   fallbacks so it reads on both the dark and light themes. */
+
+.mgs-settings {
+  --mgs-text: var(--color-text-primary, #f0f0e0);
+  --mgs-muted: var(--color-text-secondary, #b8b8a8);
+  --mgs-border: var(--color-border-light-tertiary, rgba(255, 255, 255, 0.22));
+  --mgs-panel: rgba(255, 255, 255, 0.05);
+  width: 100%;
+  min-width: 0;
+  box-sizing: border-box;
+  display: flex;
+  flex-direction: column;
+  gap: 1rem;
+  color: var(--mgs-text);
+  text-align: left;
+  max-height: calc(100vh - 9rem);
+  overflow-y: auto;
+  padding-right: 0.25rem;
+}
+
+.mgs-settings * {
+  box-sizing: border-box;
+}
+
+/* Sections */
+.mgs-block {
+  margin: 0;
+  padding: 0;
+}
+
+.mgs-settings-block {
+  padding: 0.9rem 1rem;
+  background: var(--mgs-panel);
+  border: 1px solid var(--mgs-border);
+  border-radius: 6px;
+}
+
+/* Headings: undo Foundry's default heading underline, margins and font */
+.mgs-settings h2,
+.mgs-settings h3 {
+  margin: 0 0 0.5rem;
+  padding: 0;
+  border: none;
+  font-family: inherit;
+  color: var(--mgs-text);
+}
+
+.mgs-title {
+  font-size: 1.35rem;
+  font-weight: 700;
+}
+
+.mgs-subtitle {
+  font-size: 1.05rem;
+  font-weight: 700;
+}
+
+.mgs-note,
+.mgs-hint,
+.mgs-status-detail {
+  margin: 0.25rem 0 0;
+  color: var(--mgs-muted);
+  font-size: 0.85rem;
+  line-height: 1.4;
+}
+
+.mgs-note {
+  font-size: 0.9rem;
+}
+
+.mgs-status-detail:empty {
+  display: none;
+}
+
+.mgs-hint code,
+.mgs-note code {
+  padding: 0 0.25rem;
+  border-radius: 3px;
+  background: rgba(255, 255, 255, 0.1);
+  color: var(--mgs-text);
+  font-size: 0.8rem;
+}
+
+.mgs-hint[hidden],
+.mgs-custom[hidden] {
+  display: none;
+}
+
+/* Fields: label above the control, not beside it */
+.mgs-form-group {
+  display: flex;
+  flex-direction: column;
+  align-items: stretch;
+  gap: 0.3rem;
+  margin: 0 0 0.9rem;
+}
+
+.mgs-form-group:last-child {
+  margin-bottom: 0;
+}
+
+.mgs-label {
+  flex: none;
+  margin: 0;
+  font-weight: 700;
+  color: var(--mgs-text);
+}
+
+.mgs-settings select,
+.mgs-settings input[type="text"],
+.mgs-settings input[type="number"] {
+  width: 100%;
+  min-width: 0;
+  height: 2.25rem;
+  padding: 0 0.6rem;
+  line-height: normal;
+  color: var(--mgs-text);
+  background: rgba(0, 0, 0, 0.3);
+  border: 1px solid var(--mgs-border);
+  border-radius: 4px;
+}
+
+.mgs-settings select option {
+  color: #111;
+}
+
+.mgs-settings select:focus,
+.mgs-settings input:focus {
+  outline: none;
+  border-color: var(--color-border-highlight, #ff9f1c);
+  box-shadow: 0 0 0 2px rgba(255, 159, 28, 0.3);
+}
+
+.mgs-settings input::placeholder {
+  color: var(--mgs-muted);
+  opacity: 0.8;
+}
+
+/* Checkboxes */
+.mgs-check {
+  display: flex;
+  align-items: flex-start;
+  gap: 0.6rem;
+  margin: 0 0 0.9rem;
+  cursor: pointer;
+}
+
+.mgs-check input[type="checkbox"] {
+  flex: none;
+  margin: 0.15rem 0 0;
+}
+
+.mgs-check span {
+  line-height: 1.4;
+}
+
+/* Status */
+.mgs-status-container {
+  display: flex;
+  flex-direction: column;
+  gap: 0.6rem;
+}
+
+.mgs-status {
+  padding: 0.6rem 1rem;
+  border: 1px solid var(--mgs-border);
+  border-radius: 4px;
+  font-weight: 700;
+  text-align: center;
+}
+
+.mgs-status.running {
+  background: rgba(76, 175, 80, 0.15);
+  border-color: rgba(76, 175, 80, 0.5);
+  color: #6fcf73;
+}
+
+.mgs-status.stopped,
+.mgs-status.error {
+  background: rgba(244, 67, 54, 0.15);
+  border-color: rgba(244, 67, 54, 0.5);
+  color: #ff7b72;
+}
+
+.mgs-status.starting {
+  background: rgba(255, 152, 0, 0.15);
+  border-color: rgba(255, 152, 0, 0.5);
+  color: #ffb347;
+}
+
+.mgs-status.unknown {
+  color: var(--mgs-muted);
+}
+
+/* Buttons: side by side, natural width */
+.mgs-controls {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+}
+
+.mgs-btn {
+  flex: 1 1 8rem;
+  width: auto;
+  height: auto;
+  margin: 0;
+  padding: 0.5rem 0.9rem;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 0.5rem;
+  line-height: 1.2;
+  font-weight: 700;
+  color: #fff;
+  background: #4a4a4a;
+  border: 1px solid rgba(255, 255, 255, 0.25);
+  border-radius: 4px;
+  cursor: pointer;
+}
+
+.mgs-btn:hover:not(:disabled) {
+  filter: brightness(1.15);
+}
+
+.mgs-btn:disabled {
+  opacity: 0.4;
+  cursor: not-allowed;
+}
+
+.mgs-btn.check {
+  background: #1f7ac4;
+}
+
+.mgs-btn.start {
+  background: #3d8b40;
+}
+
+.mgs-btn.stop {
+  background: #c0392b;
+}
+
+/* Footer */
+.mgs-footer {
+  display: flex;
+  justify-content: flex-end;
+  padding-top: 0.75rem;
+  border-top: 1px solid var(--mgs-border);
+}
+
+.mgs-footer .mgs-btn {
+  flex: 0 0 auto;
+  min-width: 10rem;
+}
+
+/* Host and port side by side */
+.mgs-row {
+  display: grid;
+  grid-template-columns: 1fr 7rem;
+  gap: 0.75rem;
+}
+
+.mgs-row .mgs-form-group {
+  margin-bottom: 0.4rem;
+}
+
+.mgs-tight {
+  margin: 0 0 0.9rem;
+}

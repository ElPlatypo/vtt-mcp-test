+
+// ---------- scene backups ----------
+
+function makeScene(id: string, name: string, extra: Record<string, any> = {}) {
+  const docs = (n: number, prefix: string) => ({ contents: Array.from({ length: n }, (_, i) => ({ id: `${prefix}${i}` })), size: n });
+  const scene: any = {
+    id,
+    name,
+    flags: {},
+    tokens: docs(2, 't'),
+    walls: docs(3, 'w'),
+    lights: docs(1, 'l'),
+    sounds: docs(0, 's'),
+    notes: docs(0, 'n'),
+    tiles: docs(0, 'ti'),
+    drawings: docs(0, 'd'),
+    regions: docs(1, 'r'),
+    levels: { contents: [{ id: 'defaultLevel0000' }] },
+    update: vi.fn(async () => undefined),
+    delete: vi.fn(async () => undefined),
+    deleteEmbeddedDocuments: vi.fn(async () => []),
+    createEmbeddedDocuments: vi.fn(async () => []),
+    updateEmbeddedDocuments: vi.fn(async () => []),
+    toObject: () => ({
+      _id: id,
+      name,
+      width: 2000,
+      height: 1000,
+      tokens: [{ _id: 'bt1', name: 'Wolf', level: 'defaultLevel0000' }, { _id: 'bt2', name: 'Lost', level: 'gone' }],
+      walls: [{ _id: 'bw1', c: [0, 0, 1, 1] }],
+      lights: [],
+      regions: [],
+      levels: [{ _id: 'bl', background: { src: 'old.png' } }],
+    }),
+    ...extra,
+  };
+  return scene;
+}
+
+function setupScenes(allow = true) {
+  const cave = makeScene('s1', 'Cave');
+  cave.clone = vi.fn(async (data: any) => {
+    const copy = makeScene('copy-' + cave.clone.mock.calls.length, data.name, { flags: data.flags });
+    scenesList.push(copy);
+    return copy;
+  });
+  const scenesList: any[] = [cave];
+  const created: any[] = [];
+  const folderCreate = vi.fn(async (data: any) => {
+    const f = { id: 'folder1', ...data };
+    created.push(f);
+    return f;
+  });
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('Folder', { create: folderCreate });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'w1', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'GM' },
+    scenes: { contents: scenesList, viewed: cave, current: cave },
+    folders: { contents: created },
+    settings: { get: (_m: string, key: string) => (key === 'allowWriteOperations' ? allow : undefined) },
+  });
+  return { da: new FoundryDataAccess(), cave, scenesList, folderCreate };
+}
+
+describe('manageSceneBackups', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('makes a copy in a Backups folder, flagged, inactive and out of navigation', async () => {

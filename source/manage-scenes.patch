index 0000000..8db7056
--- /dev/null
+++ b/packages/foundry-module/src/data-access.reveal.test.ts
@@ -0,0 +1,117 @@
+/** reveal: hide and show objects on a scene, secret doors, fog reset. Foundry is stubbed. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+import { checkTarget, revealPatch, selectTargets, type SceneThing } from './reveal-utils.js';
+
+describe('reveal utils', () => {
+  const things: SceneThing[] = [
+    { kind: 'token', id: 't1', name: 'Goblin 1', actorName: 'Goblin', x: 5.5, y: 5.5, hidden: true },
+    { kind: 'token', id: 't2', name: 'Goblin 2', actorName: 'Goblin', x: 9.5, y: 5.5, hidden: true },
+    { kind: 'token', id: 't3', name: 'Klarg', actorName: 'Bugbear', x: 5.5, y: 6.5, hidden: false },
+    { kind: 'light', id: 'l1', x: 5, y: 5, hidden: true },
+    { kind: 'door', id: 'w1', x: 7, y: 5.5, hidden: true },
+  ];
+  it('picks by id, name, place or all', () => {
+    expect(selectTargets(things, { kind: 'token', id: 't3' }).map(t => t.id)).toEqual(['t3']);
+    expect(selectTargets(things, { kind: 'token', name: 'goblin 1' }).map(t => t.id)).toEqual(['t1']);
+    expect(selectTargets(things, { kind: 'token', name: 'Goblin' }).map(t => t.id)).toEqual(['t1', 't2']); // actor name
+    expect(selectTargets(things, { kind: 'token', name: 'blin' }).map(t => t.id)).toEqual(['t1', 't2']); // part of a name
+    expect(selectTargets(things, { kind: 'token', x: 5, y: 6, radius: 1 }).map(t => t.id)).toEqual(['t1', 't3']);
+    expect(selectTargets(things, { kind: 'light', all: true }).map(t => t.id)).toEqual(['l1']);
+    expect(selectTargets(things, { kind: 'door', x: 7, y: 5 }).map(t => t.id)).toEqual(['w1']);
+    expect(selectTargets(things, { kind: 'token', name: 'Dragon' })).toEqual([]);
+  });
+  it('checks targets and builds patches', () => {
+    expect(checkTarget({ kind: 'token', name: 'a' })).toBeNull();
+    expect(checkTarget({ kind: 'wall' as any, id: 'x' })).toContain('kind must be');
+    expect(checkTarget({ kind: 'token' })).toContain('needs id');
+    expect(checkTarget({ kind: 'token', x: 3 })).toContain('both x and y');
+    expect(checkTarget({ kind: 'light', name: 'a' })).toContain('only works for tokens');
+    expect(checkTarget({ kind: 'light', x: 1, y: 1, radius: 500 })).toContain('radius');
+    expect(revealPatch('token', 't', true)).toEqual({ _id: 't', hidden: false });
+    expect(revealPatch('light', 'l', false)).toEqual({ _id: 'l', hidden: true });
+    expect(revealPatch('door', 'w', true)).toEqual({ _id: 'w', door: 1 });
+    expect(revealPatch('door', 'w', false)).toEqual({ _id: 'w', door: 2 });
+  });
+});
+
+function setup(allow = true) {
+  const mk = (contents: any[]) => ({ contents, size: contents.length });
+  const scene: any = {
+    id: 's1',
+    name: 'Cave',
+    grid: { size: 100 },
+    tokens: mk([
+      { id: 't1', name: 'Goblin 1', x: 500, y: 500, width: 1, height: 1, hidden: true, actor: { name: 'Goblin' } },
+      { id: 't2', name: 'Klarg', x: 900, y: 500, width: 1, height: 1, hidden: false, actor: { name: 'Bugbear' } },
+    ]),
+    lights: mk([{ id: 'l1', x: 500, y: 500, hidden: true }]),
+    tiles: mk([]),
+    sounds: mk([]),
+    drawings: mk([]),
+    walls: mk([
+      { id: 'w1', door: 2, c: [600, 500, 700, 500] },
+      { id: 'w2', door: 0, c: [0, 0, 100, 0] },
+      { id: 'w3', door: 1, c: [800, 500, 900, 500] },
+    ]),
+    updateEmbeddedDocuments: vi.fn(async () => undefined),
+  };
+  const reset = vi.fn(async () => undefined);
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('canvas', { scene, fog: { reset } });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'GM' },
+    scenes: Object.assign([scene], { contents: [scene], viewed: scene }),
+    settings: { get: (_m: string, key: string) => (key === 'allowWriteOperations' ? allow : undefined) },
+  });
+  return { da: new FoundryDataAccess(), scene, reset };
+}
+
+describe('revealObjects', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('reveals a token by name and hides another, in one update per kind', async () => {
+    const { da, scene } = setup();
+    const r = await da.revealObjects({ reveal: [{ kind: 'token', name: 'Goblin' }], hide: [{ kind: 'token', id: 't2' }] });
+    expect(scene.updateEmbeddedDocuments).toHaveBeenCalledTimes(1);
+    expect(scene.updateEmbeddedDocuments).toHaveBeenCalledWith('Token', [{ _id: 't1', hidden: false }, { _id: 't2', hidden: true }]);
+    expect(r).toMatchObject({ success: true, scene: { name: 'Cave' } });
+    expect(r.changed).toEqual([
+      { kind: 'token', id: 't1', name: 'Goblin 1', now: 'revealed' },
+      { kind: 'token', id: 't2', name: 'Klarg', now: 'hidden' },
+    ]);
+  });
+  it('reveals a secret door near a point and hides a normal one; plain walls are not doors', async () => {
+    const { da, scene } = setup();
+    await da.revealObjects({ reveal: [{ kind: 'door', x: 6.5, y: 5 }], hide: [{ kind: 'door', x: 8.5, y: 5 }] });
+    expect(scene.updateEmbeddedDocuments).toHaveBeenCalledWith('Wall', [{ _id: 'w1', door: 1 }, { _id: 'w3', door: 2 }]);
+    const r = await da.revealObjects({ reveal: [{ kind: 'door', all: true }] });
+    expect(r.changed.map((c: any) => c.id)).toEqual(['w1', 'w3']);
+  });
+  it('lights and several kinds at once; reports what it did not find', async () => {
+    const { da, scene } = setup();
+    const r = await da.revealObjects({ reveal: [{ kind: 'light', all: true }, { kind: 'token', name: 'Dragon' }] });
+    expect(scene.updateEmbeddedDocuments).toHaveBeenCalledWith('AmbientLight', [{ _id: 'l1', hidden: false }]);
+    expect(r.notFound).toEqual([JSON.stringify({ kind: 'token', name: 'Dragon' })]);
+  });
+  it('resets the fog on the viewed scene only', async () => {
+    const { da, reset } = setup();
+    const r = await da.revealObjects({ reset_fog: true });
+    expect(reset).toHaveBeenCalled();
+    expect(r.fogReset).toBe(true);
+    const other = setup();
+    (canvas as any).scene = { id: 'elsewhere' };
+    await expect(other.da.revealObjects({ reset_fog: true })).rejects.toThrow('being viewed');
+  });
+  it('refuses bad requests and respects the write gate', async () => {
+    const { da, scene } = setup();
+    await expect(da.revealObjects({})).rejects.toThrow('Give reveal');
+    await expect(da.revealObjects({ reveal: [{ kind: 'token' }] })).rejects.toThrow('needs id');
+    await expect(da.revealObjects({ scene: 'Nowhere', reveal: [{ kind: 'token', all: true }] })).rejects.toThrow('Scene not found');
+    expect(scene.updateEmbeddedDocuments).not.toHaveBeenCalled();
+    await expect(setup(false).da.revealObjects({ reveal: [{ kind: 'token', all: true }] })).rejects.toThrow();
+  });
+});

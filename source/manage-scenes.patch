diff --git a/packages/foundry-module/src/creature-flags-utils.ts b/packages/foundry-module/src/creature-flags-utils.ts
new file mode 100644
index 0000000..3100b24
--- /dev/null
+++ b/packages/foundry-module/src/creature-flags-utils.ts
@@ -0,0 +1,35 @@
+/**
+ * Whether a dnd5e creature casts spells or has legendary actions. dnd5e gives every NPC empty
+ * spell slot and legendary resource objects (and a default spellcasting ability), so their mere
+ * presence means nothing: what counts is a spellcaster level, a slot, a spell item, or a
+ * legendary action or resistance maximum above zero. Pure: no Foundry globals.
+ */
+
+const positive = (v: unknown): boolean => {
+  const n = typeof v === 'string' && v.trim() !== '' ? Number(v) : v;
+  return typeof n === 'number' && Number.isFinite(n) && n > 0;
+};
+
+const itemsOf = (doc: any): any[] => {
+  const items = doc?.items;
+  if (!items) return [];
+  if (Array.isArray(items)) return items;
+  if (Array.isArray(items.contents)) return items.contents;
+  if (typeof items.values === 'function') return [...items.values()];
+  return [];
+};
+
+export function dnd5eHasSpells(doc: any): boolean {
+  const system = doc?.system ?? {};
+  if (positive(system.details?.spellLevel)) return true;
+  const spells = system.spells ?? {};
+  for (const [key, slot] of Object.entries(spells)) {
+    if ((/^spell\d$/.test(key) || key === 'pact') && positive((slot as any)?.max ?? (slot as any)?.override)) return true;
+  }
+  return itemsOf(doc).some(i => i?.type === 'spell');
+}
+
+export function dnd5eHasLegendary(doc: any): boolean {
+  const r = doc?.system?.resources ?? {};
+  return positive(r.legact?.max) || positive(r.legres?.max);
+}

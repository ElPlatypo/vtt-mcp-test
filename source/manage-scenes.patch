+import { describe, expect, it, vi } from 'vitest';
+import { PartyTools } from './party-tools.js';
+
+function make(response: any = { success: true }) {
+  const query = vi.fn(async () => response);
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  return { tools: new PartyTools({ foundryClient: { query } as any, logger }), query };
+}
+
+describe('party tool', () => {
+  it('is exposed with action required', () => {
+    const def = make().tools.getToolDefinitions()[0]!;
+    expect(def.name).toBe('party');
+    expect(def.inputSchema.required).toEqual(['action']);
+  });
+  it('sends the request to Foundry', async () => {
+    const { tools, query } = make({ success: true, party: [] });
+    await tools.handleParty({ action: 'rest', type: 'long' });
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.party', { action: 'rest', type: 'long' });
+  });
+  it('rejects bad input and refused requests', async () => {
+    const { tools } = make();
+    await expect(tools.handleParty({ action: 'dance' })).rejects.toThrow();
+    await expect(tools.handleParty({ action: 'xp', amount: -5 })).rejects.toThrow();
+    await expect(tools.handleParty({ action: 'rest', type: 'medium' })).rejects.toThrow();
+    const refused = make({ success: false, error: 'Access denied' });
+    await expect(refused.tools.handleParty({ action: 'status' })).rejects.toThrow('Access denied');
+  });
+});

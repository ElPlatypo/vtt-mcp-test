+/**
+ * Client of the streaming narration server (tts-server/claude_tts), reached through ComfyUI's own address
+ * under /claude-tts. The server streams raw 16-bit mono PCM while it generates.
+ */
+
+export interface StreamedPcm {
+  sampleRate: number;
+  chunks: AsyncGenerator<Buffer, void, void>;
+}
+
+export interface FastSpeechRequest {
+  text: string;
+  mode: 'custom' | 'design';
+  speaker?: string;
+  instruct?: string;
+  language: string;
+  model?: string;
+  chunk_size?: number;
+  seed?: number;
+  temperature?: number;
+}
+
+export function serverUrl(comfyBaseUrl: string): string {
+  return `${comfyBaseUrl.replace(/\/+$/, '')}/claude-tts`;
+}
+
+async function failure(response: Response): Promise<Error> {
+  let detail = '';
+  try {
+    const body: any = await response.json();
+    detail = body?.error || body?.detail || '';
+  } catch {
+    // not JSON
+  }
+  if (response.status === 404) {
+    return new Error('This ComfyUI has no narration server. Install the claude_tts custom node from the bridge (tts-server/claude_tts) and restart ComfyUI.');
+  }
+  if (response.status === 503) {
+    return new Error(detail || 'The narration server is not running. Check the ComfyUI log for [claude_tts].');
+  }
+  return new Error(`Narration server error ${response.status}${detail ? `: ${detail}` : ''}`);
+}
+
+export async function getServerJson(baseUrl: string, path: string, timeoutMs = 8000): Promise<any> {
+  const response = await fetch(`${serverUrl(baseUrl)}${path}`, { signal: AbortSignal.timeout(timeoutMs) });
+  if (!response.ok) throw await failure(response);
+  return response.json();
+}
+
+/**
+ * Start a streamed speech. Resolves when the first audio is about to arrive (the server loads the model
+ * first, which takes about half a minute the first time), then yields the PCM as it is generated.
+ */
+export async function streamSpeech(baseUrl: string, request: FastSpeechRequest, options: { timeoutMs?: number } = {}): Promise<StreamedPcm> {
+    const response = await fetch(`${serverUrl(baseUrl)}/speak`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(request),
+    signal: AbortSignal.timeout(options.timeoutMs ?? 240000),
+  });
+  if (!response.ok || !response.body) throw await failure(response);
+  const sampleRate = Number(response.headers.get('x-sample-rate')) || 24000;
+  const reader = response.body.getReader();
+
+  async function* read(): AsyncGenerator<Buffer, void, void> {
+    let carry = Buffer.alloc(0); // keep whole 16-bit samples
+    try {
+      for (;;) {
+        const { done, value } = await reader.read();
+        if (done) break;
+        const joined = carry.length ? Buffer.concat([carry, Buffer.from(value)]) : Buffer.from(value);
+        const usable = joined.length - (joined.length % 2);
+        carry = joined.subarray(usable);
+        if (usable > 0) yield joined.subarray(0, usable);
+      }
+    } finally {
+      reader.cancel().catch(() => undefined);
+    }
+  }
+  return { sampleRate, chunks: read() };
+}
+
+/** A mono 16-bit PCM buffer as a WAV file. */
+export function pcmToWav(pcm: Buffer, sampleRate: number): Buffer {
+  const header = Buffer.alloc(44);
+  header.write('RIFF', 0, 'ascii');
+  header.writeUInt32LE(36 + pcm.length, 4);
+  header.write('WAVE', 8, 'ascii');
+  header.write('fmt ', 12, 'ascii');
+  header.writeUInt32LE(16, 16);
+  header.writeUInt16LE(1, 20); // PCM
+  header.writeUInt16LE(1, 22); // mono
+  header.writeUInt32LE(sampleRate, 24);
+  header.writeUInt32LE(sampleRate * 2, 28);
+  header.writeUInt16LE(2, 32);
+  header.writeUInt16LE(16, 34);
+  header.write('data', 36, 'ascii');
+  header.writeUInt32LE(pcm.length, 40);
+  return Buffer.concat([header, pcm]);
+}
+
+export function pcmSeconds(pcm: Buffer, sampleRate: number): number {
+  return pcm.length / 2 / sampleRate;
+}
+
+/**
+ * The words of `text` from fraction `from` to `to` (0 to 1), so a sentence streamed in several audio pieces
+ * can show the right part of its text with each piece.
+ */
+export function sliceWords(text: string, from: number, to: number): string {
+  const words = text.trim().split(/\s+/).filter(Boolean);
+  const a = Math.round(Math.min(1, Math.max(0, from)) * words.length);
+  const b = to >= 1 ? words.length : Math.round(Math.min(1, Math.max(0, to)) * words.length);
+  return words.slice(a, Math.max(a, b)).join(' ');
+}

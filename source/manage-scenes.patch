index 0000000..b24b04b
--- /dev/null
+++ b/packages/mcp-server/src/comfyui-errors.test.ts
@@ -0,0 +1,87 @@
+import { describe, expect, it } from 'vitest';
+import { describeComfySubmitError, describeExecutionError } from './comfyui-errors.js';
+
+describe('describeExecutionError', () => {
+  it('names the node and the exception', () => {
+    const entry = {
+      status: {
+        status_str: 'error',
+        messages: [
+          ['execution_start', {}],
+          [
+            'execution_error',
+            { node_type: 'KSampler', exception_message: 'CUDA out of memory\n' },
+          ],
+        ],
+      },
+    };
+    expect(describeExecutionError(entry)).toBe('KSampler: CUDA out of memory');
+  });
+
+  it('has a fallback', () => {
+    expect(describeExecutionError({})).toContain('unknown error');
+  });
+});
+
+// What ComfyUI sends when a checkpoint name is not in its checkpoints folder.
+const missingCheckpoint = {
+  error: {
+    type: 'prompt_outputs_failed_validation',
+    message: 'Prompt outputs failed validation',
+    details: '',
+  },
+  node_errors: {
+    '1': {
+      class_type: 'CheckpointLoaderSimple',
+      errors: [
+        {
+          type: 'value_not_in_list',
+          message: 'Value not in list',
+          details: "ckpt_name: 'dDBattlemapsSDXL10_upscaleV10.safetensors' not in []",
+        },
+      ],
+    },
+  },
+};
+
+describe('describeComfySubmitError', () => {
+  it('names the node and the missing model, and says where it must be', () => {
+    const message = describeComfySubmitError(400, missingCheckpoint, 'Request failed');
+    expect(message).toContain('ComfyUI rejected the job (HTTP 400)');
+    expect(message).toContain('CheckpointLoaderSimple (node 1)');
+    expect(message).toContain("ckpt_name: 'dDBattlemapsSDXL10_upscaleV10.safetensors' not in []");
+    expect(message).toContain('models/checkpoints');
+    expect(message).not.toContain('Request failed');
+  });
+
+  it('does not add the model hint for other problems', () => {
+    const message = describeComfySubmitError(
+      400,
+      {
+        error: { message: 'Prompt has no outputs', details: 'nothing to run' },
+      },
+      'x'
+    );
+    expect(message).toBe(
+      'ComfyUI rejected the job (HTTP 400): Prompt has no outputs (nothing to run)'
+    );
+  });
+
+  it('accepts a plain string error', () => {
+    expect(describeComfySubmitError(500, { error: 'boom' }, 'x')).toContain('boom');
+  });
+
+  it('falls back to the original message when the body has nothing useful', () => {
+    expect(describeComfySubmitError(undefined, undefined, 'connect ECONNREFUSED')).toBe(
+      'connect ECONNREFUSED'
+    );
+    expect(describeComfySubmitError(400, '<html>', 'Request failed')).toBe('Request failed');
+    expect(describeComfySubmitError(400, {}, 'Request failed')).toBe('Request failed');
+  });
+
+  it('keeps long messages short', () => {
+    const errors = Array.from({ length: 10 }, () => ({ message: 'm'.repeat(300) }));
+    const message = describeComfySubmitError(400, { node_errors: { '1': { errors } } }, 'x');
+    expect(message.length).toBeLessThanOrEqual(700);
+  });
+});

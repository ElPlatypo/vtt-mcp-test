@@ -0,0 +1,60 @@
+import { describe, expect, it, vi } from 'vitest';
+import { FileBackupTools } from './file-backup-tools.js';
+
+function makeTools(impl?: (method: string, data: any) => unknown) {
+  const query = vi.fn(impl ?? (async () => ({ success: true })));
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  return { tools: new FileBackupTools({ foundryClient: { query } as any, logger }), query };
+}
+
+describe('definitions', () => {
+  it('offers browse-files and manage-scene-backups', () => {
+    const defs = makeTools().tools.getToolDefinitions();
+    expect(defs.map(d => d.name)).toEqual(['browse-files', 'manage-scene-backups']);
+    expect(defs[1]!.inputSchema.required).toEqual(['action']);
+  });
+});
+
+describe('browse-files', () => {
+  it('sends a valid request and returns the result', async () => {
+    const { tools, query } = makeTools(async () => ({ success: true, files: [] }));
+    const r = await tools.handleBrowseFiles({ path: 'worlds', kind: 'audio', depth: 2 });
+    expect(r.success).toBe(true);
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.browse-files', { path: 'worlds', kind: 'audio', depth: 2 });
+    await tools.handleBrowseFiles(undefined);
+    expect(query).toHaveBeenLastCalledWith('foundry-mcp-bridge.browse-files', {});
+  });
+  it('refuses bad input and reports failures', async () => {
+    const { tools, query } = makeTools(async () => {
+      throw new Error('timeout');
+    });
+    await expect(tools.handleBrowseFiles({ depth: 4 })).rejects.toThrow();
+    await expect(tools.handleBrowseFiles({ kind: 'text' })).rejects.toThrow();
+    await expect(tools.handleBrowseFiles({ bogus: 1 })).rejects.toThrow();
+    expect(query).not.toHaveBeenCalled();
+    await expect(tools.handleBrowseFiles({})).rejects.toThrow('Failed to browse files: timeout');
+  });
+});
+
+describe('manage-scene-backups', () => {
+  it('sends each action', async () => {
+    const { tools, query } = makeTools();
+    await tools.handleManageSceneBackups({ action: 'backup', scene: 'Cave', label: 'before rebuild' });
+    await tools.handleManageSceneBackups({ action: 'list' });
+    await tools.handleManageSceneBackups({ action: 'restore', backup: 'b1', confirm: true });
+    expect(query).toHaveBeenNthCalledWith(1, 'foundry-mcp-bridge.manage-scene-backups', { action: 'backup', scene: 'Cave', label: 'before rebuild' });
+    expect(query).toHaveBeenNthCalledWith(3, 'foundry-mcp-bridge.manage-scene-backups', { action: 'restore', backup: 'b1', confirm: true });
+  });
+  it('checks what restore and delete need', async () => {
+    const { tools, query } = makeTools();
+    await expect(tools.handleManageSceneBackups({ action: 'restore' })).rejects.toThrow('needs backup');
+    await expect(tools.handleManageSceneBackups({ action: 'delete' })).rejects.toThrow('needs backup');
+    await expect(tools.handleManageSceneBackups({ action: 'explode' })).rejects.toThrow();
+    await expect(tools.handleManageSceneBackups({ action: 'backup', label: 'x'.repeat(41) })).rejects.toThrow();
+    expect(query).not.toHaveBeenCalled();
+  });
+  it('turns a refusal into an error', async () => {
+    const { tools } = makeTools(async () => ({ success: false, error: 'no backup matches' }));
+    await expect(tools.handleManageSceneBackups({ action: 'list' })).rejects.toThrow('Failed to manage scene backups: no backup matches');
+  });
+});

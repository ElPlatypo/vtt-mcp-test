+    calls.push([name, data]);
+    if (overrides[name]) return overrides[name](data);
+    switch (name) {
+      case 'manage-scenes':
+        return { success: true, scene: { id: 's1', name: 'Cave' } };
+      case 'list-scenes':
+        return [{ id: 's1', name: 'Cave', music: { playlist: { id: 'p1', name: 'Existing mix' }, playlistSound: null } }];
+      case 'manage-playlists':
+        if (data.action === 'describe' && !data.playlist) return { success: true, playlists: state.playlists };
+        if (data.action === 'describe') return { success: true, playlist: { id: data.playlist, name: 'Existing mix', sounds: state.playlistSounds } };
+        if (data.action === 'create') return { success: true, playlist: { id: 'new1', name: data.name } };
+        return { success: true };
+      case 'manage-scene-objects':
+        if (data.action === 'remove') return { success: true, removed: [{ id: 'x' }, { id: 'y' }] };
+        if (data.action === 'place') return { success: true, created: data.objects.map((_: any, i: number) => ({ id: `n${i}` })) };
+        return { success: true, scene: { id: 's1', name: 'Cave' }, sounds: [{ id: 'z' }] };
+      default:
+        return { success: true };
+    }
+  });
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  return { tools: new SceneSoundTools({ foundryClient: { query } as any, logger }), calls, state };
+}
+
+const names = (calls: Call[]) => calls.map(c => `${c[0]}${c[1].action ? ':' + c[1].action : ''}${c[1].command ? ':' + c[1].command : ''}`);
+
+describe('soundNameFromPath', () => {
+  it('turns a file path into a track name', () => {
+    expect(soundNameFromPath('worlds/w/uploads/audio/Cave-drip_01.mp3')).toBe('Cave drip 01');
+    expect(soundNameFromPath('x.ogg')).toBe('x');
+    expect(soundNameFromPath('.mp3')).toBe('Sound');
+  });
+});
+
+describe('definition', () => {
+  it('is exposed with scene required', () => {
+    const def = makeTools().tools.getToolDefinitions()[0]!;
+    expect(def.name).toBe('setup-scene-sound');
+    expect(def.inputSchema.required).toEqual(['scene']);
+  });
+});
+
+describe('music', () => {
+  it('creates a playlist from files, binds it to the scene and starts it', async () => {
+    const { tools, calls } = makeTools();
+    const r = await tools.handleSetupSceneSound({
+      scene: 'Cave',
+      music: { files: ['worlds/w/uploads/audio/cave-theme.mp3'], volume: 0.5, play: true },
+    });
+    expect(names(calls)).toEqual([
+      'manage-playlists:describe',
+      'manage-scenes:describe',
+      'manage-playlists:create',
+      'update-scene-music',
+      'control-playlist:play-sound',
+    ]);
+    const create = calls.find(c => c[0] === 'manage-playlists' && c[1].action === 'create')![1];
+    expect(create).toMatchObject({ name: 'Cave music', sounds: [{ path: 'worlds/w/uploads/audio/cave-theme.mp3', name: 'cave theme', repeat: true, volume: 0.5 }] });
+    expect(calls.find(c => c[0] === 'update-scene-music')![1]).toEqual({ scene_identifier: 'Cave', playlist: 'new1', playlist_sound: 'cave theme' });
+    expect(r.steps.join(' ')).toContain('created with 1 track');
+  });
+
+  it('adds only the missing files to an existing playlist', async () => {
+    const { tools, calls } = makeTools();
+    const r = await tools.handleSetupSceneSound({ scene: 'Cave', music: { playlist: 'Existing mix', files: ['a/old.mp3', 'a/new.mp3', 'a/newer.ogg'] } });
+    const update = calls.find(c => c[0] === 'manage-playlists' && c[1].action === 'update')![1];
+    expect(update.add_sounds.map((s: any) => s.path)).toEqual(['a/new.mp3', 'a/newer.ogg']);
+    expect(update.add_sounds[0].repeat).toBe(false);
+    expect(r.steps.join(' ')).toContain('2 track(s) added, 1 already there');
+    expect(calls.find(c => c[0] === 'update-scene-music')![1]).toEqual({ scene_identifier: 'Cave', playlist: 'p1' });
+  });
+
+  it('uses an existing playlist as it is, and says when it is missing', async () => {
+    const { tools, calls } = makeTools();
+    await tools.handleSetupSceneSound({ scene: 'Cave', music: { playlist: 'existing mix', sound: 'Drums', play: true } });
+    expect(calls.find(c => c[0] === 'update-scene-music')![1]).toEqual({ scene_identifier: 'Cave', playlist: 'p1', playlist_sound: 'Drums' });
+    expect(names(calls)).toContain('control-playlist:play-sound');
+    await expect(tools.handleSetupSceneSound({ scene: 'Cave', music: { playlist: 'Nope' } })).rejects.toThrow('not found');
+  });
+
+  it('clears the music', async () => {
+    const { tools, calls } = makeTools();
+    await tools.handleSetupSceneSound({ scene: 'Cave', music: { clear: true } });
+    expect(calls[0]).toEqual(['update-scene-music', { scene_identifier: 'Cave', playlist: null, playlist_sound: null }]);
+  });
+});
+
+describe('ambient sounds', () => {
+  it('replaces the earlier ones and places the new ones', async () => {
+    const { tools, calls } = makeTools();
+    const r = await tools.handleSetupSceneSound({
+      scene: 'Cave',
+      ambient: [{ path: 'a/drip.mp3', x: 10, y: 8, radius: 6, volume: 0.4 }, { path: 'a/wind.ogg', x: 20, y: 5, radius: 10, walls: false }],
+    });
+    expect(calls[0]).toEqual(['manage-scene-objects', { action: 'remove', scene: 'Cave', kind: 'sound', all_mine: true }]);
+    expect(calls[1]![1].objects).toEqual([
+      { kind: 'sound', path: 'a/drip.mp3', x: 10, y: 8, radius: 6, volume: 0.4 },
+      { kind: 'sound', path: 'a/wind.ogg', x: 20, y: 5, radius: 10, walls: false },
+    ]);
+    expect(r.steps).toEqual(['2 earlier ambient sound(s) removed', '2 ambient sound(s) placed']);
+  });
+  it('keeps the earlier ones when asked, and can clear them', async () => {
+    const { tools, calls } = makeTools();
+    await tools.handleSetupSceneSound({ scene: 'Cave', replace_ambient: false, ambient: [{ path: 'a/x.mp3', x: 1, y: 1, radius: 2 }] });
+    expect(names(calls)).toEqual(['manage-scene-objects:place']);
+    const second = makeTools();
+    await second.tools.handleSetupSceneSound({ scene: 'Cave', clear_ambient: true });
+    expect(names(second.calls)).toEqual(['manage-scene-objects:remove']);
+  });
+});
+
+describe('describe and checks', () => {
+  it('describes music and ambient sounds', async () => {
+    const { tools } = makeTools();
+    const r = await tools.handleSetupSceneSound({ scene: 'Cave', action: 'describe' });
+    expect(r).toMatchObject({
+      success: true,
+      scene: { id: 's1', name: 'Cave' },
+      music: { playlist: { name: 'Existing mix' } },
+      ambient: [{ id: 'z' }],
+    });
+  });
+  it('refuses bad combinations', async () => {
+    const { tools, calls } = makeTools();
+    await expect(tools.handleSetupSceneSound({ scene: 'Cave' })).rejects.toThrow('Give music');
+    await expect(tools.handleSetupSceneSound({ scene: 'Cave', music: {} })).rejects.toThrow('music needs');
+    await expect(tools.handleSetupSceneSound({ scene: 'Cave', music: { clear: true, files: ['a.mp3'] } })).rejects.toThrow('cannot be combined');
+    await expect(tools.handleSetupSceneSound({ scene: 'Cave', clear_ambient: true, ambient: [{ path: 'a.mp3', x: 1, y: 1, radius: 1 }] })).rejects.toThrow('not both');
+    await expect(tools.handleSetupSceneSound({ scene: 'Cave', ambient: [{ path: 'http://x/a.mp3', x: 1, y: 1, radius: 1 }] })).rejects.toThrow('Foundry files');
+    await expect(tools.handleSetupSceneSound({ scene: 'Cave', ambient: [{ path: 'a.mp3', x: 1, y: 1 }] })).rejects.toThrow();
+    expect(calls).toHaveLength(0);
+  });
+  it('says what was done when a step fails', async () => {
+    const { tools } = makeTools({
+      'manage-scene-objects': (d: any) => (d.action === 'place' ? { success: false, error: 'outside the scene' } : { success: true, removed: [] }),
+    });
+    await expect(
+      tools.handleSetupSceneSound({ scene: 'Cave', ambient: [{ path: 'a.mp3', x: 1, y: 1, radius: 1 }] })
+    ).rejects.toThrow('outside the scene (done so far: 0 earlier ambient sound(s) removed)');
+  });
+});
diff --git a/packages/mcp-server/src/tools/scene-sound-tools.ts b/packages/mcp-server/src/tools/scene-sound-tools.ts
new file mode 100644
index 0000000..4ffc9e0
--- /dev/null
+++ b/packages/mcp-server/src/tools/scene-sound-tools.ts
@@ -0,0 +1,241 @@
+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+
+export interface SceneSoundToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+const audioPath = z.string().min(1).max(400).refine(p => !/^[a-z]+:\/\//i.test(p), {
+  message: 'give a path in the Foundry files (for example worlds/my-world/uploads/audio/cave.mp3), not a web address',
+});
+
+const ambientSchema = z
+  .object({
+    path: audioPath,
+    x: z.number().min(0),
+    y: z.number().min(0),
+    radius: z.number().positive().max(400),
+    volume: z.number().min(0).max(1).optional(),
+    repeat: z.boolean().optional(),
+    walls: z.boolean().optional(),
+    easing: z.boolean().optional(),
+    hidden: z.boolean().optional(),
+  })
+  .strict();
+
+const musicSchema = z
+  .object({
+    playlist: z.string().min(1).max(200).optional(),
+    files: z.array(audioPath).min(1).max(50).optional(),
+    sound: z.string().min(1).max(200).optional(),
+    volume: z.number().min(0).max(1).optional(),
+    repeat: z.boolean().optional(),
+    clear: z.boolean().optional(),
+    play: z.boolean().optional(),
+  })
+  .strict();
+
+const schema = z
+  .object({
+    scene: z.string().min(1),
+    action: z.enum(['apply', 'describe']).optional(),
+    music: musicSchema.optional(),
+    ambient: z.array(ambientSchema).min(1).max(50).optional(),
+    replace_ambient: z.boolean().optional(),
+    clear_ambient: z.boolean().optional(),
+  })
+  .strict();
+
+/** A sound name from a file path: "worlds/w/uploads/audio/Cave-drip_01.mp3" -> "Cave drip 01". */
+export function soundNameFromPath(path: string): string {
+  const file = path.split('/').pop() ?? path;
+  const base = file.replace(/\.[^.]+$/, '');
+  const name = base.replace(/[-_]+/g, ' ').replace(/\s+/g, ' ').trim();
+  return name || 'Sound';
+}
+
+export class SceneSoundTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: SceneSoundToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'SceneSoundTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'setup-scene-sound',
+        description:
+          'Give a scene its sound in one call: the music that plays when the scene is shown and the ambient sounds placed on the map. ' +
+          'music: {playlist?, files?, sound?, volume?, repeat?, clear?, play?}. Give files (paths in the Foundry files, e.g. from upload-file or browse-files) to put them in a playlist named playlist (default "<scene name> music"; made if missing, new files added if it exists), or give just playlist to use an existing one; sound picks one track to start with; repeat defaults to true for a single file; clear:true takes the music off the scene; play:true also starts it now. ' +
+          'ambient: [{path, x, y, radius, volume?, repeat?, walls?, easing?, hidden?}] places looping sounds at a point in GRID SQUARES (radius in squares, heard within it; walls block them by default); replace_ambient (default true when ambient is given) first removes the ambient sounds this tool placed before; clear_ambient:true removes them without adding any. ' +
+          'action describe shows the scene\'s music and ambient sounds. Needs the Foundry tab open in a browser.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            scene: { type: 'string', description: 'Scene id or exact name' },
+            action: { type: 'string', enum: ['apply', 'describe'], description: 'apply (default) or describe' },
+            music: {
+              type: 'object',
+              properties: {
+                playlist: { type: 'string', description: 'Playlist id or name (existing, or the name to create with files)' },
+                files: { type: 'array', items: { type: 'string' }, description: 'Audio files to put in the playlist' },
+                sound: { type: 'string', description: 'Track (name or id) that the scene starts with' },
+                volume: { type: 'number', description: 'Volume 0-1 for the tracks added' },
+                repeat: { type: 'boolean', description: 'Loop the tracks added (default true for one file)' },
+                clear: { type: 'boolean', description: 'Remove the music from the scene' },
+                play: { type: 'boolean', description: 'Start the music now' },
+              },
+              additionalProperties: false,
+            },
+            ambient: {
+              type: 'array',
+              items: {
+                type: 'object',
+                properties: {
+                  path: { type: 'string' },
+                  x: { type: 'number' },
+                  y: { type: 'number' },
+                  radius: { type: 'number' },
+                  volume: { type: 'number' },
+                  repeat: { type: 'boolean' },
+                  walls: { type: 'boolean' },
+                  easing: { type: 'boolean' },
+                  hidden: { type: 'boolean' },
+                },
+                required: ['path', 'x', 'y', 'radius'],
+                additionalProperties: false,
+              },
+            },
+            replace_ambient: { type: 'boolean', description: 'Remove the ambient sounds this tool placed before adding (default true)' },
+            clear_ambient: { type: 'boolean', description: 'Remove the ambient sounds this tool placed' },
+          },
+          required: ['scene'],
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  private async q(method: string, data: any): Promise<any> {
+    const result = await this.foundryClient.query(`foundry-mcp-bridge.${method}`, data);
+    if (result?.success === false) throw new Error(result.error || `${method} was refused`);
+    return result;
+  }
+
+  private async sceneName(scene: string): Promise<string> {
+    const info = await this.q('manage-scenes', { action: 'describe', scene_identifier: scene });
+    return String(info?.scene?.name ?? info?.name ?? scene);
+  }
+
+  private async describeScene(scene: string): Promise<any> {
+    // list-scenes is where a scene's music binding (playlist and track, by name) is reported.
+    const listed = await this.q('list-scenes', {});
+    const all: any[] = Array.isArray(listed) ? listed : listed?.scenes ?? [];
+    const found = all.find(s => s?.id === scene) ?? all.find(s => String(s?.name).toLowerCase() === scene.toLowerCase());
+    const sounds = await this.q('manage-scene-objects', { action: 'describe', scene, kind: 'sound' });
+    return {
+      scene: { id: found?.id ?? sounds?.scene?.id, name: found?.name ?? sounds?.scene?.name },
+      music: found?.music ?? { playlist: null, playlistSound: null },
+      ambient: sounds?.sounds ?? [],
+    };
+  }
+
+  async handleSetupSceneSound(args: any): Promise<any> {
+    const a = schema.parse(args ?? {});
+    const action = a.action ?? 'apply';
+    if (action === 'describe') {
+      try {
+        return { success: true, ...(await this.describeScene(a.scene)) };
+      } catch (error) {
+        throw new Error(`Failed to describe scene sound: ${error instanceof Error ? error.message : 'Unknown error'}`);
+      }
+    }
+    if (!a.music && !a.ambient && !a.clear_ambient) {
+      throw new Error('Give music, ambient or clear_ambient (or action describe)');
+    }
+    if (a.music?.clear && (a.music.files || a.music.playlist)) throw new Error('music.clear cannot be combined with files or playlist');
+    if (a.music && !a.music.clear && !a.music.files && !a.music.playlist) {
+      throw new Error('music needs files, a playlist, or clear:true');
+    }
+    if (a.clear_ambient && a.ambient) throw new Error('Give ambient or clear_ambient, not both (ambient replaces by default)');
+
+    const steps: string[] = [];
+    try {
+      const music = a.music;
+      if (music?.clear) {
+        await this.q('update-scene-music', { scene_identifier: a.scene, playlist: null, playlist_sound: null });
+        steps.push('music removed from the scene');
+      } else if (music) {
+        const all = await this.q('manage-playlists', { action: 'describe', playlist: null });
+        const wanted = music.playlist ?? `${await this.sceneName(a.scene)} music`;
+        const existing = ((all?.playlists ?? []) as any[]).find(p => p.id === wanted || String(p.name).toLowerCase() === wanted.toLowerCase());
+
+        let playlistId: string;
+        let playlistName: string;
+        let soundToStart: string | undefined = music.sound;
+        if (music.files) {
+          const repeat = music.repeat ?? music.files.length === 1;
+          const entry = (path: string) => ({
+            path,
+            name: soundNameFromPath(path),
+            repeat,
+            ...(music.volume !== undefined ? { volume: music.volume } : {}),
+          });
+          if (existing) {
+            const detail = await this.q('manage-playlists', { action: 'describe', playlist: existing.id });
+            const have = new Set(((detail?.playlist?.sounds ?? []) as any[]).map(s => s.path));
+            const fresh = music.files.filter(p => !have.has(p));
+            if (fresh.length > 0) {
+              await this.q('manage-playlists', { action: 'update', playlist: existing.id, add_sounds: fresh.map(entry) });
+            }
+            steps.push(`playlist "${existing.name}": ${fresh.length} track(s) added, ${music.files.length - fresh.length} already there`);
+            playlistId = existing.id;
+            playlistName = existing.name;
+          } else {
+            const created = await this.q('manage-playlists', { action: 'create', name: wanted, sounds: music.files.map(entry) });
+            playlistId = created?.playlist?.id ?? wanted;
+            playlistName = created?.playlist?.name ?? wanted;
+            steps.push(`playlist "${playlistName}" created with ${music.files.length} track(s)`);
+          }
+          if (!soundToStart && music.files.length === 1) soundToStart = soundNameFromPath(music.files[0]!);
+        } else {
+          if (!existing) throw new Error(`Playlist "${wanted}" not found; give files to create it`);
+          playlistId = existing.id;
+          playlistName = existing.name;
+        }
+        await this.q('update-scene-music', {
+          scene_identifier: a.scene,
+          playlist: playlistId,
+          ...(soundToStart ? { playlist_sound: soundToStart } : {}),
+        });
+        steps.push(`scene music set to "${playlistName}"${soundToStart ? ` (track "${soundToStart}")` : ''}`);
+        if (music.play) {
+          await this.q('control-playlist', soundToStart ? { playlist: playlistId, command: 'play-sound', sound: soundToStart } : { playlist: playlistId, command: 'play' });
+          steps.push('music started');
+        }
+      }
+
+      if (a.clear_ambient || (a.ambient && a.replace_ambient !== false)) {
+        const removed = await this.q('manage-scene-objects', { action: 'remove', scene: a.scene, kind: 'sound', all_mine: true });
+        steps.push(`${(removed?.removed ?? []).length} earlier ambient sound(s) removed`);
+      }
+      if (a.ambient) {
+        const placed = await this.q('manage-scene-objects', {
+          action: 'place',
+          scene: a.scene,
+          objects: a.ambient.map(s => ({ kind: 'sound', ...s })),
+        });
+        steps.push(`${(placed?.created ?? []).length} ambient sound(s) placed`);
+      }
+    } catch (error) {
+      this.logger.error('Failed to set up scene sound', error);
+      throw new Error(`Failed to set up scene sound: ${error instanceof Error ? error.message : 'Unknown error'}${steps.length ? ` (done so far: ${steps.join('; ')})` : ''}`);
+    }
+    return { success: true, scene: a.scene, steps };
+  }
+}

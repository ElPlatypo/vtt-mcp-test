diff --git a/packages/foundry-module/src/data-access.manage-journals.test.ts b/packages/foundry-module/src/data-access.manage-journals.test.ts
new file mode 100644
index 0000000..bad3cea
--- /dev/null
+++ b/packages/foundry-module/src/data-access.manage-journals.test.ts
@@ -0,0 +1,363 @@
+/**
+ * manage-journals tests (create / update / describe). Foundry is stubbed: these check the
+ * payloads sent to JournalEntry.create / page updates, link resolution, HTML cleaning,
+ * validation and the write gate. They cannot prove a real Foundry accepts the payload.
+ */
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+
+function makePage(overrides: Record<string, any> = {}) {
+  const page: any = {
+    id: 'p1',
+    name: 'Intro',
+    type: 'text',
+    sort: 100000,
+    text: { content: '<p>old</p>' },
+    title: { show: true, level: 1 },
+    update: vi.fn(async () => undefined),
+    ...overrides,
+  };
+  return page;
+}
+
+function makeJournal(pages: any[] = [makePage()], overrides: Record<string, any> = {}) {
+  const journal: any = {
+    id: 'j1',
+    name: 'Existing',
+    folder: null,
+    ownership: { default: 0 },
+    pages: { size: pages.length, contents: pages },
+    update: vi.fn(async function (this: any, data: any) {
+      if (data.name) journal.name = data.name;
+    }),
+    createEmbeddedDocuments: vi.fn(async (_type: string, data: any[]) =>
+      data.map((d, i) => ({ id: `new-${i}`, ...d }))
+    ),
+    ...overrides,
+  };
+  return journal;
+}
+
+function setup(options: { allowWriteOperations?: boolean; journals?: any[]; actors?: any[] } = {}) {
+  const created = makeJournal([
+    makePage({ id: 'c1', name: 'First' }),
+    makePage({ id: 'c2', name: 'Second' }),
+  ]);
+  const create = vi.fn(async (data: any) => {
+    created.name = data.name;
+    created.ownership = data.ownership;
+    return created;
+  });
+
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('JournalEntry', { create });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'world-1', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'Gamemaster' },
+    journal: { contents: options.journals ?? [] },
+    actors: { contents: options.actors ?? [] },
+    scenes: { contents: [] },
+    items: { contents: [] },
+    tables: { contents: [] },
+    settings: {
+      get: (_module: string, key: string) =>
+        key === 'allowWriteOperations' ? (options.allowWriteOperations ?? true) : undefined,
+    },
+  });
+
+  const dataAccess = new FoundryDataAccess();
+  const getOrCreateFolder = vi.fn(async (name: string) => `folder-${name}`);
+  (dataAccess as any).getOrCreateFolder = getOrCreateFolder;
+  return { dataAccess, create, created, getOrCreateFolder };
+}
+
+describe('FoundryDataAccess.manageJournals', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  describe('create', () => {
+    it('creates a GM-only journal with ordered text and image pages in a folder', async () => {
+      const { dataAccess, create, getOrCreateFolder } = setup();
+
+      const result = await dataAccess.manageJournals({
+        action: 'create',
+        name: '  Goblin Arrows ',
+        folder: 'Part 1',
+        pages: [
+          { name: 'Intro', content: '<p>Hello</p>', show_title: false, title_level: 2 },
+          { name: 'Map', type: 'image', src: 'worlds/w/uploads/map.png', caption: 'The map' },
+        ],
+      });
+
+      expect(getOrCreateFolder).toHaveBeenCalledWith('Part 1', 'JournalEntry');
+      expect(create).toHaveBeenCalledWith({
+        name: 'Goblin Arrows',
+        ownership: { default: 0 },
+        folder: 'folder-Part 1',
+        pages: [
+          {
+            name: 'Intro',
+            type: 'text',
+            sort: 100000,
+            text: { format: 1, content: '<p>Hello</p>' },
+            title: { show: false, level: 2 },
+          },
+          {
+            name: 'Map',
+            type: 'image',
+            sort: 200000,
+            src: 'worlds/w/uploads/map.png',
+            image: { caption: 'The map' },
+          },
+        ],
+      });
+      expect(result.success).toBe(true);
+      expect(result.journal.id).toBe('j1');
+      expect(result.pages.map((p: any) => p.result)).toEqual(['created', 'created']);
+    });
+
+    it('applies the requested visibility', async () => {
+      const { dataAccess, create } = setup();
+      await dataAccess.manageJournals({ action: 'create', name: 'x', ownership: 'observer' });
+      expect(create.mock.calls[0][0].ownership).toEqual({ default: 2 });
+    });
+
+    it('creates an empty text page body when none is given', async () => {
+      const { dataAccess, create } = setup();
+      await dataAccess.manageJournals({ action: 'create', name: 'x', pages: [{ name: 'Blank' }] });
+      expect(create.mock.calls[0][0].pages[0].text).toEqual({ format: 1, content: '' });
+    });
+
+    it('removes scripts and resolves links in page content, reporting unmatched ones', async () => {
+      const { dataAccess, create } = setup({
+        actors: [{ id: 'a1', name: 'Sildar Hallwinter' }],
+      });
+
+      const result = await dataAccess.manageJournals({
+        action: 'create',
+        name: 'x',
+        pages: [
+          {
+            name: 'p',
+            content:
+              '<p onclick="x()">{{actor: Sildar Hallwinter}} {{actor: Nobody}}</p><script>bad()</script>',
+          },
+        ],
+      });
+
+      expect(create.mock.calls[0][0].pages[0].text.content).toBe(
+        '<p>@UUID[Actor.a1]{Sildar Hallwinter} Nobody</p>'
+      );
+      expect(result.warnings).toHaveLength(1);
+      expect(result.warnings[0]).toContain('matches no actor');
+    });
+
+    it.each([
+      ['no name', { action: 'create' }, 'name is required'],
+      ['a blank name', { action: 'create', name: '  ' }, 'non-empty'],
+      ['a bad ownership', { action: 'create', name: 'x', ownership: 'all' }, 'ownership must be'],
+      [
+        'a nameless page',
+        { action: 'create', name: 'x', pages: [{ content: 'a' }] },
+        'needs a name',
+      ],
+      [
+        'an image page without src',
+        { action: 'create', name: 'x', pages: [{ name: 'i', type: 'image' }] },
+        'needs a src',
+      ],
+      [
+        'an unsupported page type',
+        { action: 'create', name: 'x', pages: [{ name: 'i', type: 'video' }] },
+        'Unsupported page type',
+      ],
+      [
+        'a bad title level',
+        { action: 'create', name: 'x', pages: [{ name: 'i', title_level: 7 }] },
+        'title_level',
+      ],
+    ])('rejects %s without creating anything', async (_label, options, message) => {
+      const { dataAccess, create } = setup();
+      await expect(dataAccess.manageJournals(options as any)).rejects.toThrow(message);
+      expect(create).not.toHaveBeenCalled();
+    });
+  });
+
+  describe('update', () => {
+    it('renames, moves, changes visibility and edits a page found by name', async () => {
+      const page = makePage({ id: 'p1', name: 'Intro' });
+      const journal = makeJournal([page]);
+      const { dataAccess } = setup({ journals: [journal] });
+
+      const result = await dataAccess.manageJournals({
+        action: 'update',
+        journal: 'existing',
+        name: 'Renamed',
+        folder: 'Part 2',
+        ownership: 'limited',
+        pages: [{ name: 'intro', content: '<p>new</p>', show_title: false }],
+      });
+
+      expect(journal.update).toHaveBeenCalledWith({
+        name: 'Renamed',
+        ownership: { default: 1 },
+        folder: 'folder-Part 2',
+      });
+      expect(page.update).toHaveBeenCalledWith({
+        'text.content': '<p>new</p>',
+        'title.show': false,
+      });
+      expect(result.pages).toEqual([{ id: 'p1', name: 'Intro', type: 'text', result: 'updated' }]);
+    });
+
+    it('finds a page by id and adds a new page at the end when the name is new', async () => {
+      const page = makePage({ id: 'p1', sort: 300000 });
+      const journal = makeJournal([page]);
+      const { dataAccess } = setup({ journals: [journal] });
+
+      const result = await dataAccess.manageJournals({
+        action: 'update',
+        journal: 'j1',
+        pages: [
+          { id: 'p1', content: 'x' },
+          { name: 'Added', content: '<p>a</p>' },
+        ],
+      });
+
+      expect(page.update).toHaveBeenCalled();
+      expect(journal.createEmbeddedDocuments).toHaveBeenCalledWith('JournalEntryPage', [
+        {
+          name: 'Added',
+          type: 'text',
+          sort: 400000,
+          text: { format: 1, content: '<p>a</p>' },
+        },
+      ]);
+      expect(result.pages.map((p: any) => p.result)).toEqual(['updated', 'created']);
+    });
+
+    it('does not remove pages that are not mentioned', async () => {
+      const journal = makeJournal([
+        makePage({ id: 'a', name: 'A' }),
+        makePage({ id: 'b', name: 'B' }),
+      ]);
+      const { dataAccess } = setup({ journals: [journal] });
+      await dataAccess.manageJournals({ action: 'update', journal: 'j1', name: 'N' });
+      expect(journal.pages.contents).toHaveLength(2);
+    });
+
+    it('edits an image page and refuses to change a page type', async () => {
+      const image = makePage({ id: 'i', name: 'Map', type: 'image', src: 'old.png', image: {} });
+      const journal = makeJournal([image]);
+      const { dataAccess } = setup({ journals: [journal] });
+
+      await dataAccess.manageJournals({
+        action: 'update',
+        journal: 'j1',
+        pages: [{ id: 'i', src: 'new.png', caption: 'C' }],
+      });
+      expect(image.update).toHaveBeenCalledWith({ src: 'new.png', 'image.caption': 'C' });
+
+      await expect(
+        dataAccess.manageJournals({
+          action: 'update',
+          journal: 'j1',
+          pages: [{ id: 'i', type: 'text', content: 'x' }],
+        })
+      ).rejects.toThrow('type cannot change');
+    });
+
+    it('refuses ambiguous journal or page names, missing ids and empty updates', async () => {
+      const dup = [makePage({ id: 'a', name: 'Same' }), makePage({ id: 'b', name: 'Same' })];
+      const journal = makeJournal(dup);
+      const other = makeJournal([makePage()], { id: 'j2' });
+      const { dataAccess } = setup({ journals: [journal, other] });
+
+      await expect(
+        dataAccess.manageJournals({
+          action: 'update',
+          journal: 'j1',
+          pages: [{ name: 'same', content: 'x' }],
+        })
+      ).rejects.toThrow('Several pages');
+      await expect(
+        dataAccess.manageJournals({
+          action: 'update',
+          journal: 'j1',
+          pages: [{ id: 'zzz', content: 'x' }],
+        })
+      ).rejects.toThrow('Page not found');
+      await expect(dataAccess.manageJournals({ action: 'update', journal: 'j1' })).rejects.toThrow(
+        'Nothing to update'
+      );
+      await expect(
+        dataAccess.manageJournals({ action: 'update', journal: 'Existing', name: 'x' })
+      ).rejects.toThrow('Several journals');
+      await expect(
+        dataAccess.manageJournals({ action: 'update', journal: 'nope', name: 'x' })
+      ).rejects.toThrow('Journal not found');
+      await expect(dataAccess.manageJournals({ action: 'update', name: 'x' })).rejects.toThrow(
+        'journal is required'
+      );
+    });
+  });
+
+  describe('describe', () => {
+    it('lists journals, and shows one with its pages in order', async () => {
+      const text = makePage({
+        id: 't',
+        name: 'Text',
+        sort: 200000,
+        text: { content: '<p>hi</p>' },
+      });
+      const image = makePage({
+        id: 'i',
+        name: 'Img',
+        type: 'image',
+        sort: 100000,
+        src: 'a.png',
+        image: { caption: 'cap' },
+      });
+      const journal = makeJournal([text, image], {
+        folder: { name: 'F' },
+        ownership: { default: 2 },
+      });
+      const { dataAccess } = setup({ journals: [journal] });
+
+      const list = await dataAccess.manageJournals({ action: 'describe' });
+      expect(list.journals).toEqual([
+        { id: 'j1', name: 'Existing', folder: 'F', ownership: 'observer', pageCount: 2 },
+      ]);
+
+      const one = await dataAccess.manageJournals({ action: 'describe', journal: 'j1' });
+      expect(one.journal.pages.map((p: any) => p.name)).toEqual(['Img', 'Text']);
+      expect(one.journal.pages[0]).toMatchObject({ src: 'a.png', caption: 'cap' });
+      expect(one.journal.pages[1]).toMatchObject({ content: '<p>hi</p>' });
+    });
+
+    it('works even when write operations are disabled', async () => {
+      const { dataAccess } = setup({ allowWriteOperations: false });
+      await expect(dataAccess.manageJournals({ action: 'describe' })).resolves.toMatchObject({
+        success: true,
+      });
+    });
+  });
+
+  describe('write gate', () => {
+    it('blocks create and update when write operations are disabled', async () => {
+      const journal = makeJournal();
+      const { dataAccess, create } = setup({ allowWriteOperations: false, journals: [journal] });
+
+      await expect(dataAccess.manageJournals({ action: 'create', name: 'x' })).rejects.toThrow(
+        /disabled in module settings/
+      );
+      await expect(
+        dataAccess.manageJournals({ action: 'update', journal: 'j1', name: 'x' })
+      ).rejects.toThrow(/disabled in module settings/);
+      expect(create).not.toHaveBeenCalled();
+      expect(journal.update).not.toHaveBeenCalled();
+    });
+  });
+});

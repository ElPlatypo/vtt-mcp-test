+import { describe, expect, it } from 'vitest';
+import { auditSnapshot, type AuditScene, type AuditSnapshot } from './world-audit-utils.js';
+
+const scene = (over: Partial<AuditScene> = {}): AuditScene => ({
+  id: 's1', name: 'Cave', isBackup: false, active: true, navigation: true, hasBackground: true,
+  walls: 10, doors: 1, tokens: 3, tokensWithoutActor: 0, lights: 2, sounds: 0, notes: 0, tiles: 0, regions: 0,
+  musicPlaylist: 'p1', musicPlaylistExists: true, teleports: [], ...over,
+});
+const snap = (scenes: AuditScene[], over: Partial<AuditSnapshot> = {}): AuditSnapshot => ({
+  scenes, playlists: [{ id: 'p1', name: 'Mix', soundCount: 2 }], actorCount: 4, ...over,
+});
+
+describe('auditSnapshot', () => {
+  it('has nothing to say about a finished scene', () => {
+    const r = auditSnapshot(snap([scene()]));
+    expect(r.findings).toEqual([]);
+    expect(r.summary).toEqual({ error: 0, warning: 0, info: 0 });
+    expect(r.scenes[0]).toMatchObject({ name: 'Cave', walls: 10, music: true });
+  });
+
+  it('flags a bare scene, worst first', () => {
+    const r = auditSnapshot(snap([scene({ hasBackground: false, walls: 0, lights: 0, tokens: 0, musicPlaylist: null, musicPlaylistExists: true })]));
+    expect(r.findings.map(f => f.severity)).toEqual(['warning', 'info', 'info', 'info']);
+    expect(r.findings[0]!.message).toContain('background');
+    expect(r.summary).toEqual({ error: 0, warning: 1, info: 3 });
+  });
+
+  it('makes missing walls a warning only when there are tokens', () => {
+    expect(auditSnapshot(snap([scene({ walls: 0 })])).findings.find(f => f.message.includes('walls'))!.severity).toBe('warning');
+    expect(auditSnapshot(snap([scene({ walls: 0, tokens: 0 })])).findings.find(f => f.message.includes('walls'))!.severity).toBe('info');
+  });
+
+  it('checks teleports and music bindings', () => {
+    const r = auditSnapshot(snap([
+      scene({
+        musicPlaylist: 'gone', musicPlaylistExists: false,
+        teleports: [
+          { region: 'Door', hidden: false, disabled: false, destinations: ['a', 'b'], resolved: [true, false] },
+          { region: 'Hidden', hidden: true, disabled: true, destinations: ['a'], resolved: [true] },
+          { region: 'Empty', hidden: false, disabled: false, destinations: [], resolved: [] },
+        ],
+      }),
+    ]));
+    const errors = r.findings.filter(f => f.severity === 'error').map(f => f.message);
+    expect(errors).toHaveLength(3);
+    expect(errors.join('|')).toContain('does not exist');
+    expect(errors.join('|')).toContain('hidden regions never run');
+    expect(errors.join('|')).toContain('playlist that no longer exists');
+    expect(r.findings.some(f => f.message.includes('no destination'))).toBe(true);
+    expect(r.findings.some(f => f.message.includes('disabled'))).toBe(true);
+  });
+
+  it('skips backups, notes duplicate names, empty playlists and no active scene', () => {
+    const r = auditSnapshot(snap(
+      [scene({ active: false }), scene({ id: 's2', active: false }), scene({ id: 's3', name: 'Cave (old)', isBackup: true, walls: 0 })],
+      { playlists: [{ id: 'p', name: 'Empty', soundCount: 0 }], actorCount: 0 }
+    ));
+    const text = r.findings.map(f => f.message).join('|');
+    expect(text).toContain('2 scenes are called "cave"');
+    expect(text).toContain('No scene is active');
+    expect(text).toContain('no tracks');
+    expect(text).toContain('no actors');
+    expect(r.scenes).toHaveLength(2);
+  });
+
+  it('warns about tokens whose actor is gone, and about an empty world', () => {
+    expect(auditSnapshot(snap([scene({ tokensWithoutActor: 2 })])).findings[0]!.message).toContain('2 token(s)');
+    expect(auditSnapshot(snap([])).findings[0]!.message).toContain('no scenes');
+  });
+});
diff --git a/packages/foundry-module/src/world-audit-utils.ts b/packages/foundry-module/src/world-audit-utils.ts
new file mode 100644
index 0000000..3460272
--- /dev/null
+++ b/packages/foundry-module/src/world-audit-utils.ts
@@ -0,0 +1,174 @@
+/**
+ * Pure checks for audit-world: given a plain snapshot of the world's scenes, playlists and
+ * actors, list what is missing or broken. No Foundry globals, so it can be tested.
+ */
+
+/** True for the pictures Foundry and dnd5e give a new actor, which mean nobody chose one. */
+export function isDefaultActorImage(img: unknown): boolean {
+  if (typeof img !== 'string' || !img.trim()) return true;
+  return /mystery-man|^icons\/svg\/|\/icons\/svg\/actors\//.test(img);
+}
+
+export type AuditSeverity = 'error' | 'warning' | 'info';
+
+export interface AuditTeleport {
+  region: string;
+  behaviorId?: string;
+  hidden: boolean;
+  disabled: boolean;
+  destinations: string[];
+  /** For each destination: does it name a region that exists? Same order as destinations. */
+  resolved: boolean[];
+}
+
+export interface AuditScene {
+  id: string;
+  name: string;
+  isBackup: boolean;
+  active: boolean;
+  navigation: boolean;
+  hasBackground: boolean;
+  walls: number;
+  doors: number;
+  tokens: number;
+  tokensWithoutActor: number;
+  lights: number;
+  sounds: number;
+  notes: number;
+  tiles: number;
+  regions: number;
+  musicPlaylist: string | null;
+  musicPlaylistExists: boolean;
+  teleports: AuditTeleport[];
+  /** Map pins whose journal or page no longer exists. */
+  brokenPins?: number;
+  darkness?: number;
+  tokenVision?: boolean;
+  globalLight?: boolean;
+}
+
+export interface AuditActor {
+  id: string;
+  name: string;
+  type: string;
+  /** False when the actor still has Foundry's default silhouette (or none). */
+  hasImage: boolean;
+  /** A non-GM user owns it. */
+  hasPlayerOwner: boolean;
+}
+
+export interface AuditPlaylist {
+  id: string;
+  name: string;
+  soundCount: number;
+}
+
+export interface AuditSnapshot {
+  scenes: AuditScene[];
+  playlists: AuditPlaylist[];
+  actorCount: number;
+  actors?: AuditActor[];
+}
+
+export interface AuditFinding {
+  severity: AuditSeverity;
+  scene?: string;
+  playlist?: string;
+  message: string;
+  fix?: string;
+}
+
+const RANK: Record<AuditSeverity, number> = { error: 0, warning: 1, info: 2 };
+
+export function auditSnapshot(snapshot: AuditSnapshot): { summary: Record<AuditSeverity, number>; findings: AuditFinding[]; scenes: any[] } {
+  const findings: AuditFinding[] = [];
+  const add = (f: AuditFinding) => findings.push(f);
+  const scenes = snapshot.scenes.filter(s => !s.isBackup);
+
+  if (scenes.length === 0) add({ severity: 'warning', message: 'The world has no scenes', fix: 'create one with manage-scenes' });
+  else if (!scenes.some(s => s.active)) {
+    add({ severity: 'info', message: 'No scene is active, so players land on nothing', fix: 'manage-scenes set_active, or switch-scene' });
+  }
+
+  const byName = new Map<string, number>();
+  for (const s of scenes) byName.set(s.name.toLowerCase(), (byName.get(s.name.toLowerCase()) ?? 0) + 1);
+  for (const [name, count] of byName) {
+    if (count > 1) add({ severity: 'warning', message: `${count} scenes are called "${name}"; tools that take a name will refuse it`, fix: 'rename one or use ids' });
+  }
+
+  for (const s of scenes) {
+    const here = { scene: s.name };
+    if (!s.hasBackground) add({ severity: 'warning', ...here, message: 'No background image', fix: 'generate-image / upload-file, then manage-scenes' });
+    if (s.walls === 0) {
+      add({ severity: s.tokens > 0 ? 'warning' : 'info', ...here, message: 'No walls, so nothing blocks sight or movement', fix: 'layout apply_walls, or manage-scene-objects' });
+    }
+    if (s.tokens === 0) add({ severity: 'info', ...here, message: 'No tokens', fix: 'layout place, or manage-actors' });
+    if (s.tokensWithoutActor > 0) {
+      add({ severity: 'warning', ...here, message: `${s.tokensWithoutActor} token(s) whose actor no longer exists`, fix: 'delete-tokens or relink' });
+    }
+    if (s.walls > 0 && s.lights === 0) add({ severity: 'info', ...here, message: 'Walls but no lights (fine for a lit map, dark for a dungeon)', fix: 'layout lights' });
+    if ((s.brokenPins ?? 0) > 0) {
+      add({ severity: 'warning', ...here, message: `${s.brokenPins} map pin(s) point at a journal or page that no longer exists`, fix: 'manage-scene-objects update/remove, or recreate the journal' });
+    }
+    if ((s.darkness ?? 0) >= 0.5 && s.tokenVision && !s.globalLight && s.lights === 0) {
+      add({ severity: 'warning', ...here, message: 'Dark scene with token vision but no lights: players will see nothing', fix: 'layout lights, manage-scene-objects light, or lower darkness' });
+    }
+    if ((s.darkness ?? 0) < 0.5 && s.tokenVision && !s.globalLight && s.lights === 0 && s.tokens > 0) {
+      add({ severity: 'warning', ...here, message: 'Daylight scene with token vision but global light off and no lights: players see only a few feet around their tokens', fix: 'manage-scenes update global_light: true (outdoor or lit map), or add lights' });
+    }
+    if (!s.musicPlaylist) add({ severity: 'info', ...here, message: 'No music', fix: 'setup-scene-sound' });
+    else if (!s.musicPlaylistExists) {
+      add({ severity: 'error', ...here, message: `Music is bound to a playlist that no longer exists (${s.musicPlaylist})`, fix: 'setup-scene-sound or update-scene-music' });
+    }
+    for (const t of s.teleports) {
+      const where = `Teleport region "${t.region}"`;
+      if (t.destinations.length === 0) {
+        add({ severity: 'warning', ...here, message: `${where} has no destination`, fix: 'manage-regions link' });
+        continue;
+      }
+      t.destinations.forEach((d, i) => {
+        if (!t.resolved[i]) add({ severity: 'error', ...here, message: `${where} points at ${d}, which does not exist`, fix: 'manage-regions link again' });
+      });
+      if (t.hidden) add({ severity: 'error', ...here, message: `${where} is hidden, and hidden regions never run their behaviors`, fix: 'manage-regions update hidden:false' });
+      if (t.disabled) add({ severity: 'warning', ...here, message: `${where} has a disabled teleport behavior` });
+    }
+  }
+
+  for (const p of snapshot.playlists) {
+    if (p.soundCount === 0) add({ severity: 'warning', playlist: p.name, message: 'Playlist has no tracks', fix: 'manage-playlists add_sounds' });
+  }
+  if (snapshot.actorCount === 0) add({ severity: 'info', message: 'The world has no actors' });
+  const actors = snapshot.actors ?? [];
+  const names = (list: AuditActor[]) => list.slice(0, 6).map(a => a.name).join(', ') + (list.length > 6 ? `, and ${list.length - 6} more` : '');
+  const noImage = actors.filter(a => !a.hasImage);
+  if (noImage.length > 0) {
+    add({ severity: 'info', message: `${noImage.length} actor(s) still have the default silhouette: ${names(noImage)}`, fix: 'generate-image (portrait or token), then manage-actors tokenImg/img' });
+  }
+  const unowned = actors.filter(a => a.type === 'character' && !a.hasPlayerOwner);
+  if (unowned.length > 0) {
+    add({ severity: 'info', message: `${unowned.length} player character(s) are not owned by any player: ${names(unowned)}`, fix: 'assign-actor-ownership' });
+  }
+
+  findings.sort((a, b) => RANK[a.severity] - RANK[b.severity]);
+  const summary: Record<AuditSeverity, number> = { error: 0, warning: 0, info: 0 };
+  for (const f of findings) summary[f.severity]++;
+
+  return {
+    summary,
+    findings,
+    scenes: scenes.map(s => ({
+      id: s.id,
+      name: s.name,
+      active: s.active,
+      walls: s.walls,
+      doors: s.doors,
+      tokens: s.tokens,
+      lights: s.lights,
+      sounds: s.sounds,
+      notes: s.notes,
+      regions: s.regions,
+      music: s.musicPlaylist ? s.musicPlaylistExists : false,
+      teleports: s.teleports.length,
+    })),
+  };
+}
diff --git a/packages/foundry-module/src/world-time.ts b/packages/foundry-module/src/world-time.ts
new file mode 100644
index 0000000..c84df5b
--- /dev/null
+++ b/packages/foundry-module/src/world-time.ts
@@ -0,0 +1,119 @@
+/**
+ * The world-time query: read and move Foundry's world clock (game.time) on the world calendar,
+ * which dnd5e extends with sunrise, sunset and calendars such as Harptos. Advancing the clock is
+ * Foundry's own game.time.advance, so effects with durations, the dnd5e daily recovery and
+ * calendar displays all follow it.
+ */
+import { permissionManager } from './permissions.js';
+import { ERROR_MESSAGES } from './constants.js';
+import { describeDuration, describeTime, durationSeconds, secondsUntil, type TimeTarget } from './time-utils.js';
+
+export interface WorldTimeRequest {
+  action?: 'status' | 'advance' | 'until' | 'set' | 'calendar';
+  seconds?: number;
+  rounds?: number;
+  minutes?: number;
+  hours?: number;
+  days?: number;
+  until?: TimeTarget;
+  year?: number;
+  month?: number | string;
+  day?: number;
+  hour?: number;
+  minute?: number;
+  calendar?: string;
+}
+
+const TARGETS: TimeTarget[] = ['dawn', 'sunrise', 'morning', 'noon', 'afternoon', 'dusk', 'sunset', 'evening', 'midnight'];
+
+export async function worldTime(data: WorldTimeRequest): Promise<Record<string, any>> {
+  const g = (globalThis as any).game;
+  const time = g?.time;
+  if (!time?.calendar) throw new Error('This Foundry version has no world calendar (game.time.calendar)');
+  const t = (key: string) => (g.i18n?.localize ? g.i18n.localize(key) : key);
+  const now = () => describeTime(time.calendar, time.components, time.worldTime, t);
+  const action = data?.action ?? 'status';
+  const inCombat = !!(g.combat?.started);
+
+  if (action === 'status') {
+    const out: Record<string, any> = { success: true, ...now() };
+    if (g.settings?.settings?.has?.('dnd5e.calendar')) {
+      out.calendarSetting = g.settings.get('dnd5e', 'calendar');
+      const cfg = g.settings.get('dnd5e', 'calendarConfig') ?? {};
+      if (cfg.dailyRecovery !== undefined) out.dailyRecovery = !!cfg.dailyRecovery;
+    }
+    if (inCombat) out.note = 'A combat is running: each round already moves the clock by 6 seconds';
+    return out;
+  }
+
+  const gate = permissionManager.checkWritePermission('modifyScene', {});
+  if (!gate.allowed) throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${gate.reason}`);
+  const before = now();
+
+  if (action === 'advance' || action === 'until') {
+    let seconds: number;
+    if (action === 'until') {
+      if (!data.until || !TARGETS.includes(data.until)) throw new Error(`until must be one of: ${TARGETS.join(', ')}`);
+      seconds = secondsUntil(time.calendar, time.components, data.until);
+    } else {
+      seconds = durationSeconds(time.calendar, data);
+      if (!(seconds > 0)) throw new Error('advance needs a positive amount: seconds, rounds, minutes, hours or days');
+    }
+    const spd = time.calendar.days.hoursPerDay * time.calendar.days.minutesPerHour * time.calendar.days.secondsPerMinute;
+    if (seconds > 366 * spd) throw new Error('That is more than a year; use set for a date instead');
+    const dayBefore = time.components.day + time.components.year * 1000;
+    await time.advance(seconds);
+    const after = now();
+    const newDays = time.components.day + time.components.year * 1000 - dayBefore;
+    return {
+      success: true,
+      advanced: describeDuration(time.calendar, seconds),
+      before: `${before.date}, ${before.time} (${before.partOfDay})`,
+      ...after,
+      ...(newDays > 0 ? { newDay: `${newDays} new day${newDays === 1 ? '' : 's'} began: dnd5e recovers daily uses when daily recovery is on` } : {}),
+      ...(inCombat ? { note: 'A combat is running; moving the clock does not change its rounds' } : {}),
+    };
+  }
+
+  if (action === 'set') {
+    const cal = time.calendar;
+    const c = { ...time.components };
+    const months = cal.months?.values ?? [];
+    if (data.month !== undefined) {
+      const index =
+        typeof data.month === 'number'
+          ? data.month - 1
+          : months.findIndex((m: any) => [m.name, t(m.name), m.abbreviation, m.abbreviation ? t(m.abbreviation) : ''].some(s => String(s ?? '').toLowerCase() === String(data.month).toLowerCase()));
+      if (index < 0 || index >= months.length) throw new Error(`Unknown month "${data.month}"; months: ${months.map((m: any) => t(m.name)).join(', ')}`);
+      c.month = index;
+    }
+    if (data.year !== undefined) c.year = data.year - (cal.years?.yearZero ?? 0);
+    if (data.day !== undefined) c.dayOfMonth = data.day - 1;
+    if (data.hour !== undefined) c.hour = data.hour;
+    if (data.minute !== undefined) c.minute = data.minute;
+    if (data.hour !== undefined || data.minute !== undefined) c.second = 0;
+    // the day of the year follows from the month and day of the month
+    if (data.month !== undefined || data.day !== undefined) {
+      const leap = !!c.leapYear;
+      let day = 0;
+      for (let i = 0; i < c.month; i++) day += Number(leap && months[i].leapDays !== undefined ? months[i].leapDays : months[i].days) || 0;
+      c.day = day + c.dayOfMonth;
+    }
+    await time.set(cal.componentsToTime(c));
+    return { success: true, before: `${before.date}, ${before.time}`, ...now() };
+  }
+
+  if (action === 'calendar') {
+    const setting = g.settings?.settings?.get?.('dnd5e.calendar');
+    if (!setting) throw new Error('Choosing a calendar needs the dnd5e system');
+    const list = ((globalThis as any).CONFIG?.DND5E?.calendar?.calendars ?? []) as any[];
+    const options = (Array.isArray(list) ? list : Object.values(list)).map(c => ({ value: c.value, label: t(c.label ?? c.value) }));
+    if (!data.calendar) return { success: true, current: g.settings.get('dnd5e', 'calendar'), options };
+    const wanted = options.find(o => o.value === data.calendar || o.label.toLowerCase().includes(String(data.calendar).toLowerCase()));
+    if (!wanted) throw new Error(`Unknown calendar "${data.calendar}"; options: ${options.map(o => o.value).join(', ')}`);
+    await g.settings.set('dnd5e', 'calendar', wanted.value);
+    return { success: true, calendar: wanted.label, note: 'The calendar changes how the same world time is shown. Reload the Foundry page (F5) if the date does not update.', ...now() };
+  }
+
+  throw new Error('action must be status, advance, until, set or calendar');
+}
diff --git a/packages/foundry-module/styles/map-generation.css b/packages/foundry-module/styles/map-generation.css
new file mode 100644
index 0000000..5228f12
--- /dev/null
+++ b/packages/foundry-module/styles/map-generation.css
@@ -0,0 +1,346 @@
+/* Map Generation Service settings dialog. Self-contained (mgs- prefix) so it does not depend on,
+   or disturb, the Enhanced Creature Index dialog styles. Uses Foundry's theme variables with
+   fallbacks so it reads on both the dark and light themes. */
+
+.mgs-settings {
+  --mgs-text: var(--color-text-primary, #f0f0e0);
+  --mgs-muted: var(--color-text-secondary, #b8b8a8);
+  --mgs-border: var(--color-border-light-tertiary, rgba(255, 255, 255, 0.22));
+  --mgs-panel: rgba(255, 255, 255, 0.05);
+  width: 100%;
+  min-width: 0;
+  box-sizing: border-box;
+  display: flex;
+  flex-direction: column;
+  gap: 1rem;
+  color: var(--mgs-text);
+  text-align: left;
+  max-height: calc(100vh - 9rem);
+  overflow-y: auto;
+  padding-right: 0.25rem;
+}
+
+.mgs-settings * {
+  box-sizing: border-box;
+}
+
+/* Sections */
+.mgs-block {
+  margin: 0;
+  padding: 0;
+}
+
+.mgs-settings-block {
+  padding: 0.9rem 1rem;
+  background: var(--mgs-panel);
+  border: 1px solid var(--mgs-border);
+  border-radius: 6px;
+}
+
+/* Headings: undo Foundry's default heading underline, margins and font */
+.mgs-settings h2,
+.mgs-settings h3 {
+  margin: 0 0 0.5rem;
+  padding: 0;
+  border: none;
+  font-family: inherit;
+  color: var(--mgs-text);
+}
+
+.mgs-title {
+  font-size: 1.35rem;
+  font-weight: 700;
+}
+
+.mgs-subtitle {
+  font-size: 1.05rem;
+  font-weight: 700;
+}
+
+.mgs-note,
+.mgs-hint,
+.mgs-status-detail {
+  margin: 0.25rem 0 0;
+  color: var(--mgs-muted);
+  font-size: 0.85rem;
+  line-height: 1.4;
+}
+
+.mgs-note {
+  font-size: 0.9rem;
+}
+
+.mgs-status-detail:empty {
+  display: none;
+}
+
+.mgs-hint code,
+.mgs-note code {
+  padding: 0 0.25rem;
+  border-radius: 3px;
+  background: rgba(255, 255, 255, 0.1);
+  color: var(--mgs-text);
+  font-size: 0.8rem;
+}
+
+.mgs-hint[hidden],
+.mgs-custom[hidden] {
+  display: none;
+}
+
+/* Fields: label above the control, not beside it */
+.mgs-form-group {
+  display: flex;
+  flex-direction: column;
+  align-items: stretch;
+  gap: 0.3rem;
+  margin: 0 0 0.9rem;
+}
+
+.mgs-form-group:last-child {
+  margin-bottom: 0;
+}
+
+.mgs-label {
+  flex: none;
+  margin: 0;
+  font-weight: 700;
+  color: var(--mgs-text);
+}
+
+.mgs-settings select,
+.mgs-settings input[type="text"],
+.mgs-settings input[type="number"] {
+  width: 100%;
+  min-width: 0;
+  height: 2.25rem;
+  padding: 0 0.6rem;
+  line-height: normal;
+  color: var(--mgs-text);
+  background: rgba(0, 0, 0, 0.3);
+  border: 1px solid var(--mgs-border);
+  border-radius: 4px;
+}
+
+.mgs-settings select option {
+  color: #111;
+}
+
+.mgs-settings select:focus,
+.mgs-settings input:focus {
+  outline: none;
+  border-color: var(--color-border-highlight, #ff9f1c);
+  box-shadow: 0 0 0 2px rgba(255, 159, 28, 0.3);
+}
+
+.mgs-settings input::placeholder {
+  color: var(--mgs-muted);
+  opacity: 0.8;
+}
+
+/* Checkboxes */
+.mgs-check {
+  display: flex;
+  align-items: flex-start;
+  gap: 0.6rem;
+  margin: 0 0 0.9rem;
+  cursor: pointer;
+}
+
+.mgs-check input[type="checkbox"] {
+  flex: none;
+  margin: 0.15rem 0 0;
+}
+
+.mgs-check span {
+  line-height: 1.4;
+}
+
+/* Status */
+.mgs-status-container {
+  display: flex;
+  flex-direction: column;
+  gap: 0.6rem;
+}
+
+.mgs-status {
+  padding: 0.6rem 1rem;
+  border: 1px solid var(--mgs-border);
+  border-radius: 4px;
+  font-weight: 700;
+  text-align: center;
+}
+
+.mgs-status.running {
+  background: rgba(76, 175, 80, 0.15);
+  border-color: rgba(76, 175, 80, 0.5);
+  color: #6fcf73;
+}
+
+.mgs-status.stopped,
+.mgs-status.error {
+  background: rgba(244, 67, 54, 0.15);
+  border-color: rgba(244, 67, 54, 0.5);
+  color: #ff7b72;
+}
+
+.mgs-status.starting {
+  background: rgba(255, 152, 0, 0.15);
+  border-color: rgba(255, 152, 0, 0.5);
+  color: #ffb347;
+}
+
+.mgs-status.unknown {
+  color: var(--mgs-muted);
+}
+
+/* Buttons: side by side, natural width */
+.mgs-controls {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+}
+
+.mgs-btn {
+  flex: 1 1 8rem;
+  width: auto;
+  height: auto;
+  margin: 0;
+  padding: 0.5rem 0.9rem;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 0.5rem;
+  line-height: 1.2;
+  font-weight: 700;
+  color: #fff;
+  background: #4a4a4a;
+  border: 1px solid rgba(255, 255, 255, 0.25);
+  border-radius: 4px;
+  cursor: pointer;
+}
+
+.mgs-btn:hover:not(:disabled) {
+  filter: brightness(1.15);
+}
+
+.mgs-btn:disabled {
+  opacity: 0.4;
+  cursor: not-allowed;
+}
+
+.mgs-btn.check {
+  background: #1f7ac4;
+}
+
+.mgs-btn.start {
+  background: #3d8b40;
+}
+
+.mgs-btn.stop {
+  background: #c0392b;
+}
+
+/* Footer */
+.mgs-footer {
+  display: flex;
+  justify-content: flex-end;
+  padding-top: 0.75rem;
+  border-top: 1px solid var(--mgs-border);
+}
+
+.mgs-footer .mgs-btn {
+  flex: 0 0 auto;
+  min-width: 10rem;
+}
+
+/* Host and port side by side */
+.mgs-row {
+  display: grid;
+  grid-template-columns: 1fr 7rem;
+  gap: 0.75rem;
+}
+
+.mgs-row .mgs-form-group {
+  margin-bottom: 0.4rem;
+}
+
+.mgs-tight {
+  margin: 0 0 0.9rem;
+}
+
+/* Image generation dialog */
+.mgs-model-bar {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.75rem;
+}
+
+.mgs-model-bar .mgs-btn {
+  flex: 0 0 auto;
+}
+
+.mgs-model-bar .mgs-status-detail {
+  flex: 1 1 12rem;
+  margin: 0;
+}
+
+.mgs-model-bar .mgs-status-detail:empty {
+  display: none;
+}
+
+.mgs-details > .mgs-summary {
+  cursor: pointer;
+  font-size: 1.05rem;
+  font-weight: 700;
+  margin-bottom: 0.4rem;
+}
+
+.mgs-row-2,
+.mgs-row-4 {
+  display: grid;
+  gap: 0.75rem;
+}
+
+.mgs-row-2 {
+  grid-template-columns: 1fr 1fr;
+}
+
+.mgs-row-4 {
+  grid-template-columns: repeat(4, 1fr);
+}
+
+.mgs-row-2 .mgs-form-group,
+.mgs-row-4 .mgs-form-group {
+  margin-bottom: 0.4rem;
+}
+
+.mgs-textarea {
+  width: 100%;
+  min-width: 0;
+  padding: 0.4rem 0.6rem;
+  line-height: 1.35;
+  resize: vertical;
+  color: var(--mgs-text);
+  background: rgba(0, 0, 0, 0.3);
+  border: 1px solid var(--mgs-border);
+  border-radius: 4px;
+  font-family: inherit;
+}
+
+.mgs-textarea:focus {
+  outline: none;
+  border-color: var(--color-border-highlight, #ff9f1c);
+  box-shadow: 0 0 0 2px rgba(255, 159, 28, 0.3);
+}
+
+/* Parts of a profile that belong to one workflow only */
+.mgs-settings [data-workflow-group][hidden],
+.mgs-group[hidden] {
+  display: none;
+}
+
+.mgs-group {
+  margin: 0;
+}

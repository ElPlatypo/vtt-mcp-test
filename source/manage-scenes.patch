+import { describe, expect, it, vi } from 'vitest';
+import { PlayTools } from './play-tools.js';
+
+function make(impl?: (m: string, d: any) => unknown) {
+  const query = vi.fn(impl ?? (async () => ({ success: true })));
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  return { tools: new PlayTools({ foundryClient: { query } as any, logger }), query };
+}
+
+describe('PlayTools', () => {
+  it('exposes the two tools', () => {
+    expect(make().tools.getToolDefinitions().map(d => d.name)).toEqual(['manage-roll-tables', 'manage-macros']);
+  });
+
+  it('forwards valid roll table and macro requests', async () => {
+    const { tools, query } = make();
+    const create = { action: 'create', name: 'Loot', results: [{ text: 'Gold' }, { text: 'Gem', range: [2, 3] }] };
+    await tools.handleManageRollTables(create);
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.manage-roll-tables', create);
+    await tools.handleManageRollTables({ action: 'roll', table: 'Loot', times: 3 });
+    await tools.handleManageMacros({ action: 'create', name: 'Pit', command: 'return 1;' });
+    await tools.handleManageMacros({ action: 'execute', macro: 'Pit' });
+    expect(query).toHaveBeenCalledTimes(4);
+  });
+
+  it.each([
+    ['create table without results', 'handleManageRollTables', { action: 'create', name: 'x' }],
+    ['roll without table', 'handleManageRollTables', { action: 'roll' }],
+    ['too many rolls', 'handleManageRollTables', { action: 'roll', table: 'a', times: 99 }],
+    ['unknown field', 'handleManageRollTables', { action: 'list', extra: 1 }],
+    ['create macro without command', 'handleManageMacros', { action: 'create', name: 'x' }],
+    ['execute without macro', 'handleManageMacros', { action: 'execute' }],
+    ['bad macro type', 'handleManageMacros', { action: 'create', name: 'x', command: 'y', type: 'python' }],
+  ])('rejects %s before contacting Foundry', async (_l, method, args) => {
+    const { tools, query } = make();
+    await expect((tools as any)[method](args)).rejects.toThrow();
+    expect(query).not.toHaveBeenCalled();
+  });
+
+  it('reports a refusal from the module', async () => {
+    const { tools } = make(async () => ({ success: false, error: 'nope' }));
+    await expect(tools.handleManageMacros({ action: 'list' })).rejects.toThrow(/nope/);
+  });
+});
diff --git a/packages/mcp-server/src/tools/play-tools.ts b/packages/mcp-server/src/tools/play-tools.ts
new file mode 100644
index 0000000..06e09dd
--- /dev/null
+++ b/packages/mcp-server/src/tools/play-tools.ts
@@ -0,0 +1,166 @@
+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+
+export interface PlayToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+const row = z
+  .object({
+    text: z.string().min(1),
+    description: z.string().optional(),
+    weight: z.number().int().min(1).max(1000).optional(),
+    range: z.tuple([z.number().int().min(1), z.number().int().min(1)]).optional(),
+  })
+  .strict();
+
+const rollTablesSchema = z
+  .object({
+    action: z.enum(['create', 'update', 'list', 'describe', 'roll']),
+    table: z.string().min(1).optional(),
+    name: z.string().min(1).optional(),
+    description: z.string().optional(),
+    formula: z.string().min(1).optional(),
+    results: z.array(row).min(1).max(200).optional(),
+    replacement: z.boolean().optional(),
+    display_roll: z.boolean().optional(),
+    folder: z.string().min(1).optional(),
+    times: z.number().int().min(1).max(20).optional(),
+    to_chat: z.boolean().optional(),
+  })
+  .strict();
+
+const macrosSchema = z
+  .object({
+    action: z.enum(['create', 'update', 'list', 'describe', 'execute']),
+    macro: z.string().min(1).optional(),
+    name: z.string().min(1).optional(),
+    type: z.enum(['script', 'chat']).optional(),
+    command: z.string().min(1).max(20000).optional(),
+    img: z.string().min(1).optional(),
+    folder: z.string().min(1).optional(),
+  })
+  .strict();
+
+export class PlayTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: PlayToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'PlayTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'manage-roll-tables',
+        description:
+          'Create, change, list, describe and roll on Foundry roll tables (random encounters, loot, rumours). ' +
+          'create {name, results, description?, formula?, replacement?, display_roll?, folder?}: results is a list of rows {text, description?, weight?} (weight 1 by default) and the tool numbers them in order and picks the dice formula (a table of 6 rows gets 1d6; give a formula such as 2d6 together with range on every row to cover an uneven table). Or give range [low, high] on every row for exact dice ranges. ' +
+          'update {table, ...fields}: change name, description, formula or settings; passing results replaces all rows. ' +
+          'roll {table, times?, to_chat?}: roll on the table; the result is posted to chat (GM-only roll) unless to_chat is false, and returned either way. ' +
+          'list shows every table, describe {table} shows one with its rows. table is an id or exact name. Deleting goes through manage-world (type RollTable). Needs the Foundry tab open in a browser.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: { type: 'string', enum: ['create', 'update', 'list', 'describe', 'roll'] },
+            table: { type: 'string', description: 'update / describe / roll: table id or exact name' },
+            name: { type: 'string' },
+            description: { type: 'string', description: 'Text shown on the table' },
+            formula: { type: 'string', description: 'Dice formula, e.g. 1d20 (default: 1d<rows or total weight>)' },
+            results: {
+              type: 'array',
+              maxItems: 200,
+              items: {
+                type: 'object',
+                properties: {
+                  text: { type: 'string', description: 'The result' },
+                  description: { type: 'string', description: 'Extra text under the result' },
+                  weight: { type: 'number', description: 'Relative chance (whole number, default 1)' },
+                  range: {
+                    type: 'array',
+                    items: { type: 'number' },
+                    minItems: 2,
+                    maxItems: 2,
+                    description: 'Exact dice range [low, high]; use on every row or none',
+                  },
+                },
+                required: ['text'],
+                additionalProperties: false,
+              },
+            },
+            replacement: { type: 'boolean', description: 'A rolled result can come up again (default true)' },
+            display_roll: { type: 'boolean', description: 'Show the dice roll in chat (default true)' },
+            folder: { type: 'string', description: 'Roll table folder (created if absent)' },
+            times: { type: 'number', description: 'roll: how many times (1 to 20)' },
+            to_chat: { type: 'boolean', description: 'roll: post to chat (default true)' },
+          },
+          required: ['action'],
+          additionalProperties: false,
+        },
+      },
+      {
+        name: 'manage-macros',
+        description:
+          'Create, change, list, describe and run Foundry macros. ' +
+          'create {name, command, type?, img?, folder?}: type script (JavaScript, the default) or chat (the command is sent to chat). Script macros run in the GM\'s browser with the GM\'s permissions, so write them carefully. ' +
+          'update {macro, ...fields}, list, describe {macro} (shows the code), execute {macro} (runs it now and returns what it returned). macro is an id or exact name. ' +
+          'A macro can be run by a region when a token enters it: give manage-regions a behavior {type: "executeMacro", system: {events: ["tokenEnter"], uuid: "Macro.<id>"}}; the uuid is returned when you create the macro. Deleting goes through manage-world (type Macro). Needs the Foundry tab open in a browser.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: { type: 'string', enum: ['create', 'update', 'list', 'describe', 'execute'] },
+            macro: { type: 'string', description: 'update / describe / execute: macro id or exact name' },
+            name: { type: 'string' },
+            type: { type: 'string', enum: ['script', 'chat'] },
+            command: { type: 'string', description: 'The JavaScript, or the chat text' },
+            img: { type: 'string', description: 'Icon path' },
+            folder: { type: 'string', description: 'Macro folder (created if absent)' },
+          },
+          required: ['action'],
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handleManageRollTables(args: any): Promise<any> {
+    const parsed = rollTablesSchema.parse(args ?? {});
+    if (parsed.action === 'create' && (!parsed.name || !parsed.results)) {
+      throw new Error('create needs name and results');
+    }
+    if (['update', 'describe', 'roll'].includes(parsed.action) && !parsed.table) {
+      throw new Error(`${parsed.action} needs table`);
+    }
+    return this.send('manage-roll-tables', parsed, 'roll tables');
+  }
+
+  async handleManageMacros(args: any): Promise<any> {
+    const parsed = macrosSchema.parse(args ?? {});
+    if (parsed.action === 'create' && (!parsed.name || !parsed.command)) {
+      throw new Error('create needs name and command');
+    }
+    if (['update', 'describe', 'execute'].includes(parsed.action) && !parsed.macro) {
+      throw new Error(`${parsed.action} needs macro`);
+    }
+    return this.send('manage-macros', parsed, 'macros');
+  }
+
+  private async send(method: string, parsed: unknown, label: string): Promise<any> {
+    try {
+      const result = await this.foundryClient.query(`foundry-mcp-bridge.${method}`, parsed);
+      if (result?.success === false) {
+        throw new Error(result.error || 'Request was refused');
+      }
+      return result;
+    } catch (error) {
+      this.logger.error(`Failed to manage ${label}`, error);
+      throw new Error(
+        `Failed to manage ${label}: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+}

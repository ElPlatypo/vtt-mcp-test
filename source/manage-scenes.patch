+import { describe, expect, it, vi } from 'vitest';
+import { RulesTools } from './rules-tools.js';
+
+function make(response: any = { success: true }) {
+  const query = vi.fn(async () => response);
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  return { tools: new RulesTools({ foundryClient: { query } as any, logger }), query };
+}
+
+describe('rules tool', () => {
+  it('is exposed and tells Claude to look rules up', () => {
+    const def = make().tools.getToolDefinitions()[0]!;
+    expect(def.name).toBe('rules');
+    expect(def.description).toContain('instead of answering from memory');
+    expect(def.description).toContain('house');
+  });
+  it('sends the request to Foundry', async () => {
+    const { tools, query } = make({ success: true, results: [] });
+    await tools.handleRules({ query: 'hiding' });
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.rules', { query: 'hiding' }, 60000);
+  });
+  it('rejects bad input and refused requests', async () => {
+    const { tools } = make();
+    await expect(tools.handleRules({ action: 'edit' })).rejects.toThrow();
+    await expect(tools.handleRules({ action: 'read', uuids: [] })).rejects.toThrow();
+    await expect(tools.handleRules({ limit: 50 })).rejects.toThrow();
+    const refused = make({ success: false, error: 'Access denied' });
+    await expect(refused.tools.handleRules({ query: 'surprise' })).rejects.toThrow('Access denied');
+  });
+});

@@ -0,0 +1,95 @@
+/**
+ * Helpers for the map generation settings: read the form, and turn the saved settings into
+ * the target the MCP server is told to use. No Foundry globals, so they can be tested.
+ */
+
+export interface ComfyTargetSetting {
+  mode: 'builtin' | 'custom';
+  host: string;
+  port: number;
+  secure: boolean;
+}
+
+export const DEFAULT_CUSTOM_HOST = '127.0.0.1';
+export const DEFAULT_CUSTOM_PORT = 8188;
+
+const HOSTNAME = /^[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$/;
+const IPV6 = /^\[[0-9A-Fa-f:.]+\]$/;
+
+export type ComfyFormResult =
+  | { ok: true; value: ComfyTargetSetting }
+  | { ok: false; error: string };
+
+/**
+ * Read the ComfyUI fields of the settings form. The host box also accepts a pasted address
+ * such as "http://nexus:8188" or "https://comfy.example.com", which fills in the host, the
+ * port (when given) and whether to use https.
+ */
+export function readComfyForm(form: {
+  mapGenMode?: unknown;
+  mapGenCustomHost?: unknown;
+  mapGenCustomPort?: unknown;
+  mapGenCustomSecure?: unknown;
+}): ComfyFormResult {
+  if (form.mapGenMode !== 'custom') {
+    return {
+      ok: true,
+      value: {
+        mode: 'builtin',
+        host: DEFAULT_CUSTOM_HOST,
+        port: DEFAULT_CUSTOM_PORT,
+        secure: false,
+      },
+    };
+  }
+
+  let host = typeof form.mapGenCustomHost === 'string' ? form.mapGenCustomHost.trim() : '';
+  let secure = form.mapGenCustomSecure === true || form.mapGenCustomSecure === 'true';
+  let portInput: unknown = form.mapGenCustomPort;
+
+  if (host.includes('://')) {
+    let url: URL;
+    try {
+      url = new URL(host);
+    } catch {
+      return { ok: false, error: 'The ComfyUI address is not valid' };
+    }
+    if (url.protocol !== 'http:' && url.protocol !== 'https:') {
+      return { ok: false, error: 'The ComfyUI address must start with http:// or https://' };
+    }
+    if (url.username || url.password) {
+      return { ok: false, error: 'Do not put a user name or password in the ComfyUI address' };
+    }
+    secure = url.protocol === 'https:';
+    host = url.hostname;
+    if (url.port) portInput = Number(url.port);
+    else if (portInput === undefined || portInput === '') portInput = secure ? 443 : 80;
+  }
+
+  if (!host || !(HOSTNAME.test(host) || IPV6.test(host))) {
+    return {
+      ok: false,
+      error: 'The ComfyUI host must be a host name or IP address, for example 127.0.0.1 or nexus',
+    };
+  }
+
+  const port = typeof portInput === 'string' ? Number(portInput.trim()) : portInput;
+  if (typeof port !== 'number' || !Number.isInteger(port) || port < 1 || port > 65535) {
+    return { ok: false, error: 'The ComfyUI port must be a whole number from 1 to 65535' };
+  }
+
+  return { ok: true, value: { mode: 'custom', host, port, secure } };
+}
+
+/** The target to send to the MCP server, from the saved settings. Falls back to built-in. */
+export function targetFromSettings(get: (key: string) => unknown): ComfyTargetSetting {
+  const result = readComfyForm({
+    mapGenMode: get('mapGenMode'),
+    mapGenCustomHost: get('mapGenCustomHost'),
+    mapGenCustomPort: get('mapGenCustomPort'),
+    mapGenCustomSecure: get('mapGenCustomSecure'),
+  });
+  return result.ok
+    ? result.value
+    : { mode: 'builtin', host: DEFAULT_CUSTOM_HOST, port: DEFAULT_CUSTOM_PORT, secure: false };
+}

index 0000000..827bf7c
--- /dev/null
+++ b/packages/mcp-server/src/tools/chat-control.ts
@@ -0,0 +1,95 @@
+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+import { ChatTools } from './chat.js';
+import { DEFAULT_CHAT_FEED_PORT } from '../chat-feed.js';
+
+export interface ChatControlOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+const schema = z
+  .object({
+    action: z.enum(['say', 'narrate', 'read']),
+    // say
+    actorIdentifier: z.string().min(1).optional(),
+    tokenId: z.string().min(1).optional(),
+    language: z.string().min(1).optional(),
+    chatLog: z.boolean().optional(),
+    // say, narrate
+    content: z.string().min(1).max(4000).optional(),
+    whisperTo: z.array(z.string().min(1)).min(1).max(10).optional(),
+    // narrate
+    speaker: z.string().min(1).max(60).optional(),
+    // read
+    since: z.string().min(1).max(40).optional(),
+    from: z.enum(['players', 'all']).optional(),
+    rolls: z.boolean().optional(),
+    limit: z.number().int().min(1).max(50).optional(),
+  })
+  .strict();
+
+export class ChatControlTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+  private say: ChatTools;
+
+  constructor({ foundryClient, logger }: ChatControlOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'ChatControlTools' });
+    this.say = new ChatTools({ foundryClient, logger });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'chat',
+        description:
+          'Talk with the players through the chat. ' +
+          'read {since?, from?: players|all, rolls?, limit?(15)} returns the latest messages as short rows (who, as, kind say|roll|whisper|card, text, roll total, whisper recipients) and a marker: pass it as since next time to get only what is new. ' +
+          'narrate {content, speaker?("Narrator"), whisperTo?} posts narration to everyone, or only to the named players when whisperTo is given. ' +
+          'say {actorIdentifier | tokenId, content, whisperTo?, language?, chatLog?} speaks as an actor or token: a speech bubble by default, or a chat-log line, optionally whispered or in a language (Polyglot). ' +
+          `Live chat: nothing in the chat can wake you up. To run a session, prefer the table-watch feed (one bundled line only when the GM is needed: in-character and private-to-GM lines, monster turns, doors, awaited rolls). Otherwise follow every message with the chat feed, a WebSocket on this computer (ws://127.0.0.1:${DEFAULT_CHAT_FEED_PORT}) that sends one JSON line per new message typed by a person ({id, who, as?, kind, text?, roll?, flavor?, to?, gm?}): the players' and the GM's own typed lines, not what the bridge or the game system posts; ?from=players leaves out the GM. In Claude Code, start it once with the Monitor tool (ws: {url}); each message then arrives as its own notification, to answer one at a time. Without such a tool, poll read with the marker. ` +
+          "Reading is GM-only and shows whispers; never repeat a whisper to other players. A player's chat is their action: respond to what they said, do not act for them. Needs the Foundry GM tab open and not minimized; narrate and say need Allow Write Operations.",
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: { type: 'string', enum: ['say', 'narrate', 'read'], description: 'what to do' },
+            content: { type: 'string', description: 'say, narrate: plain text (html shows literally). In narrate a blank line starts a new paragraph' },
+            actorIdentifier: { type: 'string', description: 'say: name or id of the speaking actor' },
+            tokenId: { type: 'string', description: 'say: a specific token on the scene (prefer it when tokens share an actor)' },
+            whisperTo: { type: 'array', items: { type: 'string' }, description: 'say, narrate: exact player names or user ids; all must resolve or nothing is sent' },
+            language: { type: 'string', description: 'say: language key for Polyglot, e.g. "common"' },
+            chatLog: { type: 'boolean', description: 'say: post a chat-log message instead of only a bubble' },
+            speaker: { type: 'string', description: 'narrate: the name shown (default Narrator)' },
+            since: { type: 'string', description: 'read: a marker (message id) from a previous result' },
+            from: { type: 'string', enum: ['players', 'all'], description: 'read (default all)' },
+            rolls: { type: 'boolean', description: 'read: false leaves out pure roll messages' },
+            limit: { type: 'number', description: 'read: at most this many messages (default 15, max 50)' },
+          },
+          required: ['action'],
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handleChat(args: unknown): Promise<any> {
+    const a = schema.parse(args);
+    this.logger.info('Chat request', { action: a.action });
+    if (a.action === 'say') {
+      if (!a.content) throw new Error('say needs content');
+      if (!a.actorIdentifier && !a.tokenId) throw new Error('say needs actorIdentifier or tokenId');
+      const fields: Record<string, unknown> = {};
+      for (const k of ['actorIdentifier', 'tokenId', 'content', 'language', 'chatLog', 'whisperTo'] as const) {
+        if (a[k] !== undefined) fields[k] = a[k];
+      }
+      return this.say.handleCreateChatMessage(fields);
+    }
+    if (a.action === 'narrate' && !a.content) throw new Error('narrate needs content');
+    const result = await this.foundryClient.query('foundry-mcp-bridge.chat', a, 30000);
+    if (result?.success === false) throw new Error(result.error || 'Request was refused');
+    return result;
+  }
+}

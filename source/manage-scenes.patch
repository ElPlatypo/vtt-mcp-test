+import { describe, expect, it } from 'vitest';
+import {
+  buildBehaviorData,
+  buildRegionData,
+  buildRegionShape,
+  describeSchemaFields,
+  describeShape,
+} from './region-utils.js';
+import type { GridGeometry } from './scene-objects-utils.js';
+
+const geom: GridGeometry = {
+  size: 100,
+  originX: 50,
+  originY: 20,
+  sceneWidth: 2000,
+  sceneHeight: 1000,
+  columns: 20,
+  rows: 10,
+  distance: 5,
+  units: 'ft',
+};
+
+const keys = ['walk', 'swim', 'fly'];
+
+describe('buildRegionShape', () => {
+  it('turns a rectangle in squares into pixels, offset by the scene origin', () => {
+    expect(buildRegionShape({ rect: [2, 1, 3, 2] }, geom, 'r')).toEqual({
+      type: 'rectangle',
+      x: 250,
+      y: 120,
+      width: 300,
+      height: 200,
+      rotation: 0,
+      hole: false,
+    });
+  });
+
+  it('builds ellipses and polygons', () => {
+    expect(buildRegionShape({ ellipse: [5, 5, 2, 1.5] }, geom, 'r')).toMatchObject({
+      type: 'ellipse',
+      x: 550,
+      y: 520,
+      radiusX: 200,
+      radiusY: 150,
+    });
+    expect(
+      buildRegionShape({ polygon: [[0, 0], [4, 0], [2, 3]] }, geom, 'r')
+    ).toEqual({ type: 'polygon', points: [50, 20, 450, 20, 250, 320], hole: false });
+  });
+
+  it('needs exactly one shape and refuses shapes outside the scene', () => {
+    expect(() => buildRegionShape({}, geom, 'r')).toThrow('exactly one');
+    expect(() => buildRegionShape({ rect: [0, 0, 1, 1], ellipse: [1, 1, 1, 1] }, geom, 'r')).toThrow(
+      'exactly one'
+    );
+    expect(() => buildRegionShape({ rect: [18, 8, 5, 5] }, geom, 'r')).toThrow('outside the scene');
+    expect(() => buildRegionShape({ rect: [1, 1, 0, 2] }, geom, 'r')).toThrow('above 0');
+    expect(() => buildRegionShape({ polygon: [[0, 0], [1, 1]] }, geom, 'r')).toThrow('3 to 200');
+  });
+});
+
+describe('buildBehaviorData', () => {
+  it('builds difficult terrain from the movement types Foundry knows', () => {
+    expect(buildBehaviorData({ preset: 'difficult_terrain' }, keys, 'b')).toEqual({
+      type: 'modifyMovementCost',
+      name: 'Difficult terrain',
+      system: { difficulties: { walk: 2, swim: 2, fly: 2 } },
+    });
+    expect(
+      buildBehaviorData({ preset: 'difficult_terrain', cost: 3 }, keys, 'b').system.difficulties.walk
+    ).toBe(3);
+  });
+
+  it('passes raw behaviours through', () => {
+    expect(
+      buildBehaviorData(
+        { type: 'executeMacro', name: 'Pit', system: { events: ['tokenEnter'], uuid: 'Macro.abc' } },
+        keys,
+        'b'
+      )
+    ).toEqual({
+      type: 'executeMacro',
+      name: 'Pit',
+      system: { events: ['tokenEnter'], uuid: 'Macro.abc' },
+    });
+  });
+
+  it('refuses a mix of preset and type, unknown presets and bad values', () => {
+    expect(() => buildBehaviorData({ preset: 'difficult_terrain', type: 'x' }, keys, 'b')).toThrow('either');
+    expect(() => buildBehaviorData({}, keys, 'b')).toThrow('either');
+    expect(() => buildBehaviorData({ preset: 'lava' }, keys, 'b')).toThrow('unknown preset');
+    expect(() => buildBehaviorData({ preset: 'difficult_terrain', cost: -1 }, keys, 'b')).toThrow('cost');
+    expect(() => buildBehaviorData({ preset: 'difficult_terrain' }, [], 'b')).toThrow('no movement types');
+    expect(() => buildBehaviorData({ type: 'bad type!' }, keys, 'b')).toThrow('behaviour type');
+  });
+});
+
+describe('buildRegionData', () => {
+  it('builds a complete region and picks a colour from the behaviours', () => {
+    const data = buildRegionData(
+      { name: ' Rubble ', rect: [1, 1, 2, 2], behaviors: [{ preset: 'difficult_terrain' }] },
+      geom,
+      keys,
+      'regions[0]'
+    );
+    expect(data.name).toBe('Rubble');
+    expect(data.color).toBe('#c97a1a');
+    expect(data.shapes).toHaveLength(1);
+    expect(data.behaviors[0].type).toBe('modifyMovementCost');
+  });
+
+  it('requires a name and a valid colour', () => {
+    expect(() => buildRegionData({ rect: [1, 1, 1, 1] }, geom, keys, 'r')).toThrow('name is required');
+    expect(() =>
+      buildRegionData({ name: 'x', rect: [1, 1, 1, 1], color: 'red' }, geom, keys, 'r')
+    ).toThrow('#RRGGBB');
+  });
+
+  it('keeps hidden and measurement settings', () => {
+    const data = buildRegionData(
+      { name: 'Pit', rect: [1, 1, 1, 1], hidden: true, display_measurements: true, color: '#112233' },
+      geom,
+      keys,
+      'r'
+    );
+    expect(data).toMatchObject({ hidden: true, displayMeasurements: true, color: '#112233' });
+  });
+});
+
+describe('describeShape', () => {
+  it('converts pixel shapes back to squares', () => {
+    const rect = buildRegionShape({ rect: [2, 1, 3, 2] }, geom, 'r');
+    expect(describeShape(rect, geom)).toEqual({ type: 'rect', rect: [2, 1, 3, 2] });
+    const poly = buildRegionShape({ polygon: [[0, 0], [4, 0], [2, 3]] }, geom, 'r');
+    expect(describeShape(poly, geom)).toEqual({ type: 'polygon', polygon: [[0, 0], [4, 0], [2, 3]] });
+  });
+});
+
+describe('describeSchemaFields', () => {
+  it('lists field kinds, initial values, choices and nested fields', () => {
+    class NumberField {
+      options = { initial: 1 };
+    }
+    class SetField {
+      element = { choices: { tokenEnter: 'Enter', tokenExit: 'Exit' } };
+    }
+    class SchemaField {
+      fields = { walk: new NumberField() };
+    }
+    const out = describeSchemaFields({
+      cost: new NumberField(),
+      events: new SetField(),
+      difficulties: new SchemaField(),
+    });
+    expect(out.cost).toEqual({ kind: 'NumberField', initial: 1 });
+    expect(out.events.elementChoices).toEqual(['tokenEnter', 'tokenExit']);
+    expect(out.difficulties.fields.walk).toEqual({ kind: 'NumberField', initial: 1 });
+  });
+});
+
+describe('difficult terrain with the dnd5e behaviour', () => {
+  it('uses dnd5e.difficultTerrain at double cost when the system has it', () => {
+    const data = buildBehaviorData({ preset: 'difficult_terrain' }, keys, 'b', true);
+    expect(data).toEqual({ type: 'dnd5e.difficultTerrain', name: 'Difficult terrain', system: {} });
+  });
+
+  it('falls back to the core behaviour for another cost or without the system', () => {
+    expect(buildBehaviorData({ preset: 'difficult_terrain', cost: 3 }, keys, 'b', true).type).toBe(
+      'modifyMovementCost'
+    );
+    expect(buildBehaviorData({ preset: 'difficult_terrain' }, keys, 'b', false).type).toBe(
+      'modifyMovementCost'
+    );
+  });
+});
diff --git a/packages/foundry-module/src/region-utils.ts b/packages/foundry-module/src/region-utils.ts

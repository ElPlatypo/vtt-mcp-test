+import { describe, expect, it } from 'vitest';
+import {
+  countByKind,
+  decodePath,
+  extensionOf,
+  fileKind,
+  matchesFilter,
+  sanitizeBrowsePath,
+  toBrowseFile,
+} from './file-browse-utils.js';
+
+describe('sanitizeBrowsePath', () => {
+  it('cleans slashes and accepts normal folders', () => {
+    expect(sanitizeBrowsePath(undefined)).toBe('');
+    expect(sanitizeBrowsePath('')).toBe('');
+    expect(sanitizeBrowsePath('/worlds//my-world/uploads/')).toBe('worlds/my-world/uploads');
+    expect(sanitizeBrowsePath('music/Dungeon Ambience')).toBe('music/Dungeon Ambience');
+  });
+  it('refuses anything that could leave the data folder', () => {
+    for (const bad of ['../secrets', 'a/../b', 'a/./b', 'C:/Windows', 'a\\b', 'a\u0000b']) {
+      expect(() => sanitizeBrowsePath(bad)).toThrow();
+    }
+    expect(() => sanitizeBrowsePath(5)).toThrow('string');
+    expect(() => sanitizeBrowsePath('a'.repeat(400))).toThrow('too long');
+  });
+});
+
+describe('fileKind', () => {
+  it('sorts files by extension', () => {
+    expect(fileKind('cave.MP3')).toBe('audio');
+    expect(fileKind('a.ogg')).toBe('audio');
+    expect(fileKind('map.webp')).toBe('image');
+    expect(fileKind('clip.mp4')).toBe('video');
+    expect(fileKind('notes.txt')).toBe('other');
+    expect(fileKind('noext')).toBe('other');
+    expect(extensionOf('a.b.C')).toBe('c');
+  });
+});
+
+describe('toBrowseFile and filters', () => {
+  const rain = toBrowseFile('worlds/w/uploads/audio/Heavy%20Rain.mp3');
+  const map = toBrowseFile('worlds/w/maps/cave.png');
+  const text = toBrowseFile('worlds/w/readme.txt');
+
+  it('decodes the path and names the file', () => {
+    expect(rain).toEqual({ name: 'Heavy Rain.mp3', path: 'worlds/w/uploads/audio/Heavy Rain.mp3', kind: 'audio', ext: 'mp3' });
+    expect(decodePath('100%')).toBe('100%');
+  });
+  it('filters by kind, extension and text', () => {
+    expect(matchesFilter(rain, {})).toBe(true);
+    expect(matchesFilter(rain, { kind: 'audio' })).toBe(true);
+    expect(matchesFilter(map, { kind: 'audio' })).toBe(false);
+    expect(matchesFilter(map, { kind: 'all' })).toBe(true);
+    expect(matchesFilter(map, { extensions: ['.PNG', 'jpg'] })).toBe(true);
+    expect(matchesFilter(rain, { extensions: ['wav'] })).toBe(false);
+    expect(matchesFilter(rain, { search: 'rain' })).toBe(true);
+    expect(matchesFilter(rain, { search: 'cave' })).toBe(false);
+    expect(matchesFilter(toBrowseFile('a/clip.mp4'), { kind: 'video' })).toBe(true);
+  });
+  it('counts by kind', () => {
+    expect(countByKind([rain, map, text, map])).toEqual({ audio: 1, image: 2, video: 0, other: 1 });
+  });
+});
diff --git a/packages/foundry-module/src/file-browse-utils.ts b/packages/foundry-module/src/file-browse-utils.ts
new file mode 100644
index 0000000..d025cac
--- /dev/null
+++ b/packages/foundry-module/src/file-browse-utils.ts
@@ -0,0 +1,105 @@
+/**
+ * Pure helpers for browse-files: checking a folder path, naming file kinds, and filtering and
+ * shaping what Foundry's file picker returns. No Foundry globals, so they can be tested.
+ */
+
+export const AUDIO_EXTENSIONS = ['mp3', 'ogg', 'oga', 'opus', 'wav', 'flac', 'm4a', 'aac', 'webm'];
+export const IMAGE_EXTENSIONS = ['png', 'jpg', 'jpeg', 'webp', 'gif', 'svg', 'avif'];
+export const VIDEO_EXTENSIONS = ['webm', 'mp4', 'm4v', 'ogv'];
+
+export type FileKind = 'audio' | 'image' | 'video' | 'other';
+export type KindFilter = 'audio' | 'image' | 'video' | 'all';
+
+export const MAX_BROWSE_DEPTH = 3;
+export const MAX_BROWSE_FOLDERS = 80;
+export const DEFAULT_BROWSE_LIMIT = 200;
+export const MAX_BROWSE_LIMIT = 1000;
+
+/** A folder path inside the Foundry data folder: no "..", no drive letters, no backslashes. */
+export function sanitizeBrowsePath(raw: unknown): string {
+  if (raw === undefined || raw === null) return '';
+  if (typeof raw !== 'string') throw new Error('path must be a string');
+  const trimmed = raw.trim().replace(/^\/+|\/+$/g, '');
+  if (trimmed.length > 300) throw new Error('path is too long');
+  if (/[\\\u0000-\u001f]/.test(trimmed) || /^[A-Za-z]:/.test(trimmed)) {
+    throw new Error('path must be a Foundry folder path such as worlds/my-world/uploads');
+  }
+  const parts = trimmed.split('/').filter(Boolean);
+  for (const part of parts) {
+    if (part === '.' || part === '..') throw new Error('path may not contain . or .. parts');
+  }
+  return parts.join('/');
+}
+
+export function extensionOf(name: string): string {
+  const dot = name.lastIndexOf('.');
+  return dot < 0 ? '' : name.slice(dot + 1).toLowerCase();
+}
+
+/** What a file is, by its extension (webm counts as audio unless the video filter asks for it). */
+export function fileKind(name: string): FileKind {
+  const ext = extensionOf(name);
+  if (ext === 'webm') return 'audio';
+  if (AUDIO_EXTENSIONS.includes(ext)) return 'audio';
+  if (IMAGE_EXTENSIONS.includes(ext)) return 'image';
+  if (VIDEO_EXTENSIONS.includes(ext)) return 'video';
+  return 'other';
+}
+
+export function decodePath(raw: string): string {
+  try {
+    return decodeURIComponent(String(raw));
+  } catch {
+    return String(raw);
+  }
+}
+
+export interface BrowseFile {
+  name: string;
+  path: string;
+  kind: FileKind;
+  ext: string;
+}
+
+export interface BrowseFilter {
+  kind?: KindFilter;
+  extensions?: string[];
+  search?: string;
+}
+
+/** Does a file pass the kind, extension and text filters? */
+export function matchesFilter(file: BrowseFile, filter: BrowseFilter): boolean {
+  if (filter.kind && filter.kind !== 'all') {
+    const ok = filter.kind === 'video' ? VIDEO_EXTENSIONS.includes(file.ext) : file.kind === filter.kind;
+    if (!ok) return false;
+  }
+  if (filter.extensions && filter.extensions.length > 0) {
+    const wanted = filter.extensions.map(e => e.toLowerCase().replace(/^\./, ''));
+    if (!wanted.includes(file.ext)) return false;
+  }
+  if (filter.search) {
+    const s = filter.search.toLowerCase();
+    if (!file.path.toLowerCase().includes(s)) return false;
+  }
+  return true;
+}
+
+export function toBrowseFile(rawPath: string): BrowseFile {
+  const path = decodePath(rawPath);
+  const name = path.split('/').pop() ?? path;
+  return { name, path, kind: fileKind(name), ext: extensionOf(name) };
+}
+
+export interface BrowseResult {
+  /** Folder that was listed. */
+  path: string;
+  folders: Array<{ name: string; path: string }>;
+  files: BrowseFile[];
+}
+
+/** Count files by kind. */
+export function countByKind(files: BrowseFile[]): Record<FileKind, number> {
+  const counts: Record<FileKind, number> = { audio: 0, image: 0, video: 0, other: 0 };
+  for (const f of files) counts[f.kind]++;
+  return counts;
+}
diff --git a/packages/foundry-module/src/grid-measure-utils.test.ts b/packages/foundry-module/src/grid-measure-utils.test.ts

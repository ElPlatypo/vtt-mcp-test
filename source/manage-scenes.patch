+/** share-with-players: image popout and journal show. Foundry is stubbed. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+
+function setup(allow = true) {
+  const entry: any = { id: 'j1', name: 'Notes', uuid: 'JournalEntry.j1', ownership: { default: 0, u2: 3 }, update: vi.fn(async () => undefined), show: vi.fn(async () => undefined) };
+  const shareImage = vi.fn();
+  const render = vi.fn(async () => undefined);
+  const Popout = vi.fn(function (this: any, opts: any) {
+    this.opts = opts;
+    this.render = render;
+    this.shareImage = shareImage;
+  });
+  const create = vi.fn(async () => undefined);
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('ChatMessage', { create });
+  vi.stubGlobal('foundry', { applications: { apps: { ImagePopout: Popout } } });
+  const users = [
+    { id: 'gm', name: 'GM', isGM: true },
+    { id: 'u1', name: 'Ann', isGM: false },
+    { id: 'u2', name: 'Bob', isGM: false },
+  ];
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'GM' },
+    users: Object.assign([...users], { contents: users }),
+    journal: { get: (id: string) => (id === 'j1' ? entry : undefined), getName: (n: string) => (n === 'Notes' ? entry : undefined), contents: [entry] },
+    settings: { get: (_m: string, key: string) => (key === 'allowWriteOperations' ? allow : undefined) },
+  });
+  return { da: new FoundryDataAccess(), entry, shareImage, render, create };
+}
+
+describe('shareWithPlayers', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('shares an image with all players and can post it to chat', async () => {
+    const { da, shareImage, render, create } = setup();
+    const r = await da.shareWithPlayers({ image: 'u/map.png', title: 'Cave', chat: true });
+    expect(render).toHaveBeenCalled();
+    expect(shareImage).toHaveBeenCalled();
+    expect(create).toHaveBeenCalled();
+    expect(r).toMatchObject({ success: true, shared: 'image', image: 'u/map.png' });
+  });
+  it('opens a journal, giving observer access to players who lack it', async () => {
+    const { da, entry } = setup();
+    const r = await da.shareWithPlayers({ journal: 'Notes' });
+    expect(entry.update).toHaveBeenCalledWith({ ownership: { u1: 2 } });
+    expect(entry.show).toHaveBeenCalledWith('text', true);
+    expect(r).toMatchObject({ success: true, shared: 'journal', players: ['Ann', 'Bob'], granted: 1 });
+  });
+  it('limits a journal to named players and rejects unknown ones', async () => {
+    const { da, entry } = setup();
+    await da.shareWithPlayers({ journal: 'j1', users: ['Bob'] });
+    expect(entry.update).not.toHaveBeenCalled();
+    await expect(da.shareWithPlayers({ journal: 'j1', users: ['Zed'] })).rejects.toThrow('Player not found');
+  });
+  it('refuses bad requests and respects the write gate', async () => {
+    const { da } = setup();
+    await expect(da.shareWithPlayers({})).rejects.toThrow('either image or journal');
+    await expect(da.shareWithPlayers({ image: 'http://x/a.png' })).rejects.toThrow('not a web address');
+    await expect(da.shareWithPlayers({ image: 'a.png', users: ['Ann'] })).rejects.toThrow('all players');
+    await expect(da.shareWithPlayers({ journal: 'Nope' })).rejects.toThrow('Journal not found');
+    await expect(setup(false).da.shareWithPlayers({ journal: 'Notes' })).rejects.toThrow();
+  });
+});

+
+  it('keeps off squares that already hold tokens on the scene', async () => {
+    const { tools, calls } = make({ scene: { tokens: [{ name: 'Old', x: 19, y: 7, width: 1, height: 1 }] } });
+    await newLayout(tools, 'place two');
+    await tools.handleLayout({ action: 'place', layout: 'place two', scene: 'Cave', items: [{ kind: 'token', actor: 'Wolf', in: 'cellar' }] });
+    const [t] = calls.find(c => c.args.action === 'place')!.args.objects;
+    expect(`${t.x},${t.y}`).not.toBe('19,7');
+  });
+
+  it('does a dry run, shifts, and checks its input', async () => {
+    const { tools, calls } = make();
+    await newLayout(tools, 'place three');
+    const dry = await tools.handleLayout({
+      action: 'place',
+      layout: 'place three',
+      dry_run: true,
+      items: [{ kind: 'token', actor: 'Wolf', in: 'cellar', count: 2 }],
+    });
+    expect(dry).toMatchObject({ dryRun: true, wouldPlace: 2 });
+    expect(calls.some(c => c.args.action === 'place')).toBe(false);
+
+    await tools.handleLayout({ action: 'place', layout: 'place three', scene: 'Cave', shift: [1, 2], items: [{ kind: 'token', actor: 'Wolf', in: 'cellar' }] });
+    const [t] = calls.find(c => c.args.action === 'place')!.args.objects;
+    expect(t.x).toBeGreaterThanOrEqual(17);
+    expect(t.y).toBeGreaterThanOrEqual(6);
+
+    await expect(tools.handleLayout({ action: 'place', layout: 'place three', dry_run: true, items: [{ kind: 'token', in: 'cellar' }] })).rejects.toThrow('needs actor');
+    await expect(tools.handleLayout({ action: 'place', layout: 'place three', dry_run: true, items: [{ kind: 'token', actor: 'W', in: 'attic' }] })).rejects.toThrow('No shape named');
+    await expect(tools.handleLayout({ action: 'place', layout: 'place three', dry_run: true, items: [{ kind: 'orb', in: 'cellar' }] })).rejects.toThrow('kind must be');
+    await expect(tools.handleLayout({ action: 'place', layout: 'place three', dry_run: true, items: [{ kind: 'token', actor: 'W' }] })).rejects.toThrow('"in"');
+  });
+});
+
+describe('layout lights', () => {
+  it('proposes and places torches, optionally replacing earlier ones', async () => {
+    const { tools, calls } = make();
+    await newLayout(tools, 'lights one');
+    const dry = await tools.handleLayout({ action: 'lights', layout: 'lights one', dry_run: true });
+    expect(dry.wouldPlace).toBeGreaterThanOrEqual(3);
+
+    const result = await tools.handleLayout({ action: 'lights', layout: 'lights one', scene: 'Cave', replace: true, color: '#ff9900' });
+    expect(result.placed).toBe(dry.wouldPlace);
+    const remove = calls.find(c => c.args.action === 'remove')!;
+    expect(remove.args).toMatchObject({ kind: 'light', all_mine: true, scene: 'Cave' });
+    const objects = calls.find(c => c.args.action === 'place')!.args.objects;
+    expect(objects[0]).toMatchObject({ kind: 'light', color: '#ff9900', animation: 'torch' });
+  });
+
+  it('says when nothing is big enough', async () => {
+    const { tools } = make();
+    await newLayout(tools, 'lights two', [{ shape: 'room', at: [2, 2], size: [2, 2] }]);
+    await expect(tools.handleLayout({ action: 'lights', layout: 'lights two' })).rejects.toThrow('big enough');
+  });
+});
+
+describe('layout align', () => {
+  it('reads a picture file and suggests a shift', async () => {
+    const { tools } = make();
+    await newLayout(tools, 'align one', [
+      { shape: 'room', at: [3, 2], size: [8, 4] },
+      { shape: 'room', at: [3, 6], size: [3, 6] },
+      { shape: 'ellipse', center: [16, 9], radius: [3, 2] },
+    ]);
+    const doc = await (tools as any).store.load('align one');
+    const sketch = renderLayout(layoutOf(doc));
+    const file = path.join(folder, 'align-picture.png');
+    await fs.mkdir(folder, { recursive: true });
+    await fs.writeFile(file, encodePng(sketch.width, sketch.height, sketch.rgb));
+
+    const same = await tools.handleLayout({ action: 'align', layout: 'align one', image: file });
+    expect(same.shift).toEqual([0, 0]);
+    expect(same.advice).toContain('lines up');
+
+    // The same picture drawn one square to the right.
+    const shifted = new Uint8Array(sketch.rgb.length);
+    const rowBytes = sketch.width * 3;
+    const dx = 32 * 3;
+    for (let y = 0; y < sketch.height; y++) shifted.set(sketch.rgb.subarray(y * rowBytes, y * rowBytes + rowBytes - dx), y * rowBytes + dx);
+    const file2 = path.join(folder, 'align-picture-2.png');
+    await fs.writeFile(file2, encodePng(sketch.width, sketch.height, shifted));
+    const moved = await tools.handleLayout({ action: 'align', layout: 'align one', image: file2 });
+    expect(moved.shift).toEqual([1, 0]);
+    expect(moved.advice).toContain('shift [1, 0]');

+        ],
+      },
+    };
+    expect(describeExecutionError(entry)).toBe('KSampler: CUDA out of memory');
+  });
+
+  it('has a fallback', () => {
+    expect(describeExecutionError({})).toContain('unknown error');
+  });
+});
+
+// What ComfyUI sends when a checkpoint name is not in its checkpoints folder.
+const missingCheckpoint = {
+  error: {
+    type: 'prompt_outputs_failed_validation',
+    message: 'Prompt outputs failed validation',
+    details: '',
+  },
+  node_errors: {
+    '1': {
+      class_type: 'CheckpointLoaderSimple',
+      errors: [
+        {
+          type: 'value_not_in_list',
+          message: 'Value not in list',
+          details: "ckpt_name: 'dDBattlemapsSDXL10_upscaleV10.safetensors' not in []",
+        },
+      ],
+    },
+  },
+};
+
+describe('describeComfySubmitError', () => {
+  it('names the node and the missing model, and says where it must be', () => {
+    const message = describeComfySubmitError(400, missingCheckpoint, 'Request failed');
+    expect(message).toContain('ComfyUI rejected the job (HTTP 400)');
+    expect(message).toContain('CheckpointLoaderSimple (node 1)');
+    expect(message).toContain("ckpt_name: 'dDBattlemapsSDXL10_upscaleV10.safetensors' not in []");
+    expect(message).toContain('models/checkpoints');
+    expect(message).not.toContain('Request failed');
+  });
+
+  it('does not add the model hint for other problems', () => {
+    const message = describeComfySubmitError(
+      400,
+      {
+        error: { message: 'Prompt has no outputs', details: 'nothing to run' },
+      },
+      'x'
+    );
+    expect(message).toBe(
+      'ComfyUI rejected the job (HTTP 400): Prompt has no outputs (nothing to run)'
+    );
+  });
+
+  it('accepts a plain string error', () => {
+    expect(describeComfySubmitError(500, { error: 'boom' }, 'x')).toContain('boom');
+  });
+
+  it('falls back to the original message when the body has nothing useful', () => {
+    expect(describeComfySubmitError(undefined, undefined, 'connect ECONNREFUSED')).toBe(
+      'connect ECONNREFUSED'
+    );
+    expect(describeComfySubmitError(400, '<html>', 'Request failed')).toBe('Request failed');
+    expect(describeComfySubmitError(400, {}, 'Request failed')).toBe('Request failed');
+  });
+
+  it('keeps long messages short', () => {
+    const errors = Array.from({ length: 10 }, () => ({ message: 'm'.repeat(300) }));
+    const message = describeComfySubmitError(400, { node_errors: { '1': { errors } } }, 'x');
+    expect(message.length).toBeLessThanOrEqual(700);
+  });
+});
diff --git a/packages/mcp-server/src/comfyui-errors.ts b/packages/mcp-server/src/comfyui-errors.ts
new file mode 100644
index 0000000..0952b66
--- /dev/null
+++ b/packages/mcp-server/src/comfyui-errors.ts
@@ -0,0 +1,77 @@
+/**
+ * Turn ComfyUI's rejection of a job (an HTTP 400 with a JSON body) into a message that says
+ * what is wrong, such as a checkpoint that is not in the models/checkpoints folder, instead
+ * of "Request failed with status code 400".
+ */
+
+const MAX_LENGTH = 700;
+
+interface NodeError {
+  class_type?: string;
+  errors?: Array<{ type?: string; message?: string; details?: string }>;
+}
+
+/**
+ * Why a job that was accepted still failed: the messages ComfyUI keeps in its history entry
+ * (`status.messages` holds `["execution_error", {exception_message, node_type, ...}]`).
+ */
+export function describeExecutionError(entry: unknown): string {
+  const messages = (entry as any)?.status?.messages;
+  if (Array.isArray(messages)) {
+    for (const message of messages) {
+      if (Array.isArray(message) && message[0] === 'execution_error') {
+        const info = message[1] ?? {};
+        const where = info.node_type ? `${info.node_type}: ` : '';
+        const text = String(info.exception_message ?? 'unknown error').trim();
+        return `${where}${text}`.slice(0, MAX_LENGTH);
+      }
+    }
+  }
+  return 'unknown error (see the ComfyUI console)';
+}
+
+export function describeComfySubmitError(
+  status: number | undefined,
+  data: unknown,
+  fallback: string
+): string {
+  const body = (data && typeof data === 'object' ? data : {}) as {
+    error?: { message?: string; details?: string } | string;
+    node_errors?: Record<string, NodeError>;
+  };
+
+  const parts: string[] = [];
+
+  const topMessage =
+    typeof body.error === 'string' ? body.error : (body.error?.message ?? undefined);
+  const topDetails = typeof body.error === 'object' ? body.error?.details : undefined;
+  if (topMessage) parts.push(topDetails ? `${topMessage} (${topDetails})` : topMessage);
+
+  const problems: string[] = [];
+  let missingModel = false;
+  for (const [nodeId, node] of Object.entries(body.node_errors ?? {})) {
+    for (const problem of node.errors ?? []) {
+      const where = node.class_type ? `${node.class_type} (node ${nodeId})` : `node ${nodeId}`;
+      const text = [problem.message, problem.details].filter(Boolean).join(': ');
+      problems.push(`${where}: ${text}`);
+      if (
+        problem.type === 'value_not_in_list' &&
+        /(ckpt_name|vae_name|lora_name|unet_name)/.test(problem.details ?? '')
+      ) {
+        missingModel = true;
+      }
+    }
+  }
+  if (problems.length) parts.push(problems.slice(0, 4).join('; '));
+
+  let message = parts.length
+    ? `ComfyUI rejected the job${status ? ` (HTTP ${status})` : ''}: ${parts.join(' - ')}`
+    : fallback;
+
+  if (missingModel) {
+    message +=
+      ' | A model file is not where this ComfyUI looks. The checkpoint must be in ComfyUI/models/checkpoints and the VAE in models/vae (not diffusion_models), then refresh or restart ComfyUI.';
+  }
+
+  return message.length > MAX_LENGTH ? `${message.slice(0, MAX_LENGTH - 1)}…` : message;
+}

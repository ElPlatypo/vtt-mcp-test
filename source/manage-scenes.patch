@@ -0,0 +1,119 @@
+/** Combat control helpers: picking tokens and combatants by plain description, and a short readout of the encounter. */
+import { MODULE_ID } from './constants.js';
+
+/**
+ * A token can show the players one name ("Goblin Leader") while the GM still finds it by another ("Yeemik"): the real
+ * name is a GM-only flag on the token, set by update-token real_name.
+ */
+export function tokenRealName(token: any): string | undefined {
+  try {
+    const v = token?.getFlag?.(MODULE_ID, 'realName') ?? token?.flags?.[MODULE_ID]?.realName;
+    return typeof v === 'string' && v.trim() ? v.trim() : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+export interface TokenLike {
+  id: string;
+  name?: string;
+  actorName?: string;
+  /** the GM-only real name of the token, when the players are shown another */
+  realName?: string | undefined;
+  /** -1 hostile, 0 neutral, 1 friendly, 2 secret */
+  disposition?: number;
+  /** a player character (owned by a non-GM player) */
+  player?: boolean;
+}
+
+const lower = (s: unknown) => String(s ?? '').trim().toLowerCase();
+
+/**
+ * Tokens a request means: "all", "hostile", "friendly", "neutral", "players", "npcs", or a name
+ * (token or actor name; exact first, else part of a name). Several can be given.
+ */
+export function pickTokens(tokens: TokenLike[], who: string[]): { picked: TokenLike[]; notFound: string[] } {
+  const picked = new Map<string, TokenLike>();
+  const notFound: string[] = [];
+  for (const spec of who) {
+    const key = lower(spec);
+    let hits: TokenLike[];
+    if (key === 'all') hits = tokens;
+    else if (key === 'hostile') hits = tokens.filter(t => t.disposition === -1);
+    else if (key === 'friendly') hits = tokens.filter(t => t.disposition === 1);
+    else if (key === 'neutral') hits = tokens.filter(t => t.disposition === 0);
+    else if (key === 'players') hits = tokens.filter(t => t.player);
+    else if (key === 'npcs') hits = tokens.filter(t => !t.player);
+    else {
+      const byId = tokens.filter(t => t.id === spec);
+      const exact = tokens.filter(t => lower(t.name) === key);
+      const exactActor = tokens.filter(t => lower(t.actorName) === key);
+      const exactReal = tokens.filter(t => t.realName && lower(t.realName) === key);
+      const part = tokens.filter(t => lower(t.name).includes(key) || lower(t.actorName).includes(key) || (t.realName && lower(t.realName).includes(key)));
+      hits = byId.length ? byId : exact.length ? exact : exactReal.length ? exactReal : exactActor.length ? exactActor : part;
+    }
+    if (hits.length === 0) notFound.push(spec);
+    for (const t of hits) picked.set(t.id, t);
+  }
+  return { picked: [...picked.values()], notFound };
+}
+
+export interface CombatantLike {
+  id: string;
+  name?: string;
+  tokenId?: string;
+  actorName?: string;
+  realName?: string | undefined;
+  defeated?: boolean;
+  initiative?: number | null;
+}
+
+/** The combatants a name means: exact name, else part of a name or the actor name. */
+export function matchCombatants<T extends CombatantLike>(combatants: T[], name: string): T[] {
+  const key = lower(name);
+  const byId = combatants.filter(c => c.id === name || c.tokenId === name);
+  if (byId.length) return byId;
+  const exact = combatants.filter(c => lower(c.name) === key);
+  if (exact.length) return exact;
+  const exactReal = combatants.filter(c => c.realName && lower(c.realName) === key);
+  if (exactReal.length) return exactReal;
+  return combatants.filter(c => lower(c.name).includes(key) || lower(c.actorName).includes(key) || (c.realName && lower(c.realName).includes(key)));
+}
+
+/** One short line per combatant, in turn order, with the active one marked. */
+export function compactCombat(combat: any): Record<string, any> | null {
+  if (!combat) return null;
+  const turns = ((combat.turns ?? combat.combatants?.contents ?? []) as any[]).slice();
+  const started = !!combat.started;
+  const lines = turns.map((c, index) => {
+    const hp = c.actor?.system?.attributes?.hp;
+    const parts = [
+      index === combat.turn && started ? '>' : ' ',
+      c.initiative === null || c.initiative === undefined ? '--' : String(c.initiative),
+      tokenRealName(c.token) ? `${c.name ?? '?'} [${tokenRealName(c.token)}]` : c.name ?? '?',
+    ];
+    if (hp && hp.value !== undefined) parts.push(`hp ${hp.value}${hp.max !== undefined ? '/' + hp.max : ''}${hp.temp ? '+' + hp.temp : ''}`);
+    let statuses: string[] = c.actor?.statuses ? [...c.actor.statuses] : [];
+    // dnd5e adds and removes Bloodied in a hook that runs after the hit point update, so right
+    // after damage or healing the status set is stale: derive it from the hit points instead.
+    const hpValue = Number(hp?.value);
+    const hpMax = Number(hp?.max);
+    if (Number.isFinite(hpValue) && Number.isFinite(hpMax) && hpMax > 0) {
+      const bloodied = hpValue > 0 && hpValue <= hpMax / 2;
+      const tracksBloodied = statuses.includes('bloodied') || (globalThis as any).game?.system?.id === 'dnd5e';
+      statuses = statuses.filter(s => s !== 'bloodied');
+      if (bloodied && tracksBloodied) statuses.push('bloodied');
+    }
+    if (statuses.length) parts.push(`[${statuses.join(', ')}]`);
+    if (c.defeated) parts.push('(defeated)');
+    if (c.hidden) parts.push('(hidden)');
+    return parts.join(' ').trim();
+  });
+  const current = combat.combatant ?? turns[combat.turn ?? -1];
+  return {
+    started,
+    round: combat.round ?? 0,
+    ...(started && current ? { turn: current.name } : {}),
+    order: lines,
+  };
+}

+++ b/packages/foundry-module/src/module-utils.ts
@@ -0,0 +1,236 @@
+/**
+ * Helpers for manage-modules: turning Foundry values into something JSON can carry, checking the
+ * path of a module API call, and planning which modules to switch on or off. Pure functions, so
+ * they can be tested without Foundry.
+ */
+
+const MAX_DEPTH = 4;
+const MAX_ITEMS = 100;
+const MAX_STRING = 2000;
+
+const BLOCKED_SEGMENTS = new Set(['__proto__', 'prototype', 'constructor', 'eval', '__defineGetter__', '__defineSetter__', '__lookupGetter__', '__lookupSetter__']);
+const SEGMENT = /^[A-Za-z_$][A-Za-z0-9_$]*$/;
+export const MAX_PATH_SEGMENTS = 6;
+
+/** Split and check a path such as "api.getByTag"; throws a readable error for anything unsafe. */
+export function parseApiPath(path: unknown): string[] {
+  if (typeof path !== 'string' || path.trim() === '') throw new Error('path is required (for example "getByTag")');
+  const parts = path.trim().replace(/^api\./, '').split('.');
+  if (parts.length > MAX_PATH_SEGMENTS) throw new Error(`path may have at most ${MAX_PATH_SEGMENTS} parts`);
+  for (const part of parts) {
+    if (!SEGMENT.test(part)) throw new Error(`"${part}" is not a valid name in the path`);
+    if (BLOCKED_SEGMENTS.has(part)) throw new Error(`"${part}" is not allowed in a path`);
+  }
+  return parts;
+}
+
+/** Walk a path below `root` and return the function and the object to call it on. */
+export function resolveApiFunction(root: any, path: unknown): { fn: (...args: any[]) => any; self: any; name: string } {
+  const parts = parseApiPath(path);
+  let self: any = root;
+  let value: any = root;
+  for (const part of parts) {
+    if (value === null || value === undefined || (typeof value !== 'object' && typeof value !== 'function')) {
+      throw new Error(`"${part}" cannot be looked up: the part before it is not an object`);
+    }
+    self = value;
+    value = value[part];
+  }
+  if (typeof value !== 'function') throw new Error(`"${parts.join('.')}" is not a function in the module API`);
+  return { fn: value, self, name: parts.join('.') };
+}
+
+function isDocument(value: any): boolean {
+  return Boolean(value) && typeof value === 'object' && typeof value.documentName === 'string' && 'id' in value;
+}
+
+/**
+ * Make a value safe to send as JSON: documents become {documentName, id, uuid, name}, maps and
+ * sets become lists, functions become their names, depth, length and cycles are limited.
+ */
+export function serializeValue(value: unknown, depth = 0, seen: WeakSet<object> = new WeakSet()): unknown {
+  if (value === null || value === undefined) return null;
+  const type = typeof value;
+  if (type === 'string') {
+    const s = value as string;
+    return s.length > MAX_STRING ? `${s.slice(0, MAX_STRING)}... (${s.length} characters)` : s;
+  }
+  if (type === 'number') return Number.isFinite(value as number) ? value : String(value);
+  if (type === 'boolean') return value;
+  if (type === 'bigint') return String(value);
+  if (type === 'symbol') return String(value);
+  if (type === 'function') return `[function ${(value as Function).name || 'anonymous'}]`;
+
+  const obj = value as any;
+  if (isDocument(obj)) {
+    return { documentName: obj.documentName, id: obj.id, uuid: obj.uuid ?? null, name: obj.name ?? null };
+  }
+  // A canvas object (token, tile, wall...) stands for its document.
+  if (obj.document && isDocument(obj.document)) return serializeValue(obj.document, depth, seen);
+  if (seen.has(obj)) return '[circular]';
+  if (depth >= MAX_DEPTH) return Array.isArray(obj) ? `[array of ${obj.length}]` : '[object]';
+  seen.add(obj);
+  try {
+    if (obj instanceof Date) return obj.toISOString();
+    if (obj instanceof Map || obj instanceof Set || (typeof obj.contents !== 'undefined' && Array.isArray(obj.contents))) {
+      const items: unknown[] = obj instanceof Map ? [...obj.values()] : obj instanceof Set ? [...obj] : obj.contents;
+      return limitList(items, depth, seen);
+    }
+    if (Array.isArray(obj)) return limitList(obj, depth, seen);
+    const out: Record<string, unknown> = {};
+    let count = 0;
+    for (const key of Object.keys(obj)) {
+      if (count++ >= MAX_ITEMS) {
+        out['...'] = `${Object.keys(obj).length - MAX_ITEMS} more keys`;
+        break;
+      }
+      let child: unknown;
+      try {
+        child = obj[key];
+      } catch {
+        child = '[unreadable]';
+      }
+      out[key] = serializeValue(child, depth + 1, seen);
+    }
+    return out;
+  } finally {
+    seen.delete(obj);
+  }
+}
+
+function limitList(items: unknown[], depth: number, seen: WeakSet<object>): unknown[] {
+  const out = items.slice(0, MAX_ITEMS).map(item => serializeValue(item, depth + 1, seen));
+  if (items.length > MAX_ITEMS) out.push(`... ${items.length - MAX_ITEMS} more`);
+  return out;
+}
+
+/** The ids in a relationship list (a Set, an array of ids or of {id} objects). */
+export function relationIds(value: any): string[] {
+  if (!value) return [];
+  const list: any[] = Array.isArray(value) ? value : value instanceof Set || value instanceof Map ? [...(value instanceof Map ? value.values() : value)] : Array.isArray(value.contents) ? value.contents : [];
+  return list
+    .map(item => (typeof item === 'string' ? item : item?.id))
+    .filter((id): id is string => typeof id === 'string' && id.length > 0);
+}
+
+/** Names of the entries in a module API: functions, nested objects (listed one level down) and plain values. */
+export function describeApi(api: any): Array<{ name: string; kind: 'function' | 'object' | 'value'; members?: string[] }> | null {
+  if (!api || (typeof api !== 'object' && typeof api !== 'function')) return null;
+  const out: Array<{ name: string; kind: 'function' | 'object' | 'value'; members?: string[] }> = [];
+  const keys = new Set<string>(Object.keys(api));
+  // Methods of a class instance live on the prototype.
+  let proto = Object.getPrototypeOf(api);
+  let guard = 0;
+  while (proto && proto !== Object.prototype && proto !== Function.prototype && guard++ < 4) {
+    for (const key of Object.getOwnPropertyNames(proto)) if (key !== 'constructor') keys.add(key);
+    proto = Object.getPrototypeOf(proto);
+  }
+  for (const name of [...keys].sort().slice(0, 200)) {
+    if (BLOCKED_SEGMENTS.has(name) || name.startsWith('_')) continue;
+    let value: any;
+    try {
+      value = api[name];
+    } catch {
+      continue;
+    }
+    if (typeof value === 'function') out.push({ name, kind: 'function' });
+    else if (value && typeof value === 'object') {
+      out.push({ name, kind: 'object', members: Object.keys(value).filter(k => !k.startsWith('_')).slice(0, 40) });
+    } else out.push({ name, kind: 'value' });
+  }
+  return out;
+}
+
+export interface ModuleNode {
+  id: string;
+  active: boolean;
+  /** Ids of modules it needs. */
+  requires: string[];
+  /** Ids of modules it cannot run next to. */
+  conflicts: string[];
+  /** Whether it is installed. Unknown ids that are required are reported as missing. */
+  installed?: boolean;
+}
+
+export interface TogglePlan {
+  ok: boolean;
+  /** Modules whose state changes, in the order to apply them. */
+  change: Array<{ id: string; active: boolean; reason: string }>;
+  /** Already in the wanted state. */
+  unchanged: string[];
+  problems: string[];
+}
+
+/**
+ * Work out what switching modules on or off involves. Switching on adds the modules they need
+ * (when installed) and refuses when something that conflicts is active. Switching off adds the
+ * active modules that depend on them.
+ */
+export function planModuleToggle(nodes: ModuleNode[], ids: string[], active: boolean, protectedIds: string[] = []): TogglePlan {
+  const byId = new Map(nodes.map(n => [n.id, n]));
+  const change: TogglePlan['change'] = [];
+  const unchanged: string[] = [];
+  const problems: string[] = [];
+  const queued = new Set<string>();
+  const state = new Map(nodes.map(n => [n.id, n.active]));
+
+  const enable = (id: string, reason: string, stack: string[]) => {
+    if (queued.has(id)) return;
+    const node = byId.get(id);
+    if (!node) {
+      problems.push(`"${id}" is not installed`);
+      return;
+    }
+    if (stack.includes(id)) return;
+    if (state.get(id)) {
+      if (stack.length === 0) unchanged.push(id);
+      return;
+    }
+    for (const need of node.requires) enable(need, `needed by ${id}`, [...stack, id]);
+    queued.add(id);
+    state.set(id, true);
+    change.push({ id, active: true, reason });
+  };
+
+  const disable = (id: string, reason: string) => {
+    if (queued.has(id)) return;
+    const node = byId.get(id);
+    if (!node) {
+      problems.push(`"${id}" is not installed`);
+      return;
+    }
+    if (protectedIds.includes(id)) {
+      problems.push(`"${id}" is the connection to this tool and cannot be switched off from here`);
+      return;
+    }
+    if (!state.get(id)) {
+      if (reason === 'requested') unchanged.push(id);
+      return;
+    }
+    for (const other of nodes) {
+      if (state.get(other.id) && other.requires.includes(id)) disable(other.id, `needs ${id}`);
+    }
+    queued.add(id);
+    state.set(id, false);
+    change.push({ id, active: false, reason });
+  };
+
+  for (const id of ids) {
+    if (active) enable(id, 'requested', []);
+    else disable(id, 'requested');
+  }
+
+  if (active) {
+    // Conflicts between what ends up active.
+    for (const { id } of change) {
+      const node = byId.get(id)!;
+      for (const other of nodes) {
+        const clash = node.conflicts.includes(other.id) || other.conflicts.includes(id);
+        if (clash && state.get(other.id) && other.id !== id) {
+          problems.push(`"${id}" conflicts with "${other.id}", which is active`);
+        }
+      }
+    }
+  }
+  return { ok: problems.length === 0, change, unchanged, problems };
+}

+import { afterAll, describe, expect, it, vi } from 'vitest';
+import { promises as fs } from 'fs';
+import os from 'os';
+import path from 'path';
+import { PNG } from 'pngjs';
+import { ImageEditTools } from './image-edit-tools.js';
+
+const tmp: string[] = [];
+afterAll(async () => {
+  for (const f of tmp) await fs.rm(f, { force: true });
+});
+
+function pngBuffer(w: number, h: number, rgb: [number, number, number]): Buffer {
+  const png = new PNG({ width: w, height: h });
+  for (let i = 0; i < w * h; i++) png.data.set([rgb[0], rgb[1], rgb[2], 255], i * 4);
+  return PNG.sync.write(png);
+}
+async function pngFile(w: number, h: number, rgb: [number, number, number]): Promise<string> {
+  const file = path.join(os.tmpdir(), `edit-test-${Date.now()}-${Math.random().toString(36).slice(2)}.png`);
+  await fs.writeFile(file, pngBuffer(w, h, rgb));
+  tmp.push(file);
+  return file;
+}
+const pixelAt = (buf: Buffer, x: number, y: number) => {
+  const png = PNG.sync.read(buf);
+  return [...png.data.slice((y * png.width + x) * 4, (y * png.width + x) * 4 + 3)];
+};
+
+/** A scene 20 x 10 squares with a 200 x 100 map (10 px per square). */
+async function make(options: { note?: any } = {}) {
+  const edited = await pngFile(200, 100, [250, 0, 0]);
+  const generate = vi.fn(async (_a: any) => ({ success: true, local_path: edited, seed: 5 }));
+  const upload = vi.fn(async (a: any) => ({ success: true, path: `worlds/w/uploads/${a.folder}/${a.filename}` }));
+  const calls: Array<{ method: string; data: any }> = [];
+  const query = vi.fn(async (method: string, data: any) => {
+    calls.push({ method, data });
+    switch (method) {
+      case 'foundry-mcp-bridge.manage-scenes':
+        if (data.action === 'describe') {
+          return { success: true, scene: { id: 's1', name: 'Hall', background: 'worlds/w/uploads/maps/hall.png', width: 1280, height: 640, grid: { size: 64 } } };
+        }
+        return { success: true };
+      case 'foundry-mcp-bridge.read-image-file':
+        return { success: true, imageData: pngBuffer(200, 100, [0, 0, 255]).toString('base64') };
+      case 'foundry-mcp-bridge.annotations':
+        if (data.action === 'list') return { success: true, notes: options.note ? [options.note] : [] };
+        return { success: true, changed: data.ids };
+      case 'foundry-mcp-bridge.manage-scene-backups':
+        return { success: true, backup: { id: 'b1', name: 'Hall (old)' } };
+      default:
+        return { success: true };
+    }
+  });
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  const tools = new ImageEditTools({ foundryClient: { query } as any, logger, generate, upload });
+  return { tools, generate, upload, query, calls };
+}
+
+describe('definition', () => {
+  it('is exposed with action required', async () => {
+    const def = (await make()).tools.getToolDefinitions()[0]!;
+    expect(def.name).toBe('edit-image-area');
+    expect(def.inputSchema.required).toEqual(['action']);
+  });
+});
+
+describe('edit-image-area edit', () => {
+  it('edits a scene map: outlines the area, asks H3, pastes only the area back and previews it', async () => {
+    const { tools, generate } = await make();
+    const r = await tools.handle({ action: 'edit', scene: 'Hall', area: { rect: [2, 2, 6, 4] }, prompt: 'add a wooden door', seed: 3 });
+    expect(r).toMatchObject({ success: true, scene: { name: 'Hall' }, size: '200x100', areaPixels: 60 * 40 });
+    const call = generate.mock.calls[0]![0];
+    expect(call).toMatchObject({ kind: 'map', upload: false, width: 256, height: 256, seed: 3 });
+    expect(call.prompt).toContain('inside the area marked by the red outline: add a wooden door');
+    // the reference is the whole map with a red outline
+    tmp.push(call.reference_images[0]);
+    const ref = await fs.readFile(call.reference_images[0]);
+    expect(pixelAt(ref, 40, 20)).toEqual([255, 0, 0]); // on the outline (x = 2 squares = 20 px.. y = 20)
+    expect(pixelAt(ref, 150, 80)).toEqual([0, 0, 255]); // untouched map
+    // the composite: edit inside the area, the original map everywhere else
+    tmp.push(r.picture, r.preview);
+    const composite = await fs.readFile(r.picture);
+    expect(pixelAt(composite, 50, 40)).toEqual([250, 0, 0]);
+    expect(pixelAt(composite, 150, 80)).toEqual([0, 0, 255]);
+    expect(pixelAt(composite, 5, 5)).toEqual([0, 0, 255]);
+    expect((await fs.stat(r.preview)).size).toBeGreaterThan(0);
+  });
+  it('uses the area and text of a note', async () => {
+    const note = { id: 'n1', scene: { id: 's1', name: 'Hall' }, prompt: 'open a door here', area: { shape: 'rect', points: [[2, 2], [8, 2], [8, 6], [2, 6]] } };
+    const { tools, generate } = await make({ note });
+    const r = await tools.handle({ action: 'edit', annotation: 'n1' });
+    expect(r).toMatchObject({ success: true, annotation: 'n1' });
+    expect(generate.mock.calls[0]![0].prompt).toContain('open a door here');
+    tmp.push(r.picture, r.preview);
+  });
+  it('edits a Foundry image or a local file by percent', async () => {
+    const { tools, query } = await make();
+    const r = await tools.handle({ action: 'edit', image: 'worlds/w/uploads/actors/bob/portrait.png', area: { rect: [10, 10, 50, 50] }, prompt: 'a scar on the left cheek' });
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.read-image-file', { path: 'worlds/w/uploads/actors/bob/portrait.png' }, 60000);
+    expect(r.areaPixels).toBe(100 * 50);
+    tmp.push(r.picture, r.preview);
+    const local = await pngFile(200, 100, [10, 10, 10]);
+    const r2 = await tools.handle({ action: 'edit', image: local, area: { polygon: [[0, 0], [50, 0], [50, 50]], units: 'percent' }, prompt: 'a red gem' });
+    expect(r2.success).toBe(true);
+    tmp.push(r2.picture, r2.preview);
+  });
+  it('refuses unclear or incomplete requests', async () => {
+    const { tools } = await make({ note: { id: 'obj', scene: { id: 's1', name: 'Hall' }, prompt: 'x', target: { kind: 'token' } } });
+    await expect(tools.handle({ action: 'edit', prompt: 'something' })).rejects.toThrow('exactly one');
+    await expect(tools.handle({ action: 'edit', scene: 'Hall', image: 'a.png', prompt: 'x y z' })).rejects.toThrow('exactly one');
+    await expect(tools.handle({ action: 'edit', scene: 'Hall', prompt: 'add a door' })).rejects.toThrow('area');
+    await expect(tools.handle({ action: 'edit', scene: 'Hall', area: { rect: [1, 1, 3, 3] } })).rejects.toThrow('what to change');
+    await expect(tools.handle({ action: 'edit', annotation: 'missing' })).rejects.toThrow('Note not found');
+    await expect(tools.handle({ action: 'edit', annotation: 'obj', prompt: 'new picture' })).rejects.toThrow('object, not an area');
+    await expect(tools.handle({ action: 'edit', scene: 'Hall', area: { rect: [1, 1, 3, 3] }, prompt: 'ab' })).rejects.toThrow();
+  });
+  it('reports a failed generation', async () => {
+    const { tools, generate } = await make();
+    generate.mockResolvedValueOnce({ success: false, error: 'ComfyUI is offline' });
+    await expect(tools.handle({ action: 'edit', scene: 'Hall', area: { rect: [1, 1, 4, 4] }, prompt: 'add a door' })).rejects.toThrow('ComfyUI is offline');
+  });
+});
+
+describe('edit-image-area commit', () => {
+  it('backs the scene up, uploads next to the original, sets the map and marks the note done', async () => {
+    const note = { id: 'n1', scene: { id: 's1', name: 'Hall' }, prompt: 'open a door', area: { shape: 'rect', points: [[2, 2], [8, 2], [8, 6], [2, 6]] } };
+    const { tools, upload, calls } = await make({ note });
+    const edit = await tools.handle({ action: 'edit', annotation: 'n1' });
+    tmp.push(edit.picture, edit.preview);
+    const r = await tools.handle({ action: 'commit', result: edit.result, reply: 'Door added' });
+    expect(r).toMatchObject({ success: true, scene: { id: 's1' }, noteResolved: 'n1' });
+    expect(r.path).toMatch(/^worlds\/w\/uploads\/maps\/hall-edit-[a-z0-9]+\.png$/);
+    expect(upload).toHaveBeenCalledWith(expect.objectContaining({ folder: 'maps' }));
+    const methods = calls.map(c => c.method.replace('foundry-mcp-bridge.', '') + ':' + (c.data.action ?? ''));
+    expect(methods.indexOf('manage-scene-backups:backup')).toBeLessThan(methods.indexOf('manage-scenes:update'));
+    expect(calls.find(c => c.data.action === 'update')!.data).toMatchObject({ scene_identifier: 's1', background: r.path });
+    expect(calls.find(c => c.data.action === 'resolve')!.data).toMatchObject({ ids: ['n1'], status: 'done', reply: 'Door added' });
+    await expect(tools.handle({ action: 'commit', result: edit.result })).rejects.toThrow('Unknown result');
+  });
+  it('can skip the backup and the note, and only upload for non-scene pictures', async () => {
+    const { tools, calls } = await make();
+    const edit = await tools.handle({ action: 'edit', scene: 'Hall', area: { rect: [1, 1, 4, 4] }, prompt: 'add a door' });
+    tmp.push(edit.picture, edit.preview);
+    await tools.handle({ action: 'commit', result: edit.result, backup: false });
+    expect(calls.some(c => c.method.endsWith('manage-scene-backups'))).toBe(false);
+    const img = await tools.handle({ action: 'edit', image: 'worlds/w/uploads/actors/bob/portrait.png', area: { rect: [10, 10, 50, 50] }, prompt: 'a scar on the cheek' });
+    tmp.push(img.picture, img.preview);
+    const r = await tools.handle({ action: 'commit', result: img.result });
+    expect(r.path).toMatch(/^worlds\/w\/uploads\/actors\/bob\/portrait-edit-[a-z0-9]+\.png$/);
+    expect(r.scene).toBeUndefined();
+    const img2 = await tools.handle({ action: 'edit', image: 'worlds/w/uploads/x/y.png', area: { rect: [10, 10, 50, 50] }, prompt: 'a scar on the cheek' });
+    tmp.push(img2.picture, img2.preview);
+    await expect(tools.handle({ action: 'commit', result: img2.result, apply: 'scene' })).rejects.toThrow('apply file');
+  });
+});
diff --git a/packages/mcp-server/src/tools/image-edit-tools.ts b/packages/mcp-server/src/tools/image-edit-tools.ts

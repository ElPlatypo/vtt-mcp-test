+/** browse-files and scene backups with Foundry stubbed. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+
+const MODULE = 'foundry-mcp-bridge-scenes';
+
+// ---------- browse-files ----------
+
+const TREE: Record<string, { dirs: string[]; files: string[] }> = {
+  '': { dirs: ['worlds', 'modules'], files: [] },
+  worlds: { dirs: ['worlds/w1', 'worlds/w2'], files: [] },
+  'worlds/w1': { dirs: ['worlds/w1/uploads'], files: ['worlds/w1/world.json'] },
+  'worlds/w1/uploads': { dirs: [], files: ['worlds/w1/uploads/cave%20drip.mp3', 'worlds/w1/uploads/map.png', 'worlds/w1/uploads/notes.txt'] },
+  'worlds/w2': { dirs: [], files: ['worlds/w2/theme.ogg'] },
+  modules: { dirs: [], files: [] },
+};
+
+function setupBrowse() {
+  const browse = vi.fn(async (_source: string, dir: string) => {
+    const entry = TREE[dir];
+    if (!entry) throw new Error('directory does not exist');
+    return entry;
+  });
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('FilePicker', { browse });
+  vi.stubGlobal('game', { ready: true, world: { id: 'w1', getFlag: vi.fn(() => []), setFlag: vi.fn() }, user: { id: 'gm', name: 'GM' }, settings: { get: () => true } });
+  return { da: new FoundryDataAccess(), browse };
+}
+
+describe('browseFiles', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('lists one folder', async () => {
+    const { da, browse } = setupBrowse();
+    const r = await da.browseFiles({});
+    expect(browse).toHaveBeenCalledWith('data', '', {});
+    expect(r.folders.map((f: any) => f.path)).toEqual(['modules', 'worlds']);
+    expect(r.path).toBe('/');
+    expect(r.files).toEqual([]);
+  });
+
+  it('looks into subfolders and filters audio, decoding the names', async () => {
+    const { da } = setupBrowse();
+    const r = await da.browseFiles({ path: 'worlds', depth: 2, kind: 'audio' });
+    expect(r.files.map((f: any) => f.path)).toEqual(['worlds/w1/uploads/cave drip.mp3', 'worlds/w2/theme.ogg']);
+    expect(r.counts).toEqual({ audio: 2, image: 0, video: 0, other: 0 });
+    expect(r.folders.map((f: any) => f.name)).toContain('uploads');
+  });
+
+  it('searches and limits, saying when there is more', async () => {
+    const { da } = setupBrowse();
+    const found = await da.browseFiles({ path: 'worlds/w1/uploads', search: 'MAP' });
+    expect(found.files.map((f: any) => f.name)).toEqual(['map.png']);
+    const limited = await da.browseFiles({ path: 'worlds/w1/uploads', limit: 2 });
+    expect(limited.files).toHaveLength(2);
+    expect(limited.truncated).toBe(true);
+  });
+
+  it('refuses bad input and says when a folder is missing', async () => {
+    const { da } = setupBrowse();
+    await expect(da.browseFiles({ path: '../x' })).rejects.toThrow('.. parts');
+    await expect(da.browseFiles({ depth: 9 })).rejects.toThrow('depth');
+    await expect(da.browseFiles({ limit: 0 })).rejects.toThrow('limit');
+    await expect(da.browseFiles({ kind: 'text' as any })).rejects.toThrow('kind');

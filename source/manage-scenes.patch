+  /** Build the walls and doors and place them on the scene, in chunks Foundry accepts. */
+  private async applyWalls(doc: LayoutDoc, a: Args): Promise<any> {
+    const { walls, segments } = wallsFromLayout(layoutOf(doc));
+    if (walls.length === 0) throw new Error('The layout has nothing to put walls around yet');
+    const [dx, dy] = a.shift ?? [0, 0];
+    const placed = walls.map(w => ({
+      ...w,
+      points: w.points.map(p => [Math.round((p[0]! + dx) * 100) / 100, Math.round((p[1]! + dy) * 100) / 100]),
+    }));
+    const doors = placed.filter(w => w.preset).length;
+    const plan = { walls: placed.length - doors, doors, segments };
+    if (a.dry_run) return { success: true, layout: doc.id, dryRun: true, ...plan };
+
+    const client = this.foundryClient;
+    if (!client) throw new Error('apply_walls needs the connection to Foundry, which is not available here');
+
+    const scene = a.scene;
+    const described = await client.query('foundry-mcp-bridge.manage-scene-objects', {
+      action: 'describe',
+      kind: 'wall',
+      ...(scene ? { scene } : {}),
+    });
+    if (described?.success === false) throw new Error(described.error || 'Could not read the scene');
+    const grid = described?.grid;
+    if (grid && (grid.columns !== doc.columns || grid.rows !== doc.rows)) {
+      throw new Error(
+        `The scene "${described.scene?.name}" is ${grid.columns} x ${grid.rows} squares but the layout is ${doc.columns} x ${doc.rows}. Set the scene grid so the generated map has the same squares (manage-scenes grid_size, width and height), or use another scene.`
+      );
+    }
+
+    let removed = 0;
+    if (a.replace !== false) {
+      const out = await client.query('foundry-mcp-bridge.manage-scene-objects', {
+        action: 'remove',
+        kind: 'wall',
+        all_mine: true,
+        ...(scene ? { scene } : {}),
+      });
+      if (out?.success === false) throw new Error(out.error || 'Could not remove the old walls');
+      removed = out?.removed?.length ?? 0;
+    }

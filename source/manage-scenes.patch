index 0000000..8a21b3a
--- /dev/null
+++ b/packages/mcp-server/src/tools/prop-enclosed.test.ts
@@ -0,0 +1,65 @@
+/** Background pockets that do not touch the border (the loop of a handle) are removed on request. */
+import { describe, expect, it } from 'vitest';
+import { keyOutBackground, type Pixels } from './prop-keying.js';
+
+const MAGENTA = [255, 0, 255];
+const BROWN = [120, 80, 40];
+
+/** 100 x 100 magenta picture with a brown frame (a ring) and a magenta hole inside it. */
+function ring(hole: number, speck = false): Pixels {
+  const w = 100;
+  const data = new Uint8Array(w * w * 4);
+  for (let y = 0; y < w; y++) {
+    for (let x = 0; x < w; x++) {
+      const i = (y * w + x) * 4;
+      const inFrame = x >= 20 && x < 80 && y >= 20 && y < 80;
+      const inHole = x >= 50 - hole / 2 && x < 50 + hole / 2 && y >= 50 - hole / 2 && y < 50 + hole / 2;
+      const c = inFrame && !inHole ? BROWN : MAGENTA;
+      data.set([c[0]!, c[1]!, c[2]!, 255], i);
+    }
+  }
+  if (speck) data.set([255, 0, 255, 255], (30 * w + 30) * 4); // a one pixel speck inside the frame
+  return { width: w, height: w, data };
+}
+const alphaAt = (img: Pixels, x: number, y: number) => img.data[(y * img.width + x) * 4 + 3];
+
+describe('removeEnclosed', () => {
+  it('keeps an enclosed pocket by default', () => {
+    const out = keyOutBackground(ring(20), { crop: false });
+    expect(alphaAt(out, 50, 50)).toBe(255);
+  });
+  it('removes it when asked, and leaves the object around it', () => {
+    const out = keyOutBackground(ring(20), { crop: false, removeEnclosed: true });
+    expect(alphaAt(out, 50, 50)).toBe(0);
+    expect(alphaAt(out, 30, 30)).toBe(255);
+    expect(alphaAt(out, 5, 5)).toBe(0);
+    expect(out.opaqueShare).toBeCloseTo((60 * 60 - 20 * 20) / 10000, 2);
+  });
+  it('leaves specks that are too small to be a pocket', () => {
+    const out = keyOutBackground(ring(0, true), { crop: false, removeEnclosed: true });
+    expect(alphaAt(out, 30, 30)).toBe(255);
+  });
+  it('does not remove anything that is far from the background colour', () => {
+    const img = ring(20);
+    // paint the hole green instead: not the key colour, so it stays
+    for (let y = 40; y < 60; y++) for (let x = 40; x < 60; x++) img.data.set([0, 200, 0, 255], (y * 100 + x) * 4);
+    const out = keyOutBackground(img, { crop: false, removeEnclosed: true });
+    expect(alphaAt(out, 50, 50)).toBe(255);
+  });
+});
+
+describe('magenta despill', () => {
+  it('turns a small pink speck next to the removed background neutral, and leaves distant colours alone', () => {
+    const img = ring(0);
+    const w = img.width;
+    // a pink speck on the brown frame, right next to the outside
+    img.data.set([230, 60, 220, 255], (50 * w + 21) * 4);
+    // the same pink deep inside the frame, far from the background
+    img.data.set([230, 60, 220, 255], (50 * w + 50) * 4);
+    const out = keyOutBackground(img, { crop: false });
+    const at = (x: number, y: number) => [0, 1, 2].map(c => out.data[(y * w + x) * 4 + c]!);
+    const near = at(21, 50);
+    expect(Math.min(near[0]!, near[2]!) - near[1]!).toBeLessThan(25);
+    expect(at(50, 50)).toEqual([230, 60, 220]);
+  });
+});
diff --git a/packages/mcp-server/src/tools/prop-keying.ts b/packages/mcp-server/src/tools/prop-keying.ts
new file mode 100644
index 0000000..767a319
--- /dev/null
+++ b/packages/mcp-server/src/tools/prop-keying.ts
@@ -0,0 +1,330 @@
+/**
+ * Turns a picture of an object on a flat coloured background into a picture with a transparent
+ * background (a prop that can be laid on a map as a tile). Pure pixel work, no files.
+ *
+ * The background colour is read from the picture's border. Only background that touches the
+ * border is removed, so a part of the object that happens to have the same colour is kept.
+ */
+
+export interface Pixels {
+  width: number;
+  height: number;
+  /** RGBA, 4 bytes per pixel */
+  data: Uint8Array;
+}
+
+export interface KeyOptions {
+  /** Colour distance (0-441) up to which a pixel is fully background. Default 60. */
+  tolerance?: number;
+  /** Extra transparent pixels kept around the object after cropping. Default 2. */
+  padding?: number;
+  /** Crop to the object (default true). */
+  crop?: boolean;
+  /**
+   * Also remove pockets of background that do not touch the border (the loop of a handle, the gap
+   * in a ring) when they match the background colour closely. Default false. Only pockets of a few
+   * dozen pixels or more go, so specks inside the object stay.
+   */
+  removeEnclosed?: boolean;
+}
+
+export interface KeyResult extends Pixels {
+  background: [number, number, number];
+  /** Share of the picture that is left opaque (0 to 1). */
+  opaqueShare: number;
+  /** How much the border colour varies; high means the background was not flat. */
+  borderSpread: number;
+  /** Box of the object in the original picture. */
+  box: { x: number; y: number; width: number; height: number };
+  warnings: string[];
+}
+
+const dist = (data: Uint8Array, i: number, bg: number[]): number => {
+  const dr = data[i]! - bg[0]!;
+  const dg = data[i + 1]! - bg[1]!;
+  const db = data[i + 2]! - bg[2]!;
+  return Math.sqrt(dr * dr + dg * dg + db * db);
+};
+
+function median(values: number[]): number {
+  const sorted = [...values].sort((a, b) => a - b);
+  return sorted[Math.floor(sorted.length / 2)] ?? 0;
+}
+
+/** The colour that most of the border has, and how far the border pixels stray from it. */
+export function borderColour(img: Pixels): { colour: [number, number, number]; spread: number } {
+  const { width, height, data } = img;
+  const reds: number[] = [];
+  const greens: number[] = [];
+  const blues: number[] = [];
+  const add = (x: number, y: number) => {
+    const i = (y * width + x) * 4;
+    reds.push(data[i]!);
+    greens.push(data[i + 1]!);
+    blues.push(data[i + 2]!);
+  };
+  for (let x = 0; x < width; x++) {
+    add(x, 0);
+    add(x, height - 1);
+  }
+  for (let y = 1; y < height - 1; y++) {
+    add(0, y);
+    add(width - 1, y);
+  }
+  const colour: [number, number, number] = [median(reds), median(greens), median(blues)];
+  let near = 0;
+  for (let k = 0; k < reds.length; k++) {
+    const dr = reds[k]! - colour[0];
+    const dg = greens[k]! - colour[1];
+    const db = blues[k]! - colour[2];
+    if (Math.sqrt(dr * dr + dg * dg + db * db) <= 60) near++;
+  }
+  return { colour, spread: 1 - near / reds.length };
+}
+
+export function keyOutBackground(img: Pixels, options: KeyOptions = {}): KeyResult {
+  const { width, height } = img;
+  if (!(width > 0 && height > 0) || img.data.length < width * height * 4) throw new Error('The picture is empty');
+  const tolerance = options.tolerance ?? 60;
+  if (!(tolerance >= 1 && tolerance <= 200)) throw new Error('tolerance must be from 1 to 200');
+  const soft = tolerance * 2.2;
+  const warnings: string[] = [];
+
+  const { colour: bg, spread } = borderColour(img);
+  if (spread > 0.35) {
+    throw new Error(
+      `The border of the picture is not one flat colour (${Math.round(spread * 100)}% of it differs from ${bg.join(',')}); the object touches the edge or the background is patterned. Generate it again with more empty space around the object.`
+    );
+  }
+  if (spread > 0.1) warnings.push(`${Math.round(spread * 100)}% of the border differs from the background colour; the object may touch the edge`);
+
+  const src = img.data;
+  const out = new Uint8Array(width * height * 4);
+  out.set(src.subarray(0, width * height * 4));
+
+  // Flood from the border over everything that looks like background.
+  const reached = new Uint8Array(width * height);
+  const queue = new Int32Array(width * height);
+  let head = 0;
+  let tail = 0;
+  const push = (x: number, y: number) => {
+    const p = y * width + x;
+    if (reached[p]) return;
+    if (dist(src, p * 4, bg) > soft) return;
+    reached[p] = 1;
+    queue[tail++] = p;
+  };
+  for (let x = 0; x < width; x++) {
+    push(x, 0);
+    push(x, height - 1);
+  }
+  for (let y = 0; y < height; y++) {
+    push(0, y);
+    push(width - 1, y);
+  }
+  while (head < tail) {
+    const p = queue[head++]!;
+    const x = p % width;
+    const y = (p - x) / width;
+    if (x > 0) push(x - 1, y);
+    if (x < width - 1) push(x + 1, y);
+    if (y > 0) push(x, y - 1);
+    if (y < height - 1) push(x, y + 1);
+  }
+
+  if (options.removeEnclosed) {
+    const minPocket = Math.max(40, Math.round(width * height * 0.0002));
+    const seen = new Uint8Array(width * height);
+    const stack = new Int32Array(width * height);
+    const candidate = (p: number) => !reached[p] && !seen[p] && dist(src, p * 4, bg) <= tolerance;
+    for (let start = 0; start < width * height; start++) {
+      if (!candidate(start)) continue;
+      // collect one pocket
+      const members: number[] = [];
+      let top = 0;
+      stack[top++] = start;
+      seen[start] = 1;
+      while (top > 0) {
+        const p = stack[--top]!;
+        members.push(p);
+        const x = p % width;
+        const y = (p - x) / width;
+        const next = [x > 0 ? p - 1 : -1, x < width - 1 ? p + 1 : -1, y > 0 ? p - width : -1, y < height - 1 ? p + width : -1];
+        for (const q of next) {
+          if (q >= 0 && candidate(q)) {
+            seen[q] = 1;
+            stack[top++] = q;
+          }
+        }
+      }
+      if (members.length < minPocket) continue;
+      // spread from the pocket over the soft edge around it, as the border flood does
+      head = 0;
+      tail = 0;
+      for (const p of members) {
+        reached[p] = 1;
+        queue[tail++] = p;
+      }
+      while (head < tail) {
+        const p = queue[head++]!;
+        const x = p % width;
+        const y = (p - x) / width;
+        if (x > 0) push(x - 1, y);
+        if (x < width - 1) push(x + 1, y);
+        if (y > 0) push(x, y - 1);
+        if (y < height - 1) push(x, y + 1);
+      }
+    }
+  }
+
+  let opaque = 0;
+  let minX = width;
+  let minY = height;
+  let maxX = -1;
+  let maxY = -1;
+  for (let p = 0; p < width * height; p++) {
+    const i = p * 4;
+    let alpha = 255;
+    if (reached[p]) {
+      const d = dist(src, i, bg);
+      alpha = d <= tolerance ? 0 : Math.round(((d - tolerance) / (soft - tolerance)) * 255);
+      if (alpha > 0 && alpha < 255) {
+        // Take the background colour out of the edge pixel.
+        const a = alpha / 255;
+        for (let c = 0; c < 3; c++) {
+          const v = (src[i + c]! - bg[c]! * (1 - a)) / a;
+          out[i + c] = Math.max(0, Math.min(255, Math.round(v)));
+        }
+      }
+    }
+    out[i + 3] = alpha;
+    if (alpha > 0) opaque++;
+    if (alpha > 8) {
+      const x = p % width;
+      const y = (p - x) / width;
+      if (x < minX) minX = x;
+      if (x > maxX) maxX = x;
+      if (y < minY) minY = y;
+      if (y > maxY) maxY = y;
+    }
+  }
+
+  // Magenta backgrounds leave pink specks in gaps and edges (strands of hair, thin loops):
+  // near the removed area, pull pixels that are pink back to a neutral colour.
+  if (bg[0] > 150 && bg[2] > 150 && bg[1] < 110) {
+    let near = new Uint8Array(width * height);
+    for (let p = 0; p < width * height; p++) if (out[p * 4 + 3]! < 255) near[p] = 1;
+    for (let pass = 0; pass < 6; pass++) {
+      const grown = near.slice();
+      for (let p = 0; p < width * height; p++) {
+        if (near[p]) continue;
+        const x = p % width;
+        if ((x > 0 && near[p - 1]) || (x < width - 1 && near[p + 1]) || (p >= width && near[p - width]) || (p < width * (height - 1) && near[p + width])) grown[p] = 1;
+      }
+      near = grown;
+    }
+    for (let p = 0; p < width * height; p++) {
+      const i = p * 4;
+      if (!near[p] || out[i + 3] === 0) continue;
+      const r = out[i]!;
+      const g = out[i + 1]!;
+      const b = out[i + 2]!;
+      const excess = Math.min(r, b) - g;
+      if (excess > 25) {
+        // fade the pink towards a neutral grey of the same brightness (no green cast);
+        // a little pink stays when it is probably real (a nose, an ear)
+        const t = Math.min(1, (excess - 25) / 60) * 0.9;
+        const grey = (r + g + b) / 3;
+        out[i] = Math.round(r + (grey - r) * t);
+        out[i + 1] = Math.round(g + (grey - g) * t);
+        out[i + 2] = Math.round(b + (grey - b) * t);
+      }
+    }
+  }
+
+  const share = opaque / (width * height);
+  if (maxX < 0) throw new Error('Nothing is left after removing the background; the object has the background colour');
+  if (share > 0.97) warnings.push('Almost nothing was removed; the background may not be a flat colour that differs from the object');
+  if (share < 0.01) warnings.push('Very little is left; the tolerance may be too high or the object too small');
+
+  const box = { x: minX, y: minY, width: maxX - minX + 1, height: maxY - minY + 1 };
+  if (options.crop === false) {
+    return { width, height, data: out, background: bg, opaqueShare: share, borderSpread: spread, box, warnings };
+  }
+  const pad = Math.max(0, options.padding ?? 2);
+  const x0 = Math.max(0, box.x - pad);
+  const y0 = Math.max(0, box.y - pad);
+  const x1 = Math.min(width, box.x + box.width + pad);
+  const y1 = Math.min(height, box.y + box.height + pad);
+  const w = x1 - x0;
+  const h = y1 - y0;
+  const cropped = new Uint8Array(w * h * 4);
+  for (let y = 0; y < h; y++) {
+    const from = ((y0 + y) * width + x0) * 4;
+    cropped.set(out.subarray(from, from + w * 4), y * w * 4);
+  }
+  return { width: w, height: h, data: cropped, background: bg, opaqueShare: share, borderSpread: spread, box, warnings };
+}
+
+/**
+ * Shrink a picture so its longest side is at most maxSide, averaging the pixels it covers
+ * (alpha-weighted, so a transparent edge does not bleed a dark fringe). Returns the picture as it
+ * is when it is already small enough.
+ */
+export function downscale(img: Pixels, maxSide: number): Pixels {
+  const longest = Math.max(img.width, img.height);
+  if (!(maxSide >= 1) || longest <= maxSide) return img;
+  const scale = maxSide / longest;
+  const w = Math.max(1, Math.round(img.width * scale));
+  const h = Math.max(1, Math.round(img.height * scale));
+  const out = new Uint8Array(w * h * 4);
+  for (let y = 0; y < h; y++) {
+    const y0 = (y * img.height) / h;
+    const y1 = ((y + 1) * img.height) / h;
+    for (let x = 0; x < w; x++) {
+      const x0 = (x * img.width) / w;
+      const x1 = ((x + 1) * img.width) / w;
+      let r = 0;
+      let g = 0;
+      let b = 0;
+      let a = 0;
+      let weight = 0;
+      for (let sy = Math.floor(y0); sy < Math.ceil(y1); sy++) {
+        const wy = Math.min(sy + 1, y1) - Math.max(sy, y0);
+        for (let sx = Math.floor(x0); sx < Math.ceil(x1); sx++) {
+          const wx = Math.min(sx + 1, x1) - Math.max(sx, x0);
+          const wgt = wx * wy;
+          const i = (sy * img.width + sx) * 4;
+          const alpha = img.data[i + 3]! / 255;
+          r += img.data[i]! * alpha * wgt;
+          g += img.data[i + 1]! * alpha * wgt;
+          b += img.data[i + 2]! * alpha * wgt;
+          a += alpha * wgt;
+          weight += wgt;
+        }
+      }
+      const o = (y * w + x) * 4;
+      if (a > 0) {
+        out[o] = Math.round(r / a);
+        out[o + 1] = Math.round(g / a);
+        out[o + 2] = Math.round(b / a);
+      }
+      out[o + 3] = weight > 0 ? Math.round((a / weight) * 255) : 0;
+    }
+  }
+  return { width: w, height: h, data: out };
+}
+
+/** Put a picture in the middle of a transparent square, so a token is not stretched into a circle. */
+export function padToSquare(img: Pixels): Pixels {
+  if (img.width === img.height) return img;
+  const side = Math.max(img.width, img.height);
+  const out = new Uint8Array(side * side * 4);
+  const left = Math.floor((side - img.width) / 2);
+  const top = Math.floor((side - img.height) / 2);
+  for (let y = 0; y < img.height; y++) {
+    const from = y * img.width * 4;
+    out.set(img.data.subarray(from, from + img.width * 4), ((top + y) * side + left) * 4);
+  }
+  return { width: side, height: side, data: out };
+}
diff --git a/packages/mcp-server/src/tools/prop-size.test.ts b/packages/mcp-server/src/tools/prop-size.test.ts
new file mode 100644
index 0000000..d806758
--- /dev/null
+++ b/packages/mcp-server/src/tools/prop-size.test.ts
@@ -0,0 +1,76 @@
+/** make-prop generates large (H3 needs 2 megapixels) and shrinks the finished prop. */
+import { afterAll, describe, expect, it, vi } from 'vitest';
+import { promises as fs } from 'fs';
+import os from 'os';
+import path from 'path';
+import { PNG } from 'pngjs';
+import { PropTools } from './prop-tools.js';
+
+const tmp: string[] = [];
+afterAll(async () => {
+  for (const f of tmp) await fs.rm(f, { force: true });
+});
+
+/** 1600 x 1200 magenta picture with a 1000 x 600 brown object in the middle. */
+async function bigSource(): Promise<string> {
+  const w = 1600;
+  const h = 1200;
+  const png = new PNG({ width: w, height: h });
+  for (let y = 0; y < h; y++) {
+    for (let x = 0; x < w; x++) {
+      const inside = x >= 300 && x < 1300 && y >= 300 && y < 900;
+      const c = inside ? [90, 60, 30] : [255, 0, 255];
+      const i = (y * w + x) * 4;
+      png.data[i] = c[0]!;
+      png.data[i + 1] = c[1]!;
+      png.data[i + 2] = c[2]!;
+      png.data[i + 3] = 255;
+    }
+  }
+  const file = path.join(os.tmpdir(), `prop-size-${Date.now()}-${Math.random().toString(36).slice(2)}.png`);
+  await fs.writeFile(file, PNG.sync.write(png));
+  tmp.push(file);
+  return file;
+}
+
+function makeTools(generate?: any) {
+  const query = vi.fn(async () => ({ success: true, scene: { id: 's', name: 'S' }, created: [{ kind: 'tile', id: 't1', x: 1, y: 1 }] }));
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  const upload = vi.fn(async (a: any) => ({ success: true, path: `worlds/w/uploads/props/${a.filename}` }));
+  return { tools: new PropTools({ foundryClient: { query } as any, logger, generate, upload }), query, upload };
+}
+
+describe('make-prop final size', () => {
+  it('shrinks a big prop to 512 on its longest side by default, keeping the shape', async () => {
+    const { tools } = makeTools();
+    const r = await tools.handleMakeProp({ name: 'Big', image: await bigSource() });
+    tmp.push(r.local_path);
+    expect(Math.max(r.pixels.width, r.pixels.height)).toBe(512);
+    expect(r.pixels.width / r.pixels.height).toBeCloseTo(1000 / 600, 1);
+    const saved = PNG.sync.read(await fs.readFile(r.local_path));
+    expect([saved.width, saved.height]).toEqual([r.pixels.width, r.pixels.height]);
+    expect(r.steps ?? []).toBeDefined();
+  });
+  it('takes final_size, and keeps the picture when it is already smaller', async () => {
+    const { tools } = makeTools();
+    const small = await tools.handleMakeProp({ name: 'Small', image: await bigSource(), final_size: 128 });
+    tmp.push(small.local_path);
+    expect(Math.max(small.pixels.width, small.pixels.height)).toBe(128);
+    const full = await tools.handleMakeProp({ name: 'Full', image: await bigSource(), final_size: 2048 });
+    tmp.push(full.local_path);
+    expect(full.pixels.width).toBeGreaterThan(900);
+    await expect(tools.handleMakeProp({ name: 'x', image: await bigSource(), final_size: 8 })).rejects.toThrow();
+  });
+  it('sizes the tile from the shrunk picture and still asks the generator for a big size', async () => {
+    const src = await bigSource();
+    const generate = vi.fn(async () => ({ success: true, local_path: src, seconds: 1 }));
+    const { tools, query } = makeTools(generate);
+    const r = await tools.handleMakeProp({ name: 'Gen', prompt: 'a table', image_size: 512, x: 1, y: 1, width: 2, scene: 'S' });
+    tmp.push(r.local_path);
+    expect(generate).toHaveBeenCalledWith(expect.objectContaining({ width: 512, height: 512 }));
+    const placed = (query.mock.calls as any[][])[0]![1].objects[0];
+    expect(placed.width).toBe(2);
+    expect(placed.height).toBeCloseTo(1.2, 1);
+    expect(tools.getToolDefinitions()[0]!.description).toBeDefined();
+  });
+});

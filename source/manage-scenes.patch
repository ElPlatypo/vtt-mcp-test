+/**
+ * manage-scene-objects and preview-scene tests. Foundry is stubbed: these check the data sent
+ * to createEmbeddedDocuments / deleteEmbeddedDocuments, the grid conversion, validation, the
+ * "only remove what the tool created" rule and the write gate.
+ */
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+
+const MODULE = 'foundry-mcp-bridge-scenes';
+const MINE = { [MODULE]: { sceneObjectsTool: true } };
+
+function makeScene(overrides: Record<string, any> = {}) {
+  const created: Record<string, any[]> = { Token: [], AmbientLight: [] };
+  const scene: any = {
+    id: 's1',
+    name: 'Cave',
+    width: 4000,
+    height: 3000,
+    padding: 0.25,
+    grid: { size: 100, distance: 5, units: 'ft' },
+    dimensions: { sceneX: 1000, sceneY: 800, sceneWidth: 4000, sceneHeight: 3000 },
+    tokens: { contents: [] as any[] },
+    lights: { contents: [] as any[] },
+    createEmbeddedDocuments: vi.fn(async (type: string, data: any[]) => {
+      created[type] ??= [];
+      const docs = data.map((d, i) => ({ id: `${type}-${created[type].length + i}`, ...d }));
+      created[type].push(...docs);
+      return docs;
+    }),
+    deleteEmbeddedDocuments: vi.fn(async () => []),
+    ...overrides,
+  };
+  return { scene, created };
+}
+
+function setup(options: { allowWriteOperations?: boolean; scene?: any; actors?: any[] } = {}) {
+  const { scene, created } = options.scene ? { scene: options.scene, created: {} } : makeScene();
+  const goblin = {
+    id: 'a1',
+    name: 'Goblin',
+    prototypeToken: {
+      toObject: () => ({
+        name: 'Goblin',
+        width: 1,
+        height: 1,
+        texture: { src: 'g.png' },
+        flags: {},
+      }),
+    },
+  };
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'world-1', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'Gamemaster' },
+    scenes: { contents: [scene], viewed: scene, current: scene },
+    actors: { contents: options.actors ?? [goblin] },
+    settings: {
+      get: (_m: string, key: string) =>
+        key === 'allowWriteOperations' ? (options.allowWriteOperations ?? true) : undefined,
+    },
+  });
+  return { dataAccess: new FoundryDataAccess(), scene, created };
+}
+
+describe('FoundryDataAccess.manageSceneObjects', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  describe('place', () => {
+    it('puts a token at the given square, using the actor prototype and marking it', async () => {
+      const { dataAccess, scene } = setup();
+
+      const result = await dataAccess.manageSceneObjects({
+        action: 'place',
+        objects: [
+          {
+            kind: 'token',
+            actor: 'goblin',
+            x: 3,
+            y: 2,
+            name: 'Goblin 1',
+            hidden: true,
+            disposition: -1,
+          },
+        ],
+      });
+
+      const [type, data] = scene.createEmbeddedDocuments.mock.calls[0];
+      expect(type).toBe('Token');
+      expect(data[0]).toMatchObject({
+        name: 'Goblin 1',
+        actorId: 'a1',
+        x: 1300,
+        y: 1000,
+        hidden: true,
+        disposition: -1,
+        texture: { src: 'g.png' },
+        flags: MINE,
+      });
+      expect(result.created).toEqual([{ kind: 'token', id: 'Token-0', x: 3, y: 2 }]);
+    });
+
+    it('puts a light at the centre of a square with radii converted to distance', async () => {
+      const { dataAccess, scene } = setup();
+
+      const result = await dataAccess.manageSceneObjects({
+        action: 'place',
+        objects: [{ kind: 'light', x: 10.5, y: 4.5, bright: 2, dim: 6, color: '#ffaa33' }],
+      });
+
+      const [type, data] = scene.createEmbeddedDocuments.mock.calls[0];
+      expect(type).toBe('AmbientLight');
+      expect(data[0]).toMatchObject({
+        x: 2050,
+        y: 1250,
+        config: { bright: 10, dim: 30, color: '#ffaa33' },
+        flags: MINE,
+      });
+      expect(result.created[0]).toMatchObject({ kind: 'light', x: 10.5, y: 4.5 });
+    });
+
+    it('handles a mixed batch in one call and defaults to the viewed scene', async () => {
+      const { dataAccess, scene } = setup();
+      const result = await dataAccess.manageSceneObjects({
+        action: 'place',
+        objects: [
+          { kind: 'token', actor: 'a1', x: 0, y: 0 },
+          { kind: 'light', x: 1, y: 1, dim: 3 },
+        ],
+      });
+      expect(scene.createEmbeddedDocuments).toHaveBeenCalledTimes(2);
+      expect(result.created.map((c: any) => c.kind)).toEqual(['token', 'light']);
+      expect(result.scene).toEqual({ id: 's1', name: 'Cave' });
+    });
+
+    it('creates nothing when any object in the batch is invalid', async () => {
+      const { dataAccess, scene } = setup();
+
+      await expect(
+        dataAccess.manageSceneObjects({
+          action: 'place',
+          objects: [
+            { kind: 'token', actor: 'goblin', x: 1, y: 1 },
+            { kind: 'light', x: 500, y: 1, dim: 3 },
+          ],
+        })
+      ).rejects.toThrow('objects[1]');
+      expect(scene.createEmbeddedDocuments).not.toHaveBeenCalled();
+    });
+
+    it.each([
+      ['an unknown kind', { kind: 'dragon', x: 1, y: 1 }, 'kind must be'],
+      ['a token without an actor', { kind: 'token', x: 1, y: 1 }, 'actor'],
+      ['an unknown actor', { kind: 'token', actor: 'Dragon', x: 1, y: 1 }, 'Actor not found'],
+      [
+        'a token outside the scene',
+        { kind: 'token', actor: 'goblin', x: 40, y: 1 },
+        'top-left square',
+      ],
+      [
+        'a token at a bad disposition',
+        { kind: 'token', actor: 'goblin', x: 1, y: 1, disposition: 5 },
+        'disposition',
+      ],
+      [
+        'non-numeric coordinates',
+        { kind: 'token', actor: 'goblin', x: '1', y: 1 },
+        'must be numbers',
+      ],
+    ])('rejects %s', async (_label, object, message) => {
+      const { dataAccess, scene } = setup();
+      await expect(
+        dataAccess.manageSceneObjects({ action: 'place', objects: [object as any] })
+      ).rejects.toThrow(message);
+      expect(scene.createEmbeddedDocuments).not.toHaveBeenCalled();
+    });
+
+    it('refuses an actor name that matches several actors', async () => {
+      const make = (id: string) => ({ id, name: 'Twin', prototypeToken: { toObject: () => ({}) } });
+      const { dataAccess } = setup({ actors: [make('1'), make('2')] });
+      await expect(
+        dataAccess.manageSceneObjects({
+          action: 'place',
+          objects: [{ kind: 'token', actor: 'twin', x: 1, y: 1 }],
+        })
+      ).rejects.toThrow('Several actors');
+    });
+
+    it('needs a non-empty list and at most 200 objects', async () => {
+      const { dataAccess } = setup();
+      await expect(dataAccess.manageSceneObjects({ action: 'place' })).rejects.toThrow('non-empty');
+      await expect(
+        dataAccess.manageSceneObjects({
+          action: 'place',
+          objects: Array.from({ length: 201 }, () => ({ kind: 'light', x: 1, y: 1, dim: 1 })),
+        })
+      ).rejects.toThrow('At most 200');
+    });
+  });
+
+  describe('describe', () => {
+    it('reports the grid and every token and light in squares, marking its own', async () => {
+      const { scene } = makeScene();
+      scene.tokens.contents = [
+        {
+          id: 't1',
+          name: 'Goblin',
+          actorId: 'a1',
+          x: 1300,
+          y: 1000,
+          width: 1,
+          height: 1,
+          hidden: false,
+          flags: MINE,
+        },
+        {
+          id: 't2',
+          name: 'Hand-made',
+          x: 1000,
+          y: 800,
+          width: 2,
+          height: 2,
+          hidden: true,
+          flags: {},
+        },
+      ];
+      scene.lights.contents = [
+        {
+          id: 'l1',
+          x: 2050,
+          y: 1250,
+          hidden: false,
+          config: { bright: 10, dim: 30, color: '#ffaa33' },
+          flags: MINE,
+        },
+      ];
+      const { dataAccess } = setup({ scene });
+
+      const result = await dataAccess.manageSceneObjects({ action: 'describe' });
+
+      expect(result.grid).toEqual({
+        columns: 40,
+        rows: 30,
+        squarePixels: 100,
+        squareDistance: 5,
+        units: 'ft',
+        originPixels: { x: 1000, y: 800 },
+      });
+      expect(result.tokens).toEqual([
+        expect.objectContaining({ id: 't1', x: 3, y: 2, createdByTool: true }),
+        expect.objectContaining({ id: 't2', x: 0, y: 0, hidden: true, createdByTool: false }),
+      ]);
+      expect(result.lights).toEqual([
+        expect.objectContaining({
+          id: 'l1',
+          x: 10.5,
+          y: 4.5,
+          brightSquares: 2,
+          dimSquares: 6,
+          createdByTool: true,
+        }),
+      ]);
+    });
+
+    it('works when write operations are disabled, and can filter by kind', async () => {
+      const { dataAccess } = setup({ allowWriteOperations: false });
+      const result = await dataAccess.manageSceneObjects({ action: 'describe', kind: 'light' });
+      expect(result.lights).toEqual([]);
+      expect(result.tokens).toBeUndefined();
+    });
+  });
+
+  describe('remove', () => {
+    function sceneWithObjects() {
+      const { scene } = makeScene();
+      scene.tokens.contents = [
+        { id: 't1', flags: MINE },
+        { id: 't2', flags: {} },
+      ];
+      scene.lights.contents = [{ id: 'l1', flags: MINE }];
+      return scene;
+    }
+
+    it('removes only listed objects that the tool created', async () => {
+      const scene = sceneWithObjects();
+      const { dataAccess } = setup({ scene });
+
+      const result = await dataAccess.manageSceneObjects({
+        action: 'remove',
+        ids: ['t1', 't2', 'nope'],
+      });
+
+      expect(scene.deleteEmbeddedDocuments).toHaveBeenCalledTimes(1);
+      expect(scene.deleteEmbeddedDocuments).toHaveBeenCalledWith('Token', ['t1']);
+      expect(result.removed).toEqual([{ kind: 'token', id: 't1' }]);
+      expect(result.skipped.map((s: any) => s.id)).toEqual(['t2', 'nope']);
+    });
+
+    it('all_mine removes every tool-made object and nothing else', async () => {
+      const scene = sceneWithObjects();
+      const { dataAccess } = setup({ scene });
+
+      const result = await dataAccess.manageSceneObjects({ action: 'remove', all_mine: true });
+
+      expect(scene.deleteEmbeddedDocuments).toHaveBeenCalledWith('Token', ['t1']);
+      expect(scene.deleteEmbeddedDocuments).toHaveBeenCalledWith('AmbientLight', ['l1']);
+      expect(result.removed).toHaveLength(2);
+    });
+
+    it('all_mine with a kind leaves the other kind alone', async () => {
+      const scene = sceneWithObjects();
+      const { dataAccess } = setup({ scene });
+      await dataAccess.manageSceneObjects({ action: 'remove', all_mine: true, kind: 'light' });
+      expect(scene.deleteEmbeddedDocuments).toHaveBeenCalledTimes(1);
+      expect(scene.deleteEmbeddedDocuments).toHaveBeenCalledWith('AmbientLight', ['l1']);
+    });
+
+    it('needs ids or all_mine', async () => {
+      const { dataAccess } = setup();
+      await expect(dataAccess.manageSceneObjects({ action: 'remove' })).rejects.toThrow(
+        'ids, or all_mine'
+      );
+    });
+  });
+
+  describe('write gate and scene lookup', () => {
+    it('blocks place and remove when write operations are disabled', async () => {
+      const { dataAccess, scene } = setup({ allowWriteOperations: false });
+      await expect(
+        dataAccess.manageSceneObjects({
+          action: 'place',
+          objects: [{ kind: 'light', x: 1, y: 1, dim: 2 }],
+        })
+      ).rejects.toThrow(/disabled in module settings/);
+      await expect(
+        dataAccess.manageSceneObjects({ action: 'remove', all_mine: true })
+      ).rejects.toThrow(/disabled in module settings/);
+      expect(scene.createEmbeddedDocuments).not.toHaveBeenCalled();
+      expect(scene.deleteEmbeddedDocuments).not.toHaveBeenCalled();
+    });
+
+    it('finds a scene by name and reports an unknown one', async () => {
+      const { dataAccess } = setup();
+      await expect(
+        dataAccess.manageSceneObjects({ action: 'describe', scene: 'cave' })
+      ).resolves.toMatchObject({ scene: { id: 's1' } });
+      await expect(
+        dataAccess.manageSceneObjects({ action: 'describe', scene: 'Nowhere' })
+      ).rejects.toThrow('Scene not found');
+    });
+
+    it('rejects an unknown action', async () => {
+      const { dataAccess } = setup();
+      await expect(dataAccess.manageSceneObjects({ action: 'explode' as any })).rejects.toThrow(
+        'Unknown action'
+      );
+    });
+  });
+});
+
+describe('FoundryDataAccess.previewScene', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  function stubBrowser(imageLoads: boolean) {
+    const ctx: any = new Proxy(
+      {},
+      { get: (_t, prop) => (prop === 'canvas' ? undefined : () => undefined), set: () => true }
+    );
+    const canvas = {
+      width: 0,
+      height: 0,
+      getContext: () => ctx,
+      toDataURL: () => 'data:image/png;base64,QUJD',
+    };
+    vi.stubGlobal('document', { createElement: () => canvas });
+    class FakeImage {
+      onload: (() => void) | null = null;
+      onerror: (() => void) | null = null;
+      set src(_value: string) {
+        queueMicrotask(() => (imageLoads ? this.onload?.() : this.onerror?.()));
+      }
+    }
+    vi.stubGlobal('Image', FakeImage);
+    return canvas;
+  }
+
+  it('returns a PNG of the scene at a reduced size, with counts', async () => {
+    const { scene } = makeScene({ _source: { background: { src: 'maps/cave.webp' } } });
+    scene.tokens.contents = [{ id: 't', name: 'G', x: 1000, y: 800, width: 1, height: 1 }];
+    const { dataAccess } = setup({ scene });
+    const canvas = stubBrowser(true);
+
+    const result = await dataAccess.previewScene({ max_size: 2000 });
+
+    expect(result).toMatchObject({
+      success: true,
+      mimeType: 'image/png',
+      imageBase64: 'QUJD',
+      width: 2000,
+      height: 1500,
+      scale: 0.5,
+      grid: { columns: 40, rows: 30 },
+      tokens: 1,
+      lights: 0,
+    });
+    expect(result.warnings).toBeUndefined();
+    expect(canvas.width).toBe(2000);
+  });
+
+  it('still draws, with a warning, when the background cannot be loaded', async () => {
+    const { scene } = makeScene({ _source: { background: { src: 'missing.webp' } } });
+    const { dataAccess } = setup({ scene });
+    stubBrowser(false);
+
+    const result = await dataAccess.previewScene({});
+    expect(result.success).toBe(true);
+    expect(result.warnings[0]).toContain('could not be loaded');
+  });
+
+  it('warns about a scene with no background', async () => {
+    const { dataAccess } = setup();
+    stubBrowser(true);
+    const result = await dataAccess.previewScene({});
+    expect(result.warnings[0]).toContain('no background');
+  });
+
+  it('rejects out-of-range options', async () => {
+    const { dataAccess } = setup();

+/** Walls as short rows, optionally only those touching a region: {id, c:[x1,y1,x2,y2], door?, state?, other?}. */
+export function compactWallDescription(result: any, region?: { x: number; y: number; width: number; height: number }): any {
+  const walls: any[] = Array.isArray(result?.walls) ? result.walls : [];
+  const inRegion = (w: any) => {
+    if (!region) return true;
+    const minX = Math.min(w.from[0], w.to[0]);
+    const maxX = Math.max(w.from[0], w.to[0]);
+    const minY = Math.min(w.from[1], w.to[1]);
+    const maxY = Math.max(w.from[1], w.to[1]);
+    return maxX >= region.x && minX <= region.x + region.width && maxY >= region.y && minY <= region.y + region.height;
+  };
+  const rows = walls.filter(inRegion).map(w => ({
+    id: w.id,
+    c: [w.from[0], w.from[1], w.to[0], w.to[1]],
+    ...(w.door ? { door: w.door, state: w.doorState } : {}),
+    ...(w.createdByTool === false ? { other: true } : {}),
+  }));
+  const { walls: _walls, ...rest } = result;
+  return { ...rest, ...(region ? { shown: rows.length } : {}), walls: rows, format: 'c = [x1, y1, x2, y2] in grid squares; other = not placed by this tool (cannot be removed)' };

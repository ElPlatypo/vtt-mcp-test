+import { describe, expect, it } from 'vitest';
+import { attackRangeOf, rangeVerdict, sameUnits, tokenDistance, turnWarning } from './attack-checks.js';
+
+const G = 100; // pixels per square
+
+describe('attackRangeOf', () => {
+  it('reads a melee weapon (reach 5 by default) and a reach weapon', () => {
+    expect(attackRangeOf({ system: { range: { units: 'ft' } } }, { attack: { type: { value: 'melee' } } })).toEqual({ melee: true, units: 'ft', reach: 5 });
+    expect(attackRangeOf({ system: { range: { reach: 10, units: 'ft' } } }, { attack: { type: { value: 'melee' } } })).toMatchObject({ reach: 10 });
+  });
+  it('reads a ranged weapon, a thrown melee weapon and a touch spell', () => {
+    expect(attackRangeOf({ system: { range: { value: 80, long: 320, units: 'ft' } } }, { attack: { type: { value: 'ranged' } } })).toEqual({
+      melee: false,
+      units: 'ft',
+      normal: 80,
+      long: 320,
+    });
+    expect(attackRangeOf({ system: { range: { value: 20, long: 60, units: 'ft' } } }, { attack: { type: { value: 'melee' } } })).toEqual({
+      melee: true,
+      units: 'ft',
+      reach: 5,
+      normal: 20,
+      long: 60,
+    });
+    expect(attackRangeOf({ system: {} }, { range: { units: 'touch' }, attack: { type: { value: 'melee' } } })).toMatchObject({ reach: 5 });
+  });
+  it('lets an overriding activity range win, and skips self and special ranges', () => {
+    expect(attackRangeOf({ system: { range: { value: 30, units: 'ft' } } }, { range: { override: true, value: 120, units: 'ft' } })).toMatchObject({ normal: 120 });
+    expect(attackRangeOf({ system: { range: { units: 'self' } } }, {})).toBeNull();
+    expect(attackRangeOf({ system: {} }, {})).toBeNull();
+  });
+});
+
+describe('tokenDistance', () => {
+  it('counts adjacent as 5 ft, diagonals as one square, and from the nearest edge of large tokens', () => {
+    const a = { x: 0, y: 0, width: 1, height: 1 };
+    expect(tokenDistance(a, { x: G, y: 0, width: 1, height: 1 }, G, 5)).toBe(5);
+    expect(tokenDistance(a, { x: G, y: G, width: 1, height: 1 }, G, 5)).toBe(5);
+    expect(tokenDistance(a, { x: 10 * G, y: 5 * G, width: 1, height: 1 }, G, 5)).toBe(50);
+    // A Large ogre whose near edge is two squares away
+    expect(tokenDistance(a, { x: 3 * G, y: 0, width: 2, height: 2 }, G, 5)).toBe(15);
+  });
+});
+
+describe('rangeVerdict', () => {
+  const bow = { melee: false, units: 'ft', normal: 80, long: 320 };
+  const sword = { melee: true, units: 'ft', reach: 5 };
+  const axe = { melee: true, units: 'ft', reach: 5, normal: 20, long: 60 };
+  it('judges normal, long and out of range', () => {
+    expect(rangeVerdict(50, bow)).toEqual({ status: 'ok' });
+    expect(rangeVerdict(100, bow)).toEqual({ status: 'long', normal: 80 });
+    expect(rangeVerdict(400, bow)).toEqual({ status: 'out', max: 320 });
+    expect(rangeVerdict(5, sword)).toEqual({ status: 'ok' });
+    expect(rangeVerdict(10, sword)).toEqual({ status: 'out', max: 5 });
+    expect(rangeVerdict(15, axe)).toEqual({ status: 'ok' });
+    expect(rangeVerdict(40, axe)).toEqual({ status: 'long', normal: 20 });
+  });
+  it('compares units by meaning', () => {
+    expect(sameUnits('ft', 'feet')).toBe(true);
+    expect(sameUnits(undefined, 'ft')).toBe(true);
+    expect(sameUnits('m', 'ft')).toBe(false);
+  });
+});
+
+describe('turnWarning', () => {
+  const combat = { started: true, combatant: { tokenId: 't3', actorId: 'a', name: 'Goblin 3' } };
+  it('warns only when a running combat has someone else turn', () => {
+    expect(turnWarning(combat, { tokenId: 't3', name: 'Goblin 3' }, true)).toBeUndefined();
+    expect(turnWarning(combat, { tokenId: 't1', name: 'Goblin 1' }, true)).toMatch(/Goblin 3's turn, not Goblin 1's/);
+    expect(turnWarning(combat, { tokenId: 't9', name: 'Bystander' }, false)).toBeUndefined();
+    expect(turnWarning({ started: false, combatant: null }, { tokenId: 't1', name: 'Goblin 1' }, true)).toBeUndefined();
+  });
+});

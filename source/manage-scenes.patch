+    const upload = vi.fn(async () => ({ success: true, path: 'worlds/w/uploads/maps/x.png' }));
+    const { tools, calls } = make({ generate, upload });
+    await newLayout(tools, 'build one');
+    const result = await tools.handleLayout({
+      action: 'build',
+      layout: 'build one',
+      scene_name: 'Built Cave',
+      prompt: 'Damp cave with torches.',
+      scene_options: { darkness: 0.5 },
+    });
+    expect(generate).toHaveBeenCalledTimes(1);
+    const gen = generate.mock.calls[0]![0];
+    expect(gen).toMatchObject({ kind: 'map', width: 768, height: 512, upload: false });
+    expect(gen.prompt).toContain('<Picture 1>');
+    expect(gen.prompt).toContain('Damp cave with torches.');
+    expect(upload).toHaveBeenCalledWith(expect.objectContaining({ folder: 'maps' }));
+
+    const create = calls.find(c => c.tool === 'foundry-mcp-bridge.manage-scenes')!;
+    expect(create.args).toMatchObject({
+      action: 'create',
+      name: 'Built Cave',
+      background: 'worlds/w/uploads/maps/x.png',
+      width: 24 * 64,
+      height: 16 * 64,
+      grid_size: 64,
+      darkness: 0.5,
+    });
+    const walls = calls.filter(c => c.args.action === 'place');
+    expect(walls.length).toBeGreaterThan(0);
+    expect(walls[0]!.args.scene).toBe('sc1');
+    expect(result.scene).toEqual({ id: 'sc1', name: 'Built Cave' });
+    expect(result.steps.length).toBeGreaterThanOrEqual(5);

+import { describe, expect, it, vi } from 'vitest';
+import { SpeechTools } from './speech-tools.js';
+
+function flac(seconds: number): Buffer {
+  const b = Buffer.alloc(60);
+  b.write('fLaC', 0, 'ascii');
+  const rate = 24000;
+  const samples = rate * seconds;
+  b[18] = (rate >> 12) & 0xff;
+  b[19] = (rate >> 4) & 0xff;
+  b[20] = (rate & 15) << 4;
+  b.writeUInt32BE(samples, 22);
+  return b;
+}
+
+const KOKORO_VOICES = ['af_heart', 'bm_fable', 'am_fenrir'];
+
+function make(settings: any = {}, opts: { nodes?: string[]; audio?: Buffer; uploadError?: string } = {}) {
+  const nodes = opts.nodes ?? ['KokoroGenerator', 'KokoroSpeaker', 'FB_Qwen3TTSCustomVoice', 'FB_Qwen3TTSVoiceDesign'];
+  const query = vi.fn(async (method: string, data: any) => {
+    if (method === 'foundry-mcp-bridge.get-speech-settings') return { success: true, target: { mode: 'builtin' }, settings };
+    if (method === 'foundry-mcp-bridge.upload-file') return opts.uploadError ? { success: false, error: opts.uploadError } : { success: true, path: `worlds/w/uploads/generated/speech/${data.filename}` };
+    if (method === 'foundry-mcp-bridge.speak') return { success: true, messageId: 'm1' };
+    return { success: true };
+  });
+  const runAudioWorkflow = vi.fn(async () => ({ audio: opts.audio ?? flac(12), filename: 'claude-speech_00001_.flac', promptId: 'p1' }));
+  const getNodeInfo = vi.fn(async (name: string) => {
+    if (!nodes.includes(name)) return null;
+    if (name === 'KokoroSpeaker') return { input: { required: { speaker_name: [KOKORO_VOICES] } } };
+    if (name === 'FB_Qwen3TTSCustomVoice') return { input: { required: { text: ['STRING', { default: '' }], speaker: [['Aiden', 'Ryan']], device: [['auto', 'cuda']] } } };
+    return { input: { required: { text: ['STRING', { default: '' }] } } };
+  });
+  const applyTarget = vi.fn();
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  const tools = new SpeechTools({ foundryClient: { query } as any, logger, getClient: () => ({ runAudioWorkflow, getNodeInfo, getBaseUrl: () => 'http://comfy:8188' }), applyTarget });
+  return { tools, query, runAudioWorkflow, getNodeInfo, applyTarget };
+}
+
+describe('speak tool', () => {
+  it('is exposed', () => {
+    const def = make().tools.getToolDefinitions()[0]!;
+    expect(def.name).toBe('speak');
+    expect(def.description).toContain('returns at once');
+  });
+
+  it('generates with the default Kokoro setting, uploads the audio and plays it with the text', async () => {
+    const { tools, query, runAudioWorkflow, applyTarget } = make({ engine: 'kokoro', voice: 'bm_fable' });
+    const r = await tools.handleSpeak({ text: 'The woods press close.', speaker_name: 'Narrator' });
+    expect(applyTarget).toHaveBeenCalledWith({ mode: 'builtin' });
+    const wf = (runAudioWorkflow.mock.calls[0] as any[])[0];
+    expect(wf['1'].inputs.speaker_name).toBe('bm_fable');
+    expect(wf['2'].inputs).toMatchObject({ text: 'The woods press close.', lang: 'English (British)', speed: 1 });
+    const upload = query.mock.calls.find(c => c[0] === 'foundry-mcp-bridge.upload-file')![1] as any;
+    expect(upload.filename).toMatch(/^the-woods-press-close-[a-z0-9]+-0\.flac$/);
+    expect(upload.folder).toBe('generated/speech');
+    expect(typeof upload.imageData).toBe('string');
+    const queued = query.mock.calls.find(c => c[1]?.action === 'queue')![1] as any;
+    expect(queued).toMatchObject({
+      index: 0,
+      path: expect.stringContaining('generated/speech/the-woods-press-close-'),
+      text: 'The woods press close.',
+      audioSeconds: 12,
+      speaker: 'Narrator',
+      sync: true,
+      startDelayMs: 0,
+    });
+    expect(query).toHaveBeenLastCalledWith('foundry-mcp-bridge.speak', { action: 'end', id: queued.id });
+    expect(r).toMatchObject({ success: true, engine: 'kokoro', voice: 'bm_fable', audio_seconds: 12, message_id: 'm1' });
+  });
+
+  it('lets the call override the engine, voice and chat, and uses the Qwen3 node defaults', async () => {
+    const { tools, query, runAudioWorkflow } = make({ engine: 'kokoro', voice: 'bm_fable', syncText: true });
+    await tools.handleSpeak({ text: 'Hold!', engine: 'qwen3-custom', voice: 'ryan', style: 'Stern.', chat: false, seed: 5 });
+    const wf = (runAudioWorkflow.mock.calls[0] as any[])[0];
+    expect(wf['1'].class_type).toBe('FB_Qwen3TTSCustomVoice');
+    expect(wf['1'].inputs).toMatchObject({ speaker: 'Ryan', instruct: 'Stern.', device: 'auto', seed: 5 });
+    expect((query.mock.calls.find(c => c[1]?.action === 'queue')![1] as any).sync).toBe(false);
+  });
+
+  it('falls back to a voice that suits the engine when the setting is for another one', async () => {
+    const { tools, runAudioWorkflow } = make({ engine: 'qwen3-custom', voice: 'Ryan' });
+    await tools.handleSpeak({ text: 'Hi.', engine: 'kokoro' });
+    expect((runAudioWorkflow.mock.calls[0] as any[])[0]['1'].inputs.speaker_name).toBe('bm_fable');
+  });
+
+  it('explains a missing node, an unknown voice, an empty text and a failed upload', async () => {
+    await expect(make({}, { nodes: [] }).tools.handleSpeak({ text: 'Hi.' })).rejects.toThrow('KokoroGenerator');
+    await expect(make().tools.handleSpeak({ text: 'Hi.', voice: 'nobody' })).rejects.toThrow('af_heart, bm_fable, am_fenrir');
+    await expect(make().tools.handleSpeak({})).rejects.toThrow('needs text');
+    await expect(make({}, { uploadError: 'too big' }).tools.handleSpeak({ text: 'Hi.' })).rejects.toThrow('uploading part 1 to Foundry failed: too big');
+  });
+
+  it('estimates the length when the audio cannot be read', async () => {
+    const { tools } = make({}, { audio: Buffer.from('xx'.repeat(50)) });
+    const r = await tools.handleSpeak({ text: 'one two three four five six seven eight nine ten' });
+    expect(r).toMatchObject({ audio_seconds: 3.8, note: expect.stringContaining('estimated') });
+  });
+
+  it('describes engines and voices, and stops the narration', async () => {
+    vi.stubGlobal('fetch', vi.fn(async () => new Response('{}', { status: 404 })));
+    const { tools, query } = make({ engine: 'kokoro' }, { nodes: ['KokoroGenerator', 'KokoroSpeaker'] });
+    const d = await tools.handleSpeak({ action: 'describe' });
+    expect(d.engines.kokoro).toEqual({ available: true, voices: KOKORO_VOICES });
+    expect(d.engines['qwen3-custom']).toEqual({ available: false, needs: 'FB_Qwen3TTSCustomVoice' });
+    await tools.handleSpeak({ action: 'stop' });
+    expect(query).toHaveBeenLastCalledWith('foundry-mcp-bridge.speak', { action: 'stop' });
+    vi.unstubAllGlobals();
+  });
+
+  it('rejects bad arguments', async () => {
+    await expect(make().tools.handleSpeak({ text: 'x', speed: 5 })).rejects.toThrow();
+    await expect(make().tools.handleSpeak({ text: 'x'.repeat(2000) })).rejects.toThrow();
+    await expect(make().tools.handleSpeak({ engine: 'robot', text: 'x' })).rejects.toThrow();
+  });
+});
+
+describe('qwen3-fast engine', () => {
+  const RATE = 24000;
+  const half = () => Buffer.alloc(RATE); // 0.5 s of 16-bit mono
+  function stubServer(chunks: Buffer[], speakers = ['Ryan', 'Serena']) {
+    const calls: any[] = [];
+    vi.stubGlobal('fetch', vi.fn(async (url: string, init?: any) => {
+      calls.push({ url, body: init?.body ? JSON.parse(init.body) : undefined });
+      if (url.endsWith('/claude-tts/voices')) return new Response(JSON.stringify({ speakers, languages: ['English'] }), { status: 200 });
+      const body = new ReadableStream({ start(c) { for (const ch of chunks) c.enqueue(new Uint8Array(ch)); c.close(); } });
+      return new Response(body, { status: 200, headers: { 'x-sample-rate': String(RATE) } });
+    }));
+    return calls;
+  }
+
+  it('streams a sentence into pieces sized for the server speed, with the text shared out', async () => {
+    const calls = stubServer([half(), half(), half(), half(), half(), half()]);
+    const { tools, query, runAudioWorkflow } = make({ engine: 'qwen3-fast', voice: 'Ryan' });
+    const r = await tools.handleSpeak({ text: 'Four goblins wait in the woods today.', style: 'Grim.' });
+    expect(runAudioWorkflow).not.toHaveBeenCalled();
+    const speakCall = calls.find(c => c.url.endsWith('/claude-tts/speak'))!;
+    expect(speakCall.url).toBe('http://comfy:8188/claude-tts/speak');
+    expect(speakCall.body).toMatchObject({ text: 'Four goblins wait in the woods today.', speaker: 'Ryan', instruct: 'Grim.', language: 'English', mode: 'custom', temperature: 0.7 });
+    expect(typeof speakCall.body.seed).toBe('number');
+    const queued = query.mock.calls.filter(c => c[1]?.action === 'queue').map(c => c[1] as any);
+    expect(queued.map(q => q.audioSeconds)).toEqual([2, 1]);
+    expect(queued.map(q => q.index)).toEqual([0, 1]);
+    expect(queued.map(q => q.text).join(' ')).toBe('Four goblins wait in the woods today.');
+    expect(queued[0].path).toMatch(/.wav$/);
+    expect(query).toHaveBeenLastCalledWith('foundry-mcp-bridge.speak', { action: 'end', id: queued[0].id });
+    expect(r).toMatchObject({ success: true, engine: 'qwen3-fast', voice: 'Ryan', parts: 2, audio_seconds: 3 });
+    vi.unstubAllGlobals();
+  });
+
+  it('rejects an unknown voice and explains a missing server', async () => {
+    stubServer([half()]);
+    await expect(make({ engine: 'qwen3-fast' }).tools.handleSpeak({ text: 'Hi there.', voice: 'nobody' })).rejects.toThrow('Ryan, Serena');
+    vi.stubGlobal('fetch', vi.fn(async () => new Response('{}', { status: 404 })));
+    await expect(make({ engine: 'qwen3-fast' }).tools.handleSpeak({ text: 'Hi there.' })).rejects.toThrow('claude_tts');
+    vi.unstubAllGlobals();
+  });
+
+  it('is listed by describe, available or not', async () => {
+    stubServer([half()]);
+    const d = await make({ engine: 'qwen3-fast' }).tools.handleSpeak({ action: 'describe' });
+    expect(d.engines['qwen3-fast']).toMatchObject({ available: true, voices: ['Ryan', 'Serena'] });
+    vi.stubGlobal('fetch', vi.fn(async () => new Response('{}', { status: 503 })));
+    const e = await make({ engine: 'qwen3-fast' }).tools.handleSpeak({ action: 'describe' });
+    expect(e.engines['qwen3-fast']).toMatchObject({ available: false });
+    vi.unstubAllGlobals();
+  });
+});
+
+describe('segmentPlan', () => {
+  it('starts small on a fast server and larger on a slow one', async () => {
+    const { segmentPlan } = await import('./speech-tools.js');
+    expect(segmentPlan(1.7)).toEqual({ first: 0.9, growth: 1.4 });
+    const slow = segmentPlan(1.1);
+    expect(slow.first).toBeGreaterThan(1.5);
+    expect(slow.growth).toBeLessThan(1.1);
+    expect(segmentPlan(0.8).first).toBe(2);
+  });
+});
+
+describe('speaking as a character', () => {
+  it('passes the token or actor and the full line for the bubble with the first piece only', async () => {
+    const { tools, query } = make({ engine: 'kokoro', voice: 'bm_fable' });
+    await tools.handleSpeak({ text: 'Drop your gold. Or else.', token_id: 'tok1', speaker_name: 'Yeemik' });
+    const queued = query.mock.calls.filter(c => c[1]?.action === 'queue').map(c => c[1] as any);
+    expect(queued[0]).toMatchObject({ tokenId: 'tok1', bubbleText: 'Drop your gold. Or else.', speaker: 'Yeemik' });
+    for (const q of queued.slice(1)) expect(q.bubbleText).toBeUndefined();
+
+    const second = make({ engine: 'kokoro', voice: 'bm_fable' });
+    await second.tools.handleSpeak({ text: 'Hello there.', actor: 'Goblin' });
+    const first = second.query.mock.calls.find(c => c[1]?.action === 'queue')![1] as any;
+    expect(first).toMatchObject({ actorIdentifier: 'Goblin', bubbleText: 'Hello there.' });
+    expect(first.tokenId).toBeUndefined();
+  });
+  it('sends nothing extra when no character is given', async () => {
+    const { tools, query } = make({ engine: 'kokoro', voice: 'bm_fable' });
+    await tools.handleSpeak({ text: 'Plain narration.' });
+    const q = query.mock.calls.find(c => c[1]?.action === 'queue')![1] as any;
+    expect(q.tokenId).toBeUndefined();
+    expect(q.bubbleText).toBeUndefined();
+  });
+});
diff --git a/packages/mcp-server/src/tools/speech-tools.ts b/packages/mcp-server/src/tools/speech-tools.ts

+import { afterEach, describe, expect, it, vi } from 'vitest';
+import WebSocket from 'ws';
+import { ChatFeed, feedLine } from './chat-feed.js';
+
+const logger = { info: vi.fn(), warn: vi.fn(), debug: vi.fn() };
+
+describe('feedLine', () => {
+  it('is one compact JSON line with only what is there', () => {
+    expect(JSON.parse(feedLine({ id: 'a', who: 'Claudio', as: 'Randal', kind: 'say', text: 'I attack', fromGM: false }))).toEqual({ id: 'a', who: 'Claudio', as: 'Randal', kind: 'say', text: 'I attack' });
+    expect(JSON.parse(feedLine({ id: 'b', who: 'Gamemaster', kind: 'roll', roll: { formula: '1d20', total: 7 }, flavor: 'Perception', fromGM: true }))).toEqual({ id: 'b', who: 'Gamemaster', kind: 'roll', roll: { formula: '1d20', total: 7 }, flavor: 'Perception', gm: true });
+    expect(feedLine({ id: 'c', who: 'x', kind: 'say', text: 'a\nb', fromGM: false })).not.toContain('\n');
+  });
+});
+
+describe('ChatFeed', () => {
+  let feed: ChatFeed | undefined;
+  afterEach(() => feed?.stop());
+
+  /** A fake Foundry chat: `rows` is the log, read like the module's chat read does. */
+  function setup(connected = () => true) {
+    const rows: any[] = [];
+    const query = vi.fn(async (_method: string, data: any) => {
+      const start = data.since ? rows.findIndex(r => r.id === data.since) + 1 : 0;
+      const shown = (data.since ? rows.slice(start) : rows).slice(-(data.limit ?? 15));
+      return { success: true, messages: shown, marker: rows.at(-1)?.id };
+    });
+    feed = new ChatFeed({ query, isConnected: connected, logger, port: 0, pollMs: 20 });
+    return { rows, query };
+  }
+  const connect = async (path = '') => {
+    await feed!.start();
+    const lines: any[] = [];
+    const socket = new WebSocket(`ws://127.0.0.1:${feed!.port}${path}`);
+    socket.on('message', data => lines.push(JSON.parse(String(data))));
+    await new Promise(resolve => socket.once('open', resolve));
+    return { lines, socket };
+  };
+  const until = async (check: () => boolean) => {
+    for (let i = 0; i < 100 && !check(); i++) await new Promise(r => setTimeout(r, 20));
+    expect(check()).toBe(true);
+  };
+
+  it('sends what people type after connecting: players and the GM, not what the bridge or system posts', async () => {
+    const { rows } = setup();
+    rows.push({ id: '1', who: 'Claudio', kind: 'say', text: 'old', fromGM: false });
+    const { lines } = await connect();
+    await new Promise(r => setTimeout(r, 80));
+    expect(lines).toEqual([]);
+    rows.push({ id: '2', who: 'Gamemaster', kind: 'say', text: 'typed by the GM', fromGM: true });
+    rows.push({ id: '3', who: 'Gamemaster', kind: 'say', text: 'narration from the bridge', fromGM: true, auto: true });
+    rows.push({ id: '4', who: 'Claudio', as: 'Randal', kind: 'say', text: 'I open the door', fromGM: false });
+    await until(() => lines.length >= 2);
+    await new Promise(r => setTimeout(r, 60));
+    expect(lines).toEqual([
+      { id: '2', who: 'Gamemaster', kind: 'say', text: 'typed by the GM', gm: true },
+      { id: '4', who: 'Claudio', as: 'Randal', kind: 'say', text: 'I open the door' },
+    ]);
+  });
+
+  it('sends players only with ?from=players, and handles an empty chat', async () => {
+    const { rows } = setup();
+    const { lines } = await connect('/?from=players');
+    await new Promise(r => setTimeout(r, 80));
+    rows.push({ id: '1', who: 'Gamemaster', kind: 'say', text: 'gm line', fromGM: true });
+    rows.push({ id: '2', who: 'Claudio', kind: 'say', text: 'player line', fromGM: false });
+    await until(() => lines.length >= 1);
+    await new Promise(r => setTimeout(r, 60));
+    expect(lines).toEqual([{ id: '2', who: 'Claudio', kind: 'say', text: 'player line' }]);
+  });
+
+  it('says so when Foundry is not connected, and stops reading when nobody listens', async () => {
+    let connected = false;
+    const { query } = setup(() => connected);
+    const { lines, socket } = await connect();
+    await until(() => lines.length >= 1);
+    expect(lines[0]).toMatchObject({ type: 'notice' });
+    expect(query).not.toHaveBeenCalled();
+    connected = true;
+    await until(() => query.mock.calls.length > 0);
+    socket.close();
+    await new Promise(r => setTimeout(r, 100));
+    const calls = query.mock.calls.length;
+    await new Promise(r => setTimeout(r, 100));
+    expect(query.mock.calls.length).toBe(calls);
+  });
+});
diff --git a/packages/mcp-server/src/chat-feed.ts b/packages/mcp-server/src/chat-feed.ts
new file mode 100644
index 0000000..525dfa1
--- /dev/null
+++ b/packages/mcp-server/src/chat-feed.ts
@@ -0,0 +1,158 @@
+import { WebSocketServer, type WebSocket } from 'ws';
+import type { IncomingMessage } from 'node:http';
+
+/**
+ * A live feed of the Foundry chat for anything that can read a WebSocket (in Claude Code: the Monitor tool).
+ * Each new chat message is sent as one JSON line, so a client can react to the table one message at a time without
+ * keeping a request open. It carries what people type: the players' messages and the GM's typed lines, not what the
+ * bridge or the game system post itself (narration, cards, tool rolls). Connect with ?from=players for players only.
+ * Listens on this computer only. It reads the chat through the module's `chat` query, but only while someone is connected.
+ */
+
+export interface ChatFeedOptions {
+  query: (method: string, data?: any, timeoutMs?: number) => Promise<any>;
+  isConnected: () => boolean;
+  logger: { info: (m: string, d?: any) => void; warn: (m: string, d?: any) => void; debug: (m: string, d?: any) => void };
+  port: number;
+  /** how often the chat is read while a client is connected */
+  pollMs?: number;
+}
+
+export const DEFAULT_CHAT_FEED_PORT = 31417;
+
+interface Row {
+  id: string;
+  who: string;
+  as?: string;
+  kind: string;
+  text?: string;
+  roll?: { formula: string; total: number | string };
+  flavor?: string;
+  to?: string[];
+  fromGM: boolean;
+  auto?: boolean;
+}
+
+/** One chat row as the line a client receives. */
+export function feedLine(row: Row): string {
+  const out: Record<string, unknown> = { id: row.id, who: row.who };
+  if (row.as) out.as = row.as;
+  out.kind = row.kind;
+  if (row.text) out.text = row.text;
+  if (row.roll) out.roll = row.roll;
+  if (row.flavor) out.flavor = row.flavor;
+  if (row.to) out.to = row.to;
+  if (row.fromGM) out.gm = true;
+  return JSON.stringify(out);
+}
+
+export class ChatFeed {
+  private options: ChatFeedOptions;
+  private wss: WebSocketServer | undefined;
+  private clients = new Map<WebSocket, 'players' | 'people'>();
+  private timer: ReturnType<typeof setTimeout> | undefined;
+  private marker: string | undefined;
+  private lastNotice: string | undefined;
+  private polling = false;
+
+  constructor(options: ChatFeedOptions) {
+    this.options = options;
+  }
+
+  /** The port actually listening (useful when started with port 0), or undefined when not listening. */
+  get port(): number | undefined {
+    const address = this.wss?.address();
+    return address && typeof address === 'object' ? address.port : undefined;
+  }
+
+  start(): Promise<void> {
+    return new Promise(resolve => {
+      const wss = new WebSocketServer({ host: '127.0.0.1', port: this.options.port });
+      wss.once('listening', () => {
+        this.wss = wss;
+        wss.on('connection', (socket, request) => this.onConnection(socket, request));
+        this.options.logger.info('Chat feed listening', { port: this.port });
+        resolve();
+      });
+      // Another backend may already own the port: the feed is optional, so carry on without it.
+      wss.once('error', error => {
+        this.options.logger.warn('Chat feed could not start', { error: error.message });
+        resolve();
+      });
+    });
+  }
+
+  stop(): void {
+    if (this.timer) clearTimeout(this.timer);
+    this.timer = undefined;
+    for (const client of this.clients.keys()) client.terminate();
+    this.clients.clear();
+    this.wss?.close();
+    this.wss = undefined;
+  }
+
+  private onConnection(socket: WebSocket, request: IncomingMessage): void {
+    const from = new URL(request.url ?? '/', 'http://localhost').searchParams.get('from') === 'players' ? 'players' : 'people';
+    this.clients.set(socket, from);
+    socket.on('close', () => {
+      this.clients.delete(socket);
+      if (this.clients.size === 0) {
+        if (this.timer) clearTimeout(this.timer);
+        this.timer = undefined;
+        this.marker = undefined; // the next client starts from what is new then
+      }
+    });
+    socket.on('error', () => socket.terminate());
+    if (!this.timer && !this.polling) void this.tick();
+  }
+
+  private notice(text: string): void {
+    if (this.lastNotice === text) return;
+    this.lastNotice = text;
+    this.broadcast(JSON.stringify({ type: 'notice', text }), () => true);
+  }
+
+  private broadcast(line: string, wants: (from: 'players' | 'people') => boolean): void {
+    for (const [client, from] of this.clients) {
+      if (client.readyState === 1 && wants(from)) client.send(line);
+    }
+  }
+
+  private async tick(): Promise<void> {
+    if (this.clients.size === 0) return;
+    this.polling = true;
+    try {
+      if (!this.options.isConnected()) {
+        this.notice('Foundry is not connected; the feed resumes when it is');
+      } else {
+        const first = this.marker === undefined;
+        const result = await this.options.query('foundry-mcp-bridge.chat', {
+          action: 'read',
+          from: 'all',
+          limit: first ? 1 : 50,
+          ...(first || this.marker === '' ? {} : { since: this.marker }),
+        });
+        if (result?.success === false) throw new Error(result.error || 'chat read refused');
+        if (this.lastNotice) {
+          this.lastNotice = undefined;
+          if (!first) this.broadcast(JSON.stringify({ type: 'notice', text: 'Chat feed is live again' }), () => true);
+        }
+        if (!first) {
+          for (const row of (result?.messages ?? []) as Row[]) {
+            const line = feedLine(row);
+            // Players always; the GM's lines only when typed by a person, so the bridge's own posts never wake the listener.
+            this.broadcast(line, from => (from === 'players' ? !row.fromGM : !row.auto));
+          }
+        }
+        // An empty chat has no marker yet: '' means everything that appears now is new.
+        this.marker = result?.marker ?? (first ? '' : this.marker);
+      }
+    } catch (error) {
+      this.notice(`Cannot read the chat: ${error instanceof Error ? error.message : String(error)}`);
+    } finally {
+      this.polling = false;
+      if (this.clients.size > 0) this.timer = setTimeout(() => void this.tick(), this.options.pollMs ?? 700);
+      else this.timer = undefined;
+    }
+  }
+}

+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+
+export interface RevealToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+const KINDS = ['token', 'light', 'tile', 'sound', 'drawing', 'door'] as const;
+
+const target = z
+  .object({
+    kind: z.enum(KINDS),
+    id: z.string().min(1).optional(),
+    name: z.string().min(1).optional(),
+    x: z.number().min(0).optional(),
+    y: z.number().min(0).optional(),
+    radius: z.number().min(0).max(100).optional(),
+    all: z.boolean().optional(),
+  })
+  .strict();
+
+const schema = z
+  .object({
+    scene: z.string().min(1).optional(),
+    reveal: z.array(target).max(100).optional(),
+    hide: z.array(target).max(100).optional(),
+    reset_fog: z.boolean().optional(),
+  })
+  .strict()
+  .refine(a => (a.reveal?.length ?? 0) + (a.hide?.length ?? 0) > 0 || a.reset_fog, { message: 'Give reveal, hide and/or reset_fog' });
+
+const targetSchema = {
+  type: 'array',
+  maxItems: 100,
+  items: {
+    type: 'object',
+    properties: {
+      kind: { type: 'string', enum: [...KINDS] },
+      id: { type: 'string', description: 'Exact id of the object' },
+      name: { type: 'string', description: 'tokens only: the token or actor name (exact, else part of it); all matches are changed' },
+      x: { type: 'number', description: 'Grid squares from the left (with y: objects near this point)' },
+      y: { type: 'number', description: 'Grid squares from the top' },
+      radius: { type: 'number', description: 'How near, in squares (default 1)' },
+      all: { type: 'boolean', description: 'Every object of this kind' },
+    },
+    required: ['kind'],
+    additionalProperties: false,
+  },
+};
+
+export class RevealTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: RevealToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'RevealTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'reveal',
+        description:
+          'Show or hide things on a scene for the players, whoever placed them, in one call. ' +
+          'reveal and hide are lists of targets {kind: token | light | tile | sound | drawing | door, then id, or name (tokens only), or x and y (grid squares, with optional radius), or all:true}. ' +
+          'Tokens, lights, tiles, sounds and drawings are shown or hidden; a door target reveals a secret door (it becomes a normal door) or, with hide, makes a normal door secret. ' +
+          'Examples: reveal [{kind:"token", name:"Goblin"}] shows every goblin; reveal [{kind:"door", x:12.5, y:8}] reveals the secret door there; hide [{kind:"light", all:true}] hides every light. ' +
+          'reset_fog:true clears what the players have explored on the scene being viewed. scene defaults to the scene being viewed. Targets that match nothing are listed in notFound.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            scene: { type: 'string', description: 'Scene id or exact name (default the one being viewed)' },
+            reveal: { ...targetSchema, description: 'Things to show' },
+            hide: { ...targetSchema, description: 'Things to hide' },
+            reset_fog: { type: 'boolean', description: 'Reset the explored fog of war (the scene being viewed)' },
+          },
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handleReveal(args: unknown): Promise<any> {
+    const a = schema.parse(args ?? {});
+    this.logger.info('Reveal and hide', { reveal: a.reveal?.length ?? 0, hide: a.hide?.length ?? 0 });
+    const result = await this.foundryClient.query('foundry-mcp-bridge.reveal', a);
+    if (result?.success === false) throw new Error(result.error || 'Request was refused');
+    return result;
+  }
+}

+/**
+ * Town helpers for the layout tool: a `building` composite (a walled block with doors on chosen
+ * sides), a `repeat` option that copies any shape along a step, and `doorPortals`, which lists
+ * where each door leads in and out so enterable buildings can be linked to interior maps.
+ */
+
+const SIDES = ['n', 's', 'e', 'w'] as const;
+type Side = (typeof SIDES)[number];
+
+export const MAX_REPEAT = 40;
+
+/** Fills that lie on the ground: new shapes of these go under buildings already drawn. */
+const GROUND_FILLS = ['grass', 'road', 'sand', 'water'];
+
+/**
+ * Where a batch of new shapes should go when no `after` is given: under the first building, if every
+ * new shape is ground (a road must not paint over a house). undefined means on top, as usual.
+ */
+export function groundInsertIndex(existing: Array<{ fill?: string; shape?: string }>, added: unknown[]): number | undefined {
+  if (added.length === 0) return undefined;
+  const allGround = added.every(s => {
+    const f = (s as any)?.fill;
+    return typeof f === 'string' && GROUND_FILLS.includes(f) && (s as any)?.shape !== 'door';
+  });
+  if (!allGround) return undefined;
+  const i = existing.findIndex(s => s.fill === 'building' && s.shape !== 'door');
+  return i >= 0 ? i : undefined;
+}
+
+const isNum = (v: unknown): v is number => typeof v === 'number' && Number.isFinite(v);
+
+function pair(v: unknown, label: string, what: string): [number, number] {
+  if (!Array.isArray(v) || v.length !== 2 || !isNum(v[0]) || !isNum(v[1])) {
+    throw new Error(`${label}: ${what} must be two numbers`);
+  }
+  return [v[0], v[1]];
+}
+
+/** The door shapes for one building: doors sit on the wall line of the chosen side. */
+function buildingDoors(rect: [number, number, number, number], doors: unknown, label: string): any[] {
+  if (doors === undefined) return [];
+  if (!Array.isArray(doors)) throw new Error(`${label}: doors must be a list`);
+  const [x, y, w, h] = rect;
+  return doors.map((raw, i) => {
+    const where = `${label}.doors[${i}]`;
+    if (!raw || typeof raw !== 'object') throw new Error(`${where}: must be an object`);
+    const d: any = raw;
+    if (!SIDES.includes(d.side)) throw new Error(`${where}: side must be n, s, e or w`);
+    const side: Side = d.side;
+    const size = d.size ?? 1;
+    if (!isNum(size) || size <= 0) throw new Error(`${where}: size must be above 0`);
+    const run = side === 'n' || side === 's' ? w : h;
+    if (size > run) throw new Error(`${where}: the door is longer than the wall`);
+    // offset is measured along the wall from its start (west end or north end); default centred
+    const offset = d.offset ?? Math.floor((run - size) / 2);
+    if (!isNum(offset) || offset < 0 || offset + size > run + 1e-9) {
+      throw new Error(`${where}: offset ${offset} puts the door outside the wall (0 to ${run - size})`);
+    }
+    const door: any = { shape: 'door', size };
+    if (side === 'n') Object.assign(door, { at: [x + offset, y], dir: 'h' });
+    else if (side === 's') Object.assign(door, { at: [x + offset, y + h], dir: 'h' });
+    else if (side === 'w') Object.assign(door, { at: [x, y + offset], dir: 'v' });
+    else Object.assign(door, { at: [x + w, y + offset], dir: 'v' });
+    if (d.secret !== undefined) door.secret = d.secret;
+    if (d.state !== undefined) door.state = d.state;
+    return door;
+  });
+}
+
+function shiftShape(raw: any, dx: number, dy: number): any {
+  const s = { ...raw };
+  const move = (p: unknown) => (Array.isArray(p) ? [p[0] + dx, p[1] + dy] : p);
+  if (s.rect) s.rect = [s.rect[0] + dx, s.rect[1] + dy, s.rect[2], s.rect[3]];
+  if (s.ellipse) s.ellipse = [s.ellipse[0] + dx, s.ellipse[1] + dy, s.ellipse[2], s.ellipse[3]];
+  if (s.center) s.center = move(s.center);
+  if (s.at) s.at = move(s.at);
+  if (s.polygon) s.polygon = s.polygon.map(move);
+  if (s.path) s.path = s.path.map(move);
+  if (s.cells) s.cells = s.cells.map((c: number[]) => [c[0]! + dx, c[1]! + dy, c[2], c[3]]);
+  return s;
+}
+
+/**
+ * Turn the shapes asked for into plain layout shapes. A `building` becomes its walled block plus
+ * its doors; `repeat: {count, step: [dx, dy]}` makes count copies in total, each moved by step.
+ */
+export function expandShapeSpecs(raws: unknown[]): unknown[] {
+  const out: unknown[] = [];
+  raws.forEach((raw, i) => {
+    const label = `shapes[${i}]`;
+    if (!raw || typeof raw !== 'object') {
+      out.push(raw);
+      return;
+    }
+    const { repeat, ...base } = raw as any;
+    let copies: any[] = [base];
+    if (repeat !== undefined) {
+      if (!repeat || typeof repeat !== 'object') throw new Error(`${label}: repeat must be {count, step}`);
+      const count = repeat.count;
+      if (!Number.isInteger(count) || count < 1 || count > MAX_REPEAT) {
+        throw new Error(`${label}: repeat.count must be a whole number from 1 to ${MAX_REPEAT}`);
+      }
+      const [dx, dy] = pair(repeat.step, label, 'repeat.step [dx, dy]');
+      copies = Array.from({ length: count }, (_, k) => shiftShape(base, dx * k, dy * k));
+    }
+    for (const copy of copies) {
+      if (copy.shape !== 'building') {
+        out.push(copy);
+        continue;
+      }
+      const { doors, shape: _shape, ...rest } = copy;
+      let rect = rest.rect;
+      if (!rect && rest.at !== undefined && rest.size !== undefined) {
+        const at = pair(rest.at, label, 'at [column, row]');
+        const size = pair(rest.size, label, 'size [width, height]');
+        rect = [at[0], at[1], size[0], size[1]];
+        delete rest.at;
+        delete rest.size;
+      }
+      if (!Array.isArray(rect) || rect.length !== 4 || !rect.every(isNum)) {
+        throw new Error(`${label}: a building needs rect [x, y, width, height]`);
+      }
+      if (rect[2]! <= 0 || rect[3]! <= 0) throw new Error(`${label}: building width and height must be above 0`);
+      out.push({ ...rest, shape: 'rect', rect, fill: rest.fill ?? 'building' });
+      out.push(...buildingDoors(rect as [number, number, number, number], doors, label));
+    }
+  });
+  return out;
+}
+
+export interface PortalShape {
+  id?: number;
+  shape: string;
+  fill?: string;
+  rect?: number[];
+  at?: number[];
+  dir?: string;
+  size?: number;
+  secret?: boolean;
+  state?: string;
+  label?: number;
+}
+
+export interface Portal {
+  door: number | null;
+  /** Centre of the door, in squares. */
+  centre: [number, number];
+  /** A square just outside the building, and one just inside, as the centre of each square. */
+  outside: [number, number];
+  inside: [number, number];
+  /** The rect shape the door belongs to, when one can be found. */
+  building: number | null;
+  buildingLabel: number | null;
+  secret: boolean;
+  state: string;
+}
+
+const near = (a: number, b: number) => Math.abs(a - b) < 0.3;
+
+/** Where every door leads: the square outside, the square inside and the building it is part of. */
+export function doorPortals(shapes: PortalShape[]): Portal[] {
+  const rects = shapes.filter(s => s.shape === 'rect' && s.rect && s.fill !== 'door');
+  const portals: Portal[] = [];
+  for (const s of shapes) {
+    if (s.shape !== 'door' || !s.at) continue;
+    const len = s.size ?? 1;
+    const horizontal = s.dir === 'h';
+    const [x, y] = s.at as [number, number];
+    const centre: [number, number] = horizontal ? [x + len / 2, y] : [x, y + len / 2];
+    // The square in front of the door: the middle one of those it covers (the first of two).
+    const along = (start: number) => Math.floor(start) + Math.floor((len - 1) / 2) + 0.5;
+    // The building is the last rect whose edge the door sits on, and whose span covers the door.
+    let owner: PortalShape | undefined;
+    let side: Side | undefined;
+    for (const r of rects) {
+      const [rx, ry, rw, rh] = r.rect as number[];
+      const spansX = centre[0] > rx! - 1e-9 && centre[0] < rx! + rw! + 1e-9;
+      const spansY = centre[1] > ry! - 1e-9 && centre[1] < ry! + rh! + 1e-9;
+      let found: Side | undefined;
+      if (horizontal && spansX) {
+        if (near(y, ry!)) found = 'n';
+        else if (near(y, ry! + rh!)) found = 's';
+      } else if (!horizontal && spansY) {
+        if (near(x, rx!)) found = 'w';
+        else if (near(x, rx! + rw!)) found = 'e';
+      }
+      if (found) {
+        owner = r;
+        side = found;
+      }
+    }
+    let outside: [number, number];
+    let inside: [number, number];
+    const cell = (v: number) => Math.floor(v) + 0.5;
+    if (side === 'n') [outside, inside] = [[along(x), Math.round(y) - 0.5], [along(x), Math.round(y) + 0.5]];
+    else if (side === 's') [outside, inside] = [[along(x), Math.round(y) + 0.5], [along(x), Math.round(y) - 0.5]];
+    else if (side === 'w') [outside, inside] = [[Math.round(x) - 0.5, along(y)], [Math.round(x) + 0.5, along(y)]];
+    else if (side === 'e') [outside, inside] = [[Math.round(x) + 0.5, along(y)], [Math.round(x) - 0.5, along(y)]];
+    else if (horizontal) [outside, inside] = [[along(x), Math.round(y) - 0.5], [along(x), Math.round(y) + 0.5]];
+    else [outside, inside] = [[Math.round(x) - 0.5, along(y)], [Math.round(x) + 0.5, along(y)]];
+    portals.push({
+      door: s.id ?? null,
+      centre,
+      outside,
+      inside,
+      building: owner?.id ?? null,
+      buildingLabel: owner?.label ?? null,
+      secret: !!s.secret,
+      state: s.state ?? 'closed',
+    });
+  }
+  return portals;
+}
diff --git a/packages/mcp-server/src/tools/layout-utils.ts b/packages/mcp-server/src/tools/layout-utils.ts

index 0000000..d6abab3
--- /dev/null
+++ b/packages/mcp-server/src/tools/speech-tools.ts
@@ -0,0 +1,471 @@
+import { randomInt } from 'crypto';
+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+import {
+  audioSeconds,
+  buildSpeechWorkflow,
+  estimateSeconds,
+  nodeForEngine,
+  nodeInputDefaults,
+  normalizeSpeechSettings,
+  slugify,
+  SPEECH_ENGINES,
+  groupSpeech,
+  splitSpeechSegments,
+  startDelayMs,
+  type SpeechEngine,
+} from '../speech.js';
+import type { SayLane } from '../say-lane.js';
+import { getServerJson, pcmSeconds, pcmToWav, sliceWords, streamSpeech } from '../tts-stream.js';
+
+/** The part of the ComfyUI client that speech needs. */
+export interface SpeechComfyClient {
+  runAudioWorkflow(workflow: Record<string, any>, options?: { timeoutMs?: number }): Promise<{ audio: Buffer; filename: string; promptId: string }>;
+  getNodeInfo(classType: string): Promise<any | null>;
+  /** The address of the ComfyUI the client talks to, which also carries the streaming narration server. */
+  getBaseUrl(): string;
+}
+
+export interface SpeechToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+  /** The ComfyUI client, already pointed at the chosen ComfyUI by applyTarget. */
+  getClient: () => SpeechComfyClient;
+  /** Point the client at the ComfyUI the module's settings choose. */
+  applyTarget: (rawTarget: unknown) => void;
+  /** The table queue: when given, speak returns at once and speeches play one after the other. */
+  lane?: SayLane;
+}
+
+const UPLOAD_TIMEOUT_MS = 120000;
+const SPEECH_TIMEOUT_MS = 5 * 60 * 1000;
+
+/**
+ * Streamed audio is queued in growing pieces: the first one is small so playback starts at once, and each
+ * next one is at most about 1.4 times the last, so generating it (about 1.6 times faster than speech) is done before the previous one has played.
+ */
+const MAX_SEGMENT_SECONDS = 4;
+/** Extra wait before the first streamed piece plays, to build a small lead over the uploads that follow. */
+const FAST_PREROLL_MS = 600;
+function nextSegmentSeconds(last: number, growth: number): number {
+  return Math.min(MAX_SEGMENT_SECONDS, Math.round(last * growth * 100) / 100);
+}
+
+/**
+ * Piece sizes for a streaming speed of `rate` seconds of audio per second of waiting (about 1.7 on an idle GPU,
+ * less when the GPU is busy with something else). A slower server needs a bigger first piece, and pieces that grow
+ * more slowly, so each next piece is ready before the previous one has finished playing.
+ */
+export function segmentPlan(rate: number): { first: number; growth: number } {
+  return {
+    first: Math.round(Math.min(2, Math.max(0.9, 0.9 + (1.7 - rate) * 1.4)) * 100) / 100,
+    growth: Math.min(1.4, Math.max(1, rate * 0.9)),
+  };
+}
+
+const schema = z
+  .object({
+    action: z.enum(['say', 'describe', 'stop', 'status']).optional(),
+    text: z.string().min(1).max(1500).optional(),
+    voice: z.string().min(1).max(300).optional(),
+    style: z.string().min(1).max(300).optional(),
+    language: z.string().min(1).max(40).optional(),
+    speed: z.number().min(0.5).max(2).optional(),
+    engine: z.enum(SPEECH_ENGINES).optional(),
+    speaker_name: z.string().min(1).max(60).optional(),
+    token_id: z.string().min(1).max(40).optional(),
+    actor: z.string().min(1).max(80).optional(),
+    chat: z.boolean().optional(),
+    seed: z.number().int().min(0).optional(),
+  })
+  .strict();
+
+export class SpeechTools {
+  /** How fast the streaming server has been lately (seconds of audio per second of waiting, uploads included), learned from each narration. */
+  private fastRate = 1.2;
+  /** How long a word of narration lasts, learned from what was spoken, to spread the chat text over the audio of a streamed paragraph. */
+  private secondsPerWord = 0.42;
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+  private getClient: () => SpeechComfyClient;
+  private applyTarget: (raw: unknown) => void;
+  private lane: SayLane | undefined;
+
+  constructor(options: SpeechToolsOptions) {
+    this.foundryClient = options.foundryClient;
+    this.logger = options.logger.child({ component: 'SpeechTools' });
+    this.getClient = options.getClient;
+    this.applyTarget = options.applyTarget;
+    this.lane = options.lane;
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'speak',
+        description:
+          'Narrate or voice a line aloud for the whole table. It makes the speech with the GM\'s ComfyUI (the same one used for images), uploads the audio to the Foundry world, plays it for every connected player, and shows the words in the chat revealed in time with the audio. ' +
+          'say {text, voice?, style?, language?, speed?, engine?, speaker_name?, chat?} speaks the text (up to 1500 characters, a paragraph or two): the engine, voice, style and speed default to what the GM set in the module settings (Narration). ' +
+          'Engines: qwen3-fast (the best voice, streams while it generates: starts within about a second; needs the claude_tts node in ComfyUI; presets such as Ryan, "style" says how to speak), kokoro (fast, a few seconds per paragraph; voice is an id like bm_fable or af_heart), qwen3-custom (slower, preset voices such as Ryan or Serena, "style" says how to speak), qwen3-design (slowest; "voice" is a description such as "a gruff old dwarf with a Scottish accent"). ' +
+          'speaker_name is the label in the chat (default Narrator, or the NPC\'s name); token_id or actor makes it a character speaking: its name and portrait in the chat and the whole line as a speech bubble over its token when the audio starts; chat:false plays the audio without the chat text. ' +
+          'The text is spoken sentence by sentence: the first sentence starts playing as soon as it is ready (about a second with kokoro or qwen3-fast) while the rest is generated, and each sentence appears in the chat as it is spoken. The call returns at once with {queued, position}: speeches play one after the other in the order the calls were sent (and chat narrate/say and roll request cards wait for the speech before them), so send narration, an NPC line and a roll request in one message without waiting. A failure while generating later shows as a notice on the table feed. Write text to be heard: no stage directions, no markup, and spell out what should be said. Do not speak secrets or GM notes. ' +
+          'describe shows the settings, which engines this ComfyUI can run and their voices; stop silences the narration now. Needs ComfyUI running with a text-to-speech node (Kokoro or Qwen3-TTS) and Allow Write Operations.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: { type: 'string', enum: ['say', 'describe', 'stop', 'status'], description: 'say (default), describe, stop (silences and empties the table queue) or status (what is queued)' },
+            text: { type: 'string', description: 'say: what to speak (max 1500 characters)' },
+            voice: { type: 'string', description: 'say: the voice (kokoro id, qwen3 preset, or for qwen3-design a description). Default: the setting' },
+            style: { type: 'string', description: 'say: how to speak it (qwen3-custom), or the voice description for qwen3-design when voice is empty' },
+            language: { type: 'string', description: 'say: language, or auto (default)' },
+            speed: { type: 'number', description: 'say: kokoro speed, 0.5 to 2 (default 1)' },
+            engine: { type: 'string', enum: ['qwen3-fast', 'kokoro', 'qwen3-custom', 'qwen3-design'], description: 'say: override the engine' },
+            speaker_name: { type: 'string', description: 'say: the name shown in the chat (default Narrator)' },
+            token_id: { type: 'string', description: 'say: speak as this token on the scene: the chat line carries it and a speech bubble shows over it' },
+            actor: { type: 'string', description: 'say: speak as this actor (name or id), using its token on the scene for the bubble. Ignored when token_id is given' },
+            chat: { type: 'boolean', description: 'say: show the words in chat in time with the audio (default: the setting)' },
+            seed: { type: 'number', description: 'say: a fixed seed for qwen3 engines, to repeat a take' },
+          },
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handleSpeak(args: unknown): Promise<any> {
+    const a = schema.parse(args ?? {});
+    const action = a.action ?? 'say';
+    if (action === 'stop') {
+      const dropped = this.lane?.clear() ?? 0;
+      const result = await this.foundryClient.query('foundry-mcp-bridge.speak', { action: 'stop' });
+      return dropped > 0 ? { ...result, cleared_from_queue: dropped } : result;
+    }
+    if (action === 'describe') return this.describe();
+    if (action === 'status') return { success: true, queued_items: this.lane?.busy ?? 0 };
+    if (!a.text?.trim()) throw new Error('say needs text');
+    const lane = this.lane;
+    if (!lane) return this.say(a);
+    const label = `speak "${a.text.trim().slice(0, 40)}"`;
+    return lane.speech(label, epoch => this.say(a, epoch));
+  }
+
+  private async readSettings(): Promise<{ target: unknown; settings: ReturnType<typeof normalizeSpeechSettings> }> {
+    const result = await this.foundryClient.query('foundry-mcp-bridge.get-speech-settings', {});
+    if (result?.success === false || result?.error) throw new Error(result.error || 'Could not read the narration settings');
+    return { target: result?.target, settings: normalizeSpeechSettings(result?.settings) };
+  }
+
+  private async say(a: z.infer<typeof schema>, epoch?: number): Promise<any> {
+    const cancelled = () => epoch !== undefined && this.lane?.cancelled(epoch) === true;
+    if (cancelled()) return { success: true, cancelled: true };
+    if (!a.text?.trim()) throw new Error('say needs text');
+    const { target, settings } = await this.readSettings();
+    this.applyTarget(target);
+    const client = this.getClient();
+
+    const engine: SpeechEngine = a.engine ?? settings.engine;
+    if (engine === 'qwen3-fast') return this.sayFast(a, settings, client, epoch);
+    const node = nodeForEngine(engine)!;
+    const info = await client.getNodeInfo(node);
+    if (!info) {
+      throw new Error(
+        `The "${engine}" engine needs the ComfyUI node ${node}, which this ComfyUI does not have. ` +
+          (engine === 'kokoro' ? 'Install comfyui-kokoro, or' : 'Install ComfyUI-Qwen-TTS, or') +
+          ' pick another engine in the module settings (Narration) or with the engine argument.'
+      );
+    }
+
+    // A voice from another engine (the setting is for kokoro, the call asks for qwen3) falls back to what suits the engine.
+    const voice = a.voice ?? (engine === settings.engine ? settings.voice : engine === 'kokoro' ? 'bm_fable' : engine === 'qwen3-custom' ? 'Ryan' : '');
+    const checked = await this.checkVoice(engine, voice, client);
+    const defaults = engine === 'kokoro' ? {} : nodeInputDefaults(info);
+    const seed = a.seed ?? randomInt(0, 2 ** 31 - 1);
+    const text = a.text.trim();
+    const pieces = splitSpeechSegments(text);
+    const utterance = `${Date.now().toString(36)}${randomInt(0, 1679616).toString(36)}`;
+    const speaker = a.speaker_name ?? 'Narrator';
+    const sync = a.chat ?? settings.syncText;
+
+    this.logger.info('Generating speech', { engine, voice: checked, characters: text.length, pieces: pieces.length });
+    const started = Date.now();
+
+    // One piece at a time: each is uploaded and queued in Foundry as soon as it exists, so the first can start
+    // playing while the rest is still being made.
+    let firstAudioMs: number | undefined;
+    let bufferMs = 0;
+    let totalAudio = 0;
+    let lengthsKnown = true;
+    let lastPath: string | undefined;
+    let messageId: string | undefined;
+    for (let index = 0; index < pieces.length; index++) {
+      if (cancelled()) return { success: true, cancelled: true };
+      const piece = pieces[index]!;
+      const pieceStart = Date.now();
+      const request = { engine, text: piece, voice: checked, language: a.language ?? settings.language, speed: a.speed ?? settings.speed, style: a.style ?? settings.style, seed: seed + index };
+      let result;
+      try {
+        result = await client.runAudioWorkflow(buildSpeechWorkflow(request, defaults), { timeoutMs: SPEECH_TIMEOUT_MS });
+      } catch (error) {
+        await this.stopQuietly();
+        throw new Error(`Speech generation failed${index > 0 ? ` at part ${index + 1} of ${pieces.length}` : ''}: ${error instanceof Error ? error.message : String(error)}`);
+      }
+      const length = audioSeconds(result.audio);
+      if (length === null) lengthsKnown = false;
+      const seconds = length ?? estimateSeconds(piece);
+      totalAudio += seconds;
+
+      const ext = result.filename.split('.').pop()?.toLowerCase() || 'flac';
+      const filename = `${slugify(piece, 30)}-${utterance}-${index}.${ext}`;
+      let uploaded: any;
+      try {
+        uploaded = await this.foundryClient.query(
+          'foundry-mcp-bridge.upload-file',
+          { filename, imageData: result.audio.toString('base64'), folder: 'generated/speech' },
+          UPLOAD_TIMEOUT_MS
+        );
+        if (uploaded?.success === false) throw new Error(uploaded.error || 'Upload was refused');
+      } catch (error) {
+        await this.stopQuietly();
+        throw new Error(`The speech was generated but uploading part ${index + 1} to Foundry failed: ${error instanceof Error ? error.message : String(error)}`);
+      }
+      lastPath = uploaded?.path;
+
+      if (index === 0) {
+        firstAudioMs = Date.now() - started;
+        bufferMs = startDelayMs(pieces, seconds, Date.now() - pieceStart);
+      }
+      const queued = await this.foundryClient.query('foundry-mcp-bridge.speak', {
+        action: 'queue',
+        id: utterance,
+        index,
+        path: uploaded?.path,
+        text: piece,
+        audioSeconds: seconds,
+        speaker,
+        sync,
+        ...(index === 0 ? { startDelayMs: bufferMs } : {}),
+        ...this.speakerFields(a, text, index),
+      });
+      if (queued?.success === false) {
+        await this.stopQuietly();
+        throw new Error(queued.error || 'Foundry could not play the speech');
+      }
+      if (queued?.messageId) messageId = queued.messageId;
+    }
+    await this.foundryClient.query('foundry-mcp-bridge.speak', { action: 'end', id: utterance });
+
+    return {
+      success: true,
+      engine,
+      voice: checked || undefined,
+      parts: pieces.length,
+      first_audio_ready_in_seconds: Math.round((firstAudioMs ?? 0) / 100) / 10,
+      generated_in_seconds: Math.round((Date.now() - started) / 100) / 10,
+      audio_seconds: Math.round(totalAudio * 10) / 10,
+      ...(bufferMs > 0 ? { buffered_seconds: Math.round(bufferMs / 100) / 10, note: 'This engine generates slower than speech, so the start was held back to avoid gaps' } : {}),
+      ...(lengthsKnown ? {} : { note: 'Some audio lengths were estimated from the words' }),
+      path: lastPath,
+      ...(messageId ? { message_id: messageId } : {}),
+      playing: 'The audio is queued in Foundry and plays on its own; this call returns when everything is queued, not when it finishes playing',
+    };
+  }
+
+  /** The streaming engine: sentence by sentence, each streamed from the narration server and queued in Foundry in growing pieces. */
+  private async sayFast(a: z.infer<typeof schema>, settings: ReturnType<typeof normalizeSpeechSettings>, client: SpeechComfyClient, epoch?: number): Promise<any> {
+    const cancelled = () => epoch !== undefined && this.lane?.cancelled(epoch) === true;
+    const baseUrl = client.getBaseUrl();
+    let voices: any;
+    try {
+      voices = await getServerJson(baseUrl, '/voices');
+    } catch (error) {
+      throw new Error(`The qwen3-fast engine needs the claude_tts node in ComfyUI: ${error instanceof Error ? error.message : String(error)}`);
+    }
+    const speakers: string[] = voices?.speakers ?? [];
+    const wanted = a.voice ?? (settings.engine === 'qwen3-fast' ? settings.voice : 'Ryan');
+    const voice = speakers.find(v => v.toLowerCase() === wanted.toLowerCase());
+    if (!voice) throw new Error(`"${wanted}" is not a qwen3-fast voice. Available: ${speakers.join(', ')}`);
+
+    const language = (a.language ?? settings.language) === 'auto' ? 'English' : (a.language ?? settings.language);
+    const instruct = a.style ?? settings.style;
+    const text = a.text!.trim();
+    const pieces = groupSpeech(text);
+    const seed = a.seed ?? randomInt(0, 2 ** 31 - 1);
+    const utterance = `${Date.now().toString(36)}${randomInt(0, 1679616).toString(36)}`;
+    const speaker = a.speaker_name ?? 'Narrator';
+    const sync = a.chat ?? settings.syncText;
+    this.logger.info('Streaming speech', { voice, characters: text.length, pieces: pieces.length });
+
+    const started = Date.now();
+    let firstAudioMs: number | undefined;
+    let totalAudio = 0;
+    let segmentIndex = 0;
+    let lastPath: string | undefined;
+    let messageId: string | undefined;
+
+    // Uploads and queueing run in the background, in order, while the next audio keeps streaming in: waiting for
+    // each upload before reading on is what leaves gaps in the playback.
+    let sendChain: Promise<void> = Promise.resolve();
+    let sendError: unknown;
+    const queue = (pcm: Buffer, rate: number, segmentText: string): void => {
+      const seconds = pcmSeconds(pcm, rate);
+      const index = segmentIndex++;
+      totalAudio += seconds;
+      const filename = `${slugify(text, 30)}-${utterance}-${index}.wav`;
+      sendChain = sendChain.then(async () => {
+        if (sendError) return;
+        try {
+          let uploaded: any;
+          try {
+            uploaded = await this.foundryClient.query('foundry-mcp-bridge.upload-file', { filename, imageData: pcmToWav(pcm, rate).toString('base64'), folder: 'generated/speech' }, UPLOAD_TIMEOUT_MS);
+            if (uploaded?.success === false) throw new Error(uploaded.error || 'Upload was refused');
+          } catch (error) {
+            throw new Error(`The speech was generated but uploading it to Foundry failed: ${error instanceof Error ? error.message : String(error)}`);
+          }
+          lastPath = uploaded?.path;
+          const queued = await this.foundryClient.query('foundry-mcp-bridge.speak', {
+            action: 'queue',
+            id: utterance,
+            index,
+            path: uploaded?.path,
+            text: segmentText,
+            audioSeconds: seconds,
+            speaker,
+            sync,
+            ...(index === 0 ? { startDelayMs: FAST_PREROLL_MS } : {}),
+            ...this.speakerFields(a, text, index),
+          });
+          if (queued?.success === false) throw new Error(queued.error || 'Foundry could not play the speech');
+          if (queued?.messageId) messageId = queued.messageId;
+          if (firstAudioMs === undefined) firstAudioMs = Date.now() - started;
+        } catch (error) {
+          sendError = error;
+        }
+      });
+    };
+
+    const plan = segmentPlan(this.fastRate);
+    let target = plan.first; // keeps growing across sentences
+    try {
+      for (const piece of pieces) {
+        if (sendError || cancelled()) break;
+        const words = piece.split(/\s+/).length;
+        const expected = Math.max(1, words * this.secondsPerWord);
+        const stream = await streamSpeech(baseUrl, { text: piece, mode: 'custom', speaker: voice, instruct, language, model: '1.7B', chunk_size: 6, seed, temperature: 0.7 });
+        let pending: Buffer[] = [];
+        let pendingBytes = 0;
+        let spoken = 0; // seconds of this sentence already queued
+        const flush = (final: boolean) => {
+          const pcm = Buffer.concat(pending);
+          pending = [];
+          pendingBytes = 0;
+          if (pcm.length === 0) return;
+          const seconds = pcmSeconds(pcm, stream.sampleRate);
+          const from = spoken / expected;
+          spoken += seconds;
+          queue(pcm, stream.sampleRate, sliceWords(piece, from, final ? 1 : spoken / expected));
+          target = nextSegmentSeconds(target, plan.growth);
+        };
+        for await (const chunk of stream.chunks) {
+          pending.push(chunk);
+          pendingBytes += chunk.length;
+          if (pendingBytes / 2 / stream.sampleRate >= target) flush(false);
+          if (sendError || cancelled()) break;
+        }
+        if (cancelled()) break;
+        flush(true);
+        if (spoken > 0) this.secondsPerWord = Math.max(0.2, Math.min(0.9, (this.secondsPerWord + spoken / words) / 2));
+      }
+      await sendChain;
+      if (sendError) throw sendError;
+      if (cancelled()) return { success: true, cancelled: true };
+    } catch (error) {
+      await this.stopQuietly();
+      throw new Error(`Speech generation failed: ${error instanceof Error ? error.message : String(error)}`);
+    }
+    await this.foundryClient.query('foundry-mcp-bridge.speak', { action: 'end', id: utterance });
+    const waited = (Date.now() - started) / 1000;
+    if (totalAudio >= 3 && waited > 0) this.fastRate = Math.min(2.5, Math.max(0.8, (this.fastRate + totalAudio / waited) / 2));
+
+    return {
+      success: true,
+      engine: 'qwen3-fast',
+      voice,
+      parts: segmentIndex,
+      first_audio_ready_in_seconds: Math.round((firstAudioMs ?? 0) / 100) / 10,
+      generated_in_seconds: Math.round((Date.now() - started) / 100) / 10,
+      audio_seconds: Math.round(totalAudio * 10) / 10,
+      ...(firstAudioMs !== undefined && firstAudioMs > 15000 ? { note: 'The first narration after a start loads the model, which takes about half a minute; later ones start within a second' } : {}),
+      path: lastPath,
+      ...(messageId ? { message_id: messageId } : {}),
+      playing: 'The audio is queued in Foundry and plays on its own; this call returns when everything is queued, not when it finishes playing',
+    };
+  }
+
+  private async describeFast(client: SpeechComfyClient): Promise<any> {
+    try {
+      const voices = await getServerJson(client.getBaseUrl(), '/voices');
+      return { available: true, voices: voices.speakers, languages: voices.languages };
+    } catch (error) {
+      return { available: false, needs: 'the claude_tts custom node in ComfyUI', detail: error instanceof Error ? error.message : String(error) };
+    }
+  }
+
+  /** Who the line is spoken as (a token or actor on the scene), and the full line for the speech bubble that shows when the audio starts. */
+  private speakerFields(a: z.infer<typeof schema>, text: string, index: number): Record<string, string> {
+    const who = a.token_id ? { tokenId: a.token_id } : a.actor ? { actorIdentifier: a.actor } : null;
+    return who ? { ...who, ...(index === 0 ? { bubbleText: text } : {}) } : {};
+  }
+
+  private async stopQuietly(): Promise<void> {
+    try {
+      await this.foundryClient.query('foundry-mcp-bridge.speak', { action: 'stop' });
+    } catch {
+      // Best effort: the error being reported matters more.
+    }
+  }
+
+  /** The voice to use, checked against what the node offers, case-insensitively. */
+  private async checkVoice(engine: SpeechEngine, voice: string, client: SpeechComfyClient): Promise<string> {
+    if (engine === 'qwen3-design') return voice;
+    const nodeName = engine === 'kokoro' ? 'KokoroSpeaker' : 'FB_Qwen3TTSCustomVoice';
+    const field = engine === 'kokoro' ? 'speaker_name' : 'speaker';
+    const info = await client.getNodeInfo(nodeName);
+    const choices = (info?.input?.required?.[field]?.[0] ?? []) as string[];
+    if (!Array.isArray(choices) || choices.length === 0) return voice;
+    const found = choices.find(c => c.toLowerCase() === voice.toLowerCase());
+    if (found) return found;
+    throw new Error(`"${voice}" is not a ${engine} voice. Available: ${choices.slice(0, 40).join(', ')}${choices.length > 40 ? ', ...' : ''}`);
+  }
+
+  private async describe(): Promise<any> {
+    const { target, settings } = await this.readSettings();
+    this.applyTarget(target);
+    const client = this.getClient();
+    const engines: Record<string, any> = {};
+    for (const engine of SPEECH_ENGINES) {
+      if (engine === 'qwen3-fast') {
+        engines[engine] = await this.describeFast(client);
+        continue;
+      }
+      const info = await client.getNodeInfo(nodeForEngine(engine)!);
+      if (!info) {
+        engines[engine] = { available: false, needs: nodeForEngine(engine) };
+        continue;
+      }
+      if (engine === 'qwen3-design') {
+        engines[engine] = { available: true, voices: 'any description, passed as voice' };
+        continue;
+      }
+      const voices = await this.checkVoiceList(engine, client);
+      engines[engine] = { available: true, voices };
+    }
+    return { success: true, settings, engines };
+  }
+
+  private async checkVoiceList(engine: SpeechEngine, client: SpeechComfyClient): Promise<string[]> {
+    const info = await client.getNodeInfo(engine === 'kokoro' ? 'KokoroSpeaker' : 'FB_Qwen3TTSCustomVoice');
+    const choices = info?.input?.required?.[engine === 'kokoro' ? 'speaker_name' : 'speaker']?.[0];
+    return Array.isArray(choices) ? choices : [];
+  }
+}

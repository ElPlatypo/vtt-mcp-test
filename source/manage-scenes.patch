+/**
+ * Listens to the table on the GM's client and records short events (see table-watch-utils) that
+ * the MCP server reads with the table-events query, bundles, and hands to the AI GM. Recording is
+ * cheap and local; nothing is sent anywhere until the server asks.
+ */
+import { MODULE_ID } from './constants.js';
+import { getGridGeometry, pixelsToSquares } from './scene-objects-utils.js';
+import { combatSummary, partySummary } from './table-utils.js';
+import { TableEventBuffer, chatEvent, damageNotAppliedEvent, damageRollTargets, doorEvent, hpEvent, moveEvent, presenceEvent, turnEvent, type NewTableEvent } from './table-watch-utils.js';
+
+export const TABLE_WATCH_MUTED = 'tableWatchMuted';
+export const TABLE_WATCH_DOORS = 'tableWatchWakeOnDoors';
+
+class TableWatcher {
+  readonly buffer = new TableEventBuffer();
+  private registered = false;
+  private lastCombatant: string | undefined;
+
+  private get g(): any {
+    return (globalThis as any).game;
+  }
+
+  private userName = (id: string): string | undefined => this.g?.users?.get?.(id)?.name;
+  private isGMUser = (id: string): boolean => !!this.g?.users?.get?.(id)?.isGM;
+
+  private setting(key: string, fallback: any): any {
+    try {
+      return this.g?.settings?.get?.(MODULE_ID, key) ?? fallback;
+    } catch {
+      return fallback;
+    }
+  }
+
+  private record(event: NewTableEvent | null): void {
+    if (event) this.buffer.push(event);
+  }
+
+  /** Changes made by a player (not a GM, so never the bridge or the GM's own tools). */
+  private byPlayer(userId: string | undefined): string | undefined {
+    if (!userId || this.isGMUser(userId)) return undefined;
+    return this.userName(userId) ?? 'a player';
+  }
+
+  private safely(what: string, fn: () => void): void {
+    try {
+      fn();
+    } catch (error) {
+      console.warn(`[${MODULE_ID}] table watch: could not record ${what}`, error);
+    }
+  }
+
+  /** Hook into Foundry; call once, on the GM's client. */
+  register(): void {
+    if (this.registered) return;
+    this.registered = true;
+    const Hooks = (globalThis as any).Hooks;
+    const ctx = { moduleId: MODULE_ID, userName: this.userName, isGMUser: this.isGMUser };
+
+    Hooks.on('createChatMessage', (message: any) =>
+      this.safely('a chat message', () => {
+        this.record(chatEvent(message, ctx));
+        this.watchDamage(message);
+      })
+    );
+
+    Hooks.on('updateCombat', (combat: any, changed: any) =>
+      this.safely('a turn', () => {
+        if (!combat?.started) return;
+        if (!('turn' in (changed ?? {})) && !('round' in (changed ?? {}))) return;
+        const previous = this.lastCombatant;
+        this.lastCombatant = combat.combatant?.name;
+        this.record(turnEvent(combat, previous && previous !== this.lastCombatant ? previous : undefined));
+      })
+    );
+    Hooks.on('combatStart', (combat: any) =>
+      this.safely('combat start', () => {
+        this.lastCombatant = combat?.combatant?.name;
+        this.record({ kind: 'combat', wake: false, text: 'Combat started', key: 'combat' });
+      })
+    );
+    Hooks.on('deleteCombat', () =>
+      this.safely('combat end', () => {
+        this.lastCombatant = undefined;
+        this.record({ kind: 'combat', wake: false, text: 'Combat ended', key: 'combat' });
+      })
+    );
+
+    Hooks.on('updateToken', (token: any, changed: any, _options: any, userId: string) =>
+      this.safely('a move', () => {
+        const user = this.byPlayer(userId);
+        if (!user || !changed || (!('x' in changed) && !('y' in changed))) return;
+        const scene = token.parent;
+        const geom = getGridGeometry(scene);
+        const squares = pixelsToSquares(geom, Number(token.x), Number(token.y));
+        this.record(moveEvent(token.name ?? 'A token', user, squares, token.id));
+      })
+    );
+
+    Hooks.on('updateWall', (wall: any, changed: any, _options: any, userId: string) =>
+      this.safely('a door', () => {
+        const user = this.byPlayer(userId);
+        if (!user || !changed || !('ds' in changed)) return;
+        let squares: { x: number; y: number } | undefined;
+        try {
+          const c = wall.c ?? [];
+          const geom = getGridGeometry(wall.parent);
+          squares = pixelsToSquares(geom, (Number(c[0]) + Number(c[2])) / 2, (Number(c[1]) + Number(c[3])) / 2);
+        } catch {
+          squares = undefined;
+        }
+        this.record(doorEvent(Number(changed.ds), user, squares, this.setting(TABLE_WATCH_DOORS, true) !== false));
+      })
+    );
+
+    Hooks.on('updateActor', (actor: any, changed: any, _options: any, userId: string) =>
+      this.safely('hit points', () => {
+        const user = this.byPlayer(userId);
+        if (!user || changed?.system?.attributes?.hp?.value === undefined) return;
+        const hp = actor.system?.attributes?.hp ?? {};
+        this.record(hpEvent(actor.name ?? 'Someone', user, { value: Number(hp.value), max: Number(hp.max) }, actor.id));
+      })
+    );
+
+    Hooks.on('userConnected', (user: any, connected: boolean) =>
+      this.safely('a player joining', () => {
+        if (!user || user.isGM) return;
+        this.record(presenceEvent(user.name ?? 'A player', !!connected));
+      })
+    );
+  }
+
+  /** A player's damage roll: a few seconds later, say so if the targets' hit points did not change. */
+  private watchDamage(message: any): void {
+    const authorId: string | undefined = message?.author?.id ?? (typeof message?.user === 'string' ? message.user : message?.user?.id);
+    const player = this.byPlayer(authorId);
+    if (!player) return;
+    const targets = damageRollTargets(message);
+    if (targets.length === 0) return;
+    const fromUuid = (globalThis as any).fromUuidSync;
+    const hpOf = (uuid: string): number | undefined => {
+      try {
+        const doc = fromUuid?.(uuid);
+        const actor = doc?.actor ?? doc;
+        const v = actor?.system?.attributes?.hp?.value;
+        return v === undefined ? undefined : Number(v);
+      } catch {
+        return undefined;
+      }
+    };
+    const before = targets.map(t => ({ ...t, hp: hpOf(t.uuid) }));
+    const who = message.speaker?.alias || player;
+    setTimeout(() => {
+      this.safely('unapplied damage', () => {
+        const unchanged = before.filter(t => t.hp !== undefined && hpOf(t.uuid) === t.hp).map(t => ({ name: t.name, hp: t.hp as number }));
+        this.record(damageNotAppliedEvent(who, unchanged, player));
+      });
+    }, 4000);
+  }
+
+  /** What the table looks like now: the combat (if any) and the party, compactly. */
+  snapshot(): Record<string, any> {
+    const g = this.g;
+    const out: Record<string, any> = {};
+    const combat = g?.combat ?? g?.combats?.active ?? null;
+    const summary = combatSummary(combat);
+    if (summary?.started) {
+      out.combat = {
+        round: summary.round,
+        turn: summary.current,
+        order: (summary.combatants as any[]).map(c =>
+          [c.initiative ?? '--', c.name, c.active ? '(their turn)' : '', c.hp ? `hp ${c.hp}` : '', c.conditions?.length ? `[${c.conditions.join(', ')}]` : '', c.defeated ? '(defeated)' : '', c.hidden ? '(hidden)' : '']
+            .filter(Boolean)
+            .join(' ')
+        ),
+      };
+    }
+    const users = (g?.users?.contents ?? []) as any[];
+    const actors = ((g?.actors?.contents ?? []) as any[]).filter(a => a.type === 'character' && a.hasPlayerOwner);
+    const party = partySummary(actors, this.userName);
+    if (party.length) {
+      out.party = party.map(p => [p.name, p.hp ? `hp ${p.hp}` : '', p.ac !== undefined ? `AC ${p.ac}` : '', p.conditions?.length ? `[${p.conditions.join(', ')}]` : ''].filter(Boolean).join(' '));
+    }
+    out.online = users.filter(u => u.active && !u.isGM).map(u => u.name);
+    const scene = g?.scenes?.active;
+    if (scene) out.scene = scene.name;
+    return out;
+  }
+
+  read(data: { since?: number; session?: string; snapshot?: boolean }): Record<string, any> {
+    const sameSession = !data?.session || data.session === this.buffer.session;
+    const { events, seq } = this.buffer.since(sameSession ? data?.since : undefined);
+    return {
+      success: true,
+      session: this.buffer.session,
+      seq,
+      events,
+      muted: this.setting(TABLE_WATCH_MUTED, false) === true,
+      ...(sameSession ? {} : { restarted: true }),
+      ...(data?.snapshot ? { table: this.snapshot() } : {}),
+    };
+  }
+}
+
+export const tableWatcher = new TableWatcher();

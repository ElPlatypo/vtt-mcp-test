+/** Layout polish: ground under buildings, build filename, door portals, align on a town. */
+import { afterAll, describe, expect, it, vi } from 'vitest';
+import { promises as fs } from 'fs';
+import os from 'os';
+import path from 'path';
+import { LayoutTools } from './layout.js';
+import { addShapes, createDoc, layoutOf } from './layout-doc.js';
+import { alignToImage } from './layout-analysis.js';
+import { doorPortals, expandShapeSpecs, groundInsertIndex } from './layout-town.js';
+import { renderLayout } from './layout-utils.js';
+
+const folder = path.join(os.tmpdir(), `layout-polish-test-${Date.now()}`);
+afterAll(async () => {
+  await fs.rm(folder, { recursive: true, force: true });
+});
+
+describe('groundInsertIndex', () => {
+  const existing = [{ fill: 'grass' }, { fill: 'building' }, { fill: 'door', shape: 'door' }, { fill: 'building' }];
+  it('puts ground under the first building', () => {
+    expect(groundInsertIndex(existing, [{ shape: 'path', fill: 'road' }, { shape: 'ellipse', fill: 'sand' }])).toBe(1);
+  });
+  it('leaves everything else on top', () => {
+    expect(groundInsertIndex(existing, [{ shape: 'rect', fill: 'floor' }])).toBeUndefined();
+    expect(groundInsertIndex(existing, [{ shape: 'path', fill: 'road' }, { shape: 'rect', fill: 'building' }])).toBeUndefined();
+    expect(groundInsertIndex(existing, [{ shape: 'door', fill: 'door' }])).toBeUndefined();
+    expect(groundInsertIndex([{ fill: 'grass' }], [{ fill: 'road' }])).toBeUndefined();
+    expect(groundInsertIndex(existing, [])).toBeUndefined();
+  });
+});
+
+describe('add keeps roads under buildings', () => {
+  const make = () => {
+    const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+    return new LayoutTools({ logger, folder });
+  };
+  it('inserts a road below an earlier building, and respects after', async () => {
+    const t = make();
+    await t.handleLayout({ action: 'new', name: 'Town', columns: 12, rows: 8, background: 'grass', wall_fills: ['building'] });
+    await t.handleLayout({ action: 'add', layout: 'town', shapes: [{ shape: 'building', rect: [4, 2, 4, 3] }] });
+    await t.handleLayout({ action: 'add', layout: 'town', shapes: [{ shape: 'path', path: [[0, 3], [12, 3]], width: 2, fill: 'road' }] });
+    const listed = await t.handleLayout({ action: 'show', layout: 'town', shapes_list: true });
+    expect(listed.shapes.map((s: any) => s.fill)).toEqual(['road', 'building']);
+    // after: wins, putting the road on top again
+    await t.handleLayout({ action: 'add', layout: 'town', after: 1, shapes: [{ shape: 'path', path: [[0, 6], [12, 6]], fill: 'road' }] });
+    const again = await t.handleLayout({ action: 'show', layout: 'town', shapes_list: true });
+    expect(again.shapes.map((s: any) => s.fill)).toEqual(['road', 'building', 'road']);
+  });
+});
+
+describe('build filename', () => {
+  it('adds .png when the filename has no extension', async () => {
+    const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+    const upload = vi.fn(async () => ({ success: true, path: 'worlds/w/uploads/maps/x.png' }));
+    const generate = vi.fn(async () => ({ success: true, local_path: path.join(folder, 'none.png') }));
+    const client: any = { query: vi.fn(async () => ({ success: true, scene: { id: 'sc', name: 'S' } })) };
+    const tools = new LayoutTools({ logger, folder, foundryClient: client, generate, upload } as any);
+    await tools.handleLayout({ action: 'new', name: 'Fname', columns: 20, rows: 16 });
+    await tools.handleLayout({ action: 'add', layout: 'fname', shapes: [{ shape: 'room', at: [2, 2], size: [6, 6] }] });
+    for (const [given, expected] of [['phandalin', 'phandalin.png'], ['town.webp', 'town.webp'], ['a.b.png', 'a.b.png']] as const) {
+      await tools
+        .handleLayout({ action: 'build', layout: 'fname', scene_name: 'S', prompt: 'p', filename: given, walls: false, auto_align: false })
+        .catch((e: any) => { console.log("ERR", e.message); });
+      expect(upload).toHaveBeenLastCalledWith(expect.objectContaining({ filename: expected }));
+    }
+  });
+});
+
+describe('portals for wide doors', () => {
+  it('uses the middle square of the door, the first of two', () => {
+    const doc = createDoc({ name: 't', columns: 20, rows: 20 });
+    addShapes(doc, expandShapeSpecs([{ shape: 'building', rect: [2, 10, 5, 4], doors: [{ side: 'w', offset: 1, size: 2 }, { side: 's', offset: 1, size: 3 }] }]));
+    const [west, south] = doorPortals(doc.shapes as any);
+    expect(west).toMatchObject({ centre: [2, 12], outside: [1.5, 11.5], inside: [2.5, 11.5] });
+    expect(south).toMatchObject({ centre: [4.5, 14], outside: [4.5, 14.5], inside: [4.5, 13.5] });
+  });
+});
+
+describe('align on a town', () => {
+  it('matches buildings when walls go round buildings, instead of reporting none', () => {
+    const doc = createDoc({ name: 'town', columns: 24, rows: 16, grid_size: 32, background: 'grass', wall_fills: ['building'] } as any);
+    addShapes(doc, [
+      { shape: 'rect', rect: [3, 2, 6, 4], fill: 'building' },
+      { shape: 'rect', rect: [12, 8, 5, 5], fill: 'building' },
+      { shape: 'rect', rect: [4, 10, 3, 3], fill: 'building' },
+    ]);
+    const layout = layoutOf(doc);
+    const sketch = renderLayout(layout);
+    const data = new Uint8Array(sketch.width * sketch.height * 4);
+    for (let i = 0; i < sketch.width * sketch.height; i++) {
+      data[i * 4] = sketch.rgb[i * 3]!;
+      data[i * 4 + 1] = sketch.rgb[i * 3 + 1]!;
+      data[i * 4 + 2] = sketch.rgb[i * 3 + 2]!;
+      data[i * 4 + 3] = 255;
+    }
+    const result = alignToImage(layout, { width: sketch.width, height: sketch.height, data });
+    expect(result.quality).toBe('good');
+    expect(result.shift).toEqual([0, 0]);
+  });
+});

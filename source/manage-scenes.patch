+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+
+export interface PartyToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+const ACTIONS = ['status', 'rest', 'xp', 'level_up'] as const;
+
+const schema = z
+  .object({
+    action: z.enum(ACTIONS),
+    who: z.array(z.string().min(1)).max(30).optional(),
+    type: z.enum(['short', 'long']).optional(),
+    spend_hit_dice: z.boolean().optional(),
+    new_day: z.boolean().optional(),
+    amount: z.number().int().min(1).max(10_000_000).optional(),
+    split: z.boolean().optional(),
+    actor: z.string().min(1).optional(),
+    class: z.string().min(1).optional(),
+  })
+  .strict();
+
+export class PartyTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: PartyToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'PartyTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'party',
+        description:
+          'Look after the party (dnd5e): rests, experience points and level-ups, using the system\'s own rest and advancement code (hit dice, spell slots, features and uses recover as they normally do; the rest posts its chat card). ' +
+          'who is a list of "party" (default: characters owned by a player), "all_characters", or names. ' +
+          'ACTIONS: status {who?} one row per character: level, xp (value/next level), hp, hit dice, readyToLevelUp. rest {type: short | long, who?, spend_hit_dice?(true: spends hit dice on a short rest automatically), new_day?(true: a long rest starts a new day)} rests each character and reports hp before and after. xp {amount, who?, split?} gives each character that much XP, or with split divides it among them, and flags those who now have enough for the next level. level_up {actor, class?} opens the system\'s level-up window for that character on the GM screen (the choices there are made by the GM: hit points, features, ability score improvements); class is needed only for multiclass characters. Needs the Foundry tab open in a browser.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: { type: 'string', enum: [...ACTIONS] },
+            who: { type: 'array', items: { type: 'string' }, description: '"party" (default), "all_characters" or character names' },
+            type: { type: 'string', enum: ['short', 'long'], description: 'rest: short or long' },
+            spend_hit_dice: { type: 'boolean', description: 'rest (short): spend hit dice automatically (default true)' },
+            new_day: { type: 'boolean', description: 'rest (long): count it as a new day (default true)' },
+            amount: { type: 'number', description: 'xp: experience points to give' },
+            split: { type: 'boolean', description: 'xp: divide the amount among the characters instead of giving each the full amount' },
+            actor: { type: 'string', description: 'level_up: the character' },
+            class: { type: 'string', description: 'level_up: which class gains the level (multiclass only)' },
+          },
+          required: ['action'],
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handleParty(args: unknown): Promise<any> {
+    const a = schema.parse(args ?? {});
+    this.logger.info('Party', { action: a.action });
+    const result = await this.foundryClient.query('foundry-mcp-bridge.party', a);
+    if (result?.success === false) throw new Error(result.error || 'Request was refused');
+    return result;
+  }
+}

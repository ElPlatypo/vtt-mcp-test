+  async handleManageScenes(args: any): Promise<any> {
+    const schema = z
+      .object({
+        action: z.enum(['create', 'update', 'describe']),
+        scene_identifier: z.string().min(1).optional(),
+        name: z.string().min(1).optional(),
+        background: z.string().min(1).nullable().optional(),
+        width: z.number().int().min(100).max(20000).optional(),
+        height: z.number().int().min(100).max(20000).optional(),
+        padding: z.number().min(0).max(0.5).optional(),
+        grid_size: z.number().int().min(50).max(1000).optional(),
+        grid_distance: z.number().positive().max(1000).optional(),
+        grid_units: z.string().optional(),
+        grid_type: z.number().int().min(0).max(5).optional(),
+        background_color: z
+          .string()
+          .regex(/^#[0-9a-fA-F]{6}$/)
+          .nullable()
+          .optional(),
+        token_vision: z.boolean().optional(),
+        darkness: z.number().min(0).max(1).optional(),
+        global_light: z.boolean().optional(),
+        navigation: z.boolean().optional(),
+        nav_name: z.string().optional(),
+        activate: z.boolean().optional(),
+      })
+      .strict();
+    const parsed = schema.parse(args);
+
+    if (parsed.action === 'create' && !parsed.name) {
+      throw new Error('name is required for create');
+    }
+    if (parsed.action === 'update' && !parsed.scene_identifier) {
+      throw new Error('scene_identifier is required for update');
+    }
+
+    this.logger.info('Managing scenes', {
+      action: parsed.action,
+      scene_identifier: parsed.scene_identifier,
+    });
+    try {
+      const result = await this.foundryClient.query('foundry-mcp-bridge.manage-scenes', parsed);
+      return { success: true, ...result };
+    } catch (error) {
+      this.logger.error('Failed to manage scenes', error);
+      throw new Error(
+        `Failed to manage scenes: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }

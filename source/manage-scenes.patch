+  private async place(doc: LayoutDoc, a: Args): Promise<any> {
+    if (!a.items) throw new Error('place needs items');
+    const layout = layoutOf(doc);
+    const r = rasterize(layout);
+    const taken = new Set<string>();
+    if (a.scene || !a.dry_run) {
+      try {
+        const described = await this.readScene(a.scene);
+        for (const t of described.tokens ?? []) {
+          for (let dy = 0; dy < Math.max(1, Math.round(t.height ?? 1)); dy++) {
+            for (let dx = 0; dx < Math.max(1, Math.round(t.width ?? 1)); dx++) taken.add(`${Math.floor(t.x) + dx},${Math.floor(t.y) + dy}`);
+          }
+        }
+      } catch (error) {

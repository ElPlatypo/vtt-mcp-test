+    expect(combat.nextTurn).toHaveBeenCalled();
+    expect(next.combat.round).toBe(1);
+    await da.controlCombat({ action: 'next_round' });
+    expect(combat.round).toBe(2);
+  });
+
+  it('applies damage and healing through the system and reports hp', async () => {
+    const { da, g1 } = setup();
+    await da.controlCombat({ action: 'start', roll: 'none' });
+    const hit = await da.controlCombat({ action: 'damage', amounts: [{ target: 'Goblin 1', amount: 5 }] });
+    expect(g1.applyDamage).toHaveBeenCalledWith(5);
+    expect(hit.applied).toEqual([{ name: 'Goblin 1', hp: '7 -> 2' }]);
+    const heal = await da.controlCombat({ action: 'heal', amounts: [{ target: 'goblin', amount: 3 }] });
+    expect(g1.applyDamage).toHaveBeenLastCalledWith(-3);
+    expect(heal.applied[0].hp).toBe('2 -> 5');
+    const kill = await da.controlCombat({ action: 'damage', amounts: [{ target: 'Goblin 1', amount: 50 }, { target: 'Dragon', amount: 1 }] });
+    expect(kill.applied[0]).toMatchObject({ hp: '5 -> 0', down: true });
+    expect(kill.notFound).toEqual(['Dragon']);
+  });
+
+  it('falls back to changing hp directly when the system has no applyDamage', async () => {
+    const { da, g1, hp } = setup({ applyDamage: false });
+    await da.controlCombat({ action: 'damage', amounts: [{ target: 'Goblin 1', amount: 4 }] });
+    expect(g1.update).toHaveBeenCalledWith({ 'system.attributes.hp.value': 3 });
+    expect(hp.g1.value).toBe(3);
+  });
+
+  it('removes, marks defeated and ends', async () => {
+    const { da, combat } = setup();
+    await da.controlCombat({ action: 'start', roll: 'none' });
+    const d = await da.controlCombat({ action: 'defeat', names: ['Goblin 1'] });
+    expect(d.combat.order.join(' ')).toContain('(defeated)');
+    const rm = await da.controlCombat({ action: 'remove', names: ['Mira', 'Nobody'] });
+    expect(rm).toMatchObject({ removed: 1, notFound: ['Nobody'] });
+    const end = await da.controlCombat({ action: 'end' });

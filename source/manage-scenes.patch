+    createDirectory.mockRejectedValue(new Error('EEXIST: directory already exists'));
+
+    await expect(
+      dataAccess.uploadFile({ filename: 'a.png', imageData: pngBase64() })
+    ).resolves.toMatchObject({ success: true });
+    expect(upload).toHaveBeenCalled();
+  });
+
+  it('strips a directory or traversal from the filename', async () => {
+    const { dataAccess, upload } = setup();

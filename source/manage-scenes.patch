+    expect(generate).toHaveBeenCalledTimes(2);
+    const [portrait, token] = generate.mock.calls.map(c => c[0]);
+    expect(portrait).toMatchObject({ kind: 'portrait', upload: false, max_side: 1024 });
+    expect(portrait.prompt).toBe('a scarred goblin boss. Character portrait, dark fantasy painting');
+    expect(token).toMatchObject({ kind: 'token', upload: false });
+    expect(token.prompt).toContain('magenta');
+    expect(token.prompt).toContain('only this one subject');
+    expect(upload).toHaveBeenCalledWith(expect.objectContaining({ folder: 'actors/goblin-boss', filename: 'portrait.png', overwrite: true }));
+    expect(upload).toHaveBeenCalledWith(expect.objectContaining({ folder: 'actors/goblin-boss', filename: 'token.png', overwrite: true }));
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.set-actor-art', {
+      actor: 'Goblin Boss',
+      img: 'worlds/w/uploads/actors/goblin-boss/portrait.png',
+      tokenImg: 'worlds/w/uploads/actors/goblin-boss/token.png',

+    });
+    expect(r).toMatchObject({ success: true, made: 1, failed: 0 });
+    const done = r.results[0];
+    expect(done).toMatchObject({ success: true, actorName: 'Goblin Boss', tokensUpdated: 2 });
+    // the token is square, within the size asked for, and transparent around the figure
+    tmp.push(done.localToken);
+    const png = PNG.sync.read(await fs.readFile(done.localToken));
+    expect(png.width).toBe(png.height);
+    expect(png.width).toBeLessThanOrEqual(512);
+    expect(png.data[3]).toBe(0);
+    expect(done.steps).toHaveLength(3);
+  });
+  it('can make only the token, with its own size, and leave placed tokens alone', async () => {

+import { describe, expect, it } from 'vitest';
+import { orderPackIds, ownershipLevel, parseCurrency, parseCustomItems, parseItemRequests } from './loot-utils.js';
+
+describe('parseItemRequests', () => {
+  it('takes names, quantities and packs, and adds up repeats', () => {
+    expect(parseItemRequests(['Longsword', { name: 'Arrow', quantity: 20 }, { name: 'arrow', quantity: 5 }, { name: 'Rope', pack: 'dnd5e.items' }, 'longsword'])).toEqual([
+      { name: 'Longsword', quantity: 2 },
+      { name: 'Arrow', quantity: 25 },
+      { name: 'Rope', quantity: 1, pack: 'dnd5e.items' },
+    ]);
+  });
+  it('keeps the same name from two packs apart', () => {
+    expect(parseItemRequests([{ name: 'Chest', pack: 'a' }, { name: 'Chest', pack: 'b' }])).toHaveLength(2);
+  });
+  it('refuses bad entries', () => {
+    expect(() => parseItemRequests([])).toThrow('non-empty');
+    expect(() => parseItemRequests('x')).toThrow('non-empty');
+    expect(() => parseItemRequests([42])).toThrow('give an item name');
+    expect(() => parseItemRequests([{ name: ' ' }])).toThrow('name is required');
+    expect(() => parseItemRequests([{ name: 'a', quantity: 0 }])).toThrow('quantity');
+    expect(() => parseItemRequests([{ name: 'a', quantity: 1.5 }])).toThrow('quantity');
+    expect(() => parseItemRequests([{ name: 'a', pack: 3 }])).toThrow('pack');
+    expect(() => parseItemRequests(Array.from({ length: 101 }, (_, i) => `i${i}`))).toThrow('at most 100');
+  });
+});
+
+describe('orderPackIds', () => {
+  it('uses the named packs as given', () => {
+    expect(orderPackIds(['b', 'a'], ['x', 'y'])).toEqual(['x', 'y']);
+  });
+  it('puts the main item packs first and the rest in order', () => {
+    expect(orderPackIds(['world.loot', 'dnd5e.equipment24', 'dnd5e.items', 'dnd5e.magicitems'])).toEqual(['dnd5e.items', 'dnd5e.equipment24', 'dnd5e.magicitems', 'world.loot']);
+    expect(orderPackIds(['z', 'a'])).toEqual(['a', 'z']);
+  });
+});
+
+describe('parseCurrency', () => {
+  it('accepts whole amounts and nothing else', () => {
+    expect(parseCurrency(undefined)).toEqual({});
+    expect(parseCurrency({ gp: 50, sp: 0 })).toEqual({ gp: 50, sp: 0 });
+    expect(() => parseCurrency({ gold: 5 })).toThrow('not one of');
+    expect(() => parseCurrency({ gp: -1 })).toThrow('whole number');
+    expect(() => parseCurrency({ gp: 1.5 })).toThrow('whole number');
+    expect(() => parseCurrency([1])).toThrow('object');
+  });
+});
+
+describe('ownershipLevel', () => {
+  it('maps the names to Foundry levels', () => {
+    expect([ownershipLevel('none'), ownershipLevel('limited'), ownershipLevel('observer'), ownershipLevel('owner')]).toEqual([0, 1, 2, 3]);
+    expect(() => ownershipLevel('everyone')).toThrow('ownership must be');
+    expect(() => ownershipLevel(undefined)).toThrow('ownership must be');
+  });
+});
+
+describe('parseCustomItems', () => {
+  it('fills in defaults and checks prices', () => {
+    expect(parseCustomItems(undefined)).toEqual([]);
+    expect(parseCustomItems([{ name: 'Silver Locket', price: { value: 25 }, description: '<p>Engraved.</p>' }, { name: 'Note', type: 'loot', quantity: 2 }])).toEqual([
+      { name: 'Silver Locket', type: 'loot', quantity: 1, price: { value: 25, denomination: 'gp' }, description: '<p>Engraved.</p>' },
+      { name: 'Note', type: 'loot', quantity: 2 },
+    ]);
+    expect(() => parseCustomItems('x')).toThrow('list');
+    expect(() => parseCustomItems([{}])).toThrow('name is required');
+    expect(() => parseCustomItems([{ name: 'a', price: { value: 1, denomination: 'dollars' } }])).toThrow('price');
+    expect(() => parseCustomItems([{ name: 'a', quantity: 0 }])).toThrow('quantity');
+  });
+});
diff --git a/packages/foundry-module/src/loot-utils.ts b/packages/foundry-module/src/loot-utils.ts
new file mode 100644
index 0000000..eab3007
--- /dev/null
+++ b/packages/foundry-module/src/loot-utils.ts
@@ -0,0 +1,126 @@
+/**
+ * Pure helpers for add-compendium-items and make-chest: reading the list of items wanted,
+ * choosing which compendium packs to look in, and checking currency and ownership. No Foundry
+ * globals, so they can be tested.
+ */
+
+/** Item types searched when no pack is named: things that can be carried, not features or spells. */
+export const LOOT_ITEM_TYPES: readonly string[] = ['weapon', 'equipment', 'consumable', 'tool', 'loot', 'container', 'backpack'];
+
+export const MAX_ITEM_REQUESTS = 100;
+export const MAX_QUANTITY = 9999;
+
+export interface ItemRequest {
+  name: string;
+  quantity: number;
+  /** A pack id to take this item from (for example dnd5e.items); otherwise every item pack is searched. */
+  pack?: string;
+}
+
+/**
+ * Accept "Longsword", {name: "Arrow", quantity: 20} or {name, pack}; give back one request per
+ * name and pack (same item twice adds the quantities).
+ */
+export function parseItemRequests(raw: unknown, label = 'items'): ItemRequest[] {
+  if (!Array.isArray(raw) || raw.length === 0) throw new Error(`${label} must be a non-empty list`);
+  if (raw.length > MAX_ITEM_REQUESTS) throw new Error(`${label} can hold at most ${MAX_ITEM_REQUESTS} entries`);
+  const merged = new Map<string, ItemRequest>();
+  raw.forEach((entry, i) => {
+    const where = `${label}[${i}]`;
+    let name: unknown;
+    let quantity: unknown = 1;
+    let pack: unknown;
+    if (typeof entry === 'string') name = entry;
+    else if (entry && typeof entry === 'object') {
+      name = (entry as any).name;
+      if ((entry as any).quantity !== undefined) quantity = (entry as any).quantity;
+      pack = (entry as any).pack;
+    } else throw new Error(`${where}: give an item name or {name, quantity?, pack?}`);
+    if (typeof name !== 'string' || !name.trim()) throw new Error(`${where}: name is required`);
+    if (!Number.isInteger(quantity) || (quantity as number) < 1 || (quantity as number) > MAX_QUANTITY) {
+      throw new Error(`${where}: quantity must be a whole number from 1 to ${MAX_QUANTITY}`);
+    }
+    if (pack !== undefined && (typeof pack !== 'string' || !pack.trim())) throw new Error(`${where}: pack must be a pack id`);
+    const trimmed = name.trim();
+    const key = `${trimmed.toLowerCase()}|${pack ?? ''}`;
+    const have = merged.get(key);
+    if (have) have.quantity += quantity as number;
+    else merged.set(key, { name: trimmed, quantity: quantity as number, ...(pack ? { pack: (pack as string).trim() } : {}) });
+  });
+  return [...merged.values()];
+}
+
+/**
+ * The order to search item packs in: the packs the caller named, or every pack with the
+ * main item packs of the system first, so "Longsword" finds the standard one.
+ */
+export function orderPackIds(allItemPackIds: string[], named?: string[]): string[] {
+  if (named && named.length > 0) return named;
+  const first = ['dnd5e.items', 'dnd5e.equipment24', 'dnd5e.tradegoods', 'dnd5e.equipment'];
+  const preferred = first.filter(id => allItemPackIds.includes(id));
+  const rest = allItemPackIds.filter(id => !preferred.includes(id)).sort();
+  return [...preferred, ...rest];
+}
+
+export const CURRENCIES = ['pp', 'gp', 'ep', 'sp', 'cp'] as const;
+
+/** Check a currency object and give back only the amounts asked for. */
+export function parseCurrency(raw: unknown): Record<string, number> {
+  if (raw === undefined) return {};
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) throw new Error('currency must be an object such as {gp: 50, sp: 10}');
+  const out: Record<string, number> = {};
+  for (const [key, value] of Object.entries(raw as Record<string, unknown>)) {
+    if (!(CURRENCIES as readonly string[]).includes(key)) throw new Error(`currency: ${key} is not one of ${CURRENCIES.join(', ')}`);
+    if (typeof value !== 'number' || !Number.isInteger(value) || value < 0 || value > 10_000_000) {
+      throw new Error(`currency.${key} must be a whole number from 0 to 10000000`);
+    }
+    out[key] = value;
+  }
+  return out;
+}
+
+const OWNERSHIP: Record<string, number> = { none: 0, limited: 1, observer: 2, owner: 3 };
+
+/** Who can open a chest: none, limited, observer (can look inside), owner (can take things). */
+export function ownershipLevel(name: unknown): number {
+  const level = typeof name === 'string' ? OWNERSHIP[name] : undefined;
+  if (level === undefined) throw new Error('ownership must be none, limited, observer or owner');
+  return level;
+}
+
+export interface CustomItem {
+  name: string;
+  type: string;
+  quantity: number;
+  price?: { value: number; denomination: string };
+  description?: string;
+}
+
+const DENOMINATIONS = ['pp', 'gp', 'ep', 'sp', 'cp'];
+
+/** Items made up on the spot (a locket, a note), as opposed to ones taken from a compendium. */
+export function parseCustomItems(raw: unknown): CustomItem[] {
+  if (raw === undefined) return [];
+  if (!Array.isArray(raw)) throw new Error('custom_items must be a list');
+  if (raw.length > MAX_ITEM_REQUESTS) throw new Error(`custom_items can hold at most ${MAX_ITEM_REQUESTS} entries`);
+  return raw.map((entry: any, i: number) => {
+    const where = `custom_items[${i}]`;
+    if (!entry || typeof entry !== 'object') throw new Error(`${where}: must be an object`);
+    if (typeof entry.name !== 'string' || !entry.name.trim()) throw new Error(`${where}: name is required`);
+    const quantity = entry.quantity ?? 1;
+    if (!Number.isInteger(quantity) || quantity < 1 || quantity > MAX_QUANTITY) throw new Error(`${where}: quantity must be a whole number from 1 to ${MAX_QUANTITY}`);
+    const item: CustomItem = { name: entry.name.trim(), type: typeof entry.type === 'string' && entry.type ? entry.type : 'loot', quantity };
+    if (entry.price !== undefined) {
+      const p = entry.price;
+      if (!p || typeof p.value !== 'number' || p.value < 0 || !DENOMINATIONS.includes(p.denomination ?? 'gp')) {
+        throw new Error(`${where}: price must be {value, denomination: ${DENOMINATIONS.join('|')}}`);
+      }
+      item.price = { value: p.value, denomination: p.denomination ?? 'gp' };
+    }
+    if (entry.description !== undefined) {
+      if (typeof entry.description !== 'string') throw new Error(`${where}: description must be text`);
+      item.description = entry.description;
+    }
+    return item;
+  });
+}

+import { describe, expect, it } from 'vitest';
+import { buildTeleportBehavior, linkEndSpec, teleportDestinations, LINK_COLOR } from './link-utils.js';
+
+describe('linkEndSpec', () => {
+  it('keeps the shape, names it and colours it purple', () => {
+    expect(linkEndSpec({ rect: [1, 2, 3, 1], name: ' Stairs ' }, 'fallback', 'from')).toEqual({
+      name: 'Stairs',
+      rect: [1, 2, 3, 1],
+      color: LINK_COLOR,
+    });
+    expect(linkEndSpec({ ellipse: [4, 4, 1, 1], color: '#112233' }, 'To Cave', 'to')).toEqual({
+      name: 'To Cave',
+      ellipse: [4, 4, 1, 1],
+      color: '#112233',
+    });
+  });
+  it('refuses something that is not an object', () => {
+    expect(() => linkEndSpec(null as any, 'x', 'from')).toThrow('must be an object');
+    expect(() => linkEndSpec([] as any, 'x', 'from')).toThrow('must be an object');
+  });
+});
+
+describe('buildTeleportBehavior', () => {
+  it('builds a teleportToken with defaults', () => {
+    expect(buildTeleportBehavior(['Scene.a.Region.b'], {}, 'Teleport', 'link')).toEqual({
+      type: 'teleportToken',
+      name: 'Teleport',
+      system: {
+        destinations: ['Scene.a.Region.b'],
+        placement: 'center',
+        snap: true,
+        choice: false,
+        transition: { type: null, duration: 1500 },
+      },
+    });
+  });
+  it('passes the options through', () => {
+    const b = buildTeleportBehavior(['x'], { placement: 'random', choice: true, snap: false, transition: 'fade', duration: 500 }, 'T', 'link');
+    expect(b.system).toMatchObject({ placement: 'random', choice: true, snap: false, transition: { type: 'fade', duration: 500 } });
+  });
+  it('rejects bad input', () => {
+    expect(() => buildTeleportBehavior([], {}, 'T', 'link')).toThrow('destinations');
+    expect(() => buildTeleportBehavior(['x'], { placement: 'up' as any }, 'T', 'link')).toThrow('placement');
+    expect(() => buildTeleportBehavior(['x'], { transition: 'a b' }, 'T', 'link')).toThrow('transition');
+    expect(() => buildTeleportBehavior(['x'], { duration: -1 }, 'T', 'link')).toThrow('duration');
+  });
+});
+
+describe('teleportDestinations', () => {
+  it('reads sets and arrays', () => {
+    expect(teleportDestinations({ system: { destinations: new Set(['a', 'b']) } })).toEqual(['a', 'b']);
+    expect(teleportDestinations({ system: { destinations: ['a', 3] } })).toEqual(['a']);
+    expect(teleportDestinations({})).toEqual([]);
+  });
+});
diff --git a/packages/foundry-module/src/link-utils.ts b/packages/foundry-module/src/link-utils.ts
new file mode 100644
index 0000000..d51ec37
--- /dev/null
+++ b/packages/foundry-module/src/link-utils.ts
@@ -0,0 +1,82 @@
+/**
+ * Pure helpers for linking two regions with teleports (also across scenes): the region spec for
+ * each end and the teleportToken behaviour that points at the other end.
+ */
+
+import type { RegionSpec } from './region-utils.js';
+
+export const LINK_PLACEMENTS = ['center', 'random', 'relative'] as const;
+export const LINK_COLOR = '#bf5af2';
+
+/** One end of a link: where the region is, and what to call it. The scene is an id or name. */
+export interface LinkEnd {
+  scene?: string;
+  name?: string;
+  rect?: number[];
+  ellipse?: number[];
+  polygon?: number[][];
+  color?: string;
+}
+
+export interface LinkOptions {
+  /** Where arriving tokens appear in the destination region (default center). */
+  placement?: (typeof LINK_PLACEMENTS)[number];
+  /** Ask the player before teleporting. */
+  choice?: boolean;
+  /** Snap arriving tokens to the grid (default true). */
+  snap?: boolean;
+  /** Foundry transition type (a key of CONFIG.Canvas.transitionTypes, e.g. fade); none by default. */
+  transition?: string;
+  /** Transition length in milliseconds. */
+  duration?: number;
+}
+
+/** The region spec for one end of a link (no behaviours yet; they need the other end's uuid). */
+export function linkEndSpec(end: LinkEnd, fallbackName: string, label: string): RegionSpec {
+  if (!end || typeof end !== 'object' || Array.isArray(end)) throw new Error(`${label}: must be an object`);
+  const name = typeof end.name === 'string' && end.name.trim() ? end.name.trim() : fallbackName;
+  return {
+    name,
+    ...(end.rect ? { rect: end.rect } : {}),
+    ...(end.ellipse ? { ellipse: end.ellipse } : {}),
+    ...(end.polygon ? { polygon: end.polygon } : {}),
+    color: end.color ?? LINK_COLOR,
+  };
+}
+
+/** The teleportToken behaviour data that sends tokens to the given region uuids. */
+export function buildTeleportBehavior(destinations: string[], options: LinkOptions, name: string, label: string): any {
+  if (!Array.isArray(destinations) || destinations.length === 0 || destinations.some(d => typeof d !== 'string' || !d)) {
+    throw new Error(`${label}: destinations must be a non-empty list of region uuids`);
+  }
+  const placement = options.placement ?? 'center';
+  if (!(LINK_PLACEMENTS as readonly string[]).includes(placement)) {
+    throw new Error(`${label}: placement must be one of ${LINK_PLACEMENTS.join(', ')}`);
+  }
+  const transition = options.transition ?? 'none';
+  if (typeof transition !== 'string' || !/^[A-Za-z][A-Za-z0-9_-]{0,40}$/.test(transition)) {
+    throw new Error(`${label}: transition must be a transition name such as fade, or none`);
+  }
+  const duration = options.duration ?? 1500;
+  if (typeof duration !== 'number' || !Number.isFinite(duration) || duration < 0 || duration > 10000) {
+    throw new Error(`${label}: duration must be 0 to 10000 milliseconds`);
+  }
+  return {
+    type: 'teleportToken',
+    name,
+    system: {
+      destinations,
+      placement,
+      snap: options.snap ?? true,
+      choice: !!options.choice,
+      transition: { type: transition === 'none' ? null : transition, duration },
+    },
+  };
+}
+
+/** The region uuids a teleportToken behaviour sends to, for describe. */
+export function teleportDestinations(behavior: any): string[] {
+  const value = behavior?.system?.destinations;
+  const list: unknown[] = value instanceof Set ? [...value] : Array.isArray(value) ? value : [];
+  return list.filter((d): d is string => typeof d === 'string');
+}

+  private buildSceneData(options: Record<string, any>): Record<string, any> {
+    const data: Record<string, any> = {};
+
+    const number = (
+      key: string,
+      label: string,
+      min: number,
+      max: number,
+      integer: boolean
+    ): number | undefined => {
+      const value = options[key];
+      if (value === undefined) return undefined;
+      if (typeof value !== 'number' || !Number.isFinite(value)) {
+        throw new Error(`${label} must be a number`);
+      }
+      if (integer && !Number.isInteger(value)) {
+        throw new Error(`${label} must be a whole number`);
+      }
+      if (value < min || value > max) {
+        throw new Error(`${label} must be between ${min} and ${max}`);
+      }
+      return value;
+    };
+
+    if (options.name !== undefined) {
+      if (typeof options.name !== 'string' || !options.name.trim()) {
+        throw new Error('name must be a non-empty string');
+      }
+      data.name = options.name.trim();
+    }
+
+    const width = number('width', 'width', 100, 20000, true);
+    if (width !== undefined) data.width = width;
+    const height = number('height', 'height', 100, 20000, true);
+    if (height !== undefined) data.height = height;
+    const padding = number('padding', 'padding', 0, 0.5, false);
+    if (padding !== undefined) data.padding = padding;

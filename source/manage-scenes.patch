@@ -0,0 +1,100 @@
+import { describe, expect, it } from 'vitest';
+import {
+  DEFAULT_PROFILES,
+  IMAGE_KINDS,
+  profilesFromSetting,
+  readProfilesForm,
+  selectChoices,
+} from './image-profiles-utils.js';
+
+/** A form with every field filled in from the defaults. */
+function formFrom(profiles = DEFAULT_PROFILES): Record<string, unknown> {
+  const data: Record<string, unknown> = {};
+  for (const kind of IMAGE_KINDS) {
+    for (const [field, value] of Object.entries(profiles[kind])) {
+      data[`${kind}__${field}`] = String(value);
+    }
+  }
+  return data;
+}
+
+describe('profilesFromSetting', () => {
+  it('gives the defaults for an empty or broken setting', () => {
+    expect(profilesFromSetting('{}')).toEqual(DEFAULT_PROFILES);
+    expect(profilesFromSetting('nope')).toEqual(DEFAULT_PROFILES);
+    expect(profilesFromSetting(undefined)).toEqual(DEFAULT_PROFILES);
+  });
+
+  it('keeps saved values and defaults the rest', () => {
+    const p = profilesFromSetting(
+      JSON.stringify({ portrait: { workflow: 'checkpoint', checkpoint: 'a.safetensors' } })
+    );
+    expect(p.portrait.workflow).toBe('checkpoint');
+    expect(p.portrait.checkpoint).toBe('a.safetensors');
+    expect(p.portrait.steps).toBe(DEFAULT_PROFILES.portrait.steps);
+    expect(p.map).toEqual(DEFAULT_PROFILES.map);
+  });
+
+  it('defaults maps to a checkpoint and the rest to MiniMax H3', () => {
+    expect(DEFAULT_PROFILES.map.workflow).toBe('checkpoint');
+    expect(DEFAULT_PROFILES.portrait.workflow).toBe('minimax-h3');
+    expect(DEFAULT_PROFILES.token.steps).toBe(6);
+  });
+
+  it('treats profiles saved before workflows existed as old checkpoint settings', () => {
+    const p = profilesFromSetting({
+      map: { checkpoint: 'mine.safetensors', steps: 40 },
+      portrait: { checkpoint: '', steps: 25, cfg: 6 },
+    });
+    expect(p.map.workflow).toBe('checkpoint');
+    expect(p.map.checkpoint).toBe('mine.safetensors');
+    expect(p.map.steps).toBe(40);
+    expect(p.portrait).toEqual(DEFAULT_PROFILES.portrait);
+  });
+});
+
+describe('readProfilesForm', () => {
+  it('reads a complete form back into the same profiles', () => {
+    const result = readProfilesForm(formFrom());
+    expect(result).toEqual({ ok: true, value: DEFAULT_PROFILES });
+  });
+
+  it('uses what was typed', () => {
+    const data = {
+      ...formFrom(),
+      portrait__diffusionModel: ' other.safetensors ',
+      portrait__steps: '31',
+    };
+    const result = readProfilesForm(data);
+    if (!result.ok) throw new Error(result.error);
+    expect(result.value.portrait.diffusionModel).toBe('other.safetensors');
+    expect(result.value.portrait.steps).toBe(31);
+  });
+
+  it('names the field that is wrong', () => {
+    const bad = (field: string, value: string) => {
+      const result = readProfilesForm({ ...formFrom(), [field]: value });
+      return result.ok ? 'ok' : result.error;
+    };
+    expect(bad('map__workflow', 'magic')).toContain('Maps: choose a workflow');
+    expect(bad('map__steps', '0')).toContain('Maps: steps');
+    expect(bad('map__steps', '2.5')).toContain('whole number');
+    expect(bad('token__cfg', 'abc')).toContain('Tokens: CFG');
+    expect(bad('handout__width', '100')).toContain('Handouts and illustrations: width');
+    expect(bad('portrait__height', '')).toContain('Character portraits: height');
+    expect(bad('map__sampler', 'bad name')).toContain('choose a sampler');
+    expect(bad('map__scheduler', '')).toContain('choose a scheduler');
+    expect(bad('map__promptPrefix', 'x'.repeat(1001))).toContain('promptPrefix');
+  });
+});
+
+describe('selectChoices', () => {
+  it('keeps the current value even when ComfyUI does not list it', () => {
+    expect(selectChoices(['a', 'b'], 'old', false)).toEqual(['old', 'a', 'b']);
+    expect(selectChoices(['a', 'b'], 'a', false)).toEqual(['a', 'b']);
+  });
+
+  it('can offer an empty choice', () => {
+    expect(selectChoices(['a'], '', true)).toEqual(['', 'a']);
+  });
+});

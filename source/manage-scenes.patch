@@ -0,0 +1,120 @@
+/**
+ * Checks made before an attack is rolled: is the target within the weapon's or spell's range, and
+ * is it the attacker's turn. Pure functions over plain data so they can be tested without Foundry.
+ */
+
+export interface AttackRange {
+  /** a melee attack (a thrown melee weapon may also have a normal and long range) */
+  melee: boolean;
+  /** melee reach, in the range units */
+  reach?: number;
+  /** normal range */
+  normal?: number;
+  /** long range (beyond normal: disadvantage) */
+  long?: number;
+  /** ft, m, ... as the item stores it */
+  units: string;
+}
+
+const num = (v: unknown): number | undefined => {
+  const n = typeof v === 'string' && v.trim() !== '' ? Number(v) : v;
+  return typeof n === 'number' && Number.isFinite(n) && n > 0 ? n : undefined;
+};
+
+/**
+ * The range of a dnd5e item and activity. dnd5e 4+ keeps the range on the activity (which may
+ * override the item) and reach on the item; older data keeps everything on the item. Returns null
+ * when there is nothing to check (self, special, no range at all).
+ */
+export function attackRangeOf(item: any, activity: any): AttackRange | null {
+  const itemRange = item?.system?.range ?? {};
+  const actRange = activity?.range ?? {};
+  const pick = (key: string) => (activity?.range?.override ? actRange[key] ?? itemRange[key] : itemRange[key] ?? actRange[key]);
+  const unitsRaw = String(pick('units') ?? '').toLowerCase();
+  if (['self', 'spec', 'any', 'none'].includes(unitsRaw)) return null;
+  const attackType = activity?.attack?.type?.value ?? item?.system?.actionType ?? '';
+  const melee = attackType === 'melee' || attackType === 'mwak' || attackType === 'msak';
+  const touch = unitsRaw === 'touch';
+  const units = touch || unitsRaw === '' ? 'ft' : unitsRaw;
+  const reach = num(itemRange.reach) ?? num(actRange.reach) ?? (melee || touch ? 5 : undefined);
+  const normal = touch ? undefined : num(pick('value'));
+  const long = touch ? undefined : num(pick('long'));
+  if (reach === undefined && normal === undefined && long === undefined) return null;
+  return {
+    melee: melee || touch,
+    units,
+    ...(reach !== undefined ? { reach } : {}),
+    ...(normal !== undefined ? { normal } : {}),
+    ...(long !== undefined && (normal === undefined || long > normal) ? { long } : {}),
+  };
+}
+
+export interface TokenBox {
+  /** top-left corner, pixels */
+  x: number;
+  y: number;
+  /** size in grid squares */
+  width: number;
+  height: number;
+}
+
+/**
+ * Distance between two tokens the way D&D counts it on a square grid: squares between their
+ * nearest edges, plus one (adjacent tokens are 5 ft apart), diagonals counting as one square.
+ * Returned in the scene's distance units.
+ */
+export function tokenDistance(a: TokenBox, b: TokenBox, gridSize: number, gridDistance: number): number {
+  const sq = (px: number) => px / (gridSize || 1);
+  const ax = sq(a.x);
+  const ay = sq(a.y);
+  const bx = sq(b.x);
+  const by = sq(b.y);
+  const aw = a.width || 1;
+  const ah = a.height || 1;
+  const bw = b.width || 1;
+  const bh = b.height || 1;
+  const gapX = Math.max(0, bx - (ax + aw), ax - (bx + bw));
+  const gapY = Math.max(0, by - (ay + ah), ay - (by + bh));
+  const squares = Math.round(Math.max(gapX, gapY)) + 1;
+  return squares * (gridDistance || 5);
+}
+
+export type RangeVerdict =
+  | { status: 'ok' }
+  | { status: 'long'; normal: number }
+  | { status: 'out'; max: number };
+
+/** Whether a distance is within the attack's reach or range, its long range, or out of range. */
+export function rangeVerdict(distance: number, range: AttackRange): RangeVerdict {
+  const reach = range.reach ?? 0;
+  if (distance <= reach) return { status: 'ok' };
+  if (range.normal !== undefined && distance <= range.normal) return { status: 'ok' };
+  if (range.long !== undefined && distance <= range.long) return { status: 'long', normal: range.normal ?? reach };
+  return { status: 'out', max: Math.max(reach, range.normal ?? 0, range.long ?? 0) };
+}
+
+/** Units a scene and an item share, so a distance can be compared (ft and feet, m and meters). */
+export function sameUnits(a: string | undefined, b: string | undefined): boolean {
+  const norm = (u: string | undefined) => {
+    const s = String(u ?? 'ft').trim().toLowerCase().replace(/\.$/, '');
+    if (['ft', 'feet', 'foot'].includes(s)) return 'ft';
+    if (['m', 'meter', 'meters', 'metre', 'metres'].includes(s)) return 'm';
+    return s;
+  };
+  return norm(a) === norm(b);
+}
+
+/** A warning when a running combat has someone else's turn (attacks of opportunity are fine, just flagged). */
+export function turnWarning(
+  combat: { started?: boolean; combatant?: { tokenId?: string; actorId?: string; name?: string } | null } | null | undefined,
+  attacker: { tokenId?: string; actorId?: string; name: string },
+  inCombat: boolean
+): string | undefined {
+  if (!combat?.started || !combat.combatant || !inCombat) return undefined;
+  const current = combat.combatant;
+  const same =
+    (attacker.tokenId && current.tokenId === attacker.tokenId) ||
+    (!attacker.tokenId && attacker.actorId && current.actorId === attacker.actorId);
+  if (same) return undefined;
+  return `It is ${current.name ?? 'someone else'}'s turn, not ${attacker.name}'s (fine for a reaction such as an opportunity attack)`;
+}

+import { describe, expect, it } from 'vitest';
+import {
+  clipRegion,
+  divisorSizes,
+  measureAxis,
+  measureGrid,
+} from './grid-measure-utils.js';
+
+/** A picture with soft noisy texture and, optionally, dark grid lines. */
+function picture(
+  width: number,
+  height: number,
+  grid?: { size: number; offsetX: number; offsetY: number; only?: { x: number; y: number; w: number; h: number } }
+): Uint8Array {
+  const gray = new Uint8Array(width * height);
+  let seed = 12345;
+  const noise = () => {
+    seed = (seed * 1664525 + 1013904223) % 4294967296;
+    return seed / 4294967296;
+  };
+  for (let y = 0; y < height; y++) {
+    for (let x = 0; x < width; x++) {
+      // Stone-like blocks plus noise, so there are plenty of edges that are not the grid.
+      const block = ((Math.floor(x / 37) * 7 + Math.floor(y / 53) * 11) % 5) * 12;
+      let value = 120 + block + noise() * 30;
+      if (grid) {
+        const inside =
+          !grid.only ||
+          (x >= grid.only.x && x < grid.only.x + grid.only.w && y >= grid.only.y && y < grid.only.y + grid.only.h);
+        const gx = (x - grid.offsetX + grid.size * 1000) % grid.size;
+        const gy = (y - grid.offsetY + grid.size * 1000) % grid.size;
+        if (inside && (gx < 2 || gy < 2)) value = 40;
+      }
+      gray[y * width + x] = value;
+    }
+  }
+  return gray;
+}
+
+describe('measureGrid', () => {
+  it('finds the size and offset of a drawn grid', () => {
+    const gray = picture(700, 560, { size: 70, offsetX: 23, offsetY: 41 });
+    const result = measureGrid(gray, 700, 560);
+    expect(result.detected).toBe(true);
+    expect(result.size).toBe(70);
+    expect(Math.abs(result.offsetX - 23)).toBeLessThanOrEqual(2);
+    expect(Math.abs(result.offsetY - 41)).toBeLessThanOrEqual(2);
+    expect(result.confidence).toBeGreaterThan(0.3);
+  });
+
+  it('is not fooled into reporting a multiple of the spacing', () => {
+    const result = measureGrid(picture(900, 900, { size: 60, offsetX: 5, offsetY: 5 }), 900, 900);
+    expect(result.size).toBe(60);
+  });
+
+  it('finds a larger grid', () => {
+    const result = measureGrid(picture(1200, 1000, { size: 133, offsetX: 0, offsetY: 0 }), 1200, 1000);
+    expect(result.size).toBe(133);
+  });
+
+  it('says there is no grid in a picture without one', () => {
+    const result = measureGrid(picture(800, 800), 800, 800);
+    expect(result.detected).toBe(false);
+    expect(result.size).toBeNull();
+  });
+
+  it('finds a grid drawn only on part of the picture when pointed at that part', () => {
+    const area = { x: 200, y: 150, w: 500, h: 400 };
+    const gray = picture(1200, 900, { size: 51, offsetX: 7, offsetY: 3, only: area });
+    const result = measureGrid(gray, 1200, 900, {
+      region: { x: area.x, y: area.y, width: area.w, height: area.h },
+    });
+    expect(result.detected).toBe(true);
+    expect(result.size).toBe(51);
+    // Offsets are given for the whole picture, not the region.
+    expect(Math.abs(result.offsetX - 7)).toBeLessThanOrEqual(2);
+    expect(Math.abs(result.offsetY - 3)).toBeLessThanOrEqual(2);
+  });
+
+  it('lets a narrow strip speak in one direction only when a region was given', () => {
+    const gray = picture(1200, 400, { size: 51, offsetX: 10, offsetY: 0 });
+    const strip = measureGrid(gray, 1200, 400, { region: { x: 100, y: 100, width: 900, height: 30 } });
+    expect(strip.detected).toBe(true);
+    expect(strip.size).toBe(51);
+  });
+
+  it('lists grid sizes that divide the picture into whole squares', () => {
+    const result = measureGrid(picture(480, 480), 480, 480);
+    expect(result.divisors.map(d => d.size)).toContain(48);
+    expect(result.divisors.find(d => d.size === 60)).toEqual({ size: 60, columns: 8, rows: 8 });
+  });
+});
+
+describe('clipRegion', () => {
+  it('uses the whole picture by default and keeps a region inside it', () => {
+    expect(clipRegion(100, 80)).toEqual({ x: 0, y: 0, width: 100, height: 80 });
+    expect(clipRegion(100, 80, { x: 90, y: 70, width: 50, height: 50 })).toEqual({
+      x: 90,
+      y: 70,
+      width: 10,
+      height: 10,
+    });
+    expect(clipRegion(100, 80, { x: -5, y: -5, width: 20, height: 20 })).toMatchObject({ x: 0, y: 0 });
+  });
+});
+
+describe('measureAxis', () => {
+  it('gives no answer for a profile that is too short', () => {
+    expect(measureAxis(new Float64Array(30)).size).toBeNull();
+  });
+});
+
+describe('divisorSizes', () => {
+  it('only offers sizes that fit both sides', () => {
+    expect(divisorSizes(2048, 2048).map(d => d.size)).toEqual([64, 128]);
+    expect(divisorSizes(1000, 600, 40, 120).map(d => d.size)).toEqual([40, 50, 100, 120].filter(s => 1000 % s === 0 && 600 % s === 0));
+  });
+});

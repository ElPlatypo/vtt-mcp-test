@@ -0,0 +1,275 @@
+/**
+ * Monster and character actions in combat: roll an attack (and damage, and apply it), roll a
+ * saving-throw ability against targets, or roll a check. Works through the dnd5e activity and actor
+ * roll APIs, so the chat cards, advantage rules and modifiers are the system's own.
+ */
+import { rollModeName } from './roll-mode.js';
+
+export interface ActionOptions {
+  item?: string;
+  advantage?: boolean;
+  disadvantage?: boolean;
+  /** apply the damage to the targets (default true) */
+  apply?: boolean;
+  /** post the rolls for everyone instead of only the GM (default false) */
+  public?: boolean;
+  /** use up the item's charges, ammunition or spell slot, as using it normally does (default true) */
+  consume?: boolean;
+  /**
+   * Target one token (or none) for the user, the way the system reads targets when it rolls an
+   * attack: it then rolls against that token's AC and shows hit or miss on the card.
+   */
+  setTarget?: (target: NamedActor | null) => void;
+  /** targets beyond the attack's normal range (but within long range): rolled with disadvantage */
+  longRange?: (target: NamedActor) => boolean;
+}
+
+export interface NamedActor {
+  name: string;
+  actor: any;
+  token?: any;
+}
+
+const NO_DIALOG = { configure: false };
+/** The chat message of a roll: GM only by default (a hidden monster's attack must not show to players), public on request. */
+// Foundry v14 names the key messageMode (public | gm); rollMode is its older spelling, kept for older versions.
+// dnd5e 6 hands rollMode on as v14's messageMode, so it must carry the v14 name too (rollModeName).
+const messageFor = (isPublic?: boolean) => ({ create: true, messageMode: isPublic ? 'public' : 'gm', rollMode: rollModeName(isPublic ? 'public' : 'gm') });
+
+const total = (rolls: any): number => (Array.isArray(rolls) ? rolls : rolls ? [rolls] : []).reduce((n: number, r: any) => n + (Number(r?.total) || 0), 0);
+const hpOf = (actor: any): number => Number(actor?.system?.attributes?.hp?.value ?? 0);
+
+/** The activity a request means: an item by name (or the first with an attack/save), then its attack or save activity. */
+export function pickActivity(actor: any, itemName: string | undefined, wanted: Array<'attack' | 'save'> = ['attack', 'save']): { item: any; activity: any } | null {
+  const items = (actor?.items?.contents ?? [...(actor?.items ?? [])]) as any[];
+  const activitiesOf = (item: any): any[] => [...(item?.system?.activities?.values?.() ?? [])];
+  const wantedIn = (item: any) => activitiesOf(item).find(a => wanted.includes(a.type));
+  if (itemName) {
+    const key = itemName.trim().toLowerCase();
+    const item = items.find(i => i.id === itemName) ?? items.find(i => String(i.name).toLowerCase() === key) ?? items.find(i => String(i.name).toLowerCase().includes(key));
+    const activity = item ? wantedIn(item) : undefined;
+    return item && activity ? { item, activity } : null;
+  }
+  for (const item of items) {
+    const activity = wantedIn(item);
+    if (activity) return { item, activity };
+  }
+  return null;
+}
+
+/**
+ * A player character at 0 hit points is unconscious and prone. dnd5e does not set the statuses when the bridge applies
+ * damage, so do it here; harmless when they are already there, and creatures other than characters are left alone.
+ */
+export async function markDownIfZero(actor: any): Promise<string[]> {
+  try {
+    if (!actor || actor.type !== 'character' || hpOf(actor) > 0 || typeof actor.toggleStatusEffect !== 'function') return [];
+    const have = (id: string) => actor.statuses?.has?.(id) === true;
+    if (have('dead')) return [];
+    const added: string[] = [];
+    for (const id of ['unconscious', 'prone']) {
+      if (!have(id)) {
+        await actor.toggleStatusEffect(id, { active: true });
+        added.push(id);
+      }
+    }
+    return added;
+  } catch (error) {
+    console.warn('[foundry-mcp-bridge-scenes] could not mark a character as down:', error);
+    return [];
+  }
+}
+
+const clampSave = (n: unknown, fallback: number): number => Math.min(3, Math.max(0, Math.round(Number(n ?? fallback)) || 0));
+
+/**
+ * Set a character's death saving throw counts (0 to 3 each, the ones not given stay). Three failures kill the
+ * character (the dead status), three successes make them stable.
+ */
+export async function setDeathSaves(actor: any, counts: { success?: number | undefined; failure?: number | undefined }): Promise<Record<string, any>> {
+  const death = actor?.system?.attributes?.death ?? {};
+  const success = clampSave(counts.success, death.success ?? 0);
+  const failure = clampSave(counts.failure, death.failure ?? 0);
+  await actor.update({ 'system.attributes.death.success': success, 'system.attributes.death.failure': failure });
+  const out: Record<string, any> = { success, failure };
+  if (failure >= 3) {
+    if (typeof actor.toggleStatusEffect === 'function' && actor.statuses?.has?.('dead') !== true) await actor.toggleStatusEffect('dead', { active: true, overlay: true });
+    out.status = 'dead';
+  } else if (success >= 3) {
+    out.status = 'stable';
+  }
+  return out;
+}
+
+/** Stabilize a dying character: three successes, no failures; they stay at 0 hp and unconscious. */
+export async function stabilize(actor: any): Promise<Record<string, any>> {
+  const result = await setDeathSaves(actor, { success: 3, failure: 0 });
+  await markDownIfZero(actor);
+  return result;
+}
+
+/** Surprised for the first round: a status effect that lasts one round. Returns false when it was already on. */
+export async function markSurprised(actor: any): Promise<boolean> {
+  if (!actor || actor.statuses?.has?.('surprised') === true) return false;
+  const configured = ((globalThis as any).CONFIG?.statusEffects ?? []).find((s: any) => s?.id === 'surprised');
+  await actor.createEmbeddedDocuments('ActiveEffect', [
+    { name: configured?.name ? String(configured.name) : 'Surprised', img: configured?.img ?? configured?.icon, statuses: ['surprised'], duration: { rounds: 1 }, origin: actor.uuid },
+  ]);
+  return true;
+}
+
+async function applyTo(actor: any, rolls: any[], factor: number): Promise<any> {
+  const damages = rolls
+    .map(r => ({ value: Math.floor((Number(r.total) || 0) * factor), type: r.options?.type, properties: new Set<string>(r.options?.properties ?? []) }))
+    .filter(d => d.value > 0);
+  if (damages.length === 0) return;
+  if (typeof actor.applyDamage === 'function') await actor.applyDamage(damages);
+  else {
+    const next = Math.max(0, hpOf(actor) - damages.reduce((n, d) => n + d.value, 0));
+    await actor.update({ 'system.attributes.hp.value': next });
+  }
+  await markDownIfZero(actor);
+}
+
+const damageTypes = (rolls: any[]): string[] => [...new Set(rolls.map(r => r.options?.type).filter(Boolean))] as string[];
+
+/** Roll the attack (or save) of an item against each target, roll damage, apply it, and report. */
+export async function performAttack(attacker: NamedActor, targets: NamedActor[], options: ActionOptions): Promise<Record<string, any>> {
+  const found = pickActivity(attacker.actor, options.item);
+  if (!found) throw new Error(`${attacker.name} has no ${options.item ? `attack or save called "${options.item}"` : 'attack or save'} to use`);
+  const { item, activity } = found;
+  const apply = options.apply !== false;
+  const message = messageFor(options.public);
+  const out: Record<string, any> = { attacker: attacker.name, item: item.name, kind: activity.type, results: [] as any[] };
+  const config: Record<string, any> = {};
+  if (options.advantage) config.advantage = true;
+  if (options.disadvantage) config.disadvantage = true;
+
+  if (activity.type === 'save') {
+    const abilities = activity.save?.ability;
+    const ability = abilities instanceof Set ? [...abilities][0] : Array.isArray(abilities) ? abilities[0] : abilities;
+    const dc = Number(activity.save?.dc?.value ?? 0);
+    const onSave = activity.damage?.onSave ?? 'half';
+    const damage = typeof activity.rollDamage === 'function' ? await activity.rollDamage({}, NO_DIALOG, message) : [];
+    out.dc = dc;
+    out.ability = ability;
+    out.damage = { total: total(damage), types: damageTypes(damage) };
+    if (targets.length === 0) return out;
+    for (const t of targets) {
+      const rolls = await t.actor.rollSavingThrow({ ability, target: dc }, NO_DIALOG, message);
+      const saved = total(rolls?.[0] ? [rolls[0]] : []) >= dc;
+      const factor = saved ? (onSave === 'half' ? 0.5 : onSave === 'none' ? 0 : 1) : 1;
+      const before = hpOf(t.actor);
+      if (apply && damage.length) await applyTo(t.actor, damage, factor);
+      const after = hpOf(t.actor);
+      out.results.push({ target: t.name, save: total(rolls?.[0] ? [rolls[0]] : []), saved, ...(apply ? { hp: `${before} -> ${after}`, ...(after <= 0 ? { down: true } : {}) } : {}) });
+    }
+    return out;
+  }
+
+  // an attack: one roll per target
+  const list: NamedActor[] = targets.length ? targets : [{ name: '', actor: null }];
+  // using the item first spends what it costs (charges, ammunition, a spell slot) and posts its card
+  if (options.consume !== false && typeof activity.use === 'function') {
+    // subsequentActions:false: using an attack would otherwise open its own attack-roll dialog afterwards
+    await activity.use({ subsequentActions: false }, NO_DIALOG, message);
+  }
+  try {
+    for (const t of list) {
+      options.setTarget?.(t.actor ? t : null);
+      const long = !!(t.actor && options.longRange?.(t));
+      const rolls = await activity.rollAttack(long ? { ...config, disadvantage: true } : config, NO_DIALOG, message);
+      const roll = rolls?.[0];
+      if (!roll) throw new Error('The attack was cancelled or could not be rolled');
+      const natural = roll.dice?.[0]?.results?.find((r: any) => r.active !== false)?.result ?? roll.terms?.[0]?.total;
+      const crit = !!roll.isCritical;
+      const fumble = !!roll.isFumble;
+      const row: Record<string, any> = { ...(t.name ? { target: t.name } : {}), roll: Number(roll.total), ...(natural !== undefined ? { natural } : {}), ...(crit ? { crit: true } : {}), ...(fumble ? { fumble: true } : {}), ...(long ? { longRange: 'disadvantage' } : {}) };
+      if (t.actor) {
+        const ac = Number(t.actor.system?.attributes?.ac?.value ?? 10);
+        // the roll knows its target's AC (the system set it from the targeted token); fall back to comparing
+        const hit = typeof roll.isSuccess === 'boolean' && roll.options?.target !== undefined ? roll.isSuccess : crit || (!fumble && Number(roll.total) >= ac);
+        row.ac = ac;
+        row.hit = hit;
+        await finishAttackRow(row, hit, crit, t, activity, apply, message);
+      }
+      out.results.push(row);
+    }
+  } finally {
+    options.setTarget?.(null);
+  }
+  return out;
+}
+
+/** On a hit: roll damage (the system doubles the dice on a crit), apply it through the system's own rules, note hp. */
+async function finishAttackRow(row: Record<string, any>, hit: boolean, crit: boolean, t: NamedActor, activity: any, apply: boolean, message: Record<string, any>): Promise<void> {
+  if (!hit || typeof activity.rollDamage !== 'function') return;
+  const damage = await activity.rollDamage({ isCritical: crit }, NO_DIALOG, message);
+  row.damage = total(damage);
+  const types = damageTypes(damage);
+  if (types.length) row.damageTypes = types;
+  if (apply) {
+    const before = hpOf(t.actor);
+    await applyTo(t.actor, damage, 1);
+    const after = hpOf(t.actor);
+    row.hp = `${before} -> ${after}`;
+    if (after <= 0) row.down = true;
+  }
+}
+
+export interface CheckRequest {
+  skill?: string;
+  ability?: string;
+  save?: string;
+  dc?: number;
+  advantage?: boolean;
+  disadvantage?: boolean;
+  /** post the roll for everyone instead of only the GM (default false) */
+  public?: boolean;
+}
+
+/** The key a name means: "perception" or "prc" for skills, "dex" or "dexterity" for abilities. */
+export function resolveKey(table: Record<string, any>, name: string): string | undefined {
+  const key = name.trim().toLowerCase();
+  if (table[key]) return key;
+  return Object.entries(table).find(([, v]) => String(typeof v === 'string' ? v : v?.label ?? '').toLowerCase() === key)?.[0];
+}
+
+/** Roll a skill, ability check or saving throw for several actors, with an optional DC. */
+export async function performCheck(who: NamedActor[], request: CheckRequest, tables: { skills: Record<string, any>; abilities: Record<string, any> }): Promise<Record<string, any>> {
+  const kinds = [request.skill, request.ability, request.save].filter(Boolean).length;
+  if (kinds !== 1) throw new Error('Give exactly one of skill, ability or save');
+  const message = messageFor(request.public);
+  const config: Record<string, any> = {};
+  if (request.advantage) config.advantage = true;
+  if (request.disadvantage) config.disadvantage = true;
+  if (request.dc !== undefined) config.target = request.dc;
+  let label: string;
+  let run: (actor: any) => Promise<any>;
+  if (request.skill) {
+    const skill = resolveKey(tables.skills, request.skill);
+    if (!skill) throw new Error(`Unknown skill "${request.skill}"`);
+    label = `${skill} check`;
+    run = actor => actor.rollSkill({ ...config, skill }, NO_DIALOG, message);
+  } else {
+    const raw = (request.ability ?? request.save) as string;
+    const ability = resolveKey(tables.abilities, raw);
+    if (!ability) throw new Error(`Unknown ability "${raw}"`);
+    if (request.save) {
+      label = `${ability} save`;
+      run = actor => actor.rollSavingThrow({ ...config, ability }, NO_DIALOG, message);
+    } else {
+      label = `${ability} check`;
+      run = actor => actor.rollAbilityCheck({ ...config, ability }, NO_DIALOG, message);
+    }
+  }
+  const results: Array<Record<string, any>> = [];
+  for (const w of who) {
+    const rolls = await run(w.actor);
+    const roll = Array.isArray(rolls) ? rolls[0] : rolls;
+    const natural = roll?.dice?.[0]?.results?.find((r: any) => r.active !== false)?.result;
+    const value = Number(roll?.total);
+    results.push({ name: w.name, total: value, ...(natural !== undefined ? { natural } : {}), ...(request.dc !== undefined ? { success: value >= request.dc } : {}) });
+  }
+  return { roll: label, ...(request.dc !== undefined ? { dc: request.dc } : {}), results };
+}

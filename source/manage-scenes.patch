+/**
+ * The map generation dialog's code finds its elements by id. This guards against a template
+ * edit (or rename) that leaves the code looking for an id that no longer exists, which once
+ * made the custom address fields impossible to show.
+ */
+
+import { describe, expect, it } from 'vitest';
+import { readFileSync } from 'fs';
+import { dirname, join } from 'path';
+import { fileURLToPath } from 'url';
+
+const here = dirname(fileURLToPath(import.meta.url));
+const template = readFileSync(join(here, '..', 'templates', 'comfyui-settings.html'), 'utf8');
+const settings = readFileSync(join(here, 'settings.ts'), 'utf8');
+
+// The dialog class is the one that loads this template.
+const dialogCode = settings.slice(settings.indexOf('comfyui-settings.html'));
+
+describe('map generation dialog template', () => {
+  it('has every element id the dialog code looks up', () => {
+    const wanted = new Set<string>();
+    for (const match of dialogCode.matchAll(/find\(\s*'([^']+)'\s*\)/g)) {
+      for (const part of match[1].split(',')) {
+        const id = part.trim().match(/^#([\w-]+)$/)?.[1];
+        if (id) wanted.add(id);
+      }
+    }
+    expect(wanted.size).toBeGreaterThan(4);
+
+    const missing = [...wanted].filter(id => !template.includes(`id="${id}"`));
+    expect(missing).toEqual([]);
+  });
+
+  it('has a form field for every setting the dialog reads', () => {
+    for (const name of [
+      'mapGenMode',
+      'mapGenCustomHost',
+      'mapGenCustomPort',
+      'mapGenCustomSecure',
+      'autoStartService',
+      'mapGenQuality',
+    ]) {
+      expect(template).toContain(`name="${name}"`);
+    }
+  });
+
+  it('only uses styles that the map generation stylesheet defines', () => {
+    const css = readFileSync(join(here, '..', 'styles', 'map-generation.css'), 'utf8');
+    const used = new Set<string>();
+    for (const match of template.matchAll(/class="([^"]+)"/g)) {
+      match[1]
+        .split(/\s+/)
+        .filter(c => c.startsWith('mgs-'))
+        .forEach(c => used.add(c));
+    }
+    const undefinedClasses = [...used].filter(c => !css.includes(`.${c}`));
+    expect(undefinedClasses).toEqual([]);
+  });
+});

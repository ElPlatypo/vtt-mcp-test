+    const gridPx = a.scene_grid_size ?? 64;
+    const created = await this.client().query('foundry-mcp-bridge.manage-scenes', {
+      action: 'create',
+      name: a.scene_name,
+      background: uploaded.path,
+      width: doc.columns * gridPx,
+      height: doc.rows * gridPx,
+      grid_size: gridPx,
+      padding: 0,
+      ...(a.scene_options ?? {}),
+    });
+    if (created?.success === false) throw new Error(created.error || 'The scene could not be created');
+    const sceneId: string | undefined = created?.scene?.id;
+    if (!sceneId) throw new Error('Foundry did not return the new scene');

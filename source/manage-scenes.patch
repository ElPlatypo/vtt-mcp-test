+    expect(Object.keys(def.inputSchema.properties).sort()).toEqual([
+      'action',
+      'depth',
+      'embedded_identifier',
+      'embedded_type',
+      'identifier',
+      'include_embedded',
+      'limit',
+      'max_chars',
+      'path',
+      'search',
+      'type',
+      'uuid',
+    ]);
+  });
+});
+
+describe('InspectTools.handleInspectDocument', () => {
+  it('forwards list, get and schema requests', async () => {
+    const { tools, query } = makeTools();
+    await tools.handleInspectDocument({ action: 'list', type: 'Scene', search: 'cave' });
+    await tools.handleInspectDocument({
+      action: 'get',
+      type: 'Actor',
+      identifier: 'Klarg',
+      path: 'system.attributes.hp',

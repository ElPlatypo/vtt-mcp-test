+    const result = await tools.handleLayout({ action: 'build', layout: 'build two', scene_name: 'S', prompt: 'p', walls: false, auto_align: false });
+    expect(calls.some(c => c.args.action === 'place')).toBe(false);
+    expect(result.walls).toBeUndefined();
+
+    await expect(tools.handleLayout({ action: 'build', layout: 'build two', prompt: 'p' })).rejects.toThrow('scene_name');
+    await expect(tools.handleLayout({ action: 'build', layout: 'build two', scene_name: 'S' })).rejects.toThrow('prompt');
+    const bare = make();

+/**
+ * The name of a chat visibility mode for the running Foundry version. Foundry v14 names them
+ * public | gm | blind | self (CONFIG.ChatMessage.modes); older versions publicroll | gmroll | ...
+ * dnd5e 6 passes the message's rollMode straight on as v14's messageMode, and v14 treats an
+ * unknown name as the table default (usually public), so the old names leak GM-only rolls.
+ */
+export type Visibility = 'public' | 'gm' | 'blind' | 'self';
+
+const LEGACY: Record<Visibility, string> = { public: 'publicroll', gm: 'gmroll', blind: 'blindroll', self: 'selfroll' };
+
+export function rollModeName(visibility: Visibility, modes: Record<string, unknown> | undefined = (globalThis as any).CONFIG?.ChatMessage?.modes): string {
+  return modes && visibility in modes ? visibility : LEGACY[visibility];
+}

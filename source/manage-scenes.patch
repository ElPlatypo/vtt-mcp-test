+/** chat: reading and narrating. Foundry is stubbed. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+import { chatRow, selectMessages } from './chat-utils.js';
+
+const users: Record<string, any> = {
+  gm: { id: 'gm', name: 'Gamemaster', isGM: true },
+  cl: { id: 'cl', name: 'Claudio', isGM: false },
+};
+const name = (id: string) => users[id]?.name;
+const msg = (id: string, over: any = {}) => ({ id, author: users.cl, content: '', speaker: { alias: 'Randal' }, rolls: [], whisper: [], ...over });
+
+describe('chat utils', () => {
+  it('writes rows for speech, rolls, whispers and cards', () => {
+    expect(chatRow(msg('a', { content: '<p>I <b>search</b> the bodies.</p>' }), name)).toMatchObject({ kind: 'say', who: 'Claudio', as: 'Randal', text: 'I search the bodies.', fromGM: false });
+    expect(chatRow(msg('b', { rolls: [{ formula: '1d20+5', total: 18 }], flavor: 'Perception' }), name)).toMatchObject({ kind: 'roll', roll: { formula: '1d20+5', total: 18 }, flavor: 'Perception' });
+    expect(chatRow(msg('c', { author: users.gm, content: 'Psst.', whisper: ['cl'], speaker: { alias: 'Gamemaster' } }), name)).toMatchObject({ kind: 'whisper', to: ['Claudio'], fromGM: true });
+    expect(chatRow(msg('d'), name).kind).toBe('card');
+    expect(chatRow(msg('e', { content: 'x'.repeat(500) }), name).text!.length).toBe(400);
+  });
+  it('marks what the bridge, the system or a GM roll posts as automatic', () => {
+    const gm = { author: users.gm };
+    expect(chatRow(msg('a', { content: 'typed' }), name).auto).toBeUndefined();
+    expect(chatRow(msg('b', { ...gm, content: 'Narration', flags: { 'foundry-mcp-bridge-scenes': { bridge: true } } }), name).auto).toBe(true);
+    expect(chatRow(msg('c', { ...gm, content: 'spoken', flags: { 'foundry-mcp-bridge-scenes': { tts: { segments: [] } } } }), name).auto).toBe(true);
+    expect(chatRow(msg('d', { ...gm, content: 'Longsword', flags: { dnd5e: { messageType: 'usage' } } }), name).auto).toBe(true);
+    expect(chatRow(msg('e', { content: 'card', type: 'usage' }), name).auto).toBe(true);
+    expect(chatRow(msg('f', { ...gm, rolls: [{ formula: '1d20', total: 3 }] }), name).auto).toBe(true);
+    expect(chatRow(msg('g', { rolls: [{ formula: '1d20', total: 3 }] }), name).auto).toBeUndefined();
+  });
+  it('selects after a marker, by sender and without rolls', () => {
+    const all = [msg('1', { content: 'old' }), msg('2', { author: users.gm, content: 'gm line' }), msg('3', { rolls: [{ formula: '1d20', total: 4 }] }), msg('4', { content: 'new' })];
+    expect(selectMessages(all, { since: '1' }, name).map(r => r.id)).toEqual(['2', '3', '4']);
+    expect(selectMessages(all, { from: 'players' }, name).map(r => r.id)).toEqual(['1', '3', '4']);
+    expect(selectMessages(all, { from: 'players', rolls: false }, name).map(r => r.id)).toEqual(['1', '4']);
+    expect(selectMessages(all, { since: 'nope' }, name)).toHaveLength(4);
+  });
+});
+
+function setup() {
+  const messages: any[] = [msg('1', { content: 'hello' }), msg('2', { author: users.gm, content: 'welcome' })];
+  const create = vi.fn(async (d: any) => {
+    const m = msg('n' + messages.length, { author: users.gm, content: d.content, speaker: d.speaker, whisper: d.whisper ?? [] });
+    messages.push(m);
+    return m;
+  });
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('ChatMessage', { create });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: users.gm,
+    users: Object.assign([users.gm, users.cl], { get: (id: string) => users[id] }),
+    messages: { contents: messages },
+    settings: { get: (_m: string, key: string) => (key === 'allowWriteOperations' ? true : undefined) },
+  });
+  return { da: new FoundryDataAccess(), messages, create };
+}
+
+describe('controlChat', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('reads the log with a marker, and only what is new after it', async () => {
+    const { da, messages } = setup();
+    const first = await da.controlChat({});
+    expect(first.messages.map((m: any) => m.id)).toEqual(['1', '2']);
+    expect(first.marker).toBe('2');
+    messages.push(msg('3', { content: 'I attack' }));
+    const next = await da.controlChat({ since: first.marker });
+    expect(next.messages.map((m: any) => m.text)).toEqual(['I attack']);
+    expect((await da.controlChat({ limit: 1 })).omitted).toBe(2);
+  });
+  it('refuses actions that do not exist, such as the old wait', async () => {
+    const { da } = setup();
+    await expect(da.controlChat({ action: 'wait' } as any)).rejects.toThrow('read or narrate');
+  });
+  it('narrates publicly or as a whisper, escaping html', async () => {
+    const { da, create } = setup();
+    const pub = await da.controlChat({ action: 'narrate', content: 'The wind <rises>.\n\nA twig snaps.' });
+    expect(create).toHaveBeenLastCalledWith({ content: '<p>The wind &lt;rises&gt;.</p><p>A twig snaps.</p>', speaker: { alias: 'Narrator' }, flags: { 'foundry-mcp-bridge-scenes': { bridge: true } } });
+    expect(pub).toMatchObject({ success: true, delivery: 'public' });
+    const priv = await da.controlChat({ action: 'narrate', content: 'You notice a glint.', whisperTo: ['claudio'], speaker: 'Your instincts' });
+    expect(create).toHaveBeenLastCalledWith({ content: '<p>You notice a glint.</p>', speaker: { alias: 'Your instincts' }, flags: { 'foundry-mcp-bridge-scenes': { bridge: true } }, whisper: ['cl'] });
+    expect(priv).toMatchObject({ delivery: 'whisper', to: ['Claudio'] });
+    await expect(da.controlChat({ action: 'narrate' })).rejects.toThrow('needs content');
+    await expect(da.controlChat({ action: 'narrate', content: 'x', whisperTo: ['nobody'] })).rejects.toThrow('No matching players');
+  });
+});

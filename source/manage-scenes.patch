@@ -0,0 +1,107 @@
+import { z } from 'zod';
+import type { FoundryClient } from '../foundry-client.js';
+import type { Logger } from '../logger.js';
+import type { TableFeed } from '../table-feed.js';
+
+export interface TableWatchToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+  feed: TableFeed;
+}
+
+const seconds = (min: number, max: number) => z.number().min(min).max(max).optional();
+
+const schema = z
+  .object({
+    action: z.enum(['status', 'settings', 'expect', 'cancel_expect', 'flush']),
+    quiet_seconds: seconds(0, 60),
+    turn_quiet_seconds: seconds(0, 30),
+    min_interval_seconds: seconds(0, 300),
+    max_wait_seconds: seconds(1, 300),
+    max_background: z.number().int().min(0).max(200).optional(),
+    muted: z.boolean().optional(),
+    wake_on_doors: z.boolean().optional(),
+    who: z.array(z.string().min(1)).min(1).max(20).optional(),
+    timeout_seconds: seconds(5, 600),
+  })
+  .strict();
+
+export class TableWatchTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+  private feed: TableFeed;
+
+  constructor({ foundryClient, logger, feed }: TableWatchToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'TableWatchTools' });
+    this.feed = feed;
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'table-watch',
+        description:
+          'Follow the table in real time without being woken by every message. The table feed is a WebSocket on this computer (status gives its url, default ws://127.0.0.1:31418): in Claude Code start it once per session with the Monitor tool; each line it sends is one notification. It sends a line only when the GM is needed, as a "beat": {type:"beat", n, why, events, table}, where events lists everything since the last beat (oldest first) and table gives the scene, the combat order with hp and conditions, the party and who is online, so no further reads are usually needed. WAKES: a player chatting as their character (in character or emote) or privately to the GM; a GM-run creature\'s turn in combat; a player opening a door (setting); all awaited rolls coming in. NOT WAKING, but listed in the next beat: rolls, item and spell cards, token moves by players, hp changed by players, players joining or leaving, combat start and end, a player\'s turn. IGNORED: public out-of-character chat, blind messages, whispers between players, and what the bridge or the GM\'s tools post. A beat goes once the table has been quiet for quiet_seconds after the last waking event (turn_quiet_seconds after a turn change), at most every min_interval_seconds, and at the latest max_wait_seconds after the first waking event. {type:"notice"} lines report the GM muting or unmuting, Foundry disconnecting or reloading. ACTIONS: status; settings {quiet_seconds?, turn_quiet_seconds?, min_interval_seconds?, max_wait_seconds?, max_background?, muted?, wake_on_doors?} (muted and wake_on_doors are also Foundry module settings the GM can toggle; while muted nothing is sent and everything comes in one beat when unmuted); expect {who:[player or character names], timeout_seconds?(90)} holds the next beat until each of them has rolled, or the timeout (request-player-rolls does this automatically for its target); cancel_expect; flush sends what is pending now. A player\'s chat is their action: answer it, never act for them; never repeat a private message to other players.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: { type: 'string', enum: ['status', 'settings', 'expect', 'cancel_expect', 'flush'] },
+            quiet_seconds: { type: 'number', description: 'settings: quiet time after the last waking event (default 5)' },
+            turn_quiet_seconds: { type: 'number', description: 'settings: quiet time after a turn change (default 1.5)' },
+            min_interval_seconds: { type: 'number', description: 'settings: minimum gap between beats (default 10)' },
+            max_wait_seconds: { type: 'number', description: 'settings: longest a waking event waits (default 25)' },
+            max_background: { type: 'number', description: 'settings: most background events per beat (default 40)' },
+            muted: { type: 'boolean', description: 'settings: mute (true) or unmute (false) the feed for everyone' },
+            wake_on_doors: { type: 'boolean', description: 'settings: wake when a player opens a door (default true)' },
+            who: { type: 'array', items: { type: 'string' }, description: 'expect: players or characters whose rolls to wait for' },
+            timeout_seconds: { type: 'number', description: 'expect: how long to wait (default 90)' },
+          },
+          required: ['action'],
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handle(args: unknown): Promise<any> {
+    const a = schema.parse(args);
+    switch (a.action) {
+      case 'status':
+        return { success: true, ...this.feed.status() };
+      case 'settings': {
+        const patch: Record<string, number> = {};
+        if (a.quiet_seconds !== undefined) patch.quietMs = a.quiet_seconds * 1000;
+        if (a.turn_quiet_seconds !== undefined) patch.turnQuietMs = a.turn_quiet_seconds * 1000;
+        if (a.min_interval_seconds !== undefined) patch.minIntervalMs = a.min_interval_seconds * 1000;
+        if (a.max_wait_seconds !== undefined) patch.maxWaitMs = a.max_wait_seconds * 1000;
+        if (a.max_background !== undefined) patch.maxBackground = a.max_background;
+        this.feed.configure(patch);
+        let module: Record<string, any> | undefined;
+        if (a.muted !== undefined || a.wake_on_doors !== undefined) {
+          module = await this.foundryClient.query('foundry-mcp-bridge.table-events', {
+            action: 'settings',
+            ...(a.muted !== undefined ? { muted: a.muted } : {}),
+            ...(a.wake_on_doors !== undefined ? { wake_on_doors: a.wake_on_doors } : {}),
+          });
+          if (module?.success === false) throw new Error(module.error || 'Could not change the table watch settings');
+          if (typeof module?.muted === 'boolean') this.feed.bundler.muted = module.muted;
+        }
+        this.logger.info('Table watch settings changed', { patch, muted: a.muted, wake_on_doors: a.wake_on_doors });
+        return { success: true, ...this.feed.status(), ...(module ? { wake_on_doors: module.wake_on_doors } : {}) };
+      }
+      case 'expect': {
+        if (!a.who?.length) throw new Error('expect needs who: the players or characters whose rolls to wait for');
+        this.feed.expect(a.who, (a.timeout_seconds ?? 90) * 1000);
+        return { success: true, awaitingRolls: this.feed.bundler.awaiting };
+      }
+      case 'cancel_expect':
+        this.feed.cancelExpectation();
+        return { success: true };
+      case 'flush': {
+        const sent = await this.feed.flushNow('asked for by the GM (flush)');
+        return { success: true, sent, ...(sent ? {} : { note: 'Nobody is listening to the feed; start it with the Monitor tool first' }) };
+      }
+    }
+  }
+}

+import { describe, expect, it, vi } from 'vitest';
+import { JournalTools } from './journal.js';
+
+function makeTools(result: any = { success: true }) {
+  const query = vi.fn(async () => result);
+  const logger: any = {
+    info: vi.fn(),
+    debug: vi.fn(),
+    error: vi.fn(),
+    warn: vi.fn(),
+    child: () => logger,
+  };
+  return { tools: new JournalTools({ foundryClient: { query } as any, logger }), query };
+}
+
+describe('manage-journals definition', () => {
+  it('requires only action', () => {
+    const def = makeTools().tools.getToolDefinitions()[0];
+    expect(def.name).toBe('manage-journals');
+    expect(def.inputSchema.required).toEqual(['action']);
+    expect(Object.keys(def.inputSchema.properties).sort()).toEqual([
+      'action',
+      'folder',
+      'journal',
+      'name',
+      'ownership',
+      'pages',
+    ]);
+  });
+});
+
+describe('JournalTools.handleManageJournals', () => {
+  it('forwards a create request to the bridge', async () => {
+    const { tools, query } = makeTools({ success: true, journal: { id: 'j1' } });
+    const args = {
+      action: 'create',
+      name: 'Goblin Arrows',
+      folder: 'Part 1',
+      ownership: 'observer',
+      pages: [
+        { name: 'Intro', content: '<p>Hi</p>' },
+        { name: 'Map', type: 'image', src: 'a.png' },
+      ],
+    };
+
+    const result = await tools.handleManageJournals(args);
+
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.manage-journals', args);
+    expect(result.journal.id).toBe('j1');
+  });
+
+  it('allows describe with no other fields', async () => {
+    const { tools, query } = makeTools();
+    await tools.handleManageJournals({ action: 'describe' });
+    expect(query).toHaveBeenCalled();
+  });
+
+  it.each([
+    ['create without a name', { action: 'create' }, 'name is required'],
+    ['update without a journal', { action: 'update', name: 'x' }, 'journal is required'],
+    ['an unknown action', { action: 'delete', journal: 'x' }, ''],
+    ['an unknown field', { action: 'describe', purge: true }, ''],
+    [
+      'an unknown page field',
+      { action: 'create', name: 'x', pages: [{ name: 'a', html: 'b' }] },
+      '',
+    ],
+    ['a bad ownership', { action: 'create', name: 'x', ownership: 'everyone' }, ''],
+    [
+      'a bad title level',
+      { action: 'create', name: 'x', pages: [{ name: 'a', title_level: 9 }] },
+      '',
+    ],
+    [
+      'too many pages',
+      {
+        action: 'create',
+        name: 'x',
+        pages: Array.from({ length: 101 }, (_, i) => ({ name: `p${i}` })),
+      },
+      '',
+    ],
+  ])('rejects %s before contacting Foundry', async (_label, args, message) => {
+    const { tools, query } = makeTools();
+    await expect(tools.handleManageJournals(args)).rejects.toThrow(message || undefined);
+    expect(query).not.toHaveBeenCalled();
+  });
+
+  it('wraps bridge failures once', async () => {
+    const query = vi.fn(async () => {
+      throw new Error('Failed to create journal: boom');
+    });
+    const logger: any = { info: vi.fn(), error: vi.fn(), child: () => logger };
+    const tools = new JournalTools({ foundryClient: { query } as any, logger });
+
+    await expect(tools.handleManageJournals({ action: 'create', name: 'x' })).rejects.toThrow(
+      'Failed to manage journals: Failed to create journal: boom'
+    );
+  });
+});

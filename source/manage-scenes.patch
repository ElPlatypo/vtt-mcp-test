+        const sx = x - dx;
+        const sy = y - dy;
+        const o = (y * width + x) * 4;
+        if (sx >= 0 && sy >= 0 && sx < width && sy < height) {
+          const s = (sy * width + sx) * 3;
+          data[o] = rgb[s]!;
+          data[o + 1] = rgb[s + 1]!;
+          data[o + 2] = rgb[s + 2]!;
+        }
+        data[o + 3] = 255;
+      }
+    }
+    return { width, height, data };
+  }
+
+  it('finds no shift when the picture lines up', () => {
+    const result = alignToImage(layout, pictureShifted(0, 0));

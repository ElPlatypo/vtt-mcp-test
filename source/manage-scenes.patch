+    expect(parseComfyTarget(null)).toEqual(BUILTIN_TARGET);
+    expect(parseComfyTarget({})).toEqual(BUILTIN_TARGET);
+    expect(parseComfyTarget({ mode: 'builtin', host: 'evil.example', port: 1 })).toEqual(
+      BUILTIN_TARGET
+    );
+  });
+
+  it('accepts a custom host name, address or IPv6 address', () => {
+    expect(parseComfyTarget({ mode: 'custom', host: 'localhost', port: 8188 })).toEqual({
+      mode: 'custom',
+      host: 'localhost',
+      port: 8188,
+      secure: false,
+    });
+    expect(
+      parseComfyTarget({ mode: 'custom', host: ' nexus.lan ', port: 443, secure: true })
+    ).toEqual({ mode: 'custom', host: 'nexus.lan', port: 443, secure: true });
+    expect(parseComfyTarget({ mode: 'custom', host: '192.168.1.20', port: 8188 }).host).toBe(
+      '192.168.1.20'
+    );
+    expect(parseComfyTarget({ mode: 'custom', host: '[::1]', port: 8188 }).host).toBe('[::1]');
+  });
+
+  it.each([
+    ['an unknown mode', { mode: 'cloud' }, 'mode must be'],
+    ['a missing host', { mode: 'custom', port: 8188 }, 'host must be'],
+    ['a URL as host', { mode: 'custom', host: 'http://nexus', port: 8188 }, 'host must be'],
+    ['a host with a port', { mode: 'custom', host: 'nexus:8188', port: 8188 }, 'host must be'],
+    ['a host with a path', { mode: 'custom', host: 'nexus/api', port: 8188 }, 'host must be'],
+    ['a host with credentials', { mode: 'custom', host: 'a@nexus', port: 8188 }, 'host must be'],
+    ['a host with spaces', { mode: 'custom', host: 'my host', port: 8188 }, 'host must be'],
+    ['a text port', { mode: 'custom', host: 'nexus', port: '8188' }, 'port must be'],
+    ['port 0', { mode: 'custom', host: 'nexus', port: 0 }, 'port must be'],

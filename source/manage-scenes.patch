+    if (matches.length === 1) return matches[0];
+    if (matches.length > 1) {
+      throw new Error(
+        `Several journals are named "${identifier}" (ids: ${matches.map(j => j.id).join(', ')}); use the id`
+      );
+    }
+    throw new Error(`Journal not found: "${identifier}"`);
+  }
+
+  /** Look a document up by kind and name for {{kind: Name}} links. */
+  private lookupLinkTarget(kind: LinkKind, name: string): { id: string; name: string } | 'ambiguous' | null {
+    const collections: Record<LinkKind, any> = {
+      actor: (game as any).actors,
+      scene: (game as any).scenes,
+      journal: (game as any).journal,
+      item: (game as any).items,
+      rolltable: (game as any).tables,
+    };
+    const docs = (collections[kind]?.contents || []) as any[];
+    const wanted = name.trim().toLowerCase();
+    const byId = docs.find(d => d.id === name.trim());
+    if (byId) return { id: byId.id, name: byId.name };
+    const matches = docs.filter(d => String(d.name ?? '').toLowerCase() === wanted);
+    if (matches.length === 1) return { id: matches[0].id, name: matches[0].name };
+    return matches.length > 1 ? 'ambiguous' : null;
+  }
+
+  /** Make journal HTML safe and resolve {{kind: Name}} links. */
+  private prepareJournalHtml(content: string, warnings: string[]): string {
+    const safe = stripUnsafeHtml(content);
+    const resolved = resolveContentLinks(safe, (kind, name) => this.lookupLinkTarget(kind, name));
+    warnings.push(...resolved.warnings);
+    return resolved.html;
+  }
+
+  private summarizeJournal(journal: any, includePages: boolean): Record<string, any> {
+    const level = journal.ownership?.default;
+    const summary: Record<string, any> = {
+      id: journal.id,
+      name: journal.name,
+      folder: journal.folder?.name ?? null,
+      ownership: ownershipName(level),
+      pageCount: journal.pages?.size ?? journal.pages?.contents?.length ?? 0,
+    };
+    if (includePages) {
+      const pages = ((journal.pages?.contents || []) as any[])
+        .slice()
+        .sort((a, b) => (a.sort ?? 0) - (b.sort ?? 0));
+      summary.pages = pages.map(page => ({
+        id: page.id,
+        name: page.name,
+        type: page.type,
+        sort: page.sort,
+        ...(page.type === 'text'
+          ? { content: page.text?.content ?? '' }
+          : page.type === 'image'
+            ? { src: page.src ?? null, caption: page.image?.caption ?? '' }
+            : {}),
+        showTitle: page.title?.show,
+        titleLevel: page.title?.level,
+      }));
+    }
+    return summary;
+  }
+
+  /**
+   * Create, update or describe journals.
+   * create: a journal with exactly the pages given (text pages as HTML, or image pages).
+   * update: rename, move to a folder, change who can see it, and upsert pages (matched by id
+   *   or exact name; created when no page matches). Never removes pages or journals.
+   * describe: lists all journals, or one journal with its full pages.
+   * Text may contain {{actor: Name}}, {{scene: Name}}, {{journal: Name}}, {{item: Name}} or
+   * {{rolltable: Name}} (optionally {{actor: Name | label}}), which become Foundry links.
+   */
+  async manageJournals(options: {
+    action: 'create' | 'update' | 'describe';
+    journal?: string;
+    name?: string;
+    folder?: string;
+    ownership?: OwnershipName;
+    pages?: Array<{
+      id?: string;
+      name?: string;
+      type?: 'text' | 'image';
+      content?: string;
+      src?: string;
+      caption?: string;
+      show_title?: boolean;
+      title_level?: number;
+    }>;
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      if (options.action === 'describe') {
+        if (options.journal) {
+          const journal = this.findJournalByIdentifier(options.journal);
+          return { success: true, journal: this.summarizeJournal(journal, true) };
+        }
+        const journals = (((game as any).journal?.contents || []) as any[]).map(j =>
+          this.summarizeJournal(j, false)
+        );
+        return { success: true, journals };
+      }
+
+      if (options.action !== 'create' && options.action !== 'update') {
+        throw new Error(`Unknown action: ${String(options.action)} (create | update | describe)`);
+      }
+
+      const permissionCheck = permissionManager.checkWritePermission('createActor', {
+        quantity: 1,
+      });
+      if (!permissionCheck.allowed) {
+        throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${permissionCheck.reason}`);
+      }
+
+      if (options.name !== undefined && (typeof options.name !== 'string' || !options.name.trim())) {
+        throw new Error('name must be a non-empty string');
+      }
+      if (options.ownership !== undefined && !(options.ownership in OWNERSHIP_LEVELS)) {
+        throw new Error('ownership must be one of: none, limited, observer, owner');
+      }
+      if (options.folder !== undefined && (typeof options.folder !== 'string' || !options.folder.trim())) {
+        throw new Error('folder must be a non-empty string');
+      }
+      const pageSpecs = options.pages ?? [];
+      if (!Array.isArray(pageSpecs) || pageSpecs.length > 100) {
+        throw new Error('pages must be a list of at most 100 pages');
+      }
+      for (const spec of pageSpecs) {
+        if (spec.type !== undefined && spec.type !== 'text' && spec.type !== 'image') {
+          throw new Error(`Unsupported page type "${String(spec.type)}" (text | image)`);
+        }
+        if (typeof spec.content === 'string' && spec.content.length > 1_000_000) {
+          throw new Error('A page may hold at most 1,000,000 characters');
+        }
+        if (
+          spec.title_level !== undefined &&
+          (!Number.isInteger(spec.title_level) || spec.title_level < 1 || spec.title_level > 6)
+        ) {
+          throw new Error('title_level must be a whole number from 1 to 6');
+        }
+      }
+
+      const warnings: string[] = [];
+      const html = (content: string) => this.prepareJournalHtml(content, warnings);
+
+      // Fields of a page document from a spec (create: all defaults; update: only given).
+      const pageFields = (spec: (typeof pageSpecs)[number], type: 'text' | 'image') => {
+        const fields: Record<string, any> = {};
+        if (type === 'text' && spec.content !== undefined) {
+          fields['text.content'] = html(spec.content);
+        }
+        if (type === 'image') {
+          if (spec.src !== undefined) fields.src = spec.src;
+          if (spec.caption !== undefined) fields['image.caption'] = spec.caption;
+        }
+        if (spec.show_title !== undefined) fields['title.show'] = spec.show_title;
+        if (spec.title_level !== undefined) fields['title.level'] = spec.title_level;
+        return fields;
+      };
+
+      const nest = (flat: Record<string, any>): Record<string, any> => {
+        const out: Record<string, any> = {};
+        for (const [path, value] of Object.entries(flat)) {
+          const parts = path.split('.');
+          let cursor = out;
+          parts.slice(0, -1).forEach(part => {
+            cursor[part] = cursor[part] ?? {};
+            cursor = cursor[part];
+          });
+          cursor[parts[parts.length - 1]] = value;
+        }
+        return out;
+      };
+
+      const newPageData = (spec: (typeof pageSpecs)[number], sort: number) => {
+        const type = spec.type ?? 'text';
+        if (!spec.name || typeof spec.name !== 'string' || !spec.name.trim()) {
+          throw new Error('Every new page needs a name');
+        }
+        if (type === 'image' && !spec.src) {
+          throw new Error(`Image page "${spec.name}" needs a src (a Foundry file path)`);
+        }
+        const data = nest(pageFields(spec, type));
+        if (type === 'text') {
+          data.text = { format: 1, content: '', ...(data.text ?? {}) };
+        }
+        return { name: spec.name.trim(), type, sort, ...data };
+      };
+
+      let journal: any;
+      const pageResults: Array<{ id: string; name: string; type: string; result: string }> = [];
+
+      if (options.action === 'create') {
+        if (!options.name) throw new Error('name is required for create');
+        const folderId = options.folder
+          ? await this.getOrCreateFolder(options.folder.trim(), 'JournalEntry')
+          : null;
+        if (options.folder && !folderId) {
+          warnings.push(`folder "${options.folder}" could not be created; the journal is in the root`);
+        }
+        const pagesData = pageSpecs.map((spec, index) => newPageData(spec, (index + 1) * 100000));
+        journal = await JournalEntry.create({
+          name: options.name.trim(),
+          pages: pagesData,
+          ownership: { default: OWNERSHIP_LEVELS[options.ownership ?? 'none'] },
+          ...(folderId ? { folder: folderId } : {}),
+        } as any);
+        if (!journal) throw new Error('Foundry did not return the created journal');
+        for (const page of ((journal.pages?.contents || []) as any[])) {
+          pageResults.push({ id: page.id, name: page.name, type: page.type, result: 'created' });
+        }
+      } else {
+        if (!options.journal) throw new Error('journal is required for update');
+        journal = this.findJournalByIdentifier(options.journal);
+        const hasChange =
+          options.name !== undefined ||
+          options.folder !== undefined ||
+          options.ownership !== undefined ||
+          pageSpecs.length > 0;
+        if (!hasChange) throw new Error('Nothing to update: pass at least one field to change');
+
+        const journalUpdate: Record<string, any> = {};
+        if (options.name !== undefined) journalUpdate.name = options.name.trim();
+        if (options.ownership !== undefined) {
+          journalUpdate.ownership = { default: OWNERSHIP_LEVELS[options.ownership] };
+        }
+        if (options.folder !== undefined) {
+          const folderId = await this.getOrCreateFolder(options.folder.trim(), 'JournalEntry');
+          if (!folderId) {
+            warnings.push(`folder "${options.folder}" could not be created; the journal was not moved`);
+          } else {
+            journalUpdate.folder = folderId;
+          }
+        }
+        if (Object.keys(journalUpdate).length > 0) {
+          await journal.update(journalUpdate);
+        }
+
+        const existing = ((journal.pages?.contents || []) as any[]).slice();
+        let nextSort =
+          existing.reduce((max, page) => Math.max(max, page.sort ?? 0), 0) + 100000;
+        for (const spec of pageSpecs) {
+          let target: any;
+          if (spec.id) {
+            target = existing.find(p => p.id === spec.id);
+            if (!target) throw new Error(`Page not found: ${spec.id}`);
+          } else if (spec.name) {
+            const wanted = spec.name.trim().toLowerCase();
+            const matches = existing.filter(p => String(p.name ?? '').toLowerCase() === wanted);
+            if (matches.length > 1) {
+              throw new Error(
+                `Several pages are named "${spec.name}" (ids: ${matches.map(p => p.id).join(', ')}); pass the id`
+              );
+            }
+            target = matches[0];
+          } else {
+            throw new Error('Every page needs an id or a name');
+          }
+
+          if (target) {
+            if (spec.type !== undefined && spec.type !== target.type) {
+              throw new Error(
+                `Page "${target.name}" is a ${target.type} page; its type cannot change`
+              );
+            }
+            const fields = pageFields(spec, target.type);
+            if (Object.keys(fields).length === 0) {
+              warnings.push(`page "${target.name}" had nothing to change`);
+              continue;
+            }
+            await target.update(fields);
+            pageResults.push({ id: target.id, name: target.name, type: target.type, result: 'updated' });
+          } else {
+            const created = await journal.createEmbeddedDocuments('JournalEntryPage', [
+              newPageData(spec, nextSort),
+            ]);
+            nextSort += 100000;
+            const page = created?.[0];
+            if (page) existing.push(page);
+            pageResults.push({
+              id: page?.id ?? '',
+              name: spec.name!.trim(),
+              type: spec.type ?? 'text',
+              result: 'created',
+            });
+          }
+        }
+      }
+
+      this.auditLog(`manageJournals:${options.action}`, { ...options, pages: pageSpecs.length }, 'success');
+
+      return {
+        success: true,
+        action: options.action,
+        journal: this.summarizeJournal(journal, false),
+        pages: pageResults,
+        ...(warnings.length > 0 ? { warnings } : {}),
+      };
+    } catch (error) {
+      this.auditLog(
+        `manageJournals:${options?.action}`,
+        { journal: options?.journal, name: options?.name },
+        'failure',
+        error instanceof Error ? error.message : 'Unknown error'
+      );
+      throw new Error(
+        `Failed to ${options?.action ?? 'manage'} journal: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+
+  // ===== FILE UPLOAD =====
+
+  /**
+   * Upload an image into the world's own upload folder (worlds/<world>/uploads/...),
+   * so it survives module updates and can be used as a scene background, token or
+   * portrait image. Only png, jpg, webp and gif are accepted, the bytes must match the
+   * extension, size is capped, and the folder is restricted to the world's upload tree.
+   * Existing files are not replaced unless overwrite is true.
+   */
+  async uploadFile(options: {
+    filename: string;
+    imageData: string;
+    folder?: string;
+    overwrite?: boolean;
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      const permissionCheck = permissionManager.checkWritePermission('modifyScene', {});
+      if (!permissionCheck.allowed) {
+        throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${permissionCheck.reason}`);
+      }
+
+      const filename = sanitizeUploadFilename(options.filename);
+      const folder = sanitizeUploadFolder(options.folder);
+      const bytes = decodeBase64(options.imageData);
+
+      if (bytes.length === 0) {
+        throw new Error('The file is empty');
+      }
+      if (bytes.length > UPLOAD_MAX_BYTES) {
+        throw new Error(
+          `The file is ${(bytes.length / 1024 / 1024).toFixed(1)} MB; the limit is ${UPLOAD_MAX_BYTES / 1024 / 1024} MB`
+        );
+      }
+      const detected = detectImageType(bytes);
+      if (!detected) {
+        throw new Error('The file is not a PNG, JPEG, WebP or GIF image');
+      }
+      if (!extensionMatchesType(filename, detected)) {
+        throw new Error(
+          `The file content is ${detected.toUpperCase()} but the name says otherwise`
+        );
+      }
+
+      const worldId = (game as any).world?.id;
+      if (!worldId) {
+        throw new Error('No world is loaded');
+      }
+      const FilePickerAPI =
+        (globalThis as any).foundry?.applications?.apps?.FilePicker?.implementation ||
+        (globalThis as any).FilePicker;
+      if (!FilePickerAPI) {
+        throw new Error('Foundry file picker is not available');
+      }
+
+      // Create each level of worlds/<world>/uploads[/folder...]; existing ones are fine.
+      const segments = ['worlds', worldId, 'uploads', ...(folder ? folder.split('/') : [])];
+      let current = '';
+      for (const segment of segments) {
+        current = current ? `${current}/${segment}` : segment;
+        try {
+          await FilePickerAPI.createDirectory('data', current, { bucket: null });
+        } catch (dirError: any) {
+          const message = String(dirError?.message ?? dirError);
+          if (!message.includes('EEXIST') && !message.includes('already exists')) {
+            console.warn(`[${this.moduleId}] Directory creation warning for ${current}:`, message);
+          }
+        }
+      }
+      const directory = current;
+
+      // Do not silently replace an existing file.
+      if (!options.overwrite) {
+        let existing: string[] = [];
+        try {
+          const listing = await FilePickerAPI.browse('data', directory);
+          existing = (listing?.files ?? []).map((f: string) => {
+            try {
+              return decodeURIComponent(String(f));
+            } catch {
+              return String(f); // malformed %-encoding in one entry must not hide the others
+            }
+          });
+        } catch {
+          // Cannot list the folder: carry on rather than block the upload.
+        }
+        if (existing.some(f => f === `${directory}/${filename}` || f.endsWith(`/${filename}`))) {
+          throw new Error(
+            `File already exists: ${directory}/${filename}. Use a different filename or pass overwrite: true`
+          );
+        }
+      }
+
+      const mime = UPLOAD_IMAGE_TYPES[filename.slice(filename.lastIndexOf('.') + 1)];
+      const file = new File([bytes as BlobPart], filename, { type: mime });
+      const response = await FilePickerAPI.upload('data', directory, file, {}, { notify: false });
+      if (!response || !response.path) {
+        throw new Error('Foundry did not confirm the upload (it may have been rejected)');
+      }
+
+      this.auditLog('uploadFile', { filename, folder, bytes: bytes.length }, 'success');
+
+      return {
+        success: true,
+        path: response.path,
+        filename,
+        directory,
+        bytes: bytes.length,
+        contentType: mime,
+      };
+    } catch (error) {
+      this.auditLog(
+        'uploadFile',
+        { filename: options?.filename, folder: options?.folder },
+        'failure',
+        error instanceof Error ? error.message : 'Unknown error'
+      );
+      throw new Error(
+        `Failed to upload file: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+

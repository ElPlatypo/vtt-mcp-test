+/** set-actor-art: portrait, token picture and tokens already on scenes. Foundry is stubbed. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+
+function setup(allow = true) {
+  const actor: any = { id: 'a1', name: 'Goblin Boss', update: vi.fn(async () => undefined) };
+  const makeScene = (name: string, tokens: Array<{ id: string; actorId: string }>) => {
+    const scene: any = {
+      id: name,
+      name,
+      tokens: { contents: tokens, get: (id: string) => tokens.find(t => t.id === id) },
+      updateEmbeddedDocuments: vi.fn(async () => undefined),
+    };
+    return scene;
+  };
+  const s1 = makeScene('Cave', [{ id: 't1', actorId: 'a1' }, { id: 't2', actorId: 'other' }, { id: 't3', actorId: 'a1' }]);
+  const s2 = makeScene('Town', [{ id: 't4', actorId: 'other' }]);
+  const s3 = makeScene('Trail', [{ id: 't5', actorId: 'a1' }]);
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'GM' },
+    actors: { get: (id: string) => (id === 'a1' ? actor : undefined), getName: (n: string) => (n === 'Goblin Boss' ? actor : undefined), [Symbol.iterator]: function* () { yield actor; } },
+    scenes: Object.assign([s1, s2, s3], { contents: [s1, s2, s3] }),
+    settings: { get: (_m: string, key: string) => (key === 'allowWriteOperations' ? allow : undefined) },
+  });
+  return { da: new FoundryDataAccess(), actor, s1, s2, s3 };
+}
+
+describe('setActorArt', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('sets both pictures and updates the tokens of this actor on every scene', async () => {
+    const { da, actor, s1, s2, s3 } = setup();
+    const r = await da.setActorArt({ actor: 'Goblin Boss', img: 'a/portrait.png', tokenImg: 'a/token.png' });
+    expect(actor.update).toHaveBeenCalledWith({ img: 'a/portrait.png', 'prototypeToken.texture.src': 'a/token.png' });
+    expect(s1.updateEmbeddedDocuments).toHaveBeenCalledWith('Token', [{ _id: 't1', 'texture.src': 'a/token.png' }, { _id: 't3', 'texture.src': 'a/token.png' }]);
+    expect(s2.updateEmbeddedDocuments).not.toHaveBeenCalled();
+    expect(s3.updateEmbeddedDocuments).toHaveBeenCalledWith('Token', [{ _id: 't5', 'texture.src': 'a/token.png' }]);
+    expect(r).toMatchObject({ success: true, actor: { id: 'a1' }, img: 'a/portrait.png', tokenImg: 'a/token.png', tokensUpdated: 3, scenes: ['Cave', 'Trail'] });
+  });
+  it('leaves placed tokens alone when asked, and when only the portrait changes', async () => {
+    const { da, actor, s1 } = setup();
+    const r = await da.setActorArt({ actor: 'a1', tokenImg: 'a/token.png', update_placed: false });
+    expect(actor.update).toHaveBeenCalledWith({ 'prototypeToken.texture.src': 'a/token.png' });
+    expect(r.tokensUpdated).toBe(0);
+    await da.setActorArt({ actor: 'a1', img: 'a/p.png' });
+    expect(s1.updateEmbeddedDocuments).not.toHaveBeenCalled();
+  });
+  it('refuses bad requests and respects the write gate', async () => {
+    const { da, actor } = setup();
+    await expect(da.setActorArt({ actor: 'a1' })).rejects.toThrow('Give img');
+    await expect(da.setActorArt({ actor: 'a1', img: 'http://x/a.png' })).rejects.toThrow('not a web address');
+    await expect(da.setActorArt({ actor: 'Nobody', img: 'a.png' })).rejects.toThrow('Actor not found');
+    await expect(da.setActorArt({ actor: '', img: 'a.png' })).rejects.toThrow('actor');
+    expect(actor.update).not.toHaveBeenCalled();
+    const gated = setup(false);
+    await expect(gated.da.setActorArt({ actor: 'a1', img: 'a.png' })).rejects.toThrow();
+  });
+});

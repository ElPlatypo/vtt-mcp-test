+import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';
+import { promises as fs } from 'fs';
+import { SceneObjectTools } from './scene-objects.js';
+
+function makeTools(queryImpl?: (method: string, data: any, timeout?: number) => unknown) {
+  const query = vi.fn(queryImpl ?? (async () => ({ success: true })));
+  const logger: any = {
+    info: vi.fn(),
+    debug: vi.fn(),
+    error: vi.fn(),
+    warn: vi.fn(),
+    child: () => logger,
+  };
+  return { tools: new SceneObjectTools({ foundryClient: { query } as any, logger }), query };
+}
+
+describe('definitions', () => {
+  it('exposes manage-scene-objects and preview-scene', () => {
+    const defs = makeTools().tools.getToolDefinitions();
+    expect(defs.map(d => d.name)).toEqual(['manage-scene-objects', 'preview-scene']);
+    expect(defs[0].inputSchema.required).toEqual(['action']);
+  });
+});
+
+describe('handleManageSceneObjects', () => {
+  it('forwards a place request, dropping the light label', async () => {
+    const { tools, query } = makeTools(async () => ({ success: true, created: [] }));
+
+    await tools.handleManageSceneObjects({
+      action: 'place',
+      scene: 'Cave',
+      objects: [
+        { kind: 'token', actor: 'Goblin', x: 3, y: 2 },
+        { kind: 'light', x: 4.5, y: 4.5, dim: 4, label: 'torch by the door' },
+      ],
+    });
+
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.manage-scene-objects', {
+      action: 'place',
+      scene: 'Cave',
+      objects: [
+        { kind: 'token', actor: 'Goblin', x: 3, y: 2 },
+        { kind: 'light', x: 4.5, y: 4.5, dim: 4 },
+      ],
+    });
+  });
+
+  it('forwards describe and remove', async () => {
+    const { tools, query } = makeTools();
+    await tools.handleManageSceneObjects({ action: 'describe' });
+    await tools.handleManageSceneObjects({ action: 'remove', all_mine: true, kind: 'light' });
+    expect(query).toHaveBeenCalledTimes(2);
+  });
+
+  it.each([
+    ['place without objects', { action: 'place' }, 'objects is required'],
+    ['remove without ids or all_mine', { action: 'remove' }, 'ids or all_mine'],
+    ['an unknown kind', { action: 'place', objects: [{ kind: 'wall', x: 1, y: 1 }] }, ''],
+    ['a token without an actor', { action: 'place', objects: [{ kind: 'token', x: 1, y: 1 }] }, ''],
+    [
+      'an unknown field on a light',
+      { action: 'place', objects: [{ kind: 'light', x: 1, y: 1, dim: 1, glow: 3 }] },
+      '',
+    ],
+    [
+      'a bad colour',
+      { action: 'place', objects: [{ kind: 'light', x: 1, y: 1, dim: 1, color: 'red' }] },
+      '',
+    ],
+    [
+      'a bad disposition',
+      { action: 'place', objects: [{ kind: 'token', actor: 'a', x: 1, y: 1, disposition: 2 }] },
+      '',
+    ],
+    ['an unknown action', { action: 'delete-everything' }, ''],
+    ['an unknown top-level field', { action: 'describe', force: true }, ''],
+  ])('rejects %s before contacting Foundry', async (_label, args, message) => {
+    const { tools, query } = makeTools();
+    await expect(tools.handleManageSceneObjects(args)).rejects.toThrow(message || undefined);
+    expect(query).not.toHaveBeenCalled();
+  });
+
+  it('wraps a Foundry error once', async () => {
+    const { tools } = makeTools(async () => {
+      throw new Error('Failed to place scene objects: boom');
+    });
+    await expect(tools.handleManageSceneObjects({ action: 'describe' })).rejects.toThrow(
+      'Failed to manage scene objects: Failed to place scene objects: boom'
+    );
+  });
+});
+
+describe('handlePreviewScene', () => {
+  const created: string[] = [];
+  beforeAll(() => undefined);
+  afterAll(async () => {
+    for (const file of created) await fs.rm(file, { force: true });
+  });
+
+  it('saves the picture to a file and returns its path without the base64', async () => {
+    const png = Buffer.from([0x89, 0x50, 0x4e, 0x47, 1, 2, 3]);
+    const { tools, query } = makeTools(async () => ({
+      success: true,
+      scene: { id: 's', name: 'My Cave/../x' },
+      imageBase64: png.toString('base64'),
+      width: 100,
+      height: 50,
+    }));
+
+    const result = await tools.handlePreviewScene({ scene: 'My Cave', max_size: 800 });
+    created.push(result.file);
+
+    expect(query).toHaveBeenCalledWith(
+      'foundry-mcp-bridge.preview-scene',
+      { scene: 'My Cave', max_size: 800 },
+      60000
+    );
+    expect(result.imageBase64).toBeUndefined();
+    expect(result).toMatchObject({ width: 100, height: 50 });
+    expect(result.file).toMatch(/foundry-mcp-previews[\\/]My_Cave_x-\d+\.png$/);
+    expect(await fs.readFile(result.file)).toEqual(png);
+  });
+
+  it('fails clearly when Foundry returns no picture', async () => {
+    const { tools } = makeTools(async () => ({ success: true, scene: { name: 's' } }));
+    await expect(tools.handlePreviewScene({})).rejects.toThrow('returned no picture');
+  });
+
+  it('rejects bad options before contacting Foundry', async () => {
+    const { tools, query } = makeTools();
+    await expect(tools.handlePreviewScene({ max_size: 10 })).rejects.toThrow();
+    await expect(tools.handlePreviewScene({ extra: 1 })).rejects.toThrow();
+    expect(query).not.toHaveBeenCalled();
+  });
+});
diff --git a/packages/mcp-server/src/tools/scene-objects.ts b/packages/mcp-server/src/tools/scene-objects.ts
new file mode 100644
index 0000000..f596ebf
--- /dev/null
+++ b/packages/mcp-server/src/tools/scene-objects.ts
@@ -0,0 +1,277 @@
+import { promises as fs } from 'fs';
+import os from 'os';
+import path from 'path';
+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+
+export interface SceneObjectToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+/** Drawing the preview loads the map image in the GM's browser; allow more than 10 s. */
+const PREVIEW_TIMEOUT_MS = 60000;
+const KEEP_PREVIEWS = 20;
+
+const color = z.string().regex(/^#[0-9a-fA-F]{6}$/, 'color must look like #RRGGBB');
+
+const tokenSchema = z
+  .object({
+    kind: z.literal('token'),
+    actor: z.string().min(1),
+    x: z.number().finite(),
+    y: z.number().finite(),
+    name: z.string().min(1).optional(),
+    hidden: z.boolean().optional(),
+    disposition: z.union([z.literal(-1), z.literal(0), z.literal(1)]).optional(),
+    elevation: z.number().finite().optional(),
+  })
+  .strict();
+
+const lightSchema = z
+  .object({
+    kind: z.literal('light'),
+    x: z.number().finite(),
+    y: z.number().finite(),
+    bright: z.number().min(0).max(200).optional(),
+    dim: z.number().min(0).max(200).optional(),
+    color: color.optional(),
+    alpha: z.number().min(0).max(1).optional(),
+    angle: z.number().min(1).max(360).optional(),
+    rotation: z.number().finite().optional(),
+    hidden: z.boolean().optional(),
+    animation: z.string().min(1).optional(),
+    label: z.string().optional(),
+  })
+  .strict();
+
+const objectSchema = z.discriminatedUnion('kind', [tokenSchema, lightSchema]);
+
+const sceneObjectsSchema = z
+  .object({
+    action: z.enum(['place', 'describe', 'remove']),
+    scene: z.string().min(1).optional(),
+    objects: z.array(objectSchema).min(1).max(200).optional(),
+    ids: z.array(z.string().min(1)).max(500).optional(),
+    all_mine: z.boolean().optional(),
+    kind: z.enum(['token', 'light']).optional(),
+  })
+  .strict();
+
+const previewSchema = z
+  .object({
+    scene: z.string().min(1).optional(),
+    max_size: z.number().int().min(200).max(3000).optional(),
+    label_every: z.number().int().min(1).max(50).optional(),
+  })
+  .strict();
+
+export class SceneObjectTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: SceneObjectToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'SceneObjectTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'manage-scene-objects',
+        description:
+          'Place tokens and lights on a scene by grid square, describe what is on a scene, or remove objects this tool created (it never removes anything else). ' +
+          'Positions are in GRID SQUARES from the top-left corner of the map image: (0, 0) is the top-left corner of the first square, (2.5, 1.5) the centre of the square in column 2, row 1 (counting from 0). ' +
+          'Use preview-scene first to see the numbered grid. describe returns the scene grid size so you know the valid range. ' +
+          'place takes objects (up to 200): {kind:"token", actor, x, y} puts the actor\'s token with its top-left corner at that square (use whole numbers; actor is an id or exact name); {kind:"light", x, y, bright, dim} makes a light at that point with radii in squares (optional color, alpha, angle, rotation, animation, hidden). ' +
+          'remove needs ids or all_mine:true (optionally with kind) and only removes objects created by this tool. scene is an id or exact name; it defaults to the scene the GM is viewing.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: { type: 'string', enum: ['place', 'describe', 'remove'] },
+            scene: {
+              type: 'string',
+              description: 'Scene id or exact name (default: the scene being viewed)',
+            },
+            objects: {
+              type: 'array',
+              maxItems: 200,
+              description: 'Objects to place (action place)',
+              items: {
+                type: 'object',
+                properties: {
+                  kind: { type: 'string', enum: ['token', 'light'] },
+                  x: { type: 'number', description: 'Grid squares from the left edge of the map' },
+                  y: { type: 'number', description: 'Grid squares from the top edge of the map' },
+                  actor: { type: 'string', description: 'token: actor id or exact name' },
+                  name: {
+                    type: 'string',
+                    description: 'token: name to show instead of the actor name',
+                  },
+                  hidden: { type: 'boolean', description: 'token or light: hidden from players' },
+                  disposition: {
+                    type: 'number',
+                    enum: [-1, 0, 1],
+                    description: 'token: -1 hostile, 0 neutral, 1 friendly',
+                  },
+                  elevation: { type: 'number', description: 'token: elevation' },
+                  bright: { type: 'number', description: 'light: bright radius in squares' },
+                  dim: { type: 'number', description: 'light: dim radius in squares' },
+                  color: { type: 'string', description: 'light: #RRGGBB' },
+                  alpha: { type: 'number', description: 'light: colour opacity 0 to 1' },
+                  angle: {
+                    type: 'number',
+                    description: 'light: cone angle 1 to 360 (default 360)',
+                  },
+                  rotation: { type: 'number', description: 'light: cone direction in degrees' },
+                  animation: {
+                    type: 'string',
+                    description: 'light: animation type such as torch, pulse, ghost, wave, fog',
+                  },
+                  label: { type: 'string', description: 'light: note for yourself (not stored)' },
+                },
+                required: ['kind', 'x', 'y'],
+                additionalProperties: false,
+              },
+            },
+            ids: {
+              type: 'array',
+              items: { type: 'string' },
+              description: 'remove: ids of objects created by this tool',
+            },
+            all_mine: {
+              type: 'boolean',
+              description: 'remove: every object on the scene that this tool created',
+            },
+            kind: {
+              type: 'string',
+              enum: ['token', 'light'],
+              description: 'describe or remove: only this kind',
+            },
+          },
+          required: ['action'],
+          additionalProperties: false,
+        },
+      },
+      {
+        name: 'preview-scene',
+        description:
+          "Render a scene as a picture: the map image with a numbered grid (column numbers along the top and bottom, row numbers along the sides, stronger lines every 5 squares) and the scene's tokens (red) and lights (circles) on top. The picture is saved to a file on this computer; its path is returned, and you can open it to see where things are in grid squares. Read-only. Needs the Foundry tab open in a browser.",
+        inputSchema: {
+          type: 'object',
+          properties: {
+            scene: {
+              type: 'string',
+              description: 'Scene id or exact name (default: the scene being viewed)',
+            },
+            max_size: {
+              type: 'number',
+              description: 'Longest side of the picture in pixels, 200 to 3000 (default 1600)',
+            },
+            label_every: {
+              type: 'number',
+              description:
+                'Number every Nth column and row, 1 to 50 (default: chosen to stay readable)',
+            },
+          },
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handleManageSceneObjects(args: any): Promise<any> {
+    const parsed = sceneObjectsSchema.parse(args);
+    if (parsed.action === 'place' && !parsed.objects) {
+      throw new Error('objects is required for place');
+    }
+    if (parsed.action === 'remove' && !parsed.all_mine && !(parsed.ids && parsed.ids.length)) {
+      throw new Error('remove needs ids or all_mine: true');
+    }
+
+    this.logger.info('Managing scene objects', { action: parsed.action, scene: parsed.scene });
+    try {
+      // The label of a light is only a note for the caller; do not send it.
+      const payload = {
+        ...parsed,
+        ...(parsed.objects
+          ? {
+              objects: parsed.objects.map(o => {
+                if (o.kind === 'light') {
+                  const { label: _label, ...rest } = o;
+                  return rest;
+                }
+                return o;
+              }),
+            }
+          : {}),
+      };
+      const result = await this.foundryClient.query(
+        'foundry-mcp-bridge.manage-scene-objects',
+        payload
+      );
+      if (result?.success === false) {
+        throw new Error(result.error || 'Request was refused');
+      }
+      return result;
+    } catch (error) {
+      this.logger.error('Failed to manage scene objects', error);
+      throw new Error(
+        `Failed to manage scene objects: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+
+  async handlePreviewScene(args: any): Promise<any> {
+    const parsed = previewSchema.parse(args ?? {});
+
+    try {
+      const result = await this.foundryClient.query(
+        'foundry-mcp-bridge.preview-scene',
+        parsed,
+        PREVIEW_TIMEOUT_MS
+      );
+      if (result?.success === false) {
+        throw new Error(result.error || 'Request was refused');
+      }
+      const { imageBase64, ...info } = result;
+      if (typeof imageBase64 !== 'string' || imageBase64.length === 0) {
+        throw new Error('Foundry returned no picture');
+      }
+
+      const dir = path.join(os.tmpdir(), 'foundry-mcp-previews');
+      await fs.mkdir(dir, { recursive: true });
+      const safeName = String(info.scene?.name ?? 'scene')
+        .replace(/[^A-Za-z0-9_-]+/g, '_')
+        .slice(0, 40);
+      const file = path.join(dir, `${safeName}-${Date.now()}.png`);
+      await fs.writeFile(file, Buffer.from(imageBase64, 'base64'));
+      await this.pruneOldPreviews(dir);
+
+      this.logger.info('Scene preview saved', { file });
+      return { ...info, file };
+    } catch (error) {
+      this.logger.error('Failed to preview scene', error);
+      throw new Error(
+        `Failed to preview scene: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+
+  /** Keep only the newest previews so the temp folder does not grow forever. */
+  private async pruneOldPreviews(dir: string): Promise<void> {
+    try {
+      const names = (await fs.readdir(dir)).filter(n => n.endsWith('.png'));
+      const withTimes = await Promise.all(
+        names.map(async name => ({ name, mtime: (await fs.stat(path.join(dir, name))).mtimeMs }))
+      );
+      withTimes.sort((a, b) => b.mtime - a.mtime);
+      for (const old of withTimes.slice(KEEP_PREVIEWS)) {
+        await fs.rm(path.join(dir, old.name), { force: true });
+      }
+    } catch {
+      // Cleaning up is best effort.
+    }
+  }
+}
diff --git a/packages/mcp-server/src/tools/scene.test.ts b/packages/mcp-server/src/tools/scene.test.ts

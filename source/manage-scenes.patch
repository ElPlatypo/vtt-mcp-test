@@ -0,0 +1,101 @@
+/** Reading a scene as things that can be clicked, and keeping notes in scene flags. */
+import { MODULE_ID } from './constants.js';
+import { getGridGeometry } from './scene-objects-utils.js';
+import { roundSquares, type Annotation, type Clickable, type Point } from './annotation-utils.js';
+
+const FLAG = 'annotations';
+
+const contents = (collection: any): any[] => (collection?.contents ? [...collection.contents] : collection ? [...collection] : []);
+
+/** A region shape as a polygon in pixels. */
+function regionPolygon(shape: any): Point[] | null {
+  if (!shape) return null;
+  if (shape.type === 'rectangle') {
+    const { x, y, width, height } = shape;
+    return [[x, y], [x + width, y], [x + width, y + height], [x, y + height]];
+  }
+  if (shape.type === 'polygon' && Array.isArray(shape.points) && shape.points.length >= 6) {
+    const out: Point[] = [];
+    for (let i = 0; i + 1 < shape.points.length; i += 2) out.push([shape.points[i], shape.points[i + 1]]);
+    return out;
+  }
+  if (shape.type === 'ellipse' || shape.type === 'circle') {
+    const rx = shape.radiusX ?? shape.radius ?? 0;
+    const ry = shape.radiusY ?? shape.radius ?? 0;
+    const out: Point[] = [];
+    for (let i = 0; i < 32; i++) {
+      const a = (i / 32) * Math.PI * 2;
+      out.push([shape.x + Math.cos(a) * rx, shape.y + Math.sin(a) * ry]);
+    }
+    return out;
+  }
+  return null;
+}
+
+/** Everything on a scene a note can point at, in grid squares from the top-left of the map. */
+export function sceneClickables(scene: any): Clickable[] {
+  const geom = getGridGeometry(scene);
+  const size = geom.size;
+  /** a distance in squares */
+  const sq = (px: number) => Number(px ?? 0) / size;
+  /** a position in squares from the top-left of the map */
+  const px2x = (px: number) => (Number(px ?? 0) - geom.originX) / size;
+  const px2y = (px: number) => (Number(px ?? 0) - geom.originY) / size;
+  const out: Clickable[] = [];
+
+  for (const t of contents(scene.tokens)) {
+    out.push({ kind: 'token', id: t.id, name: t.name ?? t.actor?.name, x: px2x(t.x), y: px2y(t.y), width: Number(t.width ?? 1), height: Number(t.height ?? 1) });
+  }
+  for (const t of contents(scene.tiles)) {
+    out.push({ kind: 'tile', id: t.id, x: px2x(t.x), y: px2y(t.y), width: sq(t.width), height: sq(t.height) });
+  }
+  for (const d of contents(scene.drawings)) {
+    out.push({ kind: 'drawing', id: d.id, x: px2x(d.x), y: px2y(d.y), width: sq(d.shape?.width ?? 0), height: sq(d.shape?.height ?? 0) });
+  }
+  for (const l of contents(scene.lights)) out.push({ kind: 'light', id: l.id, at: [px2x(l.x), px2y(l.y)] });
+  for (const s of contents(scene.sounds)) out.push({ kind: 'sound', id: s.id, at: [px2x(s.x), px2y(s.y)] });
+  for (const n of contents(scene.notes)) out.push({ kind: 'note', id: n.id, name: n.text || n.entry?.name, at: [px2x(n.x), px2y(n.y)] });
+  for (const w of contents(scene.walls)) {
+    const c = w.c;
+    if (!Array.isArray(c) || c.length < 4) continue;
+    const door = w.door === 2 ? 'secret door' : w.door === 1 ? 'door' : undefined;
+    out.push({ kind: 'wall', id: w.id, segment: [[px2x(c[0]), px2y(c[1])], [px2x(c[2]), px2y(c[3])]], ...(door ? { door } : {}) });
+  }
+  for (const r of contents(scene.regions)) {
+    for (const shape of (r.shapes ?? []) as any[]) {
+      const polygon = regionPolygon(shape);
+      if (polygon) out.push({ kind: 'region', id: r.id, name: r.name, polygon: polygon.map(p => [px2x(p[0]), px2y(p[1])] as Point) });
+    }
+  }
+  return out;
+}
+
+/** The same things as single points (for counting what is inside an area). */
+export function sceneThings(scene: any): Array<{ kind: string; name?: string; x: number; y: number }> {
+  const things: Array<{ kind: string; name?: string; x: number; y: number }> = [];
+  for (const c of sceneClickables(scene)) {
+    if (c.kind === 'region') continue;
+    let x = c.x ?? 0;
+    let y = c.y ?? 0;
+    if (c.at) [x, y] = c.at;
+    else if (c.segment) {
+      x = (c.segment[0][0] + c.segment[1][0]) / 2;
+      y = (c.segment[0][1] + c.segment[1][1]) / 2;
+    } else if (c.width !== undefined && c.height !== undefined) {
+      x += c.width / 2;
+      y += c.height / 2;
+    }
+    things.push({ kind: c.kind === 'wall' && c.door ? 'door' : c.kind, ...(c.name ? { name: c.name } : {}), x: roundSquares(x), y: roundSquares(y) });
+  }
+  return things;
+}
+
+export function readAnnotations(scene: any): Annotation[] {
+  const stored = scene?.getFlag?.(MODULE_ID, FLAG) ?? scene?.flags?.[MODULE_ID]?.[FLAG];
+  return Array.isArray(stored) ? (stored as Annotation[]) : [];
+}
+
+export async function writeAnnotations(scene: any, list: Annotation[]): Promise<void> {
+  if (list.length === 0) await scene.unsetFlag(MODULE_ID, FLAG);
+  else await scene.setFlag(MODULE_ID, FLAG, list);
+}

diff --git a/packages/foundry-module/src/data-access.token-scene.test.ts b/packages/foundry-module/src/data-access.token-scene.test.ts
new file mode 100644
index 0000000..23ecb89
--- /dev/null
+++ b/packages/foundry-module/src/data-access.token-scene.test.ts
@@ -0,0 +1,100 @@
+/** move-token and update-token find a token on any scene, and update-token takes vision/light options. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+
+function makeScene(id: string, name: string, tokenIds: string[]) {
+  // Applies the change to the token it is called on, as Foundry would.
+  const update = vi.fn(async function (this: any, changes: any) {
+    Object.assign(this, changes);
+  });
+  const tokens = new Map(tokenIds.map(t => [t, { id: t, name: `Token ${t}`, update }]));
+  return { id, name, tokens, update };
+}
+
+function setup(allow = true) {
+  const a = makeScene('sa', 'Trail', ['ta']);
+  const b = makeScene('sb', 'Town', ['tb']);
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'GM' },
+    scenes: { contents: [a, b], current: a, viewed: a },
+    settings: { get: (_m: string, key: string) => (key === 'allowWriteOperations' ? allow : undefined) },
+  });
+  return { da: new FoundryDataAccess(), a, b };
+}
+
+describe('tokens on other scenes', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('moves a token that is not on the active scene', async () => {
+    const { da, b } = setup();
+    const r = await da.moveToken({ tokenId: 'tb', x: 128, y: 64, animate: false });
+    expect(r.success).toBe(true);
+    expect(b.update).toHaveBeenCalledWith({ x: 128, y: 64 }, { animate: false });
+  });
+
+  it('takes a scene by name and reports a token that is not there', async () => {
+    const { da } = setup();
+    await expect(da.moveToken({ tokenId: 'ta', x: 1, y: 1, scene: 'Town' })).rejects.toThrow('not found in scene "Town"');
+    await expect(da.moveToken({ tokenId: 'zz', x: 1, y: 1 })).rejects.toThrow('not found in scene "Trail"');
+    await expect(da.moveToken({ tokenId: 'ta', x: 1, y: 1, scene: 'Nowhere' })).rejects.toThrow('Scene not found');
+  });
+
+  it('finds a token by name: viewed scene first, then other scenes, refusing ambiguous names', async () => {
+    const { da, a, b } = setup();
+    // Token name, any case, on the viewed scene.
+    await da.moveToken({ tokenId: 'token ta', x: 64, y: 64, mode: 'teleport' });
+    expect(a.update).toHaveBeenCalledTimes(1);
+    // Not on the viewed scene: found on another one.
+    const r = await da.moveToken({ tokenId: 'Token tb', x: 64, y: 64, mode: 'teleport' });
+    expect(r.tokenId).toBe('tb');
+    expect(b.update).toHaveBeenCalledTimes(1);
+    // Actor name when no token is named so; two matches are refused with their ids.
+    (a.tokens as Map<string, any>).set('tc', { id: 'tc', name: 'Goblin 1', actor: { name: 'Goblin' }, update: a.update });
+    (a.tokens as Map<string, any>).set('td', { id: 'td', name: 'Goblin 2', actor: { name: 'Goblin' }, update: a.update });
+    await expect(da.moveToken({ tokenId: 'Goblin', x: 1, y: 1, mode: 'teleport' })).rejects.toThrow(/matches 2 tokens: Goblin 1 \(tc\), Goblin 2 \(td\)/);
+    const d = await da.getTokenDetails({ tokenId: 'goblin 2' });
+    expect(d.id).toBe('td');
+    // With a scene given, other scenes are not searched.
+    await expect(da.moveToken({ tokenId: 'Token tb', x: 1, y: 1, scene: 'Trail' })).rejects.toThrow('not found in scene "Trail"');
+  });
+
+  it('reports a teleport that Foundry did not apply instead of claiming it', async () => {
+    const { da, a } = setup();
+    const token = (a.tokens as Map<string, any>).get('ta');
+    Object.assign(token, { x: 0, y: 0 });
+    token.update = vi.fn(async () => undefined); // the update is dropped: the position stays
+    const r = await da.moveToken({ tokenId: 'ta', x: 128, y: 64, mode: 'teleport' });
+    expect(r).toMatchObject({ success: false, moved: false, tokenId: 'ta', position: { x: 0, y: 0 } });
+    token.update = vi.fn(async (u: any) => Object.assign(token, u));
+    expect(await da.moveToken({ tokenId: 'ta', x: 128, y: 64, mode: 'teleport' })).toMatchObject({ success: true, newPosition: { x: 128, y: 64 } });
+  });
+
+  it('updates light and vision on a token of another scene', async () => {
+    const { da, b } = setup();
+    const r = await da.updateToken({ tokenId: 'tb', options: { light: { preset: 'torch', dim: 50 }, vision_range: 60 }, updates: { hidden: false } });
+    expect(r.success).toBe(true);
+    const sent = (b.update.mock.calls as any[][])[0]![0];
+    expect(sent).toMatchObject({
+      hidden: false,
+      'light.bright': 20,
+      'light.dim': 50,
+      'light.color': '#ff9329',
+      'light.animation.type': 'torch',
+      'sight.range': 60,
+      'sight.enabled': true,
+    });
+  });
+
+  it('refuses an empty update and bad options, and respects the write gate', async () => {
+    const { da, b } = setup();
+    await expect(da.updateToken({ tokenId: 'ta', updates: {} })).rejects.toThrow('Nothing to update');
+    await expect(da.updateToken({ tokenId: 'ta', options: { light: { color: 'red' } } })).rejects.toThrow('#RRGGBB');
+    const off = setup(false);
+    await expect(off.da.updateToken({ tokenId: 'ta', updates: { hidden: true } })).rejects.toThrow();
+    expect(b.update).not.toHaveBeenCalled();
+  });
+});

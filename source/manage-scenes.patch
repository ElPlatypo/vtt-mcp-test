+++ b/packages/foundry-module/templates/image-generation-settings.html
@@ -0,0 +1,117 @@
+<form class="mgs-settings" autocomplete="off">
+  <section class="mgs-block">
+    <h2 class="mgs-title">Image Generation</h2>
+    <p class="mgs-note">
+      Claude can generate pictures with your ComfyUI. Choose here which model and settings are used for
+      each kind of picture. Which ComfyUI is used (built-in or your own) is set in
+      <strong>Configure Map Generation</strong>.
+    </p>
+  </section>
+
+  <section class="mgs-block mgs-settings-block">
+    <div class="mgs-model-bar">
+      <button type="button" class="mgs-btn check" id="igs-refresh-btn">
+        <i class="fas fa-sync"></i> Load models from ComfyUI
+      </button>
+      <p class="mgs-status-detail" id="igs-model-status">Not loaded yet. The lists below show what is saved.</p>
+    </div>
+    <p class="mgs-hint">
+      Checkpoints go in ComfyUI's <code>models/checkpoints</code> folder, MiniMax H3 diffusion models in
+      <code>models/diffusion_models</code>, text encoders in <code>models/text_encoders</code> and VAEs in
+      <code>models/vae</code>.
+    </p>
+  </section>
+
+  {{#each kinds}}
+  <details class="mgs-details mgs-settings-block" {{#if open}}open{{/if}}>
+    <summary class="mgs-summary">{{label}}</summary>
+    <p class="mgs-hint mgs-tight">{{help}}</p>
+
+    <div class="mgs-form-group">
+      <label class="mgs-label">Workflow</label>
+      <select name="{{key}}__workflow" data-role="workflow">
+        <option value="checkpoint" {{#if isCheckpoint}}selected{{/if}}>Checkpoint (Stable Diffusion / SDXL)</option>
+        <option value="minimax-h3" {{#if isH3}}selected{{/if}}>MiniMax H3 Image (supports reference pictures)</option>
+      </select>
+    </div>
+
+    <div class="mgs-group" data-workflow-group="checkpoint" {{#unless isCheckpoint}}hidden{{/unless}}>
+      <div class="mgs-row-2">
+        <div class="mgs-form-group">
+          <label class="mgs-label">Checkpoint</label>
+          <select name="{{key}}__checkpoint" data-list="checkpoint" data-current="{{checkpoint}}"></select>
+        </div>
+      </div>
+    </div>
+
+    <div class="mgs-group" data-workflow-group="minimax-h3" {{#unless isH3}}hidden{{/unless}}>
+      <div class="mgs-row-2">
+        <div class="mgs-form-group">
+          <label class="mgs-label">Diffusion model</label>
+          <select name="{{key}}__diffusionModel" data-list="diffusion" data-current="{{diffusionModel}}"></select>
+        </div>
+        <div class="mgs-form-group">
+          <label class="mgs-label">Text encoder</label>
+          <select name="{{key}}__textEncoder" data-list="textEncoder" data-current="{{textEncoder}}"></select>
+        </div>
+      </div>
+    </div>
+
+    <div class="mgs-form-group">
+      <label class="mgs-label">VAE</label>
+      <select name="{{key}}__vae" data-list="vae" data-current="{{vae}}"></select>
+    </div>
+
+    <div class="mgs-row-4">
+      <div class="mgs-form-group">
+        <label class="mgs-label">Steps</label>
+        <input type="number" name="{{key}}__steps" value="{{steps}}" min="1" max="100" step="1" />
+      </div>
+      <div class="mgs-form-group">
+        <label class="mgs-label">CFG</label>
+        <input type="number" name="{{key}}__cfg" value="{{cfg}}" min="0" max="30" step="0.1" />
+      </div>
+      <div class="mgs-form-group">
+        <label class="mgs-label">Width</label>
+        <input type="number" name="{{key}}__width" value="{{width}}" min="256" max="6400" step="8" />
+      </div>
+      <div class="mgs-form-group">
+        <label class="mgs-label">Height</label>
+        <input type="number" name="{{key}}__height" value="{{height}}" min="256" max="6400" step="8" />
+      </div>
+    </div>
+
+    <div class="mgs-row-2">
+      <div class="mgs-form-group">
+        <label class="mgs-label">Sampler</label>
+        <select name="{{key}}__sampler" data-list="sampler" data-current="{{sampler}}"></select>
+      </div>
+      <div class="mgs-form-group">
+        <label class="mgs-label">Scheduler</label>
+        <select name="{{key}}__scheduler" data-list="scheduler" data-current="{{scheduler}}"></select>
+      </div>
+    </div>
+    <p class="mgs-hint mgs-tight" data-workflow-group="minimax-h3" {{#unless isH3}}hidden{{/unless}}>
+      MiniMax H3 Image is made for 6 steps, CFG 1, Euler / Simple and about 4 megapixels or more
+      (for example 2048 x 2048). It has no negative prompt.
+    </p>
+
+    <div class="mgs-form-group">
+      <label class="mgs-label">Text before the prompt</label>

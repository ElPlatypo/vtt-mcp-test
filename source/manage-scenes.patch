+/** add-compendium-items and make-chest. Foundry is stubbed. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+
+function makePack(id: string, type: string, items: Array<{ _id: string; name: string; type: string; quantity?: number }>) {
+  const docs = new Map(items.map(i => [i._id, i]));
+  return {
+    collection: id,
+    metadata: { id, type },
+    indexed: true,
+    index: new Map(items.map(i => [i._id, { _id: i._id, name: i.name, type: i.type }])),
+    getIndex: vi.fn(async () => undefined),
+    getDocument: vi.fn(async (docId: string) => {
+      const d = docs.get(docId);
+      return d
+        ? { toObject: () => ({ _id: d._id, name: d.name, type: d.type, system: d.quantity !== undefined ? { quantity: d.quantity } : {} }) }
+        : null;
+    }),
+  };
+}
+
+function makeActor() {
+  const items: any[] = [];
+  const created: any[] = [];
+  const actor: any = {
+    id: 'chest1',
+    name: 'Old Chest',
+    items: { contents: items },
+    update: vi.fn(async () => undefined),
+    createEmbeddedDocuments: vi.fn(async (_type: string, data: any[]) =>
+      data.map((d, i) => {
+        const doc = { id: `i${items.length + i}`, ...d, update: vi.fn(async (patch: any) => { if (patch['system.quantity'] !== undefined) doc.system.quantity = patch['system.quantity']; }) };
+        items.push(doc);
+        created.push(d);
+        return doc;
+      })
+    ),
+  };
+  return { actor, items, created };
+}
+
+function setup(allow = true) {
+  const { actor, items, created } = makeActor();

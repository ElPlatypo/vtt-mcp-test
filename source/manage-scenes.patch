+import { SceneTools } from './scene.js';
+import { TokenManipulationTools } from './token-manipulation.js';
+import { SceneObjectTools } from './scene-objects.js';
+
+const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+const client = (impl?: (m: string, d: any) => unknown) => {
+  const query = vi.fn(impl ?? (async () => ({ success: true })));
+  return { foundryClient: { query } as any, logger, query };
+};
+
+describe('manage-scene-objects update', () => {
+  const make = () => {
+    const c = client(async () => ({ success: true, updated: [] }));
+    return { tools: new SceneObjectTools({ foundryClient: c.foundryClient, logger } as any), query: c.query };
+  };
+  it('is in the definition and forwards the updates', async () => {
+    const { tools, query } = make();
+    const def = tools.getToolDefinitions().find(d => d.name === 'manage-scene-objects')!;
+    expect((def.inputSchema.properties as any).action.enum).toContain('update');
+    expect((def.inputSchema.properties as any).updates).toBeDefined();
+    expect(def.description).toContain('update takes updates');
+    await tools.handleManageSceneObjects({ action: 'update', scene: 'Town', updates: [{ id: 'n1', x: 10 }] });
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.manage-scene-objects', {
+      action: 'update',
+      scene: 'Town',
+      updates: [{ id: 'n1', x: 10 }],
+    });
+  });
+  it('needs updates', async () => {
+    const { tools, query } = make();
+    await expect(tools.handleManageSceneObjects({ action: 'update' })).rejects.toThrow('updates is required');
+    await expect(tools.handleManageSceneObjects({ action: 'update', updates: [] })).rejects.toThrow();
+    expect(query).not.toHaveBeenCalled();
+  });
+});
+
+describe('scene argument aliases', () => {
+  it('manage-scenes takes scene and background_image', async () => {
+    const c = client(async () => ({ scene: { id: 's1', name: 'Road' } }));
+    const tools = new SceneTools({ foundryClient: c.foundryClient, logger });
+    await tools.handleManageScenes({ action: 'update', scene: 'Road', background_image: 'a/b.png' });
+    expect(c.query).toHaveBeenCalledWith('foundry-mcp-bridge.manage-scenes', {
+      action: 'update',
+      scene_identifier: 'Road',
+      background: 'a/b.png',
+    });
+    const def = tools.getToolDefinitions().find(d => d.name === 'manage-scenes')!;
+    expect((def.inputSchema.properties as any).scene).toBeDefined();
+  });
+  it('scene_identifier still works and update still needs one', async () => {
+    const c = client(async () => ({ scene: { id: 's1', name: 'Road' } }));
+    const tools = new SceneTools({ foundryClient: c.foundryClient, logger });
+    await tools.handleManageScenes({ action: 'update', scene_identifier: 'Road', name: 'Trail' });
+    expect(c.query).toHaveBeenCalledWith('foundry-mcp-bridge.manage-scenes', { action: 'update', scene_identifier: 'Road', name: 'Trail' });
+    await expect(tools.handleManageScenes({ action: 'update', name: 'x' })).rejects.toThrow('scene_identifier is required');
+  });
+  it('update-scene-music takes scene and no longer lists scene_identifier as required', async () => {
+    const c = client(async () => ({}));
+    const tools = new SceneTools({ foundryClient: c.foundryClient, logger });
+    await tools.handleUpdateSceneMusic({ scene: 'Road', playlist: 'Mix' });
+    expect(c.query).toHaveBeenCalledWith('foundry-mcp-bridge.update-scene-music', { scene_identifier: 'Road', playlist: 'Mix' });
+    const def = tools.getToolDefinitions().find(d => d.name === 'update-scene-music')!;
+    expect((def.inputSchema as any).required).toBeUndefined();
+    await expect(tools.handleUpdateSceneMusic({ playlist: 'Mix' })).rejects.toThrow();
+  });
+});
+
+describe('move-token and get-token-details', () => {
+  it('sends the scene and units and reports the squares', async () => {
+    const c = client(async () => ({ success: true, newPosition: { x: 1024, y: 480 }, newSquares: { x: 11, y: 2.5 }, scene: { id: 's', name: 'Town' } }));
+    const tools = new TokenManipulationTools({ foundryClient: c.foundryClient, logger });
+    const r = await tools.handleMoveToken({ tokenId: 't', x: 11, y: 2.5, units: 'squares', scene: 'Town' });
+    expect(c.query).toHaveBeenCalledWith('foundry-mcp-bridge.move-token', { tokenId: 't', x: 11, y: 2.5, animate: false, scene: 'Town', units: 'squares' });
+    expect(r).toMatchObject({ success: true, newPosition: { x: 1024, y: 480 }, newSquares: { x: 11, y: 2.5 }, scene: { name: 'Town' } });
+    await expect(tools.handleMoveToken({ tokenId: 't', x: 1, y: 1, units: 'feet' })).rejects.toThrow();

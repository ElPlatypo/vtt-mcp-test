+    });
+
+    it('still allows describe, which only reads', async () => {
+      const { scene } = makeScene();
+      const { dataAccess } = setup({ allowWriteOperations: false, scenes: [scene] });
+
+      const result = await dataAccess.manageScenes({ action: 'describe' });
+
+      expect(result.success).toBe(true);
+    });
+  });
+
+  describe('describe', () => {
+    it('lists every scene with grid and size', async () => {
+      const a = makeScene({ id: 'a', name: 'A' }).scene;
+      const b = makeScene({ id: 'b', name: 'B' }).scene;
+      const { dataAccess } = setup({ scenes: [a, b] });

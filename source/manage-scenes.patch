+
+    expect(ctx.lines).toContainEqual([0, 0, 300, 0]);
+    expect(ctx.lines).toContainEqual([300, 0, 300, 200]);
+    expect(strokes).toContain('#00e5ff');
+    expect(strokes).toContain('#ff9500');
+    expect(ctx.setLineDash).toHaveBeenCalledWith([5, 4]);
+    expect(ctx.texts.some((t: any) => t.text === '4. Armoury' && t.x === 500)).toBe(true);
+  });
+});
+
+describe('drawPreview walls and pins', () => {
+  it('draws walls as lines, doors in orange and pins with their label', () => {
+    const ctx = fakeContext();

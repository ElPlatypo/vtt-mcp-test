+import { describe, expect, it, vi } from 'vitest';
+import { SayLane } from './say-lane.js';
+
+function make(wait = 0) {
+  const state = { wait };
+  const failures: string[] = [];
+  const lane = new SayLane({ untilSpeechEnds: async () => state.wait, onFailure: t => failures.push(t) });
+  return { lane, state, failures };
+}
+
+describe('SayLane', () => {
+  it('generates speech jobs one at a time, in order', async () => {
+    const { lane } = make();
+    const log: string[] = [];
+    const slow = (name: string, ms: number) => async () => {
+      log.push(`${name}:start`);
+      await new Promise(r => setTimeout(r, ms));
+      log.push(`${name}:end`);
+    };
+    expect(lane.speech('a', slow('a', 20))).toMatchObject({ queued: true, position: 1 });
+    expect(lane.speech('b', slow('b', 1))).toMatchObject({ queued: true, position: 2 });
+    await lane.idle();
+    await lane.idle();
+    expect(log).toEqual(['a:start', 'a:end', 'b:start', 'b:end']);
+  });
+
+  it('runs a post at once when nothing is queued or playing', async () => {
+    const { lane } = make(0);
+    const result = await lane.afterSpeech('post', async () => 'posted');
+    expect(result).toBe('posted');
+  });
+
+  it('holds a post until the speech has ended, and keeps post order', async () => {
+    vi.useFakeTimers();
+    try {
+      const { lane, state } = make(0);
+      const log: string[] = [];
+      lane.speech('s', async () => {
+        state.wait = 1000;
+      });
+      const p1 = await lane.afterSpeech('p1', async () => void log.push('p1'));
+      const p2 = await lane.afterSpeech('p2', async () => void log.push('p2'));
+      expect(p1).toMatchObject({ queued: true });
+      expect(p2).toMatchObject({ queued: true });
+      await vi.advanceTimersByTimeAsync(500);
+      expect(log).toEqual([]);
+      await vi.advanceTimersByTimeAsync(600);
+      expect(log).toEqual(['p1', 'p2']);
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it('clear drops queued jobs and scheduled posts', async () => {
+    vi.useFakeTimers();
+    try {
+      const { lane, state } = make(2000);
+      const ran: string[] = [];
+      lane.speech('s', async () => void ran.push('s'));
+      await lane.afterSpeech('post', async () => void ran.push('post'));
+      state.wait = 2000;
+      expect(lane.clear()).toBeGreaterThan(0);
+      await vi.advanceTimersByTimeAsync(5000);
+      expect(ran).not.toContain('post');
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it('reports a failed job as a notice and keeps going', async () => {
+    const { lane, failures } = make();
+    const ran: string[] = [];
+    lane.speech('bad', async () => {
+      throw new Error('ComfyUI down');
+    });
+    lane.speech('good', async () => void ran.push('good'));
+    await lane.idle();
+    await lane.idle();
+    expect(failures).toEqual(['bad failed: ComfyUI down']);
+    expect(ran).toEqual(['good']);
+  });
+
+  it('marks speech cancelled after a clear', () => {
+    const { lane } = make();
+    const epoch = lane.currentEpoch();
+    expect(lane.cancelled(epoch)).toBe(false);
+    lane.clear();
+    expect(lane.cancelled(epoch)).toBe(true);
+  });
+});

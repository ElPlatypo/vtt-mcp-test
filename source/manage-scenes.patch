index 0000000..533d24f
--- /dev/null
+++ b/packages/foundry-module/src/tactical-utils.ts
@@ -0,0 +1,181 @@
+/**
+ * Tactical geometry on a square grid, the D&D way: distances (diagonals count as one square),
+ * which creatures an area of effect touches (a square is in the area when its centre is, as
+ * Foundry's templates do), and cover by the DMG corner method. Pure: pixels in, wall tests
+ * passed in as a function.
+ */
+
+export interface Pt {
+  x: number;
+  y: number;
+}
+
+export interface Box {
+  /** top-left corner, pixels */
+  x: number;
+  y: number;
+  /** size in squares */
+  width: number;
+  height: number;
+}
+
+/** Centres of the squares a token covers (a Small or Tiny token still counts its own square). */
+export function squareCentres(box: Box, grid: number): Pt[] {
+  const w = Math.max(1, Math.round(box.width || 1));
+  const h = Math.max(1, Math.round(box.height || 1));
+  const out: Pt[] = [];
+  for (let i = 0; i < w; i++) for (let j = 0; j < h; j++) out.push({ x: box.x + (i + 0.5) * grid, y: box.y + (j + 0.5) * grid });
+  return out;
+}
+
+export function centre(box: Box, grid: number): Pt {
+  return { x: box.x + ((box.width || 1) * grid) / 2, y: box.y + ((box.height || 1) * grid) / 2 };
+}
+
+/** Squares between two tokens' nearest edges plus one, times the grid distance (adjacent = 5 ft). */
+export function boxDistance(a: Box, b: Box, grid: number, gridDistance: number): number {
+  const sq = (v: number) => v / grid;
+  const gapX = Math.max(0, sq(b.x) - (sq(a.x) + (a.width || 1)), sq(a.x) - (sq(b.x) + (b.width || 1)));
+  const gapY = Math.max(0, sq(b.y) - (sq(a.y) + (a.height || 1)), sq(a.y) - (sq(b.y) + (b.height || 1)));
+  return (Math.round(Math.max(gapX, gapY)) + 1) * gridDistance;
+}
+
+/** Distance from a point to the nearest part of a token, in squares rounded up, times the grid distance. */
+export function pointDistance(p: Pt, b: Box, grid: number, gridDistance: number): number {
+  const dx = Math.max(0, b.x - p.x, p.x - (b.x + (b.width || 1) * grid));
+  const dy = Math.max(0, b.y - p.y, p.y - (b.y + (b.height || 1) * grid));
+  return Math.ceil(Math.max(dx, dy) / grid - 1e-9) * gridDistance;
+}
+
+export type AreaShape = 'circle' | 'cone' | 'line' | 'square';
+
+export interface Area {
+  shape: AreaShape;
+  origin: Pt;
+  /** radius (circle), length (cone, line) or side (square), in pixels */
+  size: number;
+  /** line width in pixels */
+  width?: number;
+  /** direction in radians (0 = east, pi/2 = south) for cone and line */
+  direction?: number;
+}
+
+/** The D&D cone: as wide as it is long, so its half angle is atan(1/2), about 26.6 degrees. */
+export const CONE_HALF_ANGLE = Math.atan(0.5);
+
+const angleDiff = (a: number, b: number) => {
+  let d = Math.abs(a - b) % (2 * Math.PI);
+  if (d > Math.PI) d = 2 * Math.PI - d;
+  return d;
+};
+
+/** Whether a point (a square centre) is inside the area. */
+export function inArea(p: Pt, area: Area): boolean {
+  const dx = p.x - area.origin.x;
+  const dy = p.y - area.origin.y;
+  const dist = Math.hypot(dx, dy);
+  const eps = 1e-6;
+  switch (area.shape) {
+    case 'circle':
+      return dist <= area.size + eps;
+    case 'square':
+      return Math.abs(dx) <= area.size / 2 + eps && Math.abs(dy) <= area.size / 2 + eps;
+    case 'cone': {
+      if (dist < eps) return false;
+      if (dist > area.size + eps) return false;
+      return angleDiff(Math.atan2(dy, dx), area.direction ?? 0) <= CONE_HALF_ANGLE + eps;
+    }
+    case 'line': {
+      const dir = area.direction ?? 0;
+      const along = dx * Math.cos(dir) + dy * Math.sin(dir);
+      const across = -dx * Math.sin(dir) + dy * Math.cos(dir);
+      return along >= -eps && along <= area.size + eps && Math.abs(across) <= (area.width ?? 0) / 2 + eps;
+    }
+  }
+}
+
+/** Whether any square of a token is inside the area. */
+export function boxInArea(box: Box, area: Area, grid: number): boolean {
+  return squareCentres(box, grid).some(p => inArea(p, area));
+}
+
+/** Corners of a token's space, pulled in a little so lines along a wall it touches do not graze it. */
+export function corners(box: Box, grid: number, inset = 2): Pt[] {
+  const x0 = box.x + inset;
+  const y0 = box.y + inset;
+  const x1 = box.x + (box.width || 1) * grid - inset;
+  const y1 = box.y + (box.height || 1) * grid - inset;
+  return [
+    { x: x0, y: y0 },
+    { x: x1, y: y0 },
+    { x: x0, y: y1 },
+    { x: x1, y: y1 },
+  ];
+}
+
+export type Cover = 'none' | 'half' | 'three-quarters' | 'total';
+
+/**
+ * DMG cover: the attacker picks a corner of its space and traces lines to every corner of the
+ * target's space; the corner that gives the best view decides. Blocked lines: none = no cover,
+ * one or two = half, three = three-quarters, all four = total (with a target bigger than one
+ * square there are more corners; the same proportions apply).
+ */
+export function wallCover(attacker: Box, target: Box, grid: number, blocked: (a: Pt, b: Pt) => boolean): { cover: Cover; blockedLines: number; lines: number } {
+  const from = corners(attacker, grid);
+  const to = corners(target, grid);
+  let best = Infinity;
+  for (const a of from) {
+    let count = 0;
+    for (const b of to) if (blocked(a, b)) count++;
+    best = Math.min(best, count);
+    if (best === 0) break;
+  }
+  const lines = to.length;
+  const share = best / lines;
+  const cover: Cover = best === 0 ? 'none' : best >= lines ? 'total' : share >= 0.75 ? 'three-quarters' : 'half';
+  return { cover, blockedLines: best, lines };
+}
+
+/** Whether a segment crosses a token's space (for creatures standing in the way). */
+export function segmentCrossesBox(a: Pt, b: Pt, box: Box, grid: number, inset = 4): boolean {
+  const minX = box.x + inset;
+  const minY = box.y + inset;
+  const maxX = box.x + (box.width || 1) * grid - inset;
+  const maxY = box.y + (box.height || 1) * grid - inset;
+  // Liang-Barsky clipping
+  let t0 = 0;
+  let t1 = 1;
+  const dx = b.x - a.x;
+  const dy = b.y - a.y;
+  const edges: Array<[number, number]> = [
+    [-dx, a.x - minX],
+    [dx, maxX - a.x],
+    [-dy, a.y - minY],
+    [dy, maxY - a.y],
+  ];
+  for (const [p, q] of edges) {
+    if (p === 0) {
+      if (q < 0) return false;
+      continue;
+    }
+    const r = q / p;
+    if (p < 0) {
+      if (r > t1) return false;
+      if (r > t0) t0 = r;
+    } else {
+      if (r < t0) return false;
+      if (r < t1) t1 = r;
+    }
+  }
+  return t0 <= t1;
+}
+
+/** Direction in radians from compass words or degrees (0 = east, 90 = south, as on the map). */
+export function directionOf(value: number | string | undefined): number | undefined {
+  if (value === undefined) return undefined;
+  if (typeof value === 'number') return (value * Math.PI) / 180;
+  const words: Record<string, number> = { e: 0, east: 0, se: 45, southeast: 45, s: 90, south: 90, sw: 135, southwest: 135, w: 180, west: 180, nw: 225, northwest: 225, n: 270, north: 270, ne: 315, northeast: 315 };
+  const deg = words[value.trim().toLowerCase()];
+  return deg === undefined ? undefined : (deg * Math.PI) / 180;
+}

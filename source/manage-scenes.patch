@@ -0,0 +1,66 @@
+/** Party management for dnd5e: who the party is, rests, XP and level-ups. Pure over actor objects. */
+
+export interface PartyActor {
+  id: string;
+  name: string;
+  actor: any;
+}
+
+const num = (v: unknown): number | undefined => (typeof v === 'number' && Number.isFinite(v) ? v : undefined);
+const lower = (s: unknown) => String(s ?? '').trim().toLowerCase();
+
+/** The actors a request means: "party" (player characters), "all_characters", or names (exact, else part of a name). */
+export function pickActors(actors: any[], who: string[] | undefined, ownedByPlayer: (actor: any) => boolean): { picked: PartyActor[]; notFound: string[] } {
+  const spec = who?.length ? who : ['party'];
+  const picked = new Map<string, PartyActor>();
+  const notFound: string[] = [];
+  for (const entry of spec) {
+    const key = lower(entry);
+    let hits: any[];
+    if (key === 'party') hits = actors.filter(a => a.type === 'character' && ownedByPlayer(a));
+    else if (key === 'all_characters') hits = actors.filter(a => a.type === 'character');
+    else {
+      const exact = actors.filter(a => lower(a.name) === key || a.id === entry);
+      hits = exact.length ? exact : actors.filter(a => lower(a.name).includes(key));
+    }
+    if (hits.length === 0) notFound.push(entry);
+    for (const a of hits) picked.set(a.id, { id: a.id, name: a.name, actor: a });
+  }
+  return { picked: [...picked.values()], notFound };
+}
+
+/** Level, XP, hit points and hit dice of one character. */
+export function partyRow(actor: any): Record<string, any> {
+  const system = actor.system ?? {};
+  const xp = system.details?.xp ?? {};
+  const hp = system.attributes?.hp ?? {};
+  const level = num(system.details?.level);
+  const value = num(xp.value);
+  const max = num(xp.max);
+  const row: Record<string, any> = { name: actor.name };
+  if (level !== undefined) row.level = level;
+  if (value !== undefined) row.xp = max !== undefined ? `${value}/${max}` : value;
+  if (value !== undefined && max !== undefined && value >= max && (level ?? 0) < 20) row.readyToLevelUp = true;
+  if (num(hp.value) !== undefined) row.hp = num(hp.max) !== undefined ? `${hp.value}/${hp.max}` : hp.value;
+  const hd = system.attributes?.hd;
+  if (hd && num(hd.value) !== undefined) row.hitDice = num(hd.max) !== undefined ? `${hd.value}/${hd.max}` : hd.value;
+  return row;
+}
+
+/** Split an XP award among actors: whole numbers, the remainder going to the first ones. */
+export function splitXp(amount: number, count: number): number[] {
+  if (count <= 0) return [];
+  const each = Math.floor(amount / count);
+  const extra = amount - each * count;
+  return Array.from({ length: count }, (_, i) => each + (i < extra ? 1 : 0));
+}
+
+/** The class a level-up means: the named one, or the only class the actor has. */
+export function pickClass(actor: any, name?: string): any | null {
+  const classes = ((actor.itemTypes?.class ?? (actor.items?.contents ?? []).filter((i: any) => i.type === 'class')) as any[]);
+  if (name) {
+    const key = lower(name);
+    return classes.find(c => lower(c.name) === key) ?? classes.find(c => lower(c.name).includes(key)) ?? null;
+  }
+  return classes.length === 1 ? classes[0] : null;
+}

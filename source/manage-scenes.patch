+/** Plutonium: 5etools text conversion, catalogue search/import and adventure reading. Foundry and Plutonium are stubbed. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+import { adventureSections, cleanTags, entriesToText, findByName, pickHeading, searchSections } from './plutonium-utils.js';
+
+describe('plutonium utils', () => {
+  it('cleans 5etools tags to readable text', () => {
+    expect(cleanTags('A {@creature goblin|MM|goblin} with a {@item scimitar|phb} {@hit 4} deals {@damage 1d6} ({@dc 12}).')).toBe('A goblin with a scimitar +4 deals 1d6 (DC 12).');
+    expect(cleanTags('{@b bold {@i nested}}')).toBe('bold nested');
+  });
+  it('turns entries into text with headings, read-aloud boxes, lists and tables', () => {
+    const t = entriesToText({
+      type: 'section',
+      name: 'Goblin Arrows',
+      entries: [
+        'Intro text.',
+        { type: 'insetReadaloud', entries: ['You hear a twang.'] },
+        { type: 'entries', name: 'Cragmaw Hideout', entries: [{ type: 'list', items: ['one', { name: 'Two', entry: 'second' }] }, { type: 'table', caption: 'Loot', colLabels: ['d6', 'Item'], rows: [['1', 'Gold'], ['2', '{@item rope|phb}']] }] },
+      ],
+    });
+    expect(t).toContain('## Goblin Arrows');
+    expect(t).toContain('> Read aloud');
+    expect(t).toContain('You hear a twang.');
+    expect(t).toContain('### Cragmaw Hideout');
+    expect(t).toContain('- one');
+    expect(t).toContain('- Two: second');
+    expect(t).toContain('d6 | Item');
+    expect(t).toContain('2 | rope');
+  });
+  it('finds rows by name, exact first, with a source filter', () => {
+    const rows = [
+      { name: 'Goblin Boss', source: 'MM' },
+      { name: 'Goblin', source: 'MM' },
+      { name: 'Goblin', source: 'AWM' },
+      { name: 'Hobgoblin', source: 'MM' },
+    ];
+    expect(findByName(rows, 'goblin').map(r => `${r.name}:${r.source}`).slice(0, 3)).toEqual(['Goblin:MM', 'Goblin:AWM', 'Goblin Boss:MM']);
+    expect(findByName(rows, 'goblin', 'awm')).toEqual([{ name: 'Goblin', source: 'AWM' }]);
+    expect(findByName(rows, '')).toEqual([]);
+  });
+  it('splits an adventure, searches it and reads under a heading', () => {
+    const sections = adventureSections(
+      [
+        { type: 'section', name: 'Goblin Arrows', entries: [{ type: 'entries', name: 'Goblin Ambush', entries: ['Four goblins hide in the brush.'] }, { type: 'entries', name: 'Cragmaw Hideout', entries: ['A cave.'] }] },
+        { type: 'section', name: 'Phandalin', entries: ['A town of Redbrand ruffians.'] },
+      ],
+      [],
+    );
+    expect(sections[0]!.headers).toEqual(['Goblin Ambush', 'Cragmaw Hideout']);
+    expect(searchSections(sections, 'redbrand')[0]).toMatchObject({ index: 1, section: 'Phandalin' });
+    expect(searchSections(sections, 'goblins')[0]!.index).toBe(0);
+    const part = pickHeading(sections[0]!.text, 'goblin ambush')!;
+    expect(part).toContain('Four goblins hide');
+    expect(part).not.toContain('A cave');
+    expect(pickHeading(sections[0]!.text, 'nothing')).toBeNull();
+  });
+});
+
+function setup(active = true) {
+  const goblin = { name: 'Goblin', source: 'MM', cr: '1/4', type: { type: 'humanoid' } };
+  const boss = { name: 'Goblin Boss', source: 'MM', cr: '1', type: 'humanoid' };
+  const actors: any[] = [{ id: 'a0', name: 'Goblin Boss', uuid: 'Actor.a0' }];
+  const items: any[] = [];
+  const pImportEntry = vi.fn(async (ent: any) => {
+    actors.push({ id: 'a' + actors.length, name: ent.name, uuid: 'Actor.new', folder: { name: 'Creatures' } });
+  });
+  const pGetImporter = vi.fn(async () => ({ pImportEntry }));
+  const loadJSON = vi.fn(async () => ({ adventureData: [{ data: [{ type: 'section', name: 'Goblin Arrows', entries: [{ type: 'entries', name: 'Goblin Ambush', entries: ['Four goblins hide.'] }] }] }] }));
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('DataUtil', { loadJSON });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'GM', isGM: true },
+    actors: { contents: actors },
+    items: { contents: items },
+    modules: {
+      get: () =>
+        active
+          ? {
+              active: true,
+              version: '2.19.8',
+              api: {
+                importer: { pGetImporter },
+                salphar: {
+                  Vetools: {
+                    pGetAllCreatures: async () => ({ monster: [goblin, boss] }),
+                    pGetAllSpells: async () => ({ spell: [{ name: 'Fireball', source: 'PHB', level: 3, school: 'V' }] }),
+                    pGetItems: async () => ({ item: [{ name: 'Rope', source: 'PHB', type: 'G' }] }),
+                    pGetAdventureIndex: async () => ({ adventure: [{ id: 'LMoP', name: 'Lost Mine of Phandelver', level: { start: 1, end: 5 }, _url: 'https://5e.tools/x.json', contents: [{ name: 'Goblin Arrows' }] }] }),
+                  },
+                },
+              },
+            }
+          : undefined,
+    },
+    settings: { get: (_m: string, key: string) => (key === 'allowWriteOperations' ? true : undefined) },
+  });
+  return { da: new FoundryDataAccess(), pImportEntry, pGetImporter, loadJSON, actors };
+}
+
+describe('lookupPlutonium', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('reports status and refuses when Plutonium is off', async () => {
+    const on = setup(true);
+    expect((await on.da.lookupPlutonium({ action: 'status' })).plutonium).toEqual({ active: true, version: '2.19.8' });
+    const off = setup(false);
+    expect((await off.da.lookupPlutonium({ action: 'status' })).plutonium.active).toBe(false);
+    await expect(off.da.lookupPlutonium({ query: 'goblin' })).rejects.toThrow('not active');
+  });
+  it('searches creatures, spells and items and flags what is already in the world', async () => {
+    const { da } = setup();
+    const r = await da.lookupPlutonium({ kind: 'creature', query: 'goblin' });
+    expect(r.results.map((x: any) => x.name)).toEqual(['Goblin', 'Goblin Boss']);
+    expect(r.results[0]).toMatchObject({ source: 'MM', cr: '1/4', type: 'humanoid' });
+    expect(r.results[1].inWorld).toBe(true);
+    expect((await da.lookupPlutonium({ kind: 'spell', query: 'fireball' })).results[0]).toMatchObject({ level: 3 });
+    expect((await da.lookupPlutonium({ kind: 'item', query: 'rope' })).results[0].name).toBe('Rope');
+  });
+  it('imports by exact name through the importer and reports what was created', async () => {
+    const { da, pImportEntry, pGetImporter } = setup();
+    const r = await da.lookupPlutonium({ action: 'import', kind: 'creature', names: ['Goblin', 'Dragon'] });
+    expect(pGetImporter).toHaveBeenCalledWith({ prop: 'monster' });
+    expect(pImportEntry).toHaveBeenCalledTimes(1);
+    expect(r.results[0]).toMatchObject({ name: 'Goblin', source: 'MM', created: [{ name: 'Goblin', folder: 'Creatures' }] });
+    expect(r.results[1]).toMatchObject({ name: 'Dragon', error: 'not found' });
+  });
+  it('asks for names when importing', async () => {
+    const { da } = setup();
+    await expect(da.lookupPlutonium({ action: 'import' })).rejects.toThrow('needs names');
+    await expect(da.lookupPlutonium({ action: 'search' })).rejects.toThrow('needs a query');
+  });
+});
+
+describe('readAdventure', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('lists adventures, outlines one, searches and reads a heading', async () => {
+    const { da, loadJSON } = setup();
+    expect((await da.readAdventure({ action: 'list', query: 'phandelver' })).adventures[0]).toMatchObject({ id: 'LMoP', level: '1-5' });
+    const outline = await da.readAdventure({});
+    expect(outline.sections[0]).toMatchObject({ name: 'Goblin Arrows', headings: ['Goblin Ambush'] });
+    expect((await da.readAdventure({ action: 'search', query: 'goblins hide' })).results[0]).toMatchObject({ section: 'Goblin Arrows' });
+    const read = await da.readAdventure({ action: 'read', section: 'goblin', heading: 'ambush' });
+    expect(read.text).toContain('Four goblins hide.');
+    expect(loadJSON).toHaveBeenCalledTimes(1);
+  });
+  it('fails clearly for an unknown adventure, section or heading', async () => {
+    const { da } = setup();
+    await expect(da.readAdventure({ adventure: 'ZZZ' })).rejects.toThrow('not found');
+    await expect(da.readAdventure({ action: 'read', section: 'nope' })).rejects.toThrow('needs section');
+    await expect(da.readAdventure({ action: 'read', section: 0, heading: 'zzz' })).rejects.toThrow('no heading');
+  });
+});
+
+describe('setPause', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('reports, pauses and unpauses without redundant toggles', async () => {
+    const { da } = setup();
+    const toggle = vi.fn();
+    (globalThis as any).game.paused = true;
+    (globalThis as any).game.togglePause = toggle;
+    expect(await da.setPause({})).toEqual({ success: true, paused: true, changed: false });
+    expect(await da.setPause({ paused: true })).toMatchObject({ changed: false });
+    expect(toggle).not.toHaveBeenCalled();
+    expect(await da.setPause({ paused: false })).toEqual({ success: true, paused: false, changed: true });
+    expect(toggle).toHaveBeenCalledWith(false, true);
+  });
+});
diff --git a/packages/foundry-module/src/data-access.read-image.test.ts b/packages/foundry-module/src/data-access.read-image.test.ts
new file mode 100644
index 0000000..a96ab8e

+import { describe, expect, it } from 'vitest';
+import { doorPortals, expandShapeSpecs } from './layout-town.js';
+import { createDoc, addShapes, layoutOf } from './layout-doc.js';
+import { wallsFromLayout } from './layout-utils.js';
+
+describe('building', () => {
+  it('becomes a rect plus doors on the chosen sides', () => {
+    const out = expandShapeSpecs([
+      { shape: 'building', rect: [4, 4, 6, 4], label: 3, doors: [{ side: 's' }, { side: 'w', offset: 1, secret: true }, { side: 'n', offset: 0, size: 2 }, { side: 'e', state: 'locked' }] },
+    ]) as any[];
+    expect(out[0]).toMatchObject({ shape: 'rect', rect: [4, 4, 6, 4], fill: 'building', label: 3 });
+    expect(out[1]).toEqual({ shape: 'door', size: 1, at: [6, 8], dir: 'h' });
+    expect(out[2]).toEqual({ shape: 'door', size: 1, at: [4, 5], dir: 'v', secret: true });
+    expect(out[3]).toEqual({ shape: 'door', size: 2, at: [4, 4], dir: 'h' });
+    expect(out[4]).toEqual({ shape: 'door', size: 1, at: [10, 5], dir: 'v', state: 'locked' });
+  });
+  it('accepts at and size and keeps other shapes untouched', () => {
+    const out = expandShapeSpecs([{ shape: 'building', at: [1, 1], size: [3, 3] }, { shape: 'ellipse', center: [5, 5], radius: [1, 1] }]) as any[];
+    expect(out).toHaveLength(2);
+    expect(out[0]).toMatchObject({ shape: 'rect', rect: [1, 1, 3, 3] });
+    expect(out[1].shape).toBe('ellipse');
+  });
+  it('refuses bad buildings and doors', () => {
+    expect(() => expandShapeSpecs([{ shape: 'building' }])).toThrow('rect');
+    expect(() => expandShapeSpecs([{ shape: 'building', rect: [0, 0, 0, 3] }])).toThrow('above 0');
+    expect(() => expandShapeSpecs([{ shape: 'building', rect: [0, 0, 3, 3], doors: [{ side: 'x' }] }])).toThrow('side');
+    expect(() => expandShapeSpecs([{ shape: 'building', rect: [0, 0, 3, 3], doors: [{ side: 'n', offset: 3 }] }])).toThrow('outside the wall');
+    expect(() => expandShapeSpecs([{ shape: 'building', rect: [0, 0, 3, 3], doors: [{ side: 'n', size: 4 }] }])).toThrow('longer');
+    expect(() => expandShapeSpecs([{ shape: 'building', rect: [0, 0, 3, 3], doors: 'n' }])).toThrow('list');
+  });
+});
+
+describe('repeat', () => {
+  it('copies a shape along a step, buildings included', () => {
+    const out = expandShapeSpecs([{ shape: 'building', rect: [2, 2, 4, 3], doors: [{ side: 's' }], repeat: { count: 3, step: [6, 0] } }]) as any[];
+    expect(out).toHaveLength(6);
+    expect(out.filter(s => s.shape === 'rect').map(s => s.rect[0])).toEqual([2, 8, 14]);
+    expect(out.filter(s => s.shape === 'door').map(s => s.at[0])).toEqual([3, 9, 15]);
+  });
+  it('moves every kind of shape', () => {
+    const out = expandShapeSpecs([{ shape: 'path', path: [[0, 0], [2, 0]], repeat: { count: 2, step: [0, 3] } }]) as any[];
+    expect(out[1].path).toEqual([[0, 3], [2, 3]]);
+  });
+  it('checks its arguments', () => {
+    expect(() => expandShapeSpecs([{ shape: 'rect', rect: [0, 0, 1, 1], repeat: { count: 0, step: [1, 0] } }])).toThrow('count');
+    expect(() => expandShapeSpecs([{ shape: 'rect', rect: [0, 0, 1, 1], repeat: { count: 999, step: [1, 0] } }])).toThrow('count');
+    expect(() => expandShapeSpecs([{ shape: 'rect', rect: [0, 0, 1, 1], repeat: { count: 2 } }])).toThrow('step');
+  });
+});
+
+describe('with a real layout', () => {
+  it('turns into walls with the doors cut out', () => {
+    const doc = createDoc({ name: 'Town', columns: 30, rows: 20, background: 'grass', wall_fills: ['building'] } as any);
+    addShapes(doc, expandShapeSpecs([{ shape: 'building', rect: [4, 4, 6, 4], doors: [{ side: 's' }] }]));
+    const { walls } = wallsFromLayout(layoutOf(doc));
+    expect(walls.filter(w => (w as any).preset === 'door')).toHaveLength(1);
+    expect(walls.length).toBeGreaterThan(1);
+  });
+});
+
+describe('doorPortals', () => {
+  const doc = createDoc({ name: 'Town', columns: 30, rows: 20, background: 'grass' } as any);
+  const ids = addShapes(doc, expandShapeSpecs([
+    { shape: 'building', rect: [4, 4, 6, 4], label: 7, doors: [{ side: 's' }, { side: 'w', offset: 1 }, { side: 'n' }, { side: 'e' }] },
+  ]));
+  it('finds the squares each side of every door and the building', () => {
+    const portals = doorPortals(doc.shapes as any);
+    expect(portals).toHaveLength(4);
+    const byCentre = (x: number, y: number) => portals.find(p => p.centre[0] === x && p.centre[1] === y)!;
+    expect(byCentre(6.5, 8)).toMatchObject({ outside: [6.5, 8.5], inside: [6.5, 7.5], building: ids[0], buildingLabel: 7 });
+    expect(byCentre(4, 5.5)).toMatchObject({ outside: [3.5, 5.5], inside: [4.5, 5.5] });
+    expect(byCentre(6.5, 4)).toMatchObject({ outside: [6.5, 3.5], inside: [6.5, 4.5] });
+    expect(byCentre(10, 5.5)).toMatchObject({ outside: [10.5, 5.5], inside: [9.5, 5.5] });
+  });
+  it('still reports a door with no building around it', () => {
+    const d = createDoc({ name: 'x', columns: 10, rows: 10 } as any);
+    addShapes(d, [{ shape: 'door', at: [3, 3], dir: 'h', secret: true }]);
+    const [p] = doorPortals(d.shapes as any);
+    expect(p).toMatchObject({ building: null, secret: true, state: 'closed' });
+  });
+});

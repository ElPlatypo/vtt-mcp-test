+    const uploaded = await this.upload({
+      file_path: localPath,
+      folder: a.upload_folder ?? 'maps',
+      filename: a.filename ? (/\.[a-z0-9]{2,5}$/i.test(a.filename) ? a.filename : `${a.filename}.png`) : `${doc.id}-${Date.now().toString(36)}.png`,

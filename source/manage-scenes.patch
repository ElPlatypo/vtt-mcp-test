@@ -0,0 +1,30 @@
+import { describe, expect, it, vi } from 'vitest';
+import { TableTools } from './table-tools.js';
+
+function make(result: any = { success: true }) {
+  const query = vi.fn(async () => result);
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  return { tools: new TableTools({ foundryClient: { query } as any, logger }), query };
+}
+
+describe('read-table', () => {
+  it('is exposed with nothing required', () => {
+    const def = make().tools.getToolDefinitions()[0]!;
+    expect(def.name).toBe('read-table');
+    expect((def.inputSchema as any).required).toBeUndefined();
+  });
+  it('sends the sections asked for', async () => {
+    const { tools, query } = make();
+    await tools.handleReadTable({});
+    expect(query).toHaveBeenLastCalledWith('foundry-mcp-bridge.read-table', {});
+    await tools.handleReadTable({ chat: { since_id: 'abc', limit: 5, rolls_only: true }, combat: true });
+    expect(query).toHaveBeenLastCalledWith('foundry-mcp-bridge.read-table', { chat: { since_id: 'abc', limit: 5, rolls_only: true }, combat: true });
+  });
+  it('refuses bad input and passes on a refusal', async () => {
+    const { tools } = make();
+    await expect(tools.handleReadTable({ chat: { limit: 500 } })).rejects.toThrow();
+    await expect(tools.handleReadTable({ chat: { purge: true } })).rejects.toThrow();
+    await expect(tools.handleReadTable({ everything: true })).rejects.toThrow();
+    await expect(make({ success: false, error: 'GM only' }).tools.handleReadTable({})).rejects.toThrow('GM only');
+  });
+});
diff --git a/packages/mcp-server/src/tools/table-tools.ts b/packages/mcp-server/src/tools/table-tools.ts
new file mode 100644
index 0000000..540c53c
--- /dev/null
+++ b/packages/mcp-server/src/tools/table-tools.ts
@@ -0,0 +1,79 @@
+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+
+export interface TableToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+const chatSchema = z
+  .object({
+    limit: z.number().int().min(1).max(100).optional(),
+    since_id: z.string().min(1).optional(),
+    since: z.number().min(0).optional(),
+    rolls_only: z.boolean().optional(),
+    whispers: z.boolean().optional(),
+  })
+  .strict();
+
+const schema = z
+  .object({
+    chat: z.union([z.boolean(), chatSchema]).optional(),
+    combat: z.boolean().optional(),
+    party: z.boolean().optional(),
+    players: z.boolean().optional(),
+  })
+  .strict();
+
+export class TableTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: TableToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'TableTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'read-table',
+        description:
+          'See what is happening at the table in one call. Sections (with none given, all four are returned): ' +
+          'chat: recent chat messages, oldest first, each with who said it, the text, flavor, whispers and for rolls the formula, total, each die and the roll type (attack, skill, save...). Pass chat:true or {limit (default 20, max 100), since_id (only messages after this id; pass the latestId of your last read to see only what is new), since (timestamp), rolls_only, whispers:false (leave out whispers)}. The result has latestId. ' +
+          'combat: the combat tracker: round, whose turn it is and every combatant with initiative, hit points, armour class and conditions. null when no combat is running. ' +
+          'party: the player characters with hit points, armour class, conditions, level, passive Perception, gold, inspiration and which player has them. ' +
+          'players: who is connected, their character and the scene they are viewing.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            chat: {
+              type: ['boolean', 'object'],
+              description: 'Recent chat and rolls: true or {limit, since_id, since, rolls_only, whispers}',
+              properties: {
+                limit: { type: 'number' },
+                since_id: { type: 'string' },
+                since: { type: 'number' },
+                rolls_only: { type: 'boolean' },
+                whispers: { type: 'boolean' },
+              },
+            },
+            combat: { type: 'boolean', description: 'The combat tracker' },
+            party: { type: 'boolean', description: 'Player characters: hit points, AC, conditions' },
+            players: { type: 'boolean', description: 'Who is connected and where they look' },
+          },
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handleReadTable(args: unknown): Promise<any> {
+    const a = schema.parse(args ?? {});
+    this.logger.debug('Reading the table', { sections: Object.keys(a) });
+    const result = await this.foundryClient.query('foundry-mcp-bridge.read-table', a);
+    if (result?.success === false) throw new Error(result.error || 'Request was refused');
+    return result;
+  }
+}

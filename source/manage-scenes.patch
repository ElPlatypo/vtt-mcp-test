index 0000000..5bd2fc9
--- /dev/null
+++ b/packages/mcp-server/src/tools/image-edit-tools.ts
@@ -0,0 +1,305 @@
+import { promises as fs } from 'fs';
+import os from 'os';
+import path from 'path';
+import { PNG } from 'pngjs';
+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+import { decodeImage } from './layout-image.js';
+import {
+  areaToPixels,
+  beforeAfter,
+  buildEditPrompt,
+  compositeArea,
+  drawOutline,
+  generationSize,
+  type Pixels,
+  type Pt,
+} from './image-edit-utils.js';
+
+export interface ImageEditToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+  generate?: ((args: any) => Promise<any>) | undefined;
+  upload?: ((args: any) => Promise<any>) | undefined;
+}
+
+const KINDS = ['map', 'portrait', 'token', 'handout'] as const;
+
+const areaSchema = z
+  .object({
+    rect: z.tuple([z.number(), z.number(), z.number(), z.number()]).optional(),
+    polygon: z.array(z.tuple([z.number(), z.number()])).min(3).max(200).optional(),
+    units: z.enum(['squares', 'percent', 'pixels']).optional(),
+  })
+  .strict();
+
+const schema = z.discriminatedUnion('action', [
+  z
+    .object({
+      action: z.literal('edit'),
+      annotation: z.string().min(1).optional(),
+      scene: z.string().min(1).optional(),
+      image: z.string().min(1).optional(),
+      area: areaSchema.optional(),
+      prompt: z.string().min(3).max(1500).optional(),
+      kind: z.enum(KINDS).optional(),
+      feather: z.number().min(0).max(200).optional(),
+      outline_width: z.number().int().min(1).max(30).optional(),
+      seed: z.number().int().min(0).optional(),
+    })
+    .strict(),
+  z
+    .object({
+      action: z.literal('commit'),
+      result: z.string().min(1),
+      apply: z.enum(['scene', 'file']).optional(),
+      folder: z.string().min(1).max(120).optional(),
+      filename: z.string().min(1).max(120).optional(),
+      backup: z.boolean().optional(),
+      resolve_note: z.boolean().optional(),
+      reply: z.string().max(2000).optional(),
+    })
+    .strict(),
+]);
+
+interface Pending {
+  id: string;
+  composite: string;
+  source: {
+    type: 'scene' | 'image';
+    scene?: { id: string; name: string };
+    foundryPath?: string;
+    annotation?: string;
+    originalName?: string;
+  };
+}
+
+const UNIQUE = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 5);
+
+export class ImageEditTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+  private generate: ((args: any) => Promise<any>) | undefined;
+  private upload: ((args: any) => Promise<any>) | undefined;
+  private pending = new Map<string, Pending>();
+  private folder = path.join(os.tmpdir(), 'foundry-mcp-edits');
+
+  constructor({ foundryClient, logger, generate, upload }: ImageEditToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'ImageEditTools' });
+    this.generate = generate;
+    this.upload = upload;
+  }
+
+  getToolDefinitions() {
+    const areaProps = {
+      rect: { type: 'array', items: { type: 'number' }, minItems: 4, maxItems: 4, description: '[x, y, width, height]' },
+      polygon: { type: 'array', items: { type: 'array', items: { type: 'number' }, minItems: 2, maxItems: 2 }, description: '[[x, y], ...] at least three corners' },
+      units: { type: 'string', enum: ['squares', 'percent', 'pixels'], description: 'squares (grid squares from the top-left of the map; scenes and notes, the default there), percent (0 to 100 of the picture; the default for other pictures) or pixels' },
+    };
+    return [
+      {
+        name: 'edit-image-area',
+        description:
+          'Change one part of a picture (a map, a character, an item) with MiniMax H3 without touching the rest: the area is outlined in red on the whole picture, H3 redraws what is inside following your instruction and removes the outline, and ONLY the area is pasted back into the original (everything outside stays pixel-identical). ' +
+          'action edit: say what to change in prompt (e.g. "add a wooden door in the middle of the stone wall and a short dirt passage joining the two rooms"; describe the result, not the edit steps) and where: annotation (the id of a "Notes for Claude" note: its area and text are used; prompt is optional and replaces the note text), or scene (a scene id or name: its map is edited; give area in grid squares), or image (a Foundry file path or an absolute path on this computer; give area as percent or pixels). area is {rect: [x, y, width, height]} or {polygon: [[x, y], ...]}; keep it a little larger than the change. Takes about two to three minutes. The result is NOT applied: it returns result (an id), a local picture path, and preview (before and after side by side): look at the preview, and edit again with a different prompt, area or seed if it is not right. ' +
+          'action commit: result (the id from edit) uploads the picture and, for a scene, makes a backup copy of the scene (backup:false to skip) and sets the new picture as its map; the note is marked done (resolve_note:false to skip; reply is the message the GM sees). apply file only uploads and returns the Foundry path (use it for portraits, tokens and items). Walls, doors and lights are not changed: adjust them afterwards with the other scene tools.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: { type: 'string', enum: ['edit', 'commit'] },
+            annotation: { type: 'string', description: 'edit: id of a note (annotations tool)' },
+            scene: { type: 'string', description: 'edit: scene id or exact name; its map is edited' },
+            image: { type: 'string', description: 'edit: Foundry file path (e.g. worlds/<world>/uploads/...) or absolute local path of a png or jpg' },
+            area: { type: 'object', properties: areaProps, additionalProperties: false, description: 'edit: where to change (not needed with annotation)' },
+            prompt: { type: 'string', description: 'edit: what the area should look like afterwards' },
+            kind: { type: 'string', enum: [...KINDS], description: 'edit: image profile (default map)' },
+            feather: { type: 'number', description: 'edit: blend width in pixels at the edge of the area (default about 0.7% of the picture width)' },
+            outline_width: { type: 'number', description: 'edit: red outline thickness in pixels' },
+            seed: { type: 'number', description: 'edit: repeat or vary a result' },
+            result: { type: 'string', description: 'commit: the result id from edit' },
+            apply: { type: 'string', enum: ['scene', 'file'], description: 'commit: scene (default for scene and note edits) or file' },
+            folder: { type: 'string', description: 'commit: folder below the world uploads (default: next to the original)' },
+            filename: { type: 'string', description: 'commit: file name (default: original name plus -edit)' },
+            backup: { type: 'boolean', description: 'commit: back the scene up first (default true)' },
+            resolve_note: { type: 'boolean', description: 'commit: mark the note done (default true)' },
+            reply: { type: 'string', description: 'commit: message shown with the note' },
+          },
+          required: ['action'],
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  private async query(method: string, data: Record<string, any>, timeout?: number): Promise<any> {
+    const result = await this.foundryClient.query(`foundry-mcp-bridge.${method}`, data, timeout);
+    if (result?.success === false) throw new Error(result.error || 'Request was refused');
+    return result;
+  }
+
+  private async savePng(image: Pixels, name: string): Promise<string> {
+    await fs.mkdir(this.folder, { recursive: true });
+    const png = new PNG({ width: image.width, height: image.height });
+    png.data = Buffer.from(image.data);
+    const file = path.join(this.folder, name);
+    await fs.writeFile(file, PNG.sync.write(png));
+    return file;
+  }
+
+  /** Read a Foundry image or a local file into pixels. */
+  private async load(source: string): Promise<{ image: Pixels; foundryPath?: string }> {
+    if (path.isAbsolute(source)) {
+      const d = await decodeImage(source);
+      return { image: { width: d.width, height: d.height, data: d.data } };
+    }
+    const file = await this.query('read-image-file', { path: source }, 60_000);
+    await fs.mkdir(this.folder, { recursive: true });
+    const ext = (source.split('.').pop() ?? 'png').toLowerCase();
+    const temp = path.join(this.folder, `source-${UNIQUE()}.${ext}`);
+    await fs.writeFile(temp, Buffer.from(file.imageData, 'base64'));
+    try {
+      const d = await decodeImage(temp);
+      return { image: { width: d.width, height: d.height, data: d.data }, foundryPath: source };
+    } catch {
+      throw new Error('Only PNG and JPEG pictures can be edited (this one is another format, for example WebP)');
+    }
+  }
+
+  private async edit(a: Extract<z.infer<typeof schema>, { action: 'edit' }>): Promise<any> {
+    if (!this.generate) throw new Error('Image generation is not available here');
+    const sources = [a.annotation, a.scene, a.image].filter(Boolean).length;
+    if (sources !== 1) throw new Error('Give exactly one of annotation, scene or image');
+
+    let sceneInfo: { id: string; name: string; background: string; columns: number; rows: number } | undefined;
+    let areaDef = a.area;
+    let change = a.prompt;
+    let annotation: string | undefined;
+    let sourcePath: string | undefined = a.image;
+
+    if (a.annotation) {
+      const list = await this.query('annotations', { action: 'list', status: 'all' });
+      const note = (list.notes ?? []).find((n: any) => n.id === a.annotation);
+      if (!note) throw new Error(`Note not found: ${a.annotation}`);
+      if (!note.area) throw new Error('That note points at an object, not an area; give scene and area yourself');
+      areaDef = { polygon: note.area.points, units: 'squares' };
+      change = change ?? note.prompt;
+      annotation = note.id;
+      sourcePath = undefined;
+      sceneInfo = await this.sceneDetails(note.scene.id);
+    } else if (a.scene) {
+      sceneInfo = await this.sceneDetails(a.scene);
+    }
+    if (!areaDef) throw new Error('Give the area to change (rect or polygon)');
+    if (!change) throw new Error('Say what to change (prompt)');
+    if (sceneInfo && !sceneInfo.background) throw new Error('That scene has no map image');
+
+    const { image: original, foundryPath } = await this.load(sceneInfo ? sceneInfo.background : sourcePath!);
+    const squares = sceneInfo ? { perSquareX: original.width / sceneInfo.columns, perSquareY: original.height / sceneInfo.rows } : undefined;
+    const poly: Pt[] = areaToPixels(areaDef, original, squares);
+
+    const outlineWidth = a.outline_width ?? Math.max(3, Math.round(Math.max(original.width, original.height) / 400));
+    const outlined = drawOutline(original, poly, outlineWidth);
+    const id = UNIQUE();
+    const refFile = await this.savePng(outlined, `ref-${id}.png`);
+    const size = generationSize(original);
+
+    const generated = await this.generate({
+      kind: a.kind ?? 'map',
+      name: `area-edit-${id}`,
+      prompt: buildEditPrompt(change),
+      reference_images: [refFile],
+      width: size.width,
+      height: size.height,
+      upload: false,
+      ...(a.seed !== undefined ? { seed: a.seed } : {}),
+    });
+    if (generated?.success === false || !generated?.local_path) throw new Error(generated?.error || 'The picture could not be generated');
+    const edited = await decodeImage(generated.local_path);
+
+    const feather = a.feather ?? Math.max(4, Math.round(original.width * 0.007));
+    const { image: composite, areaPixels } = compositeArea(original, { width: edited.width, height: edited.height, data: edited.data }, poly, feather);
+    const compositeFile = await this.savePng(composite, `edit-${id}.png`);
+    const previewFile = await this.savePng(beforeAfter(original, composite, poly), `preview-${id}.png`);
+
+    this.pending.set(id, {
+      id,
+      composite: compositeFile,
+      source: {
+        type: sceneInfo ? 'scene' : 'image',
+        ...(sceneInfo ? { scene: { id: sceneInfo.id, name: sceneInfo.name } } : {}),
+        ...((foundryPath ?? undefined) ? { foundryPath } : {}),
+        ...(annotation ? { annotation } : {}),
+      },
+    });
+    for (const old of [...this.pending.keys()].slice(0, -20)) this.pending.delete(old);
+
+    return {
+      success: true,
+      result: id,
+      picture: compositeFile,
+      preview: previewFile,
+      generated: generated.local_path,
+      size: `${original.width}x${original.height}`,
+      areaPixels,
+      ...(a.seed !== undefined ? { seed: a.seed } : generated.seed !== undefined ? { seed: generated.seed } : {}),
+      ...(sceneInfo ? { scene: { id: sceneInfo.id, name: sceneInfo.name } } : {}),
+      ...(annotation ? { annotation } : {}),
+      next: 'Open preview (before | after of the area). If it is right, commit with this result; otherwise edit again with another prompt, area or seed.',
+    };
+  }
+
+  private async sceneDetails(identifier: string): Promise<{ id: string; name: string; background: string; columns: number; rows: number }> {
+    const described = await this.query('manage-scenes', { action: 'describe', scene_identifier: identifier });
+    const s = described.scene;
+    if (!s) throw new Error(`Scene not found: "${identifier}"`);
+    const size = Number(s.grid?.size) || 100;
+    return { id: s.id, name: s.name, background: s.background ?? '', columns: Math.max(1, Math.round(Number(s.width) / size)), rows: Math.max(1, Math.round(Number(s.height) / size)) };
+  }
+
+  private async commit(a: Extract<z.infer<typeof schema>, { action: 'commit' }>): Promise<any> {
+    if (!this.upload) throw new Error('Upload is not available here');
+    const p = this.pending.get(a.result);
+    if (!p) throw new Error(`Unknown result "${a.result}"; run edit first (results are forgotten when the server restarts)`);
+    const apply = a.apply ?? (p.source.type === 'scene' ? 'scene' : 'file');
+    if (apply === 'scene' && !p.source.scene) throw new Error('This edit did not come from a scene; use apply file');
+
+    const original = p.source.foundryPath ?? p.source.scene?.name ?? 'image';
+    const stem = path.basename(original).replace(/\.[^.]+$/, '').replace(/[^A-Za-z0-9_-]+/g, '-').slice(0, 60) || 'image';
+    const fromUploads = /^worlds\/[^/]+\/uploads\/(.+)\/[^/]+$/.exec(p.source.foundryPath ?? '');
+    const folder = a.folder ?? fromUploads?.[1] ?? 'edits';
+    const filename = a.filename ?? `${stem.replace(/-edit-[a-z0-9]+$/, '')}-edit-${UNIQUE()}.png`;
+
+    let backup: any;
+    if (apply === 'scene' && a.backup !== false) {
+      backup = await this.query('manage-scene-backups', { action: 'backup', scene: p.source.scene!.id, label: 'before area edit' });
+    }
+    const uploaded = await this.upload({ file_path: p.composite, folder, filename });
+    if (uploaded?.success === false || !uploaded?.path) throw new Error(uploaded?.error || 'The picture could not be uploaded');
+
+    const out: Record<string, any> = { success: true, path: uploaded.path };
+    if (apply === 'scene') {
+      await this.query('manage-scenes', { action: 'update', scene_identifier: p.source.scene!.id, background: uploaded.path });
+      out.scene = p.source.scene;
+      out.backup = backup?.backup ?? backup?.scene ?? (backup ? 'made' : 'skipped');
+    }
+    if (p.source.annotation && a.resolve_note !== false) {
+      await this.query('annotations', {
+        action: 'resolve',
+        ids: [p.source.annotation],
+        status: 'done',
+        reply: a.reply ?? (apply === 'scene' ? 'Redrew the area on the map as requested.' : 'Redrew the area as requested.'),
+      });
+      out.noteResolved = p.source.annotation;
+    }
+    this.pending.delete(a.result);
+    return out;
+  }
+
+  async handle(args: unknown): Promise<any> {
+    const a = schema.parse(args ?? {});
+    this.logger.info('Edit image area', { action: a.action });
+    return a.action === 'edit' ? this.edit(a) : this.commit(a);
+  }
+}
diff --git a/packages/mcp-server/src/tools/image-edit-utils.test.ts b/packages/mcp-server/src/tools/image-edit-utils.test.ts
new file mode 100644
index 0000000..aac7ab7
--- /dev/null
+++ b/packages/mcp-server/src/tools/image-edit-utils.test.ts
@@ -0,0 +1,87 @@
+import { describe, expect, it } from 'vitest';
+import { areaToPixels, beforeAfter, buildEditPrompt, compositeArea, cropBox, drawOutline, generationSize, polygonBox, resizeBilinear, type Pixels } from './image-edit-utils.js';
+
+function solid(width: number, height: number, rgb: [number, number, number]): Pixels {
+  const data = new Uint8Array(width * height * 4);
+  for (let i = 0; i < width * height; i++) data.set([rgb[0], rgb[1], rgb[2], 255], i * 4);
+  return { width, height, data };
+}
+const px = (img: Pixels, x: number, y: number) => [...img.data.slice((y * img.width + x) * 4, (y * img.width + x) * 4 + 3)];
+
+describe('areaToPixels', () => {
+  const image = { width: 200, height: 100 };
+  it('converts squares, percent and pixels, rect or polygon', () => {
+    expect(areaToPixels({ rect: [1, 2, 3, 4] }, image, { perSquareX: 10, perSquareY: 5 })).toEqual([[10, 10], [40, 10], [40, 30], [10, 30]]);
+    expect(areaToPixels({ rect: [10, 20, 50, 40], units: 'percent' }, image)).toEqual([[20, 20], [120, 20], [120, 60], [20, 60]]);
+    expect(areaToPixels({ polygon: [[0, 0], [50, 0], [50, 40]], units: 'pixels' }, image)).toEqual([[0, 0], [50, 0], [50, 40]]);
+  });
+  it('clamps to the picture and refuses bad areas', () => {
+    expect(areaToPixels({ rect: [-10, -10, 400, 400], units: 'pixels' }, image)[2]).toEqual([200, 100]);
+    expect(() => areaToPixels({ rect: [1, 1, 2, 2], units: 'squares' }, image)).toThrow('scene image');
+    expect(() => areaToPixels({}, image)).toThrow('either rect');
+    expect(() => areaToPixels({ rect: [0, 0, 1, 1], polygon: [[0, 0], [1, 1], [2, 0]] }, image)).toThrow('either rect');
+    expect(() => areaToPixels({ polygon: [[0, 0], [5, 5]], units: 'pixels' }, image)).toThrow('three points');
+    expect(() => areaToPixels({ rect: [0, 0, 2, 2], units: 'pixels' }, image)).toThrow('too small');
+  });
+});
+
+describe('outline, composite and crops', () => {
+  const poly: Array<[number, number]> = [[10, 10], [50, 10], [50, 40], [10, 40]];
+  it('draws a red outline without touching the original', () => {
+    const base = solid(60, 50, [20, 30, 40]);
+    const out = drawOutline(base, poly, 3);
+    expect(px(out, 30, 10)).toEqual([255, 0, 0]);
+    expect(px(out, 30, 25)).toEqual([20, 30, 40]);
+    expect(px(base, 30, 10)).toEqual([20, 30, 40]);
+  });
+  it('pastes only the area, with a soft edge, and leaves everything else exactly as it was', () => {
+    const original = solid(60, 50, [10, 10, 10]);
+    const edited = solid(60, 50, [200, 100, 50]);
+    const { image, areaPixels } = compositeArea(original, edited, poly, 6);
+    expect(areaPixels).toBe(40 * 30);
+    expect(px(image, 30, 25)).toEqual([200, 100, 50]); // deep inside: the edit
+    const edge = px(image, 11, 25)[0]!;
+    expect(edge).toBeGreaterThan(10);
+    expect(edge).toBeLessThan(200); // blended at the edge
+    expect(px(image, 5, 5)).toEqual([10, 10, 10]);
+    expect(px(image, 55, 45)).toEqual([10, 10, 10]);
+    let changedOutside = 0;
+    for (let y = 0; y < 50; y++) for (let x = 0; x < 60; x++) {
+      if (x >= 10 && x < 50 && y >= 10 && y < 40) continue;
+      if (px(image, x, y)[0] !== 10) changedOutside++;
+    }
+    expect(changedOutside).toBe(0);
+  });
+  it('accepts an edited picture of another size', () => {
+    const { image } = compositeArea(solid(60, 50, [0, 0, 0]), solid(120, 100, [255, 255, 255]), poly, 0);
+    expect(px(image, 30, 25)).toEqual([255, 255, 255]);
+    expect(image.width).toBe(60);
+  });
+  it('resizes, crops and builds a before and after sheet', () => {
+    const r = resizeBilinear(solid(4, 4, [9, 9, 9]), 8, 6);
+    expect([r.width, r.height]).toEqual([8, 6]);
+    expect(px(r, 7, 5)).toEqual([9, 9, 9]);
+    const c = cropBox(solid(20, 20, [1, 2, 3]), { x: 5, y: 5, width: 100, height: 4 });
+    expect([c.width, c.height]).toEqual([15, 4]);
+    expect(polygonBox(poly)).toEqual({ x: 10, y: 10, width: 40, height: 30 });
+    const sheet = beforeAfter(solid(60, 50, [0, 0, 0]), solid(60, 50, [255, 255, 255]), poly, 1500);
+    expect(px(sheet, 2, 5)).toEqual([0, 0, 0]);
+    expect(px(sheet, sheet.width - 2, 5)).toEqual([255, 255, 255]);
+    expect(beforeAfter(solid(60, 50, [0, 0, 0]), solid(60, 50, [0, 0, 0]), poly, 40).width).toBe(40);
+  });
+});
+
+describe('generation size and prompt', () => {
+  it('keeps proportions, caps at 2048 and rounds to 16', () => {
+    expect(generationSize({ width: 2016, height: 1344 })).toEqual({ width: 2016, height: 1344 });
+    expect(generationSize({ width: 4032, height: 2688 })).toEqual({ width: 2048, height: 1360 });
+    expect(generationSize({ width: 100, height: 100 })).toEqual({ width: 256, height: 256 });
+  });
+  it('wraps the change in an edit instruction', () => {
+    const p = buildEditPrompt('add a wooden door in the east wall.  ');
+    expect(p).toContain('<Picture 1>');
+    expect(p).toContain('inside the area marked by the red outline: add a wooden door in the east wall.');
+    expect(p).toContain('Remove the red outline completely');
+    expect(p).toContain('Everything outside the marked area stays unchanged');
+  });
+});
diff --git a/packages/mcp-server/src/tools/image-edit-utils.ts b/packages/mcp-server/src/tools/image-edit-utils.ts
new file mode 100644
index 0000000..5370c6d
--- /dev/null
+++ b/packages/mcp-server/src/tools/image-edit-utils.ts
@@ -0,0 +1,197 @@
+/**
+ * Editing one area of a picture with an image model without touching the rest: mark the area
+ * with a red outline, let the model change what is inside, paste only that area back into the
+ * original. Pure pixel work; no network or Foundry.
+ */
+export interface Pixels {
+  width: number;
+  height: number;
+  /** RGBA */
+  data: Uint8Array;
+}
+
+export type Pt = [number, number];
+
+export interface AreaInput {
+  rect?: [number, number, number, number] | undefined;
+  polygon?: Pt[] | undefined;
+  units?: 'squares' | 'percent' | 'pixels' | undefined;
+}
+
+/** The area as a polygon in pixels of an image of this size. */
+export function areaToPixels(area: AreaInput, image: { width: number; height: number }, squares?: { perSquareX: number; perSquareY: number }): Pt[] {
+  const units = area.units ?? (squares ? 'squares' : 'percent');
+  if (!!area.rect === !!area.polygon) throw new Error('Give the area as either rect [x, y, width, height] or polygon [[x, y], ...]');
+  const pts: Pt[] = area.rect
+    ? [[area.rect[0], area.rect[1]], [area.rect[0] + area.rect[2], area.rect[1]], [area.rect[0] + area.rect[2], area.rect[1] + area.rect[3]], [area.rect[0], area.rect[1] + area.rect[3]]]
+    : area.polygon!;
+  if (pts.length < 3) throw new Error('A polygon needs at least three points');
+  const mapped = pts.map(([x, y]): Pt => {
+    if (units === 'pixels') return [x, y];
+    if (units === 'percent') return [(x / 100) * image.width, (y / 100) * image.height];
+    if (!squares) throw new Error('Squares only work for a scene image; use percent or pixels');
+    return [x * squares.perSquareX, y * squares.perSquareY];
+  });
+  const clamped = mapped.map(([x, y]): Pt => [Math.max(0, Math.min(image.width, x)), Math.max(0, Math.min(image.height, y))]);
+  const bounds = polygonBox(clamped);
+  if (bounds.width < 8 || bounds.height < 8) throw new Error('The area is too small (or outside the picture)');
+  return clamped;
+}
+
+export function polygonBox(points: Pt[]): { x: number; y: number; width: number; height: number } {
+  const xs = points.map(p => p[0]);
+  const ys = points.map(p => p[1]);
+  const x = Math.min(...xs);
+  const y = Math.min(...ys);
+  return { x, y, width: Math.max(...xs) - x, height: Math.max(...ys) - y };
+}
+
+function inside(poly: Pt[], x: number, y: number): boolean {
+  let r = false;
+  for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
+    const [xi, yi] = poly[i]!;
+    const [xj, yj] = poly[j]!;
+    if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) r = !r;
+  }
+  return r;
+}
+
+function edgeDistance(poly: Pt[], x: number, y: number): number {
+  let best = Infinity;
+  for (let i = 0; i < poly.length; i++) {
+    const [ax, ay] = poly[i]!;
+    const [bx, by] = poly[(i + 1) % poly.length]!;
+    const dx = bx - ax;
+    const dy = by - ay;
+    const l2 = dx * dx + dy * dy;
+    const t = l2 ? Math.max(0, Math.min(1, ((x - ax) * dx + (y - ay) * dy) / l2)) : 0;
+    best = Math.min(best, Math.hypot(x - (ax + t * dx), y - (ay + t * dy)));
+  }
+  return best;
+}
+
+/** A copy of the picture with the area outlined in red. */
+export function drawOutline(image: Pixels, poly: Pt[], width: number): Pixels {
+  const out: Pixels = { width: image.width, height: image.height, data: new Uint8Array(image.data) };
+  const half = Math.floor(width / 2);
+  const put = (x: number, y: number) => {
+    if (x < 0 || y < 0 || x >= out.width || y >= out.height) return;
+    const i = (y * out.width + x) * 4;
+    out.data[i] = 255;
+    out.data[i + 1] = 0;
+    out.data[i + 2] = 0;
+    out.data[i + 3] = 255;
+  };
+  for (let k = 0; k < poly.length; k++) {
+    const [x1, y1] = poly[k]!;
+    const [x2, y2] = poly[(k + 1) % poly.length]!;
+    const steps = Math.max(1, Math.ceil(Math.hypot(x2 - x1, y2 - y1)));
+    for (let s = 0; s <= steps; s++) {
+      const x = Math.round(x1 + ((x2 - x1) * s) / steps);
+      const y = Math.round(y1 + ((y2 - y1) * s) / steps);
+      for (let dx = -half; dx <= half; dx++) for (let dy = -half; dy <= half; dy++) put(x + dx, y + dy);
+    }
+  }
+  return out;
+}
+
+export function resizeBilinear(src: Pixels, outW: number, outH: number): Pixels {
+  if (src.width === outW && src.height === outH) return src;
+  const out = new Uint8Array(outW * outH * 4);
+  for (let y = 0; y < outH; y++) {
+    const fy = ((y + 0.5) * src.height) / outH - 0.5;
+    const y0 = Math.max(0, Math.floor(fy));
+    const y1 = Math.min(src.height - 1, y0 + 1);
+    const ty = Math.min(1, Math.max(0, fy - y0));
+    for (let x = 0; x < outW; x++) {
+      const fx = ((x + 0.5) * src.width) / outW - 0.5;
+      const x0 = Math.max(0, Math.floor(fx));
+      const x1 = Math.min(src.width - 1, x0 + 1);
+      const tx = Math.min(1, Math.max(0, fx - x0));
+      for (let c = 0; c < 4; c++) {
+        const a = src.data[(y0 * src.width + x0) * 4 + c]!;
+        const b = src.data[(y0 * src.width + x1) * 4 + c]!;
+        const d = src.data[(y1 * src.width + x0) * 4 + c]!;
+        const e = src.data[(y1 * src.width + x1) * 4 + c]!;
+        out[(y * outW + x) * 4 + c] = Math.round((a * (1 - tx) + b * tx) * (1 - ty) + (d * (1 - tx) + e * tx) * ty);
+      }
+    }
+  }
+  return { width: outW, height: outH, data: out };
+}
+
+/**
+ * The original with only the area taken from the edited picture. The edge blends over `feather`
+ * pixels inside the area. Pixels outside the area are exactly the original's.
+ */
+export function compositeArea(original: Pixels, edited: Pixels, poly: Pt[], feather: number): { image: Pixels; areaPixels: number } {
+  const gen = resizeBilinear(edited, original.width, original.height);
+  const out: Pixels = { width: original.width, height: original.height, data: new Uint8Array(original.data) };
+  const box = polygonBox(poly);
+  const x0 = Math.max(0, Math.floor(box.x));
+  const y0 = Math.max(0, Math.floor(box.y));
+  const x1 = Math.min(original.width - 1, Math.ceil(box.x + box.width));
+  const y1 = Math.min(original.height - 1, Math.ceil(box.y + box.height));
+  let areaPixels = 0;
+  for (let y = y0; y <= y1; y++) {
+    for (let x = x0; x <= x1; x++) {
+      if (!inside(poly, x + 0.5, y + 0.5)) continue;
+      const a = feather > 0 ? Math.min(1, edgeDistance(poly, x + 0.5, y + 0.5) / feather) : 1;
+      const i = (y * original.width + x) * 4;
+      for (let c = 0; c < 3; c++) out.data[i + c] = Math.round(original.data[i + c]! * (1 - a) + gen.data[i + c]! * a);
+      areaPixels++;
+    }
+  }
+  return { image: out, areaPixels };
+}
+
+export function cropBox(image: Pixels, box: { x: number; y: number; width: number; height: number }): Pixels {
+  const x0 = Math.max(0, Math.floor(box.x));
+  const y0 = Math.max(0, Math.floor(box.y));
+  const x1 = Math.min(image.width, Math.ceil(box.x + box.width));
+  const y1 = Math.min(image.height, Math.ceil(box.y + box.height));
+  const w = Math.max(1, x1 - x0);
+  const h = Math.max(1, y1 - y0);
+  const out = new Uint8Array(w * h * 4);
+  for (let y = 0; y < h; y++) {
+    const from = ((y0 + y) * image.width + x0) * 4;
+    out.set(image.data.subarray(from, from + w * 4), y * w * 4);
+  }
+  return { width: w, height: h, data: out };
+}
+
+/** Before and after of the area, side by side, with some margin around it, at most maxWidth wide. */
+export function beforeAfter(before: Pixels, after: Pixels, poly: Pt[], maxWidth = 1500): Pixels {
+  const box = polygonBox(poly);
+  const margin = Math.max(box.width, box.height) * 0.12;
+  const around = { x: box.x - margin, y: box.y - margin, width: box.width + margin * 2, height: box.height + margin * 2 };
+  const a = cropBox(before, around);
+  const b = cropBox(after, around);
+  const gap = Math.max(4, Math.round(a.width * 0.02));
+  const width = a.width * 2 + gap;
+  const out = new Uint8Array(width * a.height * 4).fill(255);
+  for (let y = 0; y < a.height; y++) {
+    out.set(a.data.subarray(y * a.width * 4, (y + 1) * a.width * 4), y * width * 4);
+    out.set(b.data.subarray(y * b.width * 4, (y + 1) * b.width * 4), (y * width + a.width + gap) * 4);
+  }
+  const sheet: Pixels = { width, height: a.height, data: out };
+  if (width <= maxWidth) return sheet;
+  const scale = maxWidth / width;
+  return resizeBilinear(sheet, maxWidth, Math.max(1, Math.round(a.height * scale)));
+}
+
+/** Size to ask the image model for: the picture's own proportions, at most 2048 a side, multiples of 16. */
+export function generationSize(image: { width: number; height: number }, maxSide = 2048): { width: number; height: number } {
+  const scale = Math.min(1, maxSide / Math.max(image.width, image.height));
+  const round16 = (v: number) => Math.max(256, Math.min(maxSide, Math.round((v * scale) / 16) * 16));
+  return { width: round16(image.width), height: round16(image.height) };
+}
+
+export function buildEditPrompt(change: string): string {
+  const what = change.trim().replace(/[.\s]+$/, '');
+  return (
+    'Edit <Picture 1> and keep the whole picture exactly as it is (same layout, art style, colours, lighting and framing) ' +
+    `with one change inside the area marked by the red outline: ${what}. ` +
+    'Remove the red outline completely and paint what is underneath it in the original style. Everything outside the marked area stays unchanged.'
+  );
+}

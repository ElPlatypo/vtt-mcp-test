+import { describe, expect, it } from 'vitest';
+import { TableBundler, type TableEventIn } from './table-bundler.js';
+
+let seq = 0;
+const ev = (over: Partial<TableEventIn>): TableEventIn => ({ seq: ++seq, at: 0, kind: 'move', text: 'x', wake: false, ...over });
+
+describe('TableBundler', () => {
+  it('holds background events until something wakes, then waits for quiet', () => {
+    const b = new TableBundler({ quietMs: 5000, minIntervalMs: 10000, maxWaitMs: 25000 });
+    b.add([ev({ text: 'Randal moved to square (3, 4)' })], 0);
+    expect(b.due(60_000)).toBe(false); // nothing to wake for
+    b.add([ev({ kind: 'say', wake: true, text: 'Randal: "I open the chest"' })], 1000);
+    expect(b.due(4000)).toBe(false);
+    b.add([ev({ kind: 'say', wake: true, text: 'Mira: "Careful!"' })], 4000); // still talking
+    expect(b.due(8000)).toBe(false);
+    expect(b.due(9000)).toBe(true);
+    expect(b.flush(9000)).toEqual({
+      why: ['a player spoke in character'],
+      events: ['Randal moved to square (3, 4)', 'Randal: "I open the chest"', 'Mira: "Careful!"'],
+    });
+    expect(b.flush(9001)).toBeUndefined();
+  });
+
+  it('acts fast on a monster turn but keeps a minimum gap between beats', () => {
+    const b = new TableBundler({ turnQuietMs: 1500, minIntervalMs: 10000 });
+    b.add([ev({ kind: 'turn', wake: true, text: "Goblin 1's turn" })], 0);
+    expect(b.due(1500)).toBe(true);
+    b.flush(1500);
+    b.add([ev({ kind: 'turn', wake: true, text: "Goblin 2's turn" })], 2000);
+    expect(b.due(3500)).toBe(false);
+    expect(b.nextCheck(3500)).toBe(11500);
+    expect(b.due(11500)).toBe(true);
+  });
+
+  it('sends at the latest after the maximum wait while the table keeps talking', () => {
+    const b = new TableBundler({ quietMs: 5000, minIntervalMs: 0, maxWaitMs: 20000 });
+    for (let t = 0; t <= 20000; t += 2000) b.add([ev({ kind: 'say', wake: true })], t);
+    expect(b.due(19000)).toBe(false);
+    expect(b.due(20000)).toBe(true);
+  });
+
+  it('coalesces moves and hp per key and caps the background, never dropping waking events', () => {
+    const b = new TableBundler({ maxBackground: 2, minIntervalMs: 0 });
+    b.add(
+      [
+        ev({ text: 'Randal to (1,1)', key: 'move:t1' }),
+        ev({ text: 'Mira to (2,2)', key: 'move:t2' }),
+        ev({ text: 'Randal to (5,5)', key: 'move:t1' }),
+        ev({ kind: 'roll', text: 'Mira rolled 12' }),
+        ev({ kind: 'say', wake: true, text: 'Randal: "Hi"' }),
+      ],
+      0
+    );
+    expect(b.flush(10)).toEqual({ why: ['a player spoke in character'], events: ['Randal to (5,5)', 'Mira rolled 12', 'Randal: "Hi"'], dropped: 1 });
+  });
+
+  it('waits for the rolls it asked for, matching player or character, then wakes', () => {
+    const b = new TableBundler({ quietMs: 0, minIntervalMs: 0 });
+    b.expect(['Claudio', 'Mira'], 0, 90_000);
+    b.add([ev({ kind: 'say', wake: true, text: 'Randal: "ok rolling"' })], 100);
+    expect(b.due(200)).toBe(false); // held: rolls are awaited
+    b.add([ev({ kind: 'roll', user: 'Claudio', actor: 'Randal', text: 'Randal rolled 14' })], 300);
+    expect(b.awaiting).toEqual(['Mira']);
+    b.add([ev({ kind: 'roll', user: 'Marta', actor: 'Mira', text: 'Mira rolled 9' })], 400);
+    expect(b.awaiting).toBeUndefined();
+    expect(b.due(400)).toBe(true);
+    expect(b.flush(400)?.why).toEqual(['every roll asked for is in', 'a player spoke in character']);
+  });
+
+  it('times out awaited rolls and says who is missing', () => {
+    const b = new TableBundler({ quietMs: 0, minIntervalMs: 0 });
+    b.expect(['Marta'], 0, 60_000);
+    b.tick(59_000);
+    expect(b.due(59_000)).toBe(false);
+    b.tick(60_000);
+    expect(b.due(60_000)).toBe(true);
+    expect(b.flush(60_000)?.why).toEqual(['rolls asked for timed out; not rolled: Marta']);
+  });
+
+  it('sends nothing while muted, and everything at once when unmuted', () => {
+    const b = new TableBundler({ quietMs: 0, minIntervalMs: 0 });
+    b.muted = true;
+    b.add([ev({ kind: 'say', wake: true, text: 'one' }), ev({ kind: 'whisper', wake: true, text: 'two' })], 0);
+    expect(b.due(100_000)).toBe(false);
+    b.muted = false;
+    expect(b.due(100_000)).toBe(true);
+    expect(b.flush(100_000)?.events).toEqual(['one', 'two']);
+  });
+});
+
+describe('TableBundler: round 1 fixes', () => {
+  it('drops a turn wake for a creature that is no longer the one to act', () => {
+    const b = new TableBundler({ turnQuietMs: 1500, minIntervalMs: 0 });
+    b.add([ev({ kind: 'turn', wake: true, actor: 'Goblin 1', text: "Goblin 1's turn" })], 0);
+    expect(b.dropStaleTurns('Goblin 2')).toBe(false);
+    expect(b.due(5000)).toBe(false);
+    expect(b.flush(5000)).toBeUndefined();
+  });
+
+  it('keeps a current turn and other waking events when dropping stale turns', () => {
+    const b = new TableBundler({ minIntervalMs: 0 });
+    b.add([ev({ kind: 'turn', wake: true, actor: 'Goblin 1', text: 'g1' }), ev({ kind: 'say', wake: true, text: 'Randal: "hi"' })], 0);
+    expect(b.dropStaleTurns('Goblin 2')).toBe(true);
+    expect(b.flush(10)?.events).toEqual(['Randal: "hi"']);
+    b.add([ev({ kind: 'turn', wake: true, actor: 'Goblin 2', text: 'g2' })], 20);
+    expect(b.dropStaleTurns('Goblin 2')).toBe(true);
+  });
+
+  it('drops turns when the combat is over', () => {
+    const b = new TableBundler();
+    b.add([ev({ kind: 'turn', wake: true, actor: 'Goblin 1', text: 'g1' })], 0);
+    expect(b.dropStaleTurns(undefined)).toBe(false);
+  });
+
+  it('folds an item card into the roll that follows and joins damage to its attack', () => {
+    const b = new TableBundler({ minIntervalMs: 0 });
+    b.add(
+      [
+        ev({ kind: 'card', actor: 'Randal', item: 'Longsword', text: 'Randal used Longsword' }),
+        ev({ kind: 'roll', actor: 'Randal', item: 'Longsword', rollKind: 'attack', text: 'Randal rolled Attack: 17 vs Goblin 2 (AC 15): hit' }),
+        ev({ kind: 'roll', actor: 'Randal', item: 'Longsword', rollKind: 'damage', total: 8, text: 'Randal rolled Damage: 8' }),
+        ev({ kind: 'say', wake: true, text: 'Randal: "take that"' }),
+      ],
+      0
+    );
+    expect(b.flush(1)?.events).toEqual(['Randal rolled Attack: 17 vs Goblin 2 (AC 15): hit; damage 8', 'Randal: "take that"']);
+  });
+
+  it('counts a roll that came in before the expectation was armed', () => {
+    const b = new TableBundler({ minIntervalMs: 0 });
+    b.add([ev({ kind: 'roll', at: 5000, user: 'Claudio', actor: 'Randal', text: 'Randal rolled Perception: 12' })], 5100);
+    b.expect(['Claudio'], 6000, 90_000, 4000);
+    expect(b.awaiting).toBeUndefined();
+    expect(b.hasWake).toBe(true);
+  });
+
+  it('ignores a roll from before the request', () => {
+    const b = new TableBundler();
+    b.add([ev({ kind: 'roll', at: 1000, user: 'Claudio', text: 'old roll' })], 1100);
+    b.expect(['Claudio'], 6000, 90_000, 4000);
+    expect(b.awaiting).toEqual(['Claudio']);
+  });
+});
diff --git a/packages/mcp-server/src/table-bundler.ts b/packages/mcp-server/src/table-bundler.ts

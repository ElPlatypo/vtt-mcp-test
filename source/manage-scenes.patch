--- /dev/null
+++ b/packages/mcp-server/src/comfyui-errors.ts
@@ -0,0 +1,77 @@
+/**
+ * Turn ComfyUI's rejection of a job (an HTTP 400 with a JSON body) into a message that says
+ * what is wrong, such as a checkpoint that is not in the models/checkpoints folder, instead
+ * of "Request failed with status code 400".
+ */
+
+const MAX_LENGTH = 700;
+
+interface NodeError {
+  class_type?: string;
+  errors?: Array<{ type?: string; message?: string; details?: string }>;
+}
+
+/**
+ * Why a job that was accepted still failed: the messages ComfyUI keeps in its history entry
+ * (`status.messages` holds `["execution_error", {exception_message, node_type, ...}]`).
+ */
+export function describeExecutionError(entry: unknown): string {
+  const messages = (entry as any)?.status?.messages;
+  if (Array.isArray(messages)) {
+    for (const message of messages) {
+      if (Array.isArray(message) && message[0] === 'execution_error') {
+        const info = message[1] ?? {};
+        const where = info.node_type ? `${info.node_type}: ` : '';
+        const text = String(info.exception_message ?? 'unknown error').trim();
+        return `${where}${text}`.slice(0, MAX_LENGTH);
+      }
+    }
+  }
+  return 'unknown error (see the ComfyUI console)';
+}
+
+export function describeComfySubmitError(
+  status: number | undefined,
+  data: unknown,
+  fallback: string
+): string {
+  const body = (data && typeof data === 'object' ? data : {}) as {
+    error?: { message?: string; details?: string } | string;
+    node_errors?: Record<string, NodeError>;
+  };
+
+  const parts: string[] = [];
+
+  const topMessage =
+    typeof body.error === 'string' ? body.error : (body.error?.message ?? undefined);
+  const topDetails = typeof body.error === 'object' ? body.error?.details : undefined;
+  if (topMessage) parts.push(topDetails ? `${topMessage} (${topDetails})` : topMessage);
+
+  const problems: string[] = [];
+  let missingModel = false;
+  for (const [nodeId, node] of Object.entries(body.node_errors ?? {})) {
+    for (const problem of node.errors ?? []) {
+      const where = node.class_type ? `${node.class_type} (node ${nodeId})` : `node ${nodeId}`;
+      const text = [problem.message, problem.details].filter(Boolean).join(': ');
+      problems.push(`${where}: ${text}`);
+      if (
+        problem.type === 'value_not_in_list' &&
+        /(ckpt_name|vae_name|lora_name|unet_name)/.test(problem.details ?? '')
+      ) {
+        missingModel = true;
+      }
+    }
+  }
+  if (problems.length) parts.push(problems.slice(0, 4).join('; '));
+
+  let message = parts.length
+    ? `ComfyUI rejected the job${status ? ` (HTTP ${status})` : ''}: ${parts.join(' - ')}`
+    : fallback;
+
+  if (missingModel) {
+    message +=
+      ' | A model file is not where this ComfyUI looks. The checkpoint must be in ComfyUI/models/checkpoints and the VAE in models/vae (not diffusion_models), then refresh or restart ComfyUI.';
+  }
+
+  return message.length > MAX_LENGTH ? `${message.slice(0, MAX_LENGTH - 1)}…` : message;
+}

+/**
+ * Pure helpers for manage-scene-objects and preview-scene: grid geometry, converting grid
+ * squares to scene pixels, and building light data. No Foundry globals, so they can be tested.
+ *
+ * Coordinate convention used by the tools: positions are in grid squares, measured from the
+ * top-left corner of the scene image (the grid origin). (0, 0) is the top-left corner of the
+ * top-left square; (2.5, 1.5) is the centre of the square in column 2, row 1 (0-based).
+ */
+
+export interface GridGeometry {
+  /** Pixels per grid square. */
+  size: number;
+  /** Pixel offset of the scene image's top-left corner (the padding around the map). */
+  originX: number;
+  originY: number;
+  /** Size of the scene image in pixels (without padding). */
+  sceneWidth: number;
+  sceneHeight: number;
+  /** Whole squares across and down. */
+  columns: number;
+  rows: number;
+  /** Distance of one square (e.g. 5) and its unit (e.g. "ft"). */
+  distance: number;
+  units: string;
+}
+
+/** Marker stored on everything the tool creates, so only those objects can be removed. */
+export const CREATED_BY_FLAG = 'sceneObjectsTool';
+
+/**
+ * Read the grid geometry of a Foundry scene. Prefers scene.dimensions (which knows the real
+ * padding offset); falls back to Foundry's own padding formula.
+ */
+export function getGridGeometry(scene: any): GridGeometry {
+  const size = Number(scene?.grid?.size ?? scene?.dimensions?.size);
+  if (!Number.isFinite(size) || size <= 0) {
+    throw new Error('The scene has no valid grid size');
+  }
+  const dims = scene?.dimensions;
+  const sceneWidth = Number(dims?.sceneWidth ?? scene?.width);
+  const sceneHeight = Number(dims?.sceneHeight ?? scene?.height);
+  if (
+    !Number.isFinite(sceneWidth) ||
+    !Number.isFinite(sceneHeight) ||
+    sceneWidth <= 0 ||
+    sceneHeight <= 0
+  ) {
+    throw new Error('The scene has no valid size');
+  }
+  const padding = Number(scene?.padding ?? 0);
+  const fallbackX = Math.ceil((sceneWidth * padding) / size) * size;
+  const fallbackY = Math.ceil((sceneHeight * padding) / size) * size;
+  const originX = Number.isFinite(dims?.sceneX) ? Number(dims.sceneX) : fallbackX;
+  const originY = Number.isFinite(dims?.sceneY) ? Number(dims.sceneY) : fallbackY;
+  return {
+    size,
+    originX,
+    originY,
+    sceneWidth,
+    sceneHeight,
+    columns: Math.floor(sceneWidth / size),
+    rows: Math.floor(sceneHeight / size),
+    distance: Number(scene?.grid?.distance ?? 5),
+    units: String(scene?.grid?.units ?? ''),
+  };
+}
+
+export function squaresToPixels(
+  geom: GridGeometry,
+  x: number,
+  y: number
+): { x: number; y: number } {
+  return {
+    x: Math.round(geom.originX + x * geom.size),
+    y: Math.round(geom.originY + y * geom.size),
+  };
+}
+
+export function pixelsToSquares(
+  geom: GridGeometry,
+  px: number,
+  py: number
+): { x: number; y: number } {
+  const round = (value: number) => Math.round(value * 100) / 100;
+  return { x: round((px - geom.originX) / geom.size), y: round((py - geom.originY) / geom.size) };
+}
+
+/** Throw unless (x, y) is a finite point inside the scene image. */
+export function assertInsideScene(geom: GridGeometry, x: unknown, y: unknown, label: string): void {
+  if (
+    typeof x !== 'number' ||
+    typeof y !== 'number' ||
+    !Number.isFinite(x) ||
+    !Number.isFinite(y)
+  ) {
+    throw new Error(`${label}: x and y must be numbers (grid squares)`);
+  }
+  const maxX = geom.sceneWidth / geom.size;
+  const maxY = geom.sceneHeight / geom.size;
+  if (x < 0 || y < 0 || x > maxX || y > maxY) {
+    throw new Error(
+      `${label}: (${x}, ${y}) is outside the scene, which is ${geom.columns} x ${geom.rows} squares (x 0 to ${round2(maxX)}, y 0 to ${round2(maxY)})`
+    );
+  }
+}
+
+function round2(value: number): number {
+  return Math.round(value * 100) / 100;
+}
+
+export interface LightSpec {
+  x: number;
+  y: number;
+  /** Radius of bright light, in grid squares. */
+  bright?: number;
+  /** Radius of dim light, in grid squares. */
+  dim?: number;
+  /** Colour as #RRGGBB. */
+  color?: string;
+  /** Opacity of the colour, 0 to 1. */
+  alpha?: number;
+  /** Cone angle in degrees, 1 to 360 (default 360). */
+  angle?: number;
+  /** Direction of a cone in degrees (0 = down, clockwise). */
+  rotation?: number;
+  hidden?: boolean;
+  /** Animation type, e.g. torch, pulse, flame, ghost. */
+  animation?: string;
+  label?: string;
+}
+
+const LIGHT_ANIMATIONS = [
+  'torch',
+  'pulse',
+  'chroma',
+  'wave',
+  'fog',
+  'sunburst',
+  'dome',
+  'emanation',
+  'hexa',
+  'ghost',
+  'energy',
+  'roiling',
+  'hole',
+] as const;
+
+/** Maximum radius of a light, in grid squares. */
+export const MAX_LIGHT_RADIUS_SQUARES = 200;
+
+/**
+ * Validate a light spec and build the AmbientLight data for scene.createEmbeddedDocuments.
+ * Radii are converted from grid squares to scene distance units (Foundry stores distance).
+ */
+export function buildLightData(
+  spec: LightSpec,
+  geom: GridGeometry,
+  label: string
+): Record<string, any> {
+  assertInsideScene(geom, spec.x, spec.y, label);
+
+  const radius = (value: unknown, name: string): number => {
+    if (value === undefined) return 0;
+    if (
+      typeof value !== 'number' ||
+      !Number.isFinite(value) ||
+      value < 0 ||
+      value > MAX_LIGHT_RADIUS_SQUARES
+    ) {
+      throw new Error(
+        `${label}: ${name} must be a number of squares from 0 to ${MAX_LIGHT_RADIUS_SQUARES}`
+      );
+    }
+    return value;
+  };
+  const bright = radius(spec.bright, 'bright');
+  const dim = radius(spec.dim, 'dim');
+  if (bright === 0 && dim === 0) {
+    throw new Error(`${label}: a light needs a bright or dim radius (in squares)`);
+  }
+
+  const config: Record<string, any> = {
+    bright: bright * geom.distance,
+    dim: dim * geom.distance,
+  };
+
+  if (spec.color !== undefined) {
+    if (typeof spec.color !== 'string' || !/^#[0-9a-fA-F]{6}$/.test(spec.color)) {
+      throw new Error(`${label}: color must look like #RRGGBB`);
+    }
+    config.color = spec.color.toLowerCase();
+  }
+  if (spec.alpha !== undefined) {
+    if (typeof spec.alpha !== 'number' || spec.alpha < 0 || spec.alpha > 1) {
+      throw new Error(`${label}: alpha must be a number from 0 to 1`);
+    }
+    config.alpha = spec.alpha;
+  }
+  if (spec.angle !== undefined) {
+    if (typeof spec.angle !== 'number' || spec.angle < 1 || spec.angle > 360) {
+      throw new Error(`${label}: angle must be a number from 1 to 360`);
+    }
+    config.angle = spec.angle;
+  }
+  if (spec.animation !== undefined) {
+    if (!(LIGHT_ANIMATIONS as readonly string[]).includes(spec.animation)) {
+      throw new Error(`${label}: animation must be one of ${LIGHT_ANIMATIONS.join(', ')}`);
+    }
+    config.animation = { type: spec.animation, speed: 5, intensity: 5 };
+  }
+
+  const { x, y } = squaresToPixels(geom, spec.x, spec.y);
+  const data: Record<string, any> = { x, y, config };
+  if (spec.rotation !== undefined) {
+    if (typeof spec.rotation !== 'number' || !Number.isFinite(spec.rotation)) {
+      throw new Error(`${label}: rotation must be a number of degrees`);
+    }
+    data.rotation = spec.rotation;
+  }
+  if (spec.hidden !== undefined) data.hidden = !!spec.hidden;
+  return data;
+}
+
+export { LIGHT_ANIMATIONS };
+
+// ===== WALLS =====
+
+/** What a wall blocks, by preset. Values are Foundry's wall restriction types (0 none, 20 normal). */
+export const WALL_PRESETS = ['wall', 'door', 'secret_door', 'invisible', 'window'] as const;
+export type WallPreset = (typeof WALL_PRESETS)[number];
+export const DOOR_STATES = ['closed', 'open', 'locked'] as const;
+
+/** At most this many wall segments in one call. */
+export const MAX_WALL_SEGMENTS = 1000;
+
+export interface WallSpec {
+  /** A chain of points in grid squares: [[x1, y1], [x2, y2], ...]; each pair becomes a wall. */
+  points?: Array<[number, number]>;
+  /** A rectangle in grid squares: [x, y, width, height]; becomes four walls. */
+  rect?: [number, number, number, number];
+  /** Join the last point back to the first (points only). */
+  closed?: boolean;
+  preset?: WallPreset;
+  /** For doors: closed (default), open or locked. */
+  door_state?: (typeof DOOR_STATES)[number];
+}
+
+export interface WallSegment {
+  x1: number;
+  y1: number;
+  x2: number;
+  y2: number;
+}
+
+/** Turn a spec into line segments in grid squares, validating every point. */
+export function wallSegments(spec: WallSpec, geom: GridGeometry, label: string): WallSegment[] {
+  if ((spec.points === undefined) === (spec.rect === undefined)) {
+    throw new Error(`${label}: give either points or rect`);
+  }
+  let chain: Array<[number, number]>;
+  if (spec.rect !== undefined) {
+    if (!Array.isArray(spec.rect) || spec.rect.length !== 4) {
+      throw new Error(`${label}: rect must be [x, y, width, height]`);
+    }
+    const [x, y, w, h] = spec.rect;
+    if (typeof w !== 'number' || typeof h !== 'number' || !(w > 0) || !(h > 0)) {
+      throw new Error(`${label}: rect width and height must be positive numbers`);
+    }
+    chain = [
+      [x, y],
+      [x + w, y],
+      [x + w, y + h],
+      [x, y + h],
+    ];
+    assertInsideScene(geom, x, y, label);
+    assertInsideScene(geom, x + w, y + h, label);
+    return chain.map((point, i) => {
+      const next = chain[(i + 1) % chain.length];
+      return { x1: point[0], y1: point[1], x2: next[0], y2: next[1] };
+    });
+  }
+
+  chain = spec.points as Array<[number, number]>;
+  if (!Array.isArray(chain) || chain.length < 2) {
+    throw new Error(`${label}: points needs at least two [x, y] points`);
+  }
+  chain.forEach((point, i) => {
+    if (!Array.isArray(point) || point.length !== 2) {
+      throw new Error(`${label}: points[${i}] must be [x, y]`);
+    }
+    assertInsideScene(geom, point[0], point[1], `${label} points[${i}]`);
+  });
+  const segments: WallSegment[] = [];
+  const count = spec.closed ? chain.length : chain.length - 1;
+  for (let i = 0; i < count; i++) {
+    const a = chain[i];
+    const b = chain[(i + 1) % chain.length];
+    if (a[0] === b[0] && a[1] === b[1]) {
+      throw new Error(`${label}: points[${i}] and the next point are the same`);
+    }
+    segments.push({ x1: a[0], y1: a[1], x2: b[0], y2: b[1] });
+  }
+  return segments;
+}
+
+/** Foundry wall data for each segment: pixels, restrictions and door settings. */
+export function buildWallData(
+  spec: WallSpec,
+  geom: GridGeometry,
+  label: string
+): Array<Record<string, any>> {
+  const preset = spec.preset ?? 'wall';
+  if (!(WALL_PRESETS as readonly string[]).includes(preset)) {
+    throw new Error(`${label}: preset must be one of ${WALL_PRESETS.join(', ')}`);
+  }
+  if (spec.door_state !== undefined) {
+    if (!(DOOR_STATES as readonly string[]).includes(spec.door_state)) {
+      throw new Error(`${label}: door_state must be closed, open or locked`);
+    }
+    if (preset !== 'door' && preset !== 'secret_door') {
+      throw new Error(`${label}: door_state only applies to door and secret_door`);
+    }
+  }
+
+  const restrictions: Record<
+    WallPreset,
+    { move: number; light: number; sight: number; sound: number }
+  > = {
+    wall: { move: 20, light: 20, sight: 20, sound: 20 },
+    door: { move: 20, light: 20, sight: 20, sound: 20 },
+    secret_door: { move: 20, light: 20, sight: 20, sound: 20 },
+    invisible: { move: 20, light: 0, sight: 0, sound: 0 },
+    window: { move: 20, light: 0, sight: 0, sound: 20 },
+  };
+  const door = preset === 'door' ? 1 : preset === 'secret_door' ? 2 : 0;
+  const stateCode = { closed: 0, open: 1, locked: 2 }[spec.door_state ?? 'closed'];
+
+  return wallSegments(spec, geom, label).map(segment => {
+    const a = squaresToPixels(geom, segment.x1, segment.y1);
+    const b = squaresToPixels(geom, segment.x2, segment.y2);
+    return {
+      c: [a.x, a.y, b.x, b.y],
+      ...restrictions[preset],
+      dir: 0,
+      door,
+      ds: door ? stateCode : 0,
+    };
+  });
+}

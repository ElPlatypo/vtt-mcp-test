+/** combat control: start an encounter, initiative, turns, damage and healing. Foundry is stubbed. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+import { compactCombat, matchCombatants, pickTokens } from './combat-utils.js';
+
+describe('combat utils', () => {
+  const tokens = [
+    { id: 't1', name: 'Goblin 1', actorName: 'Goblin', disposition: -1 },
+    { id: 't2', name: 'Goblin 2', actorName: 'Goblin', disposition: -1 },
+    { id: 't3', name: 'Mira', actorName: 'Mira', disposition: 1, player: true },
+  ];
+  it('picks tokens by group or name', () => {
+    expect(pickTokens(tokens, ['hostile']).picked.map(t => t.id)).toEqual(['t1', 't2']);
+    expect(pickTokens(tokens, ['players']).picked.map(t => t.id)).toEqual(['t3']);
+    expect(pickTokens(tokens, ['npcs']).picked.map(t => t.id)).toEqual(['t1', 't2']);
+    expect(pickTokens(tokens, ['goblin 2']).picked.map(t => t.id)).toEqual(['t2']);
+    expect(pickTokens(tokens, ['Goblin']).picked.map(t => t.id)).toEqual(['t1', 't2']);
+    expect(pickTokens(tokens, ['mir', 'Dragon'])).toMatchObject({ notFound: ['Dragon'] });
+  });
+  it('matches combatants and writes a short readout', () => {
+    const list = [{ id: 'c1', name: 'Goblin 1', actorName: 'Goblin' }, { id: 'c2', name: 'Mira' }];
+    expect(matchCombatants(list, 'goblin 1').map(c => c.id)).toEqual(['c1']);
+    expect(matchCombatants(list, 'gob').map(c => c.id)).toEqual(['c1']);
+    const combat = {
+      started: true,
+      round: 2,
+      turn: 1,
+      turns: [
+        { name: 'Goblin 1', initiative: 18, actor: { system: { attributes: { hp: { value: 3, max: 7 } } }, statuses: new Set(['prone']) } },
+        { name: 'Mira', initiative: 12, defeated: false, actor: { system: { attributes: { hp: { value: 20, max: 20, temp: 4 } } } } },
+        { name: 'Boss', initiative: null, hidden: true },
+      ],
+    };
+    const view = compactCombat(combat)!;
+    expect(view).toMatchObject({ started: true, round: 2, turn: 'Mira' });
+    expect(view.order).toEqual(['18 Goblin 1 hp 3/7 [prone]', '> 12 Mira hp 20/20+4', '-- Boss (hidden)']);
+  });
+  it('derives bloodied from hit points, since the system status lags behind an update', () => {
+    const combat = {
+      started: false,
+      turns: [
+        // Healed to full, but the Bloodied status has not been removed yet.
+        { name: 'Randal', initiative: 7, actor: { system: { attributes: { hp: { value: 20, max: 20 } } }, statuses: new Set(['bloodied']) } },
+        // Just took damage below half; the status has not been added yet, but the system tracks it.
+        { name: 'Ogre', initiative: 5, actor: { system: { attributes: { hp: { value: 10, max: 59 } } }, statuses: new Set(['bloodied', 'prone']) } },
+        { name: 'Goblin', initiative: 3, actor: { system: { attributes: { hp: { value: 0, max: 7 } } }, statuses: new Set(['bloodied']) } },
+      ],
+    };
+    expect(compactCombat(combat)!.order).toEqual([
+      '7 Randal hp 20/20',
+      '5 Ogre hp 10/59 [prone, bloodied]',
+      '3 Goblin hp 0/7',
+    ]);
+  });
+});
+
+function setup(options: { allow?: boolean; applyDamage?: boolean } = {}) {
+  const hp = { g1: { value: 7, max: 7 }, mira: { value: 20, max: 20 } };
+  const actor = (key: 'g1' | 'mira', name: string) => {
+    const a: any = {
+      id: key,
+      name,
+      type: key === 'mira' ? 'character' : 'npc',
+      hasPlayerOwner: key === 'mira',
+      system: { attributes: { hp: hp[key] } },
+      update: vi.fn(async (patch: any) => {
+        hp[key].value = patch['system.attributes.hp.value'];
+      }),
+    };
+    if (options.applyDamage !== false) {
+      a.applyDamage = vi.fn(async (n: number) => {
+        hp[key].value = Math.max(0, Math.min(hp[key].max, hp[key].value - n));
+      });
+    }
+    return a;
+  };
+  const g1 = actor('g1', 'Goblin');
+  const mira = actor('mira', 'Mira');
+  const tokenDocs: any[] = [
+    { id: 't1', name: 'Goblin 1', actorId: 'g1', actor: g1, disposition: -1, hidden: true },
+    { id: 't3', name: 'Mira', actorId: 'mira', actor: mira, disposition: 1, hidden: false },
+  ];
+  const scene: any = { id: 's1', name: 'Cave', tokens: { contents: tokenDocs } };
+  const combatants: any[] = [];
+  const combat: any = {
+    id: 'cb1',
+    started: false,
+    round: 0,
+    turn: null,
+    scene,
+    combatants: { contents: combatants },
+    get turns() {
+      return combatants.slice().sort((a, b) => (b.initiative ?? -1) - (a.initiative ?? -1));
+    },
+    get combatant() {
+      return this.turns[this.turn ?? -1];
+    },
+    createEmbeddedDocuments: vi.fn(async (_type: string, docs: any[]) => {
+      for (const d of docs) {
+        const token = tokenDocs.find(t => t.id === d.tokenId);
+        combatants.push({ id: 'c_' + d.tokenId, name: token.name, tokenId: d.tokenId, actor: token.actor, initiative: null, isNPC: token.actor.type !== 'character', hidden: d.hidden, update: vi.fn(async function (this: any, p: any) { Object.assign(this, p); }) });
+      }
+    }),
+    deleteEmbeddedDocuments: vi.fn(async (_t: string, ids: string[]) => {
+      for (const id of ids) combatants.splice(combatants.findIndex(c => c.id === id), 1);
+    }),
+    rollInitiative: vi.fn(async (ids: string[]) => {
+      ids.forEach((id, i) => (combatants.find(c => c.id === id).initiative = 10 + i * 5));
+    }),
+    setInitiative: vi.fn(async (id: string, v: number) => {
+      combatants.find(c => c.id === id).initiative = v;
+    }),
+    startCombat: vi.fn(async function (this: any) {
+      this.started = true;
+      this.round = 1;
+      this.turn = 0;
+    }),
+    nextTurn: vi.fn(async function (this: any) {
+      this.turn += 1;
+    }),
+    previousTurn: vi.fn(async () => undefined),
+    nextRound: vi.fn(async function (this: any) {
+      this.round += 1;
+      this.turn = 0;
+    }),
+    delete: vi.fn(async () => undefined),
+  };
+  const create = vi.fn(async () => {
+    (globalThis as any).game.combat = combat;
+    return combat;
+  });
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('CONFIG', { Combat: { documentClass: { create } }, queries: {} });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'GM', isGM: true },
+    scenes: { get: (id: string) => (id === 's1' ? scene : undefined), contents: [scene], viewed: scene },
+    settings: { get: (_m: string, key: string) => (key === 'allowWriteOperations' ? true : undefined) },
+    combat: null,
+  });
+  const da = new FoundryDataAccess();
+  (da as any).resolveSceneForObjects = () => scene;
+  if (options.allow === false) (da as any).validateFoundryState = () => undefined;
+  return { da, combat, create, hp, g1, mira };
+}
+
+describe('controlCombat', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('starts an encounter from the scene tokens, rolls initiative and begins', async () => {
+    const { da, combat, create } = setup();
+    const r = await da.controlCombat({ action: 'start' });

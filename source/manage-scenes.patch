+import { describe, expect, it, vi } from 'vitest';
+import { dnd5ePlayState } from './character-state-utils.js';
+
+describe('dnd5ePlayState', () => {
+  it('summarises a fighter: speed, saves, hit dice and feature uses', () => {
+    const actor = {
+      type: 'character',
+      statuses: new Set<string>(),
+      system: {
+        attributes: {
+          prof: 2,
+          init: { total: 2 },
+          movement: { walk: 30, units: 'ft' },
+          senses: { darkvision: 0, units: 'ft' },
+          hp: { value: 12, max: 20 },
+          exhaustion: 0,
+          inspiration: true,
+        },
+        abilities: { str: { mod: 3, save: { value: 5 } }, dex: { mod: 2, save: 2 }, con: { mod: 2, proficient: 1 } },
+        spells: {},
+      },
+      items: [
+        { type: 'class', name: 'Fighter', system: { levels: 2, identifier: 'fighter', hd: { denomination: 'd10', max: 2, spent: 1 } } },
+        { type: 'feat', name: 'Second Wind', system: { uses: { max: 1, spent: 0, recovery: [{ period: 'sr' }] } } },
+        { type: 'feat', name: 'Action Surge', system: { uses: { max: 1, value: 0, per: 'sr' } } },
+        { type: 'weapon', name: 'Longsword', system: {} },
+      ],
+    };
+    expect(dnd5ePlayState(actor)).toEqual({
+      classes: 'Fighter 2',
+      proficiencyBonus: 2,
+      initiative: 2,
+      speed: '30 ft',
+      saves: { str: 5, dex: 2, con: 4 },
+      hitDice: 'd10 1/2',
+      resources: [
+        { name: 'Second Wind', uses: '1/1', recovers: 'sr' },
+        { name: 'Action Surge', uses: '0/1', recovers: 'sr' },
+      ],
+      inspiration: true,
+    });
+  });
+
+  it('adds slots, spell DC, senses, death saves and concentration for a caster', () => {
+    const actor = {
+      type: 'character',
+      statuses: new Set(['concentrating']),
+      system: {
+        attributes: {
+          spellcasting: 'wis',
+          spell: { dc: 13, attack: 5 },
+          movement: { walk: 25, fly: 50, units: 'ft', hover: true },
+          senses: { ranges: { darkvision: 60 }, units: 'ft' },
+          hp: { value: 0, max: 18 },
+          death: { success: 1, failure: 2 },
+        },
+        spells: { spell1: { value: 1, max: 3 }, spell2: { value: 2, max: 2 }, spell3: { value: 0, max: 0 }, pact: { value: 0, max: 0 } },
+      },
+      items: [{ type: 'class', name: 'Cleric', system: { levels: 3, identifier: 'cleric', hd: { denomination: 'd8', value: 3, max: 3 } } }],
+    };
+    expect(dnd5ePlayState(actor)).toMatchObject({
+      speed: 'walk 25, fly 50 ft (hover)',
+      senses: 'darkvision 60 ft',
+      spellcasting: { ability: 'wis', dc: 13, attack: 5 },
+      spellSlots: { 1: '1/3', 2: '2/2' },
+      deathSaves: '1 successes, 2 failures',
+      concentrating: true,
+      hitDice: 'd8 3/3',
+    });
+  });
+
+  it('never reads a deprecated save accessor', () => {
+    const getter = vi.fn(() => ({ value: 99 }));
+    const wis = { mod: 1, proficient: 1 } as Record<string, unknown>;
+    Object.defineProperty(wis, 'save', { enumerable: true, get: getter });
+    const state = dnd5ePlayState({ type: 'npc', system: { attributes: { prof: 2 }, abilities: { wis } }, items: [] });
+    expect(state?.saves).toEqual({ wis: 3 });
+    expect(getter).not.toHaveBeenCalled();
+  });
+
+  it('reports legendary actions for a monster and returns nothing for an empty actor', () => {
+    const dragon = {
+      type: 'npc',
+      system: { attributes: { hp: { value: 0, max: 200 } }, resources: { legact: { value: 2, max: 3 }, legres: { value: 3, max: 3 } } },
+      items: [],
+    };
+    expect(dnd5ePlayState(dragon)).toEqual({ legendary: 'actions 2/3, resistances 3/3' });
+    expect(dnd5ePlayState({})).toBeUndefined();
+  });
+});
diff --git a/packages/foundry-module/src/character-state-utils.ts b/packages/foundry-module/src/character-state-utils.ts
new file mode 100644
index 0000000..8b5d108
--- /dev/null
+++ b/packages/foundry-module/src/character-state-utils.ts
@@ -0,0 +1,198 @@
+/**
+ * What a GM needs to know about a dnd5e creature during play, in a compact form: speed, senses,
+ * saves, spell slots, hit dice, feature uses (Second Wind, Action Surge, Rage, a wand's charges),
+ * death saves, exhaustion, legendary actions. Read from the prepared (live) actor, so derived
+ * values such as remaining uses and save totals are the system's own. Pure: no Foundry globals.
+ */
+
+export interface PlayState {
+  classes?: string;
+  proficiencyBonus?: number;
+  initiative?: number;
+  speed?: string;
+  senses?: string;
+  saves?: Record<string, number>;
+  spellcasting?: { ability?: string; dc?: number; attack?: number };
+  spellSlots?: Record<string, string>;
+  hitDice?: string;
+  resources?: Array<{ name: string; uses: string; recovers?: string }>;
+  deathSaves?: string;
+  exhaustion?: number;
+  inspiration?: boolean;
+  concentrating?: boolean;
+  legendary?: string;
+}
+
+const n = (v: unknown): number | undefined => {
+  const x = typeof v === 'string' && v.trim() !== '' ? Number(v) : v;
+  return typeof x === 'number' && Number.isFinite(x) ? x : undefined;
+};
+
+const valuesOf = (collection: any): any[] => {
+  if (!collection) return [];
+  if (Array.isArray(collection)) return collection;
+  if (Array.isArray(collection.contents)) return collection.contents;
+  if (typeof collection.values === 'function') return [...collection.values()];
+  return Object.values(collection);
+};
+
+const ABILITIES = ['str', 'dex', 'con', 'int', 'wis', 'cha'];
+const MOVES = ['walk', 'fly', 'swim', 'climb', 'burrow'];
+const SENSES = ['darkvision', 'blindsight', 'tremorsense', 'truesight'];
+
+/** "walk 30, fly 60 ft (hover)"; just "30 ft" when only walking. */
+function speedOf(movement: any): string | undefined {
+  if (!movement) return undefined;
+  const units = movement.units || 'ft';
+  const parts = MOVES.map(k => [k, n(movement[k])] as const).filter(([, v]) => v !== undefined && v > 0);
+  if (!parts.length) return undefined;
+  const hover = movement.hover ? ' (hover)' : '';
+  if (parts.length === 1 && parts[0]![0] === 'walk') return `${parts[0]![1]} ${units}${hover}`;
+  return `${parts.map(([k, v]) => `${k} ${v}`).join(', ')} ${units}${hover}`;
+}
+
+function sensesOf(senses: any): string | undefined {
+  if (!senses) return undefined;
+  const ranges = senses.ranges ?? senses;
+  const units = senses.units || ranges.units || 'ft';
+  const parts = SENSES.map(k => [k, n(ranges[k])] as const)
+    .filter(([, v]) => v !== undefined && v > 0)
+    .map(([k, v]) => `${k} ${v} ${units}`);
+  const special = typeof senses.special === 'string' && senses.special.trim() ? senses.special.trim() : '';
+  if (special) parts.push(special);
+  return parts.length ? parts.join(', ') : undefined;
+}
+
+/** Recovery period of an item's uses: dnd5e 4+ has a recovery list, older data a single "per". */
+function recoveryOf(uses: any): string | undefined {
+  const list = Array.isArray(uses?.recovery) ? uses.recovery : [];
+  const periods = list.map((r: any) => r?.period).filter(Boolean);
+  if (periods.length) return [...new Set(periods)].join('/');
+  return typeof uses?.per === 'string' && uses.per ? uses.per : undefined;
+}
+
+export function dnd5ePlayState(actor: any): PlayState | undefined {
+  const system = actor?.system;
+  if (!system) return undefined;
+  const attr = system.attributes ?? {};
+  const out: PlayState = {};
+
+  const classes = valuesOf(actor.items).filter((i: any) => i?.type === 'class');
+  if (classes.length) {
+    out.classes = classes
+      .map((c: any) => {
+        const sub = valuesOf(actor.items).find(
+          (i: any) => i?.type === 'subclass' && i.system?.classIdentifier && i.system.classIdentifier === c.system?.identifier
+        );
+        return `${c.name}${sub ? ` (${sub.name})` : ''} ${n(c.system?.levels) ?? 1}`;
+      })
+      .join(', ');
+  }
+
+  const prof = n(attr.prof);
+  if (prof !== undefined) out.proficiencyBonus = prof;
+  const init = n(attr.init?.total) ?? n(attr.init?.mod);
+  if (init !== undefined) out.initiative = init;
+  const speed = speedOf(attr.movement);
+  if (speed) out.speed = speed;
+  const senses = sensesOf(attr.senses);
+  if (senses) out.senses = senses;
+
+  if (system.abilities) {
+    const saves: Record<string, number> = {};
+    for (const k of ABILITIES) {
+      const a = system.abilities[k];
+      if (!a) continue;
+      // Newer dnd5e keeps ability.save only as a deprecated accessor that warns when read, so it
+      // is read only when it is plain data (older versions: a number, or an object with a value).
+      // Otherwise: modifier plus save proficiency (proficient is the multiplier, 0/1/2).
+      const desc = Object.getOwnPropertyDescriptor(a, 'save');
+      const plain = desc && 'value' in desc ? desc.value : undefined;
+      const fromData = n(plain?.value) ?? n(plain);
+      const mod = n(a.mod);
+      const computed = mod !== undefined ? mod + Math.floor((n(a.proficient) ?? 0) * (prof ?? 0)) : undefined;
+      const save = fromData ?? computed;
+      if (save !== undefined) saves[k] = save;
+    }
+    if (Object.keys(saves).length) out.saves = saves;
+  }
+
+  const spellAbility = typeof attr.spellcasting === 'string' && attr.spellcasting ? attr.spellcasting : undefined;
+  const dc = n(attr.spell?.dc) ?? n(attr.spelldc);
+  const spellAttack = n(attr.spell?.attack);
+  const slots: Record<string, string> = {};
+  for (let level = 1; level <= 9; level++) {
+    const s = system.spells?.[`spell${level}`];
+    const max = n(s?.max);
+    if (max && max > 0) slots[String(level)] = `${n(s.value) ?? 0}/${max}`;
+  }
+  const pact = system.spells?.pact;
+  if (n(pact?.max)) slots.pact = `${n(pact.value) ?? 0}/${n(pact.max)}${n(pact.level) ? ` (level ${n(pact.level)})` : ''}`;
+  if (Object.keys(slots).length) out.spellSlots = slots;
+  // dnd5e gives every actor a spellcasting ability (Intelligence by default), so only a creature
+  // with spell slots or spells of its own is a caster.
+  const hasSpells = valuesOf(actor.items).some((i: any) => i?.type === 'spell');
+  if (Object.keys(slots).length || hasSpells) {
+    out.spellcasting = {
+      ...(spellAbility ? { ability: spellAbility } : {}),
+      ...(dc !== undefined ? { dc } : {}),
+      ...(spellAttack !== undefined ? { attack: spellAttack } : {}),
+    };
+  }
+
+  // Hit dice per class (dnd5e 4+: hd.denomination / hd.value or max - spent), else the actor total.
+  const hd = classes
+    .map((c: any) => {
+      const den = c.system?.hd?.denomination ?? c.system?.hitDice;
+      const max = n(c.system?.hd?.max) ?? n(c.system?.levels);
+      const left = n(c.system?.hd?.value) ?? (max !== undefined ? max - (n(c.system?.hd?.spent) ?? n(c.system?.hitDiceUsed) ?? 0) : undefined);
+      return den && max !== undefined ? `${den} ${left ?? max}/${max}` : undefined;
+    })
+    .filter(Boolean);
+  if (hd.length) out.hitDice = hd.join(', ');
+  else if (n(attr.hd?.max)) out.hitDice = `${n(attr.hd.value) ?? 0}/${n(attr.hd.max)}`;
+  else if (typeof attr.hd === 'number') out.hitDice = String(attr.hd);
+
+  const resources: Array<{ name: string; uses: string; recovers?: string }> = [];
+  for (const item of valuesOf(actor.items)) {
+    if (!item || item.type === 'spell' || item.type === 'class') continue;
+    const uses = item.system?.uses;
+    const max = n(uses?.max);
+    if (!max || max <= 0) continue;
+    // Ordinary consumables (torches, rations, potions) are counted by quantity in the item list;
+    // only charged ones (a wand, a waterskin's drinks) are worth listing here.
+    if (item.type === 'consumable' && (max <= 1 || uses.autoDestroy)) continue;
+    const value = n(uses.value) ?? max - (n(uses.spent) ?? 0);
+    const recovers = recoveryOf(uses);
+    resources.push({ name: item.name, uses: `${value}/${max}`, ...(recovers ? { recovers } : {}) });
+  }
+  // Legacy resource slots on characters (primary, secondary, tertiary)
+  for (const key of ['primary', 'secondary', 'tertiary']) {
+    const r = system.resources?.[key];
+    const max = n(r?.max);
+    if (r?.label && max && max > 0) {
+      resources.push({ name: r.label, uses: `${n(r.value) ?? 0}/${max}`, ...(r.lr ? { recovers: 'lr' } : r.sr ? { recovers: 'sr' } : {}) });
+    }
+  }
+  if (resources.length) out.resources = resources;
+
+  const hp = n(attr.hp?.value);
+  if (actor.type === 'character' && hp !== undefined && hp <= 0) {
+    out.deathSaves = `${n(attr.death?.success) ?? 0} successes, ${n(attr.death?.failure) ?? 0} failures`;
+  }
+  const exhaustion = n(attr.exhaustion);
+  if (exhaustion) out.exhaustion = exhaustion;
+  if (attr.inspiration === true) out.inspiration = true;
+  const statuses = actor.statuses ? [...actor.statuses] : [];
+  if (statuses.includes('concentrating')) out.concentrating = true;
+
+  const legact = system.resources?.legact;
+  const legres = system.resources?.legres;
+  const legendary: string[] = [];
+  if (n(legact?.max)) legendary.push(`actions ${n(legact.value) ?? 0}/${n(legact.max)}`);
+  if (n(legres?.max)) legendary.push(`resistances ${n(legres.value) ?? 0}/${n(legres.max)}`);
+  if (system.resources?.lair?.value) legendary.push('lair actions');
+  if (legendary.length) out.legendary = legendary.join(', ');
+
+  return Object.keys(out).length ? out : undefined;
+}

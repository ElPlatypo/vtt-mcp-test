+import { promises as fs } from 'fs';
+import jpeg from 'jpeg-js';
+import { PNG } from 'pngjs';
+
+export interface DecodedImage {
+  width: number;
+  height: number;
+  /** RGBA pixels */
+  data: Uint8Array;
+}
+
+let cached: { key: string; image: DecodedImage } | null = null;
+
+/** Read a PNG or JPEG file into pixels. The last image is kept, since previews reuse it. */
+export async function decodeImage(file: string): Promise<DecodedImage> {
+  const stat = await fs.stat(file);
+  const key = `${file}:${stat.mtimeMs}:${stat.size}`;
+  if (cached?.key === key) return cached.image;
+
+  const buf = await fs.readFile(file);
+  let image: DecodedImage;
+  if (buf[0] === 0x89 && buf[1] === 0x50) {
+    const png = PNG.sync.read(buf);
+    image = { width: png.width, height: png.height, data: png.data };
+  } else if (buf[0] === 0xff && buf[1] === 0xd8) {
+    const raw = jpeg.decode(buf, { useTArray: true, maxMemoryUsageInMB: 512 });
+    image = { width: raw.width, height: raw.height, data: raw.data };
+  } else {
+    throw new Error('The reference image must be a PNG or JPEG file');
+  }
+  cached = { key, image };
+  return image;
+}

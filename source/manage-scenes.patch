+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+
+export interface CombatToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+const ACTIONS = ['status', 'start', 'add', 'remove', 'roll', 'set_initiative', 'next', 'previous', 'next_round', 'damage', 'heal', 'defeat', 'stabilize', 'death_saves', 'end', 'attack', 'check'] as const;
+
+const schema = z
+  .object({
+    action: z.enum(ACTIONS),
+    scene: z.string().min(1).optional(),
+    who: z.array(z.string().min(1)).max(60).optional(),
+    names: z.array(z.string().min(1)).max(60).optional(),
+    roll: z.enum(['none', 'missing', 'npcs', 'all']).optional(),
+    begin: z.boolean().optional(),
+    initiative: z.array(z.object({ name: z.string().min(1), value: z.number() }).strict()).max(60).optional(),
+    amounts: z.array(z.object({ target: z.string().min(1), amount: z.number().positive() }).strict()).max(60).optional(),
+    defeated: z.boolean().optional(),
+    attacker: z.string().min(1).optional(),
+    item: z.string().min(1).optional(),
+    targets: z.array(z.string().min(1)).max(20).optional(),
+    advantage: z.boolean().optional(),
+    disadvantage: z.boolean().optional(),
+    apply: z.boolean().optional(),
+    skill: z.string().min(1).optional(),
+    ability: z.string().min(1).optional(),
+    save: z.string().min(1).optional(),
+    dc: z.number().min(0).max(40).optional(),
+    public: z.boolean().optional(),
+    consume: z.boolean().optional(),
+    ignore_range: z.boolean().optional(),
+    surprised: z.array(z.string().min(1)).max(60).optional(),
+    success: z.number().int().min(0).max(3).optional(),
+    failure: z.number().int().min(0).max(3).optional(),
+  })
+  .strict();
+
+export class CombatTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: CombatToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'CombatTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'combat',
+        description:
+          'Run the combat tracker (Foundry\'s own, so tracker modules keep working). Every action returns a short readout: round, whose turn, and one line per combatant in order (initiative, name, hp, conditions). ' +
+          'ACTIONS: status; start {scene?, who?, roll?, begin?, surprised?} makes the encounter from tokens on the scene (who = list of: "all" (default), "hostile", "friendly", "neutral", "players", "npcs", or token/actor names; hidden tokens are included), rolls initiative for the ones without one (roll: missing (default) | npcs | all | none) and begins it (begin:false to only set it up); add {who, roll?} adds more tokens mid-fight; remove {names}; roll {names? | roll?} rolls initiative (default for everyone still without one); set_initiative {initiative:[{name, value}]}; next, previous, next_round move the turn (the first next begins the combat); damage / heal {amounts:[{target, amount}]} apply to combatants (or scene tokens) by name, through the system rules (temp HP, resistances are the system\'s job) and report hp before and after; defeat {names, defeated?(true)} marks defeated or not; stabilize {names} makes dying characters stable (3 death save successes, 0 failures); death_saves {names, success?, failure?} sets the death save counts (0 to 3; the sheet shows them; 3 failures mark the character dead and defeated); surprised (on start) lists creatures that get the Surprised status for the first round; a character reduced to 0 hp by damage here becomes unconscious and prone; end ends and deletes the encounter. ATTACK AND CHECK (the dnd5e system does the maths: modifiers, advantage, critical hits, resistances, chat cards): attack {attacker, item?, targets?, advantage?, disadvantage?, apply?(true)} uses an item of the attacker (default its first attack or save): spends its charges or slot, rolls the attack against each target (the target is targeted first, so the roll uses its AC and the card shows hit or miss), rolls damage on a hit (double dice on a crit) and applies it, reporting roll, natural, hit, damage and hp before and after; a save item (a breath weapon) rolls damage once and each target rolls a saving throw against its DC; apply:false rolls without applying. Before rolling, the distance from attacker to each target token is checked against the weapon reach or the range: out of range is refused (ignore_range:true rolls anyway), beyond normal range rolls with disadvantage; the result lists warnings, such as an attack made outside the attacker turn or a target already at 0 hp. check {who:[names], skill | ability | save, dc?, advantage?, disadvantage?} rolls a skill (perception or prc), an ability check or a saving throw (dex or dexterity) for each name and reports totals and success against dc. Rolls are posted to the GM only unless public:true. attacker, targets and who match combatants, then scene tokens, then actors. Names match exactly, else part of a name or the actor name. Needs the Foundry tab open in a browser.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: { type: 'string', enum: [...ACTIONS] },
+            scene: { type: 'string', description: 'start, add, damage, heal: scene id or exact name (default the one being viewed)' },
+            who: { type: 'array', items: { type: 'string' }, description: 'check: names to roll for. start, add: "all", "hostile", "friendly", "neutral", "players", "npcs" or token/actor names' },
+            names: { type: 'array', items: { type: 'string' }, description: 'remove, roll, defeat, stabilize, death_saves: combatant names' },
+            roll: { type: 'string', enum: ['none', 'missing', 'npcs', 'all'], description: 'start, add, roll: who to roll initiative for (default missing)' },
+            begin: { type: 'boolean', description: 'start: begin the combat after setting it up (default true)' },
+            initiative: { type: 'array', items: { type: 'object', properties: { name: { type: 'string' }, value: { type: 'number' } }, required: ['name', 'value'], additionalProperties: false }, description: 'set_initiative: [{name, value}]' },
+            amounts: { type: 'array', items: { type: 'object', properties: { target: { type: 'string' }, amount: { type: 'number' } }, required: ['target', 'amount'], additionalProperties: false }, description: 'damage, heal: [{target, amount}]' },
+            defeated: { type: 'boolean', description: 'defeat: true (default) marks defeated, false revives' },
+            attacker: { type: 'string', description: 'attack: who attacks (combatant, token or actor name)' },
+            item: { type: 'string', description: 'attack: the weapon, spell or feature to use (default the first attack)' },
+            targets: { type: 'array', items: { type: 'string' }, description: 'attack: who is attacked (names)' },
+            advantage: { type: 'boolean', description: 'attack, check: roll with advantage' },
+            disadvantage: { type: 'boolean', description: 'attack, check: roll with disadvantage' },
+            apply: { type: 'boolean', description: 'attack: apply the damage (default true)' },
+            skill: { type: 'string', description: 'check: a skill, e.g. perception or prc' },
+            ability: { type: 'string', description: 'check: an ability check, e.g. dex' },
+            save: { type: 'string', description: 'check: a saving throw, e.g. wis' },
+            dc: { type: 'number', description: 'check: the difficulty; success is reported against it' },
+            consume: { type: 'boolean', description: 'attack: spend the item charges, ammunition or spell slot (default true)' },
+            ignore_range: { type: 'boolean', description: 'attack: roll even when a target is out of range' },
+            surprised: { type: 'array', items: { type: 'string' }, description: 'start: creatures (names) surprised in the first round' },
+            success: { type: 'number', description: 'death_saves: death save successes to set (0 to 3)' },
+            failure: { type: 'number', description: 'death_saves: death save failures to set (0 to 3)' },
+            public: { type: 'boolean', description: 'attack, check: post the rolls for everyone (default: GM only, so hidden monsters are not given away)' },
+          },
+          required: ['action'],
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handleCombat(args: unknown): Promise<any> {
+    const a = schema.parse(args ?? {});
+    this.logger.info('Combat', { action: a.action });
+    const result = await this.foundryClient.query('foundry-mcp-bridge.combat', a);
+    if (result?.success === false) throw new Error(result.error || 'Request was refused');
+    return result;
+  }
+}

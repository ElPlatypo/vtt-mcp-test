+  });
+});
+
+describe('padToSquare', () => {
+  it('centres a picture in a transparent square', () => {
+    const data = new Uint8Array(4 * 2 * 4).fill(255);
+    const out = padToSquare({ width: 4, height: 2, data });
+    expect([out.width, out.height]).toEqual([4, 4]);
+    expect(out.data[3]).toBe(0); // top row transparent
+    expect(out.data[(1 * 4 + 0) * 4 + 3]).toBe(255); // second row is the picture
+    const square = { width: 3, height: 3, data: new Uint8Array(36) };
+    expect(padToSquare(square)).toBe(square);
+  });
+});
+
+describe('definition', () => {

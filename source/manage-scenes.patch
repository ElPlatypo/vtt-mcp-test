+/**
+ * In-game time on Foundry's world calendar (v13+ game.time, extended by dnd5e with sunrise and
+ * sunset): a readable date and time, the part of the day, and how many seconds to the next dawn,
+ * noon, dusk or midnight. Pure: the calendar is passed in.
+ */
+
+export interface CalendarLike {
+  name?: string;
+  months?: { values?: Array<{ name: string; abbreviation?: string; intercalary?: boolean }> };
+  days?: { values?: Array<{ name: string }>; hoursPerDay: number; minutesPerHour: number; secondsPerMinute: number };
+  seasons?: { values?: Array<{ name: string }> };
+  years?: { yearZero?: number };
+  sunrise?: (components?: any) => number;
+  sunset?: (components?: any) => number;
+}
+
+export interface TimeComponents {
+  year: number;
+  day: number;
+  dayOfMonth: number;
+  dayOfWeek: number;
+  hour: number;
+  minute: number;
+  second: number;
+  month: number;
+  season?: number;
+}
+
+export type Localize = (key: string) => string;
+
+const pad = (n: number) => String(Math.floor(n)).padStart(2, '0');
+
+export type DayPart = 'night' | 'dawn' | 'morning' | 'afternoon' | 'dusk' | 'evening';
+
+/** Sunrise and sunset in hours (dnd5e calendars know them; plain calendars get 6 and 18). */
+export function sunTimes(cal: CalendarLike, c: TimeComponents): { sunrise: number; sunset: number } {
+  const hours = cal.days?.hoursPerDay ?? 24;
+  let sunrise = hours * 0.25;
+  let sunset = hours * 0.75;
+  try {
+    if (typeof cal.sunrise === 'function') sunrise = Number(cal.sunrise(c));
+    if (typeof cal.sunset === 'function') sunset = Number(cal.sunset(c));
+  } catch {
+    // keep the defaults
+  }
+  return { sunrise, sunset };
+}
+
+/** The part of the day: an hour around sunrise is dawn, an hour around sunset is dusk. */
+export function dayPart(hourOfDay: number, sunrise: number, sunset: number): DayPart {
+  if (Math.abs(hourOfDay - sunrise) <= 0.5) return 'dawn';
+  if (Math.abs(hourOfDay - sunset) <= 0.5) return 'dusk';
+  if (hourOfDay < sunrise || hourOfDay > sunset + 2) return 'night';
+  if (hourOfDay > sunset) return 'evening';
+  const noon = (sunrise + sunset) / 2;
+  return hourOfDay < noon ? 'morning' : 'afternoon';
+}
+
+const fmtHour = (h: number, minutesPerHour = 60) => {
+  const hour = Math.floor(h);
+  return `${pad(hour)}:${pad(Math.round((h - hour) * minutesPerHour))}`;
+};
+
+/** A readable description of a moment. */
+export function describeTime(cal: CalendarLike, c: TimeComponents, worldTime: number, t: Localize = k => k): Record<string, any> {
+  const month = cal.months?.values?.[c.month];
+  const weekday = cal.days?.values?.[c.dayOfWeek];
+  const season = c.season !== undefined ? cal.seasons?.values?.[c.season] : undefined;
+  const year = c.year + (cal.years?.yearZero ?? 0);
+  const mph = cal.days?.minutesPerHour ?? 60;
+  const sph = (cal.days?.secondsPerMinute ?? 60) * mph;
+  const hourOfDay = c.hour + c.minute / mph + c.second / sph;
+  const { sunrise, sunset } = sunTimes(cal, c);
+  const monthName = month ? t(month.name) : `Month ${c.month + 1}`;
+  return {
+    calendar: cal.name ? t(cal.name) : undefined,
+    date: `${weekday ? `${t(weekday.name)}, ` : ''}${month?.intercalary ? monthName : `${c.dayOfMonth + 1} ${monthName}`}, year ${year}`,
+    time: `${pad(c.hour)}:${pad(c.minute)}`,
+    partOfDay: dayPart(hourOfDay, sunrise, sunset),
+    ...(season ? { season: t(season.name) } : {}),
+    sunrise: fmtHour(sunrise, mph),
+    sunset: fmtHour(sunset, mph),
+    worldTime,
+  };
+}
+
+export type TimeTarget = 'dawn' | 'sunrise' | 'morning' | 'noon' | 'afternoon' | 'dusk' | 'sunset' | 'evening' | 'midnight';
+
+/** Seconds from now to the next occurrence of a time of day (always in the future, at most one day). */
+export function secondsUntil(cal: CalendarLike, c: TimeComponents, target: TimeTarget): number {
+  const hours = cal.days?.hoursPerDay ?? 24;
+  const mph = cal.days?.minutesPerHour ?? 60;
+  const spm = cal.days?.secondsPerMinute ?? 60;
+  const sph = mph * spm;
+  const { sunrise, sunset } = sunTimes(cal, c);
+  const goal: Record<TimeTarget, number> = {
+    dawn: sunrise,
+    sunrise,
+    morning: sunrise + 2,
+    noon: hours / 2,
+    afternoon: hours / 2 + 2,
+    dusk: sunset,
+    sunset,
+    evening: sunset + 2,
+    midnight: 0,
+  };
+  const now = c.hour * sph + c.minute * spm + c.second;
+  let at = Math.round(goal[target] * sph);
+  const dayLength = hours * sph;
+  let diff = at - now;
+  if (diff <= 0) diff += dayLength;
+  at = diff;
+  return at;
+}
+
+/** Duration given in parts, in seconds of this calendar. */
+export function durationSeconds(cal: CalendarLike, d: { seconds?: number; minutes?: number; hours?: number; days?: number; rounds?: number }): number {
+  const spm = cal.days?.secondsPerMinute ?? 60;
+  const mph = cal.days?.minutesPerHour ?? 60;
+  const hpd = cal.days?.hoursPerDay ?? 24;
+  return Math.round((d.seconds ?? 0) + (d.rounds ?? 0) * 6 + (d.minutes ?? 0) * spm + (d.hours ?? 0) * mph * spm + (d.days ?? 0) * hpd * mph * spm);
+}
+
+/** Readable length of a span of seconds ("2 days, 3 hours, 10 minutes"). */
+export function describeDuration(cal: CalendarLike, seconds: number): string {
+  const spm = cal.days?.secondsPerMinute ?? 60;
+  const sph = spm * (cal.days?.minutesPerHour ?? 60);
+  const spd = sph * (cal.days?.hoursPerDay ?? 24);
+  let left = Math.abs(Math.round(seconds));
+  const parts: string[] = [];
+  const take = (size: number, label: string) => {
+    const n = Math.floor(left / size);
+    if (n) parts.push(`${n} ${label}${n === 1 ? '' : 's'}`);
+    left -= n * size;
+  };
+  take(spd, 'day');
+  take(sph, 'hour');
+  take(spm, 'minute');
+  if (left) parts.push(`${left} second${left === 1 ? '' : 's'}`);
+  return parts.join(', ') || '0 seconds';
+}

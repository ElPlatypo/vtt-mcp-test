+    const tools = new TokenManipulationTools({ foundryClient: c.foundryClient, logger });
+    await tools.handleGetTokenDetails({ tokenId: 't', scene: 'Town' }).catch(() => undefined);
+    expect(c.query).toHaveBeenCalledWith('foundry-mcp-bridge.get-token-details', { tokenId: 't', scene: 'Town' });
+  });
+});
diff --git a/packages/mcp-server/src/tools/prop-enclosed.test.ts b/packages/mcp-server/src/tools/prop-enclosed.test.ts

+/**
+ * Drawing for preview-scene: the scene image with a numbered grid and the scene's tokens
+ * and lights on top, so positions can be read in grid squares. Works on any 2D context, so
+ * it can be tested with a recording stub.
+ */
+
+import type { GridGeometry } from './scene-objects-utils.js';
+
+export interface PreviewToken {
+  name: string;
+  /** Top-left corner in grid squares. */
+  x: number;
+  y: number;
+  /** Size in grid squares. */
+  width: number;
+  height: number;
+}
+
+export interface PreviewLight {
+  /** Centre in grid squares. */
+  x: number;
+  y: number;
+  /** Radii in grid squares. */
+  bright: number;
+  dim: number;
+  color?: string | undefined;
+}
+
+export interface PreviewOptions {
+  geom: GridGeometry;
+  /** Output pixels per scene pixel. */
+  scale: number;
+  /** Label every Nth column and row (default 1). */
+  labelEvery: number;
+  tokens: PreviewToken[];
+  lights: PreviewLight[];
+  /** Image to draw behind the grid; omit for a plain grey background. */
+  image?: unknown;
+}
+
+/** Choose the output scale so the longest side is at most maxSize pixels (never upscales). */
+export function previewScale(geom: GridGeometry, maxSize: number): number {
+  const longest = Math.max(geom.sceneWidth, geom.sceneHeight);
+  return Math.min(1, maxSize / longest);
+}
+
+/** Pick a label interval that keeps labels readable: about one label per 40 output pixels. */
+export function defaultLabelEvery(geom: GridGeometry, scale: number): number {
+  const squarePx = geom.size * scale;
+  return Math.max(1, Math.ceil(40 / squarePx));
+}
+
+export function drawPreview(ctx: any, options: PreviewOptions): { width: number; height: number } {
+  const { geom, scale, tokens, lights } = options;
+  const width = Math.round(geom.sceneWidth * scale);
+  const height = Math.round(geom.sceneHeight * scale);
+  const square = geom.size * scale;
+  const every = Math.max(1, Math.floor(options.labelEvery));
+
+  // Background.
+  ctx.fillStyle = '#808080';
+  ctx.fillRect(0, 0, width, height);
+  if (options.image) {
+    ctx.drawImage(options.image, 0, 0, width, height);
+  }
+
+  // Lights (under the grid).
+  for (const light of lights) {
+    const cx = light.x * square;
+    const cy = light.y * square;
+    const color = light.color || '#ffcc33';
+    ctx.lineWidth = 2;
+    ctx.strokeStyle = color;
+    if (light.dim > 0) {
+      ctx.setLineDash([6, 4]);
+      ctx.beginPath();
+      ctx.arc(cx, cy, light.dim * square, 0, Math.PI * 2);
+      ctx.stroke();
+    }
+    ctx.setLineDash([]);
+    if (light.bright > 0) {
+      ctx.beginPath();
+      ctx.arc(cx, cy, light.bright * square, 0, Math.PI * 2);
+      ctx.stroke();
+    }
+    ctx.fillStyle = color;
+    ctx.beginPath();
+    ctx.arc(cx, cy, 4, 0, Math.PI * 2);
+    ctx.fill();
+  }
+
+  // Grid lines: thin every square, stronger every 5.
+  for (let col = 0; col <= geom.columns; col++) {
+    const px = col * square;
+    ctx.strokeStyle = col % 5 === 0 ? 'rgba(255,255,255,0.75)' : 'rgba(255,255,255,0.35)';
+    ctx.lineWidth = col % 5 === 0 ? 1.5 : 0.75;
+    ctx.beginPath();
+    ctx.moveTo(px, 0);
+    ctx.lineTo(px, height);
+    ctx.stroke();
+  }
+  for (let row = 0; row <= geom.rows; row++) {
+    const py = row * square;
+    ctx.strokeStyle = row % 5 === 0 ? 'rgba(255,255,255,0.75)' : 'rgba(255,255,255,0.35)';
+    ctx.lineWidth = row % 5 === 0 ? 1.5 : 0.75;
+    ctx.beginPath();
+    ctx.moveTo(0, py);
+    ctx.lineTo(width, py);
+    ctx.stroke();
+  }
+
+  // Tokens.
+  for (const token of tokens) {
+    const left = token.x * square;
+    const top = token.y * square;
+    const w = token.width * square;
+    const h = token.height * square;
+    ctx.lineWidth = 2;
+    ctx.strokeStyle = '#ff3b30';
+    ctx.fillStyle = 'rgba(255,59,48,0.3)';
+    ctx.beginPath();
+    ctx.arc(left + w / 2, top + h / 2, Math.min(w, h) / 2, 0, Math.PI * 2);
+    ctx.fill();
+    ctx.stroke();
+  }
+
+  // Labels: outlined text so they read on any map.
+  const fontSize = Math.max(9, Math.min(16, Math.round(square * 0.4)));
+  ctx.font = `bold ${fontSize}px sans-serif`;
+  ctx.textAlign = 'center';
+  ctx.textBaseline = 'middle';
+  const label = (text: string, x: number, y: number) => {
+    ctx.lineWidth = 3;
+    ctx.strokeStyle = '#000000';
+    ctx.strokeText(text, x, y);
+    ctx.fillStyle = '#ffffff';
+    ctx.fillText(text, x, y);
+  };
+  for (let col = 0; col < geom.columns; col += every) {
+    const x = (col + 0.5) * square;
+    label(String(col), x, fontSize);
+    label(String(col), x, height - fontSize);
+  }
+  for (let row = 0; row < geom.rows; row += every) {
+    const y = (row + 0.5) * square;
+    label(String(row), fontSize, y);
+    label(String(row), width - fontSize, y);
+  }
+  for (const token of tokens) {
+    label(
+      token.name,
+      (token.x + token.width / 2) * square,
+      (token.y + token.height) * square + fontSize
+    );
+  }
+
+  return { width, height };
+}

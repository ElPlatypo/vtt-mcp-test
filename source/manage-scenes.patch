+import { describe, expect, it } from 'vitest';
+import { auditSnapshot, type AuditActor, type AuditScene, type AuditSnapshot } from './world-audit-utils.js';
+
+const scene = (over: Partial<AuditScene> = {}): AuditScene => ({
+  id: 's1', name: 'Cave', isBackup: false, active: true, navigation: true, hasBackground: true,
+  walls: 10, doors: 1, tokens: 3, tokensWithoutActor: 0, lights: 2, sounds: 0, notes: 0, tiles: 0, regions: 0,
+  musicPlaylist: 'p1', musicPlaylistExists: true, teleports: [], ...over,
+});
+const actor = (over: Partial<AuditActor> = {}): AuditActor => ({ id: 'a1', name: 'Goblin', type: 'npc', hasImage: true, hasPlayerOwner: false, ...over });
+const snap = (scenes: AuditScene[], actors: AuditActor[] = [actor()]): AuditSnapshot => ({
+  scenes,
+  playlists: [{ id: 'p1', name: 'Mix', soundCount: 2 }],
+  actorCount: actors.length,
+  actors,
+});
+const messages = (s: AuditSnapshot) => auditSnapshot(s).findings.map(f => `${f.severity}: ${f.message}`);
+
+describe('extra audit checks', () => {
+  it('says nothing when all is well, and old snapshots without the new fields still work', () => {
+    expect(messages(snap([scene()]))).toEqual([]);
+    expect(auditSnapshot({ scenes: [scene()], playlists: [], actorCount: 1 }).findings).toEqual([]);
+  });
+  it('flags broken pins', () => {
+    const m = messages(snap([scene({ brokenPins: 2 })]));
+    expect(m).toEqual(['warning: 2 map pin(s) point at a journal or page that no longer exists']);
+  });
+  it('flags a dark scene that players cannot see in, but not a lit or global-light one', () => {
+    const dark = { darkness: 0.8, tokenVision: true, globalLight: false, lights: 0 };
+    expect(messages(snap([scene(dark)])).join('|')).toContain('players will see nothing');
+    const sees = (over: Partial<AuditScene>) => messages(snap([scene({ ...dark, ...over })])).some(m => m.includes('players will see nothing'));
+    expect(sees({ lights: 1 })).toBe(false);
+    expect(sees({ globalLight: true })).toBe(false);
+    expect(sees({ tokenVision: false })).toBe(false);
+    expect(sees({ darkness: 0.3 })).toBe(false);
+    expect(sees({})).toBe(true);
+  });
+  it('flags a daylight scene with token vision, no global light and no lights, once it has tokens', () => {
+    const day = { darkness: 0, tokenVision: true, globalLight: false, lights: 0, tokens: 2 };
+    const sees = (over: Partial<AuditScene>) => messages(snap([scene({ ...day, ...over })])).some(m => m.includes('Daylight scene with token vision'));
+    expect(sees({})).toBe(true);
+    expect(sees({ globalLight: true })).toBe(false);
+    expect(sees({ lights: 1 })).toBe(false);
+    expect(sees({ tokenVision: false })).toBe(false);
+    expect(sees({ tokens: 0 })).toBe(false);
+    expect(sees({ darkness: 0.8 })).toBe(false);
+  });
+  it('lists actors with the default image and unowned player characters', () => {
+    const many = Array.from({ length: 8 }, (_, i) => actor({ id: `n${i}`, name: `NPC ${i}`, hasImage: false }));
+    const m = messages(snap([scene()], [...many, actor({ id: 'pc', name: 'Thorin', type: 'character', hasPlayerOwner: false }), actor({ id: 'pc2', name: 'Bilbo', type: 'character', hasPlayerOwner: true })]));
+    expect(m[0]).toContain('8 actor(s) still have the default silhouette: NPC 0, NPC 1, NPC 2, NPC 3, NPC 4, NPC 5, and 2 more');
+    expect(m[1]).toBe('info: 1 player character(s) are not owned by any player: Thorin');
+  });
+});

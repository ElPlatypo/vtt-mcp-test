+  });
+
+  it('lays the shapes over a reference picture', async () => {
+    const t = tools();
+    const ref = path.join(folder, 'ref.png');
+    await fs.mkdir(folder, { recursive: true });
+    // A 40 x 40 red picture: 10 pixels per square.
+    const rgb = new Uint8Array(40 * 40 * 3);
+    for (let i = 0; i < 40 * 40; i++) rgb[i * 3] = 255;

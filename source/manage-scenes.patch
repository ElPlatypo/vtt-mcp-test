+++ b/packages/mcp-server/src/table-bundler.ts
@@ -0,0 +1,264 @@
+/**
+ * Bundles table events (recorded by the Foundry module) into "beats": one message that wakes the
+ * AI GM only when something needs it, carrying everything that happened since the last one.
+ *
+ * - Events marked wake (a player speaking in character or privately to the GM, a monster's turn,
+ *   a door opening) start a bundle; background events (moves, rolls, hp, cards) ride along.
+ * - A bundle is sent once the table has been quiet for a moment (players finishing their lines),
+ *   but never sooner than a minimum gap after the last one, and never later than a maximum wait.
+ * - Rolls the GM asked for are awaited: the bundle comes when everyone named has rolled, or when
+ *   the wait times out (saying who did not roll).
+ * - While muted nothing is sent; events keep collecting and come in one bundle when unmuted.
+ * Pure: time is passed in, so it is easy to test.
+ */
+
+export interface TableEventIn {
+  seq: number;
+  at: number;
+  kind: string;
+  text: string;
+  wake: boolean;
+  user?: string;
+  actor?: string;
+  key?: string;
+  /** the item a roll or card is about */
+  item?: string;
+  /** a roll's kind (attack, damage, save ...) */
+  rollKind?: string;
+  total?: number;
+}
+
+/** How far back a roll still counts for an expectation armed after it came in. */
+const LOOKBACK_MS = 60_000;
+
+export interface BundlerSettings {
+  /** quiet time after the last waking event before the bundle goes (ms) */
+  quietMs: number;
+  /** quiet time when the last waking event was a turn change: monsters act at once (ms) */
+  turnQuietMs: number;
+  /** minimum gap between two bundles (ms) */
+  minIntervalMs: number;
+  /** longest a waking event waits while the table keeps talking (ms) */
+  maxWaitMs: number;
+  /** most background events kept per bundle (the newest are kept) */
+  maxBackground: number;
+}
+
+export const DEFAULT_BUNDLER_SETTINGS: BundlerSettings = {
+  quietMs: 5000,
+  turnQuietMs: 1500,
+  minIntervalMs: 10000,
+  maxWaitMs: 25000,
+  maxBackground: 40,
+};
+
+export interface Expectation {
+  /** names still to roll (player or character names, lower case) */
+  waiting: Set<string>;
+  /** as given, for messages */
+  names: Map<string, string>;
+  deadline: number;
+}
+
+export interface Beat {
+  why: string[];
+  events: string[];
+  /** background events left out because there were too many */
+  dropped?: number;
+}
+
+const lower = (s: string | undefined) => String(s ?? '').trim().toLowerCase();
+
+/**
+ * Shorter beats: an item card ("Randal used Longsword") is dropped when a roll of the same item follows, and an attack
+ * roll takes the damage roll that follows it ("... hit; damage 8").
+ */
+export function foldRolls(events: TableEventIn[]): TableEventIn[] {
+  const same = (a: TableEventIn, b: TableEventIn) => !!a.item && a.item === b.item && lower(a.actor ?? a.user) === lower(b.actor ?? b.user);
+  const drop = new Set<TableEventIn>();
+  const text = new Map<TableEventIn, string>();
+  events.forEach((e, i) => {
+    if (e.kind === 'card' && e.item && events.slice(i + 1).some(r => r.kind === 'roll' && same(e, r))) drop.add(e);
+    if (e.kind === 'roll' && e.rollKind === 'attack') {
+      const damage = events.slice(i + 1).find(r => r.kind === 'roll' && r.rollKind === 'damage' && !drop.has(r) && same(e, r));
+      if (damage && damage.total !== undefined) {
+        drop.add(damage);
+        text.set(e, `${e.text}; damage ${damage.total}`);
+      }
+    }
+  });
+  return events.filter(e => !drop.has(e)).map(e => (text.has(e) ? { ...e, text: text.get(e)! } : e));
+}
+
+export class TableBundler {
+  settings: BundlerSettings;
+  private pending: TableEventIn[] = [];
+  private firstWakeAt: number | undefined;
+  private lastWakeAt: number | undefined;
+  private lastWakeKind: string | undefined;
+  private lastBeatAt = -Infinity;
+  private expectation: Expectation | undefined;
+  private reasons: string[] = [];
+  /** rolls seen lately, kept after their beat went out, for expectations armed after the roll came in */
+  private recentRolls: Array<{ at: number; user: string; actor: string }> = [];
+  muted = false;
+
+  constructor(settings: Partial<BundlerSettings> = {}) {
+    this.settings = { ...DEFAULT_BUNDLER_SETTINGS, ...settings };
+  }
+
+  get pendingCount(): number {
+    return this.pending.length;
+  }
+
+  get hasWake(): boolean {
+    return this.firstWakeAt !== undefined;
+  }
+
+  get awaiting(): string[] | undefined {
+    return this.expectation ? [...this.expectation.waiting].map(k => this.expectation!.names.get(k) ?? k) : undefined;
+  }
+
+  /** Wait for these players or characters to roll; the bundle comes when all have, or at the deadline. */
+  expect(names: string[], now: number, timeoutMs: number, since = now - LOOKBACK_MS): void {
+    const list = names.map(n => n.trim()).filter(Boolean);
+    if (!list.length) return;
+    const exp = this.expectation ?? { waiting: new Set<string>(), names: new Map<string, string>(), deadline: now + timeoutMs };
+    for (const n of list) {
+      exp.waiting.add(lower(n));
+      exp.names.set(lower(n), n);
+    }
+    exp.deadline = Math.max(exp.deadline, now + timeoutMs);
+    this.expectation = exp;
+    // A roll that came in since the request but before this was armed already answers it.
+    for (const roll of this.recentRolls) {
+      if (roll.at < since) continue;
+      for (const k of [roll.user, roll.actor]) if (k && exp.waiting.has(k)) {
+        for (const j of [roll.user, roll.actor]) exp.waiting.delete(j);
+        break;
+      }
+    }
+    if (exp.waiting.size === 0) {
+      this.expectation = undefined;
+      this.markWake('every roll asked for is in', 'rolls', now);
+    }
+  }
+
+  /**
+   * Turn events for a creature that is no longer the one to act (the GM's tools already ran those turns, or the combat
+   * ended) are not worth waking for: drop them. Returns whether anything still waits to be sent as a wake.
+   */
+  dropStaleTurns(currentTurn: string | undefined): boolean {
+    const keep = (e: TableEventIn) => e.kind !== 'turn' || (currentTurn !== undefined && lower(e.actor) === lower(currentTurn));
+    if (this.pending.every(keep)) return this.hasWake;
+    this.pending = this.pending.filter(keep);
+    const wakes = this.pending.filter(e => e.wake);
+    if (wakes.length === 0 && this.reasons.length === 0) {
+      this.firstWakeAt = undefined;
+      this.lastWakeAt = undefined;
+      this.lastWakeKind = undefined;
+    } else {
+      this.lastWakeKind = wakes.length ? wakes[wakes.length - 1]!.kind : this.lastWakeKind;
+    }
+    return this.hasWake;
+  }
+
+  cancelExpectation(): void {
+    this.expectation = undefined;
+  }
+
+  add(events: TableEventIn[], now: number): void {
+    for (const e of events) {
+      this.pending.push(e);
+      if (e.kind === 'roll') {
+        this.recentRolls.push({ at: e.at, user: lower(e.user), actor: lower(e.actor) });
+        if (this.recentRolls.length > 60) this.recentRolls.splice(0, this.recentRolls.length - 60);
+      }
+      if (e.kind === 'roll' && this.expectation) {
+        const hit = [lower(e.user), lower(e.actor)].find(k => k && this.expectation!.waiting.has(k));
+        if (hit) {
+          // one roll answers for both the player and their character
+          for (const k of [lower(e.user), lower(e.actor)]) this.expectation.waiting.delete(k);
+          if (this.expectation.waiting.size === 0) {
+            this.expectation = undefined;
+            this.markWake('every roll asked for is in', 'rolls', now);
+          }
+        }
+      }
+      if (e.wake) this.markWake(undefined, e.kind, now);
+    }
+  }
+
+  private markWake(reason: string | undefined, kind: string, now: number): void {
+    if (reason) this.reasons.push(reason);
+    this.firstWakeAt ??= now;
+    this.lastWakeAt = now;
+    this.lastWakeKind = kind;
+  }
+
+  /** Called on a timer: the awaited rolls time out here. */
+  tick(now: number): void {
+    if (this.expectation && now >= this.expectation.deadline) {
+      const missing = this.awaiting ?? [];
+      this.expectation = undefined;
+      this.markWake(`rolls asked for timed out; not rolled: ${missing.join(', ')}`, 'rolls', now);
+    }
+  }
+
+  /** Whether a bundle should go now. */
+  due(now: number): boolean {
+    if (this.muted || this.firstWakeAt === undefined || this.lastWakeAt === undefined) return false;
+    if (now - this.lastBeatAt < this.settings.minIntervalMs) return false;
+    // While rolls are awaited, hold the bundle (up to the max wait) so they arrive together.
+    const quiet = this.lastWakeKind === 'turn' ? this.settings.turnQuietMs : this.settings.quietMs;
+    const quietEnough = now - this.lastWakeAt >= quiet && !this.expectation;
+    const waitedEnough = now - this.firstWakeAt >= this.settings.maxWaitMs;
+    return quietEnough || waitedEnough;
+  }
+
+  /** Earliest time due() can become true, for scheduling (undefined: nothing to wait for). */
+  nextCheck(now: number): number | undefined {
+    const times: number[] = [];
+    if (this.expectation) times.push(this.expectation.deadline);
+    if (!this.muted && this.firstWakeAt !== undefined && this.lastWakeAt !== undefined) {
+      const quiet = this.lastWakeKind === 'turn' ? this.settings.turnQuietMs : this.settings.quietMs;
+      const earliest = this.lastBeatAt + this.settings.minIntervalMs;
+      times.push(Math.max(earliest, Math.min(this.lastWakeAt + quiet, this.firstWakeAt + this.settings.maxWaitMs)));
+    }
+    return times.length ? Math.max(now, Math.min(...times)) : undefined;
+  }
+
+  /** Force a bundle out of whatever is pending (also with no waking event). */
+  flush(now: number, extraReason?: string): Beat | undefined {
+    if (!this.pending.length && !this.reasons.length && !extraReason) return undefined;
+    const why = [...this.reasons];
+    if (extraReason) why.push(extraReason);
+    const wakeKinds = new Set(this.pending.filter(e => e.wake).map(e => e.kind));
+    const LABEL: Record<string, string> = {
+      say: 'a player spoke in character',
+      emote: 'a player acted (emote)',
+      whisper: 'a player wrote to the GM privately',
+      turn: "a GM-run creature's turn",
+      door: 'a player opened a door',
+    };
+    for (const k of wakeKinds) why.push(LABEL[k] ?? k);
+
+    // Coalesce: events with the same key keep only their last occurrence.
+    const lastByKey = new Map<string, number>();
+    this.pending.forEach((e, i) => e.key && lastByKey.set(e.key, i));
+    const kept = foldRolls(this.pending.filter((e, i) => !e.key || lastByKey.get(e.key) === i));
+    // Keep every waking event; cap the background, newest first.
+    const background = kept.filter(e => !e.wake);
+    const overflow = Math.max(0, background.length - this.settings.maxBackground);
+    const dropSet = new Set(background.slice(0, overflow));
+    const events = kept.filter(e => !dropSet.has(e)).map(e => e.text);
+
+    this.pending = [];
+    this.reasons = [];
+    this.firstWakeAt = undefined;
+    this.lastWakeAt = undefined;
+    this.lastWakeKind = undefined;
+    this.lastBeatAt = now;
+    return { why: [...new Set(why)], events, ...(overflow ? { dropped: overflow } : {}) };
+  }
+}

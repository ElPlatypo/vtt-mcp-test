+      expect(calls.every(c => c.data.action === 'describe')).toBe(true);
+      await expect(tools_noFoundry().handleLayout({ action: 'apply_walls', layout: 'apply three' })).rejects.toThrow('connection');
+    });
+
+    it('sends big layouts in several calls within Foundry limits', async () => {
+      const { tools, calls } = withFoundry({ columns: 60, rows: 60 });
+      await tools.handleLayout({ action: 'new', name: 'Big', columns: 60, rows: 60 });
+      // 200 separate one-square rooms: far more wall objects than one call takes
+      const rooms = [];
+      for (let r = 0; r < 14; r++) for (let c = 0; c < 15; c++) rooms.push({ shape: 'room', at: [c * 4, r * 4], size: [2, 2] });
+      await tools.handleLayout({ action: 'add', layout: 'big', shapes: rooms.slice(0, 200) });
+      await tools.handleLayout({ action: 'apply_walls', layout: 'big', replace: false });
+      const places = calls.filter(c => c.data.action === 'place');
+      expect(places.length).toBeGreaterThan(1);
+      expect(places.every(p => p.data.objects.length <= 150)).toBe(true);
+      expect(places.reduce((n, p) => n + p.data.objects.length, 0)).toBe(200);
+    });
+  });
+
+  it('exposes one tool called layout', () => {
+    expect(tools().getToolDefinitions().map(d => d.name)).toEqual(['layout']);
+  });
+});

index 0000000..050b841
--- /dev/null
+++ b/packages/mcp-server/src/tools/layout-store.test.ts
@@ -0,0 +1,53 @@
+import { afterAll, describe, expect, it } from 'vitest';
+import { promises as fs } from 'fs';
+import os from 'os';
+import path from 'path';
+import { LayoutStore, defaultLayoutsDir } from './layout-doc.js';
+
+const root = path.join(os.tmpdir(), `layout-store-test-${Date.now()}`);
+afterAll(async () => {
+  await fs.rm(root, { recursive: true, force: true });
+});
+
+function doc(id: string, name: string): any {
+  return { id, name, columns: 10, rows: 8, size: 64, background: 'rock', shapes: [] };
+}
+
+describe('LayoutStore', () => {
+  it('copies layouts from the legacy folder once, without overwriting or deleting', async () => {
+    const legacy = path.join(root, 'legacy');
+    const dir = path.join(root, 'new');
+    await fs.mkdir(legacy, { recursive: true });
+    await fs.mkdir(dir, { recursive: true });
+    await fs.writeFile(path.join(legacy, 'cave.layout.json'), JSON.stringify(doc('cave', 'Old Cave')));
+    await fs.writeFile(path.join(legacy, 'town.layout.json'), JSON.stringify(doc('town', 'Legacy Town')));
+    // Already in the new folder: must win over the legacy copy.
+    await fs.writeFile(path.join(dir, 'town.layout.json'), JSON.stringify(doc('town', 'New Town')));
+
+    const store = new LayoutStore(dir, legacy);
+    const list = await store.list();
+    expect(list.map(l => l.name).sort()).toEqual(['New Town', 'Old Cave']);
+    expect((await store.load('cave')).name).toBe('Old Cave');
+    // The legacy files stay where they were.
+    expect(await fs.readdir(legacy)).toEqual(expect.arrayContaining(['cave.layout.json', 'town.layout.json']));
+  });
+
+  it('does not migrate when an explicit folder is given without a legacy folder', async () => {
+    const dir = path.join(root, 'explicit');
+    const store = new LayoutStore(dir);
+    expect(await store.list()).toEqual([]);
+  });
+
+  it('keeps layouts out of the temp folder by default, and honours the override', () => {
+    const before = process.env.FOUNDRY_MCP_LAYOUTS_DIR;
+    try {
+      delete process.env.FOUNDRY_MCP_LAYOUTS_DIR;
+      expect(path.resolve(defaultLayoutsDir()).startsWith(path.resolve(os.tmpdir()))).toBe(false);
+      process.env.FOUNDRY_MCP_LAYOUTS_DIR = path.join(root, 'custom');
+      expect(defaultLayoutsDir()).toBe(path.join(root, 'custom'));
+    } finally {
+      if (before === undefined) delete process.env.FOUNDRY_MCP_LAYOUTS_DIR;
+      else process.env.FOUNDRY_MCP_LAYOUTS_DIR = before;
+    }
+  });
+});

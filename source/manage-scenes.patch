+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+
+export interface FileBackupToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+const browseSchema = z
+  .object({
+    path: z.string().max(300).optional(),
+    source: z.enum(['data', 'public']).optional(),
+    kind: z.enum(['audio', 'image', 'video', 'all']).optional(),
+    extensions: z.array(z.string().min(1).max(10)).max(20).optional(),
+    search: z.string().min(1).max(100).optional(),
+    depth: z.number().int().min(0).max(3).optional(),
+    limit: z.number().int().min(1).max(1000).optional(),
+  })
+  .strict();
+
+const backupSchema = z
+  .object({
+    action: z.enum(['backup', 'list', 'restore', 'delete']),
+    scene: z.string().min(1).optional(),
+    backup: z.string().min(1).optional(),
+    label: z.string().min(1).max(40).optional(),
+    confirm: z.boolean().optional(),
+  })
+  .strict();
+
+export class FileBackupTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: FileBackupToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'FileBackupTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'browse-files',
+        description:
+          'Look at the files on the Foundry server (read only): list the folders and files of a folder, optionally a few levels down, filtered by kind (audio, image, video), extension or text in the path. Uploaded files live on the server, not in a world, so music, maps and tokens put there for another world can be found here and used by their path without uploading them again (playlist sounds, scene backgrounds, token images, tiles). ' +
+          'path is a folder such as "worlds", "worlds/my-world/uploads" or "modules" (empty = the top of the data folder); source data (default) or public (Foundry\'s own files, e.g. sounds and icons); depth 0 to 3 lists subfolders\' contents too (at most 80 folders are read); limit (default 200, up to 1000). Results give each file\'s full path, kind and extension. Needs the Foundry tab open in a browser.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            path: { type: 'string', description: 'Folder to list (default: the top of the data folder)' },
+            source: { type: 'string', enum: ['data', 'public'], description: 'data (default) or public' },
+            kind: { type: 'string', enum: ['audio', 'image', 'video', 'all'], description: 'Only files of this kind' },
+            extensions: { type: 'array', items: { type: 'string' }, description: 'Only these extensions, e.g. ["mp3","ogg"]' },
+            search: { type: 'string', description: 'Only files whose path contains this text' },
+            depth: { type: 'number', description: 'Subfolder levels to look into (0 to 3, default 0)' },
+            limit: { type: 'number', description: 'Most files and folders to return (default 200)' },
+          },
+          additionalProperties: false,
+        },
+      },
+      {
+        name: 'manage-scene-backups',
+        description:
+          'Keep copies of scenes so a rebuild can be undone. backup {scene?, label?} makes a full copy (map, walls, lights, tokens, regions, tiles, pins, sounds, settings) named "<scene> (old <date time> <label>)" in a Backups folder; the copy is not active and not in navigation. list {scene?} shows the backups (all, or of one scene). restore {backup, scene?, confirm} puts a backup\'s contents back into the original scene (or the scene you name), KEEPING the scene\'s id so teleports and links still work; without confirm: true it only shows what would change; with it, a safety copy of the current state ("before restore") is made first, so a restore can itself be undone. delete {backup, confirm} removes a backup (only scenes this tool made as backups can be deleted). Layout files (the layout tool) are not part of a backup. Needs the Foundry tab open in a browser.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: { type: 'string', enum: ['backup', 'list', 'restore', 'delete'] },
+            scene: { type: 'string', description: 'backup: scene id or name (default: the scene being viewed); list: only backups of this scene; restore: scene to restore into (default: the backup\'s original)' },
+            backup: { type: 'string', description: 'restore / delete: id or name of the backup scene' },
+            label: { type: 'string', description: 'backup: a few words added to the name, e.g. "before rebuild"' },
+            confirm: { type: 'boolean', description: 'restore / delete: must be true to do it' },
+          },
+          required: ['action'],
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handleBrowseFiles(args: any): Promise<any> {
+    const parsed = browseSchema.parse(args ?? {});
+    try {
+      const result = await this.foundryClient.query('foundry-mcp-bridge.browse-files', parsed);
+      if (result?.success === false) throw new Error(result.error || 'Request was refused');
+      return result;
+    } catch (error) {
+      this.logger.error('Failed to browse files', error);
+      throw new Error(`Failed to browse files: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  async handleManageSceneBackups(args: any): Promise<any> {
+    const parsed = backupSchema.parse(args ?? {});
+    if ((parsed.action === 'restore' || parsed.action === 'delete') && !parsed.backup) {
+      throw new Error(`${parsed.action} needs backup (list shows them)`);
+    }
+    try {
+      const result = await this.foundryClient.query('foundry-mcp-bridge.manage-scene-backups', parsed);
+      if (result?.success === false) throw new Error(result.error || 'Request was refused');
+      return result;
+    } catch (error) {
+      this.logger.error('Failed to manage scene backups', error);
+      throw new Error(`Failed to manage scene backups: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+}

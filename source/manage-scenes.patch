+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+
+export interface PauseToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+const schema = z.object({ paused: z.boolean().optional() }).strict();
+
+export class PauseTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: PauseToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'PauseTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'pause',
+        description:
+          'Pause or unpause the game for everyone. A paused game stops players from moving or rolling, so unpause before asking a player to act. paused: true pauses, false unpauses; leave it out to just read the current state. Returns the state it is now in. Needs the Foundry GM tab open.',
+        inputSchema: {
+          type: 'object',
+          properties: { paused: { type: 'boolean', description: 'true to pause, false to unpause; omit to only report' } },
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handlePause(args: unknown): Promise<any> {
+    const a = schema.parse(args ?? {});
+    this.logger.info('Pause request', { paused: a.paused });
+    const result = await this.foundryClient.query('foundry-mcp-bridge.pause', a);
+    if (result?.success === false) throw new Error(result.error || 'Request was refused');
+    return result;
+  }
+}

@@ -0,0 +1,265 @@
+/**
+ * Image generation profiles as the settings dialog handles them. The MCP server holds the real
+ * defaults and rules (packages/mcp-server/src/image-profiles.ts); this copy only pre-fills the
+ * dialog and checks what the GM types, so keep the defaults in step with that file.
+ */
+
+export const IMAGE_KINDS = ['map', 'portrait', 'token', 'handout'] as const;
+export type ImageKind = (typeof IMAGE_KINDS)[number];
+
+export const WORKFLOWS = ['checkpoint', 'minimax-h3'] as const;
+export type ImageWorkflow = (typeof WORKFLOWS)[number];
+
+export const WORKFLOW_LABELS: Record<ImageWorkflow, string> = {
+  checkpoint: 'Checkpoint (Stable Diffusion / SDXL)',
+  'minimax-h3': 'MiniMax H3 Image (supports reference pictures)',
+};
+
+export interface ImageProfile {
+  workflow: ImageWorkflow;
+  checkpoint: string;
+  diffusionModel: string;
+  textEncoder: string;
+  vae: string;
+  steps: number;
+  cfg: number;
+  sampler: string;
+  scheduler: string;
+  width: number;
+  height: number;
+  promptPrefix: string;
+  promptSuffix: string;
+  negativePrompt: string;
+}
+
+export type ImageProfiles = Record<ImageKind, ImageProfile>;
+
+export const KIND_INFO: Record<ImageKind, { label: string; help: string }> = {
+  map: {
+    label: 'Maps',
+    help: 'Top-down battlemaps. The default is a battlemap checkpoint.',
+  },
+  portrait: {
+    label: 'Character portraits',
+    help: 'Tall pictures of NPCs and characters, for actor and journal images.',
+  },
+  token: {
+    label: 'Tokens',
+    help: 'Square, centered pictures used as token art.',
+  },
+  handout: {
+    label: 'Handouts and illustrations',
+    help: 'Wide pictures to show players: places, items, scenes.',
+  },
+};
+
+const H3_DEFAULTS = {
+  workflow: 'minimax-h3' as ImageWorkflow,
+  checkpoint: '',
+  diffusionModel: 'minimax_h3_image_pruned_w4a8.safetensors',
+  textEncoder: 'qwen3vl_32b_minimax_h3_int4_convrot.safetensors',
+  vae: 'minimax_h3_image_vae_fp16.safetensors',
+  steps: 6,
+  cfg: 1,
+  sampler: 'euler',
+  scheduler: 'simple',
+  promptPrefix: '',
+  promptSuffix: '',
+  negativePrompt: '',
+};
+
+export const DEFAULT_PROFILES: ImageProfiles = {
+  map: {
+    workflow: 'checkpoint',
+    checkpoint: 'dDBattlemapsSDXL10_upscaleV10.safetensors',
+    diffusionModel: '',
+    textEncoder: '',
+    vae: 'sdxl_vae.safetensors',
+    steps: 30,
+    cfg: 2.5,
+    sampler: 'dpmpp_2m_sde',
+    scheduler: 'karras',
+    width: 1024,
+    height: 1024,
+    promptPrefix: '2d DnD battlemap of ',
+    promptSuffix: ', top-down view, overhead perspective, aerial',
+    negativePrompt:
+      'grid, low angle, isometric, oblique, horizon, text, watermark, logo, caption, people, creatures, monsters, blurry, artifacts',
+  },
+  portrait: { ...H3_DEFAULTS, width: 1664, height: 2432 },
+  token: { ...H3_DEFAULTS, width: 2048, height: 2048 },
+  handout: { ...H3_DEFAULTS, width: 2432, height: 1664 },
+};
+
+/** Samplers and schedulers to offer until the real lists are read from ComfyUI. */
+export const COMMON_SAMPLERS = [
+  'euler',
+  'euler_ancestral',
+  'heun',
+  'dpm_2',
+  'dpmpp_2m',
+  'dpmpp_2m_sde',
+  'dpmpp_sde',
+  'dpmpp_3m_sde',
+  'ddim',
+  'uni_pc',
+];
+export const COMMON_SCHEDULERS = [
+  'normal',
+  'karras',
+  'exponential',
+  'sgm_uniform',
+  'simple',
+  'ddim_uniform',
+  'beta',
+];
+
+export const FIELD_LIMITS = {
+  steps: [1, 100],
+  cfg: [0, 30],
+  side: [256, 6400],
+  text: 1000,
+} as const;
+
+function pick<T>(value: unknown, fallback: T, valid: (v: unknown) => boolean): T {
+  return valid(value) ? (value as T) : fallback;
+}
+
+const isNumber = (v: unknown) => v !== undefined && v !== '' && Number.isFinite(Number(v));
+const isString = (v: unknown) => typeof v === 'string';
+const isName = (v: unknown) => typeof v === 'string' && v !== '';
+
+/**
+ * Saved profiles (the JSON text in the setting) over the defaults.
+ *
+ * Profiles saved before workflows existed have no "workflow" field: a saved map profile stays a
+ * checkpoint profile, the others only held settings for a checkpoint that was never chosen and
+ * take the new defaults (the MCP server applies the same rule).
+ */
+export function profilesFromSetting(raw: unknown): ImageProfiles {
+  let value: unknown = raw;
+  if (typeof raw === 'string') {
+    try {
+      value = JSON.parse(raw);
+    } catch {
+      value = undefined;
+    }
+  }
+  const saved = (value && typeof value === 'object' ? value : {}) as Record<string, any>;
+  const result = {} as ImageProfiles;
+  for (const kind of IMAGE_KINDS) {
+    const d = DEFAULT_PROFILES[kind];
+    const entry = saved[kind] && typeof saved[kind] === 'object' ? saved[kind] : {};
+    const legacy = saved[kind] && typeof saved[kind] === 'object' && entry.workflow === undefined;
+    if (legacy && kind !== 'map') {
+      result[kind] = { ...d };
+      continue;
+    }
+    const s = legacy ? { ...entry, workflow: 'checkpoint' } : entry;
+    result[kind] = {
+      workflow: WORKFLOWS.includes(s.workflow) ? s.workflow : d.workflow,
+      checkpoint: pick(s.checkpoint, d.checkpoint, isString),
+      diffusionModel: pick(s.diffusionModel, d.diffusionModel, isString),
+      textEncoder: pick(s.textEncoder, d.textEncoder, isString),
+      vae: pick(s.vae, d.vae, isString),
+      steps: isNumber(s.steps) ? Number(s.steps) : d.steps,
+      cfg: isNumber(s.cfg) ? Number(s.cfg) : d.cfg,
+      sampler: pick(s.sampler, d.sampler, isName),
+      scheduler: pick(s.scheduler, d.scheduler, isName),
+      width: isNumber(s.width) ? Number(s.width) : d.width,
+      height: isNumber(s.height) ? Number(s.height) : d.height,
+      promptPrefix: pick(s.promptPrefix, d.promptPrefix, isString),
+      promptSuffix: pick(s.promptSuffix, d.promptSuffix, isString),
+      negativePrompt: pick(s.negativePrompt, d.negativePrompt, isString),
+    };
+  }
+  return result;
+}
+
+export type ProfilesFormResult =
+  | { ok: true; value: ImageProfiles }
+  | { ok: false; error: string };
+
+function readNumber(
+  raw: unknown,
+  label: string,
+  [min, max]: readonly [number, number],
+  integer: boolean
+): { ok: true; value: number } | { ok: false; error: string } {
+  const text = typeof raw === 'string' ? raw.trim() : raw;
+  const n = typeof text === 'number' ? text : text === '' || text == null ? NaN : Number(text);
+  if (!Number.isFinite(n) || n < min || n > max || (integer && !Number.isInteger(n))) {
+    return {
+      ok: false,
+      error: `${label} must be ${integer ? 'a whole number' : 'a number'} from ${min} to ${max}`,
+    };
+  }
+  return { ok: true, value: n };
+}
+
+/** Read the dialog's fields (named `<kind>__<field>`) into profiles, or say what is wrong. */
+export function readProfilesForm(data: Record<string, unknown>): ProfilesFormResult {
+  const value = {} as ImageProfiles;
+  for (const kind of IMAGE_KINDS) {
+    const label = KIND_INFO[kind].label;
+    const get = (field: string) => data[`${kind}__${field}`];
+    const str = (field: string): string => {
+      const v = get(field);
+      return typeof v === 'string' ? v : '';
+    };
+
+    const workflow = str('workflow') as ImageWorkflow;
+    if (!WORKFLOWS.includes(workflow)) {
+      return { ok: false, error: `${label}: choose a workflow` };
+    }
+
+    const steps = readNumber(get('steps'), `${label}: steps`, FIELD_LIMITS.steps, true);
+    if (!steps.ok) return steps;
+    const cfg = readNumber(get('cfg'), `${label}: CFG`, FIELD_LIMITS.cfg, false);
+    if (!cfg.ok) return cfg;
+    const width = readNumber(get('width'), `${label}: width`, FIELD_LIMITS.side, true);
+    if (!width.ok) return width;
+    const height = readNumber(get('height'), `${label}: height`, FIELD_LIMITS.side, true);
+    if (!height.ok) return height;
+
+    for (const field of ['promptPrefix', 'promptSuffix', 'negativePrompt']) {
+      if (str(field).length > FIELD_LIMITS.text) {
+        return { ok: false, error: `${label}: ${field} is longer than ${FIELD_LIMITS.text} letters` };
+      }
+    }
+
+    const sampler = str('sampler').trim();
+    const scheduler = str('scheduler').trim();
+    if (!/^[A-Za-z0-9_+.\-]{1,60}$/.test(sampler)) {
+      return { ok: false, error: `${label}: choose a sampler` };
+    }
+    if (!/^[A-Za-z0-9_+.\-]{1,60}$/.test(scheduler)) {
+      return { ok: false, error: `${label}: choose a scheduler` };
+    }
+
+    value[kind] = {
+      workflow,
+      checkpoint: str('checkpoint').trim(),
+      diffusionModel: str('diffusionModel').trim(),
+      textEncoder: str('textEncoder').trim(),
+      vae: str('vae').trim(),
+      steps: steps.value,
+      cfg: cfg.value,
+      sampler,
+      scheduler,
+      width: width.value,
+      height: height.value,
+      promptPrefix: str('promptPrefix'),
+      promptSuffix: str('promptSuffix'),
+      negativePrompt: str('negativePrompt'),
+    };
+  }
+  return { ok: true, value };
+}
+
+/** The choices for a drop-down: what ComfyUI offers, plus the current value if it is not there. */
+export function selectChoices(options: string[], current: string, allowEmpty: boolean): string[] {
+  const list = [...options];
+  if (current && !list.includes(current)) list.unshift(current);
+  return allowEmpty ? ['', ...list] : list;
+}
diff --git a/packages/foundry-module/src/image-settings-dialog.ts b/packages/foundry-module/src/image-settings-dialog.ts
new file mode 100644
index 0000000..31f753f
--- /dev/null
+++ b/packages/foundry-module/src/image-settings-dialog.ts
@@ -0,0 +1,152 @@
+import { MODULE_ID } from './constants.js';
+import {
+  COMMON_SAMPLERS,
+  COMMON_SCHEDULERS,
+  IMAGE_KINDS,
+  KIND_INFO,
+  profilesFromSetting,
+  readProfilesForm,
+  selectChoices,
+} from './image-profiles-utils.js';
+
+interface KnownModels {
+  checkpoints: string[];
+  diffusionModels: string[];
+  textEncoders: string[];
+  vaes: string[];
+  samplers: string[];
+  schedulers: string[];
+}
+
+type ListKind = 'checkpoint' | 'diffusion' | 'textEncoder' | 'vae' | 'sampler' | 'scheduler';
+
+/**
+ * Settings dialog: which model and settings Claude's image generation uses for maps, portraits,
+ * tokens and handouts. The choices come from the ComfyUI the map generation settings point at.
+ */
+export class ImageGenerationDialog extends FormApplication {
+  private models: KnownModels | null = null;
+
+  static get defaultOptions() {
+    return foundry.utils.mergeObject(super.defaultOptions, {
+      title: 'Image Generation Settings',
+      template: `modules/${MODULE_ID}/templates/image-generation-settings.html`,
+      width: 680,
+      height: 'auto',
+      resizable: true,
+      closeOnSubmit: false,
+    } as any);
+  }
+
+  getData(): any {
+    const profiles = profilesFromSetting(game.settings.get(MODULE_ID, 'imageProfiles' as any));
+    return {
+      kinds: IMAGE_KINDS.map((key, index) => ({
+        key,
+        open: index === 0,
+        ...KIND_INFO[key],
+        ...profiles[key],
+        isCheckpoint: profiles[key].workflow === 'checkpoint',
+        isH3: profiles[key].workflow === 'minimax-h3',
+      })),
+    };
+  }
+
+  activateListeners(html: JQuery) {
+    super.activateListeners(html);
+    this.fillSelects(html);
+
+    html.find('#igs-refresh-btn').click(async () => {
+      await this.loadModels(html);
+    });
+
+    // Show only the parts that belong to the chosen workflow.
+    html.find('select[data-role="workflow"]').on('change', (event: any) => {
+      const select = event.currentTarget as HTMLSelectElement;
+      const section = $(select).closest('details');
+      section.find('[data-workflow-group]').each((_index: number, element: HTMLElement) => {
+        element.hidden = element.dataset.workflowGroup !== select.value;
+      });
+    });
+  }
+
+  /** The values to offer in one kind of drop-down. */
+  private optionsFor(kind: ListKind): string[] {
+    switch (kind) {
+      case 'checkpoint':
+        return this.models?.checkpoints ?? [];
+      case 'diffusion':
+        return this.models?.diffusionModels ?? [];
+      case 'textEncoder':
+        return this.models?.textEncoders ?? [];
+      case 'vae':
+        return this.models?.vaes ?? [];
+      case 'sampler':
+        return this.models?.samplers?.length ? this.models.samplers : COMMON_SAMPLERS;
+      case 'scheduler':
+        return this.models?.schedulers?.length ? this.models.schedulers : COMMON_SCHEDULERS;
+    }
+  }
+
+  /** Fill every drop-down from the known models (or sensible defaults), keeping the choice. */
+  private fillSelects(html: JQuery) {
+    const emptyLabels: Partial<Record<ListKind, string>> = {
+      checkpoint: '(choose a checkpoint)',
+      diffusion: '(choose a diffusion model)',
+      textEncoder: '(choose a text encoder)',
+      vae: "(the checkpoint's own VAE)",
+    };
+
+    html.find('select[data-list]').each((_index: number, element: HTMLElement) => {
+      const select = element as HTMLSelectElement;
+      const kind = select.dataset.list as ListKind;
+      const current = select.value || select.dataset.current || '';
+      const emptyLabel = emptyLabels[kind];
+
+      select.innerHTML = '';
+      for (const value of selectChoices(this.optionsFor(kind), current, emptyLabel !== undefined)) {
+        const option = document.createElement('option');
+        option.value = value;
+        option.textContent = value === '' ? (emptyLabel ?? '') : value;
+        select.appendChild(option);
+      }
+      select.value = current;
+    });
+  }
+
+  private async loadModels(html: JQuery) {
+    const status = html.find('#igs-model-status');
+    const bridge = (globalThis as any).foundryMCPBridge;
+    if (!bridge?.comfyuiManager) {
+      status.text('The MCP bridge is not running.');
+      return;
+    }
+
+    status.text('Asking ComfyUI...');
+    try {
+      const response = await bridge.comfyuiManager.listModels();
+      if (response.status !== 'success' || !response.models) {
+        status.text(response.message || 'Could not read the models from ComfyUI.');
+        return;
+      }
+      this.models = response.models as KnownModels;
+      this.fillSelects(html);
+      status.text(
+        `Found ${this.models.checkpoints.length} checkpoint(s), ${this.models.diffusionModels.length} diffusion model(s), ${this.models.textEncoders.length} text encoder(s) and ${this.models.vaes.length} VAE(s).`
+      );
+    } catch (error) {
+      status.text(error instanceof Error ? error.message : 'Could not reach the MCP server.');
+    }
+  }
+
+  async _updateObject(_event: Event, formData: any) {
+    const result = readProfilesForm(formData);
+    if (!result.ok) {
+      ui.notifications?.error(result.error);
+      return; // keep the dialog open so it can be fixed
+    }
+    await game.settings.set(MODULE_ID, 'imageProfiles' as any, JSON.stringify(result.value));
+    ui.notifications?.info('Image generation settings saved');
+    await this.close();
+  }
+}

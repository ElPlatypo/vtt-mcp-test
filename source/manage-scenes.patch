+  it('names the node an engine needs', () => {
+    expect(nodeForEngine('kokoro')).toBe('KokoroGenerator');
+    expect(nodeForEngine('qwen3-design')).toBe('FB_Qwen3TTSVoiceDesign');
+    expect(nodeForEngine('qwen3-fast')).toBeNull();

+});
+
+describe('audio length', () => {
+  it('reads a FLAC header', () => {
+    expect(audioSeconds(flac(24000, 24000 * 13))).toBeCloseTo(13, 3);
+    expect(audioSeconds(flac(44100, 44100 * 2))).toBeCloseTo(2, 3);
+  });
+  it('reads a WAV header', () => {

@@ -0,0 +1,60 @@
+import { describe, expect, it, vi } from 'vitest';
+import { TokenManipulationTools } from './token-manipulation.js';
+
+function makeTools() {
+  const query = vi.fn(async () => ({}));
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  return { tools: new TokenManipulationTools({ foundryClient: { query } as any, logger }), query };
+}
+
+describe('update-token with options', () => {
+  it('sends light and vision options and the scene', async () => {
+    const { tools, query } = makeTools();
+    await tools.handleUpdateToken({ tokenId: 't1', scene: 'Cave', options: { light: { preset: 'torch' }, vision_range: 60 } });
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.update-token', {
+      tokenId: 't1',
+      updates: {},
+      options: { light: { preset: 'torch' }, vision_range: 60 },
+      scene: 'Cave',
+    });
+  });
+  it('still takes plain updates, and needs one of the two', async () => {
+    const { tools, query } = makeTools();
+    await tools.handleUpdateToken({ tokenId: 't1', updates: { hidden: true } });
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.update-token', { tokenId: 't1', updates: { hidden: true } });
+    await expect(tools.handleUpdateToken({ tokenId: 't1' })).rejects.toThrow('updates, options or real_name');
+  });
+  it('describes options and no longer requires updates', () => {
+    const def = makeTools().tools.getToolDefinitions().find(d => d.name === 'update-token')!;
+    expect(def.inputSchema.required).toEqual([]);
+    expect(def.description).toContain('detection_modes');
+  });
+});
+
+describe('update-token real name and bulk display', () => {
+  it('passes a real name to the module', async () => {
+    const { tools, query } = makeTools();
+    await tools.handleUpdateToken({ tokenId: 't1', real_name: 'Yeemik' });
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.update-token', { tokenId: 't1', updates: {}, realName: 'Yeemik' });
+    await tools.handleUpdateToken({ tokenId: 't1', real_name: null });
+    expect(query).toHaveBeenLastCalledWith('foundry-mcp-bridge.update-token', { tokenId: 't1', updates: {}, realName: null });
+  });
+  it('sets display options on every non-player token without a token id', async () => {
+    const { tools, query } = makeTools();
+    query.mockResolvedValue({ success: true, tokensUpdated: 4 });
+    const r = await tools.handleUpdateToken({ apply_to: 'non_players', options: { display_name: 'hover', display_bars: 'owner' }, world_default: true });
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.update-token', { apply_to: 'non_players', options: { display_name: 'hover', display_bars: 'owner' }, world_default: true });
+    expect(r.tokensUpdated).toBe(4);
+    await expect(tools.handleUpdateToken({ apply_to: 'npcs' })).rejects.toThrow('apply_to needs options');
+    await expect(tools.handleUpdateToken({})).rejects.toThrow('tokenId is required');
+  });
+});
+
+describe('update-token schema', () => {
+  it('exposes options and scene to the caller', () => {
+    const def = makeTools().tools.getToolDefinitions().find(d => d.name === 'update-token')!;
+    const props = def.inputSchema.properties as any;
+    expect(props.options.type).toBe('object');
+    expect(props.scene.type).toBe('string');
+  });
+});

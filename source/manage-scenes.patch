+import { describe, expect, it } from 'vitest';
+import {
+  backupName,
+  backupStamp,
+  buildRestorePlan,
+  cleanLabel,
+  readBackupFlag,
+  stripForCreate,
+  summarisePlan,
+} from './scene-backup-utils.js';
+
+const MODULE = 'foundry-mcp-bridge-scenes';
+
+describe('naming', () => {
+  const date = new Date(2026, 10, 12, 9, 5);
+  it('stamps the date and time', () => {
+    expect(backupStamp(date)).toBe('2026-11-12 09:05');
+    expect(backupName('Redbrand Hideout', date)).toBe('Redbrand Hideout (old 2026-11-12 09:05)');
+    expect(backupName('Redbrand Hideout', date, 'before rebuild')).toBe('Redbrand Hideout (old 2026-11-12 09:05 before rebuild)');
+  });
+  it('cleans and limits labels', () => {
+    expect(cleanLabel(undefined)).toBe('');
+    expect(cleanLabel(' a (b) ')).toBe('a b');
+    expect(() => cleanLabel('x'.repeat(41))).toThrow('at most');
+    expect(() => cleanLabel(5)).toThrow('string');
+  });
+});
+
+describe('readBackupFlag', () => {
+  it('reads the flag this module sets, and nothing else', () => {
+    const flags = { [MODULE]: { sceneBackup: { of: 's1', name: 'Cave', at: '2026-11-12T10:00:00Z', label: 'x' } } };
+    expect(readBackupFlag(flags, MODULE)).toEqual({ of: 's1', name: 'Cave', at: '2026-11-12T10:00:00Z', label: 'x' });
+    expect(readBackupFlag({}, MODULE)).toBeNull();
+    expect(readBackupFlag(undefined, MODULE)).toBeNull();
+    expect(readBackupFlag({ other: { sceneBackup: { of: 's1' } } }, MODULE)).toBeNull();
+    expect(readBackupFlag({ [MODULE]: { sceneBackup: { name: 'no id' } } }, MODULE)).toBeNull();
+  });
+});
+
+describe('restore plan', () => {
+  const backup = {
+    _id: 'b1',
+    name: 'Cave (old)',
+    folder: 'f1',
+    width: 2000,
+    height: 1500,
+    grid: { size: 64 },
+    tokenVision: true,
+    tokens: [{ _id: 't1', name: 'Wolf', _stats: { x: 1 }, level: 'defaultLevel0000' }],
+    walls: [{ _id: 'w1', c: [0, 0, 1, 1] }, { _id: 'w2', c: [1, 1, 2, 2] }],
+    regions: [{ _id: 'r1', name: 'Trap', behaviors: [{ _id: 'bh', type: 'pauseGame' }] }],
+  };
+
+  it('copies the scene fields and not ids, names or folders', () => {
+    const plan = buildRestorePlan(backup, {});
+    expect(plan.fields).toEqual({ width: 2000, height: 1500, grid: { size: 64 }, tokenVision: true });
+    expect(plan.fields).not.toHaveProperty('name');
+    expect(plan.fields).not.toHaveProperty('folder');
+  });
+  it('removes what is there and adds the backup documents without ids', () => {
+    const plan = buildRestorePlan(backup, { tokens: 20, walls: 364, lights: 9 });
+    const byName = Object.fromEntries(plan.embedded.map(e => [e.collection, e]));
+    expect(byName.tokens).toMatchObject({ documentName: 'Token', remove: 20 });
+    expect(byName.tokens!.add).toEqual([{ name: 'Wolf', level: 'defaultLevel0000' }]);
+    expect(byName.walls!.add).toEqual([{ c: [0, 0, 1, 1] }, { c: [1, 1, 2, 2] }]);
+    expect(byName.lights).toMatchObject({ remove: 9, add: [] });
+    expect(byName.regions!.add[0]).toMatchObject({ name: 'Trap' });
+    expect(summarisePlan(plan).find(s => s.collection === 'walls')).toEqual({ collection: 'walls', remove: 364, add: 2 });
+  });
+  it('stripForCreate tolerates empty input', () => {
+    expect(stripForCreate({ _id: 'x', a: 1 })).toEqual({ a: 1 });
+    expect(stripForCreate(undefined as any)).toEqual({});
+  });
+});
diff --git a/packages/foundry-module/src/scene-backup-utils.ts b/packages/foundry-module/src/scene-backup-utils.ts

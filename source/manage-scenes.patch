+    expect(data.name).toMatch(/^Cave \(old \d{4}-\d\d-\d\d \d\d:\d\d before rebuild\)$/);
+    expect(data.flags[MODULE].sceneBackup).toMatchObject({ of: 's1', name: 'Cave', label: 'before rebuild' });
+    expect(opts).toEqual({ save: true });
+    expect(r.backup).toMatchObject({ of: 's1', originalName: 'Cave', counts: { tokens: 2, walls: 3, lights: 1 } });
+  });
+
+  it('reuses the Backups folder and refuses to back up a backup', async () => {

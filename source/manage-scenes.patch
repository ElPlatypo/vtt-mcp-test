+import { describe, expect, it } from 'vitest';
+import { buildPrototypeTokenPatch, flattenPatch, prototypeTokenUpdate } from './actor-overrides-utils.js';
+
+const patch = (token: unknown) => buildPrototypeTokenPatch(token, 'token');
+
+describe('vision', () => {
+  it('vision_range turns vision on and sets the range', () => {
+    expect(patch({ vision_range: 60 })).toEqual({ 'sight.range': 60, 'sight.enabled': true });
+    expect(patch({ vision: false, vision_range: 60 })).toEqual({ 'sight.range': 60, 'sight.enabled': false });
+    expect(patch({ vision_range: 0 })).toEqual({ 'sight.range': 0 });
+  });
+  it('sets the vision mode and the full sight object', () => {
+    expect(patch({ vision_mode: 'darkvision' })).toEqual({ 'sight.visionMode': 'darkvision' });
+    expect(patch({ sight: { enabled: true, range: 120, angle: 90, vision_mode: 'basic', brightness: 0.5 } })).toEqual({
+      'sight.enabled': true,
+      'sight.range': 120,
+      'sight.angle': 90,
+      'sight.visionMode': 'basic',
+      'sight.brightness': 0.5,
+    });
+  });
+  it('rejects bad sight values', () => {
+    expect(() => patch({ vision_range: -5 })).toThrow('vision_range');
+    expect(() => patch({ sight: { angle: 400 } })).toThrow('sight angle');
+    expect(() => patch({ sight: { bogus: 1 } })).toThrow('unknown option "bogus"');
+    expect(() => patch({ vision_mode: 'dark vision' })).toThrow('vision_mode');
+  });
+  it('sets detection modes, enabled by default', () => {
+    expect(patch({ detection_modes: [{ id: 'feelTremor', range: 30 }, { id: 'basicSight', enabled: false }] })).toEqual({
+      'detectionModes.feelTremor': { enabled: true, range: 30 },
+      'detectionModes.basicSight': { enabled: false, range: null },
+    });
+    expect(() => patch({ detection_modes: [{ range: 5 }] })).toThrow('needs an id');
+    expect(() => patch({ detection_modes: 'x' })).toThrow('list');
+  });
+});
+
+describe('light', () => {
+  it('uses a preset and lets other fields override it', () => {
+    expect(patch({ light: { preset: 'torch' } })).toMatchObject({
+      'light.bright': 20,
+      'light.dim': 40,
+      'light.color': '#ff9329',
+      'light.animation.type': 'torch',
+    });
+    expect(patch({ light: { preset: 'torch', dim: 60, color: '#00ff00' } })).toMatchObject({
+      'light.bright': 20,
+      'light.dim': 60,
+      'light.color': '#00ff00',
+    });
+    expect(patch({ light: { preset: 'none' } })).toEqual({ 'light.bright': 0, 'light.dim': 0 });
+  });
+  it('takes the single fields and the animation', () => {
+    expect(patch({ light: { bright: 10, dim: 20, alpha: 0.4, angle: 120, animation: { type: 'pulse', speed: 3, intensity: 2, reverse: true } } })).toEqual({
+      'light.bright': 10,
+      'light.dim': 20,
+      'light.alpha': 0.4,
+      'light.angle': 120,
+      'light.animation.type': 'pulse',
+      'light.animation.speed': 3,
+      'light.animation.intensity': 2,
+      'light.animation.reverse': true,
+    });
+    expect(patch({ light: { animation: null } })).toEqual({ 'light.animation.type': null });
+  });
+  it('rejects bad light values', () => {
+    expect(() => patch({ light: { preset: 'sun' } })).toThrow('preset');
+    expect(() => patch({ light: { bright: -1 } })).toThrow('light bright');
+    expect(() => patch({ light: { color: 'red' } })).toThrow('#RRGGBB');
+    expect(() => patch({ light: { glow: 1 } })).toThrow('unknown option "glow"');
+    expect(() => patch({ light: { animation: { type: 'a b' } } })).toThrow('animation type');
+    expect(() => patch({ light: 5 })).toThrow('light must be an object');
+  });
+});
+
+describe('other fields', () => {
+  it('sets lock rotation, alpha and bars', () => {
+    expect(patch({ lock_rotation: true, alpha: 0.5, display_bars: 'always' })).toEqual({
+      lockRotation: true,
+      alpha: 0.5,
+      displayBars: 50,
+    });
+    expect(() => patch({ alpha: 2 })).toThrow('alpha');
+    expect(() => patch({ display_bars: 'x' })).toThrow('display_bars');
+  });
+  it('raw applies any field as dotted keys, last', () => {
+    expect(patch({ raw: { ring: { enabled: true, colors: { ring: '#ff0000' } }, name: 'Bob' } })).toEqual({
+      'ring.enabled': true,
+      'ring.colors.ring': '#ff0000',
+      name: 'Bob',
+    });
+    expect(prototypeTokenUpdate(patch({ vision_range: 30 }))).toEqual({
+      'prototypeToken.sight.range': 30,
+      'prototypeToken.sight.enabled': true,
+    });
+  });
+  it('raw refuses dangerous or malformed input', () => {
+    expect(() => patch({ raw: { __proto__x: 1, 'a.b': 1 } })).toThrow('not allowed');
+    expect(() => patch({ raw: JSON.parse('{"constructor": {"x": 1}}') })).toThrow('not allowed');
+    expect(() => patch({ raw: [] })).toThrow('must be an object');
+    expect(() => flattenPatch({ a: { b: { c: { d: { e: { f: { g: { h: 1 } } } } } } } }, 'raw')).toThrow('too deeply');
+  });
+  it('keeps the older options and rejects unknown ones', () => {
+    expect(patch({ width: 2, disposition: -1, scale: 1.5 })).toEqual({
+      width: 2,
+      disposition: -1,
+      'texture.scaleX': 1.5,
+      'texture.scaleY': 1.5,
+    });
+    expect(() => patch({ glow: 1 })).toThrow('unknown token option "glow"');
+  });
+});

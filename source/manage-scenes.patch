index 0000000..ffd0a9f
--- /dev/null
+++ b/packages/mcp-server/src/tools/layout-utils.ts
@@ -0,0 +1,583 @@
+/**
+ * Layout sketches for map generation: draw rooms, corridors, roads, rivers and doors as flat
+ * colour shapes in grid squares, write a PNG, and optionally derive wall lines from the floor.
+ * Pure TypeScript (no drawing library): a small scanline rasterizer and PNG encoder.
+ */
+
+import zlib from 'zlib';
+
+type RGB = [number, number, number];
+
+/** Flat colours per fill type, and how to describe them to the image model. */
+export const FILLS: Record<string, { color: RGB; colorName: string; meaning: string }> = {
+  floor: { color: [225, 225, 225], colorName: 'light grey', meaning: 'floor' },
+  rock: { color: [20, 20, 20], colorName: 'near-black', meaning: 'solid rock, impassable' },
+  grass: { color: [150, 190, 120], colorName: 'light green', meaning: 'grass' },
+  road: { color: [190, 160, 110], colorName: 'tan', meaning: 'dirt road' },
+  water: { color: [90, 140, 210], colorName: 'blue', meaning: 'water' },
+  building: { color: [120, 70, 50], colorName: 'dark brown', meaning: 'building roof' },
+  stone: { color: [130, 130, 130], colorName: 'mid grey', meaning: 'stonework' },
+  sand: { color: [235, 215, 150], colorName: 'pale yellow', meaning: 'sand' },
+  wood: { color: [170, 120, 30], colorName: 'amber', meaning: 'wooden planks' },
+  door: { color: [230, 120, 20], colorName: 'orange', meaning: 'door' },
+};
+
+export const SHAPE_KINDS = ['rect', 'ellipse', 'polygon', 'path', 'cells', 'door'] as const;
+export const MAX_SHAPES = 300;
+export const MAX_PIXELS = 4096 * 4096;
+
+export interface LayoutShape {
+  shape: (typeof SHAPE_KINDS)[number];
+  fill?: string;
+  color?: string;
+  rect?: number[];
+  ellipse?: number[];
+  polygon?: number[][];
+  path?: number[][];
+  /** cells: squares to paint, each [column, row] or a run [column, row, width, height]. */
+  cells?: number[][];
+  /** Rotation in degrees (clockwise) about the shape's centre. Not for doors. */
+  rotate?: number;
+  /** Snap this shape's coordinates to a multiple of this many squares (0 = free). */
+  snap?: number;
+  /** Number shown on the preview picture (default the shape id). */
+  label?: number;
+  /** Id in a layout document. */
+  id?: number;
+  /** path: width in squares (default 2). */
+  width?: number;
+  /** door: start point of the door on a wall line, in squares. */
+  at?: number[];
+  /** door: h runs along x, v runs along y. */
+  dir?: 'h' | 'v';
+  /** door: length in squares (default 1). */
+  size?: number;
+  /** door: secret door. */
+  secret?: boolean;
+  /** door: closed (default), open or locked. */
+  state?: 'closed' | 'open' | 'locked';
+  name?: string;
+}
+
+export interface LayoutSpec {
+  columns: number;
+  rows: number;
+  /** Snap shape coordinates to this many squares (default 0 = free). */
+  snap?: number;
+  grid_size?: number;
+  background?: string;
+  shapes: LayoutShape[];
+  wall_fills?: string[];
+}
+
+export interface NormalizedLayout {
+  columns: number;
+  rows: number;
+  size: number;
+  background: string;
+  shapes: LayoutShape[];
+  wallFills: string[];
+}
+
+const HEX = /^#[0-9a-fA-F]{6}$/;
+
+function num(v: unknown): v is number {
+  return typeof v === 'number' && Number.isFinite(v);
+}
+
+function nums(v: unknown, count: number, label: string, what: string): number[] {
+  if (!Array.isArray(v) || v.length !== count || !v.every(num)) {
+    throw new Error(`${label}: ${what} must be ${count} numbers`);
+  }
+  return v as number[];
+}
+
+function points(v: unknown, min: number, label: string): number[][] {
+  if (!Array.isArray(v) || v.length < min || v.length > 500) {
+    throw new Error(`${label}: needs ${min} to 500 points [[x, y], ...]`);
+  }
+  return v.map((p, i) => nums(p, 2, `${label}[${i}]`, 'a point [x, y]'));
+}
+
+export function colorFor(shape: { fill?: string; color?: string }): RGB {
+  if (shape.color) {
+    const n = parseInt(shape.color.slice(1), 16);
+    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
+  }
+  return FILLS[shape.fill ?? 'floor']!.color;
+}
+
+function snapTo(v: number, snap: number): number {
+  return snap > 0 ? Math.round(v / snap) * snap : v;
+}
+
+const round4 = (v: number) => Math.round(v * 10000) / 10000;
+
+/**
+ * Check one shape, accept the friendly forms (room/at+size, center+radius), snap its coordinates
+ * to the grid and return the canonical shape. Throws a readable error.
+ */
+export function normalizeShape(raw: any, label: string, layoutSnap: number): LayoutShape {
+  if (!raw || typeof raw !== 'object') throw new Error(`${label}: must be an object`);
+  const s: any = { ...raw };
+  if (s.shape === 'room') s.shape = 'rect';
+  if (!(SHAPE_KINDS as readonly string[]).includes(s.shape)) {
+    throw new Error(`${label}: shape must be one of room, ${SHAPE_KINDS.join(', ')}`);
+  }
+  if (s.color !== undefined && !HEX.test(s.color)) throw new Error(`${label}: color must look like #RRGGBB`);
+  if (s.fill !== undefined && !FILLS[s.fill]) {
+    throw new Error(`${label}: fill must be one of ${Object.keys(FILLS).join(', ')}`);
+  }
+  if (s.snap !== undefined && (!num(s.snap) || s.snap < 0 || s.snap > 5)) {
+    throw new Error(`${label}: snap must be a number from 0 to 5`);
+  }
+  if (s.rotate !== undefined && !num(s.rotate)) throw new Error(`${label}: rotate must be degrees`);
+  if (s.label !== undefined && !Number.isInteger(s.label)) throw new Error(`${label}: label must be a whole number`);
+  const snap = s.snap ?? layoutSnap;
+  const sn = (v: number) => round4(snapTo(v, snap));
+
+  if (s.shape === 'door') {
+    s.fill = 'door';
+    // accept at:[x,y] with dir and size
+    const at = nums(s.at, 2, label, 'at [x, y]');
+    if (s.dir !== 'h' && s.dir !== 'v') throw new Error(`${label}: dir must be "h" or "v"`);
+    if (s.size !== undefined && (!num(s.size) || s.size <= 0 || s.size > 20)) {
+      throw new Error(`${label}: size must be a number of squares from 0 to 20`);
+    }
+    if (s.state !== undefined && !['closed', 'open', 'locked'].includes(s.state)) {
+      throw new Error(`${label}: state must be closed, open or locked`);
+    }
+    s.at = [round4(snapTo(at[0]!, 0.25)), round4(snapTo(at[1]!, 0.25))];
+    delete s.rotate;
+    return s as LayoutShape;
+  }
+
+  s.fill = s.fill ?? 'floor';
+  if (s.shape === 'rect') {
+    if (s.at !== undefined || s.size !== undefined) {
+      const at = nums(s.at, 2, label, 'at [column, row]');
+      const size = nums(s.size, 2, label, 'size [width, height]');
+      s.rect = [at[0], at[1], size[0], size[1]];
+      delete s.at;
+      delete s.size;
+    }
+    const [x, y, w, h] = nums(s.rect, 4, label, 'rect [x, y, width, height]') as [number, number, number, number];
+    if (w <= 0 || h <= 0) throw new Error(`${label}: rect width and height must be above 0`);
+    const minSide = snap > 0 ? snap : 0;
+    s.rect = [sn(x), sn(y), Math.max(sn(w), minSide), Math.max(sn(h), minSide)];
+  } else if (s.shape === 'ellipse') {
+    if (s.center !== undefined || s.radius !== undefined) {
+      const c = nums(s.center, 2, label, 'center [x, y]');
+      const r = nums(s.radius, 2, label, 'radius [rx, ry]');
+      s.ellipse = [c[0], c[1], r[0], r[1]];
+      delete s.center;
+      delete s.radius;
+    }
+    const [cx, cy, rx, ry] = nums(s.ellipse, 4, label, 'ellipse [centreX, centreY, radiusX, radiusY]') as [
+      number,
+      number,
+      number,
+      number,
+    ];
+    if (rx <= 0 || ry <= 0) throw new Error(`${label}: ellipse radii must be above 0`);
+    const minR = snap > 0 ? snap / 2 : 0;
+    s.ellipse = [sn(cx), sn(cy), Math.max(round4(snapTo(rx, snap > 0 ? snap / 2 : 0)), minR), Math.max(round4(snapTo(ry, snap > 0 ? snap / 2 : 0)), minR)];
+  } else if (s.shape === 'polygon') {
+    s.polygon = points(s.polygon, 3, `${label} polygon`).map(p => [sn(p[0]!), sn(p[1]!)]);
+  } else if (s.shape === 'path') {
+    s.path = points(s.path, 2, `${label} path`).map(p => [sn(p[0]!), sn(p[1]!)]);
+    if (s.width !== undefined && (!num(s.width) || s.width <= 0 || s.width > 50)) {
+      throw new Error(`${label}: width must be a number of squares from 0 to 50`);
+    }
+  } else {
+    if (!Array.isArray(s.cells) || s.cells.length === 0 || s.cells.length > 2000) {
+      throw new Error(`${label}: cells must be a list of 1 to 2000 squares [column, row] or runs [column, row, width, height]`);
+    }
+    s.cells = s.cells.map((c: unknown, i: number) => {
+      if (!Array.isArray(c) || (c.length !== 2 && c.length !== 4) || !c.every(Number.isInteger)) {
+        throw new Error(`${label} cells[${i}]: needs whole numbers [column, row] or [column, row, width, height]`);
+      }
+      if (c.length === 4 && (c[2] < 1 || c[3] < 1)) throw new Error(`${label} cells[${i}]: width and height must be at least 1`);
+      return c.length === 2 ? [c[0], c[1], 1, 1] : c;
+    });
+  }
+  const given = ['rect', 'ellipse', 'polygon', 'path', 'cells'].filter(k => s[k] !== undefined);
+  if (given.length !== 1 || given[0] !== s.shape) {
+    throw new Error(`${label}: a ${s.shape} needs exactly its own ${s.shape} field`);
+  }
+  return s as LayoutShape;
+}
+
+/** Check a layout request and fill in defaults. Throws a readable error. */
+export function normalizeLayout(spec: LayoutSpec): NormalizedLayout {
+  const intIn = (v: unknown, min: number, max: number, name: string): number => {
+    if (!Number.isInteger(v) || (v as number) < min || (v as number) > max) {
+      throw new Error(`${name} must be a whole number from ${min} to ${max}`);
+    }
+    return v as number;
+  };
+  const columns = intIn(spec.columns, 4, 200, 'columns');
+  const rows = intIn(spec.rows, 4, 200, 'rows');
+  const size = spec.grid_size === undefined ? 64 : intIn(spec.grid_size, 8, 256, 'grid_size');
+  if (columns * size * rows * size > MAX_PIXELS) {
+    throw new Error('The picture would be larger than 4096 x 4096 pixels; lower grid_size or the map size');
+  }
+  const background = spec.background ?? 'rock';
+  if (!FILLS[background]) throw new Error(`background must be one of ${Object.keys(FILLS).join(', ')}`);
+  const wallFills = spec.wall_fills ?? ['floor'];
+  for (const f of wallFills) {
+    if (!FILLS[f]) throw new Error(`wall_fills: unknown fill "${f}"`);
+  }
+  if (!Array.isArray(spec.shapes) || spec.shapes.length === 0 || spec.shapes.length > MAX_SHAPES) {
+    throw new Error(`shapes must be a list of 1 to ${MAX_SHAPES}`);
+  }
+
+  const layoutSnap = spec.snap === undefined ? 0 : spec.snap;
+  if (!num(layoutSnap) || layoutSnap < 0 || layoutSnap > 5) throw new Error('snap must be a number from 0 to 5');
+  const shapes = spec.shapes.map((raw, i) => normalizeShape(raw, `shapes[${i}]`, layoutSnap));
+
+  return { columns, rows, size, background, shapes, wallFills };
+}
+
+// ===== Rasterizer =====
+
+type Poly = Array<[number, number]>;
+
+/** The polygons, in squares, that make up a drawn shape (before rotation). */
+function basePolygons(shape: LayoutShape): Poly[] {
+  if (shape.shape === 'rect') {
+    const [x, y, w, h] = shape.rect!;
+    return [[[x!, y!], [x! + w!, y!], [x! + w!, y! + h!], [x!, y! + h!]]];
+  }
+  if (shape.shape === 'cells') {
+    return shape.cells!.map(([c, r, w, h]) => [
+      [c!, r!],
+      [c! + w!, r!],
+      [c! + w!, r! + h!],
+      [c!, r! + h!],
+    ] as Poly);
+  }
+  if (shape.shape === 'ellipse') {
+    const [cx, cy, rx, ry] = shape.ellipse!;
+    const n = Math.max(48, Math.min(256, Math.ceil(Math.max(rx!, ry!) * 8)));
+    const poly: Poly = [];
+    for (let i = 0; i < n; i++) {
+      const a = (i / n) * Math.PI * 2;
+      poly.push([cx! + Math.cos(a) * rx!, cy! + Math.sin(a) * ry!]);
+    }
+    return [poly];
+  }
+  if (shape.shape === 'polygon') {
+    return [shape.polygon!.map(p => [p[0]!, p[1]!] as [number, number])];
+  }
+  if (shape.shape === 'path') {
+    const half = (shape.width ?? 2) / 2;
+    const pts = shape.path!.map(p => [p[0]!, p[1]!] as [number, number]);
+    const polys: Poly[] = [];
+    for (let i = 0; i + 1 < pts.length; i++) {
+      const [x1, y1] = pts[i]!;
+      const [x2, y2] = pts[i + 1]!;
+      const len = Math.hypot(x2 - x1, y2 - y1);
+      if (len === 0) continue;
+      const nx = ((y2 - y1) / len) * half;
+      const ny = (-(x2 - x1) / len) * half;
+      polys.push([[x1 + nx, y1 + ny], [x2 + nx, y2 + ny], [x2 - nx, y2 - ny], [x1 - nx, y1 - ny]]);
+    }
+    // Flat ends; round joins only where the path bends.
+    for (const [x, y] of pts.slice(1, -1)) {
+      const n = Math.max(16, Math.min(64, Math.ceil(half * 8)));
+      const c: Poly = [];
+      for (let i = 0; i < n; i++) {
+        const a = (i / n) * Math.PI * 2;
+        c.push([x + Math.cos(a) * half, y + Math.sin(a) * half]);
+      }
+      polys.push(c);
+    }
+    return polys;
+  }
+  // door: a thin bar centred on the wall line
+  const [x, y] = shape.at as [number, number];
+  const len = shape.size ?? 1;
+  const t = 0.2;
+  return shape.dir === 'h'
+    ? [[[x, y - t], [x + len, y - t], [x + len, y + t], [x, y + t]]]
+    : [[[x - t, y], [x + t, y], [x + t, y + len], [x - t, y + len]]];
+}
+
+/** The middle of a shape's bounding box, in squares (the point it rotates about). */
+export function shapeCentre(shape: LayoutShape): [number, number] {
+  let minX = Infinity;
+  let minY = Infinity;
+  let maxX = -Infinity;
+  let maxY = -Infinity;
+  for (const poly of basePolygons(shape)) {
+    for (const [x, y] of poly) {
+      minX = Math.min(minX, x);
+      maxX = Math.max(maxX, x);
+      minY = Math.min(minY, y);
+      maxY = Math.max(maxY, y);
+    }
+  }
+  return [(minX + maxX) / 2, (minY + maxY) / 2];
+}
+
+/** The polygons (in pixels at `scale` pixels per square) that make up a drawn shape. */
+export function shapePolygons(shape: LayoutShape, scale: number): Poly[] {
+  let polys = basePolygons(shape);
+  if (shape.rotate && shape.shape !== 'door') {
+    const [cx, cy] = shapeCentre(shape);
+    const a = (shape.rotate * Math.PI) / 180;
+    const cos = Math.cos(a);
+    const sin = Math.sin(a);
+    polys = polys.map(poly =>
+      poly.map(([x, y]) => [cx + (x - cx) * cos - (y - cy) * sin, cy + (x - cx) * sin + (y - cy) * cos] as [number, number])
+    );
+  }
+  return polys.map(poly => poly.map(([x, y]) => [x * scale, y * scale] as [number, number]));
+}
+
+/** Call fill(y, xStart, xEnd) for every pixel span inside the polygon (even-odd, pixel centres). */
+export function scanPolygon(poly: Poly, width: number, height: number, fill: (y: number, x0: number, x1: number) => void) {
+  let minY = Infinity;
+  let maxY = -Infinity;
+  for (const [, y] of poly) {
+    minY = Math.min(minY, y);
+    maxY = Math.max(maxY, y);
+  }
+  const yStart = Math.max(0, Math.ceil(minY - 0.5));
+  const yEnd = Math.min(height - 1, Math.floor(maxY - 0.5));
+  for (let y = yStart; y <= yEnd; y++) {
+    const cy = y + 0.5;
+    const xs: number[] = [];
+    for (let i = 0; i < poly.length; i++) {
+      const [x1, y1] = poly[i]!;
+      const [x2, y2] = poly[(i + 1) % poly.length]!;
+      if ((y1 <= cy && y2 > cy) || (y2 <= cy && y1 > cy)) {
+        xs.push(x1 + ((cy - y1) / (y2 - y1)) * (x2 - x1));
+      }
+    }
+    xs.sort((a, b) => a - b);
+    for (let i = 0; i + 1 < xs.length; i += 2) {
+      const x0 = Math.max(0, Math.ceil(xs[i]! - 0.5));
+      const x1 = Math.min(width - 1, Math.floor(xs[i + 1]! - 0.5));
+      if (x1 >= x0) fill(y, x0, x1);
+    }
+  }
+}
+
+/** Render the layout as RGB pixels. */
+export function renderLayout(layout: NormalizedLayout): { width: number; height: number; rgb: Uint8Array } {
+  const width = layout.columns * layout.size;
+  const height = layout.rows * layout.size;
+  const rgb = new Uint8Array(width * height * 3);
+  const bg = colorFor({ fill: layout.background });
+  for (let i = 0; i < width * height; i++) {
+    rgb[i * 3] = bg[0];
+    rgb[i * 3 + 1] = bg[1];
+    rgb[i * 3 + 2] = bg[2];
+  }
+  for (const shape of layout.shapes) {
+    const [r, g, b] = colorFor(shape);
+    for (const poly of shapePolygons(shape, layout.size)) {
+      scanPolygon(poly, width, height, (y, x0, x1) => {
+        let o = (y * width + x0) * 3;
+        for (let x = x0; x <= x1; x++) {
+          rgb[o++] = r;
+          rgb[o++] = g;
+          rgb[o++] = b;
+        }
+      });
+    }
+  }
+  return { width, height, rgb };
+}
+
+// ===== PNG =====
+
+const CRC_TABLE = (() => {
+  const table = new Uint32Array(256);
+  for (let n = 0; n < 256; n++) {
+    let c = n;
+    for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
+    table[n] = c >>> 0;
+  }
+  return table;
+})();
+
+function crc32(buf: Buffer): number {
+  let c = 0xffffffff;
+  for (let i = 0; i < buf.length; i++) c = CRC_TABLE[(c ^ buf[i]!) & 255]! ^ (c >>> 8);
+  return (c ^ 0xffffffff) >>> 0;
+}
+
+function chunk(type: string, data: Buffer): Buffer {
+  const out = Buffer.alloc(12 + data.length);
+  out.writeUInt32BE(data.length, 0);
+  out.write(type, 4, 'ascii');
+  data.copy(out, 8);
+  out.writeUInt32BE(crc32(out.subarray(4, 8 + data.length)), 8 + data.length);
+  return out;
+}
+
+export function encodePng(width: number, height: number, rgb: Uint8Array): Buffer {
+  const stride = width * 3;
+  const raw = Buffer.alloc((stride + 1) * height);
+  for (let y = 0; y < height; y++) {
+    raw[y * (stride + 1)] = 0;
+    Buffer.from(rgb.buffer, rgb.byteOffset + y * stride, stride).copy(raw, y * (stride + 1) + 1);
+  }
+  const header = Buffer.alloc(13);
+  header.writeUInt32BE(width, 0);
+  header.writeUInt32BE(height, 4);
+  header[8] = 8; // bit depth
+  header[9] = 2; // RGB
+  return Buffer.concat([
+    Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]),
+    chunk('IHDR', header),
+    chunk('IDAT', zlib.deflateSync(raw, { level: 6 })),
+    chunk('IEND', Buffer.alloc(0)),
+  ]);
+}
+
+// ===== Walls from the floor =====
+
+export interface WallObject {
+  kind: 'wall';
+  points: number[][];
+  closed?: boolean;
+  preset?: 'door' | 'secret_door';
+  door_state?: 'closed' | 'open' | 'locked';
+}
+
+const CELL = 2; // wall resolution: half a square
+
+/**
+ * Wall chains around the areas drawn with the wall fills (floors by default), at half-square
+ * resolution, ready for manage-scene-objects. Doors drawn in the layout become door walls and
+ * cut the wall where they sit.
+ */
+export function wallsFromLayout(layout: NormalizedLayout): { walls: WallObject[]; segments: number } {
+  const w = layout.columns * CELL;
+  const h = layout.rows * CELL;
+  const inside = new Uint8Array(w * h);
+  const isWall = new Set(layout.wallFills);
+  if (isWall.has(layout.background)) inside.fill(1);
+  for (const shape of layout.shapes) {
+    if (shape.shape === 'door') continue;
+    const value = isWall.has(shape.fill ?? 'floor') ? 1 : 0;
+    for (const poly of shapePolygons(shape, CELL)) {
+      scanPolygon(poly, w, h, (y, x0, x1) => inside.fill(value, y * w + x0, y * w + x1 + 1));
+    }
+  }
+
+  // Unit edges on cell boundaries: horizontal key "h,x,y" (from x to x+1 on line y), vertical "v,x,y".
+  const edges = new Set<string>();
+  const at = (x: number, y: number) => (x < 0 || y < 0 || x >= w || y >= h ? 0 : inside[y * w + x]!);
+  for (let y = 0; y < h; y++) {
+    for (let x = 0; x < w; x++) {
+      if (!inside[y * w + x]) continue;
+      if (!at(x, y - 1)) edges.add(`h,${x},${y}`);
+      if (!at(x, y + 1)) edges.add(`h,${x},${y + 1}`);
+      if (!at(x - 1, y)) edges.add(`v,${x},${y}`);
+      if (!at(x + 1, y)) edges.add(`v,${x + 1},${y}`);
+    }
+  }
+
+  // Doors cut the wall where they sit.
+  const doors: WallObject[] = [];
+  for (const s of layout.shapes) {
+    if (s.shape !== 'door') continue;
+    const [x, y] = s.at as [number, number];
+    const len = s.size ?? 1;
+    const steps = Math.max(1, Math.round(len * CELL));
+    // Cut every wall face within half a square of the door line, so a door in a thin wall
+    // between two rooms opens both faces of it.
+    const line = (s.dir === 'h' ? y : x) * CELL;
+    for (let i = 0; i < steps; i++) {
+      for (let l = Math.ceil(line - 1); l <= Math.floor(line + 1); l++) {
+        if (s.dir === 'h') edges.delete(`h,${Math.round(x * CELL) + i},${l}`);
+        else edges.delete(`v,${l},${Math.round(y * CELL) + i}`);
+      }
+    }
+    doors.push({
+      kind: 'wall',
+      points: s.dir === 'h' ? [[x, y], [x + len, y]] : [[x, y], [x, y + len]],
+      preset: s.secret ? 'secret_door' : 'door',
+      door_state: s.state ?? 'closed',
+    });
+  }
+
+  // Merge unit edges into straight runs.
+  const runs: Array<[number, number, number, number]> = [];
+  const used = new Set<string>();
+  for (const key of edges) {
+    if (used.has(key)) continue;
+    const [kind, xs, ys] = key.split(',');
+    let x = Number(xs);
+    let y = Number(ys);
+    const horizontal = kind === 'h';
+    const step = (cx: number, cy: number, d: number) => (horizontal ? `h,${cx + d},${cy}` : `v,${cx},${cy + d}`);
+    while (edges.has(step(x, y, -1))) {
+      if (horizontal) x--;
+      else y--;
+    }
+    const sx = x;
+    const sy = y;
+    while (edges.has(horizontal ? `h,${x},${y}` : `v,${x},${y}`)) {
+      used.add(horizontal ? `h,${x},${y}` : `v,${x},${y}`);
+      if (horizontal) x++;
+      else y++;
+    }
+    runs.push([sx / CELL, sy / CELL, x / CELL, y / CELL]);
+  }
+
+  // Chain runs that share end points into polylines.
+  const unused = new Set(runs.map((_, i) => i));
+  const byPoint = new Map<string, number[]>();
+  const pk = (x: number, y: number) => `${x},${y}`;
+  runs.forEach((r, i) => {
+    for (const k of [pk(r[0], r[1]), pk(r[2], r[3])]) {
+      if (!byPoint.has(k)) byPoint.set(k, []);
+      byPoint.get(k)!.push(i);
+    }
+  });
+  const walls: WallObject[] = [];
+  for (let i = 0; i < runs.length; i++) {
+    if (!unused.has(i)) continue;
+    unused.delete(i);
+    const r = runs[i]!;
+    const chain: number[][] = [[r[0], r[1]], [r[2], r[3]]];
+    let extended = true;
+    while (extended) {
+      extended = false;
+      const end = chain[chain.length - 1]!;
+      const next = (byPoint.get(pk(end[0]!, end[1]!)) ?? []).find(j => unused.has(j));
+      if (next !== undefined) {
+        unused.delete(next);
+        const n = runs[next]!;
+        chain.push(n[0] === end[0] && n[1] === end[1] ? [n[2], n[3]] : [n[0], n[1]]);
+        extended = true;
+      }
+    }
+    const first = chain[0]!;
+    const last = chain[chain.length - 1]!;
+    if (chain.length > 3 && first[0] === last[0] && first[1] === last[1]) {
+      chain.pop();
+      walls.push({ kind: 'wall', points: chain, closed: true });
+    } else {
+      walls.push({ kind: 'wall', points: chain });
+    }
+  }
+
+  return { walls: [...walls, ...doors], segments: edges.size };
+}
+
+/** A sentence for the image prompt that says what each colour in the sketch means. */
+export function legendFor(layout: NormalizedLayout): string {
+  const used = new Set<string>([layout.background]);
+  for (const s of layout.shapes) {
+    if (!s.color && s.fill) used.add(s.fill);
+  }
+  const parts = [...used].map(f => `${FILLS[f]!.colorName} = ${FILLS[f]!.meaning}`);
+  return `In <Picture 1>: ${parts.join('; ')}.`;
+}

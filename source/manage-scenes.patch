+/**
+ * Guards the image generation dialog: the code finds its elements by id and builds the forms
+ * field names from a fixed pattern, so a template edit must not drift from either.
+ */
+
+import { describe, expect, it } from 'vitest';
+import { readFileSync } from 'fs';
+import { dirname, join } from 'path';
+import { fileURLToPath } from 'url';
+import { IMAGE_KINDS } from './image-profiles-utils.js';
+
+const here = dirname(fileURLToPath(import.meta.url));
+const template = readFileSync(join(here, '..', 'templates', 'image-generation-settings.html'), 'utf8');
+const dialog = readFileSync(join(here, 'image-settings-dialog.ts'), 'utf8');
+const css = readFileSync(join(here, '..', 'styles', 'map-generation.css'), 'utf8');
+
+describe('image generation dialog template', () => {
+  it('has every element id the dialog code looks up', () => {
+    const wanted = new Set<string>();
+    for (const match of dialog.matchAll(/find\(\s*'#([\w-]+)'\s*\)/g)) wanted.add(match[1]!);
+    expect(wanted.size).toBeGreaterThanOrEqual(2);
+    const missing = [...wanted].filter(id => !template.includes(`id="${id}"`));
+    expect(missing).toEqual([]);
+  });
+
+  it('has a field for every profile setting, named <kind>__<field>', () => {
+    for (const field of [
+      'workflow',
+      'checkpoint',
+      'diffusionModel',
+      'textEncoder',
+      'vae',
+      'steps',
+      'cfg',
+      'width',
+      'height',
+      'sampler',
+      'scheduler',
+      'promptPrefix',
+      'promptSuffix',
+      'negativePrompt',
+    ]) {
+      expect(template).toContain(`name="{{key}}__${field}"`);
+    }
+  });
+
+  it('is filled once per kind', () => {
+    expect(template).toContain('{{#each kinds}}');
+    expect(IMAGE_KINDS.length).toBe(4);
+  });
+
+  it('only uses styles that the stylesheet defines', () => {
+    const used = new Set<string>();
+    for (const match of template.matchAll(/class="([^"]+)"/g)) {
+      match[1]!
+        .split(/\s+/)
+        .filter(c => c.startsWith('mgs-'))
+        .forEach(c => used.add(c));
+    }
+    expect([...used].filter(c => !css.includes(`.${c}`))).toEqual([]);
+  });
+
+  it('is loaded by the dialog and listed for the module', () => {
+    expect(dialog).toContain('image-generation-settings.html');
+    const manifest = readFileSync(join(here, '..', 'module.json'), 'utf8');
+    expect(manifest).toContain('map-generation.css');
+  });
+});

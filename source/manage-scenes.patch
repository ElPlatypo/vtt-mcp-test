+      }
+    }
+    const [sx, sy] = a.shift ?? [0, 0];
+    const objects: any[] = [];
+    const report: any[] = [];
+    for (const [index, item] of a.items.entries()) {
+      const label = `items[${index}]`;
+      const kind = item.kind;
+      if (kind !== 'token' && kind !== 'light' && kind !== 'note') throw new Error(`${label}: kind must be token, light or note`);
+      if (item.in === undefined) throw new Error(`${label}: "in" (a shape id, label or name) is required`);
+      const { shape, index: shapeIndex } = resolveShape(layout, item.in);
+      const count = Math.max(1, Math.min(60, Math.round(Number(item.count ?? 1))));
+      const width = kind === 'token' ? Number(item.width ?? 1) : 1;
+      const height = kind === 'token' ? Number(item.height ?? 1) : 1;
+      const spots = pickSpots(layout, r, shapeIndex, count, {
+        width,
+        height,
+        taken,
+        spread: item.spread !== false,
+      });
+      spots.forEach((spot, n) => {
+        for (let dy = 0; dy < Math.max(1, Math.round(height)); dy++) {
+          for (let dx = 0; dx < Math.max(1, Math.round(width)); dx++) taken.add(`${spot.x + dx},${spot.y + dy}`);
+        }
+        const round = (v: number) => Math.round(v * 100) / 100;
+        if (kind === 'token') {
+          if (!item.actor) throw new Error(`${label}: a token needs actor`);
+          const name = item.name ? (count > 1 ? `${item.name} ${n + 1}` : item.name) : undefined;
+          objects.push({
+            kind: 'token',
+            actor: item.actor,
+            x: round(spot.x + sx),
+            y: round(spot.y + sy),
+            ...(name ? { name } : {}),
+            ...(item.hidden !== undefined ? { hidden: item.hidden } : {}),
+            ...(item.width !== undefined ? { width: item.width } : {}),
+            ...(item.height !== undefined ? { height: item.height } : {}),
+            ...(item.disposition !== undefined ? { disposition: item.disposition } : {}),
+            ...(item.elevation !== undefined ? { elevation: item.elevation } : {}),
+          });
+        } else if (kind === 'light') {
+          objects.push({
+            kind: 'light',
+            x: round(spot.x + 0.5 + sx),
+            y: round(spot.y + 0.5 + sy),
+            bright: Number(item.bright ?? 3),
+            dim: Number(item.dim ?? (item.bright ? Number(item.bright) * 2 : 7)),
+            ...(item.color ? { color: item.color } : {}),
+            ...(item.animation ? { animation: item.animation } : {}),
+            ...(item.alpha !== undefined ? { alpha: item.alpha } : {}),
+            ...(item.hidden !== undefined ? { hidden: item.hidden } : {}),
+          });
+        } else {
+          if (!item.journal) throw new Error(`${label}: a pin needs journal`);
+          objects.push({
+            kind: 'note',
+            x: round(spot.x + 0.5 + sx),
+            y: round(spot.y + 0.5 + sy),
+            journal: item.journal,
+            ...(item.page ? { page: item.page } : {}),
+            ...(item.text ? { text: item.text } : {}),
+            ...(item.global !== undefined ? { global: item.global } : {}),
+          });
+        }
+        report.push({ kind, in: shape.name ?? shape.id, at: [spot.x, spot.y] });
+      });
+    }

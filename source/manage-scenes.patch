+import { describe, expect, it } from 'vitest';
+import {
+  assertInsideScene,
+  buildLightData,
+  getGridGeometry,
+  pixelsToSquares,
+  squaresToPixels,
+} from './scene-objects-utils.js';
+
+const scene = (overrides: Record<string, any> = {}): any => ({
+  width: 4000,
+  height: 3000,
+  padding: 0.25,
+  grid: { size: 100, distance: 5, units: 'ft' },
+  dimensions: { sceneX: 1000, sceneY: 800, sceneWidth: 4000, sceneHeight: 3000 },
+  ...overrides,
+});
+
+describe('getGridGeometry', () => {
+  it('reads size, offset and the number of squares', () => {
+    expect(getGridGeometry(scene())).toEqual({
+      size: 100,
+      originX: 1000,
+      originY: 800,
+      sceneWidth: 4000,
+      sceneHeight: 3000,
+      columns: 40,
+      rows: 30,
+      distance: 5,
+      units: 'ft',
+    });
+  });
+
+  it('falls back to the padding formula without scene.dimensions', () => {
+    const geom = getGridGeometry(scene({ dimensions: undefined }));
+    // ceil(4000 * 0.25 / 100) * 100 = 1000; ceil(3000 * 0.25 / 100) * 100 = 800
+    expect([geom.originX, geom.originY]).toEqual([1000, 800]);
+  });
+
+  it('counts whole squares only', () => {
+    const geom = getGridGeometry(
+      scene({ dimensions: { sceneX: 0, sceneY: 0, sceneWidth: 4050, sceneHeight: 3000 } })
+    );
+    expect(geom.columns).toBe(40);
+  });
+
+  it('refuses a scene without a usable grid or size', () => {
+    expect(() => getGridGeometry(scene({ grid: { size: 0 } }))).toThrow('grid size');
+    expect(() => getGridGeometry(scene({ dimensions: undefined, width: 0 }))).toThrow('valid size');
+  });
+});
+
+describe('squares and pixels', () => {
+  const geom = getGridGeometry(scene());
+
+  it('converts including the padding offset', () => {
+    expect(squaresToPixels(geom, 0, 0)).toEqual({ x: 1000, y: 800 });
+    expect(squaresToPixels(geom, 2.5, 1.5)).toEqual({ x: 1250, y: 950 });
+  });
+
+  it('converts back', () => {
+    expect(pixelsToSquares(geom, 1250, 950)).toEqual({ x: 2.5, y: 1.5 });
+    expect(pixelsToSquares(geom, 1033, 800)).toEqual({ x: 0.33, y: 0 });
+  });
+});
+
+describe('assertInsideScene', () => {
+  const geom = getGridGeometry(scene());
+
+  it('accepts points on and inside the edges', () => {
+    expect(() => assertInsideScene(geom, 0, 0, 'p')).not.toThrow();
+    expect(() => assertInsideScene(geom, 40, 30, 'p')).not.toThrow();
+  });
+
+  it('rejects points outside and non-numbers, naming the valid range', () => {
+    expect(() => assertInsideScene(geom, 41, 5, 'p')).toThrow('40 x 30 squares');
+    expect(() => assertInsideScene(geom, -1, 5, 'p')).toThrow('outside the scene');
+    expect(() => assertInsideScene(geom, '3' as any, 5, 'p')).toThrow('must be numbers');
+    expect(() => assertInsideScene(geom, NaN, 5, 'p')).toThrow('must be numbers');
+  });
+});
+
+describe('buildLightData', () => {
+  const geom = getGridGeometry(scene());
+
+  it('converts radii from squares to scene distance and the point to pixels', () => {
+    expect(buildLightData({ x: 10, y: 5, bright: 2, dim: 4 }, geom, 'l')).toEqual({
+      x: 2000,
+      y: 1300,
+      config: { bright: 10, dim: 20 },
+    });
+  });
+
+  it('passes colour, alpha, cone, rotation, animation and hidden', () => {
+    const data = buildLightData(
+      {
+        x: 1,
+        y: 1,
+        dim: 3,
+        color: '#FFAA00',
+        alpha: 0.5,
+        angle: 90,
+        rotation: 180,
+        animation: 'torch',
+        hidden: true,
+      },
+      geom,
+      'l'
+    );
+    expect(data.config).toMatchObject({
+      color: '#ffaa00',
+      alpha: 0.5,
+      angle: 90,
+      animation: { type: 'torch' },
+    });
+    expect(data.rotation).toBe(180);
+    expect(data.hidden).toBe(true);
+  });
+
+  it.each([
+    ['no radius', { x: 1, y: 1 }, 'bright or dim'],
+    ['a negative radius', { x: 1, y: 1, dim: -1 }, 'from 0 to'],
+    ['a huge radius', { x: 1, y: 1, dim: 500 }, 'from 0 to'],
+    ['a bad colour', { x: 1, y: 1, dim: 2, color: 'red' }, '#RRGGBB'],
+    ['a bad alpha', { x: 1, y: 1, dim: 2, alpha: 2 }, 'alpha'],
+    ['a bad angle', { x: 1, y: 1, dim: 2, angle: 0 }, 'angle'],
+    ['an unknown animation', { x: 1, y: 1, dim: 2, animation: 'disco' }, 'animation must be'],
+    ['a point outside the scene', { x: 99, y: 1, dim: 2 }, 'outside the scene'],
+  ])('rejects %s', (_label, spec, message) => {
+    expect(() => buildLightData(spec as any, geom, 'l')).toThrow(message);
+  });
+});

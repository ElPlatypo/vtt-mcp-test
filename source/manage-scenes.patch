+import { describe, expect, it } from 'vitest';
+import { moveCoins, pickItems, quantityToMove } from './transfer-utils.js';
+
+const items = [
+  { id: 'a', name: 'Longsword' },
+  { id: 'b', name: 'Healing Potion' },
+  { id: 'c', name: 'Greater Healing Potion' },
+];
+
+describe('pickItems', () => {
+  it('finds by id and by name, preferring an exact name', () => {
+    expect(pickItems(items, ['a'], ['healing potion']).picked.map(i => i.id)).toEqual(['a', 'b']);
+    expect(pickItems(items, [], ['healing']).picked.map(i => i.id)).toEqual(['b', 'c']);
+  });
+  it('lists what matched nothing', () => {
+    expect(pickItems(items, ['zz'], ['axe']).notFound).toEqual(['zz', 'axe']);
+  });
+});
+
+describe('quantityToMove', () => {
+  it('moves the whole stack by default and never more than there is', () => {
+    expect(quantityToMove(5, undefined)).toEqual({ move: 5, whole: true });
+    expect(quantityToMove(5, 2)).toEqual({ move: 2, whole: false });
+    expect(quantityToMove(5, 9)).toEqual({ move: 5, whole: true });
+    expect(quantityToMove(undefined, undefined)).toEqual({ move: 1, whole: true });
+    expect(() => quantityToMove(5, 0)).toThrow(/quantity/);
+  });
+});
+
+describe('moveCoins', () => {
+  it('moves coins and leaves the rest', () => {
+    const r = moveCoins({ gp: 10, sp: 3 }, { gp: 1 }, { gp: 4, sp: 3 });
+    expect(r.from).toEqual({ gp: 6, sp: 0 });
+    expect(r.to).toEqual({ gp: 5, sp: 3 });
+    expect(r.moved).toEqual({ gp: 4, sp: 3 });
+  });
+  it('refuses more than the giver has, and unknown coins', () => {
+    expect(() => moveCoins({ gp: 1 }, {}, { gp: 2 })).toThrow(/Not enough gp/);
+    expect(() => moveCoins({ gp: 1 }, {}, { zz: 1 })).toThrow(/Unknown coin/);
+  });
+});

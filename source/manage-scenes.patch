+import { describe, expect, it } from 'vitest';
+import { checkWalls, closestOnSegment, planFixes, type CheckWall } from './wall-check-utils.js';
+
+const w = (id: string, from: [number, number], to: [number, number], extra: Partial<CheckWall> = {}): CheckWall => ({ id, from, to, door: null, createdByTool: true, ...extra });
+
+describe('checkWalls', () => {
+  it('accepts a closed room', () => {
+    const room = [w('a', [0, 0], [4, 0]), w('b', [4, 0], [4, 4]), w('c', [4, 4], [0, 4]), w('d', [0, 4], [0, 0])];
+    expect(checkWalls(room)).toEqual([]);
+  });
+  it('accepts a T junction where an end touches the middle of a wall', () => {
+    expect(checkWalls([w('a', [0, 0], [4, 0]), w('b', [2, 0], [2, 3]), w('c', [0, 3], [4, 3])]).some(i => i.kind === 'gap')).toBe(false);
+  });
+  it('finds an end that stops short and says where to join', () => {
+    const issues = checkWalls([w('a', [0, 0], [4, 0]), w('b', [4.3, 0], [4.3, 3]), w('c', [4, 0], [4, 1])]);
+    const gap = issues.find(i => i.kind === 'gap' && i.walls[0] === 'b')!;
+    expect(gap.snapTo).toEqual([4, 0]);
+    expect(gap.fixable).toBe(true);
+  });
+  it('reports loose ends, floating doors, duplicates, tiny and diagonal walls', () => {
+    const issues = checkWalls([
+      w('a', [0, 0], [4, 0]),
+      w('b', [10, 10], [12, 10]),
+      w('d', [20, 20], [21, 20], { door: 'door' }),
+      w('e', [0, 0], [4, 0]),
+      w('t', [30, 30], [30.1, 30]),
+      w('g', [40, 40], [41, 41], { door: 'door' }),
+    ]);
+    const kinds = issues.map(i => i.kind);
+    expect(kinds).toEqual(expect.arrayContaining(['loose_end', 'door_unattached', 'duplicate', 'tiny', 'diagonal_door']));
+  });
+  it('does not call far walls a gap', () => {
+    expect(checkWalls([w('a', [0, 0], [4, 0]), w('b', [0, 1], [4, 1])]).some(i => i.kind === 'gap')).toBe(false);
+  });
+});
+
+describe('planFixes', () => {
+  it('moves a short end to join, keeping door type, and drops duplicates', () => {
+    const walls = [
+      w('a', [0, 0], [4, 0]),
+      w('door', [4.3, 0], [4.3, 1], { door: 'door', doorState: 'locked' }),
+      w('x', [0, 0], [4, 0]),
+      w('c', [4, 0], [4, 5]),
+    ];
+    const plan = planFixes(walls, checkWalls(walls));
+    expect(plan.remove.sort()).toEqual(['door', 'x']);
+    expect(plan.place).toEqual([{ points: [[4, 0], [4, 1]], preset: 'door', door_state: 'locked' }]);
+  });
+  it('leaves walls the tool did not place alone', () => {
+    const walls = [w('a', [0, 0], [4, 0], { createdByTool: false }), w('b', [4.2, 0], [4.2, 3], { createdByTool: false })];
+    expect(planFixes(walls, checkWalls(walls)).remove).toEqual([]);
+  });
+});
+
+describe('closestOnSegment', () => {
+  it('clamps to the ends', () => {
+    expect(closestOnSegment([5, 1], [0, 0], [4, 0]).point).toEqual([4, 0]);
+  });
+});
diff --git a/packages/mcp-server/src/tools/wall-check-utils.ts b/packages/mcp-server/src/tools/wall-check-utils.ts
new file mode 100644
index 0000000..38bc6dc
--- /dev/null
+++ b/packages/mcp-server/src/tools/wall-check-utils.ts
@@ -0,0 +1,153 @@
+/** Wall geometry check: finds walls and doors that do not meet, and plans fixes. Pure; units are grid squares. */
+
+export interface CheckWall {
+  id: string;
+  from: [number, number];
+  to: [number, number];
+  door?: string | null;
+  doorState?: string;
+  createdByTool?: boolean;
+}
+
+export type Pt = [number, number];
+
+export interface WallIssue {
+  kind: 'gap' | 'loose_end' | 'door_unattached' | 'duplicate' | 'tiny' | 'diagonal_door';
+  at: Pt;
+  walls: string[];
+  message: string;
+  /** Where a fix would move the end, when there is a safe fix. */
+  snapTo?: Pt;
+  fixable: boolean;
+}
+
+const EPS = 0.02;
+const same = (a: Pt, b: Pt) => Math.abs(a[0] - b[0]) < EPS && Math.abs(a[1] - b[1]) < EPS;
+const round = (n: number) => Math.round(n * 100) / 100;
+const fmt = (p: Pt) => `(${round(p[0])}, ${round(p[1])})`;
+
+/** Closest point on segment ab to p, and its distance. */
+export function closestOnSegment(p: Pt, a: Pt, b: Pt): { point: Pt; dist: number; t: number } {
+  const dx = b[0] - a[0];
+  const dy = b[1] - a[1];
+  const len2 = dx * dx + dy * dy;
+  const t = len2 === 0 ? 0 : Math.max(0, Math.min(1, ((p[0] - a[0]) * dx + (p[1] - a[1]) * dy) / len2));
+  const point: Pt = [a[0] + t * dx, a[1] + t * dy];
+  return { point, dist: Math.hypot(p[0] - point[0], p[1] - point[1]), t };
+}
+
+export interface CheckOptions {
+  /** An end this close to another wall (but not touching) counts as a gap. Default 0.45 squares. */
+  tolerance?: number;
+  /** Walls shorter than this are reported. Default 0.2. */
+  minLength?: number;
+}
+
+export function checkWalls(walls: CheckWall[], options: CheckOptions = {}): WallIssue[] {
+  const tolerance = options.tolerance ?? 0.45;
+  const minLength = options.minLength ?? 0.2;
+  const issues: WallIssue[] = [];
+
+  // Duplicates: the same segment twice (either direction).
+  const seen = new Map<string, string>();
+  const dupIds = new Set<string>();
+  for (const w of walls) {
+    const a = `${round(w.from[0])},${round(w.from[1])}`;
+    const b = `${round(w.to[0])},${round(w.to[1])}`;
+    const key = a < b ? `${a}|${b}` : `${b}|${a}`;
+    const first = seen.get(key);
+    if (first) {
+      dupIds.add(w.id);
+      issues.push({ kind: 'duplicate', at: w.from, walls: [first, w.id], message: `Two walls on the same line from ${fmt(w.from)} to ${fmt(w.to)}`, fixable: !!w.createdByTool });
+    } else seen.set(key, w.id);
+  }
+
+  for (const w of walls) {
+    const length = Math.hypot(w.to[0] - w.from[0], w.to[1] - w.from[1]);
+    if (length < minLength) {
+      issues.push({ kind: 'tiny', at: w.from, walls: [w.id], message: `Wall of only ${round(length)} squares at ${fmt(w.from)}`, fixable: false });
+    }
+    if (w.door && Math.abs(w.to[0] - w.from[0]) > EPS && Math.abs(w.to[1] - w.from[1]) > EPS) {
+      issues.push({ kind: 'diagonal_door', at: w.from, walls: [w.id], message: `Door at ${fmt(w.from)}-${fmt(w.to)} is diagonal`, fixable: false });
+    }
+  }
+
+  // Ends: touching another wall's end or body, near-missing it, or loose.
+  const others = walls.filter(w => !dupIds.has(w.id));
+  const reported = new Set<string>();
+  for (const w of others) {
+    for (const end of [w.from, w.to] as Pt[]) {
+      let touching = false;
+      let best: { point: Pt; dist: number; id: string; viaEnd: boolean } | undefined;
+      for (const o of others) {
+        if (o.id === w.id) continue;
+        const c = closestOnSegment(end, o.from, o.to);
+        if (c.dist < EPS) {
+          touching = true;
+          break;
+        }
+        if (c.dist <= tolerance && (!best || c.dist < best.dist)) {
+          const toEnd = [o.from, o.to].find(p => Math.hypot(p[0] - end[0], p[1] - end[1]) <= c.dist + EPS) as Pt | undefined;
+          best = { point: toEnd ?? c.point, dist: c.dist, id: o.id, viaEnd: !!toEnd };
+        }
+      }
+      if (touching) continue;
+      const key = `${w.id}@${round(end[0])},${round(end[1])}`;
+      if (reported.has(key)) continue;
+      reported.add(key);
+      const what = w.door ? 'Door' : 'Wall';
+      if (best) {
+        const snap: Pt = [round(best.point[0]), round(best.point[1])];
+        issues.push({
+          kind: 'gap',
+          at: end,
+          walls: [w.id, best.id],
+          snapTo: snap,
+          message: `${what} end ${fmt(end)} stops ${round(best.dist)} squares short of another wall; moving it to ${fmt(snap)} joins them`,
+          fixable: !!w.createdByTool,
+        });
+      } else {
+        issues.push({
+          kind: w.door ? 'door_unattached' : 'loose_end',
+          at: end,
+          walls: [w.id],
+          message: w.door ? `Door end ${fmt(end)} touches no wall, so the door floats` : `Wall end ${fmt(end)} touches nothing (fine at a pillar or open edge, a leak otherwise)`,
+          fixable: false,
+        });
+      }
+    }
+  }
+  return issues;
+}
+
+/** Walls to replace to apply the fixable gap and duplicate fixes. */
+export function planFixes(walls: CheckWall[], issues: WallIssue[]): { remove: string[]; place: Array<{ points: Pt[]; preset: string; door_state?: string }> } {
+  const byId = new Map(walls.map(w => [w.id, w]));
+  const moved = new Map<string, { from: Pt; to: Pt }>();
+  const remove = new Set<string>();
+  for (const issue of issues) {
+    if (!issue.fixable) continue;
+    if (issue.kind === 'duplicate') {
+      remove.add(issue.walls[1]!);
+    } else if (issue.kind === 'gap' && issue.snapTo) {
+      const w = byId.get(issue.walls[0]!);
+      if (!w) continue;
+      const cur = moved.get(w.id) ?? { from: w.from, to: w.to };
+      if (same(cur.from, issue.at)) cur.from = issue.snapTo;
+      else if (same(cur.to, issue.at)) cur.to = issue.snapTo;
+      moved.set(w.id, cur);
+    }
+  }
+  const place: Array<{ points: Pt[]; preset: string; door_state?: string }> = [];
+  for (const [id, seg] of moved) {
+    if (remove.has(id)) continue;
+    const w = byId.get(id)!;
+    remove.add(id);
+    place.push({
+      points: [seg.from, seg.to],
+      preset: w.door === 'door' ? 'door' : w.door === 'secret_door' ? 'secret_door' : 'wall',
+      ...(w.door ? { door_state: w.doorState ?? 'closed' } : {}),
+    });
+  }
+  return { remove: [...remove], place };
+}

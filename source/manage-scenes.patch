@@ -0,0 +1,70 @@
+import { z } from 'zod';
+import type { FoundryClient } from '../foundry-client.js';
+import type { Logger } from '../logger.js';
+
+const TARGETS = ['dawn', 'sunrise', 'morning', 'noon', 'afternoon', 'dusk', 'sunset', 'evening', 'midnight'] as const;
+
+const schema = z
+  .object({
+    action: z.enum(['status', 'advance', 'until', 'set', 'calendar']).default('status'),
+    seconds: z.number().min(0).optional(),
+    rounds: z.number().min(0).optional(),
+    minutes: z.number().min(0).optional(),
+    hours: z.number().min(0).optional(),
+    days: z.number().min(0).optional(),
+    until: z.enum(TARGETS).optional(),
+    year: z.number().int().optional(),
+    month: z.union([z.number().int().min(1), z.string().min(1)]).optional(),
+    day: z.number().int().min(1).optional(),
+    hour: z.number().int().min(0).optional(),
+    minute: z.number().int().min(0).optional(),
+    calendar: z.string().min(1).optional(),
+  })
+  .strict();
+
+export class TimeTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: { foundryClient: FoundryClient; logger: Logger }) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'TimeTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'time',
+        description:
+          "In-game time on the world calendar (Foundry's world clock, which dnd5e extends with sunrise, sunset and the Gregorian, Harptos, Greyhawk and Khorvaire calendars). Moving the clock is Foundry's own, so effect durations, dnd5e daily recovery and the calendar display players see all follow it. status: date, weekday, time, part of the day (night, dawn, morning, afternoon, dusk, evening), season, sunrise and sunset. advance {seconds?, rounds?, minutes?, hours?, days?}: time passes (a short rest is 1 hour, a long rest 8 hours, a day of travel about 8 hours on the road); says when new days began. until {until: dawn | sunrise | morning | noon | afternoon | dusk | sunset | evening | midnight}: advances to the next one (for example a night watch until dawn). set {year?, month? (number from 1 or name), day?, hour?, minute?}: jumps to a date and time (start of a campaign; prefer advance afterwards). calendar {calendar?}: lists the calendars or switches to one (harptos for the Forgotten Realms). During combat each round already moves the clock 6 seconds; do not add rounds by hand. Use party rest for rests (it recovers hit dice and features) and then advance the clock by the rest's length.",
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: { type: 'string', enum: ['status', 'advance', 'until', 'set', 'calendar'], description: 'default status' },
+            seconds: { type: 'number', description: 'advance' },
+            rounds: { type: 'number', description: 'advance: 6 seconds each' },
+            minutes: { type: 'number', description: 'advance' },
+            hours: { type: 'number', description: 'advance' },
+            days: { type: 'number', description: 'advance' },
+            until: { type: 'string', enum: [...TARGETS], description: 'until: the time of day to move to' },
+            year: { type: 'number', description: 'set' },
+            month: { type: ['number', 'string'], description: 'set: 1-based number or month name' },
+            day: { type: 'number', description: 'set: day of the month, from 1' },
+            hour: { type: 'number', description: 'set' },
+            minute: { type: 'number', description: 'set' },
+            calendar: { type: 'string', description: 'calendar: gregorian, harptos, greyhawk or khorvaire' },
+          },
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handle(args: unknown): Promise<any> {
+    const a = schema.parse(args ?? {});
+    this.logger.info('World time', { action: a.action });
+    const result = await this.foundryClient.query('foundry-mcp-bridge.world-time', a);
+    if (result?.success === false && result?.error) throw new Error(result.error);
+    return result;
+  }
+}

@@ -0,0 +1,67 @@
+import { z } from 'zod';
+import type { FoundryClient } from '../foundry-client.js';
+import type { Logger } from '../logger.js';
+
+const place = z.union([z.string().min(1), z.tuple([z.number(), z.number()])]);
+
+const schema = z
+  .object({
+    action: z.enum(['distance', 'area', 'sight']),
+    scene: z.string().min(1).optional(),
+    from: z.string().min(1).optional(),
+    to: z.array(z.string().min(1)).min(1).max(30).optional(),
+    shape: z.enum(['circle', 'cone', 'line', 'square']).optional(),
+    origin: place.optional(),
+    size: z.number().positive().max(2000).optional(),
+    width: z.number().positive().max(200).optional(),
+    direction: z.union([z.number(), z.string().min(1)]).optional(),
+    toward: place.optional(),
+    include_origin: z.boolean().optional(),
+  })
+  .strict();
+
+export class TacticalTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: { foundryClient: FoundryClient; logger: Logger }) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'TacticalTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'tactical',
+        description:
+          'Answer tactical questions on a scene instead of guessing from a picture. Tokens are named (token name, else actor name, else part of a name; an ambiguous name is refused with the ids) and distances are in the scene units, D&D style (diagonals count as one square, measured between the nearest edges). distance {from, to:[names]}. area {shape: circle | cone | line | square, origin: token name or [column, row] in grid squares, size: radius (circle), length (cone, line) or side (square) in feet, width? (line, default 5), direction? (degrees, 0 = east, 90 = south, or north, southeast...) or toward? (a token or square), include_origin?} lists every token the area touches (a square counts when its centre is inside, as Foundry templates do): a fireball is circle 20 at a square, a dragon breath cone 15 toward a token, lightning bolt line 100 width 5; the caster is left out unless include_origin; creatures with walls blocking every line from the origin are marked behindWall. sight {from, to:[names]} gives, for each target, the distance, whether there is a line of sight through the walls, and cover by the DMG corner method (none, half, three-quarters, total; a creature standing in the way gives half). sight needs the scene on screen; it ignores light and vision (darkness, invisibility are separate). Read-only.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: { type: 'string', enum: ['distance', 'area', 'sight'] },
+            scene: { type: 'string', description: 'Scene id or name (default the one being viewed)' },
+            from: { type: 'string', description: 'distance, sight: the token measured from' },
+            to: { type: 'array', items: { type: 'string' }, description: 'distance, sight: tokens measured to' },
+            shape: { type: 'string', enum: ['circle', 'cone', 'line', 'square'], description: 'area (default circle)' },
+            origin: { description: 'area: a token name or [column, row] in grid squares', anyOf: [{ type: 'string' }, { type: 'array', items: { type: 'number' }, minItems: 2, maxItems: 2 }] },
+            size: { type: 'number', description: 'area: radius, length or side in feet' },
+            width: { type: 'number', description: 'area: width of a line in feet (default 5)' },
+            direction: { description: 'area: degrees (0 east, 90 south) or a compass word', anyOf: [{ type: 'number' }, { type: 'string' }] },
+            toward: { description: 'area: aim at this token or [column, row] instead of a direction', anyOf: [{ type: 'string' }, { type: 'array', items: { type: 'number' }, minItems: 2, maxItems: 2 }] },
+            include_origin: { type: 'boolean', description: 'area: include the token at the origin' },
+          },
+          required: ['action'],
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handle(args: unknown): Promise<any> {
+    const a = schema.parse(args);
+    this.logger.info('Tactical query', { action: a.action });
+    const result = await this.foundryClient.query('foundry-mcp-bridge.tactical', a);
+    if (result?.success === false && result?.error) throw new Error(result.error);
+    return result;
+  }
+}

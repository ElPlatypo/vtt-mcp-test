+    });
+    expect(result.placed).toBe(5);
+    const place = calls.find(c => c.args.action === 'place')!;
+    const objects = place.args.objects;
+    expect(place.args.scene).toBe('Cave');
+    const tokens = objects.filter((o: any) => o.kind === 'token');
+    expect(tokens.map((t: any) => t.name)).toEqual(['Kennel Wolf 1', 'Kennel Wolf 2', 'Kennel Wolf 3']);
+    for (const t of tokens) {

+        const scenes = (game.scenes?.contents || []) as any[];
+        return { success: true, scenes: scenes.map(scene => this.summarizeScene(scene)) };
+      }
+
+      if (options.action !== 'create' && options.action !== 'update') {
+        throw new Error(`Unknown action: ${String(options.action)} (create | update | describe)`);
+      }
+
+      const permissionCheck = permissionManager.checkWritePermission('modifyScene', {});
+      if (!permissionCheck.allowed) {
+        throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${permissionCheck.reason}`);
+      }
+
+      if (options.background !== undefined && options.background !== null) {
+        if (typeof options.background !== 'string' || !options.background.trim()) {
+          throw new Error('background must be a file path string or null to clear it');
+        }
+      }
+
+      const data = this.buildSceneData(options);
+      const view = options.initial_view;
+      if (view !== undefined) {
+        const bad = (v: unknown) => typeof v !== 'number' || !Number.isFinite(v);
+        if (!view || bad(view.x) || bad(view.y) || (view.scale !== undefined && (bad(view.scale) || view.scale < 0.25 || view.scale > 3))) {
+          throw new Error('initial_view must be {x, y, scale?} with x and y in grid squares and scale 0.25 to 3');
+        }
+      }
+
+      // On v14 the canvas colour is a Level property, not a Scene field: split it out
+      // so it is not sent to Scene.create / scene.update (where it is silently dropped).
+      let levelColor: string | undefined;
+      if ('backgroundColor' in data && ((game as any).release?.generation ?? 0) >= 14) {
+        levelColor = data.backgroundColor ?? '#999999';
+        delete data.backgroundColor;
+      }
+
+      let scene: any;
+      if (options.action === 'create') {
+        if (!data.name) {
+          throw new Error('name is required for create');
+        }
+        scene = await (globalThis as any).Scene.create(data);
+        if (!scene) {
+          throw new Error('Foundry did not return the created scene');
+        }
+      } else {
+        if (!options.scene_identifier) {
+          throw new Error('scene_identifier is required for update');
+        }
+        scene = this.findSceneByIdentifier(options.scene_identifier);
+        const hasChange =
+          Object.keys(data).length > 0 ||
+          options.background !== undefined ||
+          levelColor !== undefined ||
+          view !== undefined ||
+          options.activate === true;
+        if (!hasChange) {
+          throw new Error('Nothing to update: pass at least one field to change');
+        }
+        if (Object.keys(data).length > 0) {
+          await scene.update(data);
+        }
+      }
+
+      if (options.background !== undefined) {
+        await this.applySceneBackground(scene, options.background);
+      }
+      if (levelColor !== undefined) {
+        await this.applySceneBackgroundColor(scene, levelColor);
+      }
+      if (view !== undefined) {
+        // x and y are the centre of the opening view, in grid squares like every other tool.
+        const geom = getGridGeometry(scene);
+        const centre = squaresToPixels(geom, view.x, view.y);
+        await scene.update({
+          initial: { x: centre.x, y: centre.y, ...(view.scale !== undefined ? { scale: view.scale } : {}) },
+        });
+      }
+      if (options.activate === true) {
+        await scene.activate();
+      }
+
+      this.auditLog(`manageScenes:${options.action}`, options, 'success');
+
+      const summary = this.summarizeScene(scene);
+      const warnings = this.findUnappliedSceneChanges(options, summary);
+      return {
+        success: true,
+        action: options.action,
+        scene: summary,
+        ...(warnings.length > 0 ? { warnings } : {}),
+      };
+    } catch (error) {
+      this.auditLog(
+        `manageScenes:${options?.action}`,
+        options,
+        'failure',
+        error instanceof Error ? error.message : 'Unknown error'
+      );
+      throw new Error(
+        `Failed to ${options?.action ?? 'manage'} scene: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+
+  // ===== WORLD HOUSEKEEPING (FOLDERS, MOVE, RENAME, DELETE) =====
+
+  private worldCollection(type: string): any {
+    const g = game as any;
+    const map: Record<string, any> = {
+      Actor: g.actors,
+      Scene: g.scenes,
+      JournalEntry: g.journal,
+      Item: g.items,
+      RollTable: g.tables,
+      Playlist: g.playlists,
+      Macro: g.macros,
+      Folder: g.folders,
+    };
+    const collection = map[type];
+    if (!collection) {
+      throw new Error(`type must be one of ${Object.keys(map).join(', ')}`);
+    }
+    return collection;
+  }
+
+  /** Find one document by id or exact name (a name must be unique). */
+  private findWorldDocument(type: string, identifier: string, folderType?: string): any {
+    const docs = ((this.worldCollection(type)?.contents || []) as any[]).filter(
+      d => type !== 'Folder' || !folderType || d.type === folderType
+    );
+    const byId = docs.find(d => d.id === identifier);
+    if (byId) return byId;
+    const wanted = String(identifier).trim().toLowerCase();
+    const matches = docs.filter(d => String(d.name ?? '').toLowerCase() === wanted);
+    if (matches.length === 1) return matches[0];
+    if (matches.length > 1) {
+      throw new Error(
+        `Several ${type} documents are named "${identifier}" (ids: ${matches.map(m => m.id).join(', ')}); use the id`
+      );
+    }
+    throw new Error(`${type} not found: "${identifier}"`);
+  }
+
+  private findFolderForWorld(name: string, folderType: string): any {
+    return this.findWorldDocument('Folder', name, folderType);
+  }
+
+  /**
+   * Housekeeping for the world: list/create folders, move documents between folders, rename,
+   * and delete. Deleting needs confirm: true and is limited to 100 documents per call.
+   */
+  async manageWorld(options: {
+    action: 'list_folders' | 'create_folder' | 'rename' | 'move' | 'delete';
+    type?: string;
+    name?: string;
+    parent?: string | null;
+    identifier?: string;
+    identifiers?: string[];
+    folder?: string | null;
+    create_folder?: boolean;
+    folder_type?: string;
+    delete_contents?: boolean;
+    confirm?: boolean;
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      const action = options.action;
+      const known = ['list_folders', 'create_folder', 'rename', 'move', 'delete'];
+      if (!known.includes(action)) {
+        throw new Error(`Unknown action: ${String(action)} (${known.join(' | ')})`);
+      }
+
+      if (action === 'list_folders') {
+        const folders = (((game as any).folders?.contents || []) as any[])
+          .filter(f => !options.type || f.type === options.type)
+          .map(f => ({
+            id: f.id,
+            name: f.name,
+            type: f.type,
+            parent: f.folder?.name ?? null,
+            documents: f.contents?.length ?? 0,
+          }));
+        return { success: true, folders };
+      }
+
+      const gate = permissionManager.checkWritePermission(action === 'delete' ? 'deleteData' : 'modifyWorld');
+      if (!gate.allowed) throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${gate.reason}`);
+
+      const type = options.type;
+      if (!type) throw new Error('type is required (Actor, Scene, JournalEntry, Item, RollTable, Playlist, Macro or Folder)');
+
+      if (action === 'create_folder') {
+        if (type === 'Folder') throw new Error('type is the kind of document the folder holds, such as Actor');
+        this.worldCollection(type);
+        if (typeof options.name !== 'string' || !options.name.trim()) throw new Error('name is required');
+        const parent = options.parent ? this.findFolderForWorld(options.parent, type) : null;
+        const existing = (((game as any).folders?.contents || []) as any[]).find(
+          f => f.type === type && f.name === options.name!.trim() && (f.folder?.id ?? null) === (parent?.id ?? null)
+        );
+        if (existing) return { success: true, action, folder: { id: existing.id, name: existing.name }, existed: true };
+        const folder = await (globalThis as any).Folder.create({
+          name: options.name.trim(),
+          type,
+          ...(parent ? { folder: parent.id } : {}),
+        });
+        this.auditLog('manageWorld:create_folder', { type, name: options.name }, 'success');
+        return { success: true, action, folder: { id: folder.id, name: folder.name } };
+      }
+
+      if (action === 'rename') {
+        if (!options.identifier) throw new Error('identifier (id or exact name) is required');
+        if (typeof options.name !== 'string' || !options.name.trim()) throw new Error('name is required');
+        const doc = this.findWorldDocument(type, options.identifier, options.folder_type);
+        const before = doc.name;
+        await doc.update({ name: options.name.trim() });
+        this.auditLog('manageWorld:rename', { type, id: doc.id }, 'success');
+        return { success: true, action, id: doc.id, from: before, to: options.name.trim() };
+      }
+
+      const identifiers = options.identifiers ?? (options.identifier ? [options.identifier] : []);
+      if (!Array.isArray(identifiers) || identifiers.length === 0) {
+        throw new Error('identifiers (ids or exact names) is required');
+      }
+      if (identifiers.length > 100) throw new Error('At most 100 documents per call');
+      const docs = identifiers.map(i => this.findWorldDocument(type, i, options.folder_type));
+
+      if (action === 'move') {
+        const folderType = type === 'Folder' ? options.folder_type : type;
+        if (!folderType) throw new Error('folder_type is required when moving folders');
+        let target: any = null;
+        if (options.folder) {
+          try {
+            target = this.findFolderForWorld(options.folder, folderType);
+          } catch (error) {
+            if (!options.create_folder) throw error;
+            target = await (globalThis as any).Folder.create({ name: options.folder, type: folderType });
+          }
+        }
+        for (const doc of docs) {
+          if (type === 'Folder' && target && doc.id === target.id) {
+            throw new Error('A folder cannot be moved into itself');
+          }
+        }
+        for (const doc of docs) await doc.update({ folder: target ? target.id : null });
+        this.auditLog('manageWorld:move', { type, count: docs.length }, 'success');
+        return {
+          success: true,
+          action,
+          folder: target ? { id: target.id, name: target.name } : null,
+          moved: docs.map(d => ({ id: d.id, name: d.name })),
+        };
+      }
+
+      // delete
+      if (options.confirm !== true) {
+        throw new Error(
+          `Deleting is permanent. Pass confirm: true to delete: ${docs.map(d => `${d.name} (${d.id})`).join(', ')}`
+        );
+      }
+      if (type === 'Scene') {
+        const active = docs.find(d => d.active);
+        if (active) throw new Error(`"${active.name}" is the active scene; activate another scene first`);
+      }
+      const deleted: Array<{ id: string; name: string }> = [];
+      for (const doc of docs) {
+        const entry = { id: doc.id, name: doc.name };
+        if (type === 'Folder') {
+          await doc.delete({
+            deleteSubfolders: !!options.delete_contents,
+            deleteContents: !!options.delete_contents,
+          });
+        } else {
+          await doc.delete();
+        }
+        deleted.push(entry);
+      }
+      this.auditLog('manageWorld:delete', { type, count: deleted.length }, 'success');
+      return { success: true, action, deleted };
+    } catch (error) {
+      this.auditLog(
+        `manageWorld:${options?.action}`,
+        { type: options?.type },
+        'failure',
+        error instanceof Error ? error.message : 'Unknown error'
+      );
+      throw new Error(
+        `Failed to ${options?.action ?? 'manage'} world: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+
+  // ===== ROLL TABLES AND MACROS =====
+
+  private tableSummary(table: any, withResults: boolean): Record<string, any> {
+    return {
+      id: table.id,
+      name: table.name,
+      formula: table.formula,
+      rows: table.results?.contents?.length ?? table.results?.size ?? 0,
+      replacement: table.replacement,
+      folder: table.folder?.name ?? null,
+      ...(withResults
+        ? {
+            description: table.description ?? '',
+            results: ((table.results?.contents || []) as any[]).map(r => ({
+              range: r.range,
+              weight: r.weight,
+              text: r.name,
+              ...(r.description ? { description: r.description } : {}),
+            })),
+          }
+        : {}),
+    };
+  }
+
+  /**
+   * Create, update, list, describe and roll on roll tables. Deleting goes through manage-world.
+   */
+  async manageRollTables(options: {
+    action: 'create' | 'update' | 'list' | 'describe' | 'roll';
+    table?: string;
+    name?: string;
+    description?: string;
+    formula?: string;
+    results?: Array<Record<string, any>>;
+    replacement?: boolean;
+    display_roll?: boolean;
+    folder?: string;
+    times?: number;
+    to_chat?: boolean;
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      const action = options.action;
+      const known = ['create', 'update', 'list', 'describe', 'roll'];
+      if (!known.includes(action)) {
+        throw new Error(`Unknown action: ${String(action)} (${known.join(' | ')})`);
+      }
+      const tables = (((game as any).tables?.contents || []) as any[]);
+
+      if (action === 'list') {
+        return { success: true, tables: tables.map(t => this.tableSummary(t, false)) };
+      }
+      if (action === 'describe') {
+        if (!options.table) throw new Error('table (id or exact name) is required');
+        return { success: true, table: this.tableSummary(this.findWorldDocument('RollTable', options.table), true) };
+      }
+
+      if (action === 'roll') {
+        if (!options.table) throw new Error('table (id or exact name) is required');
+        const gate = permissionManager.checkWritePermission('createChatMessage');
+        const toChat = options.to_chat !== false;
+        if (toChat && !gate.allowed) throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${gate.reason}`);
+        const times = options.times === undefined ? 1 : options.times;
+        if (!Number.isInteger(times) || times < 1 || times > 20) throw new Error('times must be 1 to 20');
+        const table = this.findWorldDocument('RollTable', options.table);
+        const rolled: Array<Record<string, any>> = [];
+        for (let i = 0; i < times; i++) {
+          const draw = await table.draw({ displayChat: toChat, rollMode: toChat ? rollModeName('gm') : undefined });
+          rolled.push({
+            roll: draw.roll?.total ?? null,
+            results: ((draw.results || []) as any[]).map(r => ({ text: r.name, description: r.description || undefined })),
+          });
+        }
+        return { success: true, action, table: { id: table.id, name: table.name }, rolled, toChat };
+      }
+
+      const gate = permissionManager.checkWritePermission('modifyWorld');
+      if (!gate.allowed) throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${gate.reason}`);
+
+      const folderId =
+        options.folder !== undefined
+          ? await this.getOrCreateFolder(options.folder, 'RollTable' as any)
+          : undefined;
+
+      if (action === 'create') {
+        if (typeof options.name !== 'string' || !options.name.trim()) throw new Error('name is required');
+        const built = buildTableResults(options.results);
+        const table = await (globalThis as any).RollTable.create({
+          name: options.name.trim(),
+          description: options.description ?? '',
+          formula: options.formula ?? built.formula,
+          replacement: options.replacement ?? true,
+          displayRoll: options.display_roll ?? true,
+          results: built.results,
+          ...(folderId ? { folder: folderId } : {}),
+        });
+        this.auditLog('manageRollTables:create', { name: options.name }, 'success');
+        return { success: true, action, table: this.tableSummary(table, false) };
+      }
+
+      // update
+      if (!options.table) throw new Error('table (id or exact name) is required');
+      const table = this.findWorldDocument('RollTable', options.table);
+      const patch: Record<string, any> = {};
+      if (options.name !== undefined) patch.name = options.name;
+      if (options.description !== undefined) patch.description = options.description;
+      if (options.formula !== undefined) patch.formula = options.formula;
+      if (options.replacement !== undefined) patch.replacement = options.replacement;
+      if (options.display_roll !== undefined) patch.displayRoll = options.display_roll;
+      if (folderId !== undefined) patch.folder = folderId;
+      let built: ReturnType<typeof buildTableResults> | undefined;
+      if (options.results !== undefined) {
+        built = buildTableResults(options.results);
+        if (options.formula === undefined) patch.formula = built.formula;
+      }
+      if (Object.keys(patch).length === 0 && !built) throw new Error('Nothing to update');
+      if (Object.keys(patch).length > 0) await table.update(patch);
+      if (built) {
+        const old = ((table.results?.contents || []) as any[]).map(r => r.id);
+        if (old.length > 0) await table.deleteEmbeddedDocuments('TableResult', old);
+        await table.createEmbeddedDocuments('TableResult', built.results);
+      }
+      this.auditLog('manageRollTables:update', { id: table.id }, 'success');
+      return { success: true, action, table: this.tableSummary(table, false) };
+    } catch (error) {
+      this.auditLog(`manageRollTables:${options?.action}`, { table: options?.table }, 'failure', error instanceof Error ? error.message : 'Unknown error');
+      throw new Error(
+        `Failed to ${options?.action ?? 'manage'} roll table: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+
+  /**
+   * Create, update, list, describe and run macros. Deleting goes through manage-world.
+   * Script macros run in the GM's browser with the GM's permissions.
+   */
+  async manageMacros(options: {
+    action: 'create' | 'update' | 'list' | 'describe' | 'execute';
+    macro?: string;
+    name?: string;
+    type?: string;
+    command?: string;
+    img?: string;
+    folder?: string;
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      const action = options.action;
+      const known = ['create', 'update', 'list', 'describe', 'execute'];
+      if (!known.includes(action)) {
+        throw new Error(`Unknown action: ${String(action)} (${known.join(' | ')})`);
+      }
+      const summary = (m: any, full: boolean) => ({
+        id: m.id,
+        uuid: m.uuid ?? `Macro.${m.id}`,
+        name: m.name,
+        type: m.type,
+        folder: m.folder?.name ?? null,
+        ...(full ? { command: m.command } : {}),
+      });
+
+      if (action === 'list') {
+        return { success: true, macros: (((game as any).macros?.contents || []) as any[]).map(m => summary(m, false)) };
+      }
+      if (action === 'describe') {
+        if (!options.macro) throw new Error('macro (id or exact name) is required');
+        return { success: true, macro: summary(this.findWorldDocument('Macro', options.macro), true) };
+      }
+
+      const gate = permissionManager.checkWritePermission('modifyWorld');
+      if (!gate.allowed) throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${gate.reason}`);
+
+      if (action === 'execute') {
+        if (!options.macro) throw new Error('macro (id or exact name) is required');
+        const macro = this.findWorldDocument('Macro', options.macro);
+        const result = await macro.execute();
+        this.auditLog('manageMacros:execute', { id: macro.id }, 'success');
+        let returned: unknown = null;
+        try {
+          returned = result === undefined ? null : JSON.parse(JSON.stringify(result));
+        } catch {
+          returned = String(result);
+        }
+        return { success: true, action, macro: summary(macro, false), returned };
+      }
+
+      const folderId =
+        options.folder !== undefined ? await this.getOrCreateFolder(options.folder, 'Macro' as any) : undefined;
+
+      if (action === 'create') {
+        const data = buildMacroData(options);
+        const macro = await (globalThis as any).Macro.create({ ...data, ...(folderId ? { folder: folderId } : {}) });
+        this.auditLog('manageMacros:create', { name: data.name }, 'success');
+        return { success: true, action, macro: summary(macro, false) };
+      }
+
+      // update
+      if (!options.macro) throw new Error('macro (id or exact name) is required');
+      const macro = this.findWorldDocument('Macro', options.macro);
+      const merged = buildMacroData({
+        name: options.name ?? macro.name,
+        type: options.type ?? macro.type,
+        command: options.command ?? macro.command,
+        img: options.img,
+      });
+      const patch: Record<string, any> = { name: merged.name, type: merged.type, command: merged.command };
+      if (options.img !== undefined) patch.img = options.img;
+      if (folderId !== undefined) patch.folder = folderId;
+      await macro.update(patch);
+      this.auditLog('manageMacros:update', { id: macro.id }, 'success');
+      return { success: true, action, macro: summary(macro, false) };
+    } catch (error) {
+      this.auditLog(`manageMacros:${options?.action}`, { macro: options?.macro }, 'failure', error instanceof Error ? error.message : 'Unknown error');
+      throw new Error(
+        `Failed to ${options?.action ?? 'manage'} macro: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+
+  // ===== FILE BROWSING =====
+
+  /**
+   * List folders and files on the Foundry server (read only): worlds, modules, uploads, music...
+   * Filter by kind (audio, image, video), extension or text, and look a few levels down.
+   */
+  async browseFiles(options: {
+    path?: string;
+    source?: 'data' | 'public';
+    kind?: KindFilter;
+    extensions?: string[];
+    search?: string;
+    depth?: number;
+    limit?: number;
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      const source = options.source ?? 'data';
+      if (source !== 'data' && source !== 'public') throw new Error('source must be "data" or "public"');
+      const root = sanitizeBrowsePath(options.path);
+      const depth = options.depth ?? 0;
+      if (!Number.isInteger(depth) || depth < 0 || depth > MAX_BROWSE_DEPTH) {
+        throw new Error(`depth must be a whole number from 0 to ${MAX_BROWSE_DEPTH}`);
+      }
+      const limit = options.limit ?? DEFAULT_BROWSE_LIMIT;
+      if (!Number.isInteger(limit) || limit < 1 || limit > MAX_BROWSE_LIMIT) {
+        throw new Error(`limit must be a whole number from 1 to ${MAX_BROWSE_LIMIT}`);
+      }
+      if (options.kind !== undefined && !['audio', 'image', 'video', 'all'].includes(options.kind)) {
+        throw new Error('kind must be audio, image, video or all');
+      }
+      if (options.extensions !== undefined && (!Array.isArray(options.extensions) || options.extensions.length > 20)) {
+        throw new Error('extensions must be a list of at most 20 file extensions');
+      }
+      const FilePickerAPI =
+        (globalThis as any).foundry?.applications?.apps?.FilePicker?.implementation ||
+        (globalThis as any).FilePicker;
+      if (!FilePickerAPI) throw new Error('Foundry file picker is not available');
+
+      const filter = {
+        ...(options.kind ? { kind: options.kind } : {}),
+        ...(options.extensions ? { extensions: options.extensions } : {}),
+        ...(options.search ? { search: String(options.search) } : {}),
+      };
+      const folders: Array<{ name: string; path: string }> = [];
+      const files: BrowseFile[] = [];
+      let visited = 0;
+      let truncated = false;
+
+      const walk = async (dir: string, level: number): Promise<void> => {
+        if (visited >= MAX_BROWSE_FOLDERS) {
+          truncated = true;
+          return;
+        }
+        visited++;
+        let listing: any;
+        try {
+          listing = await FilePickerAPI.browse(source, dir, {});
+        } catch (error) {
+          if (level === 0) {
+            throw new Error(`Cannot read folder "${dir || '/'}": ${error instanceof Error ? error.message : 'not found'}`);
+          }
+          return;
+        }
+        for (const d of (listing?.dirs ?? []) as string[]) {
+          const path = decodePath(d);
+          if (folders.length < limit) folders.push({ name: path.split('/').pop() ?? path, path });
+          else truncated = true;
+          if (level < depth) await walk(path, level + 1);
+        }
+        for (const f of (listing?.files ?? []) as string[]) {
+          const file = toBrowseFile(f);
+          if (!matchesFilter(file, filter)) continue;
+          if (files.length >= limit) {
+            truncated = true;
+            continue;
+          }
+          files.push(file);
+        }
+      };
+      await walk(root, 0);
+
+      folders.sort((a, b) => a.path.localeCompare(b.path));
+      files.sort((a, b) => a.path.localeCompare(b.path));
+      return {
+        success: true,
+        source,
+        path: root || '/',
+        depth,
+        folders,
+        files,
+        counts: countByKind(files),
+        ...(truncated ? { truncated: true, note: 'More exists than shown; narrow the path, use search or kind, or raise limit' } : {}),
+      };
+    } catch (error) {
+      throw new Error(`Failed to browse files: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  // ===== ACTOR ART =====
+
+  /**
+   * set-actor-art: give an actor its portrait and token picture, and (by default) change the tokens
+   * already placed on scenes, which otherwise keep the picture they were made with.
+   */
+  async setActorArt(data: { actor: string; img?: string; tokenImg?: string; update_placed?: boolean }): Promise<any> {
+    this.validateFoundryState();
+    const gate = permissionManager.checkWritePermission('createActor', {});
+    if (!gate.allowed) throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${gate.reason}`);
+    try {
+      if (!data?.actor || typeof data.actor !== 'string') throw new Error('actor (id or name) is required');
+      if (!data.img && !data.tokenImg) throw new Error('Give img (portrait) and/or tokenImg (token picture)');
+      for (const [key, value] of Object.entries({ img: data.img, tokenImg: data.tokenImg })) {
+        if (value !== undefined && (typeof value !== 'string' || !value.trim() || /^[a-z]+:\/\//i.test(value))) {
+          throw new Error(`${key} must be a path in the Foundry files, not a web address`);
+        }
+      }
+      const actor = this.findActorByIdentifier(data.actor);
+      if (!actor) throw new Error(`Actor not found: "${data.actor}"`);
+
+      const patch: Record<string, any> = {};
+      if (data.img) patch.img = data.img.trim();
+      if (data.tokenImg) patch['prototypeToken.texture.src'] = data.tokenImg.trim();
+      await actor.update(patch);
+
+      let placed = 0;
+      const scenesTouched: string[] = [];
+      if (data.tokenImg && data.update_placed !== false) {
+        for (const scene of (((game as any).scenes?.contents || []) as any[])) {
+          const tokens = ((scene.tokens?.contents || []) as any[]).filter(t => t.actorId === actor.id);
+          if (tokens.length === 0) continue;
+          await scene.updateEmbeddedDocuments(
+            'Token',
+            tokens.map(t => ({ _id: t.id, 'texture.src': data.tokenImg!.trim() }))
+          );
+          placed += tokens.length;
+          scenesTouched.push(scene.name);
+        }
+      }
+      this.auditLog('setActorArt', { actor: actor.id, placed }, 'success');
+      return {
+        success: true,
+        actor: { id: actor.id, name: actor.name },
+        ...(data.img ? { img: data.img.trim() } : {}),
+        ...(data.tokenImg ? { tokenImg: data.tokenImg.trim() } : {}),
+        tokensUpdated: placed,
+        ...(scenesTouched.length > 0 ? { scenes: scenesTouched } : {}),
+      };
+    } catch (error) {
+      throw new Error(`Failed to set actor art: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  // ===== READING AN IMAGE FILE =====
+
+  /** The bytes of an image in the Foundry files (a scene map, a token), as base64, for editing it. */
+  async readImageFile(data: { path: string }): Promise<any> {
+    this.validateFoundryState();
+    try {
+      const path = typeof data?.path === 'string' ? data.path.trim() : '';
+      if (!path) throw new Error('path is required');
+      if (/^[a-z]+:\/\//i.test(path) || path.includes('..') || path.startsWith('/')) throw new Error('path must be a path in the Foundry files');
+      const ext = (path.split('?')[0]!.split('.').pop() ?? '').toLowerCase();
+      const types: Record<string, string> = { png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', webp: 'image/webp', gif: 'image/gif' };
+      if (!types[ext]) throw new Error('Only png, jpg, webp and gif images can be read');
+      const route = (globalThis as any).foundry?.utils?.getRoute?.(path) ?? `/${path}`;
+      const response = await fetch(route);
+      if (!response.ok) throw new Error(`The file could not be read (HTTP ${response.status})`);
+      const bytes = new Uint8Array(await response.arrayBuffer());
+      if (bytes.length > 30 * 1024 * 1024) throw new Error('The image is larger than 30 MB');
+      let binary = '';
+      for (let i = 0; i < bytes.length; i += 0x8000) binary += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
+      return { success: true, path, mimeType: types[ext], size: bytes.length, imageData: btoa(binary) };
+    } catch (error) {
+      throw new Error(`Failed to read the image: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  // ===== NOTES LEFT ON THE MAP BY THE GM =====
+
+  /** Notes the GM left on scenes (by clicking an object or drawing an area), with what is there now. */
+  async listAnnotations(data: { scene?: string; status?: string }): Promise<any> {
+    this.validateFoundryState();
+    try {
+      const status = data?.status ?? 'open';
+      if (status !== 'all' && !ANNOTATION_STATUSES.includes(status as AnnotationStatus)) throw new Error('status must be open, done, dismissed or all');
+      const scenes: any[] = data?.scene ? [this.findSceneByIdentifier(data.scene)] : (((game as any).scenes?.contents || []) as any[]);
+      const notes: any[] = [];
+      for (const scene of scenes) {
+        const list = readAnnotations(scene).filter(a => status === 'all' || a.status === status);
+        if (list.length === 0) continue;
+        const clickables = sceneClickables(scene);
+        const things = sceneThings(scene);
+        for (const a of list) {
+          const entry: Record<string, any> = {
+            id: a.id,
+            number: a.number,
+            scene: { id: scene.id, name: scene.name },
+            type: a.type,
+            prompt: a.prompt,
+            status: a.status,
+            created: a.created,
+          };
+          if (a.target) {
+            const now = clickables.find(c => c.id === a.target!.id && c.kind === a.target!.kind);
+            entry.target = a.target;
+            entry.stillThere = !!now;
+            if (now) {
+              const t = targetOf(now);
+              if (t.x !== a.target.x || t.y !== a.target.y || t.name !== a.target.name) entry.nowAt = t;
+            }
+          }
+          if (a.area) {
+            entry.area = a.area;
+            entry.inside = summariseArea(things, a.area);
+          }
+          if (a.reply) entry.reply = a.reply;
+          notes.push(entry);
+        }
+      }
+      notes.sort((x, y) => x.created - y.created);
+      return { success: true, status, count: notes.length, notes };
+    } catch (error) {
+      throw new Error(`Failed to list notes: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  /** Mark notes done, dismissed or open again, and leave a reply the GM sees in the notes panel. */
+  async resolveAnnotations(data: { ids: string[]; status?: string; reply?: string }): Promise<any> {
+    this.validateFoundryState();
+    const gate = permissionManager.checkWritePermission('modifyScene', {});
+    if (!gate.allowed) throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${gate.reason}`);
+    try {
+      if (!Array.isArray(data?.ids) || data.ids.length === 0 || data.ids.length > 50) throw new Error('ids must list 1 to 50 note ids');
+      const status = (data.status ?? 'done') as AnnotationStatus;
+      const changed: string[] = [];
+      const missing = new Set(data.ids);
+      for (const scene of (((game as any).scenes?.contents || []) as any[])) {
+        const list = readAnnotations(scene);
+        let touched = false;
+        const next = list.map(a => {
+          if (!missing.has(a.id)) return a;
+          missing.delete(a.id);
+          touched = true;
+          changed.push(a.id);
+          return applyResolve(a, { status, ...(data.reply !== undefined ? { reply: data.reply } : {}) });
+        });
+        if (touched) await writeAnnotations(scene, next);
+      }
+      this.auditLog('resolveAnnotations', { count: changed.length, status }, 'success');
+      return { success: true, status, changed, ...(missing.size ? { notFound: [...missing] } : {}) };
+    } catch (error) {
+      throw new Error(`Failed to update notes: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  /** Remove finished (done or dismissed) notes, from one scene or all. */
+  async clearAnnotations(data: { scene?: string }): Promise<any> {
+    this.validateFoundryState();
+    const gate = permissionManager.checkWritePermission('modifyScene', {});
+    if (!gate.allowed) throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${gate.reason}`);
+    try {
+      const scenes: any[] = data?.scene ? [this.findSceneByIdentifier(data.scene)] : (((game as any).scenes?.contents || []) as any[]);
+      let removed = 0;
+      for (const scene of scenes) {
+        const list = readAnnotations(scene);
+        const keep = list.filter(a => a.status === 'open');
+        if (keep.length !== list.length) {
+          removed += list.length - keep.length;
+          await writeAnnotations(scene, keep);
+        }
+      }
+      this.auditLog('clearAnnotations', { removed }, 'success');
+      return { success: true, removed };
+    } catch (error) {
+      throw new Error(`Failed to clear notes: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  // ===== REVEAL AND HIDE =====
+
+  /**
+   * Show or hide things on a scene for the players, whoever placed them: tokens (by name), lights,
+   * tiles, sounds and drawings (hidden), doors (secret or normal). Can also reset the fog of war
+   * on the scene being viewed.
+   */
+  async revealObjects(data: { scene?: string; reveal?: RevealTarget[]; hide?: RevealTarget[]; reset_fog?: boolean }): Promise<any> {
+    this.validateFoundryState();
+    const gate = permissionManager.checkWritePermission('modifyScene', {});
+    if (!gate.allowed) throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${gate.reason}`);
+    try {
+      const reveal = data?.reveal ?? [];
+      const hide = data?.hide ?? [];
+      if (!Array.isArray(reveal) || !Array.isArray(hide) || reveal.length + hide.length > 100) throw new Error('reveal and hide are lists of at most 100 targets');
+      if (reveal.length + hide.length === 0 && !data?.reset_fog) throw new Error('Give reveal, hide and/or reset_fog');
+      for (const target of [...reveal, ...hide]) {
+        const problem = checkTarget(target);
+        if (problem) throw new Error(problem);
+      }
+      const scene = this.resolveSceneForObjects(data.scene);
+      const size = Number(scene.grid?.size ?? scene.dimensions?.size ?? 100) || 100;
+      const collections: Record<RevealKind, { docs: any; embedded: string }> = {
+        token: { docs: scene.tokens, embedded: 'Token' },
+        light: { docs: scene.lights, embedded: 'AmbientLight' },
+        tile: { docs: scene.tiles, embedded: 'Tile' },
+        sound: { docs: scene.sounds, embedded: 'AmbientSound' },
+        drawing: { docs: scene.drawings, embedded: 'Drawing' },
+        door: { docs: scene.walls, embedded: 'Wall' },
+      };
+      const things: SceneThing[] = [];
+      for (const kind of REVEAL_KINDS) {
+        for (const d of ((collections[kind].docs?.contents || []) as any[])) {
+          if (kind === 'door') {
+            if (!d.door) continue;
+            const c = d.c ?? [0, 0, 0, 0];
+            things.push({ kind, id: d.id, x: (c[0] + c[2]) / 2 / size, y: (c[1] + c[3]) / 2 / size, hidden: d.door === 2 });
+          } else {
+            const wide = kind === 'token' ? Number(d.width ?? 1) / 2 : 0;
+            things.push({
+              kind,
+              id: d.id,
+              ...(d.name ? { name: d.name } : {}),
+              ...(d.actor?.name ? { actorName: d.actor.name } : {}),
+              x: Number(d.x ?? 0) / size + wide,
+              y: Number(d.y ?? 0) / size + (kind === 'token' ? Number(d.height ?? 1) / 2 : 0),
+              hidden: !!d.hidden,
+            });
+          }
+        }
+      }
+
+      const done: Array<{ kind: string; id: string; name?: string; now: 'revealed' | 'hidden' }> = [];
+      const notFound: string[] = [];
+      const writes = new Map<RevealKind, Map<string, Record<string, any>>>();
+      const apply = (targets: RevealTarget[], show: boolean) => {
+        for (const target of targets) {
+          const picked = selectTargets(things, target);
+          if (picked.length === 0) {
+            notFound.push(JSON.stringify(target));
+            continue;
+          }
+          for (const t of picked) {
+            const byId = writes.get(t.kind) ?? new Map<string, Record<string, any>>();
+            byId.set(t.id, revealPatch(t.kind, t.id, show));
+            writes.set(t.kind, byId);
+            done.push({ kind: t.kind, id: t.id, ...(t.name ? { name: t.name } : {}), now: show ? 'revealed' : 'hidden' });
+          }
+        }
+      };
+      apply(reveal, true);
+      apply(hide, false);
+      for (const [kind, byId] of writes) {
+        await scene.updateEmbeddedDocuments(collections[kind].embedded, [...byId.values()]);
+      }
+
+      let fogReset = false;
+      if (data.reset_fog) {
+        const canvasScene = (globalThis as any).canvas?.scene;
+        if (!canvasScene || canvasScene.id !== scene.id) throw new Error('Fog can only be reset on the scene being viewed; open that scene first');
+        await (globalThis as any).canvas.fog?.reset?.();
+        fogReset = true;
+      }
+      this.auditLog('revealObjects', { scene: scene.id, changed: done.length, fogReset }, 'success');
+      return { success: true, scene: { id: scene.id, name: scene.name }, changed: done, ...(notFound.length ? { notFound } : {}), ...(fogReset ? { fogReset } : {}) };
+    } catch (error) {
+      throw new Error(`Failed to reveal or hide: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  // ===== COMBAT CONTROL =====
+
+  /** Bring the combat tracker to the front for the GM; says so when the GM is looking at another scene. */
+  private showCombatTracker(combat: any, scene: any): string | undefined {
+    try {
+      const g = globalThis as any;
+      if (combat?.active === false) void combat.activate?.();
+      if (g.ui?.sidebar && g.ui.sidebar.expanded === false) g.ui.sidebar.expand?.();
+      g.ui?.sidebar?.activateTab?.('combat');
+      g.ui?.combat?.render?.({ force: true });
+      const viewed = g.game?.scenes?.viewed ?? g.canvas?.scene;
+      if (viewed && scene && viewed.id !== scene.id) {
+        return `The GM is viewing "${viewed.name}", not "${scene.name}", so the tracker shows this combat only once that scene is open`;
+      }
+    } catch {
+      // showing the tracker is a convenience; the combat itself is already set up
+    }
+    return undefined;
+  }
+
+  /**
+   * Run the combat tracker: start an encounter from the tokens on a scene, roll initiative, move
+   * through turns and rounds, apply damage and healing, mark defeated, end. Uses Foundry's own
+   * combat, so any tracker module built on it keeps working.
+   */
+  async controlCombat(data: CombatRequest): Promise<any> {
+    this.validateFoundryState();
+    const action = data?.action;
+    const ACTIONS = ['status', 'start', 'add', 'remove', 'roll', 'set_initiative', 'next', 'previous', 'next_round', 'damage', 'heal', 'defeat', 'stabilize', 'death_saves', 'end', 'attack', 'check'];
+    if (!ACTIONS.includes(action as string)) throw new Error(`action must be one of: ${ACTIONS.join(', ')}`);
+    if (action !== 'status') {
+      const gate = permissionManager.checkWritePermission('modifyScene', {});
+      if (!gate.allowed) throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${gate.reason}`);
+    }
+    try {
+      const g = game as any;
+      let combat: any = g.combat ?? g.combats?.active ?? null;
+      const members = () =>
+        ((combat?.combatants?.contents ?? []) as any[]).map(c => ({
+          id: c.id,
+          name: c.name,
+          tokenId: c.tokenId,
+          actorName: c.actor?.name,
+          realName: tokenRealName(c.token),
+          initiative: c.initiative,
+          doc: c,
+        }));
+      const out: Record<string, any> = { success: true, action };
+      const needCombat = () => {
+        if (!combat) throw new Error('There is no combat on this scene yet: use action start');
+        return combat;
+      };
+      const rollFor = async (which: 'missing' | 'npcs' | 'all' | string[]) => {
+        const all = members();
+        let ids: string[];
+        if (Array.isArray(which)) {
+          ids = which.flatMap(n => matchCombatants(all, n).map(c => c.id));
+        } else {
+          ids = all
+            .filter(c => (which === 'all' ? true : which === 'npcs' ? c.doc.isNPC && c.initiative == null : c.initiative == null))
+            .map(c => c.id);
+        }
+        // dnd5e applies one initiative roll to every combatant of the same actor, so identical
+        // monsters (unlinked tokens of one actor) would all share a result. Roll each combatant's own.
+        for (const id of ids) {
+          const combatant: any = members().find(m => m.id === id)?.doc;
+          if (combatant && typeof combatant.getInitiativeRoll === 'function') {
+            const roll = await combatant.getInitiativeRoll();
+            if (!roll._evaluated) await roll.evaluate();
+            await combatant.update({ initiative: roll.total });
+            const speaker = (globalThis as any).ChatMessage?.getSpeaker?.({ token: combatant.token, actor: combatant.actor });
+            await roll.toMessage({ ...(speaker ? { speaker } : {}), flavor: `${combatant.name} rolls for Initiative!` }, { rollMode: rollModeName('gm'), messageMode: 'gm' } as any);
+          } else {
+            await combat.rollInitiative([id]);
+          }
+        }
+        return ids.length;
+      };
+
+      /** Actors for names: combatants first, then tokens on the scene, then world actors. */
+      const resolveNamed = (names: string[]): NamedActor[] => {
+        const result: NamedActor[] = [];
+        let sceneTokens: any[] | undefined;
+        for (const name of names) {
+          const inCombat = combat ? matchCombatants(members(), name) : [];
+          if (inCombat.length > 0) {
+            for (const c of inCombat) if (c.doc.actor) result.push({ name: c.name ?? '?', actor: c.doc.actor, token: c.doc.token });
+            continue;
+          }
+          sceneTokens ??= ((this.resolveSceneForObjects(data.scene).tokens?.contents || []) as any[]);
+          const infos: TokenLike[] = sceneTokens.map(t => ({ id: t.id, name: t.name, actorName: t.actor?.name, realName: tokenRealName(t) }));
+          const { picked } = pickTokens(infos, [name]);
+          for (const p of picked) {
+            const tokenDoc = sceneTokens.find(t => t.id === p.id);
+            if (tokenDoc?.actor) result.push({ name: p.name ?? '?', actor: tokenDoc.actor, token: tokenDoc });
+          }
+          if (picked.length === 0) {
+            const key = name.trim().toLowerCase();
+            const actor = ((g.actors?.contents || []) as any[]).find(a => String(a.name).toLowerCase() === key);
+            if (actor) result.push({ name: actor.name, actor });
+          }
+        }
+        return result;
+      };
+
+      switch (action) {
+        case 'status':
+          return { ...out, combat: compactCombat(combat) };
+
+        case 'start':
+        case 'add': {
+          const scene = this.resolveSceneForObjects(data.scene);
+          if (!combat || (combat.scene?.id && combat.scene.id !== scene.id && action === 'start')) {
+            combat = await (globalThis as any).CONFIG.Combat.documentClass.create({ scene: scene.id, active: true });
+          }
+          const tokenDocs = ((scene.tokens?.contents || []) as any[]);
+          const infos: TokenLike[] = tokenDocs.map(t => ({
+            id: t.id,
+            name: t.name,
+            actorName: t.actor?.name,
+            realName: tokenRealName(t),
+            disposition: t.disposition,
+            player: !!(t.actor?.hasPlayerOwner && t.actor?.type === 'character'),
+          }));
+          const already = new Set(members().map(m => m.tokenId));
+          const { picked, notFound } = pickTokens(infos, data.who?.length ? data.who : ['all']);
+          const fresh = picked.filter(t => !already.has(t.id));
+          if (fresh.length > 0) {
+            await combat.createEmbeddedDocuments(
+              'Combatant',
+              fresh.map(t => {
+                const doc = tokenDocs.find(d => d.id === t.id);
+                return { tokenId: t.id, sceneId: scene.id, actorId: doc?.actorId, hidden: !!doc?.hidden };
+              })
+            );
+          }
+          const rollWhich = data.roll ?? 'missing';
+          if (rollWhich !== 'none') out.rolled = await rollFor(rollWhich);
+          if (action === 'start' && data.begin !== false && !combat.started) await combat.startCombat();
+          if (action === 'start') {
+            // a paused game blocks every player action, so a combat that starts is never paused
+            const g2 = game as any;
+            if (data.begin !== false && g2.paused && typeof g2.togglePause === 'function') {
+              g2.togglePause(false, true);
+              out.unpaused = true;
+            }
+            const note = this.showCombatTracker(combat, scene);
+            if (note) out.note = note;
+          }
+          if (action === 'start' && data.surprised?.length) {
+            const surprised: string[] = [];
+            for (const target of resolveNamed(data.surprised)) if (await markSurprised(target.actor)) surprised.push(target.name);
+            out.surprised = surprised;
+            const unknown = data.surprised.filter(n => resolveNamed([n]).length === 0);
+            if (unknown.length) out.surprisedNotFound = unknown;
+          }
+          out.added = fresh.map(t => t.name);
+          if (picked.length > fresh.length) out.alreadyIn = picked.length - fresh.length;
+          if (notFound.length) out.notFound = notFound;
+          break;
+        }
+
+        case 'remove': {
+          needCombat();
+          const ids: string[] = [];
+          const missing: string[] = [];
+          for (const name of data.names ?? []) {
+            const hit = matchCombatants(members(), name);
+            if (hit.length === 0) missing.push(name);
+            ids.push(...hit.map(c => c.id));
+          }
+          if (ids.length > 0) await combat.deleteEmbeddedDocuments('Combatant', [...new Set(ids)]);
+          out.removed = ids.length;
+          if (missing.length) out.notFound = missing;
+          break;
+        }
+
+        case 'roll': {
+          needCombat();
+          out.rolled = await rollFor(data.names?.length ? data.names : data.roll && data.roll !== 'none' ? data.roll : 'missing');
+          break;
+        }
+
+        case 'set_initiative': {
+          needCombat();
+          const entries = data.initiative ?? [];
+          if (entries.length === 0) throw new Error('set_initiative needs initiative: [{name, value}]');
+          const missing: string[] = [];
+          for (const e of entries) {
+            const hit = matchCombatants(members(), e.name);
+            if (hit.length === 0) missing.push(e.name);
+            for (const c of hit) await combat.setInitiative(c.id, Number(e.value));
+          }
+          if (missing.length) out.notFound = missing;
+          break;
+        }
+
+        case 'next':
+        case 'previous':
+        case 'next_round': {
+          needCombat();
+          if (!combat.started) await combat.startCombat();
+          else if (action === 'next') await combat.nextTurn();
+          else if (action === 'previous') await combat.previousTurn();
+          else await combat.nextRound();
+          break;
+        }
+
+        case 'damage':
+        case 'heal': {
+          const list = data.amounts ?? [];
+          if (list.length === 0) throw new Error(`${action} needs amounts: [{target, amount}]`);
+          const sceneTokens = (this.resolveSceneForObjects(data.scene).tokens?.contents || []) as any[];
+          const applied: Array<Record<string, any>> = [];
+          const missing: string[] = [];
+          for (const entry of list) {
+            const amount = Number(entry.amount);
+            if (!(amount > 0)) throw new Error('amount must be a number above 0');
+            let actors: Array<{ name: string; actor: any }> = [];
+            const inCombat = combat ? matchCombatants(members(), entry.target) : [];
+            if (inCombat.length > 0) actors = inCombat.map(c => ({ name: c.name ?? '?', actor: c.doc.actor }));
+            else {
+              const infos: TokenLike[] = sceneTokens.map(t => ({ id: t.id, name: t.name, actorName: t.actor?.name, realName: tokenRealName(t) }));
+              const { picked } = pickTokens(infos, [entry.target]);
+              actors = picked.map(p => ({ name: p.name ?? '?', actor: sceneTokens.find(t => t.id === p.id)?.actor }));
+            }
+            actors = actors.filter(a => a.actor);
+            if (actors.length === 0) missing.push(entry.target);
+            for (const { name, actor } of actors) {
+              const before = Number(actor.system?.attributes?.hp?.value ?? 0);
+              if (typeof actor.applyDamage === 'function') {
+                await actor.applyDamage(action === 'damage' ? amount : -amount);
+              } else {
+                const hp = actor.system?.attributes?.hp ?? {};
+                const next = action === 'damage' ? Math.max(0, before - amount) : Math.min(Number(hp.max ?? before + amount), before + amount);
+                await actor.update({ 'system.attributes.hp.value': next });
+              }
+              const after = Number(actor.system?.attributes?.hp?.value ?? before);
+              const statuses = action === 'damage' && after <= 0 ? await markDownIfZero(actor) : [];
+              applied.push({ name, hp: `${before} -> ${after}`, ...(after <= 0 ? { down: true } : {}), ...(statuses.length ? { addedStatuses: statuses } : {}) });
+            }
+          }
+          out.applied = applied;
+          if (missing.length) out.notFound = missing;
+          break;
+        }
+
+        case 'attack': {
+          if (!data.attacker) throw new Error('attack needs attacker (a token or actor name)');
+          const [attacker] = resolveNamed([data.attacker]);
+          if (!attacker) throw new Error(`Attacker not found: ${data.attacker}`);
+          const targets = resolveNamed(data.targets ?? []);
+          const missingTargets = (data.targets ?? []).filter(n => !resolveNamed([n]).length);
+          const setTarget = (t: NamedActor | null) => {
+            try {
+              const user = g.user;
+              for (const tok of [...(user.targets ?? [])]) tok.setTarget?.(false, { user, releaseOthers: false, groupSelection: true });
+              t?.token?.object?.setTarget?.(true, { user, releaseOthers: true, groupSelection: true });
+            } catch {
+              // targeting is only a help for the system to know the AC
+            }
+          };
+          // Before rolling: is each target in range, and is it the attacker's turn?
+          const warnings: string[] = [];
+          const longRange = new Set<NamedActor>();
+          const found = pickActivity(attacker.actor, data.item);
+          const range = found ? attackRangeOf(found.item, found.activity) : null;
+          const attackerToken = attacker.token ?? attacker.actor?.getActiveTokens?.(false, true)?.[0] ?? null;
+          if (range && attackerToken) {
+            const outOfRange: string[] = [];
+            for (const t of targets) {
+              const targetToken = t.token ?? t.actor?.getActiveTokens?.(false, true)?.[0] ?? null;
+              if (!targetToken || targetToken.parent?.id !== attackerToken.parent?.id) continue;
+              const grid = attackerToken.parent?.grid ?? {};
+              if (!sameUnits(grid.units, range.units)) continue;
+              const distance = tokenDistance(attackerToken, targetToken, Number(grid.size) || 100, Number(grid.distance) || 5);
+              const verdict = rangeVerdict(distance, range);
+              if (verdict.status === 'out') outOfRange.push(`${t.name} is ${distance} ${range.units} away (${found!.item.name} reaches ${verdict.max} ${range.units})`);
+              else if (verdict.status === 'long') {
+                longRange.add(t);
+                warnings.push(`${t.name} is ${distance} ${range.units} away, beyond the normal range of ${verdict.normal} ${range.units}: rolled with disadvantage`);
+              }
+            }
+            if (outOfRange.length && !data.ignore_range) {
+              throw new Error(`Out of range: ${outOfRange.join('; ')}. Move closer, pick another attack, or pass ignore_range: true`);
+            }
+            if (outOfRange.length) warnings.push(`Out of range (rolled anyway): ${outOfRange.join('; ')}`);
+          }
+          const attackerInCombat = !!combat && members().some(m => (attackerToken && m.tokenId === attackerToken.id) || m.doc.actor === attacker.actor);
+          const turn = turnWarning(combat, { tokenId: attackerToken?.id, actorId: attacker.actor?.id, name: attacker.name }, attackerInCombat);
+          if (turn) warnings.push(turn);
+          if (Number(attacker.actor?.system?.attributes?.hp?.value ?? 0) <= 0 && attacker.actor?.system?.attributes?.hp) warnings.push(`${attacker.name} is at 0 hit points`);
+          for (const t of targets) if (t.actor?.system?.attributes?.hp && Number(t.actor?.system?.attributes?.hp?.value ?? 0) <= 0) warnings.push(`${t.name} was already at 0 hit points`);
+          const result = await performAttack(attacker, targets, {
+            longRange: t => longRange.has(t),
+            setTarget,
+            ...(data.item ? { item: data.item } : {}),
+            ...(data.advantage ? { advantage: true } : {}),
+            ...(data.disadvantage ? { disadvantage: true } : {}),
+            ...(data.apply === false ? { apply: false } : {}),
+            ...(data.public ? { public: true } : {}),
+            ...(data.consume === false ? { consume: false } : {}),
+          });
+          Object.assign(out, result);
+          if (warnings.length) out.warnings = warnings;
+          if (missingTargets.length) out.notFound = missingTargets;
+          break;
+        }
+
+        case 'check': {
+          const named = resolveNamed(data.who ?? []);
+          if (named.length === 0) throw new Error('check needs who: token or actor names');
+          const cfg = (globalThis as any).CONFIG?.DND5E ?? {};
+          const result = await performCheck(
+            named,
+            {
+              ...(data.skill ? { skill: data.skill } : {}),
+              ...(data.ability ? { ability: data.ability } : {}),
+              ...(data.save ? { save: data.save } : {}),
+              ...(data.dc !== undefined ? { dc: data.dc } : {}),
+              ...(data.public ? { public: true } : {}),
+              ...(data.advantage ? { advantage: true } : {}),
+              ...(data.disadvantage ? { disadvantage: true } : {}),
+            },
+            { skills: cfg.skills ?? {}, abilities: cfg.abilities ?? {} }
+          );
+          Object.assign(out, result);
+          break;
+        }
+
+        case 'defeat': {
+          needCombat();
+          const missing: string[] = [];
+          for (const name of data.names ?? []) {
+            const hit = matchCombatants(members(), name);
+            if (hit.length === 0) missing.push(name);
+            for (const c of hit) await c.doc.update({ defeated: data.defeated !== false });
+          }
+          if (missing.length) out.notFound = missing;
+          break;
+        }
+
+        case 'stabilize':
+        case 'death_saves': {
+          const names = data.names ?? [];
+          if (names.length === 0) throw new Error(`${action} needs names`);
+          if (action === 'death_saves' && data.success === undefined && data.failure === undefined) throw new Error('death_saves needs success and/or failure (0 to 3)');
+          const results: Record<string, any>[] = [];
+          const found = resolveNamed(names);
+          for (const t of found) {
+            const r = action === 'stabilize' ? await stabilize(t.actor) : await setDeathSaves(t.actor, { success: data.success, failure: data.failure });
+            if (r.status === 'dead' && combat) {
+              const hit = matchCombatants(members(), t.name)[0];
+              if (hit) await hit.doc.update({ defeated: true });
+            }
+            results.push({ name: t.name, ...r });
+          }
+          out.deathSaves = results;
+          const missingNames = names.filter(n => resolveNamed([n]).length === 0);
+          if (missingNames.length) out.notFound = missingNames;
+          break;
+        }
+
+        case 'end': {
+          needCombat();
+          await combat.delete();
+          this.auditLog('controlCombat', { action }, 'success');
+          return { ...out, ended: true };
+        }
+      }
+      this.auditLog('controlCombat', { action }, 'success');
+      combat = g.combat ?? g.combats?.active ?? combat;
+      return { ...out, combat: compactCombat(combat) };
+    } catch (error) {
+      throw new Error(`Failed to run the combat: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  // ===== CHAT: READ, WAIT, NARRATE =====
+
+  /**
+   * Read the chat log, wait for what players say or roll, or speak as the narrator. Reading returns short
+   * rows plus a marker (the last message id) to pass as since next time, so a table can be followed without
+   * rereading the log.
+   */
+  async controlChat(data: ChatControlRequest): Promise<any> {
+    this.validateFoundryState();
+    const action = data?.action ?? 'read';
+    if (!['read', 'narrate'].includes(action)) throw new Error('action must be read or narrate');
+    if (action === 'narrate') {
+      const gate = permissionManager.checkWritePermission('modifyScene', {});
+      if (!gate.allowed) throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${gate.reason}`);
+    }
+    try {
+      const g = game as any;
+      const userName = (id: string): string | undefined => g.users?.get?.(id)?.name;
+      const all = (): any[] => ((g.messages?.contents || [...(g.messages || [])]) as any[]);
+      const lastId = (): string | undefined => all().at(-1)?.id;
+
+      if (action === 'narrate') {
+        const text = String(data.content ?? '').trim();
+        if (!text) throw new Error('narrate needs content');
+        const whisper = data.whisperTo?.length ? this.resolveWhisperTargets(data.whisperTo) : [];
+        const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
+        const html = text
+          .split(/\n{2,}/)
+          .map(p => `<p>${esc(p).replace(/\n/g, '<br>')}</p>`)
+          .join('');
+        const created = await (globalThis as any).ChatMessage.create({
+          content: html,
+          speaker: { alias: data.speaker?.trim() || 'Narrator' },
+          flags: { [MODULE_ID]: { bridge: true } },
+          ...(whisper.length ? { whisper } : {}),
+        });
+        return { success: true, id: created?.id ?? null, delivery: whisper.length ? 'whisper' : 'public', to: whisper.map(id => userName(id) ?? id), marker: lastId() };
+      }
+
+      const limit = Math.max(1, Math.min(50, Number(data.limit ?? 15)));
+      const from = data.from ?? 'all';
+      const filter = { since: data.since, from, rolls: data.rolls } as const;
+
+      const rows = selectMessages(all(), filter, userName);
+      const shown = rows.slice(-limit);
+      return { success: true, messages: shown, ...(rows.length > shown.length ? { omitted: rows.length - shown.length } : {}), marker: lastId() };
+    } catch (error) {
+      throw new Error(`Chat request failed: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  // ===== PAUSE =====
+
+  /** Pause or unpause the game for everyone, or just report the state when paused is not given. */
+  async setPause(data: { paused?: boolean }): Promise<any> {
+    this.validateFoundryState();
+    const g = game as any;
+    const before = !!g.paused;
+    if (typeof data?.paused === 'boolean') {
+      const gate = permissionManager.checkWritePermission('modifyScene', {});
+      if (!gate.allowed) throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${gate.reason}`);
+      if (data.paused !== before) g.togglePause(data.paused, true);
+    }
+    const now = typeof data?.paused === 'boolean' ? data.paused : before;
+    return { success: true, paused: now, changed: now !== before };
+  }
+
+  // ===== PLUTONIUM (5etools data) =====
+
+  private catalogCache = new Map<string, any[]>();
+  private adventureCache = new Map<string, AdventureSection[]>();
+
+  private plutoniumApi(): any {
+    const mod = (game as any).modules?.get('plutonium');
+    if (!mod?.active || !mod.api) throw new Error('Plutonium is not active in this world: enable it (and libWrapper) first');
+    return mod.api;
+  }
+
+  private static CATALOGS: Record<string, { prop: string; loader: string; key: string; collection: string }> = {
+    creature: { prop: 'monster', loader: 'pGetAllCreatures', key: 'monster', collection: 'actors' },
+    spell: { prop: 'spell', loader: 'pGetAllSpells', key: 'spell', collection: 'items' },
+    item: { prop: 'item', loader: 'pGetItems', key: 'item', collection: 'items' },
+  };
+
+  private async catalogRows(kind: string): Promise<any[]> {
+    const cat = FoundryDataAccess.CATALOGS[kind];
+    if (!cat) throw new Error('kind must be creature, spell or item');
+    const cached = this.catalogCache.get(kind);
+    if (cached) return cached;
+    const data = await this.plutoniumApi().salphar.Vetools[cat.loader]();
+    const rows: any[] = (Array.isArray(data) ? data : data?.[cat.key]) ?? [];
+    this.catalogCache.set(kind, rows);
+    return rows;
+  }
+
+  private catalogLine(kind: string, r: any, inWorld: Set<string>): Record<string, any> {
+    const base: Record<string, any> = { name: r.name, source: r.source };
+    if (kind === 'creature') Object.assign(base, { cr: creatureCr(r), type: creatureType(r) });
+    else if (kind === 'spell') Object.assign(base, { level: r.level, school: r.school });
+    else Object.assign(base, { type: r.type ?? r.typeAlt, rarity: r.rarity });
+    if (inWorld.has(String(r.name).toLowerCase())) base.inWorld = true;
+    return base;
+  }
+
+  /**
+   * Search and import from the 5etools catalogue through Plutonium, so monsters, spells and items
+   * come in fully converted (actions, traits, spells, art), including sources the SRD compendiums lack.
+   */
+  async lookupPlutonium(data: PlutoniumRequest): Promise<any> {
+    this.validateFoundryState();
+    const action = data?.action ?? 'search';
+    if (!['status', 'search', 'import'].includes(action)) throw new Error('action must be status, search or import');
+    if (action === 'import') {
+      const gate = permissionManager.checkWritePermission('modifyScene', {});
+      if (!gate.allowed) throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${gate.reason}`);
+    }
+    try {
+      const mod = (game as any).modules?.get('plutonium');
+      if (action === 'status') {
+        return { success: true, plutonium: { active: !!mod?.active, version: mod?.version ?? null }, kinds: Object.keys(FoundryDataAccess.CATALOGS) };
+      }
+      const api = this.plutoniumApi();
+      const kind = data.kind ?? 'creature';
+      const cat = FoundryDataAccess.CATALOGS[kind];
+      if (!cat) throw new Error('kind must be creature, spell or item');
+      const rows = await this.catalogRows(kind);
+      const g = game as any;
+      const existing = (): any[] => ((g[cat.collection]?.contents || [...(g[cat.collection] || [])]) as any[]);
+
+      if (action === 'search') {
+        const q = String(data.query ?? '').trim();
+        if (!q) throw new Error('search needs a query');
+        const have = new Set(existing().map(d => String(d.name).toLowerCase()));
+        const found = findByName(rows, q, data.source, Math.max(1, Math.min(25, Number(data.limit ?? 10))));
+        return {
+          success: true,
+          kind,
+          query: q,
+          results: found.map(r => this.catalogLine(kind, r, have)),
+          ...(found.length === 0 ? { note: 'No match. Try fewer or different words, or a source filter such as MM.' } : {}),
+        };
+      }
+
+      const wanted = (data.names?.length ? data.names : data.query ? [data.query] : []).slice(0, 20);
+      if (wanted.length === 0) throw new Error('import needs names (or query)');
+      const importer = await api.importer.pGetImporter({ prop: cat.prop });
+      const results: Array<Record<string, any>> = [];
+      for (const spec of wanted) {
+        const [rawName, rawSource] = String(spec).split('|');
+        const name = rawName!.trim();
+        const source = (rawSource ?? data.source)?.trim();
+        const exact = findByName(rows, name, source, 25).filter(r => String(r.name).toLowerCase() === name.toLowerCase());
+        const pick = exact[0];
+        if (!pick) {
+          results.push({ name, error: 'not found', similar: findByName(rows, name, source, 5).map(r => `${r.name} [${r.source}]`) });
+          continue;
+        }
+        const before = new Set(existing().map(d => d.id));
+        try {
+          await importer.pImportEntry(pick, {});
+        } catch (error) {
+          results.push({ name, source: pick.source, error: error instanceof Error ? error.message : String(error) });
+          continue;
+        }
+        const made = existing().filter(d => !before.has(d.id));
+        results.push({
+          name: pick.name,
+          source: pick.source,
+          ...(exact.length > 1 ? { otherSources: exact.slice(1).map(r => r.source) } : {}),
+          created: made.map(d => ({ id: d.id, name: d.name, uuid: d.uuid, folder: d.folder?.name ?? null })),
+          ...(made.length === 0 ? { note: 'Nothing new was created: it may already exist in the world.' } : {}),
+        });
+      }
+      return { success: true, kind, results };
+    } catch (error) {
+      throw new Error(`Plutonium request failed: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  private async adventureIndex(): Promise<any[]> {
+    const idx = await this.plutoniumApi().salphar.Vetools.pGetAdventureIndex();
+    return (Array.isArray(idx) ? idx : idx?.adventure) ?? [];
+  }
+
+  /** An adventure from 5etools: its outline, a text search, or a section read, so scenes can be run from the book. */
+  async readAdventure(data: AdventureRequest): Promise<any> {
+    this.validateFoundryState();
+    const action = data?.action ?? 'outline';
+    if (!['list', 'outline', 'search', 'read'].includes(action)) throw new Error('action must be list, outline, search or read');
+    try {
+      const index = await this.adventureIndex();
+      if (action === 'list') {
+        const q = String(data.query ?? '').toLowerCase();
+        const rows = index.filter(a => !q || `${a.name} ${a.id}`.toLowerCase().includes(q));
+        return { success: true, adventures: rows.slice(0, 60).map(a => ({ id: a.id, name: a.name, level: a.level ? `${a.level.start}-${a.level.end}` : undefined })), total: rows.length };
+      }
+      const id = String(data.adventure ?? 'LMoP');
+      const entry = index.find(a => String(a.id).toLowerCase() === id.toLowerCase());
+      if (!entry) throw new Error(`adventure "${id}" not found: use action list`);
+      let sections = this.adventureCache.get(entry.id);
+      if (!sections) {
+        const loader = (globalThis as any).DataUtil?.loadJSON;
+        if (!loader || !entry._url) throw new Error('the adventure data cannot be loaded here');
+        const json = await (globalThis as any).DataUtil.loadJSON(entry._url);
+        const body = json?.adventureData?.[0]?.data ?? json?.data ?? [];
+        sections = adventureSections(body, entry.contents);
+        this.adventureCache.set(entry.id, sections);
+      }
+
+      if (action === 'outline') {
+        return {
+          success: true,
+          adventure: { id: entry.id, name: entry.name },
+          sections: sections.map(sec => ({ index: sec.index, name: sec.name, chars: sec.text.length, headings: sec.headers.slice(0, 40) })),
+          note: 'Read a part with action read {section: index or name, heading?}.',
+        };
+      }
+      if (action === 'search') {
+        const q = String(data.query ?? '').trim();
+        if (!q) throw new Error('search needs a query');
+        return { success: true, adventure: entry.id, query: q, results: searchSections(sections, q, Math.max(1, Math.min(10, Number(data.limit ?? 6)))) };
+      }
+
+      const key = data.section;
+      const sec =
+        typeof key === 'number' || /^\d+$/.test(String(key ?? ''))
+          ? sections[Number(key)]
+          : sections.find(s => s.name.toLowerCase() === String(key ?? '').toLowerCase()) ?? sections.find(s => s.name.toLowerCase().includes(String(key ?? '').toLowerCase()));
+      if (!sec) throw new Error('read needs section (an index or name from the outline)');
+      let text = sec.text;
+      if (data.heading) {
+        const part = pickHeading(text, String(data.heading));
+        if (!part) throw new Error(`no heading containing "${data.heading}" in ${sec.name}: see the outline headings`);
+        text = part;
+      }
+      const maxChars = Math.max(500, Math.min(15000, Number(data.max_chars ?? 6000)));
+      const clipped = clipText(text, maxChars);
+      return {
+        success: true,
+        adventure: entry.id,
+        section: sec.name,
+        ...(data.heading ? { heading: data.heading } : {}),
+        text: clipped.text,
+        ...(clipped.truncated ? { truncated: true, remainingChars: clipped.remaining, note: 'Use heading to read one part, or a larger max_chars (up to 15000).' } : {}),
+      };
+    } catch (error) {
+      throw new Error(`Adventure lookup failed: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  // ===== RULES LOOKUP =====
+
+  private rulesCache = new Map<string, RulePage[]>();
+
+  /** The text pages of a journal, as searchable plain text. */
+  private async rulePagesOf(journal: any, source: string): Promise<RulePage[]> {
+    const pages: RulePage[] = [];
+    for (const page of ((journal.pages?.contents || []) as any[])) {
+      if (page.type && page.type !== 'text') continue;
+      const html = String(page.text?.content ?? '');
+      let text = htmlToText(html);
+      // Many rules pages are made of embeds of other pages: pull the embedded text in (one level).
+      const embeds = [...html.matchAll(/@Embed\[([^\]\s]+)[^\]]*\]/g)].map(m => m[1]!).slice(0, 12);
+      for (const uuid of embeds) {
+        try {
+          const doc: any = await (globalThis as any).fromUuid(uuid);
+          const parts = doc?.documentName === 'JournalEntry' ? ((doc.pages?.contents || []) as any[]) : doc ? [doc] : [];
+          for (const p of parts) {
+            const t = htmlToText(p.text?.content);
+            if (t) text += (text ? '\n\n' : '') + t;
+          }
+        } catch {
+          /* an embed that cannot be resolved is skipped */
+        }
+      }
+      if (text) pages.push({ uuid: page.uuid, journal: journal.name, page: page.name, source, text });
+    }
+    return pages;
+  }
+
+  /** Journal packs of the game system, and the world's journals about rules (name has rule, house or reference). */
+  private rulesSources(): Array<{ id: string; label: string; kind: 'pack' | 'world' }> {
+    const g = game as any;
+    const system = g.system?.id;
+    const packs = ((g.packs?.contents || [...(g.packs || [])]) as any[])
+      .filter(p => p.documentName === 'JournalEntry' && (!p.metadata?.system || p.metadata.system === system))
+      .map(p => ({ id: p.collection as string, label: (p.metadata?.label ?? p.collection) as string, kind: 'pack' as const }));
+    return [...packs, { id: 'world', label: 'World rules journals', kind: 'world' as const }];
+  }
+
+  /**
+   * Look up rules in the system's own rules journals and in the world's rules journals, so rules are
+   * read from the book and not remembered. search finds pages for a question; read returns a page
+   * (or lists the pages of a journal); sources lists where the rules come from.
+   */
+  async lookupRules(data: RulesRequest): Promise<any> {
+    this.validateFoundryState();
+    const action = data?.action ?? 'search';
+    if (!['search', 'read', 'sources'].includes(action)) throw new Error('action must be search, read or sources');
+    try {
+      const g = game as any;
+      const all = this.rulesSources();
+      if (action === 'sources') {
+        return { success: true, sources: all.map(s => ({ id: s.id, label: s.label })), note: 'Put house rules in a world journal whose name has "rules", "house" or "reference" in it to have them found too.' };
+      }
+
+      if (action === 'read') {
+        const uuids = data.uuids?.length ? data.uuids : data.uuid ? [data.uuid] : [];
+        if (uuids.length === 0 || uuids.length > 5) throw new Error('read needs uuid (or uuids, at most 5) from a search result');
+        const maxChars = Math.max(500, Math.min(12000, Number(data.max_chars ?? 4000)));
+        const results: Array<Record<string, any>> = [];
+        for (const uuid of uuids) {
+          const doc: any = await (globalThis as any).fromUuid(uuid);
+          if (!doc) {
+            results.push({ uuid, error: 'not found' });
+            continue;
+          }
+          if (doc.documentName === 'JournalEntry') {
+            results.push({ uuid, journal: doc.name, pages: ((doc.pages?.contents || []) as any[]).map(p => ({ page: p.name, uuid: p.uuid })), note: 'This is a whole journal: read one of its pages.' });
+            continue;
+          }
+          const text = htmlToText(doc.text?.content);
+          const clipped = clipText(text, maxChars);
+          results.push({ uuid, journal: doc.parent?.name, page: doc.name, text: clipped.text, ...(clipped.truncated ? { truncated: true, remainingChars: clipped.remaining, note: 'Pass a larger max_chars (up to 12000) for the rest.' } : {}) });
+        }
+        return { success: true, results };
+      }
+
+      const query = String(data?.query ?? '').trim();
+      if (!query) throw new Error('search needs a query');
+      const wanted = data.sources?.length ? new Set(data.sources) : null;
+      const pages: RulePage[] = [];
+      const searched: string[] = [];
+      for (const src of all) {
+        if (wanted && !wanted.has(src.id) && !(src.kind === 'world' && wanted.has('world'))) continue;
+        searched.push(src.id);
+        if (src.kind === 'world') {
+          for (const journal of ((g.journal?.contents || []) as any[])) {
+            if (/rule|house|reference|homebrew/i.test(journal.name ?? '')) pages.push(...(await this.rulePagesOf(journal, 'world')));
+          }
+          continue;
+        }
+        let cached = this.rulesCache.get(src.id);
+        if (!cached) {
+          const pack = g.packs.get(src.id);
+          cached = [];
+          for (const journal of (await pack.getDocuments()) as any[]) cached.push(...(await this.rulePagesOf(journal, src.label)));
+          this.rulesCache.set(src.id, cached);
+        }
+        pages.push(...cached);
+      }
+      const hits = searchPages(pages, query, Math.max(1, Math.min(10, Number(data.limit ?? 5))));
+      return {
+        success: true,
+        query,
+        searched,
+        results: hits.map(({ score: _score, ...h }) => h),
+        ...(hits.length === 0 ? { note: 'No page matched. Try other words, or action sources to see what is searched.' } : { note: 'Read a page with action read and its uuid; the snippet is only a hint.' }),
+      };
+    } catch (error) {
+      throw new Error(`Failed to look up the rules: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  // ===== PARTY: RESTS, XP, LEVEL-UPS =====
+
+  /** Look after the party: status, short and long rests, XP awards, and opening the level-up for a character. */
+  async controlParty(data: PartyRequest): Promise<any> {
+    this.validateFoundryState();
+    const action = data?.action;
+    const ACTIONS = ['status', 'rest', 'xp', 'level_up'];
+    if (!ACTIONS.includes(action as string)) throw new Error(`action must be one of: ${ACTIONS.join(', ')}`);
+    if (action !== 'status') {
+      const gate = permissionManager.checkWritePermission('modifyScene', {});
+      if (!gate.allowed) throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${gate.reason}`);
+    }
+    try {
+      const g = game as any;
+      const actors = ((g.actors?.contents || [...(g.actors || [])]) as any[]);
+      const playerOwned = (a: any) => !!a.hasPlayerOwner;
+      const who = action === 'level_up' ? (data.actor ? [data.actor] : []) : data.who;
+      const { picked, notFound } = pickActors(actors, who, playerOwned);
+      const out: Record<string, any> = { success: true, action };
+      if (notFound.length) out.notFound = notFound;
+      if (picked.length === 0 && action !== 'level_up') {
+        return { ...out, note: 'No characters matched. "party" means characters owned by a player; pass names or "all_characters".', party: [] };
+      }
+
+      switch (action) {
+        case 'status':
+          return { ...out, party: picked.map(p => partyRow(p.actor)) };
+
+        case 'rest': {
+          if (data.type !== 'short' && data.type !== 'long') throw new Error('rest needs type: short or long');
+          const rows: Array<Record<string, any>> = [];
+          for (const p of picked) {
+            const before = Number(p.actor.system?.attributes?.hp?.value ?? 0);
+            if (data.type === 'long') await p.actor.longRest({ dialog: false, advanceTime: false, newDay: data.new_day !== false });
+            else await p.actor.shortRest({ dialog: false, advanceTime: false, autoHD: data.spend_hit_dice !== false });
+            const row = partyRow(p.actor);
+            row.hpBefore = before;
+            rows.push(row);
+          }
+          this.auditLog('controlParty', { action, type: data.type, count: rows.length }, 'success');
+          return { ...out, type: data.type, party: rows };
+        }
+
+        case 'xp': {
+          const amount = Number(data.amount);
+          if (!(amount > 0)) throw new Error('xp needs amount above 0');
+          const shares = data.split ? splitXp(amount, picked.length) : picked.map(() => amount);
+          const rows: Array<Record<string, any>> = [];
+          for (let i = 0; i < picked.length; i++) {
+            const actor = picked[i]!.actor;
+            const now = Number(actor.system?.details?.xp?.value ?? 0);
+            await actor.update({ 'system.details.xp.value': now + shares[i]! });
+            rows.push({ ...partyRow(actor), gained: shares[i] });
+          }
+          this.auditLog('controlParty', { action, amount, count: rows.length }, 'success');
+          return { ...out, party: rows };
+        }
+
+        case 'level_up': {
+          const target = picked[0];
+          if (!target) throw new Error('level_up needs actor: the character name');
+          const classItem = pickClass(target.actor, data.class);
+          if (!classItem) throw new Error(`${target.name} has several classes (or none): say which with class`);
+          const manager = (globalThis as any).dnd5e?.applications?.advancement?.AdvancementManager;
+          if (!manager?.forLevelChange) throw new Error('This version of dnd5e has no level-up manager I can open');
+          const flow = await manager.forLevelChange(target.actor, classItem.id, 1);
+          await flow.render({ force: true });
+          this.auditLog('controlParty', { action, actor: target.name }, 'success');
+          return { ...out, actor: target.name, class: classItem.name, opened: true, note: 'The level-up window is open on the GM screen: the choices (hit points, features, ability score improvements) are made there.' };
+        }
+      }
+      return out;
+    } catch (error) {
+      throw new Error(`Failed to manage the party: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  // ===== READING THE TABLE =====
+
+  /**
+   * What is going on at the table, in one call: recent chat (with rolls), the combat tracker,
+   * the party's vitals and who is online. Only the sections asked for are returned.
+   */
+  async readTable(data: { chat?: ChatQuery | boolean; combat?: boolean; party?: boolean; players?: boolean }): Promise<any> {
+    this.validateFoundryState();
+    try {
+      const g = game as any;
+      const userList = ((g.users?.contents || [...(g.users || [])]) as any[]);
+      const userName = (id: string) => userList.find(u => u.id === id)?.name ?? g.users?.get?.(id)?.name;
+      const out: Record<string, any> = { success: true };
+      const wantsAny = data?.chat || data?.combat || data?.party || data?.players;
+      const sections = wantsAny ? data : { chat: true, combat: true, party: true, players: true };
+
+      if (sections.chat) {
+        const query: ChatQuery = typeof sections.chat === 'object' ? sections.chat : {};
+        // the GM sees every message, whispers included; query.whispers:false leaves them out
+        const messages = ((g.messages?.contents || [...(g.messages || [])]) as any[]);
+        out.chat = selectChat(messages, query, userName);
+      }
+      if (sections.combat) {
+        out.combat = combatSummary(g.combat ?? g.combats?.active ?? null);
+      }
+      if (sections.party) {
+        const actors = ((g.actors?.contents || [...(g.actors || [])]) as any[]).filter(
+          a => a.type === 'character' && (a.hasPlayerOwner || Object.entries(a.ownership ?? {}).some(([id, l]) => id !== 'default' && (l as number) >= 3 && userName(id) && !userList.find(u => u.id === id)?.isGM))
+        );
+        out.party = partySummary(actors, userName);
+      }
+      if (sections.players) {
+        out.players = userList.map(u => ({
+          name: u.name,
+          gm: !!u.isGM,
+          online: !!u.active,
+          ...(u.character?.name ? { character: u.character.name } : {}),
+          ...(u.viewedScene ? { viewing: g.scenes?.get?.(u.viewedScene)?.name ?? u.viewedScene } : {}),
+        }));
+      }
+      return out;
+    } catch (error) {
+      throw new Error(`Failed to read the table: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  // ===== SHARING WITH PLAYERS =====
+
+  /**
+   * Show an image full-screen to every player, or open a journal for players. For a journal the
+   * named players (default: everyone) are first given observer access if they have less.
+   */
+  async shareWithPlayers(data: { image?: string; title?: string; journal?: string; users?: string[]; chat?: boolean }): Promise<any> {
+    this.validateFoundryState();
+    const gate = permissionManager.checkWritePermission('modifyScene', {});
+    if (!gate.allowed) throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${gate.reason}`);
+    try {
+      const hasImage = typeof data?.image === 'string' && data.image.trim() !== '';
+      const hasJournal = typeof data?.journal === 'string' && data.journal.trim() !== '';
+      if (hasImage === hasJournal) throw new Error('Give either image or journal (not both)');
+      const g = game as any;
+      if (hasImage) {
+        if (data.users && data.users.length > 0) throw new Error('An image is shown to all players; users only works with a journal');
+        const src = data.image!.trim();
+        if (/^[a-z]+:\/\//i.test(src)) throw new Error('image must be a path in the Foundry files, not a web address');
+        const Popout = (globalThis as any).foundry?.applications?.apps?.ImagePopout ?? (globalThis as any).ImagePopout;
+        if (!Popout) throw new Error('This Foundry version has no image popout');
+        const title = data.title?.trim() || undefined;
+        const popout = new Popout({ src, window: { title: title ?? 'Image' }, caption: title, shareable: true });
+        await popout.render({ force: true });
+        popout.shareImage?.();
+        if (data.chat) {
+          await (globalThis as any).ChatMessage.create({ content: `<p><img src="${src}" style="max-width:100%"></p>${title ? `<p>${title}</p>` : ''}` });
+        }
+        this.auditLog('shareWithPlayers', { image: src }, 'success');
+        return { success: true, shared: 'image', image: src, ...(title ? { title } : {}) };
+      }
+      const entry = this.findJournalByIdentifier(data.journal!.trim());
+      if (!entry) throw new Error(`Journal not found: "${data.journal}"`);
+      const players = ((g.users?.contents || [...(g.users || [])]) as any[]).filter(u => !u.isGM);
+      const wanted = data.users && data.users.length > 0 ? players.filter(u => data.users!.some(n => n === u.id || n === u.name)) : players;
+      if (data.users && data.users.length > 0) {
+        const missing = data.users.filter(n => !players.some(u => u.id === n || u.name === n));
+        if (missing.length > 0) throw new Error(`Player not found: ${missing.map(n => '"' + n + '"').join(', ')}`);
+      }
+      const patch: Record<string, number> = {};
+      for (const user of wanted) {
+        const level = entry.ownership?.[user.id] ?? entry.ownership?.default ?? 0;
+        if (level < 2) patch[user.id] = 2;
+      }
+      if (Object.keys(patch).length > 0) await entry.update({ ownership: { ...patch } });
+      if (typeof entry.show === 'function') await entry.show('text', true);
+      else if (typeof g.socket?.emit === 'function') g.socket.emit('showEntry', entry.uuid, true);
+      else throw new Error('This Foundry version cannot show journals to players');
+      if (data.chat) {
+        await (globalThis as any).ChatMessage.create({ content: `<p>@UUID[${entry.uuid}]{${entry.name}}</p>` });
+      }
+      this.auditLog('shareWithPlayers', { journal: entry.id }, 'success');
+      return { success: true, shared: 'journal', journal: { id: entry.id, name: entry.name }, players: wanted.map(u => u.name), granted: Object.keys(patch).length };
+    } catch (error) {
+      throw new Error(`Failed to share: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  // ===== LOOT: COMPENDIUM ITEMS AND CHESTS =====
+
+  /**
+   * Copy items from the compendium onto an actor, by exact name. A name already on the actor
+   * stacks (its quantity goes up) unless stack is false. Returns what was added, stacked and not found.
+   */
+  private async addCompendiumItemsToActor(
+    actor: any,
+    requests: ItemRequest[],
+    packIds: string[] | undefined,
+    stack: boolean
+  ): Promise<{ added: any[]; stacked: any[]; notFound: string[]; warnings: string[] }> {
+    const warnings: string[] = [];
+    const allPacks = Array.from(((game as any).packs?.values?.() ?? []) as Iterable<any>).filter(
+      (p: any) => p.metadata?.type === 'Item'
+    );
+    const searchOrder = orderPackIds(
+      allPacks.map((p: any) => String(p.collection ?? p.metadata?.id)),
+      packIds
+    );
+
+    // one name index per pack, built when first needed
+    const indexes = new Map<string, Map<string, { id: string; type: string }>>();
+    const indexOf = async (packId: string) => {
+      const have = indexes.get(packId);
+      if (have) return have;
+      const pack = (game as any).packs?.get(packId);
+      if (!pack) {
+        warnings.push(`Compendium pack "${packId}" not found`);
+        indexes.set(packId, new Map());
+        return indexes.get(packId)!;
+      }
+      if (pack.metadata?.type !== 'Item') {
+        warnings.push(`Pack "${packId}" holds ${pack.metadata?.type} documents, not items`);
+        indexes.set(packId, new Map());
+        return indexes.get(packId)!;
+      }
+      if (!pack.indexed) await pack.getIndex({});
+      const map = new Map<string, { id: string; type: string }>();
+      for (const entry of pack.index.values() as IterableIterator<any>) {
+        const key = String(entry.name ?? '').toLowerCase();
+        if (key && !map.has(key)) map.set(key, { id: String(entry._id), type: String(entry.type ?? '') });
+      }
+      indexes.set(packId, map);
+      return map;
+    };
+
+    const added: any[] = [];
+    const stacked: any[] = [];
+    const notFound: string[] = [];
+
+    for (const request of requests) {
+      const key = request.name.toLowerCase();
+      let hit: { packId: string; id: string } | null = null;
+      for (const packId of request.pack ? [request.pack] : searchOrder) {
+        const entry = (await indexOf(packId)).get(key);
+        if (!entry) continue;
+        // without a named pack only things that can be carried count (not a spell or feature of the same name)
+        if (!request.pack && !LOOT_ITEM_TYPES.includes(entry.type)) continue;
+        hit = { packId, id: entry.id };
+        break;
+      }
+      if (!hit) {
+        notFound.push(request.name);
+        continue;
+      }
+      const document = await (game as any).packs.get(hit.packId).getDocument(hit.id);
+      if (!document) {
+        notFound.push(request.name);
+        continue;
+      }
+      const data = document.toObject() as Record<string, any>;
+      delete data._id;
+
+      const existing = stack
+        ? ((actor.items?.contents ?? []) as any[]).find(
+            i => String(i.name).toLowerCase() === key && i.type === data.type && typeof i.system?.quantity === 'number'
+          )
+        : undefined;
+      if (existing) {
+        const quantity = (existing.system.quantity as number) + request.quantity;
+        await existing.update({ 'system.quantity': quantity });
+        stacked.push({ name: existing.name, quantity, pack: hit.packId, itemId: existing.id });
+        continue;
+      }
+      if (typeof data.system?.quantity === 'number' || request.quantity > 1) {
+        data.system = { ...(data.system ?? {}), quantity: request.quantity };
+      }
+      const [created] = (await actor.createEmbeddedDocuments('Item', [data])) as any[];
+      added.push({ name: created?.name ?? request.name, quantity: request.quantity, pack: hit.packId, itemId: created?.id });
+    }
+    return { added, stacked, notFound, warnings };
+  }
+
+  /** add-compendium-items: put compendium items (by exact name) on an actor, a chest, a party stash. */
+  async addCompendiumItems(data: { actor: string; items: unknown; packs?: string[]; stack?: boolean }): Promise<any> {
+    this.validateFoundryState();
+    const gate = permissionManager.checkWritePermission('createActor', {});
+    if (!gate.allowed) throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${gate.reason}`);
+    try {
+      if (!data?.actor || typeof data.actor !== 'string') throw new Error('actor (id or name) is required');
+      const requests = parseItemRequests(data.items);
+      const actor = this.findActorByIdentifier(data.actor);
+      if (!actor) throw new Error(`Actor not found: "${data.actor}"`);
+      if (data.packs !== undefined && (!Array.isArray(data.packs) || data.packs.some(p => typeof p !== 'string'))) {
+        throw new Error('packs must be a list of pack ids');
+      }
+      const result = await this.addCompendiumItemsToActor(actor, requests, data.packs, data.stack !== false);
+      this.auditLog('addCompendiumItems', { actor: actor.id, count: requests.length }, 'success');
+      return { success: true, actor: { id: actor.id, name: actor.name }, ...result };
+    } catch (error) {
+      throw new Error(`Failed to add compendium items: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  /**
+   * make-chest: a stash of loot as an actor (a group in dnd5e), with currency, compendium items and
+   * made-up items, and who can open it. The token is placed by the server tool.
+   */
+  async makeChest(data: {
+    name: string;
+    type?: string;
+    img?: string;
+    folder?: string;
+    ownership?: string;
+    currency?: unknown;
+    items?: unknown;
+    custom_items?: unknown;
+    packs?: string[];
+  }): Promise<any> {
+    this.validateFoundryState();
+    const gate = permissionManager.checkWritePermission('createActor', {});
+    if (!gate.allowed) throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${gate.reason}`);
+    try {
+      if (!data?.name || typeof data.name !== 'string' || !data.name.trim()) throw new Error('name is required');
+      // check everything before creating anything
+      const currency = parseCurrency(data.currency);
+      const requests = data.items === undefined ? [] : parseItemRequests(data.items);
+      const custom = parseCustomItems(data.custom_items);
+      const level = ownershipLevel(data.ownership ?? 'observer');
+      const type = data.type ?? 'group';
+      const chestImg = data.img ?? 'icons/containers/chest/chest-reinforced-steel-brown.webp';
+
+      const created = await this.createActors({
+        actors: [
+          {
+            name: data.name.trim(),
+            type,
+            img: chestImg,
+            tokenImg: chestImg,
+            ...(Object.keys(currency).length > 0 ? { system: { currency } } : {}),
+          },
+        ],
+        ...(data.folder ? { folder: data.folder } : { folder: 'Loot' }),
+      });
+      const actor = (game as any).actors?.get(created.created[0]!.id);
+      if (!actor) throw new Error('The chest was created but could not be found again');
+      await actor.update({ 'ownership.default': level });
+
+      const steps: string[] = [];
+      if (custom.length > 0) {
+        await actor.createEmbeddedDocuments(
+          'Item',
+          custom.map(c => ({
+            name: c.name,
+            type: c.type,
+            system: {
+              quantity: c.quantity,
+              ...(c.price ? { price: c.price } : {}),
+              ...(c.description ? { description: { value: c.description } } : {}),
+            },
+          }))
+        );
+        steps.push(`${custom.length} made-up item(s) added`);
+      }
+      let report: any = { added: [], stacked: [], notFound: [], warnings: [] };
+      if (requests.length > 0) {
+        report = await this.addCompendiumItemsToActor(actor, requests, data.packs, true);
+        steps.push(`${report.added.length + report.stacked.length} compendium item(s) added`);
+      }
+      this.auditLog('makeChest', { actor: actor.id, items: requests.length + custom.length }, 'success');
+      return {
+        success: true,
+        actor: { id: actor.id, name: actor.name, type },
+        ownership: data.ownership ?? 'observer',
+        currency,
+        steps,
+        added: report.added,
+        stacked: report.stacked,
+        notFound: report.notFound,
+        warnings: report.warnings,
+      };
+    } catch (error) {
+      throw new Error(`Failed to make the chest: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  // ===== WORLD AUDIT =====
+
+  /** Read-only checklist of what is missing or broken across the world's scenes, playlists and actors. */
+  async auditWorld(options: { scene?: string; include_backups?: boolean } = {}): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      const g: any = game;
+      const resolveUuid = (uuid: string): any => {
+        try {
+          return (globalThis as any).fromUuidSync?.(uuid) ?? null;
+        } catch {
+          return null;
+        }
+      };
+      const playlistIds = new Set((((g.playlists?.contents || []) as any[]).map(p => p.id)));
+      const actorIds = new Set((((g.actors?.contents || []) as any[]).map(a => a.id)));
+      let sceneDocs = (g.scenes?.contents || []) as any[];
+      if (options.scene) {
+        const one = this.findSceneByIdentifier(options.scene);
+        sceneDocs = sceneDocs.filter(s => s.id === one.id);
+      }
+      const size = (c: any): number => c?.size ?? c?.contents?.length ?? 0;
+      const scenes: AuditScene[] = sceneDocs.map(scene => {
+        const walls = (scene.walls?.contents || []) as any[];
+        const tokens = (scene.tokens?.contents || []) as any[];
+        const levels = (scene.levels?.contents || []) as any[];
+        const musicPlaylist = scene.playlist?.id ?? (typeof scene.playlist === 'string' ? scene.playlist : null);
+        const teleports: AuditTeleport[] = [];
+        for (const region of (scene.regions?.contents || []) as any[]) {
+          for (const b of (region.behaviors?.contents || []) as any[]) {
+            if (b.type !== 'teleportToken') continue;
+            const destinations = teleportDestinations(b);
+            teleports.push({
+              region: region.name,
+              behaviorId: b.id,
+              hidden: !!region.hidden,
+              disabled: !!b.disabled,
+              destinations,
+              resolved: destinations.map(d => !!resolveUuid(d)),
+            });
+          }
+        }
+        return {
+          id: scene.id,
+          name: scene.name,
+          isBackup: !!readBackupFlag(scene.flags, this.moduleId),
+          active: !!scene.active,
+          navigation: !!scene.navigation,
+          hasBackground: !!(scene.background?.src || levels.some(l => l.background?.src)),
+          walls: walls.length,
+          doors: walls.filter(w => (w.door ?? 0) > 0).length,
+          tokens: tokens.length,
+          tokensWithoutActor: tokens.filter(t => t.actorId && !actorIds.has(t.actorId)).length,
+          lights: size(scene.lights),
+          sounds: size(scene.sounds),
+          notes: size(scene.notes),
+          tiles: size(scene.tiles),
+          regions: size(scene.regions),
+          musicPlaylist,
+          musicPlaylistExists: !musicPlaylist || playlistIds.has(musicPlaylist),
+          teleports,
+          brokenPins: ((scene.notes?.contents || []) as any[]).filter(n => {
+            if (!n.entryId) return false;
+            const journal = g.journal?.get?.(n.entryId);
+            if (!journal) return true;
+            return !!n.pageId && !journal.pages?.get?.(n.pageId);
+          }).length,
+          darkness: Number(scene.environment?.darknessLevel ?? scene.darkness ?? 0),
+          tokenVision: !!(scene.tokenVision ?? true),
+          globalLight: !!(scene.environment?.globalLight?.enabled ?? scene.globalLight ?? false),
+        };
+      });
+      const snapshot: AuditSnapshot = {
+        scenes: options.include_backups ? scenes.map(s => ({ ...s, isBackup: false })) : scenes,
+        playlists: (((g.playlists?.contents || []) as any[]).map(p => ({ id: p.id, name: p.name, soundCount: size(p.sounds) }))),
+        actorCount: actorIds.size,
+        actors: (((g.actors?.contents || []) as any[]).map(a => ({
+          id: a.id,
+          name: a.name,
+          type: a.type,
+          hasImage: !isDefaultActorImage(a.img),
+          hasPlayerOwner: Object.entries(a.ownership ?? {}).some(
+            ([userId, level]) => userId !== 'default' && Number(level) >= 3 && !g.users?.get?.(userId)?.isGM
+          ),
+        })) as AuditActor[]),
+      };
+      const result = auditSnapshot(snapshot);
+      return {
+        success: true,
+        world: g.world?.title ?? g.world?.id,
+        ...result,
+        ...(scenes.some(s => s.isBackup) && !options.include_backups
+          ? { backupScenesSkipped: scenes.filter(s => s.isBackup).length }
+          : {}),
+      };
+    } catch (error) {
+      throw new Error(`Failed to audit the world: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  // ===== SCENE BACKUPS =====
+
+  private sceneCounts(scene: any): Record<string, number> {
+    const counts: Record<string, number> = {};
+    for (const [collection] of RESTORE_COLLECTIONS) {
+      const c = scene?.[collection];
+      counts[collection] = c?.size ?? c?.contents?.length ?? 0;
+    }
+    return counts;
+  }
+
+  private backupFolder(): any {
+    return ((game as any).folders?.contents || []).find((f: any) => f.type === 'Scene' && f.name === BACKUP_FOLDER_NAME);
+  }
+
+  private async ensureBackupFolder(): Promise<any> {
+    const existing = this.backupFolder();
+    if (existing) return existing;
+    return await (globalThis as any).Folder.create({ name: BACKUP_FOLDER_NAME, type: 'Scene' });
+  }
+
+  private backupInfo(scene: any): Record<string, any> {
+    const flag = readBackupFlag(scene.flags, this.moduleId);
+    return {
+      id: scene.id,
+      name: scene.name,
+      ...(flag ? { of: flag.of, originalName: flag.name, at: flag.at, ...(flag.label ? { label: flag.label } : {}) } : {}),
+      counts: this.sceneCounts(scene),
+    };
+  }
+
+  private findBackupScene(identifier: string | undefined, exactOnly = false): any {
+    if (!identifier) throw new Error('backup (id or exact name of a backup scene) is required');
+    const all = (((game as any).scenes?.contents || []) as any[]).filter(s => readBackupFlag(s.flags, this.moduleId));
+    const exact = all.filter(s => s.id === identifier || s.name === identifier);
+    if (exact.length === 1) return exact[0];
+    if (exact.length > 1) throw new Error(`Several backups are named "${identifier}"; use the id`);
+    if (exactOnly) throw new Error(`No backup has the id or exact name "${identifier}" (list shows them; delete needs an exact match)`);
+    const partial = all.filter(s => s.name.toLowerCase().includes(identifier.toLowerCase()));
+    if (partial.length === 1) return partial[0];
+    throw new Error(
+      partial.length > 1
+        ? `"${identifier}" matches ${partial.length} backups; use the id (list shows them)`
+        : `No backup matches "${identifier}" (list shows the backups; only scenes this tool made as backups count)`
+    );
+  }
+
+  /**
+   * Copies of scenes kept in a Backups folder: backup (a full copy with everything on it), list,
+   * restore (put a backup's contents back into the original scene, keeping its id so links
+   * still work; makes a safety copy first) and delete (backups only).
+   */
+  async manageSceneBackups(options: {
+    action: 'backup' | 'list' | 'restore' | 'delete';
+    scene?: string;
+    backup?: string;
+    label?: string;
+    confirm?: boolean;
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      const action = options.action;
+      if (!['backup', 'list', 'restore', 'delete'].includes(action)) {
+        throw new Error(`Unknown action: ${String(action)} (backup | list | restore | delete)`);
+      }
+      const scenes = (((game as any).scenes?.contents || []) as any[]);
+
+      if (action === 'list') {
+        let backups = scenes.filter(s => readBackupFlag(s.flags, this.moduleId));
+        if (options.scene) {
+          const original = this.findSceneByIdentifier(options.scene);
+          backups = backups.filter(s => {
+            const flag = readBackupFlag(s.flags, this.moduleId)!;
+            return flag.of === original.id;
+          });
+        }
+        const items = backups.map(s => this.backupInfo(s)).sort((a, b) => String(b.at).localeCompare(String(a.at)));
+        return { success: true, total: items.length, backups: items };
+      }
+
+      const gate = permissionManager.checkWritePermission('modifyScene', {});
+      if (!gate.allowed) throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${gate.reason}`);
+
+      const makeBackup = async (scene: any, label?: string): Promise<any> => {
+        if (readBackupFlag(scene.flags, this.moduleId)) throw new Error('That scene is itself a backup; back up the original');
+        const now = new Date();
+        const folder = await this.ensureBackupFolder();
+        const name = backupName(scene.name, now, label);
+        const flag = { of: scene.id, name: scene.name, at: now.toISOString(), ...(label ? { label } : {}) };
+        const copy = await scene.clone(
+          {
+            name,
+            folder: folder.id,
+            active: false,
+            navigation: false,
+            flags: { ...(scene.flags ?? {}), [this.moduleId]: { ...(scene.flags?.[this.moduleId] ?? {}), sceneBackup: flag } },
+          },
+          { save: true }
+        );
+        if (!copy) throw new Error('Foundry did not create the copy');
+        this.auditLog('manageSceneBackups:backup', { scene: scene.id, backup: copy.id }, 'success');
+        return copy;
+      };
+
+      if (action === 'backup') {
+        const scene = this.resolveSceneForObjects(options.scene);
+        const copy = await makeBackup(scene, options.label ? backupLabel(options.label) : undefined);
+        return {
+          success: true,
+          action,
+          scene: { id: scene.id, name: scene.name },
+          backup: this.backupInfo(copy),
+          note: 'A full copy was made in the Backups folder. Layout files are kept apart (layout list shows them).',
+        };
+      }
+
+      if (action === 'delete') {
+        const backup = this.findBackupScene(options.backup, true);
+        if (options.confirm !== true) {
+          return { success: true, dryRun: true, wouldDelete: this.backupInfo(backup), note: 'Pass confirm: true to delete this backup.' };
+        }
+        const info = this.backupInfo(backup);
+        await backup.delete();
+        this.auditLog('manageSceneBackups:delete', { backup: info.id }, 'success');
+        return { success: true, action, deleted: info };
+      }
+
+      // restore
+      const backup = this.findBackupScene(options.backup);
+      const flag = readBackupFlag(backup.flags, this.moduleId)!;
+      const target = options.scene ? this.findSceneByIdentifier(options.scene) : scenes.find(s => s.id === flag.of);
+      if (!target) {
+        throw new Error(`The original scene of this backup no longer exists; pass scene (the scene to restore into)`);
+      }
+      if (readBackupFlag(target.flags, this.moduleId)) throw new Error('Cannot restore into another backup');
+      const source = backup.toObject();
+      const plan = buildRestorePlan(source, this.sceneCounts(target));
+      if (options.confirm !== true) {
+        return {
+          success: true,
+          dryRun: true,
+          restoreInto: { id: target.id, name: target.name },
+          from: this.backupInfo(backup),
+          changes: summarisePlan(plan),
+          note: 'Nothing was changed. Pass confirm: true to restore; the current state is backed up first so this can be undone.',
+        };
+      }
+
+      const safety = await makeBackup(target, 'before restore');
+      const levelIds = new Set<string>(((target.levels?.contents || []) as any[]).map(l => l.id));
+      const warnings: string[] = [];
+      await target.update(plan.fields);
+      for (const entry of plan.embedded) {
+        const existing = ((target[entry.collection]?.contents || []) as any[]).map(d => d.id);
+        if (existing.length > 0) await target.deleteEmbeddedDocuments(entry.documentName, existing);
+        const data = entry.add.map(d => {
+          if (typeof d.level === 'string' && levelIds.size > 0 && !levelIds.has(d.level)) {
+            const { level, ...rest } = d;
+            void level;
+            return rest;
+          }
+          return d;
+        });
+        if (data.length > 0) await target.createEmbeddedDocuments(entry.documentName, data);
+      }
+      // Levels hold the picture and their own settings: update them in place, by position.
+      const backupLevels = (Array.isArray(source.levels) ? source.levels : []) as any[];
+      const targetLevels = ((target.levels?.contents || []) as any[]);
+      if (backupLevels.length === targetLevels.length && backupLevels.length > 0) {
+        await target.updateEmbeddedDocuments(
+          'Level',
+          backupLevels.map((l, i) => ({ ...stripForCreate(l), _id: targetLevels[i].id }))
+        );
+      } else if (backupLevels.length !== targetLevels.length) {
+        warnings.push(`The backup has ${backupLevels.length} level(s) and the scene ${targetLevels.length}; levels were left as they are`);
+      }
+      this.auditLog('manageSceneBackups:restore', { backup: backup.id, scene: target.id }, 'success');
+      return {
+        success: true,
+        action,
+        restoredInto: { id: target.id, name: target.name },
+        from: this.backupInfo(backup),
+        safetyBackup: this.backupInfo(safety),
+        changes: summarisePlan(plan),
+        ...(warnings.length ? { warnings } : {}),
+      };
+    } catch (error) {
+      throw new Error(`Failed to manage scene backups: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  // ===== MODULES =====
+
+  /** Modules this tool runs in; never switched off from here. */
+  private static readonly OWN_MODULE_IDS = ['foundry-mcp-bridge-scenes', 'foundry-mcp-bridge'];
+
+  private moduleList(): any[] {
+    const collection = (game as any).modules;
+    return collection ? [...collection.values()] : [];
+  }
+
+  private findModule(id: string | undefined): any {
+    if (!id) throw new Error('module (id) is required');
+    const found = (game as any).modules?.get(id);
+    if (!found) throw new Error(`Module "${id}" is not installed (use list to see the ids)`);
+    return found;
+  }
+
+  private moduleNode(m: any): ModuleNode {
+    const rel = m.relationships ?? m.manifest?.relationships ?? {};
+    return {
+      id: m.id,
+      active: Boolean(m.active),
+      requires: relationIds(rel.requires),
+      conflicts: relationIds(rel.conflicts),
+      installed: true,
+    };
+  }
+
+  private moduleSummary(m: any, full: boolean): Record<string, any> {
+    const node = this.moduleNode(m);
+    const names = (value: any): string[] =>
+      value ? [...(value instanceof Set || Array.isArray(value) ? value : [])].map((x: any) => String(x?.name ?? x)) : [];
+    const out: Record<string, any> = {
+      id: m.id,
+      title: m.title,
+      version: m.version,
+      active: node.active,
+      type: m.type ?? 'module',
+      hasApi: Boolean(m.api),
+    };
+    if (full) {
+      out.description = typeof m.description === 'string' ? m.description.replace(/<[^>]+>/g, '').slice(0, 800) : undefined;
+      out.authors = names(m.authors);
+      out.requires = node.requires;
+      out.conflicts = node.conflicts;
+      out.recommends = relationIds((m.relationships ?? m.manifest?.relationships ?? {}).recommends);
+      out.compatibility = m.compatibility ? serializeValue(m.compatibility) : undefined;
+      out.packs = ((m.packs?.contents ?? (m.packs instanceof Set ? [...m.packs] : Array.isArray(m.packs) ? m.packs : [])) as any[]).map(p => String(p?.name ?? p?.id ?? p)).slice(0, 50);
+      out.url = m.url ?? undefined;
+    }
+    return out;
+  }
+
+  private moduleSettings(id: string): any[] {
+    const registry: Map<string, any> | undefined = (game as any).settings?.settings;
+    if (!registry) return [];
+    const out: any[] = [];
+    for (const [key, setting] of registry) {
+      if (setting?.namespace !== id && !String(key).startsWith(`${id}.`)) continue;
+      let current: unknown;
+      try {
+        current = serializeValue((game as any).settings.get(setting.namespace, setting.key));
+      } catch {
+        current = '[unreadable]';
+      }
+      out.push({
+        key: setting.key,
+        name: setting.name ? (game as any).i18n?.localize?.(setting.name) ?? setting.name : undefined,
+        hint: setting.hint ? String((game as any).i18n?.localize?.(setting.hint) ?? setting.hint).slice(0, 300) : undefined,
+        scope: setting.scope,
+        type: typeof setting.type === 'function' ? setting.type.name : String(setting.type ?? ''),
+        default: serializeValue(setting.default),
+        choices: setting.choices ? serializeValue(setting.choices) : undefined,
+        range: setting.range ? serializeValue(setting.range) : undefined,
+        current,
+      });
+    }
+    return out;
+  }
+
+  /**
+   * Look at the modules installed on this server and use them: list and describe them, read and
+   * change their settings, call functions of their public API, and switch them on or off (which
+   * takes effect after the page is reloaded).
+   */
+  async manageModules(options: {
+    action: 'list' | 'describe' | 'get_setting' | 'set_setting' | 'call' | 'set_active';
+    module?: string;
+    modules?: string[];
+    filter?: 'all' | 'active' | 'inactive';
+    search?: string;
+    key?: string;
+    value?: unknown;
+    path?: string;
+    args?: unknown[];
+    active?: boolean;
+    confirm?: boolean;
+    dry_run?: boolean;
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      const action = options.action;
+      const known = ['list', 'describe', 'get_setting', 'set_setting', 'call', 'set_active'];
+      if (!known.includes(action)) throw new Error(`Unknown action: ${String(action)} (${known.join(' | ')})`);
+
+      if (action === 'list') {
+        const filter = options.filter ?? 'all';
+        const search = options.search?.toLowerCase();
+        const items = this.moduleList()
+          .filter(m => filter === 'all' || (filter === 'active') === Boolean(m.active))
+          .filter(m => !search || `${m.id} ${m.title}`.toLowerCase().includes(search))
+          .map(m => this.moduleSummary(m, false))
+          .sort((a, b) => String(a.title).localeCompare(String(b.title)));
+        return {
+          success: true,
+          total: items.length,
+          active: items.filter(m => m.active).length,
+          modules: items,
+        };
+      }
+
+      if (action === 'describe') {
+        const m = this.findModule(options.module);
+        return {
+          success: true,
+          module: this.moduleSummary(m, true),
+          settings: this.moduleSettings(m.id),
+          api: m.active ? describeApi(m.api) : null,
+          ...(m.active ? {} : { note: 'The module is not active in this world, so it has no API loaded yet' }),
+        };
+      }
+
+      if (action === 'get_setting') {
+        const m = this.findModule(options.module);
+        if (!options.key) throw new Error('key is required');
+        const registered = (game as any).settings?.settings?.has(`${m.id}.${options.key}`);
+        if (!registered) throw new Error(`Module "${m.id}" has no setting "${options.key}" (describe lists them)`);
+        return { success: true, module: m.id, key: options.key, value: serializeValue((game as any).settings.get(m.id, options.key)) };
+      }
+
+      const gate = permissionManager.checkWritePermission('modifyWorld');
+      if (!gate.allowed) throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${gate.reason}`);
+
+      if (action === 'set_setting') {
+        const m = this.findModule(options.module);
+        if (!options.key) throw new Error('key is required');
+        if (options.value === undefined) throw new Error('value is required');
+        const setting = (game as any).settings?.settings?.get(`${m.id}.${options.key}`);
+        if (!setting) throw new Error(`Module "${m.id}" has no setting "${options.key}" (describe lists them)`);
+        const before = serializeValue((game as any).settings.get(m.id, options.key));
+        await (game as any).settings.set(m.id, options.key, options.value);
+        const after = serializeValue((game as any).settings.get(m.id, options.key));
+        this.auditLog('manageModules:set_setting', { module: m.id, key: options.key }, 'success');
+        return { success: true, module: m.id, key: options.key, scope: setting.scope, before, after, ...(setting.requiresReload ? { reloadRequired: true } : {}) };
+      }
+
+      if (action === 'call') {
+        const m = this.findModule(options.module);
+        if (!m.active) throw new Error(`Module "${m.id}" is not active in this world; switch it on with set_active and reload first`);
+        if (!m.api) throw new Error(`Module "${m.id}" has no public API (describe shows what it offers)`);
+        const { fn, self, name } = resolveApiFunction(m.api, options.path);
+        const args = options.args ?? [];
+        if (!Array.isArray(args) || args.length > 20) throw new Error('args must be a list of at most 20 values');
+        const result = await Promise.race([
+          Promise.resolve(fn.apply(self, args)),
+          new Promise((_, reject) => setTimeout(() => reject(new Error('The call took longer than 30 seconds')), 30000)),
+        ]);
+        this.auditLog('manageModules:call', { module: m.id, path: name }, 'success');
+        return { success: true, module: m.id, path: name, returned: serializeValue(result) };
+      }
+
+      // set_active
+      if (!Array.isArray(options.modules) || options.modules.length === 0) throw new Error('modules (a list of ids) is required');
+      if (typeof options.active !== 'boolean') throw new Error('active (true or false) is required');
+      const all = this.moduleList();
+      const plan = planModuleToggle(all.map(m => this.moduleNode(m)), options.modules, options.active, FoundryDataAccess.OWN_MODULE_IDS);
+      if (!plan.ok) return { success: false, error: plan.problems.join('; '), plan };
+      if (plan.change.length === 0) return { success: true, changed: [], unchanged: plan.unchanged, note: 'Nothing to change' };
+      if (options.dry_run || options.confirm !== true) {
+        return {
+          success: true,
+          dryRun: true,
+          wouldChange: plan.change,
+          unchanged: plan.unchanged,
+          note: 'Nothing was changed. Pass confirm: true to apply it; the page must be reloaded afterwards.',
+        };
+      }
+      const config = { ...(((game as any).settings.get('core', 'moduleConfiguration') as Record<string, boolean>) ?? {}) };
+      for (const c of plan.change) config[c.id] = c.active;
+      await (game as any).settings.set('core', 'moduleConfiguration', config);
+      this.auditLog('manageModules:set_active', { changed: plan.change.map(c => `${c.id}=${c.active}`) }, 'success');
+      return {
+        success: true,
+        changed: plan.change,
+        unchanged: plan.unchanged,
+        reloadRequired: true,
+        note: 'Saved. The change takes effect when the Foundry page is reloaded (F5); the connection to this tool drops for a moment.',
+      };
+    } catch (error) {
+      this.auditLog(`manageModules:${options?.action}`, { module: options?.module }, 'failure', error instanceof Error ? error.message : 'Unknown error');
+      throw new Error(`Failed to ${options?.action ?? 'manage'} modules: ${error instanceof Error ? error.message : 'Unknown error'}`);
+    }
+  }
+
+  // ===== SCENE OBJECTS (TOKENS AND LIGHTS PLACED IN GRID SQUARES) =====
+
+  /** The scene named by the caller, or the one the GM is looking at. */
+  private resolveSceneForObjects(identifier?: string): any {
+    if (identifier) return this.findSceneByIdentifier(identifier);
+    const scene = (game.scenes as any)?.viewed ?? (game.scenes as any)?.current;
+    if (!scene) throw new Error('No scene is open; pass scene (id or name)');
+    return scene;
+  }
+
+  private isToolObject(doc: any): boolean {
+    const flags = doc?.flags?.[this.moduleId] ?? doc?.getFlag?.(this.moduleId, CREATED_BY_FLAG);
+    if (flags === true) return true;
+    return !!flags?.[CREATED_BY_FLAG];
+  }
+
+  private findActorForPlacement(identifier: string): any {
+    const actors = (((game as any).actors?.contents || []) as any[]);
+    const byId = actors.find(a => a.id === identifier);
+    if (byId) return byId;
+    const wanted = identifier.trim().toLowerCase();
+    const matches = actors.filter(a => String(a.name ?? '').toLowerCase() === wanted);
+    if (matches.length === 1) return matches[0];
+    if (matches.length > 1) {
+      throw new Error(
+        `Several actors are named "${identifier}" (ids: ${matches.map(a => a.id).join(', ')}); use the id`
+      );
+    }
+    throw new Error(`Actor not found: "${identifier}"`);
+  }
+
+  private describeSceneObjects(scene: any, geom: GridGeometry, kinds: string[]): Record<string, any> {
+    const out: Record<string, any> = {
+      scene: { id: scene.id, name: scene.name },
+      grid: {
+        columns: geom.columns,
+        rows: geom.rows,
+        squarePixels: geom.size,
+        squareDistance: geom.distance,
+        units: geom.units,
+        originPixels: { x: geom.originX, y: geom.originY },
+      },
+    };
+    if (kinds.includes('token')) {
+      out.tokens = (((scene.tokens?.contents || []) as any[]).map(t => ({
+        id: t.id,
+        name: t.name,
+        actorId: t.actorId ?? null,
+        ...pixelsToSquares(geom, t.x, t.y),
+        width: t.width,
+        height: t.height,
+        hidden: !!t.hidden,
+        disposition: t.disposition === -1 ? 'hostile' : t.disposition === 1 ? 'friendly' : t.disposition === 0 ? 'neutral' : 'secret',
+        elevation: t.elevation ?? 0,
+        createdByTool: this.isToolObject(t),
+      })));
+    }
+    if (kinds.includes('light')) {
+      out.lights = (((scene.lights?.contents || []) as any[]).map(l => ({
+        id: l.id,
+        ...pixelsToSquares(geom, l.x, l.y),
+        brightSquares: (l.config?.bright ?? 0) / (geom.distance || 1),
+        dimSquares: (l.config?.dim ?? 0) / (geom.distance || 1),
+        color: l.config?.color ? String(l.config.color) : null,
+        alpha: l.config?.alpha ?? 0.5,
+        angle: l.config?.angle ?? 360,
+        animation: l.config?.animation?.type ?? null,
+        hidden: !!l.hidden,
+        createdByTool: this.isToolObject(l),
+      })));
+    }
+    if (kinds.includes('wall')) {
+      const walls = ((scene.walls?.contents || []) as any[]).map(w => {
+        const a = pixelsToSquares(geom, w.c?.[0], w.c?.[1]);
+        const b = pixelsToSquares(geom, w.c?.[2], w.c?.[3]);
+        return {
+          id: w.id,
+          from: [a.x, a.y],
+          to: [b.x, b.y],
+          door: w.door === 1 ? 'door' : w.door === 2 ? 'secret_door' : null,
+          ...(w.door ? { doorState: w.ds === 1 ? 'open' : w.ds === 2 ? 'locked' : 'closed' } : {}),
+          createdByTool: this.isToolObject(w),
+        };
+      });
+      out.wallCount = walls.length;
+      out.walls = walls.slice(0, 400);
+      if (walls.length > 400) out.wallsTruncated = true;
+    }
+    if (kinds.includes('note')) {
+      out.notes = ((scene.notes?.contents || []) as any[]).map(n => ({
+        id: n.id,
+        ...pixelsToSquares(geom, n.x, n.y),
+        text: n.text ?? '',
+        journalId: n.entryId ?? null,
+        pageId: n.pageId ?? null,
+        createdByTool: this.isToolObject(n),
+      }));
+    }
+    if (kinds.includes('tile')) {
+      out.tiles = ((scene.tiles?.contents || []) as any[]).map(t => ({
+        id: t.id,
+        ...pixelsToSquares(geom, t.x, t.y),
+        width: Math.round((t.width / geom.size) * 100) / 100,
+        height: Math.round((t.height / geom.size) * 100) / 100,
+        src: t.texture?.src ?? null,
+        rotation: t.rotation ?? 0,
+        alpha: t.alpha ?? 1,
+        elevation: t.elevation ?? 0,
+        hidden: !!t.hidden,
+        createdByTool: this.isToolObject(t),
+      }));
+    }
+    if (kinds.includes('sound')) {
+      out.sounds = ((scene.sounds?.contents || []) as any[]).map(s => ({
+        id: s.id,
+        ...pixelsToSquares(geom, s.x, s.y),
+        radiusSquares: Math.round(((s.radius ?? 0) / (geom.distance || 1)) * 100) / 100,
+        path: s.path ?? null,
+        volume: s.volume,
+        repeat: !!s.repeat,
+        walls: s.walls !== false,
+        easing: s.easing !== false,
+        hidden: !!s.hidden,
+        createdByTool: this.isToolObject(s),
+      }));
+    }
+    return out;
+  }
+
+  /**
+   * Place tokens, lights, walls and map pins by grid square, describe what is on a scene, or remove objects
+   * this tool created (never anything else).
+   */
+  async manageSceneObjects(options: {
+    action: 'place' | 'describe' | 'remove' | 'update';
+    scene?: string;
+    objects?: Array<Record<string, any>>;
+    updates?: Array<Record<string, any>>;
+    ids?: string[];
+    all_mine?: boolean;
+    kind?: 'token' | 'light' | 'wall' | 'note' | 'tile' | 'sound';
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      const action = options.action;
+      if (action !== 'place' && action !== 'describe' && action !== 'remove' && action !== 'update') {
+        throw new Error(`Unknown action: ${String(action)} (place | describe | remove | update)`);
+      }
+      const scene = this.resolveSceneForObjects(options.scene);
+      const geom = getGridGeometry(scene);
+
+      if (action === 'describe') {
+        const kinds = options.kind ? [options.kind] : ['token', 'light', 'wall', 'note', 'tile', 'sound'];
+        return { success: true, ...this.describeSceneObjects(scene, geom, kinds) };
+      }
+
+      const permissionCheck = permissionManager.checkWritePermission('modifyScene', {});
+      if (!permissionCheck.allowed) {
+        throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${permissionCheck.reason}`);
+      }
+
+      const flagData = { [this.moduleId]: { [CREATED_BY_FLAG]: true } };
+
+      if (action === 'place') {
+        const specs = options.objects ?? [];
+        if (!Array.isArray(specs) || specs.length === 0) {
+          throw new Error('objects must be a non-empty list');
+        }
+        if (specs.length > 200) throw new Error('At most 200 objects per call');
+
+        const tokenData: any[] = [];
+        const lightData: any[] = [];
+        const wallData: any[] = [];
+        const noteData: any[] = [];
+        const tileData: any[] = [];
+        const soundData: any[] = [];
+        const warnings: string[] = [];
+
+        specs.forEach((spec, index) => {
+          const label = `objects[${index}]`;
+          if (spec.kind === 'light') {
+            const data = buildLightData(spec as any, geom, label);
+            lightData.push({ ...data, flags: flagData });
+          } else if (spec.kind === 'token') {
+            assertInsideScene(geom, spec.x, spec.y, label);
+            if (!spec.actor || typeof spec.actor !== 'string') {
+              throw new Error(`${label}: actor (id or exact name) is required for a token`);
+            }
+            if (spec.x >= geom.columns || spec.y >= geom.rows) {
+              throw new Error(
+                `${label}: a token's x and y are its top-left square (0 to ${geom.columns - 1} across, 0 to ${geom.rows - 1} down)`
+              );
+            }
+            if (spec.disposition !== undefined && ![-1, 0, 1].includes(spec.disposition)) {
+              throw new Error(`${label}: disposition must be -1 (hostile), 0 (neutral) or 1 (friendly)`);
+            }
+            for (const dim of ['width', 'height'] as const) {
+              if (
+                spec[dim] !== undefined &&
+                (typeof spec[dim] !== 'number' || !(spec[dim] >= 0.5 && spec[dim] <= 20))
+              ) {
+                throw new Error(`${label}: ${dim} must be a number of squares from 0.5 to 20`);
+              }
+            }
+            const actor = this.findActorForPlacement(spec.actor);
+            const proto = (actor as any).prototypeToken.toObject();
+            if (proto.texture?.src?.startsWith('http')) proto.texture.src = null;
+            const position = squaresToPixels(geom, spec.x, spec.y);
+            tokenData.push({
+              ...proto,
+              ...(spec.name ? { name: String(spec.name) } : {}),
+              ...(spec.width !== undefined ? { width: spec.width } : {}),
+              ...(spec.height !== undefined ? { height: spec.height } : {}),
+              actorId: actor.id,
+              x: position.x,
+              y: position.y,
+              ...(spec.hidden !== undefined ? { hidden: !!spec.hidden } : {}),
+              ...(spec.disposition !== undefined ? { disposition: spec.disposition } : {}),
+              ...(spec.elevation !== undefined ? { elevation: Number(spec.elevation) } : {}),
+              flags: { ...(proto.flags ?? {}), ...flagData },
+            });
+          } else if (spec.kind === 'wall') {
+            for (const data of buildWallData(spec as any, geom, label)) {
+              wallData.push({ ...data, flags: flagData });
+            }
+            if (wallData.length > MAX_WALL_SEGMENTS) {
+              throw new Error(`At most ${MAX_WALL_SEGMENTS} wall segments per call`);
+            }
+          } else if (spec.kind === 'note') {
+            assertInsideScene(geom, spec.x, spec.y, label);
+            if (!spec.journal || typeof spec.journal !== 'string') {
+              throw new Error(`${label}: journal (id or exact name) is required for a map pin`);
+            }
+            const journal = this.findJournalByIdentifier(spec.journal);
+            let pageId: string | undefined;
+            if (spec.page !== undefined) {
+              const pages = (journal.pages?.contents || []) as any[];
+              const wantedPage = String(spec.page).trim().toLowerCase();
+              const matches = pages.filter(
+                p => p.id === spec.page || String(p.name ?? '').toLowerCase() === wantedPage
+              );
+              if (matches.length === 0) {
+                throw new Error(`${label}: page "${spec.page}" not found in journal "${journal.name}"`);
+              }
+              if (matches.length > 1) {
+                throw new Error(`${label}: several pages match "${spec.page}"; use the page id`);
+              }
+              pageId = matches[0].id;
+            }
+            const position = squaresToPixels(geom, spec.x, spec.y);
+            const size = spec.icon_size === undefined ? 40 : Number(spec.icon_size);
+            const fontSize = spec.font_size === undefined ? 32 : Number(spec.font_size);
+            if (!Number.isFinite(size) || size < 32 || size > 512) {
+              throw new Error(`${label}: icon_size must be a number from 32 to 512`);
+            }
+            if (!Number.isFinite(fontSize) || fontSize < 8 || fontSize > 128) {
+              throw new Error(`${label}: font_size must be a number from 8 to 128`);
+            }
+            noteData.push({
+              x: position.x,
+              y: position.y,
+              entryId: journal.id,
+              ...(pageId ? { pageId } : {}),
+              text: spec.text === undefined ? journal.name : String(spec.text),
+              texture: { src: spec.icon ? String(spec.icon) : 'icons/svg/book.svg' },
+              iconSize: size,
+              fontSize,
+              global: !!spec.global,
+              flags: flagData,
+            });
+          } else if (spec.kind === 'tile') {
+            tileData.push({ ...buildTileData(spec as any, geom, label), flags: flagData });
+          } else if (spec.kind === 'sound') {
+            soundData.push({ ...buildSoundData(spec as any, geom, label), flags: flagData });
+          } else {
+            throw new Error(`${label}: kind must be "token", "light", "wall", "note", "tile" or "sound"`);
+          }
+        });
+
+        const created: Array<{ kind: string; id: string; x: number; y: number }> = [];
+        if (tokenData.length > 0) {
+          const docs = (await scene.createEmbeddedDocuments('Token', tokenData)) as any[];
+          for (const doc of docs ?? []) {
+            created.push({ kind: 'token', id: doc.id, ...pixelsToSquares(geom, doc.x, doc.y) });
+          }
+        }
+        if (lightData.length > 0) {
+          const docs = (await scene.createEmbeddedDocuments('AmbientLight', lightData)) as any[];
+          for (const doc of docs ?? []) {
+            created.push({ kind: 'light', id: doc.id, ...pixelsToSquares(geom, doc.x, doc.y) });
+          }
+        }
+
+        if (wallData.length > 0) {
+          const docs = (await scene.createEmbeddedDocuments('Wall', wallData)) as any[];
+          for (const doc of docs ?? []) {
+            const a = pixelsToSquares(geom, doc.c?.[0], doc.c?.[1]);
+            created.push({ kind: 'wall', id: doc.id, ...a });
+          }
+        }
+        if (noteData.length > 0) {
+          const docs = (await scene.createEmbeddedDocuments('Note', noteData)) as any[];
+          for (const doc of docs ?? []) {
+            created.push({ kind: 'note', id: doc.id, ...pixelsToSquares(geom, doc.x, doc.y) });
+          }
+        }
+
+        if (tileData.length > 0) {
+          const docs = (await scene.createEmbeddedDocuments('Tile', tileData)) as any[];
+          for (const doc of docs ?? []) {
+            created.push({ kind: 'tile', id: doc.id, ...pixelsToSquares(geom, doc.x, doc.y) });
+          }
+        }
+        if (soundData.length > 0) {
+          const docs = (await scene.createEmbeddedDocuments('AmbientSound', soundData)) as any[];
+          for (const doc of docs ?? []) {
+            created.push({ kind: 'sound', id: doc.id, ...pixelsToSquares(geom, doc.x, doc.y) });
+          }
+        }
+
+        this.auditLog('manageSceneObjects:place', { scene: scene.id, count: specs.length }, 'success');
+        return {
+          success: true,
+          action,
+          scene: { id: scene.id, name: scene.name },
+          created,
+          ...(warnings.length > 0 ? { warnings } : {}),
+        };
+      }
+
+      if (action === 'update') {
+        const specs = options.updates ?? [];
+        if (!Array.isArray(specs) || specs.length === 0) throw new Error('updates must be a non-empty list');
+        if (specs.length > 200) throw new Error('At most 200 updates per call');
+        const sceneCollections: Record<string, any> = {
+          token: scene.tokens,
+          light: scene.lights,
+          wall: scene.walls,
+          note: scene.notes,
+          tile: scene.tiles,
+          sound: scene.sounds,
+        };
+        const byKind: Record<string, any[]> = {};
+        const changed: Array<{ kind: string; id: string; changed: string[] }> = [];
+        specs.forEach((spec, index) => {
+          const label = `updates[${index}]`;
+          if (!spec || typeof spec !== 'object' || typeof spec.id !== 'string') throw new Error(`${label}: id is required`);
+          let kind: ObjectKind | undefined;
+          let doc: any;
+          for (const k of Object.keys(sceneCollections) as ObjectKind[]) {
+            if (spec.kind && spec.kind !== k) continue;
+            const found = sceneCollections[k]?.get?.(spec.id);
+            if (found) {
+              kind = k;
+              doc = found;
+              break;
+            }
+          }
+          if (!kind || !doc) throw new Error(`${label}: no ${spec.kind ?? 'object'} with id ${spec.id} on this scene`);
+          if (!this.isToolObject(doc)) {
+            throw new Error(`${label}: ${spec.id} was not created by this tool (only its own objects can be changed)`);
+          }
+          if (kind === 'wall' && !doc.door) throw new Error(`${label}: door_state only applies to doors`);
+          const data = buildObjectUpdate(kind, spec, geom, { x: doc.x, y: doc.y }, label);
+          (byKind[kind] ??= []).push({ _id: doc.id, ...data });
+          changed.push({ kind, id: doc.id, changed: Object.keys(spec).filter(k => k !== 'id' && k !== 'kind') });
+        });
+        for (const [kind, list] of Object.entries(byKind)) {
+          await scene.updateEmbeddedDocuments(OBJECT_DOCUMENT[kind as ObjectKind], list);
+        }
+        this.auditLog('manageSceneObjects:update', { scene: scene.id, count: specs.length }, 'success');
+        return { success: true, action, scene: { id: scene.id, name: scene.name }, updated: changed };
+      }
+
+      // remove: only objects this tool created.
+      const ids = options.ids ?? [];
+      if (!options.all_mine && ids.length === 0) {
+        throw new Error('Pass ids, or all_mine: true, to say what to remove');
+      }
+      const kinds: Array<'token' | 'light' | 'wall' | 'note' | 'tile' | 'sound'> = options.kind
+        ? [options.kind]
+        : ['token', 'light', 'wall', 'note', 'tile', 'sound'];
+      const removed: Array<{ kind: string; id: string }> = [];
+      const skipped: Array<{ id: string; reason: string }> = [];
+      const collections: Record<string, { collection: any; documentName: string }> = {
+        token: { collection: scene.tokens, documentName: 'Token' },
+        light: { collection: scene.lights, documentName: 'AmbientLight' },
+        wall: { collection: scene.walls, documentName: 'Wall' },
+        note: { collection: scene.notes, documentName: 'Note' },
+        tile: { collection: scene.tiles, documentName: 'Tile' },
+        sound: { collection: scene.sounds, documentName: 'AmbientSound' },
+      };
+
+      const wanted = new Set(ids);
+      const found = new Set<string>();
+      for (const kind of kinds) {
+        const { collection, documentName } = collections[kind];
+        const docs = ((collection?.contents || []) as any[]).filter(doc => {
+          if (!this.isToolObject(doc)) return false;
+          return options.all_mine ? true : wanted.has(doc.id);
+        });
+        for (const doc of docs) found.add(doc.id);
+        if (docs.length > 0) {
+          await scene.deleteEmbeddedDocuments(
+            documentName,
+            docs.map(d => d.id)
+          );
+          docs.forEach(d => removed.push({ kind, id: d.id }));
+        }
+      }
+      for (const id of ids) {
+        if (!found.has(id)) {
+          skipped.push({
+            id,
+            reason: 'not found, or not created by this tool (only its own objects can be removed)',
+          });
+        }
+      }
+
+      this.auditLog('manageSceneObjects:remove', { scene: scene.id, count: removed.length }, 'success');
+      return {
+        success: true,
+        action,
+        scene: { id: scene.id, name: scene.name },
+        removed,
+        ...(skipped.length > 0 ? { skipped } : {}),
+      };
+    } catch (error) {
+      this.auditLog(
+        `manageSceneObjects:${options?.action}`,
+        { scene: options?.scene },
+        'failure',
+        error instanceof Error ? error.message : 'Unknown error'
+      );
+      throw new Error(
+        `Failed to ${options?.action ?? 'manage'} scene objects: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+
+  /**
+   * Find the grid drawn into a map picture: pixels per square and where the lines start. Works
+   * on a scene's background or on any image in Foundry's files, and can look at one region
+   * only (grids are often faint and drawn just on the floors). Read-only.
+   */
+  async measureGrid(options: {
+    scene?: string;
+    image?: string;
+    region?: { x: number; y: number; width: number; height: number };
+    min_size?: number;
+    max_size?: number;
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      let scene: any;
+      let src: string | null = null;
+      if (options.image) {
+        if (typeof options.image !== 'string' || /^[a-z]+:\/\//i.test(options.image)) {
+          throw new Error('image must be a path in the Foundry files, such as worlds/<world>/uploads/map.png');
+        }
+        src = options.image;
+      } else {
+        scene = this.resolveSceneForObjects(options.scene);
+        src =
+          scene._source?.background?.src || scene.levels?.contents?.[0]?.background?.src || null;
+        if (!src) throw new Error('The scene has no background image to measure');
+      }
+
+      const image = await new Promise<HTMLImageElement>((resolve, reject) => {
+        const img = new Image();
+        img.onload = () => resolve(img);
+        img.onerror = () => reject(new Error(`The image could not be loaded: ${src}`));
+        img.src = src!;
+      });
+      const width = image.naturalWidth;
+      const height = image.naturalHeight;
+      if (width * height > 40_000_000) {
+        throw new Error(`The image is too large to measure (${width}x${height})`);
+      }
+
+      const canvas = document.createElement('canvas');
+      canvas.width = width;
+      canvas.height = height;
+      const ctx = canvas.getContext('2d', { willReadFrequently: true });
+      if (!ctx) throw new Error('This browser cannot read the picture');
+      ctx.drawImage(image, 0, 0);
+      let rgba: Uint8ClampedArray;
+      try {
+        rgba = ctx.getImageData(0, 0, width, height).data;
+      } catch {
+        throw new Error('The browser refused to read the picture (it is from another site)');
+      }
+      const gray = new Uint8Array(width * height);
+      for (let i = 0; i < gray.length; i++) {
+        gray[i] = 0.299 * rgba[i * 4]! + 0.587 * rgba[i * 4 + 1]! + 0.114 * rgba[i * 4 + 2]!;
+      }
+
+      const measured = measureGridInPicture(gray, width, height, {
+        ...(options.region ? { region: options.region } : {}),
+        ...(options.min_size !== undefined ? { minSize: options.min_size } : {}),
+        ...(options.max_size !== undefined ? { maxSize: options.max_size } : {}),
+      });
+
+      const notes: string[] = [];
+      if (measured.detected && measured.size) {
+        if (measured.size < 50) {
+          const factor = Math.ceil(50 / measured.size);
+          notes.push(
+            `Foundry's smallest grid is 50 px. To use this grid, make the scene ${factor}x the image size (width ${width * factor}, height ${height * factor}) with grid_size ${measured.size * factor}.`
+          );
+        } else {
+          notes.push(
+            `With the scene as large as the image (${width}x${height}), set grid_size to ${measured.size}.`
+          );
+        }
+      } else {
+        notes.push(
+          'No regular grid was found. If the picture has a faint grid on its floors, pass a region that covers only a floor area. For a map without a grid, pick a grid_size from divisors (whole squares) or from the size of a feature you can measure, such as a door or corridor.'
+        );
+      }
+
+      return {
+        success: true,
+        source: options.image ? 'image' : 'scene background',
+        ...(scene ? { scene: { id: scene.id, name: scene.name, grid_size: scene.grid?.size } } : {}),
+        image: src,
+        width,
+        height,
+        ...measured,
+        notes,
+      };
+    } catch (error) {
+      return { success: false, error: error instanceof Error ? error.message : 'Could not measure the grid' };
+    }
+  }
+
+  /** The movement types this Foundry's difficult-terrain behaviour has a cost for. */
+  private movementCostKeys(): string[] {
+    const model = (globalThis as any).CONFIG?.RegionBehavior?.dataModels?.modifyMovementCost;
+    const fields = model?.schema?.fields?.difficulties?.fields ?? model?.defineSchema?.()?.difficulties?.fields;
+    if (fields && typeof fields === 'object') return Object.keys(fields);
+    const actions = (globalThis as any).CONFIG?.Token?.movement?.actions;
+    return actions && typeof actions === 'object'
+      ? Object.keys(actions).filter(key => key !== 'displace')
+      : [];
+  }
+
+  /**
+   * Regions: areas of a scene that act when tokens enter, leave or move in them (difficult
+   * terrain, traps that run a macro, pop-up text, teleports). create / describe / remove (only
+   * regions this tool made) / behavior_types (what each behaviour type accepts).
+   */
+  async manageRegions(options: {
+    action: 'create' | 'describe' | 'remove' | 'behavior_types' | 'link';
+    scene?: string;
+    regions?: RegionSpec[];
+    ids?: string[];
+    all_mine?: boolean;
+    from?: LinkEnd;
+    to?: LinkEnd;
+    two_way?: boolean;
+    name?: string;
+  } & LinkOptions): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      const action = options.action;
+      if (!['create', 'describe', 'remove', 'behavior_types', 'link'].includes(action)) {
+        throw new Error(`Unknown action: ${String(action)} (create | describe | remove | behavior_types | link)`);
+      }
+
+      if (action === 'behavior_types') {
+        const models = (globalThis as any).CONFIG?.RegionBehavior?.dataModels ?? {};
+        const types: Record<string, any> = {};
+        for (const [type, model] of Object.entries<any>(models)) {
+          let fields: any;
+          try {
+            fields = model?.schema?.fields ?? model?.defineSchema?.();
+          } catch {
+            fields = undefined;
+          }
+          types[type] = describeSchemaFields(fields, 2);
+        }
+        const events = (globalThis as any).CONFIG?.RegionBehavior?.events ?? undefined;
+        return {
+          success: true,
+          types,
+          ...(events ? { events: Array.isArray(events) ? events : Object.keys(events) } : {}),
+          presets: ['difficult_terrain'],
+        };
+      }
+
+      const scene = this.resolveSceneForObjects(options.scene);
+      const geom = getGridGeometry(scene);
+      const regionDocs = (scene.regions?.contents || []) as any[];
+
+      if (action === 'describe') {
+        return {
+          success: true,
+          scene: { id: scene.id, name: scene.name },
+          regions: regionDocs.map(region => ({
+            id: region.id,
+            name: region.name,
+            color: region.color ? String(region.color) : null,
+            hidden: !!region.hidden,
+            shapes: ((region.shapes || []) as any[]).map(shape => describeShape(shape, geom)),
+            behaviors: ((region.behaviors?.contents || []) as any[]).map(b => ({
+              id: b.id,
+              type: b.type,
+              name: b.name,
+              disabled: !!b.disabled,
+              ...(b.type === 'teleportToken' ? { teleportsTo: teleportDestinations(b) } : {}),
+            })),
+            uuid: region.uuid,
+            createdByTool: this.isToolObject(region),
+          })),
+        };
+      }
+
+      const permissionCheck = permissionManager.checkWritePermission('modifyScene', {});
+      if (!permissionCheck.allowed) {
+        throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${permissionCheck.reason}`);
+      }
+
+      if (action === 'link') {
+        return await this.linkRegions(options);
+      }
+
+      if (action === 'create') {
+        const specs = options.regions ?? [];
+        if (!Array.isArray(specs) || specs.length === 0) {
+          throw new Error('regions must be a non-empty list');
+        }
+        if (specs.length > MAX_REGIONS_PER_CALL) {
+          throw new Error(`At most ${MAX_REGIONS_PER_CALL} regions per call`);
+        }
+        const keys = this.movementCostKeys();
+        const dnd5eTerrain = !!(globalThis as any).CONFIG?.RegionBehavior?.dataModels?.['dnd5e.difficultTerrain'];
+        const flags = { [this.moduleId]: { [CREATED_BY_FLAG]: true } };
+        const data = specs.map((spec, index) => ({
+          ...buildRegionData(spec, geom, keys, `regions[${index}]`, dnd5eTerrain),
+          flags,
+        }));
+        const created = (await scene.createEmbeddedDocuments('Region', data)) as any[];
+        this.auditLog('manageRegions:create', { scene: scene.id, count: created.length }, 'success');
+        return {
+          success: true,
+          action: 'create',
+          scene: { id: scene.id, name: scene.name },
+          created: created.map(region => ({
+            id: region.id,
+            name: region.name,
+            behaviors: ((region.behaviors?.contents || []) as any[]).map(b => b.type),
+          })),
+        };
+      }
+
+      // remove: only regions this tool created
+      const wanted = options.all_mine
+        ? regionDocs.filter(region => this.isToolObject(region))
+        : regionDocs.filter(region => (options.ids ?? []).includes(region.id));
+      const removable = wanted.filter(region => this.isToolObject(region));
+      const skipped = wanted.filter(region => !this.isToolObject(region)).map(region => region.id);
+      if (removable.length > 0) {
+        await scene.deleteEmbeddedDocuments(
+          'Region',
+          removable.map(region => region.id)
+        );
+      }
+      this.auditLog('manageRegions:remove', { scene: scene.id, count: removable.length }, 'success');
+      return {
+        success: true,
+        action: 'remove',
+        removed: removable.map(region => region.id),
+        ...(skipped.length > 0
+          ? { skipped, note: 'Skipped regions this tool did not create; it never removes those' }
+          : {}),
+      };
+    } catch (error) {
+      throw new Error(
+        `Failed to manage regions: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+
+  /**
+   * Two regions joined by teleports, in the same scene or in two scenes: tokens entering one
+   * appear in the other (and back, unless two_way is false). Both regions are made by this tool.
+   */
+  private async linkRegions(options: {
+    from?: LinkEnd;
+    to?: LinkEnd;
+    two_way?: boolean;
+    name?: string;
+  } & LinkOptions): Promise<any> {
+    if (!options.from || !options.to) {
+      throw new Error('link needs from and to, each {scene?, rect | ellipse | polygon, name?}');
+    }
+    const ends = [options.from, options.to].map(end => {
+      const scene = this.resolveSceneForObjects(end.scene);
+      return { end, scene, geom: getGridGeometry(scene) };
+    });
+    const [a, b] = ends as [(typeof ends)[number], (typeof ends)[number]];
+    const sameScene = a.scene.id === b.scene.id;
+    const base = options.name?.trim();
+    const fallback = (side: number) =>
+      base
+        ? `${base} ${side === 0 ? '(A)' : '(B)'}`
+        : sameScene
+          ? `Teleport ${side === 0 ? 'A' : 'B'}`
+          : `To ${(side === 0 ? b : a).scene.name}`;
+    const keys = this.movementCostKeys();
+    const flags = { [this.moduleId]: { [CREATED_BY_FLAG]: true } };
+    const datas = ends.map((e, i) => ({
+      ...buildRegionData(linkEndSpec(e.end, fallback(i), i === 0 ? 'from' : 'to'), e.geom, keys, i === 0 ? 'from' : 'to', false),
+      flags,
+    }));
+    // Check the behaviours before anything is created.
+    buildTeleportBehavior(['Scene.x.Region.y'], options, 'check', 'link');
+
+    const created: any[] = [];
+    try {
+      for (let i = 0; i < 2; i++) {
+        const docs = (await ends[i]!.scene.createEmbeddedDocuments('Region', [datas[i]])) as any[];
+        created.push(docs[0]);
+      }
+      const twoWay = options.two_way !== false;
+      const behaviours: Array<{ region: any; destination: any }> = [{ region: created[0], destination: created[1] }];
+      if (twoWay) behaviours.push({ region: created[1], destination: created[0] });
+      for (const { region, destination } of behaviours) {
+        const destScene = destination === created[0] ? a.scene : b.scene;
+        await region.createEmbeddedDocuments('RegionBehavior', [
+          buildTeleportBehavior([destination.uuid], options, `Teleport to ${destScene.name}`, 'link'),
+        ]);
+      }
+    } catch (error) {
+      for (let i = 0; i < created.length; i++) {
+        try {
+          await ends[i]!.scene.deleteEmbeddedDocuments('Region', [created[i].id]);
+        } catch {
+          /* best effort */
+        }
+      }
+      throw error;
+    }
+    this.auditLog('manageRegions:link', { from: a.scene.id, to: b.scene.id }, 'success');
+    return {
+      success: true,
+      action: 'link',
+      twoWay: options.two_way !== false,
+      from: { scene: { id: a.scene.id, name: a.scene.name }, region: { id: created[0].id, name: created[0].name, uuid: created[0].uuid } },
+      to: { scene: { id: b.scene.id, name: b.scene.name }, region: { id: created[1].id, name: created[1].name, uuid: created[1].uuid } },
+      note: 'Tokens that enter a linked region are moved to the other one. The teleport runs when a token is moved there, so test it by moving a token.',
+    };
+  }
+
+  /**
+   * Draw the scene image with a numbered grid and its tokens and lights, and return it as a
+   * PNG so positions can be checked in grid squares. Read-only.
+   */
+  async previewScene(options: {
+    scene?: string;
+    max_size?: number;
+    label_every?: number;
+    region?: { x: number; y: number; width: number; height: number };
+    layers?: string[];
+    labels?: 'numbers' | 'names' | 'none';
+    dim?: number;
+    data_only?: boolean;
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      const scene = this.resolveSceneForObjects(options.scene);
+      const layers = options.layers ?? [...DEFAULT_LAYERS];
+      for (const layer of layers) {
+        if (!(PREVIEW_LAYERS as readonly string[]).includes(layer)) {
+          throw new Error(`Unknown layer "${layer}" (${PREVIEW_LAYERS.join(', ')})`);
+        }
+      }
+      if (options.dim !== undefined && (typeof options.dim !== 'number' || options.dim < 0 || options.dim > 0.9)) {
+        throw new Error('dim must be a number from 0 to 0.9');
+      }
+      const geom = getGridGeometry(scene);
+      const maxSize = options.max_size ?? 1600;
+      if (typeof maxSize !== 'number' || !Number.isFinite(maxSize) || maxSize < 200 || maxSize > 3000) {
+        throw new Error('max_size must be a number from 200 to 3000');
+      }
+      if (
+        options.label_every !== undefined &&
+        (!Number.isInteger(options.label_every) || options.label_every < 1 || options.label_every > 50)
+      ) {
+        throw new Error('label_every must be a whole number from 1 to 50');
+      }
+      let view: PreviewView | undefined;
+      if (options.region) {
+        const r = options.region;
+        const nums = [r.x, r.y, r.width, r.height];
+        if (nums.some(n => typeof n !== 'number' || !Number.isFinite(n))) {
+          throw new Error('region needs numbers x, y, width and height (in grid squares)');
+        }
+        const x = Math.max(0, r.x);
+        const y = Math.max(0, r.y);
+        const width = Math.min(geom.columns - x, r.width + Math.min(0, r.x));
+        const height = Math.min(geom.rows - y, r.height + Math.min(0, r.y));
+        if (width < 2 || height < 2) {
+          throw new Error(
+            `region must cover at least 2 by 2 grid squares inside the scene (${geom.columns} columns, ${geom.rows} rows)`
+          );
+        }
+        view = { x, y, width, height };
+      }
+      const scale = previewScale(geom, maxSize, view);
+      const labelEvery = options.label_every ?? defaultLabelEvery(geom, scale);
+
+      const warnings: string[] = [];
+      const src =
+        scene._source?.background?.src || scene.levels?.contents?.[0]?.background?.src || null;
+      let image: any;
+      if (src && !options.data_only && layers.includes('image')) {
+        try {
+          image = await new Promise<any>((resolve, reject) => {
+            const img = new Image();
+            img.onload = () => resolve(img);
+            img.onerror = () => reject(new Error('the image could not be loaded'));
+            img.src = src;
+          });
+        } catch (error) {
+          warnings.push(
+            `Background ${src}: ${error instanceof Error ? error.message : 'could not be drawn'}; drawn on grey`
+          );
+        }
+      } else if (!src) {
+        warnings.push('The scene has no background image; drawn on grey');
+      }
+
+      const tokens: PreviewToken[] = (((scene.tokens?.contents || []) as any[]).map(t => {
+        const topLeft = pixelsToSquares(geom, t.x, t.y);
+        const real = tokenRealName(t);
+        return {
+          name: real ? `${String(t.name ?? '')} [${real}]` : String(t.name ?? ''),
+          hidden: Boolean(t.hidden),
+          ...topLeft,
+          width: Number(t.width ?? 1),
+          height: Number(t.height ?? 1),
+        };
+      }));
+      const lights: PreviewLight[] = (((scene.lights?.contents || []) as any[]).map(l => {
+        const centre = pixelsToSquares(geom, l.x, l.y);
+        return {
+          ...centre,
+          bright: (l.config?.bright ?? 0) / (geom.distance || 1),
+          dim: (l.config?.dim ?? 0) / (geom.distance || 1),
+          color: l.config?.color ? String(l.config.color) : undefined,
+        };
+      }));
+
+      const walls: PreviewWall[] = ((scene.walls?.contents || []) as any[]).map(w => {
+        const a = pixelsToSquares(geom, w.c?.[0], w.c?.[1]);
+        const b = pixelsToSquares(geom, w.c?.[2], w.c?.[3]);
+        return { x1: a.x, y1: a.y, x2: b.x, y2: b.y, door: Number(w.door ?? 0) };
+      });
+      const notes: PreviewNote[] = ((scene.notes?.contents || []) as any[]).map(n => ({
+        ...pixelsToSquares(geom, n.x, n.y),
+        text: String(n.text ?? ''),
+      }));
+
+      const regions: PreviewRegion[] = ((scene.regions?.contents || []) as any[]).map(r => {
+        const shapes: PreviewRegion['shapes'] = [];
+        for (const sh of (r.shapes || []) as any[]) {
+          if (sh.hole) continue;
+          if (sh.type === 'rectangle') {
+            const a = pixelsToSquares(geom, sh.x, sh.y);
+            const w = Number(sh.width) / geom.size;
+            const h = Number(sh.height) / geom.size;
+            shapes.push({ type: 'poly', points: [[a.x, a.y], [a.x + w, a.y], [a.x + w, a.y + h], [a.x, a.y + h]] });
+          } else if (sh.type === 'ellipse') {
+            const c = pixelsToSquares(geom, sh.x, sh.y);
+            shapes.push({ type: 'ellipse', cx: c.x, cy: c.y, rx: Number(sh.radiusX) / geom.size, ry: Number(sh.radiusY) / geom.size });
+          } else if (sh.type === 'circle') {
+            const c = pixelsToSquares(geom, sh.x, sh.y);
+            const rad = Number(sh.radius) / geom.size;
+            shapes.push({ type: 'ellipse', cx: c.x, cy: c.y, rx: rad, ry: rad });
+          } else if (sh.type === 'polygon' && Array.isArray(sh.points)) {
+            const pts: Array<[number, number]> = [];
+            for (let i = 0; i + 1 < sh.points.length; i += 2) {
+              const p = pixelsToSquares(geom, sh.points[i], sh.points[i + 1]);
+              pts.push([p.x, p.y]);
+            }
+            if (pts.length >= 3) shapes.push({ type: 'poly', points: pts });
+          }
+        }
+        return {
+          name: String(r.name ?? ''),
+          color: r.color ? String(r.color) : undefined,
+          kinds: ((r.behaviors?.contents || []) as any[]).map(b => String(b.type ?? '')),
+          shapes,
+        };
+      });
+
+      const tiles: PreviewTile[] = ((scene.tiles?.contents || []) as any[]).map(t => {
+        const topLeft = pixelsToSquares(geom, t.x, t.y);
+        return {
+          ...topLeft,
+          width: Number(t.width ?? 0) / geom.size,
+          height: Number(t.height ?? 0) / geom.size,
+          rotation: Number(t.rotation ?? 0),
+          alpha: Number(t.alpha ?? 1),
+          hidden: Boolean(t.hidden),
+        };
+      });
+      const tileSources = ((scene.tiles?.contents || []) as any[]).map(t => String(t.texture?.src ?? ''));
+      if (!options.data_only && layers.includes('tiles') && tiles.length > 0) {
+        const loaded = new Map<string, any>();
+        for (const tileSrc of [...new Set(tileSources.filter(Boolean))].slice(0, 60)) {
+          try {
+            loaded.set(
+              tileSrc,
+              await new Promise<any>((resolve, reject) => {
+                const img = new Image();
+                img.onload = () => resolve(img);
+                img.onerror = () => reject(new Error('could not be loaded'));
+                img.src = tileSrc;
+              })
+            );
+          } catch (error) {
+            warnings.push(`Tile picture ${tileSrc}: ${error instanceof Error ? error.message : 'could not be drawn'}; outline only`);
+          }
+        }
+        tiles.forEach((tile, i) => {
+          const img = loaded.get(tileSources[i]!);
+          if (img) tile.image = img;
+        });
+      }
+
+      const round2 = (v: number) => Math.round(v * 100) / 100;
+      const legend = {
+        tiles: tiles.map((t, i) => ({
+          n: `T${i + 1}`,
+          x: round2(t.x),
+          y: round2(t.y),
+          width: round2(t.width),
+          height: round2(t.height),
+          rotation: t.rotation ?? 0,
+          hidden: Boolean(t.hidden),
+          src: tileSources[i],
+        })),
+        tokens: tokens.map((t, i) => ({
+          n: i + 1,
+          name: t.name,
+          x: round2(t.x),
+          y: round2(t.y),
+          width: t.width,
+          height: t.height,
+          hidden: Boolean(t.hidden),
+        })),
+        lights: lights.map((l, i) => ({
+          n: `L${i + 1}`,
+          x: round2(l.x),
+          y: round2(l.y),
+          bright: round2(l.bright),
+          dim: round2(l.dim),
+        })),
+        notes: notes.map((n, i) => ({ n: `N${i + 1}`, x: round2(n.x), y: round2(n.y), text: n.text })),
+        regions: regions.map((r, i) => ({ n: `R${i + 1}`, name: r.name, kinds: r.kinds })),
+      };
+
+      if (options.data_only) {
+        return {
+          success: true,
+          scene: { id: scene.id, name: scene.name },
+          dataOnly: true,
+          grid: { columns: geom.columns, rows: geom.rows },
+          legend,
+          regionShapes: regions.map(r => r.shapes),
+          walls: walls.map(w => [round2(w.x1), round2(w.y1), round2(w.x2), round2(w.y2), w.door]),
+        };
+      }
+
+      const canvas = document.createElement('canvas');
+      const outSize = previewSize(geom, scale, view);
+      canvas.width = outSize.width;
+      canvas.height = outSize.height;
+      const ctx = canvas.getContext('2d');
+      if (!ctx) throw new Error('This browser cannot draw the preview');
+      const size = drawPreview(ctx, {
+        geom,
+        scale,
+        labelEvery,
+        tokens,
+        lights,
+        walls,
+        notes,
+        regions,
+        tiles,
+        layers: layers as PreviewLayer[],
+        labelMode: options.labels ?? 'numbers',
+        ...(options.dim !== undefined ? { dim: options.dim } : {}),
+        image,
+        ...(view ? { view } : {}),
+      });
+
+      let dataUrl: string;
+      try {
+        dataUrl = canvas.toDataURL('image/png');
+      } catch {
+        throw new Error('The browser refused to export the picture (the background image is from another site)');
+      }
+      const imageBase64 = dataUrl.slice(dataUrl.indexOf(',') + 1);
+
+      return {
+        success: true,
+        scene: { id: scene.id, name: scene.name },
+        mimeType: 'image/png',
+        imageBase64,
+        width: size.width,
+        height: size.height,
+        scale,
+        labelEvery,
+        ...(view ? { region: view } : {}),
+        grid: { columns: geom.columns, rows: geom.rows },
+        tokens: tokens.length,
+        lights: lights.length,
+        walls: walls.length,
+        notes: notes.length,
+        regions: regions.length,
+        layers,
+        legend,
+        ...(warnings.length > 0 ? { warnings } : {}),
+      };
+    } catch (error) {
+      throw new Error(
+        `Failed to preview scene: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+
+  // ===== INSPECT DOCUMENT (READ-ONLY) =====
+
+  /** Names of the embedded document types a document class has (e.g. Token, Wall for a Scene). */
+  private embeddedTypesOf(documentClass: any): Record<string, string> {
+    const embedded = documentClass?.metadata?.embedded;
+    return embedded && typeof embedded === 'object' ? { ...embedded } : {};
+  }
+
+  /**
+   * Read-only look at Foundry data, so the exact fields and values can be checked instead of
+   * guessed. list: documents of a type. get: one document's data (by type and name/id, or
+   * by uuid), optionally an embedded document or a part of it by path. schema: the fields a
+   * document type has, with their kinds and allowed values.
+   */
+  async inspectDocument(options: {
+    action: 'list' | 'get' | 'schema';
+    type?: string;
+    identifier?: string;
+    uuid?: string;
+    embedded_type?: string;
+    embedded_identifier?: string;
+    path?: string;
+    depth?: number;
+    max_chars?: number;
+    include_embedded?: boolean;
+    search?: string;
+    limit?: number;
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      const action = options.action;
+      if (action !== 'list' && action !== 'get' && action !== 'schema') {
+        throw new Error(`Unknown action: ${String(action)} (list | get | schema)`);
+      }
+
+      const intIn = (value: unknown, name: string, min: number, max: number, fallback: number) => {
+        if (value === undefined) return fallback;
+        if (typeof value !== 'number' || !Number.isInteger(value) || value < min || value > max) {
+          throw new Error(`${name} must be a whole number from ${min} to ${max}`);
+        }
+        return value;
+      };
+      const depth = intIn(options.depth, 'depth', 1, 12, 5);
+      const maxChars = intIn(options.max_chars, 'max_chars', 500, MAX_MAX_CHARS, DEFAULT_MAX_CHARS);
+
+      const checkType = (type: unknown): string => {
+        if (typeof type !== 'string' || !(INSPECTABLE_TYPES as readonly string[]).includes(type)) {
+          throw new Error(`type must be one of: ${INSPECTABLE_TYPES.join(', ')}`);
+        }
+        return type;
+      };
+
+      if (action === 'schema') {
+        const typeName = options.embedded_type ?? options.type;
+        if (typeof typeName !== 'string' || !/^[A-Za-z]+$/.test(typeName)) {
+          throw new Error('schema needs type (or embedded_type), e.g. Scene or Wall');
+        }
+        const documentClass = (CONFIG as any)[typeName]?.documentClass;
+        const fields = documentClass?.schema?.fields;
+        if (!fields) throw new Error(`No document type named "${typeName}"`);
+        const schemaDepth = intIn(options.depth, 'depth', 1, 6, 3);
+        return {
+          success: true,
+          action,
+          type: typeName,
+          embeddedTypes: this.embeddedTypesOf(documentClass),
+          fields: describeFields(fields, schemaDepth),
+        };
+      }
+
+      if (action === 'list') {
+        const type = checkType(options.type);
+        const collection = (game as any).collections?.get(type);
+        if (!collection) throw new Error(`Foundry has no collection for ${type}`);
+        const limit = intIn(options.limit, 'limit', 1, 500, 100);
+        const search = options.search?.trim().toLowerCase();
+        const all = ((collection.contents || []) as any[]).filter(doc => {
+          if (!search) return true;
+          return String(doc.name ?? '').toLowerCase().includes(search);
+        });
+        const items = all.slice(0, limit).map(doc => ({
+          id: doc.id,
+          name: doc.name ?? doc.alias ?? '',
+          ...(doc.type ? { subtype: doc.type } : {}),
+          folder: doc.folder?.name ?? null,
+        }));
+        return {
+          success: true,
+          action,
+          type,
+          total: all.length,
+          ...(all.length > limit ? { shown: limit } : {}),
+          items,
+        };
+      }
+
+      // get
+      let doc: any;
+      if (options.uuid) {
+        doc = await (globalThis as any).fromUuid(options.uuid);
+        if (!doc) throw new Error(`No document found for uuid ${options.uuid}`);
+      } else {
+        const type = checkType(options.type);
+        if (!options.identifier) throw new Error('get needs identifier (id or exact name) or uuid');
+        const collection = (game as any).collections?.get(type);
+        if (!collection) throw new Error(`Foundry has no collection for ${type}`);
+        const docs = (collection.contents || []) as any[];
+        const byId = docs.find(d => d.id === options.identifier);
+        if (byId) {
+          doc = byId;
+        } else {
+          const wanted = options.identifier.trim().toLowerCase();
+          const matches = docs.filter(d => String(d.name ?? '').toLowerCase() === wanted);
+          if (matches.length === 0) throw new Error(`${type} not found: "${options.identifier}"`);
+          if (matches.length > 1) {
+            throw new Error(
+              `Several ${type} documents are named "${options.identifier}" (ids: ${matches.map(m => m.id).join(', ')}); use the id`
+            );
+          }
+          doc = matches[0];
+        }
+      }
+
+      const topEmbedded = this.embeddedTypesOf(doc.constructor);
+
+      if (options.embedded_type) {
+        const embeddedType = options.embedded_type;
+        if (!(embeddedType in topEmbedded)) {
+          throw new Error(
+            `${doc.documentName ?? 'This document'} has no embedded "${embeddedType}". It has: ${Object.keys(topEmbedded).join(', ') || 'none'}`
+          );
+        }
+        const embeddedDocs = ((doc.getEmbeddedCollection(embeddedType)?.contents ?? []) as any[]);
+        if (!options.embedded_identifier) {
+          return {
+            success: true,
+            action,
+            parent: { id: doc.id, name: doc.name },
+            embeddedType,
+            total: embeddedDocs.length,
+            items: embeddedDocs.slice(0, 200).map(e => ({
+              id: e.id,
+              name: e.name ?? '',
+              ...(e.type ? { subtype: e.type } : {}),
+            })),
+          };
+        }
+        const wantedEmbedded = options.embedded_identifier.trim().toLowerCase();
+        const found =
+          embeddedDocs.find(e => e.id === options.embedded_identifier) ??
+          (() => {
+            const matches = embeddedDocs.filter(
+              e => String(e.name ?? '').toLowerCase() === wantedEmbedded
+            );
+            if (matches.length > 1) {
+              throw new Error(
+                `Several ${embeddedType} documents are named "${options.embedded_identifier}" (ids: ${matches.map(m => m.id).join(', ')}); use the id`
+              );
+            }
+            return matches[0];
+          })();
+        if (!found) {
+          throw new Error(`${embeddedType} not found: "${options.embedded_identifier}"`);
+        }
+        doc = found;
+      }
+
+      let data: unknown = doc.toObject();
+      const embeddedHere = Object.values(this.embeddedTypesOf(doc.constructor)) as string[];
+      if (!options.include_embedded && !options.path && data && typeof data === 'object') {
+        const counts: Record<string, string> = {};
+        for (const field of embeddedHere) {
+          const value = (data as any)[field];
+          if (Array.isArray(value)) {
+            counts[field] = `[${value.length} items: use embedded_type to list, or include_embedded]`;
+            (data as any)[field] = counts[field];
+          }
+        }
+      }
+      if (options.path) data = pickPath(data, options.path);
+      const trimmed = trimDepth(data, depth);
+      const { json, truncated } = limitJson(trimmed, maxChars);
+
+      return {
+        success: true,
+        action,
+        document: {
+          documentName: doc.documentName,
+          id: doc.id,
+          name: doc.name ?? null,
+          uuid: doc.uuid ?? null,
+          embeddedTypes: Object.keys(this.embeddedTypesOf(doc.constructor)),
+        },
+        ...(options.path ? { path: options.path } : {}),
+        depth,
+        truncated,
+        // A string, so the size limit is exact; the caller reads it as JSON.
+        data: json,
+        ...(truncated
+          ? {
+              note: `Output was cut at ${maxChars} characters. Use path to read one part, a smaller depth, or a larger max_chars.`,
+            }
+          : {}),
+      };
+    } catch (error) {
+      throw new Error(
+        `Failed to inspect: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+
+  // ===== JOURNAL MANAGEMENT (CREATE / UPDATE / DESCRIBE) =====
+
+  /** Find journals by id or exact (case-insensitive) name; throws if none or several. */
+  private findJournalByIdentifier(identifier: string): any {
+    const journals = ((game as any).journal?.contents || []) as any[];
+    const byId = journals.find(j => j.id === identifier);
+    if (byId) return byId;
+    const wanted = identifier.trim().toLowerCase();
+    const matches = journals.filter(j => String(j.name ?? '').toLowerCase() === wanted);
+    if (matches.length === 1) return matches[0];
+    if (matches.length > 1) {
+      throw new Error(
+        `Several journals are named "${identifier}" (ids: ${matches.map(j => j.id).join(', ')}); use the id`
+      );
+    }
+    throw new Error(`Journal not found: "${identifier}"`);
+  }
+
+  /** Look a document up by kind and name for {{kind: Name}} links. */
+  private lookupLinkTarget(kind: LinkKind, name: string): { id: string; name: string } | 'ambiguous' | null {
+    const collections: Record<LinkKind, any> = {
+      actor: (game as any).actors,
+      scene: (game as any).scenes,
+      journal: (game as any).journal,
+      item: (game as any).items,
+      rolltable: (game as any).tables,
+    };
+    const docs = (collections[kind]?.contents || []) as any[];
+    const wanted = name.trim().toLowerCase();
+    const byId = docs.find(d => d.id === name.trim());
+    if (byId) return { id: byId.id, name: byId.name };
+    const matches = docs.filter(d => String(d.name ?? '').toLowerCase() === wanted);
+    if (matches.length === 1) return { id: matches[0].id, name: matches[0].name };
+    return matches.length > 1 ? 'ambiguous' : null;
+  }
+
+  /** Make journal HTML safe and resolve {{kind: Name}} links. */
+  private prepareJournalHtml(content: string, warnings: string[]): string {
+    const safe = stripUnsafeHtml(content);
+    const resolved = resolveContentLinks(safe, (kind, name) => this.lookupLinkTarget(kind, name));
+    warnings.push(...resolved.warnings);
+    return resolved.html;
+  }
+
+  private summarizeJournal(journal: any, includePages: boolean): Record<string, any> {
+    const level = journal.ownership?.default;
+    const summary: Record<string, any> = {
+      id: journal.id,
+      name: journal.name,
+      folder: journal.folder?.name ?? null,
+      ownership: ownershipName(level),
+      pageCount: journal.pages?.size ?? journal.pages?.contents?.length ?? 0,
+    };
+    if (includePages) {
+      const pages = ((journal.pages?.contents || []) as any[])
+        .slice()
+        .sort((a, b) => (a.sort ?? 0) - (b.sort ?? 0));
+      summary.pages = pages.map(page => ({
+        id: page.id,
+        name: page.name,
+        type: page.type,
+        sort: page.sort,
+        ...(page.type === 'text'
+          ? { content: page.text?.content ?? '' }
+          : page.type === 'image'
+            ? { src: page.src ?? null, caption: page.image?.caption ?? '' }
+            : {}),
+        showTitle: page.title?.show,
+        titleLevel: page.title?.level,
+      }));
+    }
+    return summary;
+  }
+
+  /**
+   * Create, update or describe journals.
+   * create: a journal with exactly the pages given (text pages as HTML, or image pages).
+   * update: rename, move to a folder, change who can see it, and upsert pages (matched by id
+   *   or exact name; created when no page matches). Never removes pages or journals.
+   * describe: lists all journals, or one journal with its full pages.
+   * Text may contain {{actor: Name}}, {{scene: Name}}, {{journal: Name}}, {{item: Name}} or
+   * {{rolltable: Name}} (optionally {{actor: Name | label}}), which become Foundry links.
+   */
+  async manageJournals(options: {
+    action: 'create' | 'update' | 'describe';
+    journal?: string;
+    name?: string;
+    folder?: string;
+    ownership?: OwnershipName;
+    pages?: Array<{
+      id?: string;
+      name?: string;
+      type?: 'text' | 'image';
+      content?: string;
+      src?: string;
+      caption?: string;
+      show_title?: boolean;
+      title_level?: number;
+    }>;
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      if (options.action === 'describe') {
+        if (options.journal) {
+          const journal = this.findJournalByIdentifier(options.journal);
+          return { success: true, journal: this.summarizeJournal(journal, true) };
+        }
+        const journals = (((game as any).journal?.contents || []) as any[]).map(j =>
+          this.summarizeJournal(j, false)
+        );
+        return { success: true, journals };
+      }
+
+      if (options.action !== 'create' && options.action !== 'update') {
+        throw new Error(`Unknown action: ${String(options.action)} (create | update | describe)`);
+      }
+
+      const permissionCheck = permissionManager.checkWritePermission('createActor', {
+        quantity: 1,
+      });
+      if (!permissionCheck.allowed) {
+        throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${permissionCheck.reason}`);
+      }
+
+      if (options.name !== undefined && (typeof options.name !== 'string' || !options.name.trim())) {
+        throw new Error('name must be a non-empty string');
+      }
+      if (options.ownership !== undefined && !(options.ownership in OWNERSHIP_LEVELS)) {
+        throw new Error('ownership must be one of: none, limited, observer, owner');
+      }
+      if (options.folder !== undefined && (typeof options.folder !== 'string' || !options.folder.trim())) {
+        throw new Error('folder must be a non-empty string');
+      }
+      const pageSpecs = options.pages ?? [];
+      if (!Array.isArray(pageSpecs) || pageSpecs.length > 100) {
+        throw new Error('pages must be a list of at most 100 pages');
+      }
+      for (const spec of pageSpecs) {
+        if (spec.type !== undefined && spec.type !== 'text' && spec.type !== 'image') {
+          throw new Error(`Unsupported page type "${String(spec.type)}" (text | image)`);
+        }
+        if (typeof spec.content === 'string' && spec.content.length > 1_000_000) {
+          throw new Error('A page may hold at most 1,000,000 characters');
+        }
+        if (
+          spec.title_level !== undefined &&
+          (!Number.isInteger(spec.title_level) || spec.title_level < 1 || spec.title_level > 6)
+        ) {
+          throw new Error('title_level must be a whole number from 1 to 6');
+        }
+      }
+
+      const warnings: string[] = [];
+      const html = (content: string) => this.prepareJournalHtml(content, warnings);
+
+      // Fields of a page document from a spec (create: all defaults; update: only given).
+      const pageFields = (spec: (typeof pageSpecs)[number], type: 'text' | 'image') => {
+        const fields: Record<string, any> = {};
+        if (type === 'text' && spec.content !== undefined) {
+          fields['text.content'] = html(spec.content);
+        }
+        if (type === 'image') {
+          if (spec.src !== undefined) fields.src = spec.src;
+          if (spec.caption !== undefined) fields['image.caption'] = spec.caption;
+        }
+        if (spec.show_title !== undefined) fields['title.show'] = spec.show_title;
+        if (spec.title_level !== undefined) fields['title.level'] = spec.title_level;
+        return fields;
+      };
+
+      const nest = (flat: Record<string, any>): Record<string, any> => {
+        const out: Record<string, any> = {};
+        for (const [path, value] of Object.entries(flat)) {
+          const parts = path.split('.');
+          let cursor = out;
+          parts.slice(0, -1).forEach(part => {
+            cursor[part] = cursor[part] ?? {};
+            cursor = cursor[part];
+          });
+          cursor[parts[parts.length - 1]] = value;
+        }
+        return out;
+      };
+
+      const newPageData = (spec: (typeof pageSpecs)[number], sort: number) => {
+        const type = spec.type ?? 'text';
+        if (!spec.name || typeof spec.name !== 'string' || !spec.name.trim()) {
+          throw new Error('Every new page needs a name');
+        }
+        if (type === 'image' && !spec.src) {
+          throw new Error(`Image page "${spec.name}" needs a src (a Foundry file path)`);
+        }
+        const data = nest(pageFields(spec, type));
+        if (type === 'text') {
+          data.text = { format: 1, content: '', ...(data.text ?? {}) };
+        }
+        return { name: spec.name.trim(), type, sort, ...data };
+      };
+
+      let journal: any;
+      const pageResults: Array<{ id: string; name: string; type: string; result: string }> = [];
+
+      if (options.action === 'create') {
+        if (!options.name) throw new Error('name is required for create');
+        const folderId = options.folder
+          ? await this.getOrCreateFolder(options.folder.trim(), 'JournalEntry')
+          : null;
+        if (options.folder && !folderId) {
+          warnings.push(`folder "${options.folder}" could not be created; the journal is in the root`);
+        }
+        const pagesData = pageSpecs.map((spec, index) => newPageData(spec, (index + 1) * 100000));
+        journal = await JournalEntry.create({
+          name: options.name.trim(),
+          pages: pagesData,
+          ownership: { default: OWNERSHIP_LEVELS[options.ownership ?? 'none'] },
+          ...(folderId ? { folder: folderId } : {}),
+        } as any);
+        if (!journal) throw new Error('Foundry did not return the created journal');
+        for (const page of ((journal.pages?.contents || []) as any[])) {
+          pageResults.push({ id: page.id, name: page.name, type: page.type, result: 'created' });
+        }
+      } else {
+        if (!options.journal) throw new Error('journal is required for update');
+        journal = this.findJournalByIdentifier(options.journal);
+        const hasChange =
+          options.name !== undefined ||
+          options.folder !== undefined ||
+          options.ownership !== undefined ||
+          pageSpecs.length > 0;
+        if (!hasChange) throw new Error('Nothing to update: pass at least one field to change');
+
+        const journalUpdate: Record<string, any> = {};
+        if (options.name !== undefined) journalUpdate.name = options.name.trim();
+        if (options.ownership !== undefined) {
+          journalUpdate.ownership = { default: OWNERSHIP_LEVELS[options.ownership] };
+        }
+        if (options.folder !== undefined) {
+          const folderId = await this.getOrCreateFolder(options.folder.trim(), 'JournalEntry');
+          if (!folderId) {
+            warnings.push(`folder "${options.folder}" could not be created; the journal was not moved`);
+          } else {
+            journalUpdate.folder = folderId;
+          }
+        }
+        if (Object.keys(journalUpdate).length > 0) {
+          await journal.update(journalUpdate);
+        }
+
+        const existing = ((journal.pages?.contents || []) as any[]).slice();
+        let nextSort =
+          existing.reduce((max, page) => Math.max(max, page.sort ?? 0), 0) + 100000;
+        for (const spec of pageSpecs) {
+          let target: any;
+          if (spec.id) {
+            target = existing.find(p => p.id === spec.id);
+            if (!target) throw new Error(`Page not found: ${spec.id}`);
+          } else if (spec.name) {
+            const wanted = spec.name.trim().toLowerCase();
+            const matches = existing.filter(p => String(p.name ?? '').toLowerCase() === wanted);
+            if (matches.length > 1) {
+              throw new Error(
+                `Several pages are named "${spec.name}" (ids: ${matches.map(p => p.id).join(', ')}); pass the id`
+              );
+            }
+            target = matches[0];
+          } else {
+            throw new Error('Every page needs an id or a name');
+          }
+
+          if (target) {
+            if (spec.type !== undefined && spec.type !== target.type) {
+              throw new Error(
+                `Page "${target.name}" is a ${target.type} page; its type cannot change`
+              );
+            }
+            const fields = pageFields(spec, target.type);
+            if (Object.keys(fields).length === 0) {
+              warnings.push(`page "${target.name}" had nothing to change`);
+              continue;
+            }
+            await target.update(fields);
+            pageResults.push({ id: target.id, name: target.name, type: target.type, result: 'updated' });
+          } else {
+            const created = await journal.createEmbeddedDocuments('JournalEntryPage', [
+              newPageData(spec, nextSort),
+            ]);
+            nextSort += 100000;
+            const page = created?.[0];
+            if (page) existing.push(page);
+            pageResults.push({
+              id: page?.id ?? '',
+              name: spec.name!.trim(),
+              type: spec.type ?? 'text',
+              result: 'created',
+            });
+          }
+        }
+      }
+
+      this.auditLog(`manageJournals:${options.action}`, { ...options, pages: pageSpecs.length }, 'success');
+
+      return {
+        success: true,
+        action: options.action,
+        journal: this.summarizeJournal(journal, false),
+        pages: pageResults,
+        ...(warnings.length > 0 ? { warnings } : {}),
+      };
+    } catch (error) {
+      this.auditLog(
+        `manageJournals:${options?.action}`,
+        { journal: options?.journal, name: options?.name },
+        'failure',
+        error instanceof Error ? error.message : 'Unknown error'
+      );
+      throw new Error(
+        `Failed to ${options?.action ?? 'manage'} journal: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+
+  // ===== FILE UPLOAD =====
+
+  /**
+   * Upload an image into the world's own upload folder (worlds/<world>/uploads/...),
+   * so it survives module updates and can be used as a scene background, token or
+   * portrait image. Only png, jpg, webp and gif are accepted, the bytes must match the
+   * extension, size is capped, and the folder is restricted to the world's upload tree.
+   * Existing files are not replaced unless overwrite is true.
+   */
+  async uploadFile(options: {
+    filename: string;
+    imageData: string;
+    folder?: string;
+    overwrite?: boolean;
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      const permissionCheck = permissionManager.checkWritePermission('modifyScene', {});
+      if (!permissionCheck.allowed) {
+        throw new Error(`${ERROR_MESSAGES.ACCESS_DENIED}: ${permissionCheck.reason}`);
+      }
+
+      const filename = sanitizeUploadFilename(options.filename);
+      const folder = sanitizeUploadFolder(options.folder);
+      const bytes = decodeBase64(options.imageData);
+
+      if (bytes.length === 0) {
+        throw new Error('The file is empty');
+      }
+      const detected = detectImageType(bytes);
+      const detectedAudio = detected ? null : detectAudioType(bytes);
+      const limit = detectedAudio ? UPLOAD_AUDIO_MAX_BYTES : UPLOAD_MAX_BYTES;
+      if (bytes.length > limit) {
+        throw new Error(
+          `The file is ${(bytes.length / 1024 / 1024).toFixed(1)} MB; the limit is ${limit / 1024 / 1024} MB`
+        );
+      }
+      if (!detected && !detectedAudio) {
+        throw new Error('The file is not a PNG, JPEG, WebP or GIF image or an MP3, OGG, WAV, FLAC or M4A audio file');
+      }
+      if (detected && !extensionMatchesType(filename, detected)) {
+        throw new Error(
+          `The file content is ${detected.toUpperCase()} but the name says otherwise`
+        );
+      }
+      if (detectedAudio && !extensionMatchesAudio(filename, detectedAudio)) {
+        throw new Error(
+          `The file content is ${detectedAudio.toUpperCase()} but the name says otherwise`
+        );
+      }
+
+      const worldId = (game as any).world?.id;
+      if (!worldId) {
+        throw new Error('No world is loaded');
+      }
+      const FilePickerAPI =
+        (globalThis as any).foundry?.applications?.apps?.FilePicker?.implementation ||
+        (globalThis as any).FilePicker;
+      if (!FilePickerAPI) {
+        throw new Error('Foundry file picker is not available');
+      }
+
+      // Create each level of worlds/<world>/uploads[/folder...]; existing ones are fine.
+      const segments = ['worlds', worldId, 'uploads', ...(folder ? folder.split('/') : [])];
+      let current = '';
+      for (const segment of segments) {
+        current = current ? `${current}/${segment}` : segment;
+        try {
+          await FilePickerAPI.createDirectory('data', current, { bucket: null });
+        } catch (dirError: any) {
+          const message = String(dirError?.message ?? dirError);
+          if (!message.includes('EEXIST') && !message.includes('already exists')) {
+            console.warn(`[${this.moduleId}] Directory creation warning for ${current}:`, message);
+          }
+        }
+      }
+      const directory = current;
+
+      // Do not silently replace an existing file.
+      if (!options.overwrite) {
+        let existing: string[] = [];
+        try {
+          const listing = await FilePickerAPI.browse('data', directory);
+          existing = (listing?.files ?? []).map((f: string) => {
+            try {
+              return decodeURIComponent(String(f));
+            } catch {
+              return String(f); // malformed %-encoding in one entry must not hide the others
+            }
+          });
+        } catch {
+          // Cannot list the folder: carry on rather than block the upload.
+        }
+        if (existing.some(f => f === `${directory}/${filename}` || f.endsWith(`/${filename}`))) {
+          throw new Error(
+            `File already exists: ${directory}/${filename}. Use a different filename or pass overwrite: true`
+          );
+        }
+      }
+
+      const fileExt = filename.slice(filename.lastIndexOf('.') + 1);
+      const mime = UPLOAD_IMAGE_TYPES[fileExt] ?? UPLOAD_AUDIO_TYPES[fileExt];
+      const file = new File([bytes as BlobPart], filename, { type: mime });
+      const response = await FilePickerAPI.upload('data', directory, file, {}, { notify: false });
+      if (!response || !response.path) {
+        throw new Error('Foundry did not confirm the upload (it may have been rejected)');
+      }
+
+      this.auditLog('uploadFile', { filename, folder, bytes: bytes.length }, 'success');
+
+      return {
+        success: true,
+        path: response.path,
+        filename,
+        directory,
+        bytes: bytes.length,
+        contentType: mime,
+      };
+    } catch (error) {
+      this.auditLog(
+        'uploadFile',
+        { filename: options?.filename, folder: options?.folder },
+        'failure',
+        error instanceof Error ? error.message : 'Unknown error'
+      );
+      throw new Error(
+        `Failed to upload file: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+
+  // ===== PLAYLIST MANAGEMENT (CRUD + PLAYBACK) =====
+
+  /**
+   * Create or update a playlist, optionally with sounds in one call.
+   * playlist: null -> create; identifier -> update by id or (unique) name.
+   */
+  async managePlaylists(options: {
+    action: 'create' | 'update' | 'delete' | 'describe';
+    playlist?: string | null;
+    name?: string;
+    mode?: number;
+    fade?: number;
+    description?: string;
+    sorting?: 'a' | 'm';
+    folder?: string | null;
+    color?: string | null;
+    sounds?: Array<{
+      name?: string;
+      path?: string;
+      id?: string;
+      volume?: number;
+      repeat?: boolean;
+      fade?: number;
+    }>;
+    /** update: new sounds to add to the playlist. */
+    add_sounds?: Array<{ name?: string; path?: string; volume?: number; repeat?: boolean; fade?: number }>;
+    /** update: sounds to remove (id, exact name or path). */
+    remove_sounds?: string[];
+    updates?: Record<string, any>;
+  }): Promise<any> {
+    this.validateFoundryState();
+
+    try {
+      const playlists = () => (game as any).playlists?.contents || [];
+
+      if (options.action === 'describe') {
+        const doc = options.playlist
+          ? this.findMusicDoc((game as any).playlists, options.playlist, 'playlist')
+          : null;
+        if (!doc) {
+          return {
+            success: true,
+            playlists: playlists().map((pl: any) => ({
+              id: pl.id,
+              name: pl.name,
+              mode: pl.mode,
+              playing: pl.playing,
+              soundCount: pl.sounds?.size || 0,
+            })),
+          };
+        }
+        return {
+          success: true,
+          playlist: {
+            id: doc.id,
+            name: doc.name,
+            mode: doc.mode,
+            playing: doc.playing,
+            description: doc.description || '',
+            folder: doc.folder || null,
+            sort: doc.sort,
+            sounds: (doc.sounds?.contents || []).map((s: any) => ({
+              id: s.id,
+              name: s.name,
+              path: s.path,
+              volume: s.volume,
+              repeat: s.repeat,
+              fade: s.fade,
+              playing: s.playing,
+            })),
+          },
+        };
+      }
+
+      if (options.action === 'create') {
+        if (!options.name || typeof options.name !== 'string') {
+          throw new Error('name is required for create');
+        }
+        const data: Record<string, any> = { name: options.name };
+        if (options.mode !== undefined) data.mode = options.mode;
+        if (options.fade !== undefined) data.fade = options.fade;
+        if (options.description !== undefined) data.description = options.description;
+        if (options.sorting !== undefined) data.sorting = options.sorting;
+        if (options.folder !== undefined) data.folder = options.folder;
+        if (options.color !== undefined) data.color = options.color;
+        const PlaylistClass = (globalThis as any).Playlist ?? (globalThis as any).getDocumentClass?.('Playlist');
+        if (!PlaylistClass?.createDocuments) throw new Error('Foundry Playlist class is not available');
+        const pl = await PlaylistClass.createDocuments([data]);
+        const doc = Array.isArray(pl) ? pl[0] : pl;
+
+        let soundsCreated = 0;
+        for (const s of options.sounds || []) {
+          if (!s.path) {
+            throw new Error(`sound entry needs a "path": ${JSON.stringify(s)}`);
+          }
+          const sdata: Record<string, any> = { path: s.path };
+          if (s.name !== undefined) sdata.name = s.name;
+          if (s.volume !== undefined) sdata.volume = s.volume;
+          if (s.repeat !== undefined) sdata.repeat = s.repeat;
+          if (s.fade !== undefined) sdata.fade = s.fade;
+          await (doc as any).createEmbeddedDocuments('PlaylistSound', [sdata]);
+          soundsCreated++;
+        }
+        return {
+          success: true,
+          playlist: { id: doc.id, name: doc.name, mode: doc.mode },
+          soundsCreated,
+        };
+      }
+
+      if (options.action === 'update') {
+        const doc = this.findMusicDoc((game as any).playlists, options.playlist, 'playlist');
+        if (!doc) throw new Error('update requires a playlist identifier');
+        const patch = { ...(options.updates || {}) } as Record<string, any>;
+        for (const key of [
+          'name',
+          'mode',
+          'fade',
+          'description',
+          'sorting',
+          'folder',
+          'color',
+        ] as const) {
+          if ((options as any)[key] !== undefined) patch[key] = (options as any)[key];
+        }
+        if (Object.keys(patch).length) await doc.update(patch);
+        // Sound-level ops in the same call

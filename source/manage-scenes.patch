@@ -0,0 +1,281 @@
+/**
+ * Pure helpers for manage-regions: turning grid-square shapes into Foundry v14 region data and
+ * describing region behaviours. No Foundry globals, so they can be tested.
+ *
+ * Regions are areas of a scene that do something when tokens enter, leave or move in them:
+ * difficult terrain, traps (with a macro), text pop-ups, teleports and so on. Shapes are given
+ * in grid squares like every other scene object.
+ */
+
+import { assertInsideScene, squaresToPixels, type GridGeometry } from './scene-objects-utils.js';
+
+/** A behaviour to attach to a region. Either a ready-made preset or a raw Foundry behaviour. */
+export interface BehaviorSpec {
+  /** Ready-made: difficult_terrain (movement costs more). */
+  preset?: string;
+  /** difficult_terrain: movement cost multiplier (default 2). */
+  cost?: number;
+  /** Raw Foundry behaviour type, e.g. executeMacro, displayScrollingText, pauseGame. */
+  type?: string;
+  name?: string;
+  /** Raw behaviour settings; see the behavior_types action for the fields of each type. */
+  system?: Record<string, unknown>;
+  disabled?: boolean;
+}
+
+export interface RegionSpec {
+  name?: string;
+  /** Rectangle [x, y, width, height] in grid squares. */
+  rect?: number[];
+  /** Ellipse [centreX, centreY, radiusX, radiusY] in grid squares. */
+  ellipse?: number[];
+  /** Polygon corners [[x, y], ...] in grid squares (3 or more). */
+  polygon?: number[][];
+  color?: string;
+  hidden?: boolean;
+  display_measurements?: boolean;
+  behaviors?: BehaviorSpec[];
+}
+
+export const REGION_PRESETS = ['difficult_terrain'] as const;
+export const MAX_REGIONS_PER_CALL = 100;
+export const MAX_BEHAVIORS_PER_REGION = 10;
+
+const COLOR = /^#[0-9a-fA-F]{6}$/;
+
+/** Default colour for a region: orange for difficult terrain, red otherwise. */
+function defaultColor(spec: RegionSpec): string {
+  const presets = (spec.behaviors ?? []).map(b => b.preset);
+  return presets.includes('difficult_terrain') ? '#c97a1a' : '#e03131';
+}
+
+function numbers(values: unknown, count: number, label: string, what: string): number[] {
+  if (
+    !Array.isArray(values) ||
+    values.length !== count ||
+    values.some(v => typeof v !== 'number' || !Number.isFinite(v))
+  ) {
+    throw new Error(`${label}: ${what} must be ${count} numbers`);
+  }
+  return values as number[];
+}
+
+/** The Foundry shape data for a region spec (pixels). */
+export function buildRegionShape(spec: RegionSpec, geom: GridGeometry, label: string): any {
+  const given = [spec.rect, spec.ellipse, spec.polygon].filter(v => v !== undefined).length;
+  if (given !== 1) {
+    throw new Error(`${label}: give exactly one of rect, ellipse or polygon`);
+  }
+
+  if (spec.rect) {
+    const [x, y, w, h] = numbers(spec.rect, 4, label, 'rect [x, y, width, height]') as [
+      number,
+      number,
+      number,
+      number,
+    ];
+    if (w <= 0 || h <= 0) throw new Error(`${label}: rect width and height must be above 0`);
+    assertInsideScene(geom, x, y, label);
+    assertInsideScene(geom, x + w, y + h, label);
+    const origin = squaresToPixels(geom, x, y);
+    return {
+      type: 'rectangle',
+      x: origin.x,
+      y: origin.y,
+      width: Math.round(w * geom.size),
+      height: Math.round(h * geom.size),
+      rotation: 0,
+      hole: false,
+    };
+  }
+
+  if (spec.ellipse) {
+    const [cx, cy, rx, ry] = numbers(spec.ellipse, 4, label, 'ellipse [centreX, centreY, radiusX, radiusY]') as [
+      number,
+      number,
+      number,
+      number,
+    ];
+    if (rx <= 0 || ry <= 0) throw new Error(`${label}: ellipse radii must be above 0`);
+    assertInsideScene(geom, cx, cy, label);
+    const centre = squaresToPixels(geom, cx, cy);
+    return {
+      type: 'ellipse',
+      x: centre.x,
+      y: centre.y,
+      radiusX: Math.round(rx * geom.size),
+      radiusY: Math.round(ry * geom.size),
+      rotation: 0,
+      hole: false,
+    };
+  }
+
+  const polygon = spec.polygon!;
+  if (!Array.isArray(polygon) || polygon.length < 3 || polygon.length > 200) {
+    throw new Error(`${label}: polygon needs 3 to 200 corners [[x, y], ...]`);
+  }
+  const points: number[] = [];
+  polygon.forEach((corner, index) => {
+    const [x, y] = numbers(corner, 2, `${label} polygon[${index}]`, 'a corner [x, y]') as [number, number];
+    assertInsideScene(geom, x, y, `${label} polygon[${index}]`);
+    const p = squaresToPixels(geom, x, y);
+    points.push(p.x, p.y);
+  });
+  return { type: 'polygon', points, hole: false };
+}
+
+/**
+ * The Foundry behaviour data for one behaviour spec. `movementKeys` are the movement types the
+ * running Foundry knows (walk, swim, ...), read from its own movement-cost schema.
+ */
+export function buildBehaviorData(
+  spec: BehaviorSpec,
+  movementKeys: string[],
+  label: string,
+  dnd5eTerrain = false
+): any {
+  const hasPreset = spec.preset !== undefined;
+  const hasType = spec.type !== undefined;
+  if (hasPreset === hasType) {
+    throw new Error(`${label}: give either preset (${REGION_PRESETS.join(', ')}) or type`);
+  }
+
+  if (hasPreset) {
+    if (spec.preset !== 'difficult_terrain') {
+      throw new Error(`${label}: unknown preset "${spec.preset}" (${REGION_PRESETS.join(', ')})`);
+    }
+    const cost = spec.cost === undefined ? 2 : spec.cost;
+    if (typeof cost !== 'number' || !Number.isFinite(cost) || cost < 0 || cost > 10) {
+      throw new Error(`${label}: cost must be a number from 0 to 10`);
+    }
+    // The dnd5e system's own behaviour (a normal "difficult terrain" region, honoured by its
+    // movement rules) is preferred; it is always double cost, so another cost uses the core one.
+    if (dnd5eTerrain && cost === 2) {
+      return {
+        type: 'dnd5e.difficultTerrain',
+        name: spec.name ?? 'Difficult terrain',
+        system: {},
+        ...(spec.disabled ? { disabled: true } : {}),
+      };
+    }
+    if (movementKeys.length === 0) {
+      throw new Error(`${label}: this Foundry has no movement types to apply difficult terrain to`);
+    }
+    return {
+      type: 'modifyMovementCost',
+      name: spec.name ?? 'Difficult terrain',
+      system: { difficulties: Object.fromEntries(movementKeys.map(key => [key, cost])) },
+      ...(spec.disabled ? { disabled: true } : {}),
+    };
+  }
+
+  if (typeof spec.type !== 'string' || !/^[A-Za-z][A-Za-z0-9._-]{0,63}$/.test(spec.type)) {
+    throw new Error(`${label}: type must be a Foundry behaviour type name such as executeMacro`);
+  }
+  if (spec.system !== undefined && (typeof spec.system !== 'object' || spec.system === null || Array.isArray(spec.system))) {
+    throw new Error(`${label}: system must be an object`);
+  }
+  return {
+    type: spec.type,
+    ...(spec.name !== undefined ? { name: String(spec.name) } : {}),
+    system: spec.system ?? {},
+    ...(spec.disabled ? { disabled: true } : {}),
+  };
+}
+
+/** The complete Foundry region data for a spec. */
+export function buildRegionData(
+  spec: RegionSpec,
+  geom: GridGeometry,
+  movementKeys: string[],
+  label: string,
+  dnd5eTerrain = false
+): any {
+  if (!spec || typeof spec !== 'object') throw new Error(`${label}: must be an object`);
+  if (typeof spec.name !== 'string' || !spec.name.trim()) {
+    throw new Error(`${label}: name is required`);
+  }
+  if (spec.color !== undefined && !COLOR.test(spec.color)) {
+    throw new Error(`${label}: color must look like #RRGGBB`);
+  }
+  const behaviors = spec.behaviors ?? [];
+  if (!Array.isArray(behaviors) || behaviors.length > MAX_BEHAVIORS_PER_REGION) {
+    throw new Error(`${label}: behaviors must be a list of at most ${MAX_BEHAVIORS_PER_REGION}`);
+  }
+  return {
+    name: spec.name.trim(),
+    color: spec.color ?? defaultColor(spec),
+    shapes: [buildRegionShape(spec, geom, label)],
+    behaviors: behaviors.map((b, i) => buildBehaviorData(b, movementKeys, `${label} behaviors[${i}]`, dnd5eTerrain)),
+    ...(spec.hidden !== undefined ? { hidden: !!spec.hidden } : {}),
+    ...(spec.display_measurements !== undefined
+      ? { displayMeasurements: !!spec.display_measurements }
+      : {}),
+  };
+}
+
+/** A short description of a region's shapes in grid squares, for describe. */
+export function describeShape(shape: any, geom: GridGeometry): Record<string, unknown> {
+  const round = (v: number) => Math.round(v * 100) / 100;
+  const sq = (px: number, origin: number) => round((px - origin) / geom.size);
+  if (shape?.type === 'rectangle') {
+    return {
+      type: 'rect',
+      rect: [
+        sq(shape.x, geom.originX),
+        sq(shape.y, geom.originY),
+        round(shape.width / geom.size),
+        round(shape.height / geom.size),
+      ],
+    };
+  }
+  if (shape?.type === 'ellipse') {
+    return {
+      type: 'ellipse',
+      ellipse: [
+        sq(shape.x, geom.originX),
+        sq(shape.y, geom.originY),
+        round(shape.radiusX / geom.size),
+        round(shape.radiusY / geom.size),
+      ],
+    };
+  }
+  if (shape?.type === 'polygon' && Array.isArray(shape.points)) {
+    const polygon: number[][] = [];
+    for (let i = 0; i + 1 < shape.points.length; i += 2) {
+      polygon.push([sq(shape.points[i], geom.originX), sq(shape.points[i + 1], geom.originY)]);
+    }
+    return { type: 'polygon', polygon };
+  }
+  return { type: String(shape?.type ?? 'unknown') };
+}
+
+/**
+ * The fields of a Foundry data model's schema as plain data (name, kind, initial value and
+ * choices), a couple of levels deep, so behaviour settings can be written without guessing.
+ */
+export function describeSchemaFields(fields: any, depth = 2): Record<string, any> {
+  const out: Record<string, any> = {};
+  if (!fields || typeof fields !== 'object') return out;
+  for (const [name, field] of Object.entries<any>(fields)) {
+    if (!field || typeof field !== 'object') continue;
+    const entry: Record<string, any> = { kind: String(field.constructor?.name ?? 'Field') };
+    if (field.options?.initial !== undefined && typeof field.options.initial !== 'function') {
+      entry.initial = field.options.initial;
+    } else if (field.initial !== undefined && typeof field.initial !== 'function') {
+      entry.initial = field.initial;
+    }
+    const choices = field.choices;
+    if (Array.isArray(choices)) entry.choices = choices;
+    else if (choices && typeof choices === 'object') entry.choices = Object.keys(choices);
+    if (depth > 0 && field.fields && typeof field.fields === 'object') {
+      entry.fields = describeSchemaFields(field.fields, depth - 1);
+    }
+    if (depth > 0 && field.element?.choices) {
+      const c = field.element.choices;
+      entry.elementChoices = Array.isArray(c) ? c : Object.keys(c);
+    }
+    out[name] = entry;
+  }
+  return out;
+}

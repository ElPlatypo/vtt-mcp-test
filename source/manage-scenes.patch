@@ -0,0 +1,137 @@
+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+
+export interface JournalToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+}
+
+const pageSchema = z
+  .object({
+    id: z.string().min(1).optional(),
+    name: z.string().min(1).optional(),
+    type: z.enum(['text', 'image']).optional(),
+    content: z.string().max(1_000_000).optional(),
+    src: z.string().min(1).optional(),
+    caption: z.string().optional(),
+    show_title: z.boolean().optional(),
+    title_level: z.number().int().min(1).max(6).optional(),
+  })
+  .strict();
+
+const journalSchema = z
+  .object({
+    action: z.enum(['create', 'update', 'describe']),
+    journal: z.string().min(1).optional(),
+    name: z.string().min(1).optional(),
+    folder: z.string().min(1).optional(),
+    ownership: z.enum(['none', 'limited', 'observer', 'owner']).optional(),
+    pages: z.array(pageSchema).max(100).optional(),
+  })
+  .strict();
+
+export class JournalTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+
+  constructor({ foundryClient, logger }: JournalToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'JournalTools' });
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'manage-journals',
+        description:
+          'Create, update or describe journals with exact pages (never deletes anything). ' +
+          'create: needs name; optional folder (created if missing), ownership (who can see it: none = GM only (default), limited, observer, owner) and pages. ' +
+          'update: needs journal (id or exact name); can rename, move to a folder, change ownership, and upsert pages: a page with an id or an exact existing name is changed, otherwise a new page is added at the end. ' +
+          'describe: lists all journals, or one journal with its full page contents when journal is given. ' +
+          'Text pages take HTML in content (headings, paragraphs, lists, tables). Image pages take src, a Foundry file path such as the one upload-file returns. ' +
+          'In text you can write {{actor: Name}}, {{scene: Name}}, {{journal: Name}}, {{item: Name}} or {{rolltable: Name}} (or {{actor: Name | label}}) to insert a clickable Foundry link; unmatched names are reported as warnings. Scripts and event handlers are removed from the HTML.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: { type: 'string', enum: ['create', 'update', 'describe'] },
+            journal: {
+              type: 'string',
+              description: 'Journal id or exact name (update; optional for describe)',
+            },
+            name: {
+              type: 'string',
+              description: 'Journal name (required for create; renames on update)',
+            },
+            folder: {
+              type: 'string',
+              description: 'Journal folder name; created if it does not exist',
+            },
+            ownership: {
+              type: 'string',
+              enum: ['none', 'limited', 'observer', 'owner'],
+              description:
+                'Default permission for players: none (GM only), limited, observer (can read), owner',
+            },
+            pages: {
+              type: 'array',
+              maxItems: 100,
+              description: 'Pages to create (create) or upsert (update)',
+              items: {
+                type: 'object',
+                properties: {
+                  id: { type: 'string', description: 'Existing page id (update)' },
+                  name: { type: 'string', description: 'Page name (required for new pages)' },
+                  type: { type: 'string', enum: ['text', 'image'], description: 'Default text' },
+                  content: { type: 'string', description: 'HTML for a text page' },
+                  src: { type: 'string', description: 'Foundry file path for an image page' },
+                  caption: { type: 'string', description: 'Caption of an image page' },
+                  show_title: {
+                    type: 'boolean',
+                    description: 'Show the page title in the journal',
+                  },
+                  title_level: {
+                    type: 'number',
+                    description: 'Heading level of the title, 1 to 6',
+                  },
+                },
+                additionalProperties: false,
+              },
+            },
+          },
+          required: ['action'],
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handleManageJournals(args: any): Promise<any> {
+    const parsed = journalSchema.parse(args);
+
+    if (parsed.action === 'create' && !parsed.name) {
+      throw new Error('name is required for create');
+    }
+    if (parsed.action === 'update' && !parsed.journal) {
+      throw new Error('journal is required for update');
+    }
+
+    this.logger.info('Managing journals', {
+      action: parsed.action,
+      journal: parsed.journal ?? parsed.name,
+    });
+
+    try {
+      const result = await this.foundryClient.query('foundry-mcp-bridge.manage-journals', parsed);
+      if (result?.success === false) {
+        throw new Error(result.error || 'Request was refused');
+      }
+      return result;
+    } catch (error) {
+      this.logger.error('Failed to manage journals', error);
+      throw new Error(
+        `Failed to manage journals: ${error instanceof Error ? error.message : 'Unknown error'}`
+      );
+    }
+  }
+}

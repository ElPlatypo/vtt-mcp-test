+import { describe, expect, it } from 'vitest';
+import {
+  BUILTIN_TARGET,
+  comfyBaseUrl,
+  comfyWebSocketUrl,
+  describeComfyTarget,
+  parseComfyTarget,
+  sameComfyTarget,
+} from './comfyui-target.js';
+
+describe('parseComfyTarget', () => {
+  it('defaults to the built-in instance', () => {
+    expect(parseComfyTarget(undefined)).toEqual(BUILTIN_TARGET);
+    expect(parseComfyTarget(null)).toEqual(BUILTIN_TARGET);
+    expect(parseComfyTarget({})).toEqual(BUILTIN_TARGET);
+    expect(parseComfyTarget({ mode: 'builtin', host: 'evil.example', port: 1 })).toEqual(
+      BUILTIN_TARGET
+    );
+  });
+
+  it('accepts a custom host name, address or IPv6 address', () => {
+    expect(parseComfyTarget({ mode: 'custom', host: 'localhost', port: 8188 })).toEqual({
+      mode: 'custom',
+      host: 'localhost',
+      port: 8188,
+      secure: false,
+    });
+    expect(
+      parseComfyTarget({ mode: 'custom', host: ' nexus.lan ', port: 443, secure: true })
+    ).toEqual({ mode: 'custom', host: 'nexus.lan', port: 443, secure: true });
+    expect(parseComfyTarget({ mode: 'custom', host: '192.168.1.20', port: 8188 }).host).toBe(
+      '192.168.1.20'
+    );
+    expect(parseComfyTarget({ mode: 'custom', host: '[::1]', port: 8188 }).host).toBe('[::1]');
+  });
+
+  it.each([
+    ['an unknown mode', { mode: 'cloud' }, 'mode must be'],
+    ['a missing host', { mode: 'custom', port: 8188 }, 'host must be'],
+    ['a URL as host', { mode: 'custom', host: 'http://nexus', port: 8188 }, 'host must be'],
+    ['a host with a port', { mode: 'custom', host: 'nexus:8188', port: 8188 }, 'host must be'],
+    ['a host with a path', { mode: 'custom', host: 'nexus/api', port: 8188 }, 'host must be'],
+    ['a host with credentials', { mode: 'custom', host: 'a@nexus', port: 8188 }, 'host must be'],
+    ['a host with spaces', { mode: 'custom', host: 'my host', port: 8188 }, 'host must be'],
+    ['a text port', { mode: 'custom', host: 'nexus', port: '8188' }, 'port must be'],
+    ['port 0', { mode: 'custom', host: 'nexus', port: 0 }, 'port must be'],
+    ['port 70000', { mode: 'custom', host: 'nexus', port: 70000 }, 'port must be'],
+    ['a fractional port', { mode: 'custom', host: 'nexus', port: 80.5 }, 'port must be'],
+    [
+      'a non-boolean secure',
+      { mode: 'custom', host: 'nexus', port: 80, secure: 'yes' },
+      'secure must be',
+    ],
+  ])('rejects %s', (_label, input, message) => {
+    expect(() => parseComfyTarget(input)).toThrow(message);
+  });
+
+  it('rejects a target that is not an object', () => {
+    expect(() => parseComfyTarget('nexus')).toThrow('must be an object');
+  });
+});
+
+describe('URLs and descriptions', () => {
+  const custom = { mode: 'custom', host: 'nexus', port: 8188, secure: false } as const;
+
+  it('builds http and ws URLs, or https and wss when secure', () => {
+    expect(comfyBaseUrl(BUILTIN_TARGET)).toBe('http://127.0.0.1:31411');
+    expect(comfyBaseUrl(custom)).toBe('http://nexus:8188');
+    expect(comfyBaseUrl({ ...custom, secure: true })).toBe('https://nexus:8188');
+    expect(comfyWebSocketUrl(custom, 'a b')).toBe('ws://nexus:8188/ws?clientId=a%20b');
+    expect(comfyWebSocketUrl({ ...custom, secure: true }, 'x')).toBe(
+      'wss://nexus:8188/ws?clientId=x'
+    );
+  });
+
+  it('compares and describes targets', () => {
+    expect(sameComfyTarget(custom, { ...custom })).toBe(true);
+    expect(sameComfyTarget(custom, { ...custom, port: 1 })).toBe(false);
+    expect(sameComfyTarget(custom, BUILTIN_TARGET)).toBe(false);
+    expect(describeComfyTarget(custom)).toBe('custom ComfyUI at http://nexus:8188');
+    expect(describeComfyTarget(BUILTIN_TARGET)).toBe('built-in ComfyUI at http://127.0.0.1:31411');
+  });
+});
diff --git a/packages/mcp-server/src/comfyui-target.ts b/packages/mcp-server/src/comfyui-target.ts
new file mode 100644
index 0000000..be290a7
--- /dev/null
+++ b/packages/mcp-server/src/comfyui-target.ts
@@ -0,0 +1,74 @@
+/**
+ * Where the map generation service (ComfyUI) lives: the one the bridge installs and starts
+ * itself on this computer ("builtin"), or any ComfyUI you already run ("custom"), on this
+ * computer or another one. Pure helpers, so they can be tested without a server.
+ */
+
+export interface ComfyTarget {
+  mode: 'builtin' | 'custom';
+  host: string;
+  port: number;
+  /** Use https and wss instead of http and ws (for a ComfyUI behind a TLS reverse proxy). */
+  secure: boolean;
+}
+
+export const BUILTIN_COMFY_PORT = 31411;
+
+export const BUILTIN_TARGET: ComfyTarget = {
+  mode: 'builtin',
+  host: '127.0.0.1',
+  port: BUILTIN_COMFY_PORT,
+  secure: false,
+};
+
+const HOSTNAME = /^[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$/;
+const IPV6 = /^\[[0-9A-Fa-f:.]+\]$/;
+
+/**
+ * Check a target sent by the Foundry module. Anything other than a clearly valid custom
+ * target is rejected, so a bad setting can never send requests to a strange address.
+ */
+export function parseComfyTarget(raw: unknown): ComfyTarget {
+  if (raw === undefined || raw === null) return { ...BUILTIN_TARGET };
+  if (typeof raw !== 'object') throw new Error('ComfyUI target must be an object');
+  const input = raw as Record<string, unknown>;
+
+  if (input.mode === undefined || input.mode === 'builtin') return { ...BUILTIN_TARGET };
+  if (input.mode !== 'custom') throw new Error('ComfyUI mode must be "builtin" or "custom"');
+
+  const host = typeof input.host === 'string' ? input.host.trim() : '';
+  if (!host || !(HOSTNAME.test(host) || IPV6.test(host))) {
+    throw new Error(
+      'ComfyUI host must be a host name or IP address (no http://, no port, no path)'
+    );
+  }
+
+  const port = input.port;
+  if (typeof port !== 'number' || !Number.isInteger(port) || port < 1 || port > 65535) {
+    throw new Error('ComfyUI port must be a whole number from 1 to 65535');
+  }
+
+  const secure = input.secure === undefined ? false : input.secure;
+  if (typeof secure !== 'boolean') throw new Error('ComfyUI secure must be true or false');
+
+  return { mode: 'custom', host, port, secure };
+}
+
+export function comfyBaseUrl(target: ComfyTarget): string {
+  return `${target.secure ? 'https' : 'http'}://${target.host}:${target.port}`;
+}
+
+export function comfyWebSocketUrl(target: ComfyTarget, clientId: string): string {
+  return `${target.secure ? 'wss' : 'ws'}://${target.host}:${target.port}/ws?clientId=${encodeURIComponent(clientId)}`;
+}
+
+export function sameComfyTarget(a: ComfyTarget, b: ComfyTarget): boolean {
+  return a.mode === b.mode && a.host === b.host && a.port === b.port && a.secure === b.secure;
+}
+
+/** A short description for messages, e.g. "custom ComfyUI at http://nexus:8188". */
+export function describeComfyTarget(target: ComfyTarget): string {
+  return target.mode === 'builtin'
+    ? `built-in ComfyUI at ${comfyBaseUrl(target)}`
+    : `custom ComfyUI at ${comfyBaseUrl(target)}`;
+}

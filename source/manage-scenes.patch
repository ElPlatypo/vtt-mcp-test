+describe('normalizeShape', () => {
+  it('snaps to the grid, accepts room and centre forms, and keeps free shapes free', () => {
+    expect(normalizeShape({ shape: 'room', at: [2.2, 3.4], size: [4.1, 2.9] }, 's', 1)).toMatchObject({
+      shape: 'rect',
+      rect: [2, 3, 4, 3],
+    });
+    expect(normalizeShape({ shape: 'ellipse', center: [5.3, 5.3], radius: [2.1, 3] }, 's', 1)).toMatchObject({
+      ellipse: [5, 5, 2, 3],
+    });
+    expect(normalizeShape({ shape: 'polygon', polygon: [[0.3, 0.3], [4.4, 0.6], [2.2, 3.9]] }, 's', 0)).toMatchObject({
+      polygon: [[0.3, 0.3], [4.4, 0.6], [2.2, 3.9]],
+    });
+    expect(normalizeShape({ shape: 'rect', rect: [1.3, 1.3, 2, 2], snap: 0 }, 's', 1)).toMatchObject({
+      rect: [1.3, 1.3, 2, 2],
+    });
+    expect(normalizeShape({ shape: 'door', at: [7.2, 3.4], dir: 'v' }, 's', 1)).toMatchObject({ at: [7.25, 3.5] });
+  });
+
+  it('never makes a room smaller than one square', () => {
+    expect(normalizeShape({ shape: 'room', at: [1, 1], size: [0.2, 0.2] }, 's', 1)).toMatchObject({ rect: [1, 1, 1, 1] });
+  });
+
+  it('turns cells into runs and rejects bad ones', () => {
+    expect(normalizeShape({ shape: 'cells', cells: [[1, 1], [2, 1, 3, 1]] }, 's', 1)).toMatchObject({
+      cells: [[1, 1, 1, 1], [2, 1, 3, 1]],
+    });
+    expect(() => normalizeShape({ shape: 'cells', cells: [[1.5, 1]] }, 's', 1)).toThrow();
+    expect(() => normalizeShape({ shape: 'cells', cells: [] }, 's', 1)).toThrow();
+  });
+
+  it('rotates about the centre', () => {
+    const rotated = shapePolygons({ shape: 'rect', rect: [0, 0, 4, 2], rotate: 90 }, 1)[0]!;
+    const xs = rotated.map(p => Math.round(p[0] * 100) / 100);
+    const ys = rotated.map(p => Math.round(p[1] * 100) / 100);
+    expect([Math.min(...xs), Math.max(...xs)]).toEqual([1, 3]);
+    expect([Math.min(...ys), Math.max(...ys)]).toEqual([-1, 3]);
+  });
+});
+
+function tools_noFoundry() {
+  return tools();
+}
+
+describe('layout tool', () => {
+  it('builds a layout in steps and shows the text map after each change', async () => {
+    const t = tools();

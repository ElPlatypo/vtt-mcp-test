+/** manage-scene-objects describe shows the details update can change. Foundry is stubbed. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+
+const MODULE = 'foundry-mcp-bridge-scenes';
+const mine = { [MODULE]: { sceneObjectsTool: true } };
+const col = (docs: any[]) => ({ contents: docs, get: (id: string) => docs.find(d => d.id === id) });
+
+function setup() {
+  const scene: any = {
+    id: 's1',
+    name: 'Town',
+    width: 2000,
+    height: 1500,
+    padding: 0,
+    grid: { size: 100, distance: 5, units: 'ft' },
+    dimensions: { sceneX: 0, sceneY: 0, sceneWidth: 2000, sceneHeight: 1500 },
+    tokens: col([
+      { id: 't1', name: 'Boss', actorId: 'a', x: 100, y: 100, width: 1, height: 1, hidden: false, disposition: -1, elevation: 10, flags: mine },
+      { id: 't2', name: 'Guest', x: 0, y: 0, width: 1, height: 1, disposition: 1, flags: {} },
+      { id: 't3', name: 'Odd', x: 0, y: 0, width: 1, height: 1, disposition: -2, flags: {} },
+    ]),
+    lights: col([{ id: 'l1', x: 0, y: 0, config: { bright: 15, dim: 30, color: '#ff0000', alpha: 0.7, angle: 90, animation: { type: 'torch' } }, flags: mine }, { id: 'l2', x: 0, y: 0, config: { bright: 5, dim: 10 }, flags: {} }]),
+    walls: col([
+      { id: 'w1', c: [0, 0, 100, 0], door: 1, ds: 2, flags: mine },
+      { id: 'w2', c: [0, 0, 100, 0], door: 2, ds: 1, flags: mine },
+      { id: 'w3', c: [0, 0, 100, 0], door: 1, ds: 0, flags: mine },
+      { id: 'w4', c: [0, 0, 100, 0], door: 0, ds: 0, flags: mine },
+    ]),
+    notes: col([]),
+    tiles: col([{ id: 'ti1', x: 0, y: 0, width: 200, height: 100, rotation: 45, alpha: 0.4, elevation: 3, texture: { src: 'a.png' }, flags: mine }]),
+    sounds: col([{ id: 'so1', x: 0, y: 0, radius: 25, path: 'a.mp3', volume: 0.2, repeat: true, walls: false, easing: true, flags: mine }]),
+  };
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'GM' },
+    scenes: { contents: [scene], viewed: scene, current: scene },
+    actors: { contents: [] },
+    settings: { get: () => true },
+  });
+  return new FoundryDataAccess();
+}
+
+describe('describe shows what update can change', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('lists token disposition and elevation, light angle, alpha and animation', async () => {
+    const r = await setup().manageSceneObjects({ action: 'describe', scene: 's1' });
+    expect(r.tokens[0]).toMatchObject({ id: 't1', disposition: 'hostile', elevation: 10, createdByTool: true });
+    expect(r.tokens[1].disposition).toBe('friendly');
+    expect(r.tokens[2].disposition).toBe('secret');
+    expect(r.lights[0]).toMatchObject({ alpha: 0.7, angle: 90, animation: 'torch', color: '#ff0000' });
+    expect(r.lights[1]).toMatchObject({ alpha: 0.5, angle: 360, animation: null });
+  });
+  it('gives the state of doors but not of plain walls', async () => {
+    const r = await setup().manageSceneObjects({ action: 'describe', scene: 's1', kind: 'wall' });
+    const byId = Object.fromEntries(r.walls.map((w: any) => [w.id, w]));
+    expect(byId.w1).toMatchObject({ door: 'door', doorState: 'locked' });
+    expect(byId.w2).toMatchObject({ door: 'secret_door', doorState: 'open' });
+    expect(byId.w3).toMatchObject({ door: 'door', doorState: 'closed' });
+    expect(byId.w4).not.toHaveProperty('doorState');
+  });
+  it('lists tile opacity and elevation and sound walls and easing', async () => {
+    const r = await setup().manageSceneObjects({ action: 'describe', scene: 's1' });
+    expect(r.tiles[0]).toMatchObject({ alpha: 0.4, elevation: 3, rotation: 45, width: 2, height: 1 });
+    expect(r.sounds[0]).toMatchObject({ walls: false, easing: true, volume: 0.2, radiusSquares: 5 });
+  });
+});

+    expect(
+      readComfyForm({
+        mapGenMode: 'custom',
+        mapGenCustomHost: 'https://comfy.example.com',
+        mapGenCustomPort: '',
+      })
+    ).toEqual({
+      ok: true,
+      value: { mode: 'custom', host: 'comfy.example.com', port: 443, secure: true },
+    });
+  });
+
+  it.each([
+    [
+      'no host',
+      { mapGenMode: 'custom', mapGenCustomHost: '', mapGenCustomPort: 8188 },
+      'host must be',
+    ],
+    [
+      'a host with a path',
+      { mapGenMode: 'custom', mapGenCustomHost: 'nexus/api', mapGenCustomPort: 8188 },
+      'host must be',
+    ],
+    [

+import { describe, expect, it, vi } from 'vitest';
+import { ShareTools } from './share-tools.js';
+
+function make(result: any = { success: true }) {
+  const query = vi.fn(async () => result);
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  return { tools: new ShareTools({ foundryClient: { query } as any, logger }), query };
+}
+
+describe('share-with-players', () => {
+  it('sends an image or a journal to the bridge', async () => {
+    const { tools, query } = make();
+    await tools.handleShareWithPlayers({ image: 'a/map.png', title: 'The cave', chat: true });
+    expect(query).toHaveBeenCalledWith('foundry-mcp-bridge.share-with-players', { image: 'a/map.png', title: 'The cave', chat: true });
+    await tools.handleShareWithPlayers({ journal: 'Notes', users: ['Ann'] });
+    expect(query).toHaveBeenLastCalledWith('foundry-mcp-bridge.share-with-players', { journal: 'Notes', users: ['Ann'] });
+  });
+  it('needs exactly one of image and journal', async () => {
+    const { tools } = make();
+    await expect(tools.handleShareWithPlayers({})).rejects.toThrow();
+    await expect(tools.handleShareWithPlayers({ image: 'a', journal: 'b' })).rejects.toThrow();
+  });
+  it('passes on a refusal', async () => {
+    const { tools } = make({ success: false, error: 'nope' });
+    await expect(tools.handleShareWithPlayers({ journal: 'x' })).rejects.toThrow('nope');
+  });
+});

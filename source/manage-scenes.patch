@@ -0,0 +1,117 @@
+/** party: status, rests, xp, level-up. Foundry and dnd5e are stubbed. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+import { partyRow, pickActors, pickClass, splitXp } from './party-utils.js';
+
+describe('party utils', () => {
+  const actors: any[] = [
+    { id: 'a1', name: 'Mira', type: 'character', hasPlayerOwner: true },
+    { id: 'a2', name: 'Bo', type: 'character', hasPlayerOwner: false },
+    { id: 'a3', name: 'Goblin', type: 'npc' },
+  ];
+  const owned = (a: any) => !!a.hasPlayerOwner;
+  it('picks the party, all characters, or names', () => {
+    expect(pickActors(actors, undefined, owned).picked.map(p => p.name)).toEqual(['Mira']);
+    expect(pickActors(actors, ['all_characters'], owned).picked.map(p => p.name)).toEqual(['Mira', 'Bo']);
+    expect(pickActors(actors, ['bo', 'gob', 'Dragon'], owned)).toMatchObject({ notFound: ['Dragon'] });
+  });
+  it('writes a row with xp, hit dice and the level-up flag', () => {
+    const row = partyRow({ name: 'Mira', system: { details: { level: 3, xp: { value: 950, max: 900 } }, attributes: { hp: { value: 10, max: 20 }, hd: { value: 2, max: 3 } } } });
+    expect(row).toEqual({ name: 'Mira', level: 3, xp: '950/900', readyToLevelUp: true, hp: '10/20', hitDice: '2/3' });
+  });
+  it('splits xp without losing any and picks a class', () => {
+    expect(splitXp(100, 3)).toEqual([34, 33, 33]);
+    expect(splitXp(5, 0)).toEqual([]);
+    const fighter = { name: 'Fighter' };
+    const wizard = { name: 'Wizard' };
+    expect(pickClass({ itemTypes: { class: [fighter] } })).toBe(fighter);
+    expect(pickClass({ itemTypes: { class: [fighter, wizard] } })).toBeNull();
+    expect(pickClass({ itemTypes: { class: [fighter, wizard] } }, 'wiz')).toBe(wizard);
+  });
+});
+
+function setup() {
+  const mk = (id: string, name: string, xp: number, max: number) => {
+    const system: any = { details: { level: 3, xp: { value: xp, max } }, attributes: { hp: { value: 5, max: 20 }, hd: { value: 1, max: 3 } } };
+    const actor: any = {
+      id,
+      name,
+      type: 'character',
+      hasPlayerOwner: true,
+      system,
+      itemTypes: { class: [{ id: 'cl1', name: 'Fighter' }] },
+      update: vi.fn(async (patch: any) => {
+        system.details.xp.value = patch['system.details.xp.value'];
+      }),
+      longRest: vi.fn(async () => {
+        system.attributes.hp.value = 20;
+        system.attributes.hd.value = 2;
+      }),
+      shortRest: vi.fn(async () => {
+        system.attributes.hp.value = 12;
+      }),
+    };
+    return actor;
+  };
+  const mira = mk('a1', 'Mira', 800, 900);
+  const bo = mk('a2', 'Bo', 100, 900);
+  const render = vi.fn(async () => undefined);
+  const forLevelChange = vi.fn(async () => ({ render }));
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('dnd5e', { applications: { advancement: { AdvancementManager: { forLevelChange } } } });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'GM', isGM: true },
+    actors: { contents: [mira, bo] },
+    settings: { get: (_m: string, key: string) => (key === 'allowWriteOperations' ? true : undefined) },
+  });
+  return { da: new FoundryDataAccess(), mira, bo, forLevelChange, render };
+}
+
+describe('controlParty', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('reports the party', async () => {
+    const { da } = setup();
+    const r = await da.controlParty({ action: 'status' });
+    expect(r.party.map((p: any) => p.name)).toEqual(['Mira', 'Bo']);
+    expect(r.party[0]).toMatchObject({ level: 3, xp: '800/900', hp: '5/20', hitDice: '1/3' });
+  });
+  it('long and short rests go through the system with no dialog', async () => {
+    const { da, mira, bo } = setup();
+    const long = await da.controlParty({ action: 'rest', type: 'long' });
+    expect(mira.longRest).toHaveBeenCalledWith({ dialog: false, advanceTime: false, newDay: true });
+    expect(long.party[0]).toMatchObject({ name: 'Mira', hp: '20/20', hpBefore: 5 });
+    await da.controlParty({ action: 'rest', type: 'short', who: ['Bo'], spend_hit_dice: false });
+    expect(bo.shortRest).toHaveBeenCalledWith({ dialog: false, advanceTime: false, autoHD: false });
+    expect(mira.shortRest).not.toHaveBeenCalled();
+    await expect(da.controlParty({ action: 'rest' })).rejects.toThrow('short or long');
+  });
+  it('gives xp to each or split, and flags a level-up', async () => {
+    const { da, mira, bo } = setup();
+    const each = await da.controlParty({ action: 'xp', amount: 150 });
+    expect(mira.update).toHaveBeenCalledWith({ 'system.details.xp.value': 950 });
+    expect(each.party[0]).toMatchObject({ gained: 150, readyToLevelUp: true });
+    const split = await da.controlParty({ action: 'xp', amount: 101, split: true });
+    expect(mira.update).toHaveBeenLastCalledWith({ 'system.details.xp.value': 1001 });
+    expect(bo.update).toHaveBeenLastCalledWith({ 'system.details.xp.value': 300 });
+    expect(split.party.map((p: any) => p.gained)).toEqual([51, 50]);
+    await expect(da.controlParty({ action: 'xp', amount: 0 })).rejects.toThrow('above 0');
+  });
+  it('opens the level-up window for a character', async () => {
+    const { da, forLevelChange, render } = setup();
+    const r = await da.controlParty({ action: 'level_up', actor: 'Mira' });
+    expect(forLevelChange).toHaveBeenCalledWith(expect.objectContaining({ name: 'Mira' }), 'cl1', 1);
+    expect(render).toHaveBeenCalledWith({ force: true });
+    expect(r).toMatchObject({ opened: true, class: 'Fighter' });
+  });
+  it('says so when nobody matches and rejects unknown actions', async () => {
+    const { da } = setup();
+    const r = await da.controlParty({ action: 'status', who: ['Nobody'] });
+    expect(r.party).toEqual([]);
+    expect(r.notFound).toEqual(['Nobody']);
+    await expect(da.controlParty({ action: 'dance' })).rejects.toThrow('action must be one of');
+  });
+});

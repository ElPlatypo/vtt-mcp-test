index 0000000..6c9da45
--- /dev/null
+++ b/packages/foundry-module/src/annotation-utils.ts
@@ -0,0 +1,235 @@
+/**
+ * Notes the GM leaves on a scene for Claude: a click on one object or a drawn area, with what
+ * should change. Plain data and geometry only; Foundry itself is not touched here.
+ */
+
+export type AnnotationStatus = 'open' | 'done' | 'dismissed';
+export const ANNOTATION_STATUSES: AnnotationStatus[] = ['open', 'done', 'dismissed'];
+export const ANNOTATION_KINDS = ['token', 'light', 'tile', 'sound', 'note', 'drawing', 'wall', 'region'] as const;
+export type AnnotationKind = (typeof ANNOTATION_KINDS)[number];
+
+export type Point = [number, number];
+
+export interface AnnotationTarget {
+  kind: AnnotationKind;
+  id: string;
+  name?: string;
+  /** grid squares from the top-left of the map (a wall: its middle) */
+  x: number;
+  y: number;
+  width?: number;
+  height?: number;
+  /** a door: its state */
+  door?: string;
+}
+
+export interface AnnotationArea {
+  shape: 'rect' | 'polygon';
+  points: Point[];
+  bbox: { x: number; y: number; width: number; height: number };
+}
+
+export interface Annotation {
+  id: string;
+  /** shown on the map pin; counts up per scene */
+  number: number;
+  scene: string;
+  sceneName: string;
+  type: 'object' | 'area';
+  target?: AnnotationTarget;
+  area?: AnnotationArea;
+  prompt: string;
+  status: AnnotationStatus;
+  created: number;
+  reply?: string;
+  resolved?: number;
+}
+
+export const MAX_PROMPT = 2000;
+
+export function newAnnotationId(): string {
+  const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
+  let id = 'n';
+  for (let i = 0; i < 9; i++) id += chars[Math.floor(Math.random() * chars.length)];
+  return id;
+}
+
+/** Grid squares to one decimal, so notes stay readable. */
+export const roundSquares = (value: number): number => Math.round(value * 10) / 10;
+
+export function polygonBounds(points: Point[]): { x: number; y: number; width: number; height: number } {
+  const xs = points.map(p => p[0]);
+  const ys = points.map(p => p[1]);
+  const x = Math.min(...xs);
+  const y = Math.min(...ys);
+  return { x: roundSquares(x), y: roundSquares(y), width: roundSquares(Math.max(...xs) - x), height: roundSquares(Math.max(...ys) - y) };
+}
+
+export function rectPoints(x1: number, y1: number, x2: number, y2: number): Point[] {
+  const left = Math.min(x1, x2);
+  const right = Math.max(x1, x2);
+  const top = Math.min(y1, y2);
+  const bottom = Math.max(y1, y2);
+  return [[left, top], [right, top], [right, bottom], [left, bottom]];
+}
+
+export function makeArea(points: Point[], shape: 'rect' | 'polygon'): AnnotationArea {
+  if (!Array.isArray(points) || points.length < 3) throw new Error('An area needs at least three points');
+  const rounded = points.map(p => [roundSquares(p[0]), roundSquares(p[1])] as Point);
+  return { shape, points: rounded, bbox: polygonBounds(rounded) };
+}
+
+export function pointInPolygon(point: Point, polygon: Point[]): boolean {
+  let inside = false;
+  for (let i = 0, j = polygon.length - 1; i < polygon.length; j = i++) {
+    const [xi, yi] = polygon[i]!;
+    const [xj, yj] = polygon[j]!;
+    if (yi > point[1] !== yj > point[1] && point[0] < ((xj - xi) * (point[1] - yi)) / (yj - yi) + xi) inside = !inside;
+  }
+  return inside;
+}
+
+export function distanceToSegment(p: Point, a: Point, b: Point): number {
+  const dx = b[0] - a[0];
+  const dy = b[1] - a[1];
+  const lengthSq = dx * dx + dy * dy;
+  const t = lengthSq === 0 ? 0 : Math.max(0, Math.min(1, ((p[0] - a[0]) * dx + (p[1] - a[1]) * dy) / lengthSq));
+  return Math.hypot(p[0] - (a[0] + t * dx), p[1] - (a[1] + t * dy));
+}
+
+/** What can be clicked on a scene, in grid squares. */
+export interface Clickable {
+  kind: AnnotationKind;
+  id: string;
+  name?: string;
+  /** rectangle (tokens, tiles, drawings): top-left and size */
+  x?: number;
+  y?: number;
+  width?: number;
+  height?: number;
+  /** a point (lights, sounds, pins): where it is */
+  at?: Point;
+  /** a wall: its two ends */
+  segment?: [Point, Point];
+  /** a region: its outline */
+  polygon?: Point[];
+  door?: string;
+}
+
+/** Smaller things win over what lies under them; tokens first. */
+const PRIORITY: Record<AnnotationKind, number> = { token: 0, note: 1, light: 2, sound: 3, wall: 4, drawing: 5, region: 6, tile: 7 };
+
+const POINT_REACH = 0.45;
+const WALL_REACH = 0.3;
+
+function hitDistance(c: Clickable, p: Point): number | null {
+  if (c.at) {
+    const d = Math.hypot(c.at[0] - p[0], c.at[1] - p[1]);
+    return d <= POINT_REACH ? d : null;
+  }
+  if (c.segment) {
+    const d = distanceToSegment(p, c.segment[0], c.segment[1]);
+    return d <= WALL_REACH ? d : null;
+  }
+  if (c.polygon) return pointInPolygon(p, c.polygon) ? 0 : null;
+  if (c.x !== undefined && c.y !== undefined && c.width !== undefined && c.height !== undefined) {
+    return p[0] >= c.x && p[0] <= c.x + c.width && p[1] >= c.y && p[1] <= c.y + c.height ? 0 : null;
+  }
+  return null;
+}
+
+const area = (c: Clickable): number => (c.width !== undefined && c.height !== undefined ? c.width * c.height : 0);
+
+/** The thing under a point: by kind priority, then the smallest, then the nearest. */
+export function hitTest(things: Clickable[], point: Point): Clickable | null {
+  const hits = things
+    .map(c => ({ c, d: hitDistance(c, point) }))
+    .filter((h): h is { c: Clickable; d: number } => h.d !== null);
+  if (hits.length === 0) return null;
+  hits.sort((a, b) => PRIORITY[a.c.kind] - PRIORITY[b.c.kind] || area(a.c) - area(b.c) || a.d - b.d);
+  return hits[0]!.c;
+}
+
+export function targetOf(c: Clickable): AnnotationTarget {
+  let x = c.x ?? 0;
+  let y = c.y ?? 0;
+  if (c.at) [x, y] = c.at;
+  if (c.segment) {
+    x = (c.segment[0][0] + c.segment[1][0]) / 2;
+    y = (c.segment[0][1] + c.segment[1][1]) / 2;
+  }
+  if (c.polygon) {
+    const b = polygonBounds(c.polygon);
+    x = b.x;
+    y = b.y;
+  }
+  return {
+    kind: c.kind,
+    id: c.id,
+    ...(c.name ? { name: c.name } : {}),
+    x: roundSquares(x),
+    y: roundSquares(y),
+    ...(c.width !== undefined ? { width: roundSquares(c.width) } : {}),
+    ...(c.height !== undefined ? { height: roundSquares(c.height) } : {}),
+    ...(c.door ? { door: c.door } : {}),
+  };
+}
+
+export interface NewAnnotation {
+  scene: string;
+  sceneName: string;
+  prompt: string;
+  target?: AnnotationTarget;
+  area?: AnnotationArea;
+}
+
+export function makeAnnotation(input: NewAnnotation, existing: Annotation[], now: number = Date.now()): Annotation {
+  const prompt = (input.prompt ?? '').trim();
+  if (!prompt) throw new Error('Write what should change');
+  if (prompt.length > MAX_PROMPT) throw new Error(`The note may be at most ${MAX_PROMPT} characters`);
+  if (!!input.target === !!input.area) throw new Error('A note needs either a target object or an area');
+  const number = existing.reduce((max, a) => Math.max(max, a.number), 0) + 1;
+  return {
+    id: newAnnotationId(),
+    number,
+    scene: input.scene,
+    sceneName: input.sceneName,
+    type: input.target ? 'object' : 'area',
+    ...(input.target ? { target: input.target } : {}),
+    ...(input.area ? { area: input.area } : {}),
+    prompt,
+    status: 'open',
+    created: now,
+  };
+}
+
+export function applyResolve(a: Annotation, change: { status?: AnnotationStatus; reply?: string }, now: number = Date.now()): Annotation {
+  if (change.status !== undefined && !ANNOTATION_STATUSES.includes(change.status)) {
+    throw new Error(`status must be one of: ${ANNOTATION_STATUSES.join(', ')}`);
+  }
+  if (change.reply !== undefined && change.reply.length > MAX_PROMPT) throw new Error(`The reply may be at most ${MAX_PROMPT} characters`);
+  const next: Annotation = { ...a };
+  if (change.status !== undefined) {
+    next.status = change.status;
+    if (change.status === 'open') delete next.resolved;
+    else next.resolved = now;
+  }
+  if (change.reply !== undefined) {
+    if (change.reply.trim()) next.reply = change.reply.trim();
+    else delete next.reply;
+  }
+  return next;
+}
+
+/** What lies inside an area, counted by kind, with token names. */
+export function summariseArea(things: Array<{ kind: string; name?: string; x: number; y: number }>, areaDef: AnnotationArea): Record<string, any> {
+  const inside = things.filter(t => pointInPolygon([t.x, t.y], areaDef.points));
+  const out: Record<string, any> = {};
+  const tokens = inside.filter(t => t.kind === 'token').map(t => t.name ?? 'token');
+  if (tokens.length > 0) out.tokens = tokens;
+  for (const t of inside) {
+    if (t.kind === 'token') continue;
+    out[`${t.kind}s`] = (out[`${t.kind}s`] ?? 0) + 1;
+  }
+  return out;
+}

+    check('name', typeof options.name === 'string' ? options.name.trim() : undefined, summary.name);
+    check('width', options.width, summary.width);
+    check('height', options.height, summary.height);
+    check('padding', options.padding, summary.padding);
+    check('grid_size', options.grid_size, summary.grid?.size);
+    check('grid_distance', options.grid_distance, summary.grid?.distance);
+    check('grid_units', options.grid_units, summary.grid?.units);
+    check('grid_type', options.grid_type, summary.grid?.type);
+    // null means "reset to default" on v14, so only a concrete colour can be compared.
+    if (typeof options.background_color === 'string') {
+      check('background_color', options.background_color, summary.backgroundColor);
+    }
+    check('token_vision', options.token_vision, summary.tokenVision);
+    check('darkness', options.darkness, summary.darkness);
+    check('global_light', options.global_light, summary.globalLight);
+    check('navigation', options.navigation, summary.navigation);

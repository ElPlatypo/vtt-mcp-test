+import { describe, expect, it, vi } from 'vitest';
+import { defaultLabelEvery, drawPreview, previewScale } from './preview-utils.js';
+import type { GridGeometry } from './scene-objects-utils.js';
+
+const geom: GridGeometry = {
+  size: 100,
+  originX: 0,
+  originY: 0,
+  sceneWidth: 1000,
+  sceneHeight: 500,
+  columns: 10,
+  rows: 5,
+  distance: 5,
+  units: 'ft',
+};
+
+function fakeContext() {
+  const texts: Array<{ text: string; x: number; y: number }> = [];
+  const lines: Array<[number, number, number, number]> = [];
+  let last: [number, number] = [0, 0];
+  let from: [number, number] = [0, 0];
+  const ctx: any = {
+    texts,
+    lines,
+    fillRect: vi.fn(),
+    drawImage: vi.fn(),
+    beginPath: vi.fn(),
+    closePath: vi.fn(),
+    moveTo: vi.fn((x: number, y: number) => {
+      from = [x, y];
+    }),
+    lineTo: vi.fn((x: number, y: number) => {
+      last = [x, y];
+      lines.push([from[0], from[1], last[0], last[1]]);
+    }),
+    arc: vi.fn(),
+    stroke: vi.fn(),
+    fill: vi.fn(),
+    setLineDash: vi.fn(),
+    strokeText: vi.fn(),
+    fillText: vi.fn((text: string, x: number, y: number) => texts.push({ text, x, y })),
+  };
+  return ctx;
+}
+
+describe('previewScale and defaultLabelEvery', () => {
+  it('shrinks big scenes to the maximum size and never enlarges', () => {
+    expect(previewScale({ ...geom, sceneWidth: 4000 }, 1600)).toBe(0.4);
+    expect(previewScale(geom, 1600)).toBe(1);
+  });
+
+  it('labels more sparsely when squares get small', () => {
+    expect(defaultLabelEvery(geom, 1)).toBe(1);
+    expect(defaultLabelEvery(geom, 0.2)).toBe(2);
+    expect(defaultLabelEvery(geom, 0.1)).toBe(4);
+  });
+});

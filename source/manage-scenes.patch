+/**
+ * upload-file tests. Foundry's file picker is stubbed: these check what the bridge asks
+ * Foundry to do (which folders, which file, which checks) and that unsafe input is refused
+ * before anything is uploaded. Whether a real Foundry accepts the upload needs a real world.
+ */
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+import { UPLOAD_MAX_BYTES } from './upload-utils.js';
+
+const PNG_HEAD = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a];
+
+function pngBase64(extraBytes = 16): string {
+  return Buffer.from([...PNG_HEAD, ...new Array(extraBytes).fill(7)]).toString('base64');
+}
+
+function setup(
+  options: { allowWriteOperations?: boolean; existingFiles?: string[]; noWorld?: boolean } = {}
+) {
+  const createDirectory = vi.fn(async () => undefined);
+  const browse = vi.fn(async () => ({ files: options.existingFiles ?? [] }));
+  const upload = vi.fn(async (_source: string, directory: string, file: File) => ({
+    status: 'success',
+    path: `${directory}/${file.name}`,
+  }));
+
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('FilePicker', { createDirectory, browse, upload });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: options.noWorld
+      ? { getFlag: vi.fn(() => []), setFlag: vi.fn() }
+      : { id: 'world-1', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'Gamemaster' },
+    settings: {
+      get: (_module: string, key: string) =>
+        key === 'allowWriteOperations' ? (options.allowWriteOperations ?? true) : undefined,
+    },
+  });
+
+  return { dataAccess: new FoundryDataAccess(), createDirectory, browse, upload };
+}
+
+describe('FoundryDataAccess.uploadFile', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('uploads into the world upload folder and returns the Foundry path', async () => {
+    const { dataAccess, createDirectory, upload } = setup();
+
+    const result = await dataAccess.uploadFile({ filename: 'Cave.PNG', imageData: pngBase64() });
+
+    expect(createDirectory.mock.calls.map(c => c[1])).toEqual([
+      'worlds',
+      'worlds/world-1',
+      'worlds/world-1/uploads',
+    ]);
+    expect(upload).toHaveBeenCalledTimes(1);
+    const [source, directory, file, , uploadOptions] = upload.mock.calls[0] as unknown as [
+      string,
+      string,
+      File,
+      unknown,
+      unknown,
+    ];
+    expect(source).toBe('data');
+    expect(directory).toBe('worlds/world-1/uploads');
+    expect(file.name).toBe('Cave.png');
+    expect(file.type).toBe('image/png');
+    expect(file.size).toBe(PNG_HEAD.length + 16);
+    expect(uploadOptions).toEqual({ notify: false });
+    expect(result).toMatchObject({
+      success: true,
+      path: 'worlds/world-1/uploads/Cave.png',
+      filename: 'Cave.png',
+      directory: 'worlds/world-1/uploads',
+      contentType: 'image/png',
+    });
+  });
+
+  it('creates and uses a nested sub-folder', async () => {
+    const { dataAccess, createDirectory, upload } = setup();
+
+    const result = await dataAccess.uploadFile({
+      filename: 'a.png',
+      imageData: pngBase64(),
+      folder: 'maps/phandelver',
+    });
+
+    expect(createDirectory.mock.calls.map(c => c[1])).toEqual([
+      'worlds',
+      'worlds/world-1',
+      'worlds/world-1/uploads',
+      'worlds/world-1/uploads/maps',
+      'worlds/world-1/uploads/maps/phandelver',
+    ]);
+    expect(upload.mock.calls[0][1]).toBe('worlds/world-1/uploads/maps/phandelver');
+    expect(result.path).toBe('worlds/world-1/uploads/maps/phandelver/a.png');
+  });
+
+  it('keeps going when a directory already exists', async () => {

+++ b/packages/foundry-module/src/chat-utils.ts
@@ -0,0 +1,78 @@
+/**
+ * Chat reading: turning chat messages into short rows that say who spoke, what they said or rolled,
+ * and who a whisper was for, and picking the messages after a marker.
+ */
+import { MODULE_ID } from './constants.js';
+import { htmlToText } from './rules-utils.js';
+
+export interface ChatRow {
+  id: string;
+  /** the player or GM who sent it */
+  who: string;
+  /** the character, token or alias it was sent as, when different */
+  as?: string;
+  kind: 'say' | 'roll' | 'whisper' | 'card';
+  text?: string;
+  roll?: { formula: string; total: number | string };
+  flavor?: string;
+  /** recipients of a whisper */
+  to?: string[];
+  fromGM: boolean;
+  /** made by the bridge, the game system or a macro (narration, cards, tool rolls), not typed by a person */
+  auto?: boolean;
+}
+
+const MAX_TEXT = 400;
+
+const cut = (text: string): string => (text.length > MAX_TEXT ? text.slice(0, MAX_TEXT - 3) + '...' : text);
+
+/** One chat message as a compact row. */
+export function chatRow(message: any, userName: (id: string) => string | undefined): ChatRow {
+  const author = message.author ?? undefined;
+  const authorId = author?.id ?? (typeof message.user === 'string' ? message.user : message.user?.id);
+  const who = author?.name ?? message.user?.name ?? (authorId ? userName(authorId) : undefined) ?? 'unknown';
+  const fromGM = !!(author?.isGM ?? message.user?.isGM);
+  const alias = message.speaker?.alias;
+  const text = htmlToText(message.content).replace(/\s+/g, ' ').trim();
+  const rolls: any[] = Array.isArray(message.rolls) ? message.rolls : [];
+  const whisper: string[] = Array.isArray(message.whisper) ? message.whisper : [];
+  const row: ChatRow = { id: message.id, who, fromGM, kind: whisper.length ? 'whisper' : rolls.length ? 'roll' : text ? 'say' : 'card' };
+  // The bridge marks what it posts with a flag; the system's cards have their own flags and message type.
+  const flags = message.flags ?? {};
+  if (flags[MODULE_ID]?.bridge || flags[MODULE_ID]?.tts || flags.dnd5e || (message.type && message.type !== 'base') || (fromGM && rolls.length)) row.auto = true;
+  if (alias && alias !== who) row.as = alias;
+  if (text) row.text = cut(text);
+  if (rolls.length) row.roll = { formula: String(rolls[0].formula ?? ''), total: rolls[0].total ?? '' };
+  if (message.flavor) row.flavor = cut(htmlToText(message.flavor));
+  if (whisper.length) {
+    row.to = whisper.map(id => userName(id) ?? id);
+    if (rolls.length && row.kind === 'whisper') row.roll = { formula: String(rolls[0].formula ?? ''), total: rolls[0].total ?? '' };
+  }
+  return row;
+}
+
+export interface ChatFilter {
+  /** only messages after this message id */
+  since?: string | undefined;
+  /** players: only what players sent; all: everything */
+  from?: 'players' | 'all' | undefined;
+  /** false drops pure roll messages */
+  rolls?: boolean | undefined;
+}
+
+/** The messages that pass the filter, oldest first. Unknown `since` ids count as no marker. */
+export function selectMessages(messages: any[], filter: ChatFilter, userName: (id: string) => string | undefined): ChatRow[] {
+  let start = 0;
+  if (filter.since) {
+    const at = messages.findIndex(m => m.id === filter.since);
+    if (at >= 0) start = at + 1;
+  }
+  const rows: ChatRow[] = [];
+  for (const m of messages.slice(start)) {
+    const row = chatRow(m, userName);
+    if (filter.from === 'players' && row.fromGM) continue;
+    if (filter.rolls === false && row.kind === 'roll') continue;
+    rows.push(row);
+  }
+  return rows;
+}
diff --git a/packages/foundry-module/src/combat-actions.test.ts b/packages/foundry-module/src/combat-actions.test.ts

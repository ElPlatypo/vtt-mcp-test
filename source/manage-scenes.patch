@@ -0,0 +1,38 @@
+/** read-image-file: the bytes of an image in the Foundry files, as base64. Foundry and fetch are stubbed. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+
+function setup(response: { ok: boolean; status?: number; bytes?: Uint8Array }) {
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('game', { ready: true, world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() }, user: { id: 'gm', name: 'GM' } });
+  vi.stubGlobal('foundry', { utils: { getRoute: (p: string) => `/${p}` } });
+  const fetchMock = vi.fn(async () => ({ ok: response.ok, status: response.status ?? 200, arrayBuffer: async () => (response.bytes ?? new Uint8Array()).buffer }));
+  vi.stubGlobal('fetch', fetchMock);
+  return { da: new FoundryDataAccess(), fetchMock };
+}
+
+describe('readImageFile', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('returns the file as base64 with its type', async () => {
+    const bytes = new Uint8Array([137, 80, 78, 71, 1, 2, 3]);
+    const { da, fetchMock } = setup({ ok: true, bytes });
+    const r = await da.readImageFile({ path: 'worlds/w/uploads/maps/hall.png' });
+    expect(fetchMock).toHaveBeenCalledWith('/worlds/w/uploads/maps/hall.png');
+    expect(r).toMatchObject({ success: true, mimeType: 'image/png', size: 7, imageData: btoa(String.fromCharCode(...bytes)) });
+  });
+  it('refuses paths that are not Foundry image files', async () => {
+    const { da, fetchMock } = setup({ ok: true, bytes: new Uint8Array([1]) });
+    await expect(da.readImageFile({ path: '' })).rejects.toThrow('path is required');
+    await expect(da.readImageFile({ path: 'https://x.com/a.png' })).rejects.toThrow('path in the Foundry files');
+    await expect(da.readImageFile({ path: 'worlds/../secret.png' })).rejects.toThrow('path in the Foundry files');
+    await expect(da.readImageFile({ path: '/etc/a.png' })).rejects.toThrow('path in the Foundry files');
+    await expect(da.readImageFile({ path: 'worlds/w/data.json' })).rejects.toThrow('Only png');
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+  it('reports a missing file', async () => {
+    const { da } = setup({ ok: false, status: 404 });
+    await expect(da.readImageFile({ path: 'worlds/w/nope.png' })).rejects.toThrow('HTTP 404');
+  });
+});
diff --git a/packages/foundry-module/src/data-access.regions.test.ts b/packages/foundry-module/src/data-access.regions.test.ts
new file mode 100644
index 0000000..0cc8cfa
--- /dev/null
+++ b/packages/foundry-module/src/data-access.regions.test.ts
@@ -0,0 +1,228 @@
+/**
+ * manage-regions and zoomed preview-scene tests. Foundry is stubbed: these check the data sent
+ * to createEmbeddedDocuments / deleteEmbeddedDocuments, the grid conversion, validation, the
+ * "only remove what the tool created" rule and the write gate.
+ */
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+
+const MODULE = 'foundry-mcp-bridge-scenes';
+const MINE = { [MODULE]: { sceneObjectsTool: true } };
+
+function makeScene(regions: any[] = []) {
+  const scene: any = {
+    id: 's1',
+    name: 'Cave',
+    width: 4000,
+    height: 3000,
+    padding: 0.25,
+    grid: { size: 100, distance: 5, units: 'ft' },
+    dimensions: { sceneX: 1000, sceneY: 800, sceneWidth: 4000, sceneHeight: 3000 },
+    tokens: { contents: [] as any[] },
+    lights: { contents: [] as any[] },
+    regions: { contents: regions },
+    createEmbeddedDocuments: vi.fn(async (type: string, data: any[]) =>
+      data.map((d, i) => ({
+        id: `${type}-${i}`,
+        name: d.name,
+        behaviors: { contents: (d.behaviors ?? []).map((b: any) => ({ type: b.type })) },
+      }))
+    ),
+    deleteEmbeddedDocuments: vi.fn(async () => []),
+  };
+  return scene;
+}
+
+function setup(options: { allowWriteOperations?: boolean; scene?: any } = {}) {
+  const scene = options.scene ?? makeScene();
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('CONFIG', {
+    RegionBehavior: {
+      dataModels: {
+        modifyMovementCost: { schema: { fields: { difficulties: { fields: { walk: {}, swim: {} } } } } },
+        pauseGame: { schema: { fields: { once: { constructor: { name: 'BooleanField' } } } } },
+      },
+    },
+  });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'world-1', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'Gamemaster' },
+    scenes: { contents: [scene], viewed: scene, current: scene },
+    actors: { contents: [] },
+    settings: {
+      get: (_m: string, key: string) =>
+        key === 'allowWriteOperations' ? (options.allowWriteOperations ?? true) : undefined,
+    },
+  });
+  return { dataAccess: new FoundryDataAccess(), scene };
+}
+
+describe('FoundryDataAccess.manageRegions', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('creates a difficult terrain region in pixels, with the movement types Foundry knows', async () => {
+    const { dataAccess, scene } = setup();
+
+    const result = await dataAccess.manageRegions({
+      action: 'create',
+      regions: [
+        { name: 'Rubble', rect: [2, 1, 3, 2], behaviors: [{ preset: 'difficult_terrain', cost: 2 }] },
+      ],
+    });
+
+    const [type, data] = scene.createEmbeddedDocuments.mock.calls[0];
+    expect(type).toBe('Region');
+    expect(data[0]).toMatchObject({
+      name: 'Rubble',
+      shapes: [{ type: 'rectangle', x: 1200, y: 900, width: 300, height: 200 }],
+      behaviors: [
+        { type: 'modifyMovementCost', system: { difficulties: { walk: 2, swim: 2 } } },
+      ],
+      flags: MINE,
+    });
+    expect(result.created).toEqual([{ id: 'Region-0', name: 'Rubble', behaviors: ['modifyMovementCost'] }]);
+  });
+
+  it('creates a trap that runs a macro when a token enters', async () => {
+    const { dataAccess, scene } = setup();
+    await dataAccess.manageRegions({
+      action: 'create',
+      regions: [
+        {
+          name: 'Pit trap',
+          rect: [10, 5, 2, 1],
+          hidden: true,
+          behaviors: [
+            { type: 'executeMacro', system: { events: ['tokenEnter'], uuid: 'Macro.pit' } },
+          ],
+        },
+      ],
+    });
+    const data = scene.createEmbeddedDocuments.mock.calls[0][1][0];
+    expect(data.hidden).toBe(true);
+    expect(data.behaviors[0]).toEqual({
+      type: 'executeMacro',
+      system: { events: ['tokenEnter'], uuid: 'Macro.pit' },
+    });
+  });
+
+  it('refuses regions outside the scene and empty lists', async () => {
+    const { dataAccess } = setup();
+    await expect(
+      dataAccess.manageRegions({ action: 'create', regions: [{ name: 'Far', rect: [39, 29, 5, 5] }] })
+    ).rejects.toThrow('outside the scene');
+    await expect(dataAccess.manageRegions({ action: 'create', regions: [] })).rejects.toThrow('non-empty');
+  });
+
+  it('is blocked when write operations are off', async () => {
+    const { dataAccess, scene } = setup({ allowWriteOperations: false });
+    await expect(
+      dataAccess.manageRegions({ action: 'create', regions: [{ name: 'x', rect: [1, 1, 1, 1] }] })
+    ).rejects.toThrow();
+    expect(scene.createEmbeddedDocuments).not.toHaveBeenCalled();
+  });
+
+  it('describes regions with their shapes in squares and marks the ones it made', async () => {
+    const scene = makeScene([
+      {
+        id: 'r1',
+        name: 'Rubble',
+        color: '#c97a1a',
+        hidden: false,
+        flags: MINE,
+        shapes: [{ type: 'rectangle', x: 1200, y: 900, width: 300, height: 200 }],
+        behaviors: { contents: [{ id: 'b1', type: 'modifyMovementCost', name: 'Difficult terrain' }] },
+      },
+      { id: 'r2', name: 'Theirs', shapes: [], behaviors: { contents: [] } },
+    ]);
+    const { dataAccess } = setup({ scene });
+
+    const result = await dataAccess.manageRegions({ action: 'describe' });
+
+    expect(result.regions[0]).toMatchObject({
+      id: 'r1',
+      shapes: [{ type: 'rect', rect: [2, 1, 3, 2] }],
+      behaviors: [{ type: 'modifyMovementCost' }],
+      createdByTool: true,
+    });
+    expect(result.regions[1].createdByTool).toBe(false);
+  });
+
+  it('removes only regions it created', async () => {
+    const scene = makeScene([
+      { id: 'r1', name: 'Mine', flags: MINE, shapes: [], behaviors: { contents: [] } },
+      { id: 'r2', name: 'Theirs', shapes: [], behaviors: { contents: [] } },
+    ]);
+    const { dataAccess } = setup({ scene });
+
+    const result = await dataAccess.manageRegions({ action: 'remove', ids: ['r1', 'r2'] });
+
+    expect(scene.deleteEmbeddedDocuments).toHaveBeenCalledWith('Region', ['r1']);
+    expect(result.removed).toEqual(['r1']);
+    expect(result.skipped).toEqual(['r2']);
+
+    scene.deleteEmbeddedDocuments.mockClear();
+    const all = await dataAccess.manageRegions({ action: 'remove', all_mine: true });
+    expect(all.removed).toEqual(['r1']);
+  });
+
+  it('lists the behaviour types of this Foundry with their fields', async () => {
+    const { dataAccess } = setup();
+    const result = await dataAccess.manageRegions({ action: 'behavior_types' });
+    expect(Object.keys(result.types)).toEqual(['modifyMovementCost', 'pauseGame']);
+    expect(result.types.modifyMovementCost.difficulties.fields).toBeDefined();
+    expect(result.presets).toEqual(['difficult_terrain']);
+  });
+});
+
+describe('FoundryDataAccess.previewScene region zoom', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  function stubBrowser() {
+    const ctx: any = new Proxy(
+      {},
+      { get: (_t, prop) => (prop === 'canvas' ? undefined : () => undefined), set: () => true }
+    );
+    const canvas = {
+      width: 0,
+      height: 0,
+      getContext: () => ctx,
+      toDataURL: () => 'data:image/png;base64,QUJD',
+    };
+    vi.stubGlobal('document', { createElement: () => canvas });
+    return canvas;
+  }
+
+  it('draws only the region, enlarged to fill the picture', async () => {
+    const { dataAccess } = setup();
+    const canvas = stubBrowser();
+
+    const result = await dataAccess.previewScene({
+      max_size: 1600,
+      region: { x: 10, y: 5, width: 10, height: 8 },
+    });
+
+    expect(result.success).toBe(true);
+    expect(result.scale).toBe(1.6);
+    expect(result.width).toBe(1600);
+    expect(result.height).toBe(1280);
+    expect(canvas.width).toBe(1600);
+    expect(result.region).toEqual({ x: 10, y: 5, width: 10, height: 8 });
+  });
+
+  it('keeps a region inside the scene and refuses ones that are too small', async () => {
+    const { dataAccess } = setup();
+    stubBrowser();
+
+    const clipped = await dataAccess.previewScene({ region: { x: 35, y: 25, width: 20, height: 20 } });
+    expect(clipped.region).toEqual({ x: 35, y: 25, width: 5, height: 5 });
+
+    await expect(
+      dataAccess.previewScene({ region: { x: 39.5, y: 5, width: 3, height: 3 } })
+    ).rejects.toThrow('2 by 2');
+  });
+});
diff --git a/packages/foundry-module/src/data-access.reveal.test.ts b/packages/foundry-module/src/data-access.reveal.test.ts

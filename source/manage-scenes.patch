+++ b/packages/mcp-server/src/speech.ts
@@ -0,0 +1,240 @@
+/**
+ * Narration: the settings for spoken text, the ComfyUI workflows that make speech from them, and the
+ * length of a finished audio file. Pure, so it can be tested without ComfyUI.
+ * The setting names and defaults are mirrored in the Foundry module (settings.ts); keep the two in step.
+ */
+
+export const SPEECH_ENGINES = ['kokoro', 'qwen3-custom', 'qwen3-design', 'qwen3-fast'] as const;
+export type SpeechEngine = (typeof SPEECH_ENGINES)[number];
+
+export interface SpeechSettings {
+  engine: SpeechEngine;
+  /** kokoro: a voice id such as bm_fable; qwen3-custom and qwen3-fast: a preset such as Ryan; qwen3-design: a description of the voice */
+  voice: string;
+  /** "auto" picks it from the voice (kokoro) or uses English (qwen3) */
+  language: string;
+  speed: number;
+  /** qwen3-custom: how to say it (1.7B model); qwen3-design: the voice description when no voice is given */
+  style: string;
+  /** reveal the words in chat in time with the audio */
+  syncText: boolean;
+}
+
+export const DEFAULT_STYLE = 'A deep, measured storyteller narrating a fantasy adventure, calm and a little ominous.';
+
+export const DEFAULT_SPEECH_SETTINGS: SpeechSettings = {
+  engine: 'kokoro',
+  voice: 'bm_fable',
+  language: 'auto',
+  speed: 1,
+  style: DEFAULT_STYLE,
+  syncText: true,
+};
+
+/** Settings from whatever the module sends, with defaults for anything missing or odd. */
+export function normalizeSpeechSettings(raw: unknown): SpeechSettings {
+  const r = (raw && typeof raw === 'object' ? raw : {}) as Record<string, unknown>;
+  const engine = SPEECH_ENGINES.includes(r.engine as SpeechEngine) ? (r.engine as SpeechEngine) : DEFAULT_SPEECH_SETTINGS.engine;
+  const text = (v: unknown, fallback: string) => (typeof v === 'string' && v.trim() ? v.trim() : fallback);
+  const speed = Number(r.speed);
+  return {
+    engine,
+    voice: text(r.voice, DEFAULT_SPEECH_SETTINGS.voice),
+    language: text(r.language, DEFAULT_SPEECH_SETTINGS.language),
+    speed: Number.isFinite(speed) && speed >= 0.5 && speed <= 2 ? speed : 1,
+    style: text(r.style, DEFAULT_STYLE),
+    syncText: typeof r.syncText === 'boolean' ? r.syncText : true,
+  };
+}
+
+const KOKORO_LANGUAGES: Record<string, string> = {
+  a: 'English',
+  b: 'English (British)',
+  j: 'Japanese',
+  z: 'Mandarin Chinese',
+  e: 'Spanish',
+  f: 'French',
+  h: 'Hindi',
+  i: 'Italian',
+  p: 'Brazilian Portuguese',
+};
+
+/** The Kokoro language for a voice id, from its first letter (af_heart is American English, bm_fable British). */
+export function kokoroLanguageFor(voice: string): string {
+  return KOKORO_LANGUAGES[voice.trim().charAt(0).toLowerCase()] ?? 'English';
+}
+
+export interface SpeechRequest {
+  engine: SpeechEngine;
+  text: string;
+  voice: string;
+  language: string;
+  speed: number;
+  style: string;
+  seed: number;
+}
+
+/** Defaults of a node's inputs, as ComfyUI's object_info lists them: the first choice of a list, or the declared default. */
+export function nodeInputDefaults(info: any): Record<string, unknown> {
+  const spec = { ...(info?.input?.required ?? {}), ...(info?.input?.optional ?? {}) } as Record<string, any[]>;
+  const out: Record<string, unknown> = {};
+  for (const [key, value] of Object.entries(spec)) {
+    const [type, options] = value;
+    if (Array.isArray(type)) out[key] = options?.default ?? type[0];
+    else if (options && typeof options === 'object' && 'default' in options) out[key] = options.default;
+  }
+  return out;
+}
+
+export const SPEECH_FILENAME_PREFIX = 'audio/claude-speech';
+
+/**
+ * The ComfyUI workflow that speaks the text. `defaults` are the Qwen3 node's own input defaults (read from
+ * ComfyUI), so the workflow stays valid when the node gains or loses options.
+ */
+export function buildSpeechWorkflow(request: SpeechRequest, defaults: Record<string, unknown> = {}): Record<string, any> {
+  if (request.engine === 'qwen3-fast') throw new Error('qwen3-fast streams from its own server and has no ComfyUI workflow');
+  const save = (from: string) => ({ class_type: 'SaveAudio', inputs: { audio: [from, 0], filename_prefix: SPEECH_FILENAME_PREFIX } });
+  const language = request.language === 'auto' ? undefined : request.language;
+
+  if (request.engine === 'kokoro') {
+    return {
+      '1': { class_type: 'KokoroSpeaker', inputs: { speaker_name: request.voice } },
+      '2': {
+        class_type: 'KokoroGenerator',
+        inputs: { text: request.text, speaker: ['1', 0], speed: request.speed, lang: language ?? kokoroLanguageFor(request.voice) },
+      },
+      '3': save('2'),
+    };
+  }
+
+  const common = { ...defaults, text: request.text, model_choice: '1.7B', language: language ?? 'English', seed: request.seed, unload_model_after_generate: false };
+  if (request.engine === 'qwen3-custom') {
+    return {
+      '1': { class_type: 'FB_Qwen3TTSCustomVoice', inputs: { ...common, speaker: request.voice, instruct: request.style } },
+      '2': save('1'),
+    };
+  }
+  return {
+    '1': { class_type: 'FB_Qwen3TTSVoiceDesign', inputs: { ...common, instruct: request.voice || request.style } },
+    '2': save('1'),
+  };
+}
+
+/** The ComfyUI node that must exist for an engine (none for qwen3-fast, which uses the streaming server). */
+export function nodeForEngine(engine: SpeechEngine): string | null {
+  if (engine === 'qwen3-fast') return null;
+  return engine === 'kokoro' ? 'KokoroGenerator' : engine === 'qwen3-custom' ? 'FB_Qwen3TTSCustomVoice' : 'FB_Qwen3TTSVoiceDesign';
+}
+
+/** Seconds of audio in a FLAC or WAV file, or null when it cannot be read. */
+export function audioSeconds(buf: Buffer): number | null {
+  try {
+    if (buf.length > 42 && buf.toString('ascii', 0, 4) === 'fLaC') {
+      const o = 18; // STREAMINFO: sample rate is 20 bits at byte 18, total samples 36 bits after it
+      const rate = (buf[o]! << 12) | (buf[o + 1]! << 4) | (buf[o + 2]! >> 4);
+      const total = (buf[o + 3]! & 15) * 2 ** 32 + buf.readUInt32BE(o + 4);
+      return rate > 0 && total > 0 ? total / rate : null;
+    }
+    if (buf.length > 44 && buf.toString('ascii', 0, 4) === 'RIFF' && buf.toString('ascii', 8, 12) === 'WAVE') {
+      const byteRate = buf.readUInt32LE(28);
+      let at = 12;
+      while (at + 8 <= buf.length) {
+        const id = buf.toString('ascii', at, at + 4);
+        const size = buf.readUInt32LE(at + 4);
+        if (id === 'data') return byteRate > 0 ? size / byteRate : null;
+        at += 8 + size + (size % 2);
+      }
+    }
+  } catch {
+    // Unreadable: the caller estimates from the text.
+  }
+  return null;
+}
+
+/** A rough speaking time from the words, for when the file length cannot be read. */
+export function estimateSeconds(text: string): number {
+  const words = text.trim().split(/\s+/).filter(Boolean).length;
+  return Math.max(1, Math.round(words * 0.38 * 10) / 10);
+}
+
+export function slugify(text: string, max = 40): string {
+  return (
+    text
+      .toLowerCase()
+      .replace(/[^a-z0-9]+/g, '-')
+      .replace(/^-+|-+$/g, '')
+      .slice(0, max)
+      .replace(/-+$/g, '') || 'speech'
+  );
+}
+
+/**
+ * Split text into pieces to speak one after the other, so the first one can start playing while the rest is
+ * still being generated: sentences, a long sentence cut at commas, very short sentences joined to the next.
+ */
+export function splitSpeechSegments(text: string, maxChars = 200): string[] {
+  const clean = text.replace(/\s+/g, ' ').trim();
+  if (!clean) return [];
+  const sentences = clean.split(/(?<=[.!?…])\s+(?=[^\s])/).map(s => s.trim()).filter(Boolean);
+
+  const pieces: string[] = [];
+  for (const sentence of sentences) {
+    if (sentence.length <= maxChars) {
+      pieces.push(sentence);
+      continue;
+    }
+    let rest = sentence;
+    while (rest.length > maxChars) {
+      const cut = Math.max(rest.lastIndexOf(', ', maxChars), rest.lastIndexOf('; ', maxChars), rest.lastIndexOf(' ', maxChars));
+      const at = cut > maxChars * 0.4 ? cut + 1 : maxChars;
+      pieces.push(rest.slice(0, at).trim());
+      rest = rest.slice(at).trim();
+    }
+    if (rest) pieces.push(rest);
+  }
+
+  // A very short piece ("Roll for initiative.") sounds abrupt alone and costs a whole generation: join it to the next.
+  const joined: string[] = [];
+  for (const piece of pieces) {
+    const last = joined[joined.length - 1];
+    if (last !== undefined && last.length < 28 && last.length + piece.length + 1 <= maxChars) joined[joined.length - 1] = `${last} ${piece}`;
+    else joined.push(piece);
+  }
+  return joined;
+}
+
+/**
+ * Text in paragraph-sized pieces for an engine that streams: sentences are kept together up to `maxChars`, so one
+ * request (one voice, one context) speaks as much as possible and only a long text is cut, at sentence ends.
+ */
+export function groupSpeech(text: string, maxChars = 600): string[] {
+  const groups: string[] = [];
+  for (const sentence of splitSpeechSegments(text, maxChars)) {
+    const last = groups[groups.length - 1];
+    if (last !== undefined && last.length + sentence.length + 1 <= maxChars) groups[groups.length - 1] = `${last} ${sentence}`;
+    else groups.push(sentence);
+  }
+  return groups;
+}
+
+/**
+ * How long to hold the first piece back so playback never runs dry while the rest is generated.
+ * `firstReadyMs` is how long the first piece took to be ready to play, `firstSeconds` its audio length;
+ * later pieces are assumed to take as long per second of audio. Returns milliseconds (0 when generation is faster than speech).
+ */
+export function startDelayMs(pieces: string[], firstSeconds: number, firstReadyMs: number, gapMs = 120): number {
+  if (pieces.length < 2 || firstSeconds <= 0) return 0;
+  const perSecond = firstReadyMs / 1000 / firstSeconds; // seconds of waiting per second of speech
+  const first = pieces[0]!.length;
+  const seconds = pieces.map(p => (firstSeconds * p.length) / first); // estimated length of each piece
+  let ready = 0; // when piece k is ready, counted from when piece 1 was ready
+  let plays = 0; // when piece k would start playing if playback began at 0
+  let delay = 0;
+  for (let k = 1; k < pieces.length; k++) {
+    plays += seconds[k - 1]! + gapMs / 1000;
+    ready += seconds[k]! * perSecond;
+    delay = Math.max(delay, ready - plays);
+  }
+  return Math.max(0, Math.round((delay + (delay > 0 ? 0.4 : 0)) * 1000));
+}

+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+
+function doc(id: string, name: string, extra: Record<string, any> = {}) {
+  return { id, name, update: vi.fn(async () => undefined), delete: vi.fn(async () => undefined), ...extra };
+}
+
+function setup(allow = true) {
+  const goblin = doc('a1', 'Goblin');
+  const wolf = doc('a2', 'Wolf');
+  const dupe1 = doc('a3', 'Twin');
+  const dupe2 = doc('a4', 'Twin');
+  const folder = doc('f1', 'Monsters', { type: 'Actor', contents: [goblin], folder: null });
+  const scene = doc('s1', 'Cave', { active: false });
+  const live = doc('s2', 'Live', { active: true });
+  const create = vi.fn(async (d: any) => ({ id: 'newf', name: d.name }));
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('Folder', { create });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'GM' },
+    actors: { contents: [goblin, wolf, dupe1, dupe2] },
+    scenes: { contents: [scene, live] },
+    folders: { contents: [folder] },
+    settings: { get: (_m: string, k: string) => (k === 'allowWriteOperations' ? allow : undefined) },
+  });
+  return { da: new FoundryDataAccess(), goblin, wolf, scene, live, folder, create, dupe1 };
+}
+
+describe('manageWorld', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('lists folders', async () => {
+    const { da } = setup();
+    const r = await da.manageWorld({ action: 'list_folders' });
+    expect(r.folders).toEqual([{ id: 'f1', name: 'Monsters', type: 'Actor', parent: null, documents: 1 }]);
+  });
+
+  it('creates a folder, or reports the one that exists', async () => {
+    const { da, create } = setup();
+    const r = await da.manageWorld({ action: 'create_folder', type: 'Actor', name: 'Villains' });
+    expect(create).toHaveBeenCalledWith({ name: 'Villains', type: 'Actor' });
+    expect(r.folder.id).toBe('newf');
+    const again = await da.manageWorld({ action: 'create_folder', type: 'Actor', name: 'Monsters' });
+    expect(again.existed).toBe(true);
+    expect(create).toHaveBeenCalledTimes(1);
+  });
+
+  it('moves documents into a folder, creating it on request, and to the top level', async () => {
+    const { da, goblin, wolf } = setup();
+    await da.manageWorld({ action: 'move', type: 'Actor', identifiers: ['Goblin'], folder: 'Monsters' });
+    expect(goblin.update).toHaveBeenCalledWith({ folder: 'f1' });
+    await da.manageWorld({ action: 'move', type: 'Actor', identifiers: ['a2'], folder: 'New', create_folder: true });
+    expect(wolf.update).toHaveBeenCalledWith({ folder: 'newf' });
+    await da.manageWorld({ action: 'move', type: 'Actor', identifiers: ['a2'], folder: null });
+    expect(wolf.update).toHaveBeenLastCalledWith({ folder: null });
+    await expect(
+      da.manageWorld({ action: 'move', type: 'Actor', identifiers: ['a2'], folder: 'Nope' })
+    ).rejects.toThrow('not found');
+  });
+
+  it('renames and refuses ambiguous names', async () => {
+    const { da, goblin } = setup();
+    const r = await da.manageWorld({ action: 'rename', type: 'Actor', identifier: 'goblin', name: 'Cragmaw Goblin' });
+    expect(goblin.update).toHaveBeenCalledWith({ name: 'Cragmaw Goblin' });
+    expect(r.from).toBe('Goblin');
+    await expect(
+      da.manageWorld({ action: 'rename', type: 'Actor', identifier: 'Twin', name: 'x' })
+    ).rejects.toThrow('Several');
+  });
+
+  it('deletes only with confirm and never the active scene', async () => {
+    const { da, scene, live } = setup();
+    await expect(da.manageWorld({ action: 'delete', type: 'Scene', identifiers: ['Cave'] })).rejects.toThrow('confirm');
+    expect(scene.delete).not.toHaveBeenCalled();
+    await expect(
+      da.manageWorld({ action: 'delete', type: 'Scene', identifiers: ['Live'], confirm: true })
+    ).rejects.toThrow('active scene');
+    expect(live.delete).not.toHaveBeenCalled();
+    const r = await da.manageWorld({ action: 'delete', type: 'Scene', identifiers: ['Cave'], confirm: true });
+    expect(scene.delete).toHaveBeenCalled();
+    expect(r.deleted).toEqual([{ id: 's1', name: 'Cave' }]);
+  });
+
+  it('deletes a folder but keeps its contents unless asked', async () => {
+    const { da, folder } = setup();
+    await da.manageWorld({ action: 'delete', type: 'Folder', identifiers: ['Monsters'], confirm: true });
+    expect(folder.delete).toHaveBeenCalledWith({ deleteSubfolders: false, deleteContents: false });
+  });
+
+  it('is blocked when write operations are off, but listing works', async () => {
+    const { da, goblin } = setup(false);
+    await expect(da.manageWorld({ action: 'rename', type: 'Actor', identifier: 'Goblin', name: 'x' })).rejects.toThrow();
+    expect(goblin.update).not.toHaveBeenCalled();
+    await expect(da.manageWorld({ action: 'list_folders' })).resolves.toMatchObject({ success: true });
+  });
+});

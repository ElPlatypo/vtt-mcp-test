+import { afterAll, describe, expect, it, vi } from 'vitest';
+import { promises as fs } from 'fs';
+import os from 'os';
+import path from 'path';
+import { PNG } from 'pngjs';
+import { borderColour, keyOutBackground, type Pixels } from './prop-keying.js';
+import { PropTools, propFileName } from './prop-tools.js';
+
+/** A picture filled with `bg` and a rectangle of `fg`, with an optional hole of bg colour inside. */
+function picture(w: number, h: number, bg: number[], rect: [number, number, number, number], fg: number[], hole?: [number, number, number, number]): Pixels {
+  const data = new Uint8Array(w * h * 4);
+  for (let y = 0; y < h; y++) {
+    for (let x = 0; x < w; x++) {
+      const i = (y * w + x) * 4;
+      const inRect = x >= rect[0] && x < rect[0] + rect[2] && y >= rect[1] && y < rect[1] + rect[3];
+      const inHole = hole && x >= hole[0] && x < hole[0] + hole[2] && y >= hole[1] && y < hole[1] + hole[3];
+      const c = inRect && !inHole ? fg : bg;
+      data[i] = c[0]!;
+      data[i + 1] = c[1]!;
+      data[i + 2] = c[2]!;
+      data[i + 3] = 255;
+    }
+  }
+  return { width: w, height: h, data };
+}
+
+const alphaAt = (img: Pixels, x: number, y: number) => img.data[(y * img.width + x) * 4 + 3];
+
+describe('keyOutBackground', () => {
+  it('removes a flat background and crops to the object', () => {
+    const img = picture(40, 30, [255, 0, 255], [10, 8, 12, 10], [120, 80, 40]);
+    const out = keyOutBackground(img, { padding: 1 });
+    expect(out.background).toEqual([255, 0, 255]);
+    expect(out.box).toEqual({ x: 10, y: 8, width: 12, height: 10 });
+    expect(out.width).toBe(14);
+    expect(out.height).toBe(12);
+    expect(alphaAt(out, 0, 0)).toBe(0);
+    expect(alphaAt(out, 7, 6)).toBe(255);
+    expect(out.opaqueShare).toBeCloseTo(120 / 1200, 5);
+  });
+
+  it('keeps background-coloured parts of the object that do not touch the border', () => {
+    const img = picture(40, 40, [0, 255, 0], [8, 8, 24, 24], [200, 50, 50], [16, 16, 8, 8]);
+    const out = keyOutBackground(img, { crop: false });
+    expect(alphaAt(out, 20, 20)).toBe(255);
+    expect(alphaAt(out, 2, 2)).toBe(0);
+  });
+
+  it('softens edge pixels and takes the background colour out of them', () => {
+    const img = picture(20, 20, [255, 0, 255], [5, 5, 10, 10], [10, 10, 10]);
+    // An edge pixel half way between the background and the object.
+    const i = (5 * 20 + 4) * 4;
+    img.data[i] = 190;
+    img.data[i + 1] = 5;
+    img.data[i + 2] = 190;
+    const out = keyOutBackground(img, { crop: false });
+    const a = out.data[i + 3]!;
+    expect(a).toBeGreaterThan(0);
+    expect(a).toBeLessThan(255);
+    expect(out.data[i]!).toBeLessThan(190);
+  });
+
+  it('refuses a patterned border and a picture that is all background', () => {
+    const noisy = picture(20, 20, [255, 0, 255], [5, 5, 10, 10], [10, 10, 10]);
+    for (let x = 0; x < 20; x += 2) {
+      const i = x * 4;
+      noisy.data[i] = 0;
+      noisy.data[i + 1] = 0;
+      noisy.data[i + 2] = 0;
+    }
+    for (let y = 0; y < 20; y += 2) {
+      const i = (y * 20 + 19) * 4;
+      noisy.data[i] = 0;
+      noisy.data[i + 1] = 255;
+      noisy.data[i + 2] = 0;
+    }
+    for (let x = 0; x < 20; x += 2) {
+      const i = (19 * 20 + x) * 4;
+      noisy.data[i] = 0;
+      noisy.data[i + 1] = 255;
+      noisy.data[i + 2] = 255;
+    }
+    expect(() => keyOutBackground(noisy)).toThrow('not one flat colour');
+    const blank = picture(10, 10, [255, 0, 255], [0, 0, 0, 0], [0, 0, 0]);
+    expect(() => keyOutBackground(blank)).toThrow('Nothing is left');
+    expect(() => keyOutBackground(picture(10, 10, [0, 0, 0], [3, 3, 4, 4], [9, 9, 9]), { tolerance: 0 })).toThrow('tolerance');
+  });
+
+  it('reads the border colour', () => {
+    const c = borderColour(picture(10, 10, [10, 20, 30], [4, 4, 2, 2], [200, 200, 200]));
+    expect(c.colour).toEqual([10, 20, 30]);
+    expect(c.spread).toBe(0);
+  });
+});
+
+describe('propFileName', () => {
+  it('makes a safe file name', () => {
+    expect(propFileName('Old Oak Table!')).toBe('old-oak-table');
+    expect(propFileName('???')).toBe('prop');
+  });
+});
+
+const tmp: string[] = [];
+afterAll(async () => {
+  for (const f of tmp) await fs.rm(f, { force: true });
+});
+
+async function writeSource(): Promise<string> {
+  const img = picture(64, 48, [255, 0, 255], [16, 12, 32, 24], [90, 60, 30]);
+  const png = new PNG({ width: 64, height: 48 });
+  png.data = Buffer.from(img.data);
+  const file = path.join(os.tmpdir(), `prop-test-${Date.now()}-${Math.random().toString(36).slice(2)}.png`);
+  await fs.writeFile(file, PNG.sync.write(png));
+  tmp.push(file);
+  return file;
+}
+
+function makeTools(overrides: { generate?: any; upload?: any; query?: any } = {}) {
+  const query = vi.fn(overrides.query ?? (async () => ({ success: true, scene: { id: 's', name: 'S' }, created: [{ kind: 'tile', id: 't1', x: 3, y: 4 }] })));
+  const logger: any = { info: vi.fn(), debug: vi.fn(), error: vi.fn(), warn: vi.fn(), child: () => logger };
+  const upload = overrides.upload ?? vi.fn(async (a: any) => ({ success: true, path: `worlds/w/uploads/props/${a.filename}` }));
+  const tools = new PropTools({ foundryClient: { query } as any, logger, generate: overrides.generate, upload });
+  return { tools, query, upload };
+}
+
+describe('make-prop', () => {
+  it('is exposed with a required name', () => {
+    const def = makeTools().tools.getToolDefinitions()[0]!;
+    expect(def.name).toBe('make-prop');
+    expect(def.inputSchema.required).toEqual(['name']);
+  });
+
+  it('removes the background of an existing picture, uploads it and places the tile', async () => {
+    const source = await writeSource();
+    const { tools, query, upload } = makeTools();
+    const r = await tools.handleMakeProp({ name: 'Crate', image: source, x: 3, y: 4, width: 2, scene: 'Cave', rotation: 15 });
+    expect(r.success).toBe(true);
+    expect(r.pixels).toEqual({ width: 36, height: 28 });
+    tmp.push(r.local_path);
+    const out = PNG.sync.read(await fs.readFile(r.local_path));
+    expect(out.data[3]).toBe(0);
+    expect(out.data[(14 * 36 + 18) * 4 + 3]).toBe(255);
+    expect(upload).toHaveBeenCalledWith(expect.objectContaining({ folder: 'props', file_path: r.local_path }));
+    const call = query.mock.calls[0]!;
+    expect(call[0]).toBe('foundry-mcp-bridge.manage-scene-objects');
+    expect(call[1]).toMatchObject({
+      action: 'place',
+      scene: 'Cave',
+      objects: [{ kind: 'tile', x: 3, y: 4, width: 2, height: 1.56, rotation: 15 }],
+    });
+    expect(call[1].objects[0].src).toMatch(/^worlds\/w\/uploads\/props\/crate-.*\.png$/);
+    expect(r.tile).toMatchObject({ id: 't1', width: 2, height: 1.56 });
+  });
+
+  it('only uploads when no position is given', async () => {
+    const source = await writeSource();
+    const { tools, query } = makeTools();
+    const r = await tools.handleMakeProp({ name: 'Rug', image: source });
+    tmp.push(r.local_path);
+    expect(r.uploaded).toContain('props/rug-');
+    expect(query).not.toHaveBeenCalled();
+    expect(r.tile).toBeUndefined();
+  });
+
+  it('generates on a flat background when given a prompt', async () => {
+    const source = await writeSource();
+    const generate = vi.fn(async () => ({ success: true, local_path: source, seconds: 12 }));
+    const { tools } = makeTools({ generate });
+    const r = await tools.handleMakeProp({ name: 'Barrel', prompt: 'an oak barrel', key: 'green', image_size: 512 });
+    tmp.push(r.local_path);
+    const sent = (generate.mock.calls as any[][])[0]![0];
+    expect(sent).toMatchObject({ kind: 'token', width: 512, height: 512, upload: false });
+    expect(sent.prompt).toContain('an oak barrel');
+    expect(sent.prompt).toContain('pure green (#00FF00)');
+    expect(r.steps[0]).toContain('generated');
+  });
+
+  it('checks its input and reports failures', async () => {
+    const source = await writeSource();
+    const { tools } = makeTools();
+    await expect(tools.handleMakeProp({ name: 'x' })).rejects.toThrow('prompt');
+    await expect(tools.handleMakeProp({ name: 'x', image: source, x: 1 })).rejects.toThrow('both x and y');
+    await expect(tools.handleMakeProp({ name: 'x', prompt: 'a barrel', image_size: 500 })).rejects.toThrow('multiple of 32');
+    await expect(tools.handleMakeProp({ name: 'x', prompt: 'a barrel' })).rejects.toThrow('not available');
+    await expect(tools.handleMakeProp({ name: 'x', image: source, bogus: 1 })).rejects.toThrow();
+    const failing = makeTools({ upload: async () => ({ success: false, error: 'disk full' }) });
+    await expect(failing.tools.handleMakeProp({ name: 'x', image: source })).rejects.toThrow('disk full');
+    const badTile = makeTools({ query: async () => ({ success: false, error: 'outside the scene' }) });
+    await expect(badTile.tools.handleMakeProp({ name: 'x', image: source, x: 1, y: 1 })).rejects.toThrow('outside the scene');
+  });
+});
diff --git a/packages/mcp-server/src/tools/prop-tools.ts b/packages/mcp-server/src/tools/prop-tools.ts
new file mode 100644
index 0000000..12988d7
--- /dev/null
+++ b/packages/mcp-server/src/tools/prop-tools.ts
@@ -0,0 +1,211 @@
+import { promises as fs } from 'fs';
+import os from 'os';
+import path from 'path';
+import { PNG } from 'pngjs';
+import { z } from 'zod';
+import { FoundryClient } from '../foundry-client.js';
+import { Logger } from '../logger.js';
+import { decodeImage } from './layout-image.js';
+import { downscale, keyOutBackground } from './prop-keying.js';
+
+export interface PropToolsOptions {
+  foundryClient: FoundryClient;
+  logger: Logger;
+  /** generate-image */
+  generate?: (args: any) => Promise<any>;
+  /** upload-file */
+  upload?: (args: any) => Promise<any>;
+}
+
+const KEYS = {
+  magenta: { hex: '#FF00FF', words: 'pure magenta (#FF00FF)' },
+  green: { hex: '#00FF00', words: 'pure green (#00FF00)' },
+  blue: { hex: '#0000FF', words: 'pure blue (#0000FF)' },
+} as const;
+
+const schema = z
+  .object({
+    name: z.string().min(1).max(60),
+    prompt: z.string().min(3).max(2000).optional(),
+    image: z.string().min(1).optional(),
+    key: z.enum(['magenta', 'green', 'blue']).optional(),
+    image_size: z.number().int().min(256).max(2048).optional(),
+    final_size: z.number().int().min(32).max(2048).optional(),
+    keep_enclosed: z.boolean().optional(),
+    tolerance: z.number().min(1).max(200).optional(),
+    seed: z.number().int().optional(),
+    negative_prompt: z.string().max(500).optional(),
+    folder: z.string().min(1).max(100).optional(),
+    scene: z.string().min(1).optional(),
+    x: z.number().min(0).optional(),
+    y: z.number().min(0).optional(),
+    width: z.number().positive().max(100).optional(),
+    height: z.number().positive().max(100).optional(),
+    rotation: z.number().optional(),
+    alpha: z.number().min(0).max(1).optional(),
+    elevation: z.number().optional(),
+    hidden: z.boolean().optional(),
+  })
+  .strict();
+
+/** A name safe to use as a file name. */
+export function propFileName(name: string): string {
+  const base = name
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+    .slice(0, 40);
+  return base || 'prop';
+}
+
+export class PropTools {
+  private foundryClient: FoundryClient;
+  private logger: Logger;
+  private generate: ((args: any) => Promise<any>) | undefined;
+  private upload: ((args: any) => Promise<any>) | undefined;
+  private folder = path.join(os.tmpdir(), 'foundry-mcp-props');
+
+  constructor({ foundryClient, logger, generate, upload }: PropToolsOptions) {
+    this.foundryClient = foundryClient;
+    this.logger = logger.child({ component: 'PropTools' });
+    this.generate = generate;
+    this.upload = upload;
+  }
+
+  getToolDefinitions() {
+    return [
+      {
+        name: 'make-prop',
+        description:
+          'Make a prop (a table, crate, rug, statue, campfire, door in the floor...) as a picture with a transparent background and, if you give a position, lay it on a scene as a tile. ' +
+          'With prompt it generates the object seen from above on a flat coloured background (key: magenta default, green or blue; pick a colour the object does not contain), removes that background, crops to the object and uploads the PNG to the Foundry files (folder default props). ' +
+          'With image (a PNG or JPEG on this computer, for example the local_path of an earlier generate-image) it skips generating and only removes the background, so you can retry with another tolerance (default 60; raise it if a coloured fringe is left, lower it if the object is eaten into). ' +
+          'Give x and y (grid squares, top-left corner of the tile) to place it on scene (id or name, default the scene being viewed) with width in squares (default 2; the height keeps the picture\'s proportions unless you give height) and optional rotation (degrees), alpha, elevation, hidden. Without x and y it only makes and uploads the picture and returns its path for manage-scene-objects {kind:"tile", src}. ' +
+          'Generation takes a couple of minutes. Tiles it places are removed with manage-scene-objects remove.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: { type: 'string', description: 'Short name, used for the file' },
+            prompt: { type: 'string', description: 'What the object is and looks like (the tool adds the top-down view and the flat background)' },
+            image: { type: 'string', description: 'Existing picture on this computer to remove the background from, instead of generating' },
+            key: { type: 'string', enum: ['magenta', 'green', 'blue'], description: 'Background colour to generate on (default magenta)' },
+            image_size: { type: 'number', description: 'Size to generate at, a multiple of 32 (default 1024). MiniMax H3 draws badly below about 2 megapixels, so anything smaller is raised to that automatically; the prop is shrunk afterwards.' },
+            keep_enclosed: { type: 'boolean', description: 'Keep background-coloured pockets that do not touch the edge (default false: the loop of a rope handle or the gap in a ring is made transparent too). Set true if the object really contains the key colour.' },
+            final_size: { type: 'number', description: 'Longest side in pixels of the finished prop picture (default 512; 32 to 2048). The object is generated large and shrunk to this.' },
+            tolerance: { type: 'number', description: 'How different from the background a pixel must be to stay (default 60)' },
+            seed: { type: 'number' },
+            negative_prompt: { type: 'string' },
+            folder: { type: 'string', description: 'Folder under the world uploads (default props)' },
+            scene: { type: 'string', description: 'Scene id or exact name for placing (default: the scene being viewed)' },
+            x: { type: 'number', description: 'Grid square of the left edge (with y: place the tile)' },
+            y: { type: 'number', description: 'Grid square of the top edge' },
+            width: { type: 'number', description: 'Tile width in squares (default 2)' },
+            height: { type: 'number', description: 'Tile height in squares (default keeps proportions)' },
+            rotation: { type: 'number' },
+            alpha: { type: 'number' },
+            elevation: { type: 'number' },
+            hidden: { type: 'boolean' },
+          },
+          required: ['name'],
+          additionalProperties: false,
+        },
+      },
+    ];
+  }
+
+  async handleMakeProp(args: unknown): Promise<any> {
+    const a = schema.parse(args ?? {});
+    if (!a.prompt && !a.image) throw new Error('Give prompt (to generate the object) or image (a picture to remove the background from)');
+    if ((a.x === undefined) !== (a.y === undefined)) throw new Error('Give both x and y to place the tile, or neither');
+    const size = a.image_size ?? 1024;
+    if (size % 32 !== 0) throw new Error('image_size must be a multiple of 32');
+
+    const steps: string[] = [];
+    let source = a.image;
+    let generated: any;
+    if (!source) {
+      if (!this.generate) throw new Error('Image generation is not available here');
+      const key = KEYS[a.key ?? 'magenta'];
+      generated = await this.generate({
+        kind: 'token',
+        name: `prop-${propFileName(a.name)}`,
+        width: size,
+        height: size,
+        upload: false,
+        ...(a.seed !== undefined ? { seed: a.seed } : {}),
+        negative_prompt: `shadow on the background, floor, ground, table surface, gradient background, vignette, text, watermark, ${a.negative_prompt ?? ''}`.replace(/,\s*$/, ''),
+        prompt:
+          `${a.prompt}. A single object seen straight from above (top-down, overhead), centred in the picture with plenty of empty space all around it and nothing touching the edges, ` +
+          `isolated on a perfectly flat, uniform ${key.words} background. No floor, no shadow cast on the background, no other objects.`,
+      });
+      if (generated?.success === false) throw new Error(generated.error || 'The object could not be generated');
+      source = generated?.local_path;
+      if (!source) throw new Error('The image generator returned no file');
+      steps.push(`generated (${generated.seconds ?? '?'} s)`);
+    }
+
+    const picture = await decodeImage(source);
+    const keyed = keyOutBackground(
+      { width: picture.width, height: picture.height, data: picture.data },
+      { ...(a.tolerance !== undefined ? { tolerance: a.tolerance } : {}), removeEnclosed: !a.keep_enclosed }
+    );
+    steps.push(`background removed (was rgb ${keyed.background.join(',')}), cropped to ${keyed.width} x ${keyed.height}`);
+
+    // Generated large (H3 needs 2 megapixels); a prop does not need that many pixels, so shrink it.
+    const finalSide = a.final_size ?? 512;
+    const small = downscale({ width: keyed.width, height: keyed.height, data: keyed.data }, finalSide);
+    if (small.width !== keyed.width) steps.push(`shrunk to ${small.width} x ${small.height}`);
+    const png = new PNG({ width: small.width, height: small.height });
+    png.data = Buffer.from(small.data);
+    await fs.mkdir(this.folder, { recursive: true });
+    const fileName = `${propFileName(a.name)}-${Date.now().toString(36)}.png`;
+    const local = path.join(this.folder, fileName);
+    await fs.writeFile(local, PNG.sync.write(png));
+
+    const result: Record<string, any> = {
+      success: true,
+      name: a.name,
+      local_path: local,
+      pixels: { width: small.width, height: small.height },
+      ...(keyed.warnings.length > 0 ? { warnings: keyed.warnings } : {}),
+    };
+
+    if (!this.upload) {
+      result.steps = steps;
+      return result;
+    }
+    const uploaded = await this.upload({ file_path: local, folder: a.folder ?? 'props', filename: fileName });
+    if (uploaded?.success === false || !uploaded?.path) throw new Error(uploaded?.error || 'The prop could not be uploaded');
+    result.uploaded = uploaded.path;
+    steps.push(`uploaded to ${uploaded.path}`);
+
+    if (a.x !== undefined && a.y !== undefined) {
+      const width = a.width ?? 2;
+      const height = a.height ?? Math.round(((width * small.height) / small.width) * 100) / 100;
+      const placed = await this.foundryClient.query('foundry-mcp-bridge.manage-scene-objects', {
+        action: 'place',
+        ...(a.scene ? { scene: a.scene } : {}),
+        objects: [
+          {
+            kind: 'tile',
+            x: a.x,
+            y: a.y,
+            width,
+            height,
+            src: uploaded.path,
+            ...(a.rotation !== undefined ? { rotation: a.rotation } : {}),
+            ...(a.alpha !== undefined ? { alpha: a.alpha } : {}),
+            ...(a.elevation !== undefined ? { elevation: a.elevation } : {}),
+            ...(a.hidden !== undefined ? { hidden: a.hidden } : {}),
+          },
+        ],
+      });
+      if (placed?.success === false) throw new Error(placed.error || 'The tile could not be placed');
+      result.tile = { ...(placed?.created?.[0] ?? {}), width, height, scene: placed?.scene };
+      steps.push(`placed as a ${width} x ${height} tile`);
+    }
+    result.steps = steps;
+    this.logger.info('Prop made', { name: a.name, placed: a.x !== undefined });
+    return result;
+  }
+}

+import { describe, expect, it } from 'vitest';
+import { LANE_GAP_MS, LEAD_MS, planSegment, segmentsEnd, segmentsHtml, segmentsText, speechSettingsFrom, wordTimes } from './speech-utils.js';
+
+describe('planSegment with a lane', () => {
+  it('starts a new utterance after the audio already queued, with a short gap', () => {
+    expect(planSegment(undefined, 1000, 2, 0, 9000).start).toBe(9000 + LANE_GAP_MS);
+  });
+  it('ignores a lane that has already ended', () => {
+    expect(planSegment(undefined, 1000, 2, 0, 500).start).toBe(1000 + LEAD_MS);
+  });
+});
+
+describe('planSegment', () => {
+  it('starts the first piece after the lead and any requested delay', () => {
+    expect(planSegment(undefined, 1000, 2)).toEqual({ start: 1000 + LEAD_MS, nextStart: 1000 + LEAD_MS + 2000 });
+    expect(planSegment(undefined, 1000, 2, 3000).start).toBe(1000 + LEAD_MS + 3000);
+  });
+  it('follows the previous piece without a gap, or restarts after the lead when late', () => {
+    expect(planSegment(5000, 2000, 1.5)).toEqual({ start: 5000, nextStart: 6500 });
+    expect(planSegment(5000, 9000, 1)).toEqual({ start: 9000 + LEAD_MS, nextStart: 9000 + LEAD_MS + 1000 });
+  });
+});
+
+describe('wordTimes', () => {
+  it('spreads the words over the audio, longer words and sentence ends taking longer', () => {
+    const t = wordTimes('A goblin attacks. Run now', 10000, 4);
+    expect(t.map(w => w.word)).toEqual(['A', 'goblin', 'attacks.', 'Run', 'now']);
+    expect(t[0]!.at).toBe(10000);
+    for (let i = 1; i < t.length; i++) expect(t[i]!.at).toBeGreaterThan(t[i - 1]!.at);
+    expect(t[4]!.at).toBeLessThan(14000);
+    // the pause after "attacks." makes "Run" later than an even split
+    expect(t[3]!.at - t[2]!.at).toBeGreaterThan(t[2]!.at - t[1]!.at);
+  });
+  it('handles empty text', () => {
+    expect(wordTimes('   ', 0, 1)).toEqual([]);
+  });
+});
+
+describe('segments to html and text', () => {
+  const segments = [
+    { text: 'You see <b>two</b> horses.', at: 1000, seconds: 2 },
+    { text: 'Both are dead.', at: 3000, seconds: 1 },
+  ];
+  it('escapes the words and stamps each with its time', () => {
+    const html = segmentsHtml(segments);
+    expect(html).toContain('<span class="mcp-tts-w" data-at="1000">You</span>');
+    expect(html).toContain('&lt;b&gt;two&lt;/b&gt;');
+    expect(html).not.toContain('<b>');
+    expect((html.match(/mcp-tts-w/g) ?? []).length).toBe(7);
+  });
+  it('joins the plain text', () => {
+    expect(segmentsText(segments)).toBe('You see <b>two</b> horses. Both are dead.');
+  });
+});
+
+describe('segmentsEnd', () => {
+  it('is when the last audio ends', () => {
+    expect(segmentsEnd([{ text: 'a', at: 1000, seconds: 2 }, { text: 'b', at: 3000, seconds: 1.5 }])).toBe(4500);
+    expect(segmentsEnd([])).toBe(0);
+  });
+});
+
+describe('speechSettingsFrom', () => {
+  it('reads the settings with defaults and ignores odd values', () => {
+    const s = speechSettingsFrom(k => ({ ttsEngine: 'qwen3-fast', ttsVoice: ' Ryan ', ttsSpeed: 9, ttsSyncText: false })[k]);
+    expect(s).toMatchObject({ engine: 'qwen3-fast', voice: 'Ryan', speed: 1, syncText: false, language: 'auto' });
+    expect(speechSettingsFrom(() => undefined)).toMatchObject({ engine: 'kokoro', voice: 'bm_fable', syncText: true });
+  });
+});
diff --git a/packages/foundry-module/src/speech-utils.ts b/packages/foundry-module/src/speech-utils.ts
new file mode 100644
index 0000000..f92e9cc
--- /dev/null
+++ b/packages/foundry-module/src/speech-utils.ts
@@ -0,0 +1,96 @@
+/**
+ * Narration in the table's browsers: when each piece of audio starts, when each word of the chat text
+ * appears. No Foundry globals, so it can be tested. All times are server time in milliseconds
+ * (game.time.serverTime), which every connected browser shares.
+ */
+
+/** How long before the first audio starts, so every browser can fetch and decode it. */
+export const LEAD_MS = 500;
+
+export interface SpeechSegment {
+  text: string;
+  /** server time the audio of this piece starts */
+  at: number;
+  seconds: number;
+}
+
+export interface PlaybackPlan {
+  start: number;
+  nextStart: number;
+}
+
+/**
+ * When a piece of audio should start. The first piece waits `delayMs` (the server asks for a delay when it
+ * generates slower than speech) plus the lead; the next ones follow the previous piece without a gap, or start
+ * after the lead if they arrived late.
+ */
+export function planSegment(previousEnd: number | undefined, now: number, seconds: number, delayMs = 0, laneEnd = 0): PlaybackPlan {
+  // laneEnd is when the last audio of any earlier speech ends: a new utterance starts after it, never on top of it.
+  const start =
+    previousEnd === undefined ? Math.max(now + LEAD_MS + Math.max(0, delayMs), laneEnd + (laneEnd > now ? LANE_GAP_MS : 0)) : Math.max(previousEnd, now + LEAD_MS);
+  return { start, nextStart: start + seconds * 1000 };
+}
+
+/** A short breath between one speech and the next. */
+export const LANE_GAP_MS = 250;
+
+export interface TimedWord {
+  word: string;
+  at: number;
+}
+
+/**
+ * The time each word of a spoken text is reached, spread over its audio by word length, with a longer
+ * pause after a comma and a full stop. Close enough to follow along by eye.
+ */
+export function wordTimes(text: string, at: number, seconds: number): TimedWord[] {
+  const words = text.trim().split(/\s+/).filter(Boolean);
+  if (words.length === 0) return [];
+  const weight = (w: string) => w.replace(/[^\p{L}\p{N}]/gu, '').length + 2 + (/[.!?…]["')\]]*$/.test(w) ? 5 : /[,;:—–-]["')\]]*$/.test(w) ? 2.5 : 0);
+  const weights = words.map(weight);
+  const total = weights.reduce((a, b) => a + b, 0);
+  const out: TimedWord[] = [];
+  let used = 0;
+  for (let i = 0; i < words.length; i++) {
+    out.push({ word: words[i]!, at: Math.round(at + (used / total) * seconds * 1000) });
+    used += weights[i]!;
+  }
+  return out;
+}
+
+export function escapeHtml(text: string): string {
+  return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
+}
+
+/** The chat message body: every word in a span that the browser reveals when its time comes. */
+export function segmentsHtml(segments: SpeechSegment[]): string {
+  const spans = segments.flatMap(s => wordTimes(s.text, s.at, s.seconds)).map(w => `<span class="mcp-tts-w" data-at="${w.at}">${escapeHtml(w.word)}</span>`);
+  return `<p class="mcp-tts">${spans.join(' ')}</p>`;
+}
+
+/** When the audio of the segments ends (server time), or 0 when there are none. */
+export function segmentsEnd(segments: SpeechSegment[]): number {
+  return segments.reduce((end, s) => Math.max(end, s.at + s.seconds * 1000), 0);
+}
+
+/** The plain text of the segments, for the message content (search, export, clients without the module). */
+export function segmentsText(segments: SpeechSegment[]): string {
+  return segments.map(s => s.text.trim()).filter(Boolean).join(' ');
+}
+
+/** Settings read from the module, in the shape the MCP server expects. */
+export function speechSettingsFrom(get: (key: string) => unknown) {
+  const text = (key: string, fallback: string) => {
+    const v = get(key);
+    return typeof v === 'string' && v.trim() ? v.trim() : fallback;
+  };
+  const speed = Number(get('ttsSpeed'));
+  return {
+    engine: text('ttsEngine', 'kokoro'),
+    voice: text('ttsVoice', 'bm_fable'),
+    language: text('ttsLanguage', 'auto'),
+    speed: Number.isFinite(speed) && speed >= 0.5 && speed <= 2 ? speed : 1,
+    style: text('ttsStyle', 'A deep, measured storyteller narrating a fantasy adventure, calm and a little ominous.'),
+    syncText: get('ttsSyncText') !== false,
+  };
+}
diff --git a/packages/foundry-module/src/table-utils.ts b/packages/foundry-module/src/table-utils.ts
new file mode 100644
index 0000000..209e405
--- /dev/null
+++ b/packages/foundry-module/src/table-utils.ts
@@ -0,0 +1,151 @@
+/** Helpers that turn Foundry chat messages, combats and actors into short plain objects. */
+
+export function stripHtml(html: string, max = 600): string {
+  const text = String(html ?? '')
+    .replace(/@UUID\[[^\]]*\]\{([^}]*)\}/g, '$1')
+    .replace(/<\/(p|li|h[1-6]|div|tr)>/gi, ' ')
+    .replace(/<br\s*\/?>/gi, ' ')
+    .replace(/<[^>]*>/g, '')
+    .replace(/&lt;/g, '<')
+    .replace(/&gt;/g, '>')
+    .replace(/&quot;/g, '"')
+    .replace(/&#39;/g, "'")
+    .replace(/&amp;/g, '&')
+    .replace(/\s+/g, ' ')
+    .trim();
+  return text.length > max ? `${text.slice(0, max)}...` : text;
+}
+
+/** Dice results of a Roll: [{faces, results:[...]}] for each dice term. */
+export function rollDice(roll: any): Array<{ faces: number; results: number[] }> {
+  const out: Array<{ faces: number; results: number[] }> = [];
+  for (const term of (roll?.terms ?? []) as any[]) {
+    if (typeof term?.faces === 'number' && Array.isArray(term.results)) {
+      out.push({ faces: term.faces, results: term.results.filter((r: any) => r.active !== false).map((r: any) => r.result) });
+    }
+  }
+  return out;
+}
+
+export interface ChatLine {
+  id: string;
+  time: number;
+  who: string;
+  user?: string;
+  text?: string;
+  flavor?: string;
+  rolls?: Array<{ formula: string; total: number; dice: Array<{ faces: number; results: number[] }> }>;
+  rollType?: string;
+  whisper?: string[];
+  blind?: boolean;
+}
+
+/** One chat message as a short line. `userName` finds a user's name from an id. */
+export function chatLine(message: any, userName: (id: string) => string | undefined): ChatLine {
+  const rolls = ((message.rolls ?? []) as any[]).map(r => ({ formula: String(r.formula ?? ''), total: Number(r.total ?? 0), dice: rollDice(r) }));
+  const text = stripHtml(message.content ?? '');
+  const line: ChatLine = {
+    id: message.id,
+    time: message.timestamp ?? 0,
+    who: message.speaker?.alias || message.author?.name || userName(message.author?.id ?? message.user?.id ?? '') || 'unknown',
+  };
+  const user = message.author?.name ?? userName(message.author?.id ?? '');
+  if (user && user !== line.who) line.user = user;
+  if (text) line.text = text;
+  if (message.flavor) line.flavor = stripHtml(message.flavor, 200);
+  if (rolls.length > 0) line.rolls = rolls;
+  const rollType = message.flags?.dnd5e?.roll?.type ?? message.flags?.dnd5e?.messageType;
+  if (rollType) line.rollType = String(rollType);
+  if (Array.isArray(message.whisper) && message.whisper.length > 0) {
+    line.whisper = message.whisper.map((id: string) => userName(id) ?? id);
+  }
+  if (message.blind) line.blind = true;
+  return line;
+}
+
+export interface ChatQuery {
+  limit?: number;
+  since_id?: string;
+  since?: number;
+  rolls_only?: boolean;
+  whispers?: boolean;
+}
+
+/** The newest messages matching the query, oldest first, plus the id to continue from. */
+export function selectChat(messages: any[], query: ChatQuery, userName: (id: string) => string | undefined) {
+  const limit = Math.max(1, Math.min(100, Math.floor(query.limit ?? 20)));
+  let list = messages.slice().sort((a, b) => (a.timestamp ?? 0) - (b.timestamp ?? 0));
+  const latestId = list.length > 0 ? list[list.length - 1].id : undefined;
+  if (query.since_id) {
+    const at = list.findIndex(m => m.id === query.since_id);
+    if (at >= 0) list = list.slice(at + 1);
+  }
+  if (query.since !== undefined) list = list.filter(m => (m.timestamp ?? 0) > query.since!);
+  if (query.rolls_only) list = list.filter(m => (m.rolls ?? []).length > 0);
+  if (query.whispers === false) list = list.filter(m => !(Array.isArray(m.whisper) && m.whisper.length > 0));
+  const total = list.length;
+  const shown = list.slice(-limit).map(m => chatLine(m, userName));
+  return { messages: shown, total, ...(total > shown.length ? { omitted: total - shown.length } : {}), latestId };
+}
+
+const num = (value: any): number | undefined => (typeof value === 'number' && Number.isFinite(value) ? value : undefined);
+
+/** Hit points, armour class and conditions of an actor (dnd5e shape; missing fields are left out). */
+export function actorVitals(actor: any): Record<string, any> {
+  const system = actor?.system ?? {};
+  const out: Record<string, any> = {};
+  const hp = system.attributes?.hp;
+  if (hp) {
+    const value = num(hp.value);
+    const max = num(hp.max);
+    if (value !== undefined) out.hp = max !== undefined ? `${value}/${max}` : value;
+    if (num(hp.temp)) out.tempHp = hp.temp;
+  }
+  const ac = num(system.attributes?.ac?.value);
+  if (ac !== undefined) out.ac = ac;
+  const statuses = actor?.statuses ? [...actor.statuses] : [];
+  if (statuses.length > 0) out.conditions = statuses;
+  return out;
+}
+
+export function combatSummary(combat: any): Record<string, any> | null {
+  if (!combat) return null;
+  const turns = ((combat.turns ?? combat.combatants?.contents ?? []) as any[]).slice();
+  const current = combat.combatant ?? turns[combat.turn ?? -1];
+  return {
+    id: combat.id,
+    started: !!combat.started,
+    round: combat.round ?? 0,
+    turn: combat.turn ?? null,
+    ...(current ? { current: current.name } : {}),
+    combatants: turns.map((c, index) => ({
+      name: c.name,
+      initiative: c.initiative ?? null,
+      ...(index === combat.turn && combat.started ? { active: true } : {}),
+      ...(c.defeated ? { defeated: true } : {}),
+      ...(c.hidden ? { hidden: true } : {}),
+      ...(c.isNPC ? { npc: true } : {}),
+      ...actorVitals(c.actor),
+    })),
+  };
+}
+
+export function partySummary(actors: any[], userName: (id: string) => string | undefined): Array<Record<string, any>> {
+  return actors.map(actor => {
+    const system = actor.system ?? {};
+    const owners = Object.entries(actor.ownership ?? {})
+      .filter(([id, level]) => id !== 'default' && (level as number) >= 3)
+      .map(([id]) => userName(id))
+      .filter((n): n is string => !!n);
+    const entry: Record<string, any> = { id: actor.id, name: actor.name, ...actorVitals(actor) };
+    const level = num(system.details?.level);
+    if (level !== undefined) entry.level = level;
+    const passive = num(system.skills?.prc?.passive);
+    if (passive !== undefined) entry.passivePerception = passive;
+    const gp = num(system.currency?.gp);
+    if (gp !== undefined) entry.gp = gp;
+    if (system.attributes?.inspiration) entry.inspiration = true;
+    if (owners.length > 0) entry.player = owners.join(', ');
+    return entry;
+  });
+}

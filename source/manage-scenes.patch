+  /** Read what is on a scene (tokens, lights, pins) in grid squares. */
+  private async readScene(scene: string | undefined): Promise<any> {
+    const res = await this.client().query('foundry-mcp-bridge.manage-scene-objects', {
+      action: 'describe',
+      ...(scene ? { scene } : {}),
+    });
+    if (res?.success === false) throw new Error(res.error || 'Could not read the scene');
+    return res;
+  }
+
+  private async check(doc: LayoutDoc, a: Args): Promise<any> {
+    const layout = layoutOf(doc);
+    const result = checkLayout(layout);
+    let sceneProblems: string[] | undefined;
+    let sceneInfo: any;
+    if (a.scene) {
+      const described = await this.readScene(a.scene);
+      sceneInfo = described.scene;
+      sceneProblems = checkSceneObjects(layout, {
+        tokens: (described.tokens ?? []).map((t: any) => ({ name: t.name, x: t.x, y: t.y, width: t.width ?? 1, height: t.height ?? 1, hidden: t.hidden })),
+        lights: (described.lights ?? []).map((l: any) => ({ x: l.x, y: l.y })),
+        notes: (described.notes ?? []).map((n: any) => ({ x: n.x, y: n.y, text: n.text })),
+      });
+    }
+    const problems = result.errors.length + result.warnings.length + (sceneProblems?.length ?? 0);
+    return {
+      success: true,
+      layout: doc.id,
+      ok: problems === 0,
+      errors: result.errors,
+      warnings: result.warnings,
+      ...(sceneProblems ? { scene: sceneInfo, sceneProblems } : {}),
+      areas: result.areas.slice(0, 8),

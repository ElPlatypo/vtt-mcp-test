+    const r = await da.manageModules({ action: 'call', module: 'tagger', path: 'getByTag', args: ['boss'] });
+    expect(tagger.api.getByTag).toHaveBeenCalledWith('boss');
+    expect(r).toMatchObject({ path: 'getByTag', returned: [{ documentName: 'Token', id: 't1', uuid: 'Scene.s.Token.t1', name: 'boss' }] });
+    await da.manageModules({ action: 'call', module: 'tagger', path: 'api.tags.add', args: ['t1', 'x'] });
+    expect(added).toEqual([['t1', 'x']]);
+  });
+
+  it('refuses calls it should not make', async () => {
+    const { da } = setup();
+    await expect(da.manageModules({ action: 'call', module: 'sequencer', path: 'play' })).rejects.toThrow('not active');
+    await expect(da.manageModules({ action: 'call', module: 'foundry-mcp-bridge-scenes', path: 'x' })).rejects.toThrow('no public API');
+    await expect(da.manageModules({ action: 'call', module: 'tagger', path: 'nope' })).rejects.toThrow('not a function');
+    await expect(da.manageModules({ action: 'call', module: 'tagger', path: 'getByTag.constructor' })).rejects.toThrow('not allowed');
+    await expect(da.manageModules({ action: 'call', module: 'tagger', path: 'count' })).rejects.toThrow('not a function');
+    await expect(da.manageModules({ action: 'call', module: 'tagger', path: 'getByTag', args: new Array(25).fill(1) })).rejects.toThrow('at most 20');
+  });
+
+  it('gives up on a call that never returns', async () => {
+    vi.useFakeTimers();
+    const { da } = setup();
+    const pending = da.manageModules({ action: 'call', module: 'tagger', path: 'slow' });
+    const caught = pending.catch(e => e);
+    await vi.advanceTimersByTimeAsync(31000);
+    expect(String(await caught)).toContain('longer than 30 seconds');
+  });
+
+  it('blocks writes when write operations are off', async () => {
+    const { da } = setup(false);
+    await expect(da.manageModules({ action: 'set_setting', module: 'tagger', key: 'mode', value: 'x' })).rejects.toThrow();
+    await expect(da.manageModules({ action: 'call', module: 'tagger', path: 'getByTag' })).rejects.toThrow();
+    await expect(da.manageModules({ action: 'set_active', modules: ['sequencer'], active: true, confirm: true })).rejects.toThrow();
+    expect((await da.manageModules({ action: 'list' })).success).toBe(true);
+  });
+
+  it('plans before it switches modules and only saves with confirm', async () => {
+    const { da, set } = setup();
+    const dry = await da.manageModules({ action: 'set_active', modules: ['sequencer'], active: true });
+    expect(dry).toMatchObject({ success: true, dryRun: true });
+    expect(dry.wouldChange.map((c: any) => c.id)).toEqual(['socketlib', 'sequencer']);
+    expect(set).not.toHaveBeenCalled();
+
+    const done = await da.manageModules({ action: 'set_active', modules: ['sequencer'], active: true, confirm: true });
+    expect(done.reloadRequired).toBe(true);
+    expect(set).toHaveBeenCalledWith('core', 'moduleConfiguration', {
+      tagger: true,
+      'foundry-mcp-bridge-scenes': true,
+      socketlib: true,
+      sequencer: true,
+    });
+  });
+
+  it('switches off a module and what depends on it, but never the connection', async () => {
+    const { da, set } = setup();
+    await da.manageModules({ action: 'set_active', modules: ['tagger'], active: false, confirm: true });
+    expect(set.mock.calls[0]![2]).toMatchObject({ tagger: false });
+    const own = await da.manageModules({ action: 'set_active', modules: ['foundry-mcp-bridge-scenes'], active: false, confirm: true });
+    expect(own.success).toBe(false);
+    expect(own.error).toContain('connection to this tool');
+  });
+
+  it('refuses a conflicting module and reports a no-op', async () => {
+    const { da, set } = setup();
+    const clash = await da.manageModules({ action: 'set_active', modules: ['foundry-mcp-bridge'], active: true, confirm: true });
+    expect(clash.success).toBe(false);
+    expect(clash.error).toContain('conflicts');
+    const same = await da.manageModules({ action: 'set_active', modules: ['tagger'], active: true, confirm: true });
+    expect(same).toMatchObject({ success: true, changed: [], unchanged: ['tagger'] });
+    expect(set).not.toHaveBeenCalled();
+    await expect(da.manageModules({ action: 'set_active', modules: [], active: true })).rejects.toThrow('modules');
+    await expect(da.manageModules({ action: 'set_active', modules: ['tagger'] })).rejects.toThrow('active');
+    await expect(da.manageModules({ action: 'explode' as any })).rejects.toThrow('Unknown action');
+  });
+});

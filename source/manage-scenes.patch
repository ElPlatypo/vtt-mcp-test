@@ -0,0 +1,141 @@
+/** Notes left on the map: list with current state, resolve with a reply, clear finished ones. Foundry is stubbed. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+import { makeAnnotation, makeArea, rectPoints, type Annotation } from './annotation-utils.js';
+import { sceneClickables, sceneThings } from './annotation-scene.js';
+import { MODULE_ID } from './constants.js';
+
+const mk = (contents: any[]) => ({ contents, size: contents.length });
+
+function makeScene(id: string, name: string, notes: Annotation[]) {
+  const flags: Record<string, any> = notes.length ? { annotations: notes } : {};
+  const scene: any = {
+    id,
+    name,
+    grid: { size: 100 },
+    dimensions: { sceneWidth: 3200, sceneHeight: 3200, sceneX: 0, sceneY: 0, size: 100 },
+    tokens: mk([{ id: 't1', name: 'Goblin 1', x: 300, y: 300, width: 1, height: 1 }, { id: 't2', name: 'Goblin 2', x: 900, y: 900, width: 1, height: 1 }]),
+    tiles: mk([{ id: 'ti1', x: 0, y: 0, width: 400, height: 400 }]),
+    drawings: mk([]),
+    lights: mk([{ id: 'l1', x: 250, y: 250 }]),
+    sounds: mk([]),
+    notes: mk([]),
+    walls: mk([{ id: 'w1', door: 2, c: [100, 100, 200, 100] }, { id: 'w2', door: 0, c: [100, 200, 200, 200] }]),
+    regions: mk([{ id: 'r1', name: 'Pit', shapes: [{ type: 'rectangle', x: 500, y: 500, width: 200, height: 200 }] }]),
+    getFlag: (m: string, k: string) => (m === MODULE_ID ? flags[k] : undefined),
+    setFlag: vi.fn(async (m: string, k: string, v: any) => { flags[k] = v; }),
+    unsetFlag: vi.fn(async (m: string, k: string) => { delete flags[k]; }),
+  };
+  return scene;
+}
+
+function setup(allow = true) {
+  const objectNote = makeAnnotation(
+    { scene: 's1', sceneName: 'Cave', prompt: 'Change this goblin picture', target: { kind: 'token', id: 't1', name: 'Goblin 1', x: 3, y: 3, width: 1, height: 1 } },
+    [], 1000
+  );
+  const movedNote = makeAnnotation(
+    { scene: 's1', sceneName: 'Cave', prompt: 'Move this goblin', target: { kind: 'token', id: 't2', name: 'Goblin 2', x: 1, y: 1, width: 1, height: 1 } },
+    [objectNote], 2000
+  );
+  const goneNote = makeAnnotation(
+    { scene: 's1', sceneName: 'Cave', prompt: 'Remove this', target: { kind: 'light', id: 'ghost', x: 5, y: 5 } },
+    [objectNote, movedNote], 3000
+  );
+  const areaNote = makeAnnotation(
+    { scene: 's1', sceneName: 'Cave', prompt: 'Add enemies here', area: makeArea(rectPoints(0, 0, 4, 4), 'rect') },
+    [objectNote, movedNote, goneNote], 4000
+  );
+  const doneNote: Annotation = { ...makeAnnotation({ scene: 's2', sceneName: 'Town', prompt: 'Old', area: makeArea(rectPoints(0, 0, 2, 2), 'rect') }, [], 500), status: 'done', resolved: 600 };
+  const s1 = makeScene('s1', 'Cave', [objectNote, movedNote, goneNote, areaNote]);
+  const s2 = makeScene('s2', 'Town', [doneNote]);
+  const s3 = makeScene('s3', 'Empty', []);
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'w', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'GM' },
+    scenes: Object.assign([s1, s2, s3], { contents: [s1, s2, s3] }),
+    settings: { get: (_m: string, key: string) => (key === 'allowWriteOperations' ? allow : undefined) },
+  });
+  return { da: new FoundryDataAccess(), s1, s2, s3, objectNote, movedNote, goneNote, areaNote, doneNote };
+}
+
+describe('scene as clickable things', () => {
+  it('reads every kind in grid squares', () => {
+    const { s1 } = setup();
+    const kinds = sceneClickables(s1).map(c => c.kind).sort();
+    expect(kinds).toEqual(['light', 'region', 'tile', 'token', 'token', 'wall', 'wall']);
+    const things = sceneThings(s1);
+    expect(things.find(t => t.kind === 'door')).toMatchObject({ x: 1.5, y: 1 });
+    expect(things.find(t => t.name === 'Goblin 1')).toMatchObject({ kind: 'token', x: 3.5, y: 3.5 });
+  });
+});
+
+describe('scene padding', () => {
+  it('counts squares from the top-left of the map, not of the padded canvas', () => {
+    const { s1 } = setup();
+    s1.dimensions = { sceneWidth: 3200, sceneHeight: 3200, sceneX: 200, sceneY: 100, size: 100 };
+    const token = sceneClickables(s1).find(c => c.id === 't1')!;
+    expect([token.x, token.y]).toEqual([1, 2]);
+    expect(sceneClickables(s1).find(c => c.id === 'ti1')).toMatchObject({ x: -2, y: -1, width: 4, height: 4 });
+  });
+});
+
+describe('listAnnotations', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('lists open notes of every scene oldest first, with what is there now', async () => {
+    const { da } = setup();
+    const r = await da.listAnnotations({});
+    expect(r).toMatchObject({ success: true, status: 'open', count: 4 });
+    expect(r.notes.map((n: any) => n.number)).toEqual([1, 2, 3, 4]);
+    const [unchanged, moved, gone, area] = r.notes;
+    expect(unchanged).toMatchObject({ scene: { name: 'Cave' }, type: 'object', stillThere: true });
+    expect(unchanged.nowAt).toBeUndefined();
+    expect(moved.nowAt).toMatchObject({ x: 9, y: 9, name: 'Goblin 2' });
+    expect(gone.stillThere).toBe(false);
+    expect(area.inside).toEqual({ tokens: ['Goblin 1'], lights: 1, tiles: 1, doors: 1, walls: 1 });
+  });
+  it('filters by status and scene', async () => {
+    const { da } = setup();
+    expect((await da.listAnnotations({ status: 'done' })).notes.map((n: any) => n.prompt)).toEqual(['Old']);
+    expect((await da.listAnnotations({ status: 'all' })).count).toBe(5);
+    expect((await da.listAnnotations({ scene: 'Town', status: 'all' })).count).toBe(1);
+    expect((await da.listAnnotations({ scene: 's3' })).count).toBe(0);
+    await expect(da.listAnnotations({ status: 'soon' })).rejects.toThrow('status must be');
+    await expect(da.listAnnotations({ scene: 'Nowhere' })).rejects.toThrow('Scene not found');
+  });
+});
+
+describe('resolveAnnotations and clearAnnotations', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  it('marks notes done with a reply, reports unknown ids, and can reopen', async () => {
+    const { da, s1, objectNote } = setup();
+    const r = await da.resolveAnnotations({ ids: [objectNote.id, 'nope'], reply: 'New picture set' });
+    expect(r).toMatchObject({ success: true, status: 'done', changed: [objectNote.id], notFound: ['nope'] });
+    const saved = s1.setFlag.mock.calls[0]![2] as Annotation[];
+    expect(saved.find(a => a.id === objectNote.id)).toMatchObject({ status: 'done', reply: 'New picture set' });
+    expect((await da.listAnnotations({})).count).toBe(3);
+    await da.resolveAnnotations({ ids: [objectNote.id], status: 'open' });
+    expect((await da.listAnnotations({})).count).toBe(4);
+  });
+  it('clears only finished notes and removes the flag when nothing is left', async () => {
+    const { da, s1, s2 } = setup();
+    expect(await da.clearAnnotations({})).toEqual({ success: true, removed: 1 });
+    expect(s2.unsetFlag).toHaveBeenCalled();
+    expect(s1.setFlag).not.toHaveBeenCalled();
+    expect(await da.clearAnnotations({})).toEqual({ success: true, removed: 0 });
+  });
+  it('refuses bad requests and respects the write gate', async () => {
+    const { da } = setup();
+    await expect(da.resolveAnnotations({ ids: [] })).rejects.toThrow('1 to 50');
+    await expect(da.resolveAnnotations({ ids: ['x'], status: 'later' })).resolves.toMatchObject({ notFound: ['x'] });
+    const gated = setup(false);
+    await expect(gated.da.resolveAnnotations({ ids: ['x'] })).rejects.toThrow();
+    await expect(gated.da.clearAnnotations({})).rejects.toThrow();
+  });
+});

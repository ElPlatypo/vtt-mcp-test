@@ -0,0 +1,108 @@
+import { describe, expect, it } from 'vitest';
+import {
+  decodeBase64,
+  detectImageType,
+  extensionMatchesType,
+  sanitizeUploadFilename,
+  sanitizeUploadFolder,
+} from './upload-utils.js';
+
+const PNG = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0, 0, 0, 0];
+const JPG = [0xff, 0xd8, 0xff, 0xe0, 0, 0x10];
+const GIF = [0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 1, 0];
+const WEBP = [0x52, 0x49, 0x46, 0x46, 1, 2, 3, 4, 0x57, 0x45, 0x42, 0x50];
+
+describe('sanitizeUploadFilename', () => {
+  it('keeps a clean name and lower-cases the extension', () => {
+    expect(sanitizeUploadFilename('cave-map_01.PNG')).toBe('cave-map_01.png');
+  });
+
+  it('drops any directory part, including path traversal', () => {
+    expect(sanitizeUploadFilename('../../etc/evil.png')).toBe('evil.png');
+    expect(sanitizeUploadFilename('C:\\Users\\me\\map.webp')).toBe('map.webp');
+  });
+
+  it('replaces unsafe characters', () => {
+    expect(sanitizeUploadFilename('my map (final)!.jpg')).toBe('my_map__final__.jpg');
+  });
+
+  it('removes leading dots so the name cannot be hidden or relative', () => {
+    expect(sanitizeUploadFilename('..hidden.png')).toBe('hidden.png');
+  });
+
+  it.each(['notes.txt', 'script.js', 'image.svg', 'archive.zip', 'photo.bmp'])(
+    'rejects the extension of %s',
+    name => {
+      expect(() => sanitizeUploadFilename(name)).toThrow(/Unsupported file type/);
+    }
+  );
+
+  it.each(['', '   ', 'noextension', '.png', 'trailingdot.', 42, null, undefined])(
+    'rejects %j',
+    name => {
+      expect(() => sanitizeUploadFilename(name)).toThrow();
+    }
+  );
+});
+
+describe('sanitizeUploadFolder', () => {
+  it('treats empty input as the upload folder itself', () => {
+    expect(sanitizeUploadFolder(undefined)).toBe('');
+    expect(sanitizeUploadFolder('')).toBe('');
+  });
+
+  it('accepts up to three clean levels and normalises separators', () => {
+    expect(sanitizeUploadFolder('maps')).toBe('maps');
+    expect(sanitizeUploadFolder('maps\\phandelver/part_1')).toBe('maps/phandelver/part_1');
+  });
+
+  it.each(['..', '../x', 'a/../b', 'a/.hidden', 'a b', 'maps.old', 'a/b/c/d', 'ünï'])(
+    'rejects %s',
+    folder => {
+      expect(() => sanitizeUploadFolder(folder)).toThrow();
+    }
+  );
+
+  it('rejects a non-string', () => {
+    expect(() => sanitizeUploadFolder(5)).toThrow('folder must be a string');
+  });
+});
+
+describe('detectImageType', () => {
+  it('recognises the four supported formats', () => {
+    expect(detectImageType(Uint8Array.from(PNG))).toBe('png');
+    expect(detectImageType(Uint8Array.from(JPG))).toBe('jpg');
+    expect(detectImageType(Uint8Array.from(GIF))).toBe('gif');
+    expect(detectImageType(Uint8Array.from(WEBP))).toBe('webp');
+  });
+
+  it('returns null for anything else', () => {
+    expect(detectImageType(new TextEncoder().encode('<svg></svg>'))).toBeNull();
+    expect(detectImageType(new TextEncoder().encode('MZ executable'))).toBeNull();
+    expect(detectImageType(new Uint8Array())).toBeNull();
+  });
+
+  it('does not accept RIFF files that are not WebP', () => {
+    const wav = [0x52, 0x49, 0x46, 0x46, 1, 2, 3, 4, 0x57, 0x41, 0x56, 0x45];
+    expect(detectImageType(Uint8Array.from(wav))).toBeNull();
+  });
+});
+
+describe('extensionMatchesType', () => {
+  it('matches the extension to the content, treating jpeg as jpg', () => {
+    expect(extensionMatchesType('a.png', 'png')).toBe(true);
+    expect(extensionMatchesType('a.jpeg', 'jpg')).toBe(true);
+    expect(extensionMatchesType('a.jpg', 'png')).toBe(false);
+    expect(extensionMatchesType('a.webp', 'gif')).toBe(false);
+  });
+});
+
+describe('decodeBase64', () => {
+  it('decodes valid base64', () => {
+    expect(Array.from(decodeBase64(btoa('abc')))).toEqual([97, 98, 99]);
+  });
+
+  it.each(['', '!!!not base64!!!', 123, null])('rejects %j', value => {
+    expect(() => decodeBase64(value)).toThrow();
+  });
+});

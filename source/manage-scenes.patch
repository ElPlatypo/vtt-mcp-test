+++ b/packages/mcp-server/src/image-profiles.ts
@@ -0,0 +1,399 @@
+/**
+ * Image generation profiles: what to generate with (model, sampler, size, prompt wording) for
+ * each kind of picture. The GM edits them in the Foundry module's settings; this file turns
+ * them into a ComfyUI workflow. The module keeps a copy of the defaults for its dialog
+ * (packages/foundry-module/src/image-profiles-utils.ts) - keep the two in step.
+ *
+ * Two workflows exist:
+ *  - "checkpoint": a Stable Diffusion style checkpoint (SDXL battlemaps), with a negative prompt.
+ *  - "minimax-h3": MiniMax H3 Image: diffusion model + Qwen3-VL text encoder + VAE, 6 steps,
+ *    no negative prompt, and up to 16 reference pictures (<Picture 1> ... in the prompt).
+ */
+
+export const IMAGE_KINDS = ['map', 'portrait', 'token', 'handout'] as const;
+export type ImageKind = (typeof IMAGE_KINDS)[number];
+
+export const WORKFLOWS = ['checkpoint', 'minimax-h3'] as const;
+export type ImageWorkflow = (typeof WORKFLOWS)[number];
+
+export interface ImageProfile {
+  workflow: ImageWorkflow;
+  /** "checkpoint" workflow: checkpoint file as ComfyUI lists it. Empty = not chosen yet. */
+  checkpoint: string;
+  /** "minimax-h3" workflow: the diffusion model (models/diffusion_models). */
+  diffusionModel: string;
+  /** "minimax-h3" workflow: the Qwen3-VL text encoder (models/text_encoders). */
+  textEncoder: string;
+  /** VAE file name (models/vae). Empty = use the VAE inside the checkpoint (checkpoint only). */
+  vae: string;
+  steps: number;
+  cfg: number;
+  sampler: string;
+  scheduler: string;
+  width: number;
+  height: number;
+  /** Text put before / after what is asked for. */
+  promptPrefix: string;
+  promptSuffix: string;
+  /** Not used by the minimax-h3 workflow. */
+  negativePrompt: string;
+}
+
+export type ImageProfiles = Record<ImageKind, ImageProfile>;
+
+export const MAX_REFERENCE_IMAGES = 16;
+
+export const LIMITS = {
+  minSteps: 1,
+  maxSteps: 100,
+  minCfg: 0,
+  maxCfg: 30,
+  minSide: 256,
+  maxSide: 6400,
+  maxPixels: 4096 * 4096,
+  maxText: 1000,
+} as const;
+
+export const H3_DEFAULTS = {
+  workflow: 'minimax-h3' as const,
+  checkpoint: '',
+  diffusionModel: 'minimax_h3_image_pruned_w4a8.safetensors',
+  textEncoder: 'qwen3vl_32b_minimax_h3_int4_convrot.safetensors',
+  vae: 'minimax_h3_image_vae_fp16.safetensors',
+  steps: 6,
+  cfg: 1,
+  sampler: 'euler',
+  scheduler: 'simple',
+  promptPrefix: '',
+  promptSuffix: '',
+  negativePrompt: '',
+};
+
+export const DEFAULT_PROFILES: ImageProfiles = {
+  map: {
+    workflow: 'checkpoint',
+    checkpoint: 'dDBattlemapsSDXL10_upscaleV10.safetensors',
+    diffusionModel: '',
+    textEncoder: '',
+    vae: 'sdxl_vae.safetensors',
+    steps: 30,
+    cfg: 2.5,
+    sampler: 'dpmpp_2m_sde',
+    scheduler: 'karras',
+    width: 1024,
+    height: 1024,
+    promptPrefix: '2d DnD battlemap of ',
+    promptSuffix: ', top-down view, overhead perspective, aerial',
+    negativePrompt:
+      'grid, low angle, isometric, oblique, horizon, text, watermark, logo, caption, people, creatures, monsters, blurry, artifacts',
+  },
+  // MiniMax H3 Image works best from about 4 megapixels up and wants long, detailed prompts.
+  portrait: { ...H3_DEFAULTS, width: 1664, height: 2432 },
+  token: { ...H3_DEFAULTS, width: 2048, height: 2048 },
+  handout: { ...H3_DEFAULTS, width: 2432, height: 1664 },
+};
+
+function clamp(value: number, min: number, max: number): number {
+  return Math.min(max, Math.max(min, value));
+}
+
+function num(value: unknown, fallback: number): number {
+  const n = typeof value === 'number' ? value : typeof value === 'string' ? Number(value) : NaN;
+  return Number.isFinite(n) ? n : fallback;
+}
+
+function text(value: unknown, fallback: string, max: number = LIMITS.maxText): string {
+  return typeof value === 'string' ? value.slice(0, max) : fallback;
+}
+
+/** Round to a multiple (8 for Stable Diffusion, 32 for MiniMax H3) within the allowed length. */
+export function snapSide(value: number, multiple = 8): number {
+  return clamp(Math.round(value / multiple) * multiple, LIMITS.minSide, LIMITS.maxSide);
+}
+
+/** Keep the picture inside the pixel budget while keeping its shape. */
+export function fitPixels(
+  width: number,
+  height: number,
+  multiple = 8
+): { width: number; height: number } {
+  let w = snapSide(width, multiple);
+  let h = snapSide(height, multiple);
+  if (w * h > LIMITS.maxPixels) {
+    const scale = Math.sqrt(LIMITS.maxPixels / (w * h));
+    w = Math.max(LIMITS.minSide, Math.floor((w * scale) / multiple) * multiple);
+    h = Math.max(LIMITS.minSide, Math.floor((h * scale) / multiple) * multiple);
+  }
+  return { width: w, height: h };
+}
+
+function nameOrDefault(value: unknown, fallback: string): string {
+  return typeof value === 'string' ? value.trim().slice(0, 260) : fallback;
+}
+
+function tokenOrDefault(value: unknown, fallback: string): string {
+  return typeof value === 'string' && /^[A-Za-z0-9_+.\-]{1,60}$/.test(value.trim())
+    ? value.trim()
+    : fallback;
+}
+
+/** One profile from whatever was saved: missing or unusable fields fall back to the default. */
+export function normalizeProfile(raw: unknown, fallback: ImageProfile): ImageProfile {
+  const r = (raw && typeof raw === 'object' ? raw : {}) as Record<string, unknown>;
+  const size = fitPixels(num(r.width, fallback.width), num(r.height, fallback.height));
+  const workflow = WORKFLOWS.includes(r.workflow as ImageWorkflow)
+    ? (r.workflow as ImageWorkflow)
+    : fallback.workflow;
+  return {
+    workflow,
+    checkpoint: nameOrDefault(r.checkpoint, fallback.checkpoint),
+    diffusionModel: nameOrDefault(r.diffusionModel, fallback.diffusionModel),
+    textEncoder: nameOrDefault(r.textEncoder, fallback.textEncoder),
+    vae: nameOrDefault(r.vae, fallback.vae),
+    steps: Math.round(clamp(num(r.steps, fallback.steps), LIMITS.minSteps, LIMITS.maxSteps)),
+    cfg: clamp(num(r.cfg, fallback.cfg), LIMITS.minCfg, LIMITS.maxCfg),
+    sampler: tokenOrDefault(r.sampler, fallback.sampler),
+    scheduler: tokenOrDefault(r.scheduler, fallback.scheduler),
+    width: size.width,
+    height: size.height,
+    promptPrefix: text(r.promptPrefix, fallback.promptPrefix),
+    promptSuffix: text(r.promptSuffix, fallback.promptSuffix),
+    negativePrompt: text(r.negativePrompt, fallback.negativePrompt),
+  };
+}
+
+/**
+ * All profiles from the saved setting (an object, or the JSON text of one).
+ *
+ * Profiles saved before workflows existed have no "workflow" field. A saved map profile was a
+ * checkpoint profile and stays one; the others only ever held settings for a checkpoint that was
+ * never chosen, so they take the new defaults.
+ */
+export function normalizeProfiles(raw: unknown): ImageProfiles {
+  let value = raw;
+  if (typeof value === 'string') {
+    try {
+      value = JSON.parse(value);
+    } catch {
+      value = undefined;
+    }
+  }
+  const saved = (value && typeof value === 'object' ? value : {}) as Record<string, any>;
+  const result = {} as ImageProfiles;
+  for (const kind of IMAGE_KINDS) {
+    const entry = saved[kind];
+    const legacy = entry && typeof entry === 'object' && entry.workflow === undefined;
+    if (legacy && kind !== 'map') {
+      result[kind] = { ...DEFAULT_PROFILES[kind] };
+    } else if (legacy) {
+      result[kind] = normalizeProfile({ ...entry, workflow: 'checkpoint' }, DEFAULT_PROFILES[kind]);
+    } else {
+      result[kind] = normalizeProfile(entry, DEFAULT_PROFILES[kind]);
+    }
+  }
+  return result;
+}
+
+export interface ImageRequest {
+  prompt: string;
+  negativePrompt?: string | undefined;
+  width?: number | undefined;
+  height?: number | undefined;
+  steps?: number | undefined;
+  seed?: number | undefined;
+  /** Names of reference pictures already uploaded to ComfyUI (minimax-h3 only). */
+  referenceImages?: string[] | undefined;
+}
+
+export interface ResolvedGeneration {
+  workflow: ImageWorkflow;
+  checkpoint: string;
+  diffusionModel: string;
+  textEncoder: string;
+  vae: string;
+  steps: number;
+  cfg: number;
+  sampler: string;
+  scheduler: string;
+  width: number;
+  height: number;
+  seed: number;
+  positive: string;
+  negative: string;
+  referenceImages: string[];
+}
+
+const SETTINGS_HINT = 'In Foundry open the module settings, click "Configure Image Generation"';
+
+/** Combine a profile with one request: the request's size, steps and seed win. */
+export function resolveGeneration(
+  kind: ImageKind,
+  profile: ImageProfile,
+  request: ImageRequest
+): ResolvedGeneration {
+  const prompt = request.prompt.trim();
+  if (!prompt) throw new Error('prompt is required');
+
+  if (profile.workflow === 'minimax-h3') {
+    if (!profile.diffusionModel || !profile.textEncoder || !profile.vae) {
+      throw new Error(
+        `The "${kind}" profile uses MiniMax H3 Image but is missing its diffusion model, text encoder or VAE. ${SETTINGS_HINT} and pick them.`
+      );
+    }
+  } else if (!profile.checkpoint) {
+    throw new Error(
+      `No checkpoint is chosen for "${kind}" images. ${SETTINGS_HINT} and pick one.`
+    );
+  }
+
+  const references = request.referenceImages ?? [];
+  if (references.length > 0 && profile.workflow !== 'minimax-h3') {
+    throw new Error(
+      `The "${kind}" profile uses a checkpoint workflow, which cannot take reference images. Only MiniMax H3 profiles can.`
+    );
+  }
+  if (references.length > MAX_REFERENCE_IMAGES) {
+    throw new Error(`At most ${MAX_REFERENCE_IMAGES} reference images are allowed`);
+  }
+
+  const multiple = profile.workflow === 'minimax-h3' ? 32 : 8;
+  const size = fitPixels(request.width ?? profile.width, request.height ?? profile.height, multiple);
+  const steps = Math.round(clamp(request.steps ?? profile.steps, LIMITS.minSteps, LIMITS.maxSteps));
+  const seed =
+    request.seed !== undefined && Number.isFinite(request.seed)
+      ? Math.abs(Math.trunc(request.seed))
+      : Math.floor(Math.random() * 2 ** 32);
+  const negativeExtra = request.negativePrompt?.trim();
+  return {
+    workflow: profile.workflow,
+    checkpoint: profile.checkpoint,
+    diffusionModel: profile.diffusionModel,
+    textEncoder: profile.textEncoder,
+    vae: profile.vae,
+    steps,
+    cfg: profile.cfg,
+    sampler: profile.sampler,
+    scheduler: profile.scheduler,
+    width: size.width,
+    height: size.height,
+    seed,
+    positive: `${profile.promptPrefix}${prompt}${profile.promptSuffix}`,
+    negative:
+      profile.workflow === 'minimax-h3'
+        ? ''
+        : negativeExtra
+          ? [profile.negativePrompt, negativeExtra].filter(Boolean).join(', ')
+          : profile.negativePrompt,
+    referenceImages: references,
+  };
+}
+
+/** The ComfyUI workflow (stock nodes only) for a plain text-to-image run with a checkpoint. */
+function buildCheckpointWorkflow(
+  gen: ResolvedGeneration,
+  filenamePrefix: string
+): Record<string, any> {
+  const workflow: Record<string, any> = {
+    '1': { inputs: { ckpt_name: gen.checkpoint }, class_type: 'CheckpointLoaderSimple' },
+    '2': { inputs: { text: gen.positive, clip: ['1', 1] }, class_type: 'CLIPTextEncode' },
+    '3': { inputs: { text: gen.negative, clip: ['1', 1] }, class_type: 'CLIPTextEncode' },
+    '4': {
+      inputs: { width: gen.width, height: gen.height, batch_size: 1 },
+      class_type: 'EmptyLatentImage',
+    },
+    '5': {
+      inputs: {
+        seed: gen.seed,
+        steps: gen.steps,
+        cfg: gen.cfg,
+        denoise: 1.0,
+        sampler_name: gen.sampler,
+        scheduler: gen.scheduler,
+        model: ['1', 0],
+        positive: ['2', 0],
+        negative: ['3', 0],
+        latent_image: ['4', 0],
+      },
+      class_type: 'KSampler',
+    },
+  };
+
+  if (gen.vae) {
+    workflow['9'] = { inputs: { vae_name: gen.vae }, class_type: 'VAELoader' };
+  }
+  workflow['6'] = {
+    inputs: { samples: ['5', 0], vae: gen.vae ? ['9', 0] : ['1', 2] },
+    class_type: 'VAEDecode',
+  };
+  workflow['7'] = {
+    inputs: { filename_prefix: filenamePrefix, images: ['6', 0] },
+    class_type: 'SaveImage',
+  };
+  return workflow;
+}
+
+/**
+ * MiniMax H3 Image: text to image, or with reference pictures an edit/guided generation. The
+ * conditioning node takes the pictures as images.image_1 ... and the prompt names them
+ * <Picture 1> ... Sampling is the model's own: 6 steps, CFG 1, empty negative conditioning.
+ */
+function buildMiniMaxH3Workflow(
+  gen: ResolvedGeneration,
+  filenamePrefix: string
+): Record<string, any> {
+  const workflow: Record<string, any> = {
+    '1': {
+      class_type: 'UNETLoader',
+      inputs: { unet_name: gen.diffusionModel, weight_dtype: 'default' },
+    },
+    '2': {
+      class_type: 'CLIPLoader',
+      inputs: { clip_name: gen.textEncoder, type: 'minimax', device: 'default' },
+    },
+    '3': { class_type: 'VAELoader', inputs: { vae_name: gen.vae } },
+    '5': {
+      class_type: 'MiniMaxH3ImageConditioning',
+      inputs: {
+        clip: ['2', 0],
+        vae: ['3', 0],
+        prompt: gen.positive,
+        width: gen.width,
+        height: gen.height,
+      },
+    },
+    '6': { class_type: 'ConditioningZeroOut', inputs: { conditioning: ['5', 0] } },
+    '7': {
+      class_type: 'KSampler',
+      inputs: {
+        model: ['1', 0],
+        positive: ['5', 0],
+        negative: ['6', 0],
+        latent_image: ['5', 1],
+        seed: gen.seed,
+        steps: gen.steps,
+        cfg: gen.cfg,
+        sampler_name: gen.sampler,
+        scheduler: gen.scheduler,
+        denoise: 1,
+      },
+    },
+    '8': { class_type: 'VAEDecode', inputs: { samples: ['7', 0], vae: ['3', 0] } },
+    '9': { class_type: 'SaveImage', inputs: { filename_prefix: filenamePrefix, images: ['8', 0] } },
+  };
+
+  gen.referenceImages.forEach((name, index) => {
+    const nodeId = String(20 + index);
+    workflow[nodeId] = { class_type: 'LoadImage', inputs: { image: name } };
+    workflow['5'].inputs[`images.image_${index + 1}`] = [nodeId, 0];
+  });
+  return workflow;
+}
+
+export function buildWorkflow(gen: ResolvedGeneration, filenamePrefix: string): Record<string, any> {
+  return gen.workflow === 'minimax-h3'
+    ? buildMiniMaxH3Workflow(gen, filenamePrefix)
+    : buildCheckpointWorkflow(gen, filenamePrefix);
+}
+
+/** Kept for callers and tests that build the checkpoint workflow directly. */
+export const buildTxt2ImgWorkflow = buildCheckpointWorkflow;

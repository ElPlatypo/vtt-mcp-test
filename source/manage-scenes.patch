+/** MiniMax H3 pictures are generated at 2 megapixels or more and shrunk afterwards. */
+import { describe, expect, it } from 'vitest';
+import { DEFAULT_PROFILES, LIMITS, raiseToMinPixels, resolveGeneration } from './image-profiles.js';
+import { downscale } from './tools/prop-keying.js';
+
+const MIN = 2 * 1024 * 1024;
+
+describe('raiseToMinPixels', () => {
+  it('leaves a big enough size alone', () => {
+    expect(raiseToMinPixels(2048, 2048, 32)).toEqual({ width: 2048, height: 2048, raised: false });
+    expect(raiseToMinPixels(1664, 2432, 32).raised).toBe(false);
+  });
+  it('raises small squares and keeps the shape, in multiples of 32', () => {
+    const r = raiseToMinPixels(512, 512, 32);
+    expect(r.raised).toBe(true);
+    expect(r.width * r.height).toBeGreaterThanOrEqual(MIN);
+    expect(r.width).toBe(r.height);
+    expect(r.width % 32).toBe(0);
+    expect(r.width * r.height).toBeLessThan(MIN * 1.1);
+  });
+  it('keeps a wide or tall shape', () => {
+    const wide = raiseToMinPixels(1280, 704, 32);
+    expect(wide.width * wide.height).toBeGreaterThanOrEqual(MIN);
+    expect(wide.width / wide.height).toBeCloseTo(1280 / 704, 1);
+    const tall = raiseToMinPixels(256, 1024, 32);
+    expect(tall.width * tall.height).toBeGreaterThanOrEqual(MIN);
+    expect(tall.height / tall.width).toBeCloseTo(4, 0);
+    expect(wide.width % 32 === 0 && wide.height % 32 === 0 && tall.width % 32 === 0 && tall.height % 32 === 0).toBe(true);
+  });
+});
+
+describe('resolveGeneration and the 2 megapixel minimum', () => {
+  const h3 = { ...DEFAULT_PROFILES.portrait };
+  it('raises a small H3 request and says what was asked', () => {
+    const gen = resolveGeneration('token', h3, { prompt: 'a barrel', width: 512, height: 512 });
+    expect(gen.width * gen.height).toBeGreaterThanOrEqual(LIMITS.minH3Pixels);
+    expect(gen.raisedFrom).toEqual({ width: 512, height: 512 });
+  });
+  it('does not touch a big H3 request, and does not raise checkpoint pictures', () => {
+    const big = resolveGeneration('portrait', h3, { prompt: 'x' });
+    expect(big.raisedFrom).toBeUndefined();
+    const cp = resolveGeneration('map', { ...DEFAULT_PROFILES.map, checkpoint: 'sdxl.safetensors' }, { prompt: 'x', width: 512, height: 512 });
+    expect([cp.width, cp.height]).toEqual([512, 512]);
+    expect(cp.raisedFrom).toBeUndefined();
+  });
+  it('raises the profile size too when the profile itself is small', () => {
+    const gen = resolveGeneration('token', { ...h3, width: 768, height: 768 }, { prompt: 'x' });
+    expect(gen.width * gen.height).toBeGreaterThanOrEqual(LIMITS.minH3Pixels);
+  });
+});
+
+describe('downscale', () => {
+  const solid = (w: number, h: number, rgba: [number, number, number, number]) => {
+    const data = new Uint8Array(w * h * 4);
+    for (let i = 0; i < w * h; i++) data.set(rgba, i * 4);
+    return { width: w, height: h, data };
+  };
+  it('returns the same picture when it is small enough', () => {
+    const img = solid(100, 50, [1, 2, 3, 255]);
+    expect(downscale(img, 100)).toBe(img);
+    expect(downscale(img, 500)).toBe(img);
+  });
+  it('shrinks the longest side and keeps the shape and colour', () => {
+    const small = downscale(solid(1000, 500, [200, 100, 50, 255]), 250);
+    expect([small.width, small.height]).toEqual([250, 125]);
+    expect(Array.from(small.data.slice(0, 4))).toEqual([200, 100, 50, 255]);
+  });
+  it('averages a checker pattern to grey', () => {
+    const w = 4;
+    const data = new Uint8Array(w * w * 4);
+    for (let y = 0; y < w; y++) for (let x = 0; x < w; x++) data.set((x + y) % 2 ? [255, 255, 255, 255] : [0, 0, 0, 255], (y * w + x) * 4);
+    const out = downscale({ width: w, height: w, data }, 2);
+    expect(out.width).toBe(2);
+    expect(out.data[0]).toBeGreaterThan(120);
+    expect(out.data[0]).toBeLessThan(135);
+  });
+  it('does not bleed the colour of transparent pixels into the edge', () => {
+    // left half opaque red, right half transparent black
+    const w = 4;
+    const data = new Uint8Array(w * 1 * 4);
+    data.set([255, 0, 0, 255, 255, 0, 0, 255, 0, 0, 0, 0, 0, 0, 0, 0]);
+    const out = downscale({ width: w, height: 1, data }, 1);
+    expect(out.data[0]).toBe(255); // still pure red, not darkened
+    expect(out.data[3]).toBeGreaterThan(120);
+    expect(out.data[3]).toBeLessThan(135);
+  });
+});

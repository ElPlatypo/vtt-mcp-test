+/**
+ * manage-scene-objects and preview-scene tests. Foundry is stubbed: these check the data sent
+ * to createEmbeddedDocuments / deleteEmbeddedDocuments, the grid conversion, validation, the
+ * "only remove what the tool created" rule and the write gate.
+ */
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FoundryDataAccess } from './data-access.js';
+
+const MODULE = 'foundry-mcp-bridge-scenes';
+const MINE = { [MODULE]: { sceneObjectsTool: true } };
+
+function makeScene(overrides: Record<string, any> = {}) {
+  const created: Record<string, any[]> = { Token: [], AmbientLight: [] };
+  const scene: any = {
+    id: 's1',
+    name: 'Cave',
+    width: 4000,
+    height: 3000,
+    padding: 0.25,
+    grid: { size: 100, distance: 5, units: 'ft' },
+    dimensions: { sceneX: 1000, sceneY: 800, sceneWidth: 4000, sceneHeight: 3000 },
+    tokens: { contents: [] as any[] },
+    lights: { contents: [] as any[] },
+    createEmbeddedDocuments: vi.fn(async (type: string, data: any[]) => {
+      created[type] ??= [];
+      const docs = data.map((d, i) => ({ id: `${type}-${created[type].length + i}`, ...d }));
+      created[type].push(...docs);
+      return docs;
+    }),
+    deleteEmbeddedDocuments: vi.fn(async () => []),
+    ...overrides,
+  };
+  return { scene, created };
+}
+
+function setup(options: { allowWriteOperations?: boolean; scene?: any; actors?: any[] } = {}) {
+  const { scene, created } = options.scene ? { scene: options.scene, created: {} } : makeScene();
+  const goblin = {
+    id: 'a1',
+    name: 'Goblin',
+    prototypeToken: {
+      toObject: () => ({
+        name: 'Goblin',
+        width: 1,
+        height: 1,
+        texture: { src: 'g.png' },
+        flags: {},
+      }),
+    },
+  };
+  vi.stubGlobal('Hooks', { on: vi.fn(), callAll: vi.fn() });
+  vi.stubGlobal('game', {
+    ready: true,
+    world: { id: 'world-1', getFlag: vi.fn(() => []), setFlag: vi.fn() },
+    user: { id: 'gm', name: 'Gamemaster' },
+    scenes: { contents: [scene], viewed: scene, current: scene },
+    actors: { contents: options.actors ?? [goblin] },
+    settings: {
+      get: (_m: string, key: string) =>
+        key === 'allowWriteOperations' ? (options.allowWriteOperations ?? true) : undefined,
+    },
+  });
+  return { dataAccess: new FoundryDataAccess(), scene, created };
+}
+
+describe('FoundryDataAccess.manageSceneObjects', () => {
+  beforeEach(() => vi.unstubAllGlobals());
+  afterEach(() => vi.unstubAllGlobals());
+
+  describe('place', () => {
+    it('puts a token at the given square, using the actor prototype and marking it', async () => {
+      const { dataAccess, scene } = setup();
+
+      const result = await dataAccess.manageSceneObjects({
+        action: 'place',
+        objects: [
+          {
+            kind: 'token',
+            actor: 'goblin',
+            x: 3,
+            y: 2,
+            name: 'Goblin 1',
+            hidden: true,
+            disposition: -1,
+          },
+        ],
+      });
+
+      const [type, data] = scene.createEmbeddedDocuments.mock.calls[0];
+      expect(type).toBe('Token');
+      expect(data[0]).toMatchObject({
+        name: 'Goblin 1',
+        actorId: 'a1',
+        x: 1300,
+        y: 1000,
+        hidden: true,
+        disposition: -1,
+        texture: { src: 'g.png' },
+        flags: MINE,
+      });
+      expect(result.created).toEqual([{ kind: 'token', id: 'Token-0', x: 3, y: 2 }]);
+    });
+
+    it('puts a light at the centre of a square with radii converted to distance', async () => {
+      const { dataAccess, scene } = setup();
+
+      const result = await dataAccess.manageSceneObjects({
+        action: 'place',
+        objects: [{ kind: 'light', x: 10.5, y: 4.5, bright: 2, dim: 6, color: '#ffaa33' }],
+      });
+
+      const [type, data] = scene.createEmbeddedDocuments.mock.calls[0];
+      expect(type).toBe('AmbientLight');
+      expect(data[0]).toMatchObject({
+        x: 2050,
+        y: 1250,
+        config: { bright: 10, dim: 30, color: '#ffaa33' },
+        flags: MINE,
+      });
+      expect(result.created[0]).toMatchObject({ kind: 'light', x: 10.5, y: 4.5 });
+    });
+
+    it('handles a mixed batch in one call and defaults to the viewed scene', async () => {
+      const { dataAccess, scene } = setup();
+      const result = await dataAccess.manageSceneObjects({
+        action: 'place',
+        objects: [
+          { kind: 'token', actor: 'a1', x: 0, y: 0 },
+          { kind: 'light', x: 1, y: 1, dim: 3 },
+        ],
+      });
+      expect(scene.createEmbeddedDocuments).toHaveBeenCalledTimes(2);
+      expect(result.created.map((c: any) => c.kind)).toEqual(['token', 'light']);
+      expect(result.scene).toEqual({ id: 's1', name: 'Cave' });
+    });
+
+    it('creates nothing when any object in the batch is invalid', async () => {
+      const { dataAccess, scene } = setup();
+
+      await expect(
+        dataAccess.manageSceneObjects({
+          action: 'place',
+          objects: [
+            { kind: 'token', actor: 'goblin', x: 1, y: 1 },
+            { kind: 'light', x: 500, y: 1, dim: 3 },
+          ],
+        })
+      ).rejects.toThrow('objects[1]');
+      expect(scene.createEmbeddedDocuments).not.toHaveBeenCalled();
+    });
+
+    it.each([
+      ['an unknown kind', { kind: 'dragon', x: 1, y: 1 }, 'kind must be'],
+      ['a token without an actor', { kind: 'token', x: 1, y: 1 }, 'actor'],
+      ['an unknown actor', { kind: 'token', actor: 'Dragon', x: 1, y: 1 }, 'Actor not found'],
+      [
+        'a token outside the scene',
+        { kind: 'token', actor: 'goblin', x: 40, y: 1 },
+        'top-left square',
+      ],
+      [
+        'a token at a bad disposition',
+        { kind: 'token', actor: 'goblin', x: 1, y: 1, disposition: 5 },

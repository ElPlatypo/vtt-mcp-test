@@ -0,0 +1,112 @@
+/**
+ * Pure helpers for scene backups: naming, recognising backups, and working out what a restore
+ * writes back. No Foundry globals, so they can be tested.
+ */
+
+/** Embedded collections a restore replaces: [scene collection name, document name]. Levels are updated in place. */
+export const RESTORE_COLLECTIONS: ReadonlyArray<readonly [string, string]> = [
+  ['tokens', 'Token'],
+  ['walls', 'Wall'],
+  ['lights', 'AmbientLight'],
+  ['sounds', 'AmbientSound'],
+  ['notes', 'Note'],
+  ['tiles', 'Tile'],
+  ['drawings', 'Drawing'],
+  ['regions', 'Region'],
+];
+
+/** Scene fields a restore copies back (everything that is not an id, a name, a folder or embedded). */
+export const RESTORE_FIELDS = [
+  'width',
+  'height',
+  'padding',
+  'grid',
+  'fog',
+  'tokenVision',
+  'environment',
+  'shiftX',
+  'shiftY',
+  'initial',
+  'initialLevel',
+  'transition',
+  'weather',
+  'playlist',
+  'playlistSound',
+  'journal',
+  'journalEntryPage',
+] as const;
+
+export const BACKUP_FOLDER_NAME = 'Backups';
+export const MAX_LABEL_LENGTH = 40;
+
+const pad = (n: number) => String(n).padStart(2, '0');
+
+/** 2026-11-12 14:05 */
+export function backupStamp(date: Date): string {
+  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}`;
+}
+
+export function cleanLabel(label: unknown): string {
+  if (label === undefined || label === null || label === '') return '';
+  if (typeof label !== 'string') throw new Error('label must be a string');
+  const cleaned = label.replace(/[\u0000-\u001f]/g, ' ').replace(/[()]/g, '').trim();
+  if (cleaned.length > MAX_LABEL_LENGTH) throw new Error(`label may have at most ${MAX_LABEL_LENGTH} characters`);
+  return cleaned;
+}
+
+/** "Redbrand Hideout (old 2026-11-12 14:05 before rebuild)" */
+export function backupName(sceneName: string, date: Date, label?: unknown): string {
+  const extra = cleanLabel(label);
+  return `${sceneName} (old ${backupStamp(date)}${extra ? ` ${extra}` : ''})`;
+}
+
+export interface BackupFlag {
+  /** Id of the scene this is a copy of. */
+  of: string;
+  /** Name that scene had. */
+  name: string;
+  at: string;
+  label?: string;
+}
+
+export function readBackupFlag(flags: unknown, moduleId: string): BackupFlag | null {
+  const f = (flags as any)?.[moduleId]?.sceneBackup;
+  if (!f || typeof f !== 'object' || typeof f.of !== 'string') return null;
+  return { of: f.of, name: String(f.name ?? ''), at: String(f.at ?? ''), ...(f.label ? { label: String(f.label) } : {}) };
+}
+
+/** A copy of embedded document data without its id and statistics, ready to create again. */
+export function stripForCreate(data: Record<string, any>): Record<string, any> {
+  const { _id, _stats, ...rest } = data ?? {};
+  void _id;
+  void _stats;
+  return rest;
+}
+
+export interface RestorePlan {
+  fields: Record<string, any>;
+  embedded: Array<{ collection: string; documentName: string; remove: number; add: Array<Record<string, any>> }>;
+}
+
+/**
+ * What a restore does: the scene fields to write and, per collection, how many documents to
+ * remove from the scene and which to create from the backup.
+ */
+export function buildRestorePlan(backup: Record<string, any>, currentCounts: Record<string, number>): RestorePlan {
+  const fields: Record<string, any> = {};
+  for (const key of RESTORE_FIELDS) {
+    if (key in backup) fields[key] = backup[key];
+  }
+  const embedded = RESTORE_COLLECTIONS.map(([collection, documentName]) => ({
+    collection,
+    documentName,
+    remove: currentCounts[collection] ?? 0,
+    add: (Array.isArray(backup[collection]) ? backup[collection] : []).map((d: any) => stripForCreate(d)),
+  }));
+  return { fields, embedded };
+}
+
+/** A plain-language summary of a plan, for the dry run. */
+export function summarisePlan(plan: RestorePlan): Array<{ collection: string; remove: number; add: number }> {
+  return plan.embedded.map(e => ({ collection: e.collection, remove: e.remove, add: e.add.length }));
+}

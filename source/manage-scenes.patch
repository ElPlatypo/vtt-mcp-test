+import { describe, expect, it } from 'vitest';
+import {
+  applyResolve,
+  distanceToSegment,
+  hitTest,
+  makeAnnotation,
+  makeArea,
+  newAnnotationId,
+  pointInPolygon,
+  polygonBounds,
+  rectPoints,
+  summariseArea,
+  targetOf,
+  type Clickable,
+} from './annotation-utils.js';
+
+describe('geometry', () => {
+  it('builds rectangles, bounds and areas', () => {
+    expect(rectPoints(5, 6, 2, 3)).toEqual([[2, 3], [5, 3], [5, 6], [2, 6]]);
+    expect(polygonBounds([[1, 2], [4, 2], [4, 7]])).toEqual({ x: 1, y: 2, width: 3, height: 5 });
+    const area = makeArea(rectPoints(1.04, 2.06, 4, 5), 'rect');
+    expect(area).toEqual({ shape: 'rect', points: [[1, 2.1], [4, 2.1], [4, 5], [1, 5]], bbox: { x: 1, y: 2.1, width: 3, height: 2.9 } });
+    expect(() => makeArea([[0, 0], [1, 1]], 'polygon')).toThrow('three points');
+  });
+  it('tests points against polygons and segments', () => {
+    const tri: Array<[number, number]> = [[0, 0], [10, 0], [0, 10]];
+    expect(pointInPolygon([2, 2], tri)).toBe(true);
+    expect(pointInPolygon([8, 8], tri)).toBe(false);
+    expect(distanceToSegment([5, 3], [0, 0], [10, 0])).toBe(3);
+    expect(distanceToSegment([-3, 4], [0, 0], [10, 0])).toBe(5);
+    expect(distanceToSegment([1, 1], [2, 2], [2, 2])).toBeCloseTo(Math.SQRT2);
+  });
+});
+
+describe('hitTest', () => {
+  const things: Clickable[] = [
+    { kind: 'tile', id: 'tile', x: 0, y: 0, width: 10, height: 10 },
+    { kind: 'token', id: 'tok', name: 'Goblin', x: 4, y: 4, width: 1, height: 1 },
+    { kind: 'light', id: 'light', at: [4.5, 4.5] },
+    { kind: 'wall', id: 'wall', segment: [[2, 8], [8, 8]], door: 'door' },
+    { kind: 'region', id: 'reg', name: 'Trap', polygon: [[6, 1], [9, 1], [9, 3], [6, 3]] },
+    { kind: 'drawing', id: 'draw', x: 1, y: 1, width: 2, height: 2 },
+  ];
+  it('prefers tokens over lights over tiles', () => {
+    expect(hitTest(things, [4.5, 4.5])?.id).toBe('tok');
+    expect(hitTest(things.filter(t => t.kind !== 'token'), [4.5, 4.5])?.id).toBe('light');
+    expect(hitTest(things.filter(t => t.kind === 'tile'), [4.5, 4.5])?.id).toBe('tile');
+  });
+  it('finds walls near the line, regions inside, and nothing in empty space', () => {
+    expect(hitTest(things, [5, 8.2])?.id).toBe('wall');
+    expect(hitTest(things, [5, 8.6])?.id).toBe('tile');
+    expect(hitTest(things, [7, 2])?.id).toBe('reg');
+    expect(hitTest(things, [20, 20])).toBeNull();
+    expect(hitTest([], [1, 1])).toBeNull();
+  });
+  it('takes the smaller of two overlapping drawings and tiles', () => {
+    const c: Clickable[] = [
+      { kind: 'tile', id: 'big', x: 0, y: 0, width: 10, height: 10 },
+      { kind: 'tile', id: 'small', x: 2, y: 2, width: 2, height: 2 },
+    ];
+    expect(hitTest(c, [3, 3])?.id).toBe('small');
+  });
+  it('describes a target in grid squares', () => {
+    expect(targetOf(things[1]!)).toEqual({ kind: 'token', id: 'tok', name: 'Goblin', x: 4, y: 4, width: 1, height: 1 });
+    expect(targetOf(things[2]!)).toEqual({ kind: 'light', id: 'light', x: 4.5, y: 4.5 });
+    expect(targetOf(things[3]!)).toEqual({ kind: 'wall', id: 'wall', x: 5, y: 8, door: 'door' });
+    expect(targetOf(things[4]!)).toEqual({ kind: 'region', id: 'reg', name: 'Trap', x: 6, y: 1 });
+  });
+});
+
+describe('annotations', () => {
+  const target = { kind: 'token' as const, id: 'tok', x: 1, y: 1 };
+  it('makes numbered open notes and checks them', () => {
+    const a = makeAnnotation({ scene: 's1', sceneName: 'Cave', prompt: '  change the picture ', target }, [], 1000);
+    expect(a).toMatchObject({ number: 1, type: 'object', prompt: 'change the picture', status: 'open', created: 1000, target });
+    expect(a.id).toMatch(/^n[a-z0-9]{9}$/);
+    const area = makeArea(rectPoints(0, 0, 3, 3), 'rect');
+    const b = makeAnnotation({ scene: 's1', sceneName: 'Cave', prompt: 'add enemies', area }, [a], 2000);
+    expect(b).toMatchObject({ number: 2, type: 'area' });
+    expect(() => makeAnnotation({ scene: 's', sceneName: 'x', prompt: '   ', target }, [])).toThrow('Write what');
+    expect(() => makeAnnotation({ scene: 's', sceneName: 'x', prompt: 'x'.repeat(2001), target }, [])).toThrow('at most');
+    expect(() => makeAnnotation({ scene: 's', sceneName: 'x', prompt: 'x' }, [])).toThrow('target object or an area');
+    expect(() => makeAnnotation({ scene: 's', sceneName: 'x', prompt: 'x', target, area }, [])).toThrow('target object or an area');
+    expect(newAnnotationId()).not.toBe(newAnnotationId());
+  });
+  it('resolves, replies, reopens and rejects bad statuses', () => {
+    const a = makeAnnotation({ scene: 's1', sceneName: 'Cave', prompt: 'x', target }, [], 1);
+    const done = applyResolve(a, { status: 'done', reply: ' Done, new picture ' }, 50);
+    expect(done).toMatchObject({ status: 'done', reply: 'Done, new picture', resolved: 50 });
+    const reopened = applyResolve(done, { status: 'open', reply: '' });
+    expect(reopened.status).toBe('open');
+    expect(reopened.resolved).toBeUndefined();
+    expect(reopened.reply).toBeUndefined();
+    expect(() => applyResolve(a, { status: 'later' as any })).toThrow('status must be');
+  });
+  it('counts what lies inside an area', () => {
+    const area = makeArea(rectPoints(0, 0, 5, 5), 'rect');
+    const things = [
+      { kind: 'token', name: 'Goblin', x: 1, y: 1 },
+      { kind: 'token', name: 'Far', x: 9, y: 9 },
+      { kind: 'light', x: 2, y: 2 },
+      { kind: 'light', x: 3, y: 3 },
+      { kind: 'wall', x: 4, y: 4 },
+    ];
+    expect(summariseArea(things, area)).toEqual({ tokens: ['Goblin'], lights: 2, walls: 1 });
+    expect(summariseArea([], area)).toEqual({});
+  });
+});
